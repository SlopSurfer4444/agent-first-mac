{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wine-runtime-overlay.schema.json",
  "type": "object",
  "required": [
    "schema",
    "id",
    "owner",
    "previousHubManifestSha256",
    "previousDS3ManifestSha256",
    "previousHubCriticalHashes",
    "sourceHubManifestSha256",
    "sourceCriticalHashes",
    "desiredPEHashes",
    "lifecycleSha256"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "const": "wine-runtime-overlay"
    },
    "owner": {
      "type": "string",
      "const": "control-games-hub"
    },
    "previousHubManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previousDS3ManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previousHubCriticalHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minProperties": 1
    },
    "sourceHubManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCriticalHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minProperties": 1
    },
    "desiredPEHashes": {
      "type": "object",
      "required": [
        "engine/lib/wine/i386-windows/winemac.drv",
        "engine/lib/wine/x86_64-windows/winemac.drv"
      ],
      "properties": {
        "engine/lib/wine/i386-windows/winemac.drv": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine/lib/wine/x86_64-windows/winemac.drv": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "lifecycleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
