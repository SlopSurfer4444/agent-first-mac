#!/usr/bin/python3
"""Bounded read-only Phase 3 identity and preparation preflight."""

import json
import os
from pathlib import Path
import plistlib
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
MANIFEST_PATH = ROOT / "manifests/phase3-capabilities.json"
BASE_COMMIT = "2fdbd7e7419fc049565f87b29a21b7dd1838a754"
EXPECTED_BRANCH = "codex/phase-3-permissions-prep"


def run(argv):
    completed = subprocess.run(
        [str(item) for item in argv],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    return completed.returncode, completed.stdout.strip()


def resolve_path(value):
    if value == "$HOME":
        return Path.home()
    if value.startswith("$HOME/"):
        return Path.home() / value[len("$HOME/"):]
    return Path(value)


def plist_value(path, key):
    try:
        with path.open("rb") as handle:
            return plistlib.load(handle).get(key)
    except (OSError, plistlib.InvalidFileException):
        return None


def inspect_identity(item):
    path = resolve_path(item["path"])
    if not path.is_dir():
        return {"id": item["id"], "status": "absent"}

    info = path / "Contents/Info.plist"
    if not info.is_file():
        info = path / "Info.plist"
    actual = {
        "bundle_id": plist_value(info, "CFBundleIdentifier"),
        "version": plist_value(info, "CFBundleShortVersionString"),
    }
    _, signature_output = run(["/usr/bin/codesign", "-dv", "--verbose=4", path])
    team_match = re.search(r"^TeamIdentifier=(.+)$", signature_output, re.MULTILINE)
    actual["team_id"] = team_match.group(1) if team_match else None
    _, requirement_output = run(["/usr/bin/codesign", "-dr", "-", path])
    requirement_match = re.search(r"^designated => (.+)$", requirement_output, re.MULTILINE)
    actual["designated_requirement"] = requirement_match.group(1) if requirement_match else None
    verify_argv = ["/usr/bin/codesign", "--verify", "--strict", path]
    if item["signature_verification"] == "deep_strict":
        verify_argv.insert(2, "--deep")
    verify_status, verify_output = run(verify_argv)
    actual["signature_valid"] = verify_status == 0
    if verify_status != 0:
        actual["signature_failure_class"] = (
            "obsolete_custom_omit_rules"
            if "resource envelope is obsolete (custom omit rules)" in verify_output
            else "other_bounded"
        )
    if path.suffix == ".app":
        gatekeeper_status, _ = run(["/usr/sbin/spctl", "-a", "-t", "exec", path])
        actual["gatekeeper_assessment"] = (
            "accepted" if gatekeeper_status == 0 else "rejected_or_unavailable"
        )
    else:
        actual["gatekeeper_assessment"] = "not_applicable_embedded_or_plugin"
    if item["id"] == "happ_app":
        actual["app_store_receipt_present"] = (path / "Contents/_MASReceipt/receipt").is_file()
        _, item_id = run(["/usr/bin/mdls", "-raw", "-name", "kMDItemAppStoreAdamID", path])
        actual["app_store_item_id"] = item_id
    if item["id"] == "amnezia_app":
        executable = plist_value(info, "CFBundleExecutable")
        file_status, file_output = run(["/usr/bin/file", "-b", path / executable])
        actual["architecture_class"] = (
            "arm64_ios_style_wrapper" if file_status == 0 and "arm64" in file_output
            else "other"
        )

    expected = {
        "bundle_id": item["bundle_id"],
        "team_id": item["team_id"],
        "designated_requirement": item["designated_requirement"],
    }
    if item["version_policy"] == "exact_observed_retest_on_change":
        expected["version"] = item["observed_version"]
    for field in ("app_store_item_id", "app_store_receipt_present", "architecture_class"):
        if field in item:
            expected[field] = item[field]
    mismatches = sorted(
        key for key, expected_value in expected.items()
        if actual.get(key) != expected_value
    )
    if not actual["signature_valid"]:
        mismatches.append("signature_valid")
    if path.suffix == ".app" and actual["gatekeeper_assessment"] != "accepted":
        mismatches.append("gatekeeper_assessment")
    return {
        "id": item["id"],
        "status": "mismatch" if mismatches else "verified_identity",
        "facts": actual,
        "mismatch_fields": sorted(set(mismatches)),
    }


def fixture_identity(item, fixture):
    facts = fixture.get("identities", {}).get(item["id"])
    if facts is None:
        return {"id": item["id"], "status": "absent"}
    expected = {
        "bundle_id": item["bundle_id"],
        "team_id": item["team_id"],
        "designated_requirement": item["designated_requirement"],
    }
    if item["version_policy"] == "exact_observed_retest_on_change":
        expected["version"] = item["observed_version"]
    for field in ("app_store_item_id", "app_store_receipt_present", "architecture_class"):
        if field in item:
            expected[field] = item[field]
    mismatches = sorted(
        key for key, expected_value in expected.items()
        if facts.get(key) != expected_value
    )
    if facts.get("signature_valid") is not True:
        mismatches.append("signature_valid")
    if item["path"].endswith(".app") and facts.get("gatekeeper_assessment") != "accepted":
        mismatches.append("gatekeeper_assessment")
    return {
        "id": item["id"],
        "status": "mismatch" if mismatches else "verified_identity",
        "facts": facts,
        "mismatch_fields": sorted(set(mismatches)),
    }


def live_prerequisites():
    devtools_status, devtools_output = run(["/usr/sbin/DevToolsSecurity", "-status"])
    groups_status, groups_output = run(["/usr/bin/id", "-Gn"])
    gatekeeper_status, gatekeeper_output = run(["/usr/sbin/spctl", "--status"])
    uid = os.getuid()
    updater_status, _ = run([
        "/bin/launchctl", "print", f"gui/{uid}/com.google.GoogleUpdater.wake",
    ])
    return {
        "developer_group_present": groups_status == 0 and "_developer" in groups_output.split(),
        "devtools_security": (
            "enabled" if devtools_status == 0 and "enabled" in devtools_output.lower()
            else "disabled"
        ),
        "gatekeeper_enabled": gatekeeper_status == 0 and "enabled" in gatekeeper_output.lower(),
        "google_updater_loaded": updater_status == 0,
    }


def git_facts():
    branch_status, branch = run(["/usr/bin/git", "branch", "--show-current"])
    ancestor_status, _ = run([
        "/usr/bin/git", "merge-base", "--is-ancestor", BASE_COMMIT, "HEAD",
    ])
    dirty_status, dirty = run(["/usr/bin/git", "status", "--porcelain"])
    return {
        "base_is_ancestor": ancestor_status == 0,
        "branch": branch if branch_status == 0 else "unknown",
        "branch_expected": branch_status == 0 and branch == EXPECTED_BRANCH,
        "clean": dirty_status == 0 and dirty == "",
    }


def main():
    args = sys.argv[1:]
    json_mode = False
    fixture_path = None
    while args:
        arg = args.pop(0)
        if arg == "--json":
            json_mode = True
        elif arg == "--fixture" and args:
            fixture_path = Path(args.pop(0))
        else:
            raise SystemExit("usage: phase3-preflight [--json] [--fixture PATH]")

    manifest = json.loads(MANIFEST_PATH.read_text())
    fixture = json.loads(fixture_path.read_text()) if fixture_path else None
    if fixture is not None and fixture.get("schema") != 1:
        raise SystemExit("unsupported fixture schema")

    identities = [
        fixture_identity(item, fixture) if fixture is not None else inspect_identity(item)
        for item in manifest["logical_identities"]
    ]
    identity_by_id = {item["id"]: item for item in identities}
    relationships = []
    for relationship in manifest["identity_relationships"]:
        left = identity_by_id[relationship["left"]]
        right = identity_by_id[relationship["right"]]
        if left["status"] != "verified_identity" or right["status"] != "verified_identity":
            status = "blocked"
        elif left["facts"]["version"] == right["facts"]["version"]:
            status = "safely_observed"
        else:
            status = "mismatch"
        relationships.append({"id": relationship["id"], "status": status})

    prerequisites = (
        {key: fixture[key] for key in (
            "developer_group_present", "devtools_security", "gatekeeper_enabled",
            "google_updater_loaded",
        )}
        if fixture is not None else live_prerequisites()
    )
    prerequisite_checks = [
        {"id": "developer_group", "status": "safely_observed",
         "fact": prerequisites["developer_group_present"]},
        {"id": "devtools_security", "status": "safely_observed",
         "fact": prerequisites["devtools_security"]},
        {"id": "gatekeeper", "status": "safely_observed",
         "fact": prerequisites["gatekeeper_enabled"]},
        {"id": "google_updater", "status": "safely_observed",
         "fact": prerequisites["google_updater_loaded"]},
    ]
    capabilities = [
        {"id": item["id"], "status": item["observed_status"]}
        for item in manifest["capabilities"]
    ]
    manifest_by_id = {item["id"]: item for item in manifest["logical_identities"]}
    required_identity_failure = any(
        item["status"] != "verified_identity"
        and manifest_by_id[item["id"]]["preparation_role"].startswith("required_")
        for item in identities
    )
    # Fixture mode may replace identity/prerequisite facts only. Git state is
    # always authoritative live state from the checkout containing this tool.
    control_git = git_facts()
    git_failure = not (
        control_git["base_is_ancestor"] and control_git["branch_expected"]
        and control_git["clean"]
    )
    known_blocker = (
        any(item["status"] in {"mismatch", "blocked"} for item in relationships)
        or any(item["status"] == "mismatch" for item in identities)
    )
    report = {
        "schema": 1,
        "phase": "phase3_permissions_preparation",
        "read_only": True,
        "permission_state_read": False,
        "raw_tcc_read": False,
        "fixture_mode": fixture is not None,
        "verdict": "BLOCKED" if required_identity_failure or git_failure else (
            "PREPARED_WITH_KNOWN_BLOCKERS" if known_blocker else "PREPARED"
        ),
        "verdict_ceiling": "PREPARED_FOR_INDEPENDENT_REVIEW",
        "control_git": control_git,
        "identities": identities,
        "identity_relationships": relationships,
        "prerequisites": prerequisite_checks,
        "capabilities": capabilities,
        "system_mutations_performed": False,
    }
    if json_mode:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"Phase 3 preparation preflight: {report['verdict']}")
        for item in identities:
            print(f"{item['status'].upper():18} {item['id']}")
        for item in relationships:
            print(f"{item['status'].upper():18} {item['id']}")
        for item in prerequisite_checks:
            print(f"SAFELY_OBSERVED    {item['id']}={item['fact']}")
        print("TCC/product capability state: unknown until authorized ceremony probes")
    raise SystemExit(1 if required_identity_failure or git_failure else 0)


if __name__ == "__main__":
    main()
