#!/usr/bin/python3
"""Read-only bounded GameToMac source/installed identity check."""
import json
import os
import pathlib
import plistlib
import re
import subprocess
import sys
sys.dont_write_bytecode = True
root = pathlib.Path(__file__).resolve().parents[1]
def require(ok, reason):
    if not ok:
        raise ValueError(reason)
def run(args):
    p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    require(p.returncode == 0, 'identity_command_failed')
    return (p.stdout + p.stderr).decode('utf-8', 'replace')
try:
    require(sys.argv[1:] in ([], ['--installed']), 'arguments')
    m = json.loads((root / 'manifests/gametomac.json').read_text())
    require(type(m['schema']) is int and m['schema'] == 1 and type(m['enabled']) is bool, 'manifest_types')
    a = m['application']
    require(a == {'path': '/Applications/GameToMac.app', 'bundleIdentifier': 'com.marcibrahim.gamelibrary', 'teamIdentifier': '4F5RV48Y8T', 'executable': 'GameLibrary', 'versionKey': 'CFBundleVersion', 'minimumVersion': 87}, 'identity_contract')
    require(re.fullmatch(r'https://updates\.gametomac\.com/[A-Za-z0-9.-]+\.dmg', m['source']['url']) is not None, 'source_domain')
    require(re.fullmatch('[0-9a-f]{64}', m['source']['sha256']) is not None, 'source_checksum')
    require('./darwin/gametomac.nix' in (root / 'flake.nix').read_text(), 'module_import')
    module = (root / 'darwin/gametomac.nix').read_text()
    require('builtins.readFile' not in module, 'untracked_nix_input')
    for value in [m['source']['url'], m['source']['sha256'], a['path'], a['bundleIdentifier'], a['teamIdentifier'], a['executable'], a['versionKey']]:
        require(json.dumps(value) in module, 'module_manifest_disagreement')
    require('enabled = ' + str(m['enabled']).lower() + ';' in module, 'enabled_disagreement')
    require('minimumVersion = ' + str(a['minimumVersion']) + ';' in module, 'floor_disagreement')
    installed = sys.argv[1:] == ['--installed']
    if installed:
        app = pathlib.Path(a['path'])
        marker = pathlib.Path('/var/db/agent-first-mac/gametomac/managed-source')
        if m['enabled']:
            require(app.is_dir() and not app.is_symlink(), 'app_missing_or_symlink')
            p = plistlib.loads((app / 'Contents/Info.plist').read_bytes())
            require(p.get('CFBundleIdentifier') == a['bundleIdentifier'] and p.get('CFBundleExecutable') == a['executable'], 'bundle_identity')
            build = p.get(a['versionKey'])
            require(type(build) is str and re.fullmatch('[0-9]+', build) and int(build) >= a['minimumVersion'], 'build_floor')
            exe = app / 'Contents/MacOS' / a['executable']
            require(exe.is_file() and not exe.is_symlink() and os.access(exe, os.X_OK), 'executable_identity')
            run(['/usr/bin/lipo', '-verify_arch', 'arm64', str(exe)])
            detail = run(['/usr/bin/codesign', '-dv', '--verbose=4', str(app)])
            require('TeamIdentifier=' + a['teamIdentifier'] + '\n' in detail, 'team_identity')
            run(['/usr/bin/codesign', '--verify', '--deep', '--strict', str(app)])
            run(['/usr/sbin/spctl', '--assess', '--type', 'execute', str(app)])
            require(marker.is_file() and not marker.is_symlink(), 'marker_missing')
            require(marker.stat().st_uid == 0 and marker.stat().st_gid == 0 and marker.stat().st_mode & 0o777 == 0o644, 'marker_permissions')
            require(marker.read_bytes() == ('87|' + m['source']['sha256'] + '\n').encode('ascii'), 'marker_identity')
        else:
            require(not app.exists() and not app.is_symlink() and not marker.exists() and not marker.is_symlink(), 'removal_incomplete')
    print(json.dumps({'verdict':'PASS', 'scope':'installed-identity' if installed else 'source-contract', 'gameplayVerified':False}))
except Exception as e:
    print(json.dumps({'verdict':'FAIL', 'reason':str(e)}))
    sys.exit(1)
