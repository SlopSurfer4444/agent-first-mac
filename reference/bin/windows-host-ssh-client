#!/usr/bin/python3
"""Transactional WindowsHost outbound SSH client profile.

Runtime identities are intentionally retained only under AIDev/state.  The
script emits boolean status and fingerprints only; it never prints key bodies,
overlay addresses, account names, or raw command output.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import hmac
import json
import os
from pathlib import Path
import pwd
import re
import secrets
import shutil
import subprocess
import sys
import tempfile


ALIAS = "windows-host"
PROXY = "/Applications/Tailscale.app/Contents/MacOS/tailscale nc %h %p"
EXPECTED_FINGERPRINT = re.compile(r"^SHA256:[A-Za-z0-9+/]{20,}$")
EXPECTED_USER = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")


class ProfileError(RuntimeError):
    pass


def fail(code: str) -> None:
    raise ProfileError(code)


def canonical_home() -> Path:
    if os.geteuid() == 0:
        fail("refusing_root")
    home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    if Path.home() != home or home.is_symlink():
        fail("canonical_home_mismatch")
    return home


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def public_blob_fingerprint(public_body: str) -> str:
    try:
        blob = base64.b64decode(public_body.encode("ascii"), validate=True)
    except Exception as exc:
        raise ProfileError("invalid_host_key_body") from exc
    digest = base64.b64encode(hashlib.sha256(blob).digest()).decode("ascii")
    return "SHA256:" + digest.rstrip("=")


def tailscale_cli() -> Path:
    path = Path("/Applications/Tailscale.app/Contents/MacOS/tailscale")
    if not path.is_file() or path.is_symlink():
        fail("canonical_tailscale_cli_missing")
    return path


def resolve_windows_peer() -> str:
    proc = subprocess.run(
        [str(tailscale_cli()), "status", "--json"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True, timeout=15,
    )
    data = json.loads(proc.stdout)
    matches: list[str] = []
    for peer in (data.get("Peer") or {}).values():
        host = str(peer.get("HostName") or "").lower()
        dns = str(peer.get("DNSName") or "").lower().rstrip(".")
        os_name = str(peer.get("OS") or "").lower()
        if not peer.get("Online") or os_name != "windows":
            continue
        if host != ALIAS and not dns.startswith(ALIAS + "."):
            continue
        ips = [str(value) for value in (peer.get("TailscaleIPs") or [])
               if str(value).startswith("100.")]
        if len(ips) == 1:
            matches.append(ips[0])
    if len(matches) != 1:
        fail("windows_peer_not_unique_online")
    return matches[0]


def scan_ed25519_host_key(host: str) -> tuple[str, str, str]:
    proc = subprocess.run(
        ["/usr/bin/ssh-keyscan", "-T", "8", "-t", "ed25519", host],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True, timeout=15,
    )
    rows = [line.split() for line in proc.stdout.splitlines()
            if line and not line.startswith("#")]
    rows = [row for row in rows if len(row) >= 3 and row[1] == "ssh-ed25519"]
    if len(rows) != 1 or rows[0][0] != host:
        fail("host_key_scan_not_unique")
    return rows[0][0], rows[0][1], rows[0][2]


def hashed_known_host(host: str, key_type: str, public_body: str) -> bytes:
    salt = secrets.token_bytes(20)
    digest = hmac.new(salt, host.encode("utf-8"), hashlib.sha1).digest()
    token = "|1|{}|{}".format(
        base64.b64encode(salt).decode("ascii"),
        base64.b64encode(digest).decode("ascii"),
    )
    return f"{token} {key_type} {public_body}\n".encode("ascii")


def render_main_config() -> bytes:
    return b"Include config.d/*.conf\n"


def render_alias_config(host: str, user: str) -> bytes:
    return (
        "Host windows-host\n"
        f"  HostName {host}\n"
        f"  User {user}\n"
        "  IdentityFile ~/.ssh/windows-host_ed25519\n"
        "  IdentitiesOnly yes\n"
        "  PreferredAuthentications publickey\n"
        "  PubkeyAuthentication yes\n"
        "  PasswordAuthentication no\n"
        "  KbdInteractiveAuthentication no\n"
        "  StrictHostKeyChecking yes\n"
        "  UserKnownHostsFile ~/.ssh/known_hosts_windows-host\n"
        "  HashKnownHosts yes\n"
        "  CheckHostIP yes\n"
        "  ForwardAgent no\n"
        "  PermitLocalCommand no\n"
        "  ServerAliveInterval 30\n"
        "  ServerAliveCountMax 3\n"
        "  TCPKeepAlive yes\n"
        "  RequestTTY no\n"
    ).encode("utf-8")


def render_proxy_config(host: str, user: str) -> bytes:
    return render_alias_config(host, user) + (
        f"  ProxyCommand {PROXY}\n"
        "  HostKeyAlgorithms ssh-ed25519\n"
        "  GlobalKnownHostsFile /dev/null\n"
        "  BatchMode yes\n"
        "  ConnectTimeout 10\n"
    ).encode()


def replace_exact(path: Path, expected: bytes, replacement: bytes) -> None:
    if (not path.is_file() or path.is_symlink()
            or path.stat().st_mode & 0o777 != 0o600
            or path.read_bytes() != expected or path.parent.is_symlink()):
        fail("transport_target_drift")
    descriptor, staged = tempfile.mkstemp(prefix=".windows-host.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(replacement)
            handle.flush()
            os.fsync(handle.fileno())
        if path.is_symlink() or path.read_bytes() != expected:
            fail("transport_concurrent_drift")
        os.replace(staged, path)
    finally:
        if os.path.exists(staged):
            os.unlink(staged)


def transport_restore(paths: dict[str, Path]) -> None:
    journal = paths["state"] / "transport-backup.json"
    if not journal.is_file() or journal.is_symlink() or journal.stat().st_mode & 0o777 != 0o600:
        fail("transport_backup_missing_or_unsafe")
    data = json.loads(journal.read_text())
    replacements = []
    for name in ("alias", "receipt"):
        old = base64.b64decode(data[name]["before"], validate=True)
        new = base64.b64decode(data[name]["after"], validate=True)
        path = paths[name]
        if not path.is_file() or path.is_symlink() or path.stat().st_mode & 0o777 != 0o600:
            fail("transport_recovery_drift")
        current = path.read_bytes()
        if current not in (old, new):
            fail("transport_recovery_drift")
        replacements.append((path, current, old))
    # Validate both before restoring either; retain journal for interrupted recovery.
    for path, current, old in replacements:
        replace_exact(path, current, old)
    journal.unlink()


def migrate_transport() -> bool:
    paths = layout(canonical_home())
    validate_key_prestate(paths)
    receipt = load_receipt(paths)
    if not exact_managed(paths, receipt):
        fail("managed_bytes_drift")
    if receipt.get("transport") == "tailscale-nc":
        doctor()
        return False
    if "transport" in receipt:
        fail("unsupported_transport")
    old_alias = render_alias_config(receipt["host"], receipt["user"])
    if paths["alias"].read_bytes() != old_alias:
        fail("legacy_alias_not_exact")
    tailscale_cli()
    new_alias = render_proxy_config(receipt["host"], receipt["user"])
    old_receipt = paths["receipt"].read_bytes()
    receipt["transport"] = "tailscale-nc"
    receipt["managed"]["alias"] = sha256_bytes(new_alias)
    new_receipt = (json.dumps(receipt, sort_keys=True) + "\n").encode()
    journal = paths["state"] / "transport-backup.json"
    # A prior interrupted transaction must be explicitly recovered, never overwritten.
    backup = {}
    for name, before, after in (("alias", old_alias, new_alias),
                                ("receipt", old_receipt, new_receipt)):
        backup[name] = {"before": base64.b64encode(before).decode(),
                        "after": base64.b64encode(after).decode()}
    atomic_write(journal, (json.dumps(backup, sort_keys=True) + "\n").encode(), 0o600)
    try:
        replace_exact(paths["alias"], old_alias, new_alias)
        replace_exact(paths["receipt"], old_receipt, new_receipt)
        doctor()
    except Exception:
        transport_restore(paths)
        raise
    return True


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    if path.exists() or path.is_symlink():
        fail("managed_target_collision")
    if path.parent.is_symlink() or not path.parent.is_dir():
        fail("unsafe_managed_parent")
    descriptor, staged = tempfile.mkstemp(prefix=".windows-host.", dir=path.parent)
    staged_path = Path(staged)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(staged_path, path)
    finally:
        if staged_path.exists():
            staged_path.unlink()


def layout(home: Path) -> dict[str, Path]:
    ssh = home / ".ssh"
    return {
        "ssh": ssh,
        "private": ssh / "windows-host_ed25519",
        "public": ssh / "windows-host_ed25519.pub",
        "main": ssh / "config",
        "config_dir": ssh / "config.d",
        "alias": ssh / "config.d/windows-host.conf",
        "known": ssh / "known_hosts_windows-host",
        "state": home / "AIDev/state/windows-host-ssh-client",
        "receipt": home / "AIDev/state/windows-host-ssh-client/receipt.json",
    }


def validate_key_prestate(paths: dict[str, Path]) -> None:
    ssh = paths["ssh"]
    if not ssh.is_dir() or ssh.is_symlink() or (ssh.stat().st_mode & 0o777) != 0o700:
        fail("ssh_directory_not_exact")
    for name, mode in (("private", 0o600), ("public", 0o644)):
        path = paths[name]
        if not path.is_file() or path.is_symlink() or (path.stat().st_mode & 0o777) != mode:
            fail("dedicated_key_prestate_not_exact")


def prepare(fingerprint: str, user: str) -> tuple[str, str, str, str]:
    if not EXPECTED_FINGERPRINT.fullmatch(fingerprint):
        fail("invalid_expected_fingerprint")
    if not EXPECTED_USER.fullmatch(user):
        fail("invalid_runtime_user")
    home = canonical_home()
    paths = layout(home)
    validate_key_prestate(paths)
    if any(paths[name].exists() or paths[name].is_symlink()
           for name in ("main", "config_dir", "alias", "known", "receipt")):
        fail("managed_prestate_collision")
    host, key_type, public_body = scan_ed25519_host_key(resolve_windows_peer())
    observed = public_blob_fingerprint(public_body)
    if observed != fingerprint:
        fail("independent_host_fingerprint_mismatch")
    return host, key_type, public_body, observed


def apply_profile(fingerprint: str, user: str) -> bool:
    home = canonical_home()
    paths = layout(home)
    if paths["receipt"].exists() or paths["receipt"].is_symlink():
        receipt = load_receipt(paths)
        if receipt.get("hostFingerprint") != fingerprint or receipt.get("user") != user:
            fail("already_applied_runtime_identity_mismatch")
        doctor()
        return False
    host, key_type, public_body, observed = prepare(fingerprint, user)
    paths["config_dir"].mkdir(mode=0o700)
    paths["state"].mkdir(parents=True, mode=0o700, exist_ok=False)
    created: list[Path] = []
    try:
        main = render_main_config()
        alias = render_alias_config(host, user)
        known = hashed_known_host(host, key_type, public_body)
        for path, data in ((paths["main"], main), (paths["alias"], alias),
                           (paths["known"], known)):
            atomic_write(path, data, 0o600)
            created.append(path)
        receipt = {
            "schema": 1,
            "status": "applied",
            "host": host,
            "user": user,
            "hostFingerprint": observed,
            "managed": {
                "config": sha256_bytes(main),
                "alias": sha256_bytes(alias),
                "knownHosts": sha256_bytes(known),
            },
            "prestate": {
                "configAbsent": True,
                "configDirAbsent": True,
                "knownHostsAbsent": True,
            },
        }
        atomic_write(paths["receipt"],
                     (json.dumps(receipt, sort_keys=True) + "\n").encode(), 0o600)
    except Exception:
        for path in reversed(created):
            if path.exists() and not path.is_symlink():
                path.unlink()
        if paths["config_dir"].is_dir() and not any(paths["config_dir"].iterdir()):
            paths["config_dir"].rmdir()
        if paths["state"].is_dir() and not any(paths["state"].iterdir()):
            paths["state"].rmdir()
        raise
    return True


def load_receipt(paths: dict[str, Path]) -> dict:
    receipt = paths["receipt"]
    if not receipt.is_file() or receipt.is_symlink() or (receipt.stat().st_mode & 0o777) != 0o600:
        fail("runtime_receipt_missing_or_unsafe")
    data = json.loads(receipt.read_text())
    if data.get("schema") != 1 or data.get("status") != "applied":
        fail("runtime_receipt_state_invalid")
    return data


def exact_managed(paths: dict[str, Path], receipt: dict) -> bool:
    expected = receipt["managed"]
    checks = (("main", "config"), ("alias", "alias"), ("known", "knownHosts"))
    for path_name, hash_name in checks:
        path = paths[path_name]
        if not path.is_file() or path.is_symlink() or (path.stat().st_mode & 0o777) != 0o600:
            return False
        if sha256_bytes(path.read_bytes()) != expected[hash_name]:
            return False
    return True


def doctor() -> None:
    home = canonical_home()
    paths = layout(home)
    validate_key_prestate(paths)
    receipt = load_receipt(paths)
    if not exact_managed(paths, receipt):
        fail("managed_bytes_drift")
    current_host = resolve_windows_peer()
    if current_host != receipt["host"]:
        fail("runtime_peer_drift")
    proxy = receipt.get("transport") == "tailscale-nc"
    if receipt.get("transport") not in (None, "tailscale-nc"):
        fail("unsupported_transport")
    # Enrollment still keyscans and checks the independent fingerprint. Routine
    # health instead validates that exact pin and lets strict SSH authenticate
    # the actual peer; another unauthenticated scan adds no stronger identity.
    rows = paths["known"].read_text().splitlines()
    if len(rows) != 1:
        fail("known_host_pin_invalid")
    row = rows[0].split()
    if len(row) != 3 or row[1] != "ssh-ed25519":
        fail("known_host_pin_invalid")
    parts = row[0].split("|")
    try:
        if len(parts) != 4 or parts[:2] != ["", "1"]:
            fail("known_host_pin_invalid")
        salt, host_digest = (base64.b64decode(value, validate=True) for value in parts[2:])
    except ValueError as exc:
        raise ProfileError("known_host_pin_invalid") from exc
    if (len(salt) != 20 or len(host_digest) != 20
            or not hmac.compare_digest(host_digest, hmac.new(
                salt, current_host.encode(), hashlib.sha1).digest())
            or public_blob_fingerprint(row[2]) != receipt["hostFingerprint"]):
        fail("pinned_host_key_drift")
    expected_alias = (render_proxy_config if proxy else render_alias_config)(
        current_host, receipt["user"])
    if (paths["alias"].read_bytes() != expected_alias
            or paths["main"].read_bytes() != render_main_config()):
        fail("managed_policy_drift")
    effective = subprocess.run(
        ["/usr/bin/ssh", "-G", ALIAS], check=True,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10,
    ).stdout.splitlines()
    required = {
        "stricthostkeychecking true",
        "passwordauthentication no",
        "kbdinteractiveauthentication no",
        "identitiesonly yes",
        "forwardagent no",
        "preferredauthentications publickey",
        "pubkeyauthentication yes",
    }
    if proxy:
        required.update({f"proxycommand {PROXY}", "hostkeyalgorithms ssh-ed25519",
                         "globalknownhostsfile /dev/null", "batchmode yes",
                         f"userknownhostsfile {paths['known']}"})
    if not required.issubset(set(effective)):
        fail("effective_ssh_policy_drift")
    smoke = subprocess.run(
        ["/usr/bin/ssh", "-T", "-o", "BatchMode=yes",
         "-o", "StrictHostKeyChecking=yes", "-o", "HostKeyAlgorithms=ssh-ed25519",
         "-o", f"UserKnownHostsFile={paths['known']}", "-o", "GlobalKnownHostsFile=/dev/null",
         "-o", "PreferredAuthentications=publickey", "-o", "PasswordAuthentication=no",
         "-o", "KbdInteractiveAuthentication=no", "-o", "IdentitiesOnly=yes",
         "-o", "ForwardAgent=no", "-o", "PermitLocalCommand=no",
         ALIAS, "printf BRIDGE_STRICT_OK"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        text=True, timeout=20,
    ).stdout
    if smoke != "BRIDGE_STRICT_OK":
        fail("strict_key_only_smoke_failed")


def rollback() -> None:
    home = canonical_home()
    paths = layout(home)
    receipt = load_receipt(paths)
    if not exact_managed(paths, receipt):
        fail("rollback_refuses_managed_drift")
    for name in ("known", "alias", "main"):
        paths[name].unlink()
    if paths["config_dir"].is_dir() and not any(paths["config_dir"].iterdir()):
        paths["config_dir"].rmdir()
    receipt["status"] = "rolled_back"
    staged = (json.dumps(receipt, sort_keys=True) + "\n").encode()
    paths["receipt"].unlink()
    atomic_write(paths["receipt"], staged, 0o600)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    sub = result.add_subparsers(dest="command", required=True)
    for name in ("prepare", "apply"):
        item = sub.add_parser(name)
        item.add_argument("--fingerprint", required=True)
        item.add_argument("--user", required=True)
    sub.add_parser("doctor")
    sub.add_parser("rollback")
    sub.add_parser("migrate-transport")
    sub.add_parser("restore-transport")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "prepare":
            prepare(args.fingerprint, args.user)
            print("prepare_pass=true")
        elif args.command == "apply":
            changed = apply_profile(args.fingerprint, args.user)
            print("apply_pass=true")
            print(f"apply_noop={'false' if changed else 'true'}")
        elif args.command == "doctor":
            doctor()
            print("doctor_pass=true")
            print("strict_host_key_checking=true")
            print("key_only_smoke=true")
        elif args.command == "migrate-transport":
            changed = migrate_transport()
            print("transport_pass=true")
            print(f"transport_noop={'false' if changed else 'true'}")
        elif args.command == "restore-transport":
            transport_restore(layout(canonical_home()))
            print("transport_restore_pass=true")
        elif args.command == "rollback":
            rollback()
            print("rollback_pass=true")
        return 0
    except (ProfileError, subprocess.SubprocessError, json.JSONDecodeError,
            OSError, KeyError, ValueError) as exc:
        code = str(exc) if isinstance(exc, ProfileError) else "bounded_runtime_failure"
        print("status=FAIL", file=sys.stderr)
        print(f"blocker={code}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
