#!/usr/bin/python3
"""Transactional WindowsHost outbound SSH client profile.

Runtime identities are intentionally retained only under AIDev/state.  The
script emits boolean status and fingerprints only; it never prints key bodies,
overlay addresses, account names, or raw command output.
"""

from __future__ import annotations

import argparse
import base64
import ctypes
import hashlib
import hmac
import json
import os
from pathlib import Path
import pwd
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile


ALIAS = "windows-host"
PROXY = "/Applications/Tailscale.app/Contents/MacOS/tailscale nc %h %p"
EXPECTED_FINGERPRINT = re.compile(r"^SHA256:[A-Za-z0-9+/]{20,}$")
EXPECTED_USER = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")
MAX_MANAGED_FILE = 1024 * 1024


class ProfileError(RuntimeError):
    pass


def fail(code: str) -> None:
    raise ProfileError(code)


def canonical_home() -> Path:
    if os.geteuid() == 0:
        fail("refusing_root")
    home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    if Path.home() != home or home.is_symlink():
        fail("canonical_home_mismatch")
    return home


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def public_blob_fingerprint(public_body: str) -> str:
    try:
        blob = base64.b64decode(public_body.encode("ascii"), validate=True)
    except Exception as exc:
        raise ProfileError("invalid_host_key_body") from exc
    digest = base64.b64encode(hashlib.sha256(blob).digest()).decode("ascii")
    return "SHA256:" + digest.rstrip("=")


def tailscale_cli() -> Path:
    path = Path("/Applications/Tailscale.app/Contents/MacOS/tailscale")
    if not path.is_file() or path.is_symlink():
        fail("canonical_tailscale_cli_missing")
    return path


def resolve_windows_peer() -> str:
    proc = subprocess.run(
        [str(tailscale_cli()), "status", "--json"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True, timeout=15,
    )
    data = json.loads(proc.stdout)
    matches: list[str] = []
    for peer in (data.get("Peer") or {}).values():
        host = str(peer.get("HostName") or "").lower()
        dns = str(peer.get("DNSName") or "").lower().rstrip(".")
        os_name = str(peer.get("OS") or "").lower()
        if not peer.get("Online") or os_name != "windows":
            continue
        if host != ALIAS and not dns.startswith(ALIAS + "."):
            continue
        ips = [str(value) for value in (peer.get("TailscaleIPs") or [])
               if str(value).startswith("100.")]
        if len(ips) == 1:
            matches.append(ips[0])
    if len(matches) != 1:
        fail("windows_peer_not_unique_online")
    return matches[0]


def scan_ed25519_host_key(host: str) -> tuple[str, str, str]:
    proc = subprocess.run(
        ["/usr/bin/ssh-keyscan", "-T", "8", "-t", "ed25519", host],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True, timeout=15,
    )
    rows = [line.split() for line in proc.stdout.splitlines()
            if line and not line.startswith("#")]
    rows = [row for row in rows if len(row) >= 3 and row[1] == "ssh-ed25519"]
    if len(rows) != 1 or rows[0][0] != host:
        fail("host_key_scan_not_unique")
    return rows[0][0], rows[0][1], rows[0][2]


def hashed_known_host(host: str, key_type: str, public_body: str) -> bytes:
    salt = secrets.token_bytes(20)
    digest = hmac.new(salt, host.encode("utf-8"), hashlib.sha1).digest()
    token = "|1|{}|{}".format(
        base64.b64encode(salt).decode("ascii"),
        base64.b64encode(digest).decode("ascii"),
    )
    return f"{token} {key_type} {public_body}\n".encode("ascii")


def render_main_config() -> bytes:
    return b"Include config.d/*.conf\n"


def render_alias_config(host: str, user: str) -> bytes:
    return (
        "Host windows-host\n"
        f"  HostName {host}\n"
        f"  User {user}\n"
        "  IdentityFile ~/.ssh/windows-host_ed25519\n"
        "  IdentitiesOnly yes\n"
        "  PreferredAuthentications publickey\n"
        "  PubkeyAuthentication yes\n"
        "  PasswordAuthentication no\n"
        "  KbdInteractiveAuthentication no\n"
        "  StrictHostKeyChecking yes\n"
        "  UserKnownHostsFile ~/.ssh/known_hosts_windows-host\n"
        "  HashKnownHosts yes\n"
        "  CheckHostIP yes\n"
        "  ForwardAgent no\n"
        "  PermitLocalCommand no\n"
        "  ServerAliveInterval 30\n"
        "  ServerAliveCountMax 3\n"
        "  TCPKeepAlive yes\n"
        "  RequestTTY no\n"
    ).encode("utf-8")


def render_proxy_config(host: str, user: str) -> bytes:
    return render_alias_config(host, user) + (
        f"  ProxyCommand {PROXY}\n"
        "  HostKeyAlgorithms ssh-ed25519\n"
        "  GlobalKnownHostsFile /dev/null\n"
        "  BatchMode yes\n"
        "  ConnectTimeout 10\n"
    ).encode()


def replace_exact(path: Path, expected: bytes, replacement: bytes) -> None:
    if (not path.is_file() or path.is_symlink()
            or path.stat().st_mode & 0o777 != 0o600
            or path.read_bytes() != expected or path.parent.is_symlink()):
        fail("transport_target_drift")
    descriptor, staged = tempfile.mkstemp(prefix=".windows-host.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(replacement)
            handle.flush()
            os.fsync(handle.fileno())
        if path.is_symlink() or path.read_bytes() != expected:
            fail("transport_concurrent_drift")
        os.replace(staged, path)
    finally:
        if os.path.exists(staged):
            os.unlink(staged)


def transport_restore(paths: dict[str, Path]) -> None:
    journal = paths["state"] / "transport-backup.json"
    if not journal.is_file() or journal.is_symlink() or journal.stat().st_mode & 0o777 != 0o600:
        fail("transport_backup_missing_or_unsafe")
    data = json.loads(journal.read_text())
    replacements = []
    for name in ("alias", "receipt"):
        old = base64.b64decode(data[name]["before"], validate=True)
        new = base64.b64decode(data[name]["after"], validate=True)
        path = paths[name]
        if not path.is_file() or path.is_symlink() or path.stat().st_mode & 0o777 != 0o600:
            fail("transport_recovery_drift")
        current = path.read_bytes()
        if current not in (old, new):
            fail("transport_recovery_drift")
        replacements.append((path, current, old))
    # Validate both before restoring either; retain journal for interrupted recovery.
    for path, current, old in replacements:
        replace_exact(path, current, old)
    journal.unlink()


def migrate_transport() -> bool:
    paths = layout(canonical_home())
    validate_key_prestate(paths)
    receipt = load_receipt(paths)
    if not exact_managed(paths, receipt):
        fail("managed_bytes_drift")
    if receipt.get("transport") == "tailscale-nc":
        validate_local_profile(paths, receipt)
        validate_effective_policy(paths, receipt)
        return False
    if "transport" in receipt:
        fail("unsupported_transport")
    old_alias = render_alias_config(receipt["host"], receipt["user"])
    if paths["alias"].read_bytes() != old_alias:
        fail("legacy_alias_not_exact")
    tailscale_cli()
    new_alias = render_proxy_config(receipt["host"], receipt["user"])
    old_receipt = paths["receipt"].read_bytes()
    receipt["transport"] = "tailscale-nc"
    receipt["managed"]["alias"] = sha256_bytes(new_alias)
    new_receipt = (json.dumps(receipt, sort_keys=True) + "\n").encode()
    journal = paths["state"] / "transport-backup.json"
    # A prior interrupted transaction must be explicitly recovered, never overwritten.
    backup = {}
    for name, before, after in (("alias", old_alias, new_alias),
                                ("receipt", old_receipt, new_receipt)):
        backup[name] = {"before": base64.b64encode(before).decode(),
                        "after": base64.b64encode(after).decode()}
    atomic_write(journal, (json.dumps(backup, sort_keys=True) + "\n").encode(), 0o600)
    try:
        replace_exact(paths["alias"], old_alias, new_alias)
        replace_exact(paths["receipt"], old_receipt, new_receipt)
        doctor()
    except Exception:
        transport_restore(paths)
        raise
    return True


def directory_fd(path: Path) -> int:
    # macOS' two canonical system aliases are not user-controlled parents.
    parts = path.absolute().parts[1:]
    if parts and parts[0] in ("var", "tmp"):
        parts = ("private", *parts)
    held = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in parts:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=held)
            os.close(held)
            held = child
        return held
    except OSError as exc:
        os.close(held)
        raise ProfileError("unsafe_managed_parent") from exc


def read_file(path: Path, *, private: bool = True) -> bytes:
    parent = directory_fd(path.parent)
    try:
        descriptor = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
        with os.fdopen(descriptor, "rb") as handle:
            info = os.fstat(handle.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or info.st_mode & 0o022
                    or info.st_nlink != 1 or info.st_size > MAX_MANAGED_FILE
                    or (private and info.st_mode & 0o777 != 0o600)):
                fail("managed_file_unsafe")
            raw = handle.read(MAX_MANAGED_FILE + 1)
            final = os.fstat(handle.fileno())
            named = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
            if (len(raw) != info.st_size or len(raw) > MAX_MANAGED_FILE
                    or (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
                    != (final.st_dev, final.st_ino, final.st_size, final.st_mtime_ns, final.st_ctime_ns)
                    or (final.st_dev, final.st_ino) != (named.st_dev, named.st_ino)):
                fail("managed_file_drift")
            return raw
    finally:
        os.close(parent)


def ensure_directory(path: Path, home: Path) -> None:
    held = directory_fd(home)
    try:
        for part in path.relative_to(home).parts:
            try:
                os.mkdir(part, mode=0o700, dir_fd=held)
                os.fsync(held)
            except FileExistsError:
                pass
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=held)
            os.close(held)
            held = child
            info = os.fstat(held)
            if info.st_uid != os.getuid() or info.st_mode & 0o022:
                fail("unsafe_managed_parent")
    finally:
        os.close(held)


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    parent = directory_fd(path.parent)
    staged = ".windows-host." + secrets.token_hex(12)
    created = False
    try:
        descriptor = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                             mode, dir_fd=parent)
        created = True
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb", closefd=True) as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        # link(2) publishes complete bytes only if the target is still absent.
        # A preflight exists() check followed by replace() clobbers a concurrent
        # owner file (including a symlink) created while we stage the payload.
        try:
            os.link(staged, path.name, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
        except FileExistsError:
            fail("managed_target_collision")
        os.fsync(parent)
        current = directory_fd(path.parent)
        try:
            if (os.fstat(current).st_dev, os.fstat(current).st_ino) != (os.fstat(parent).st_dev, os.fstat(parent).st_ino):
                fail("unsafe_managed_parent")
        finally:
            os.close(current)
    finally:
        if created:
            os.unlink(staged, dir_fd=parent)
        os.close(parent)


def layout(home: Path) -> dict[str, Path]:
    ssh = home / ".ssh"
    return {
        "ssh": ssh,
        "private": ssh / "windows-host_ed25519",
        "public": ssh / "windows-host_ed25519.pub",
        "main": ssh / "config",
        "config_dir": ssh / "config.d",
        "alias": ssh / "config.d/windows-host.conf",
        "known": ssh / "known_hosts_windows-host",
        "state": home / "AIDev/state/windows-host-ssh-client",
        "receipt": home / "AIDev/state/windows-host-ssh-client/receipt.json",
        "enrollment": home / "AIDev/state/windows-host-ssh-client/enrollment.json",
    }


def validate_key_prestate(paths: dict[str, Path]) -> None:
    ssh = paths["ssh"]
    if not ssh.is_dir() or ssh.is_symlink() or (ssh.stat().st_mode & 0o777) != 0o700:
        fail("ssh_directory_not_exact")
    for name, mode in (("private", 0o600), ("public", 0o644)):
        path = paths[name]
        if not path.is_file() or path.is_symlink() or (path.stat().st_mode & 0o777) != mode:
            fail("dedicated_key_prestate_not_exact")


def validate_profile_parents(paths: dict[str, Path]) -> None:
    home = paths["ssh"].parent
    for target in (paths["config_dir"], paths["state"]):
        for parent in (target, *target.parents):
            if parent == home:
                break
            if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
                fail("unsafe_managed_parent")


def shared_include(data: bytes) -> bool:
    # Only a first, top-level directive is unambiguously outside Host/Match.
    for line in data.splitlines():
        line = line.strip()
        if not line or line.startswith(b"#"):
            continue
        return line.lower() == b"include config.d/windows-host.conf"
    return False


def enrollment_main(before: bytes | None) -> bytes:
    if before is not None and shared_include(before):
        return before
    # Do not activate unrelated fragments merely because config.d exists.
    # Reset the include's Host context before replaying the owner's bytes.
    return b"Include config.d/windows-host.conf\nHost *\n" + (before or b"")


def read_main(paths: dict[str, Path]) -> bytes | None:
    path = paths["main"]
    if not path.exists() and not path.is_symlink():
        return None
    return read_file(path, private=False)


def prepare(fingerprint: str, user: str) -> tuple[str, str, str, str]:
    if not EXPECTED_FINGERPRINT.fullmatch(fingerprint):
        fail("invalid_expected_fingerprint")
    if not EXPECTED_USER.fullmatch(user):
        fail("invalid_runtime_user")
    home = canonical_home()
    paths = layout(home)
    validate_key_prestate(paths)
    validate_profile_parents(paths)
    read_main(paths)
    if any(paths[name].exists() or paths[name].is_symlink()
           for name in ("alias", "known", "receipt", "enrollment")):
        fail("managed_prestate_collision")
    host, key_type, public_body = scan_ed25519_host_key(resolve_windows_peer())
    observed = public_blob_fingerprint(public_body)
    if observed != fingerprint:
        fail("independent_host_fingerprint_mismatch")
    return host, key_type, public_body, observed


def apply_profile(fingerprint: str, user: str) -> bool:
    home = canonical_home()
    paths = layout(home)
    validate_profile_parents(paths)
    if paths["receipt"].exists() or paths["receipt"].is_symlink():
        receipt = load_receipt(paths)
        if receipt.get("hostFingerprint") != fingerprint or receipt.get("user") != user:
            fail("already_applied_runtime_identity_mismatch")
        validate_key_prestate(paths)
        validate_local_profile(paths, receipt)
        validate_effective_policy(paths, receipt)
        return False
    if paths["enrollment"].exists() or paths["enrollment"].is_symlink():
        plan = load_enrollment(paths)
        if plan["hostFingerprint"] != fingerprint or plan["user"] != user:
            fail("preparing_runtime_identity_mismatch")
        validate_key_prestate(paths)
    else:
        host, key_type, public_body, observed = prepare(fingerprint, user)
        before = read_main(paths)
        main = enrollment_main(before)
        alias = render_alias_config(host, user)
        known = hashed_known_host(host, key_type, public_body)
        plan = {"schema": 1, "status": "preparing", "host": host, "user": user,
                "hostFingerprint": observed, "sharedConfig": True,
                "managed": {"config": sha256_bytes(main), "alias": sha256_bytes(alias),
                            "knownHosts": sha256_bytes(known)},
                "images": {name: base64.b64encode(data).decode("ascii") for name, data in
                           (("main", main), ("alias", alias), ("known", known))},
                "mainBefore": None if before is None else base64.b64encode(before).decode("ascii")}
        ensure_directory(paths["state"], home)
        # Durable ownership precedes EVERY profile publication. It survives
        # failure, including final receipt publication, for retry or rollback.
        atomic_write(paths["enrollment"], (json.dumps(plan, sort_keys=True) + "\n").encode(), 0o600)
    images = {name: base64.b64decode(value, validate=True) for name, value in plan["images"].items()}
    journal_bytes = (json.dumps(plan, sort_keys=True) + "\n").encode()
    if read_file(paths["enrollment"]) != journal_bytes:
        fail("preparing_journal_drift")
    ensure_directory(paths["config_dir"], home)
    publish_main(paths, plan, images["main"])
    for name in ("alias", "known"):
        path = paths[name]
        if path.exists() or path.is_symlink():
            if not exact_file(path, sha256_bytes(images[name])):
                fail("preparing_payload_drift")
        else:
            atomic_write(path, images[name], 0o600)
    receipt = {key: value for key, value in plan.items() if key not in ("images", "mainBefore")}
    receipt["status"] = "applied"
    receipt["enrollmentHash"] = sha256_bytes(journal_bytes)
    validate_local_profile(paths, receipt)
    validate_effective_policy(paths, receipt)
    if not exact_file(paths["enrollment"], receipt["enrollmentHash"]):
        fail("preparing_journal_drift")
    atomic_write(paths["receipt"], (json.dumps(receipt, sort_keys=True) + "\n").encode(), 0o600)
    return True


def exact_file(path: Path, digest: str) -> bool:
    try:
        return sha256_bytes(read_file(path)) == digest
    except (ProfileError, OSError):
        return False


def load_enrollment(paths: dict[str, Path]) -> dict:
    path = paths["enrollment"]
    if not path.is_file() or path.is_symlink() or path.stat().st_mode & 0o777 != 0o600:
        fail("enrollment_journal_unsafe")
    try:
        plan = json.loads(read_file(path))
        if (plan["schema"] != 1 or plan["status"] != "preparing"
                or set(plan["images"]) != {"main", "alias", "known"}
                or not EXPECTED_USER.fullmatch(plan["user"])
                or not EXPECTED_FINGERPRINT.fullmatch(plan["hostFingerprint"])):
            fail("enrollment_journal_invalid")
        for name, digest in (("main", "config"), ("alias", "alias"), ("known", "knownHosts")):
            image = base64.b64decode(plan["images"][name], validate=True)
            if sha256_bytes(image) != plan["managed"][digest]:
                fail("enrollment_journal_invalid")
        before = (None if plan["mainBefore"] is None
                  else base64.b64decode(plan["mainBefore"], validate=True))
        if (base64.b64decode(plan["images"]["main"], validate=True) != enrollment_main(before)
                or base64.b64decode(plan["images"]["alias"], validate=True)
                != render_alias_config(plan["host"], plan["user"])):
            fail("enrollment_journal_invalid")
        validate_pin(base64.b64decode(plan["images"]["known"], validate=True),
                     plan["host"], plan["hostFingerprint"])
        return plan
    except (KeyError, TypeError, ValueError) as exc:
        raise ProfileError("enrollment_journal_invalid") from exc


def publish_main(paths: dict[str, Path], plan: dict, after: bytes) -> None:
    current = read_main(paths)
    before = (None if plan["mainBefore"] is None
              else base64.b64decode(plan["mainBefore"], validate=True))
    if current == after or (current is not None and shared_include(current) and current != before):
        return
    held = paths["state"] / "config-before"
    if before is not None:
        if current == before:
            identity = paths["main"].lstat()
            rename_exclusive(paths["main"], held)
            captured = held.lstat()
            if ((captured.st_dev, captured.st_ino) != (identity.st_dev, identity.st_ino)
                    or not stat.S_ISREG(captured.st_mode) or read_file(held, private=False) != before):
                try:
                    rename_exclusive(held, paths["main"])
                except OSError:
                    pass
                fail("preparing_shared_config_drift")
        elif current is not None or not held.is_file() or held.is_symlink() or read_file(held, private=False) != before:
            fail("preparing_shared_config_drift")
    elif current is not None:
        fail("preparing_shared_config_drift")
    atomic_write(paths["main"], after, 0o600)


def load_receipt(paths: dict[str, Path]) -> dict:
    receipt = paths["receipt"]
    if not receipt.is_file() or receipt.is_symlink() or (receipt.stat().st_mode & 0o777) != 0o600:
        fail("runtime_receipt_missing_or_unsafe")
    try:
        data = json.loads(read_file(receipt))
    except (ValueError, UnicodeError) as exc:
        raise ProfileError("runtime_receipt_state_invalid") from exc
    if not isinstance(data, dict) or data.get("schema") != 1 or data.get("status") != "applied":
        fail("runtime_receipt_state_invalid")
    return data


def exact_managed(paths: dict[str, Path], receipt: dict, *, include_main: bool = True) -> bool:
    expected = receipt["managed"]
    checks = (("main", "config"), ("alias", "alias"), ("known", "knownHosts"))
    for path_name, hash_name in checks:
        if path_name == "main" and not include_main:
            continue
        if path_name == "main" and receipt.get("sharedConfig") is True:
            if not shared_include(read_main(paths) or b""):
                return False
            continue
        path = paths[path_name]
        if not exact_file(path, expected[hash_name]):
            return False
    return True


def doctor() -> None:
    home = canonical_home()
    paths = layout(home)
    validate_key_prestate(paths)
    validate_profile_parents(paths)
    receipt = load_receipt(paths)
    validate_local_profile(paths, receipt)
    current_host = resolve_windows_peer()
    if current_host != receipt["host"]:
        fail("runtime_peer_drift")
    validate_effective_policy(paths, receipt)
    smoke = subprocess.run(
        ["/usr/bin/ssh", "-T", "-o", "BatchMode=yes",
         "-o", "StrictHostKeyChecking=yes", "-o", "HostKeyAlgorithms=ssh-ed25519",
         "-o", f"UserKnownHostsFile={paths['known']}", "-o", "GlobalKnownHostsFile=/dev/null",
         "-o", "PreferredAuthentications=publickey", "-o", "PasswordAuthentication=no",
         "-o", "KbdInteractiveAuthentication=no", "-o", "IdentitiesOnly=yes",
         "-o", "ForwardAgent=no", "-o", "PermitLocalCommand=no",
         ALIAS, "printf BRIDGE_STRICT_OK"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        text=True, timeout=20,
    ).stdout
    if smoke != "BRIDGE_STRICT_OK":
        fail("strict_key_only_smoke_failed")


def validate_effective_policy(paths: dict[str, Path], receipt: dict) -> None:
    """Local OpenSSH expansion only; no peer lookup, keyscan or connection.

    Dedicated Include ordering fixes first-value options but IdentityFile and
    forwarding directives can accumulate from later owner configuration.
    Canonicalization is disabled for this diagnostic to avoid DNS resolution.
    """
    proxy = receipt.get("transport") == "tailscale-nc"
    effective = subprocess.run(
        ["/usr/bin/ssh", "-G", "-o", "CanonicalizeHostname=no", ALIAS], check=True,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10,
    ).stdout.splitlines()
    required = {
        "stricthostkeychecking true",
        "passwordauthentication no",
        "kbdinteractiveauthentication no",
        "identitiesonly yes",
        "forwardagent no",
        "preferredauthentications publickey",
        "permitlocalcommand no",
        "forwardx11 no",
    }
    if proxy:
        required.update({f"proxycommand {PROXY}", "hostkeyalgorithms ssh-ed25519",
                         "globalknownhostsfile /dev/null", "batchmode yes",
                         f"userknownhostsfile {paths['known']}"})
    if not required.issubset(set(effective)):
        fail("effective_ssh_policy_drift")
    fields = {}
    for line in effective:
        key, _, value = line.partition(" ")
        fields.setdefault(key, []).append(value.strip())
    if (fields.get("identityfile") not in ([str(paths["private"])], ["~/.ssh/windows-host_ed25519"])
            or fields.get("pubkeyauthentication") not in (["yes"], ["true"])
            or fields.get("userknownhostsfile") not in ([str(paths["known"])], ["~/.ssh/known_hosts_windows-host"])
            or fields.get("hostname") != [receipt["host"]]
            or fields.get("user") != [receipt["user"]]
            or any(name in fields for name in ("localforward", "remoteforward", "dynamicforward"))
            or fields.get("proxyjump", ["none"]) != ["none"]
            or fields.get("tunnel", ["false"]) not in (["false"], ["no"])
            or (not proxy and fields.get("proxycommand", ["none"]) != ["none"])):
        fail("effective_ssh_policy_drift")


def validate_local_profile(paths: dict[str, Path], receipt: dict) -> None:
    if not exact_managed(paths, receipt):
        fail("managed_bytes_drift")
    current_host = receipt["host"]
    proxy = receipt.get("transport") == "tailscale-nc"
    if receipt.get("transport") not in (None, "tailscale-nc"):
        fail("unsupported_transport")
    validate_pin(read_file(paths["known"]), current_host, receipt["hostFingerprint"])
    expected_alias = (render_proxy_config if proxy else render_alias_config)(
        current_host, receipt["user"])
    if (read_file(paths["alias"]) != expected_alias
            or (not receipt.get("sharedConfig") and read_main(paths) != render_main_config())):
        fail("managed_policy_drift")


def validate_pin(data: bytes, host: str, fingerprint: str) -> None:
    # Enrollment keeps its independent scan; local reconciliation validates the
    # retained pin without requiring a healthy Windows host or live network.
    rows = data.decode("ascii").splitlines()
    if len(rows) != 1:
        fail("known_host_pin_invalid")
    row = rows[0].split()
    if len(row) != 3 or row[1] != "ssh-ed25519":
        fail("known_host_pin_invalid")
    parts = row[0].split("|")
    try:
        if len(parts) != 4 or parts[:2] != ["", "1"]:
            fail("known_host_pin_invalid")
        salt, host_digest = (base64.b64decode(value, validate=True) for value in parts[2:])
    except ValueError as exc:
        raise ProfileError("known_host_pin_invalid") from exc
    if (len(salt) != 20 or len(host_digest) != 20
            or not hmac.compare_digest(host_digest, hmac.new(
                salt, host.encode(), hashlib.sha1).digest())
            or public_blob_fingerprint(row[2]) != fingerprint):
        fail("pinned_host_key_drift")


def rename_exclusive(source: Path, destination: Path) -> None:
    """Move the actual directory entry without replacing any destination."""
    libc = ctypes.CDLL(None, use_errno=True)
    try:
        rename = libc.renameatx_np
    except AttributeError:
        fail("exclusive_rename_unavailable")
    rename.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    rename.restype = ctypes.c_int
    source_parent = directory_fd(source.parent)
    try:
        destination_parent = directory_fd(destination.parent)
        try:
            if rename(source_parent, os.fsencode(source.name), destination_parent,
                      os.fsencode(destination.name), 4) != 0:
                raise OSError(ctypes.get_errno(), "exclusive rename refused")
            os.fsync(source_parent)
            os.fsync(destination_parent)
        finally:
            os.close(destination_parent)
    finally:
        os.close(source_parent)


def rollback() -> None:
    home = canonical_home()
    paths = layout(home)
    validate_profile_parents(paths)
    pending = not paths["receipt"].exists() and not paths["receipt"].is_symlink()
    record_name = "enrollment" if pending else "receipt"
    original_record = read_file(paths[record_name])
    receipt = load_enrollment(paths) if pending else load_receipt(paths)
    if json.loads(original_record) != receipt:
        fail("rollback_refuses_managed_drift")
    if not pending and not exact_managed(paths, receipt, include_main=False):
        fail("rollback_refuses_managed_drift")
    if pending and receipt["mainBefore"] is not None:
        held = paths["state"] / "config-before"
        # An interruption between capture and publication must not strand the
        # owner's pre-existing config. Never replace a newer owner entry.
        if read_main(paths) is None and held.exists():
            before = base64.b64decode(receipt["mainBefore"], validate=True)
            if held.is_symlink() or not held.is_file() or read_file(held, private=False) != before:
                fail("rollback_refuses_managed_drift")
            rename_exclusive(held, paths["main"])
    # The top-level Include is shared infrastructure, not an exclusive alias
    # payload. Retain it even when currently empty: a new profile may appear
    # immediately after an emptiness check. Owner edits to it are also retained.
    names = [name for name in ("known", "alias", "receipt", "enrollment")
             if paths[name].exists() or paths[name].is_symlink()]
    hashes = {"known": receipt["managed"]["knownHosts"],
              "alias": receipt["managed"]["alias"]}
    for name in names:
        if name in ("receipt", "enrollment"):
            if name == record_name:
                hashes[name] = sha256_bytes(original_record)
            else:
                if "enrollmentHash" not in receipt:
                    fail("rollback_refuses_managed_drift")
                hashes[name] = receipt["enrollmentHash"]
        if not exact_file(paths[name], hashes[name]):
            fail("rollback_refuses_managed_drift")
    identities = {name: paths[name].lstat() for name in names}
    if paths["state"].is_symlink() or not paths["state"].is_dir():
        fail("unsafe_managed_parent")
    recovery = Path(tempfile.mkdtemp(prefix="rollback-", dir=paths["state"]))
    captured = []
    try:
        for name in names:
            held = recovery / name
            rename_exclusive(paths[name], held)
            captured.append(name)
            actual, expected = held.lstat(), identities[name]
            if (not stat.S_ISREG(actual.st_mode) or actual.st_mode & 0o777 != 0o600
                    or (actual.st_dev, actual.st_ino) != (expected.st_dev, expected.st_ino)
                    or sha256_bytes(read_file(held)) != hashes[name]):
                fail("rollback_capture_drift")
        if any(paths[name].exists() or paths[name].is_symlink() for name in names):
            fail("rollback_target_reappeared")
        receipt["status"] = "rolled_back"
        receipt.pop("images", None)
        receipt.pop("mainBefore", None)
        receipt["rollbackRecovery"] = recovery.name
        atomic_write(paths["receipt"],
                     (json.dumps(receipt, sort_keys=True) + "\n").encode(), 0o600)
        if any(paths[name].exists() or paths[name].is_symlink() for name in ("known", "alias")):
            fail("rollback_target_reappeared")
    except Exception as exc:
        # Restore the actual captured entries only into absent slots. A racing
        # replacement stays in place; its predecessor remains in private
        # recovery. Renames preserve symlinks/directories without following them.
        for name in reversed(captured):
            try:
                rename_exclusive(recovery / name, paths[name])
            except OSError:
                pass
        raise ProfileError("rollback_interrupted_recovery_retained") from exc


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    sub = result.add_subparsers(dest="command", required=True)
    for name in ("prepare", "apply"):
        item = sub.add_parser(name)
        item.add_argument("--fingerprint", required=True)
        item.add_argument("--user", required=True)
    sub.add_parser("doctor")
    sub.add_parser("rollback")
    sub.add_parser("migrate-transport")
    sub.add_parser("restore-transport")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "prepare":
            prepare(args.fingerprint, args.user)
            print("prepare_pass=true")
        elif args.command == "apply":
            changed = apply_profile(args.fingerprint, args.user)
            print("apply_pass=true")
            print(f"apply_noop={'false' if changed else 'true'}")
        elif args.command == "doctor":
            doctor()
            print("doctor_pass=true")
            print("strict_host_key_checking=true")
            print("key_only_smoke=true")
        elif args.command == "migrate-transport":
            changed = migrate_transport()
            print("transport_pass=true")
            print(f"transport_noop={'false' if changed else 'true'}")
        elif args.command == "restore-transport":
            transport_restore(layout(canonical_home()))
            print("transport_restore_pass=true")
        elif args.command == "rollback":
            rollback()
            print("rollback_pass=true")
        return 0
    except (ProfileError, subprocess.SubprocessError, json.JSONDecodeError,
            OSError, KeyError, ValueError) as exc:
        code = str(exc) if isinstance(exc, ProfileError) else "bounded_runtime_failure"
        print("status=FAIL", file=sys.stderr)
        print(f"blocker={code}", file=sys.stderr)
        print("next_action=inspect_private_enrollment_and_retry_or_rollback", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
