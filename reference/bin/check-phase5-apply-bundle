def validate_initial_implementation(directory):
    require(
        git_at(directory, "rev-parse", INITIAL_IMPLEMENTATION + "^")
        == BASE,
        "initial_implementation_parent",
    )
    require(
        commit_scope(directory, INITIAL_IMPLEMENTATION)
        == IMPLEMENTATION_SCOPE,
        "initial_implementation_scope",
    )
    require(
        metadata(directory, INITIAL_IMPLEMENTATION) == EXECUTOR_METADATA,
        "initial_implementation_metadata",
    )


def validate_first_correction(directory):
    require(
        git_at(directory, "rev-parse", FIRST_CORRECTION + "^")
        == INITIAL_IMPLEMENTATION,
        "first_correction_parent",
    )
    require(
        commit_scope(directory, FIRST_CORRECTION)
        == FIRST_CORRECTION_SCOPE,
        "first_correction_scope",
    )
    require(
        metadata(directory, FIRST_CORRECTION) == EXECUTOR_METADATA,
        "first_correction_metadata",
    )


def validate_second_correction(directory):
    require(
        git_at(directory, "rev-parse", SECOND_CORRECTION + "^")
        == FIRST_CORRECTION,
        "second_correction_parent",
    )
    require(
        commit_scope(directory, SECOND_CORRECTION)
        == FOLLOWUP_CORRECTION_SCOPE,
        "second_correction_scope",
    )
    require(
        metadata(directory, SECOND_CORRECTION) == EXECUTOR_METADATA,
        "second_correction_metadata",
    )


def validate_third_correction(directory):
    require(
        git_at(directory, "rev-parse", THIRD_CORRECTION + "^")
        == SECOND_CORRECTION,
        "third_correction_parent",
    )
    require(
        commit_scope(directory, THIRD_CORRECTION)
        == FINAL_CORRECTION_SCOPE,
        "third_correction_scope",
    )
    require(
        metadata(directory, THIRD_CORRECTION) == EXECUTOR_METADATA,
        "third_correction_metadata",
    )


def validate_finalization_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == ORIGINAL_EVIDENCE_COMMIT,
        "finalization_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == FINALIZATION_CORRECTION_SCOPE,
        "finalization_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "finalization_correction_metadata",
    )


def validate_determinism_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == REJECTED_REVIEW_HEAD,
        "determinism_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == DETERMINISM_CORRECTION_SCOPE,
        "determinism_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "determinism_correction_metadata",
    )
    corrected_preparation_evidence_contract(
        strict_git_json(
            directory,
            correction,
            EVIDENCE,
            "corrected_preparation_evidence_json",
        ),
        directory,
    )


def validate_directory_chain_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == DIRECTORY_CHAIN_BASE,
        "directory_chain_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == DIRECTORY_CHAIN_CORRECTION_SCOPE,
        "directory_chain_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "directory_chain_correction_metadata",
    )


def validate_review_pair(directory, head="HEAD"):
    validate_historical_base(directory, head)
    require(
        git_at(directory, "rev-list", "--merges", BASE + ".." + head)
        == "",
        "apply_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                BASE + ".." + head,
            ).splitlines(),
        )
    )
    require(len(commits) >= 9, "determinism_pair_commit_count")
    (
        initial,
        first_correction,
        second_correction,
        third_correction,
        original_evidence,
        correction,
        final_correction_evidence_commit,
        determinism_correction,
        determinism_evidence_commit,
    ) = commits[:9]
    require(
        initial == INITIAL_IMPLEMENTATION,
        "initial_implementation_commit",
    )
    require(
        first_correction == FIRST_CORRECTION,
        "first_correction_commit",
    )
    require(
        second_correction == SECOND_CORRECTION,
        "second_correction_commit",
    )
    require(
        third_correction == THIRD_CORRECTION,
        "third_correction_commit",
    )
    require(
        original_evidence == ORIGINAL_EVIDENCE_COMMIT,
        "original_evidence_commit",
    )
    validate_initial_implementation(directory)
    validate_first_correction(directory)
    validate_second_correction(directory)
    validate_third_correction(directory)
    require(
        git_at(directory, "rev-parse", original_evidence + "^")
        == THIRD_CORRECTION,
        "original_evidence_parent",
    )
    require(
        commit_scope(directory, original_evidence) == EVIDENCE_SCOPE,
        "original_evidence_scope",
    )
    require(
        metadata(directory, original_evidence) == EXECUTOR_METADATA,
        "original_evidence_metadata",
    )
    original_value = strict_git_json(
        directory,
        original_evidence,
        EVIDENCE,
        "original_evidence_json",
    )
    evidence_value_contract(
        original_value,
        directory,
        THIRD_CORRECTION,
        "drop-two-task-commits",
    )
    validate_finalization_correction(directory, correction)
    corrected_value = strict_git_json(
        directory,
        correction,
        EVIDENCE,
        "corrected_evidence_json",
    )
    evidence_value_contract(
        corrected_value,
        directory,
        THIRD_CORRECTION,
        "remove-unintegrated-review-branch-and-worktree",
    )
    require(
        git_at(
            directory,
            "rev-parse",
            final_correction_evidence_commit + "^",
        )
        == correction,
        "final_correction_evidence_parent",
    )
    require(
        commit_scope(directory, final_correction_evidence_commit)
        == FINAL_CORRECTION_EVIDENCE_SCOPE,
        "final_correction_evidence_scope",
    )
    require(
        metadata(directory, final_correction_evidence_commit)
        == EXECUTOR_METADATA,
        "final_correction_evidence_metadata",
    )
    final_value = strict_git_json(
        directory,
        final_correction_evidence_commit,
        FINAL_CORRECTION_EVIDENCE,
        "final_correction_evidence_json",
    )
    final_correction_evidence_contract(
        final_value,
        directory,
        correction,
    )
    require(
        final_correction_evidence_commit == REJECTED_REVIEW_HEAD,
        "rejected_review_head",
    )
    validate_determinism_correction(
        directory,
        determinism_correction,
    )
    require(
        git_at(
            directory,
            "rev-parse",
            determinism_evidence_commit + "^",
        )
        == determinism_correction,
        "determinism_evidence_parent",
    )
    require(
        commit_scope(directory, determinism_evidence_commit)
        == DETERMINISM_EVIDENCE_SCOPE,
        "determinism_evidence_scope",
    )
    require(
        metadata(directory, determinism_evidence_commit)
        == EXECUTOR_METADATA,
        "determinism_evidence_metadata",
    )
    determinism_evidence_contract(
        strict_git_json(
            directory,
            determinism_evidence_commit,
            DETERMINISM_EVIDENCE,
            "determinism_evidence_json",
        ),
        directory,
        determinism_correction,
    )
    require(
        determinism_evidence_commit == DIRECTORY_CHAIN_BASE,
        "directory_chain_base",
    )
    require(len(commits) >= 11, "directory_chain_pair_commit_count")
    directory_chain_correction = commits[9]
    directory_chain_evidence_commit = commits[10]
    validate_directory_chain_correction(
        directory,
        directory_chain_correction,
    )
    require(
        git_at(
            directory,
            "rev-parse",
            directory_chain_evidence_commit + "^",
        )
        == directory_chain_correction,
        "directory_chain_evidence_parent",
    )
    require(
        commit_scope(directory, directory_chain_evidence_commit)
        == DIRECTORY_CHAIN_EVIDENCE_SCOPE,
        "directory_chain_evidence_scope",
    )
    require(
        metadata(directory, directory_chain_evidence_commit)
        == EXECUTOR_METADATA,
        "directory_chain_evidence_metadata",
    )
    directory_chain_evidence_contract(
        strict_git_json(
            directory,
            directory_chain_evidence_commit,
            DIRECTORY_CHAIN_EVIDENCE,
            "directory_chain_evidence_json",
        ),
        directory,
        directory_chain_correction,
    )
    require(
        directory_chain_correction == DIRECTORY_CHAIN_IMPLEMENTATION
        and directory_chain_evidence_commit
        == DIRECTORY_CHAIN_REVIEW_HEAD,
        "directory_chain_review_identity",
    )
    return (
        commits,
        directory_chain_correction,
        directory_chain_evidence_commit,
    )


def protected_path(path):
    if path in {"AGENTS.md", "ARCHITECTURE.md", "README.md"}:
        return True
    if (
        path.startswith("codex/")
        or path.startswith("docs/phase-4")
        or path.startswith("docs/phase-5")
        or path.startswith("evidence/phase-4/")
        or path.startswith("evidence/phase-5/")
        or path.startswith("install-bundles/phase-4/")
        or path.startswith("policy/aid-admin")
        or path.startswith("skills/manage-workstation/")
        or path.startswith("Sources/AidAdmin")
        or path.startswith("tests/AidAdmin")
        or path.startswith("tests/fixtures/phase5")
        or path == "Package.swift"
        or path == "policy/sudoers.d/agent-first-mac-aid-admin"
        or path.startswith("bin/build-phase4")
        or path.startswith("bin/check-phase4")
        or path.startswith("bin/check-phase5")
        or path == "bin/codex-quarantine"
        or path.startswith("bin/phase4")
        or path.startswith("bin/phase5")
        or path.startswith("manifests/codex")
        or path.startswith("manifests/phase5")
        or path.startswith("manifests/trusted-repos")
    ):
        return True
    return False


def validate_apply_acceptance(directory, head="HEAD"):
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                APPLY_BUNDLE_ACCEPTANCE,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "apply_acceptance_not_ancestor",
    )
    commits, implementation, evidence = validate_review_pair(
        directory,
        DIRECTORY_CHAIN_REVIEW_HEAD,
    )
    require(
        len(commits) == 11
        and implementation == DIRECTORY_CHAIN_IMPLEMENTATION
        and evidence == DIRECTORY_CHAIN_REVIEW_HEAD,
        "accepted_review_chain",
    )
    require(
        git_at(
            directory,
            "rev-parse",
            APPLY_BUNDLE_ACCEPTANCE + "^",
        )
        == DIRECTORY_CHAIN_REVIEW_HEAD,
        "acceptance_parent",
    )
    require(
        commit_scope(directory, APPLY_BUNDLE_ACCEPTANCE)
        == ACCEPTANCE_SCOPE,
        "acceptance_scope",
    )
    require(
        metadata(directory, APPLY_BUNDLE_ACCEPTANCE)
        == COORDINATOR_METADATA,
        "acceptance_metadata",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            DIRECTORY_CHAIN_REVIEW_HEAD
            + ".."
            + APPLY_BUNDLE_ACCEPTANCE,
        )
        == "",
        "acceptance_merge",
    )
    validate_acceptance_value(
        strict_git_json(
            directory,
            APPLY_BUNDLE_ACCEPTANCE,
            ACCEPTANCE,
            "acceptance_json",
        ),
        DIRECTORY_CHAIN_IMPLEMENTATION,
        DIRECTORY_CHAIN_REVIEW_HEAD,
    )


def validate_hook_trust_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == APPLY_BUNDLE_ACCEPTANCE,
        "hook_trust_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == HOOK_TRUST_CORRECTION_SCOPE,
        "hook_trust_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "hook_trust_correction_metadata",
    )
    require(
        correction == HOOK_TRUST_IMPLEMENTATION,
        "hook_trust_correction_identity",
    )


def validate_hook_trust_followup(directory, followup):
    require(
        git_at(directory, "rev-parse", followup + "^")
        == HOOK_TRUST_IMPLEMENTATION,
        "hook_trust_followup_parent",
    )
    require(
        commit_scope(directory, followup)
        == HOOK_TRUST_FOLLOWUP_SCOPE,
        "hook_trust_followup_scope",
    )
    require(
        metadata(directory, followup) == EXECUTOR_METADATA,
        "hook_trust_followup_metadata",
    )
    require(
        followup == HOOK_TRUST_FOLLOWUP,
        "hook_trust_followup_identity",
    )


def validate_hook_trust_pair(directory, head="HEAD"):
    validate_apply_acceptance(directory, head)
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            APPLY_BUNDLE_ACCEPTANCE + ".." + head,
        )
        == "",
        "hook_trust_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                APPLY_BUNDLE_ACCEPTANCE + ".." + head,
            ).splitlines(),
        )
    )
    require(len(commits) >= 3, "hook_trust_pair_commit_count")
    correction, followup, evidence = commits[:3]
    validate_hook_trust_correction(directory, correction)
    validate_hook_trust_followup(directory, followup)
    require(
        git_at(directory, "rev-parse", evidence + "^") == followup,
        "hook_trust_evidence_parent",
    )
    require(
        commit_scope(directory, evidence) == HOOK_TRUST_EVIDENCE_SCOPE,
        "hook_trust_evidence_scope",
    )
    require(
        metadata(directory, evidence) == EXECUTOR_METADATA,
        "hook_trust_evidence_metadata",
    )
    hook_trust_evidence_contract(
        strict_git_json(
            directory,
            evidence,
            HOOK_TRUST_EVIDENCE,
            "hook_trust_evidence_json",
        ),
        directory,
        correction,
        followup,
    )
    require(
        evidence == HOOK_TRUST_REVIEW_HEAD,
        "hook_trust_evidence_identity",
    )
    return commits, correction, followup, evidence


def validate_byte_exactness_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == HOOK_TRUST_REVIEW_HEAD,
        "byte_exactness_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == BYTE_EXACTNESS_CORRECTION_SCOPE,
        "byte_exactness_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "byte_exactness_correction_metadata",
    )
    require(
        correction == BYTE_EXACTNESS_IMPLEMENTATION,
        "byte_exactness_correction_identity",
    )


def validate_byte_exactness_pair(directory, head="HEAD"):
    validate_apply_acceptance(directory, head)
    prior, correction, followup, evidence = validate_hook_trust_pair(
        directory,
        HOOK_TRUST_REVIEW_HEAD,
    )
    require(
        len(prior) == 3
        and correction == HOOK_TRUST_IMPLEMENTATION
        and followup == HOOK_TRUST_FOLLOWUP
        and evidence == HOOK_TRUST_REVIEW_HEAD,
        "hook_trust_review_history_shape",
    )
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                HOOK_TRUST_REVIEW_HEAD,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "byte_exactness_base_not_ancestor",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            HOOK_TRUST_REVIEW_HEAD + ".." + head,
        )
        == "",
        "byte_exactness_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                HOOK_TRUST_REVIEW_HEAD + ".." + head,
            ).splitlines(),
        )
    )
    require(len(commits) >= 2, "byte_exactness_pair_commit_count")
    implementation, byte_evidence = commits[:2]
    validate_byte_exactness_correction(directory, implementation)
    require(
        git_at(directory, "rev-parse", byte_evidence + "^")
        == implementation,
        "byte_exactness_evidence_parent",
    )
    require(
        commit_scope(directory, byte_evidence)
        == BYTE_EXACTNESS_EVIDENCE_SCOPE,
        "byte_exactness_evidence_scope",
    )
    require(
        metadata(directory, byte_evidence) == EXECUTOR_METADATA,
        "byte_exactness_evidence_metadata",
    )
    byte_exactness_evidence_contract(
        strict_git_json(
            directory,
            byte_evidence,
            BYTE_EXACTNESS_EVIDENCE,
            "byte_exactness_evidence_json",
        ),
        directory,
        implementation,
    )
    require(
        byte_evidence == BYTE_EXACTNESS_REVIEW_HEAD,
        "byte_exactness_evidence_identity",
    )
    return commits, implementation, byte_evidence


def validate_actual_layout_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == BYTE_EXACTNESS_REVIEW_HEAD,
        "actual_layout_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == ACTUAL_LAYOUT_CORRECTION_SCOPE,
        "actual_layout_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "actual_layout_correction_metadata",
    )


def validate_actual_layout_pair(directory, head="HEAD"):
    validate_apply_acceptance(directory, head)
    prior, implementation, evidence = validate_byte_exactness_pair(
        directory,
        BYTE_EXACTNESS_REVIEW_HEAD,
    )
    require(
        len(prior) == 2
        and implementation == BYTE_EXACTNESS_IMPLEMENTATION
        and evidence == BYTE_EXACTNESS_REVIEW_HEAD,
        "byte_exactness_review_history_shape",
    )
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                BYTE_EXACTNESS_REVIEW_HEAD,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "actual_layout_base_not_ancestor",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            BYTE_EXACTNESS_REVIEW_HEAD + ".." + head,
        )
        == "",
        "actual_layout_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                BYTE_EXACTNESS_REVIEW_HEAD + ".." + head,
            ).splitlines(),
        )
    )
    require(len(commits) >= 2, "actual_layout_pair_commit_count")
    correction, layout_evidence = commits[:2]
    validate_actual_layout_correction(directory, correction)
    require(
        git_at(directory, "rev-parse", layout_evidence + "^")
        == correction,
        "actual_layout_evidence_parent",
    )
    require(
        commit_scope(directory, layout_evidence)
        == ACTUAL_LAYOUT_EVIDENCE_SCOPE,
        "actual_layout_evidence_scope",
    )
    require(
        metadata(directory, layout_evidence) == EXECUTOR_METADATA,
        "actual_layout_evidence_metadata",
    )
    actual_layout_evidence_contract(
        strict_git_json(
            directory,
            layout_evidence,
            ACTUAL_LAYOUT_EVIDENCE,
            "actual_layout_evidence_json",
        ),
        directory,
        correction,
    )
    return commits, correction, layout_evidence


def validate_post_reconciliation_status(directory, head="HEAD"):
    prior, implementation, evidence = validate_actual_layout_pair(
        directory,
        ACTUAL_LAYOUT_REVIEW_HEAD,
    )
    require(
        len(prior) == 2
        and implementation == ACTUAL_LAYOUT_IMPLEMENTATION
        and evidence == ACTUAL_LAYOUT_REVIEW_HEAD,
        "actual_layout_review_history_shape",
    )
    require(
        git_at(
            directory,
            "rev-parse",
            POST_RECONCILIATION_STATUS + "^",
        )
        == ACTUAL_LAYOUT_REVIEW_HEAD,
        "post_reconciliation_status_parent",
    )
    require(
        commit_scope(directory, POST_RECONCILIATION_STATUS) == set(),
        "post_reconciliation_status_scope",
    )
    require(
        metadata(directory, POST_RECONCILIATION_STATUS)
        == COORDINATOR_METADATA,
        "post_reconciliation_status_metadata",
    )
    require(
        git_at(
            directory,
            "rev-parse",
            POST_RECONCILIATION_BASE + "^",
        )
        == POST_RECONCILIATION_STATUS,
        "post_reconciliation_base_parent",
    )
    require(
        commit_scope(directory, POST_RECONCILIATION_BASE) == set(),
        "post_reconciliation_base_scope",
    )
    require(
        metadata(directory, POST_RECONCILIATION_BASE)
        == COORDINATOR_METADATA,
        "post_reconciliation_base_metadata",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--reverse",
            ACTUAL_LAYOUT_REVIEW_HEAD
            + ".."
            + POST_RECONCILIATION_BASE,
        ).splitlines()
        == [
            POST_RECONCILIATION_STATUS,
            POST_RECONCILIATION_BASE,
        ],
        "post_reconciliation_status_chain",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            ACTUAL_LAYOUT_REVIEW_HEAD
            + ".."
            + POST_RECONCILIATION_BASE,
        )
        == "",
        "post_reconciliation_status_merge",
    )
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                POST_RECONCILIATION_BASE,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "post_reconciliation_base_not_ancestor",
    )


def validate_post_reconciliation_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == POST_RECONCILIATION_BASE,
        "post_reconciliation_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == POST_RECONCILIATION_CORRECTION_SCOPE,
        "post_reconciliation_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "post_reconciliation_correction_metadata",
    )


def validate_post_reconciliation_pair(directory, head="HEAD"):
    validate_post_reconciliation_status(directory, head)
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            POST_RECONCILIATION_BASE + ".." + head,
        )
        == "",
        "post_reconciliation_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                POST_RECONCILIATION_BASE + ".." + head,
            ).splitlines(),
        )
    )
    require(
        len(commits) >= 2,
        "post_reconciliation_pair_commit_count",
    )
    implementation, evidence = commits[:2]
    validate_post_reconciliation_correction(
        directory,
        implementation,
    )
    require(
        git_at(directory, "rev-parse", evidence + "^")
        == implementation,
        "post_reconciliation_evidence_parent",
    )
    require(
        commit_scope(directory, evidence)
        == POST_RECONCILIATION_EVIDENCE_SCOPE,
        "post_reconciliation_evidence_scope",
    )
    require(
        metadata(directory, evidence) == EXECUTOR_METADATA,
        "post_reconciliation_evidence_metadata",
    )
    post_reconciliation_evidence_contract(
        strict_git_json(
            directory,
            evidence,
            POST_RECONCILIATION_EVIDENCE,
            "post_reconciliation_evidence_json",
        ),
        directory,
        implementation,
    )
    return commits, implementation, evidence


def validate_rejected_post_reconciliation_pair(directory, head="HEAD"):
    # Preserve the established earliest fail-closed boundary for histories
    # that do not contain the accepted post-reconciliation base.
    validate_post_reconciliation_status(directory, head)
    commits, implementation, evidence = (
        validate_post_reconciliation_pair(
            directory,
            POST_RECONCILIATION_REVIEW_HEAD,
        )
    )
    require(
        len(commits) == 2
        and implementation == POST_RECONCILIATION_IMPLEMENTATION
        and evidence == POST_RECONCILIATION_REVIEW_HEAD,
        "post_reconciliation_rejected_pair_identity",
    )
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                POST_RECONCILIATION_REVIEW_HEAD,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "post_reconciliation_rejected_pair_not_ancestor",
    )


def validate_topology_correction(directory, correction):
    require(
        git_at(directory, "rev-parse", correction + "^")
        == TOPOLOGY_CORRECTION_BASE,
        "topology_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == TOPOLOGY_CORRECTION_SCOPE,
        "topology_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "topology_correction_metadata",
    )


def validate_topology_correction_pair(directory, head="HEAD"):
    validate_rejected_post_reconciliation_pair(directory, head)
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            TOPOLOGY_CORRECTION_BASE + ".." + head,
        )
        == "",
        "topology_correction_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                TOPOLOGY_CORRECTION_BASE + ".." + head,
            ).splitlines(),
        )
    )
    require(
        len(commits) >= 2,
        "topology_correction_pair_commit_count",
    )
    implementation, evidence = commits[:2]
    validate_topology_correction(directory, implementation)
    require(
        git_at(directory, "rev-parse", evidence + "^")
        == implementation,
        "topology_correction_evidence_parent",
    )
    require(
        commit_scope(directory, evidence)
        == TOPOLOGY_CORRECTION_EVIDENCE_SCOPE,
        "topology_correction_evidence_scope",
    )
    require(
        metadata(directory, evidence) == EXECUTOR_METADATA,
        "topology_correction_evidence_metadata",
    )
    topology_correction_evidence_contract(
        strict_git_json(
            directory,
            evidence,
            TOPOLOGY_CORRECTION_EVIDENCE,
            "topology_correction_evidence_json",
        ),
        directory,
        implementation,
    )
    return commits, implementation, evidence


def validate_trusted_probe_status(directory, head="HEAD"):
    commits, implementation, evidence = validate_topology_correction_pair(
        directory,
        PRIOR_PROTECTED_BASELINE,
    )
    require(
        len(commits) == 2
        and evidence == PRIOR_PROTECTED_BASELINE,
        "trusted_probe_prior_baseline",
    )
    require(
        git_at(directory, "rev-parse", TRUSTED_PROBE_STATUS + "^")
        == PRIOR_PROTECTED_BASELINE,
        "trusted_probe_status_parent",
    )
    require(
        commit_scope(directory, TRUSTED_PROBE_STATUS) == set(),
        "trusted_probe_status_scope",
    )
    require(
        metadata(directory, TRUSTED_PROBE_STATUS)
        == COORDINATOR_METADATA,
        "trusted_probe_status_metadata",
    )
    require(
        git_at(directory, "rev-parse", TRUSTED_PROBE_BASE + "^")
        == TRUSTED_PROBE_STATUS,
        "trusted_probe_base_parent",
    )
    require(
        commit_scope(directory, TRUSTED_PROBE_BASE) == set(),
        "trusted_probe_base_scope",
    )
    require(
        metadata(directory, TRUSTED_PROBE_BASE)
        == COORDINATOR_METADATA,
        "trusted_probe_base_metadata",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--reverse",
            PRIOR_PROTECTED_BASELINE + ".." + TRUSTED_PROBE_BASE,
        ).splitlines()
        == [TRUSTED_PROBE_STATUS, TRUSTED_PROBE_BASE],
        "trusted_probe_status_chain",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            PRIOR_PROTECTED_BASELINE + ".." + TRUSTED_PROBE_BASE,
        )
        == "",
        "trusted_probe_status_merge",
    )
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                TRUSTED_PROBE_BASE,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "trusted_probe_base_not_ancestor",
    )
    return implementation, evidence


def validate_trusted_probe_implementation(directory, implementation):
    require(
        implementation == TRUSTED_PROBE_IMPLEMENTATION,
        "trusted_probe_implementation_identity",
    )
    require(
        git_at(directory, "rev-parse", implementation + "^")
        == TRUSTED_PROBE_BASE,
        "trusted_probe_implementation_parent",
    )
    require(
        commit_scope(directory, implementation)
        == TRUSTED_PROBE_CORRECTION_SCOPE,
        "trusted_probe_implementation_scope",
    )
    require(
        metadata(directory, implementation) == EXECUTOR_METADATA,
        "trusted_probe_implementation_metadata",
    )


def validate_trusted_probe_validator_correction(directory, correction):
    require(
        correction == TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
        "trusted_probe_validator_correction_identity",
    )
    require(
        git_at(directory, "rev-parse", correction + "^")
        == TRUSTED_PROBE_IMPLEMENTATION,
        "trusted_probe_validator_correction_parent",
    )
    require(
        commit_scope(directory, correction)
        == TRUSTED_PROBE_VALIDATOR_SCOPE,
        "trusted_probe_validator_correction_scope",
    )
    require(
        metadata(directory, correction) == EXECUTOR_METADATA,
        "trusted_probe_validator_correction_metadata",
    )
    require(
        implementation_hashes(
            directory,
            correction,
            TRUSTED_PROBE_VALIDATOR_SCOPE,
        )
        == {VALIDATOR: TRUSTED_PROBE_FIRST_VALIDATOR_SHA256},
        "trusted_probe_validator_correction_hash",
    )


def validate_trusted_probe_validator_followup(directory, followup):
    require(
        followup == TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
        "trusted_probe_validator_followup_identity",
    )
    require(
        git_at(directory, "rev-parse", followup + "^")
        == TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
        "trusted_probe_validator_followup_parent",
    )
    require(
        commit_scope(directory, followup)
        == TRUSTED_PROBE_VALIDATOR_SCOPE,
        "trusted_probe_validator_followup_scope",
    )
    require(
        metadata(directory, followup) == EXECUTOR_METADATA,
        "trusted_probe_validator_followup_metadata",
    )
    require(
        implementation_hashes(
            directory,
            followup,
            TRUSTED_PROBE_VALIDATOR_SCOPE,
        )
        == {VALIDATOR: TRUSTED_PROBE_OMITTED_FIXTURE_SHA256},
        "trusted_probe_validator_followup_hash",
    )


def validate_trusted_probe_public_contract_followup(directory, followup):
    require(
        git_at(directory, "rev-parse", followup + "^")
        == TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
        "trusted_probe_public_contract_followup_parent",
    )
    require(
        commit_scope(directory, followup)
        == TRUSTED_PROBE_VALIDATOR_SCOPE,
        "trusted_probe_public_contract_followup_scope",
    )
    require(
        metadata(directory, followup) == EXECUTOR_METADATA,
        "trusted_probe_public_contract_followup_metadata",
    )


def validate_trusted_probe_pair(directory, head="HEAD"):
    validate_trusted_probe_status(directory, head)
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            TRUSTED_PROBE_BASE + ".." + head,
        )
        == "",
        "trusted_probe_extension_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                TRUSTED_PROBE_BASE + ".." + head,
            ).splitlines(),
        )
    )
    require(len(commits) >= 5, "trusted_probe_pair_commit_count")
    (
        implementation,
        validator_correction,
        validator_followup,
        public_contract_followup,
        evidence,
    ) = commits[:5]
    validate_trusted_probe_implementation(directory, implementation)
    validate_trusted_probe_validator_correction(
        directory,
        validator_correction,
    )
    validate_trusted_probe_validator_followup(
        directory,
        validator_followup,
    )
    validate_trusted_probe_public_contract_followup(
        directory,
        public_contract_followup,
    )
    require(
        git_at(directory, "rev-parse", evidence + "^")
        == public_contract_followup,
        "trusted_probe_evidence_parent",
    )
    require(
        commit_scope(directory, evidence)
        == TRUSTED_PROBE_EVIDENCE_SCOPE,
        "trusted_probe_evidence_scope",
    )
    require(
        metadata(directory, evidence) == EXECUTOR_METADATA,
        "trusted_probe_evidence_metadata",
    )
    trusted_probe_evidence_contract(
        strict_git_json(
            directory,
            evidence,
            TRUSTED_PROBE_EVIDENCE,
            "trusted_probe_evidence_json",
        ),
        directory,
        implementation,
        validator_correction,
        validator_followup,
        public_contract_followup,
    )
    return (
        commits,
        implementation,
        validator_correction,
        validator_followup,
        public_contract_followup,
        evidence,
    )


def validate_repository(directory, branch=None, head="HEAD"):
    resolved_branch = (
        git_at(directory, "branch", "--show-current")
        if branch is None
        else branch
    )
    if resolved_branch not in {BRANCH, "main"}:
        raise RuntimeError("unexpected_branch")
    resolved_head = git_at(directory, "rev-parse", head)
    if (
        resolved_branch == "main"
        and resolved_head == TRUSTED_PROBE_BASE
    ):
        _implementation, evidence = validate_trusted_probe_status(
            directory,
            head,
        )
        return {
            "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
            "evidenceCommit": evidence,
            "implementationCommit": _implementation,
            "protectedBaselineCommit": evidence,
            "repositoryState": "integrated_main",
            "sourceCommit": resolved_head,
        }
    (
        commits,
        implementation,
        validator_correction,
        validator_followup,
        public_contract_followup,
        evidence,
    ) = validate_trusted_probe_pair(
        directory,
        head,
    )
    if resolved_branch == BRANCH:
        require(
            len(commits) == 5 and resolved_head == evidence,
            "trusted_probe_review_history_shape",
        )
        return {
            "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
            "evidenceCommit": evidence,
            "implementationCommit": implementation,
            "protectedBaselineCommit": evidence,
            "repositoryState": "trusted_probe_review",
            "sourceCommit": resolved_head,
            "publicContractFollowupCommit":
                public_contract_followup,
            "validatorCorrectionCommit": validator_correction,
            "validatorFollowupCommit": validator_followup,
        }
    changed = set(
        filter(
            None,
            git_at(
                directory,
                "diff",
                "--name-only",
                evidence + ".." + head,
            ).splitlines(),
        )
    )
    protected = sorted(path for path in changed if protected_path(path))
    require(
        not protected,
        "protected_descendant_drift"
        + (":" + ",".join(protected) if protected else ""),
    )
    return {
        "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
        "evidenceCommit": evidence,
        "implementationCommit": implementation,
        "protectedBaselineCommit": evidence,
        "repositoryState": "integrated_main",
        "sourceCommit": resolved_head,
        "publicContractFollowupCommit": public_contract_followup,
        "validatorCorrectionCommit": validator_correction,
        "validatorFollowupCommit": validator_followup,
    }


def private_runtime_evidence_contract(directory, value, implementation):
    required = {
        "authority", "base", "bindings", "branch", "gate", "implementation",
        "phase", "publicObservation", "redaction", "schema", "systemMutations",
        "tests", "topology",
    }
    require(set(value) == required, "private_runtime_evidence_shape")
    require(value["schema"] == 1 and value["phase"] == "phase5_private_current_runtime_reconciliation_contract"
            and value["base"] == PRIVATE_RUNTIME_BASE
            and value["branch"] == PRIVATE_RUNTIME_BRANCH, "private_runtime_evidence_header")
    require(value["gate"] == {
        "marker": PRIVATE_RUNTIME_MARKER,
        "maximumVerdict": PRIVATE_RUNTIME_VERDICT,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "stageBContinuationRequired": True,
    }, "private_runtime_evidence_gate")
    require(value["implementation"] == implementation, "private_runtime_evidence_implementation")
    bindings = value["bindings"]
    require(set(bindings) == {
        "implementationBlobsSHA256", "implementationMetadata",
        "implementationParent", "implementationRawCommitSHA256",
        "implementationScope",
    } and bindings["implementationParent"] == PRIVATE_RUNTIME_BASE
            and bindings["implementationMetadata"] == PRIVATE_RUNTIME_EXECUTOR_METADATA
            and bindings["implementationScope"] == sorted(PRIVATE_RUNTIME_SCOPE)
            and set(bindings["implementationBlobsSHA256"]) == PRIVATE_RUNTIME_SCOPE,
            "private_runtime_evidence_bindings")
    raw = subprocess.run([*GIT, "cat-file", "commit", implementation], cwd=directory,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    require(raw.returncode == 0
            and bindings["implementationRawCommitSHA256"]
            == hashlib.sha256(raw.stdout).hexdigest()
            and all(bindings["implementationBlobsSHA256"][path]
                    == hashlib.sha256(git_blob(directory, implementation, path)).hexdigest()
                    for path in PRIVATE_RUNTIME_SCOPE),
            "private_runtime_evidence_raw_bindings")
    require(value["authority"] == {
        "handoffSHA256": "64fd9d337a18b57878819a0f0b58f3a2d33c08e4b8745bef0feb772c83cd713c",
        "ownerDecision": "согласовано",
        "operationalMigrationDependency": False,
    }, "private_runtime_evidence_authority")
    require(value["systemMutations"] == {
        "liveCodex": False, "privateConfig": False, "root": False, "system": False,
    }, "private_runtime_evidence_mutations")
    require(value["redaction"] == {
        "privateHashes": False, "privatePaths": False, "secrets": False,
        "stableMachineIdentifiers": False,
    }, "private_runtime_evidence_redaction")
    require(value["publicObservation"] == {
        "externalProjectAdditions": 4,
        "hookLeafRecords": 3,
        "hookParentTables": 1,
        "projectRows": 23,
        "vendorRows": 4,
    }, "private_runtime_evidence_public_observation")
    require(value["topology"] == {
        "evidenceOnlyChild": True, "implementationPaths": sorted(PRIVATE_RUNTIME_SCOPE),
        "noMerge": True, "parent": PRIVATE_RUNTIME_BASE,
    }, "private_runtime_evidence_topology")
    require(isinstance(value["tests"], dict) and value["tests"] and all(value["tests"].values()),
            "private_runtime_evidence_tests")


def validate_private_runtime_pair(directory, mode):
    branch = git_at(directory, "branch", "--show-current")
    head = git_at(directory, "rev-parse", "HEAD")
    require(branch == PRIVATE_RUNTIME_BRANCH, "private_runtime_branch")
    require(git_at(directory, "remote") == "", "private_runtime_origin")
    require(git_at(directory, "status", "--porcelain=v1", "--untracked-files=all") == "",
            "private_runtime_dirty")
    commits = list(filter(None, git_at(directory, "rev-list", "--reverse", PRIVATE_RUNTIME_BASE + ".." + head).splitlines()))
    require(git_at(directory, "merge-base", "--is-ancestor", PRIVATE_RUNTIME_BASE, head) == "",
            "private_runtime_base_not_ancestor")
    require(git_at(directory, "rev-list", "--merges", PRIVATE_RUNTIME_BASE + ".." + head) == "",
            "private_runtime_merge")
    if mode == "precommit":
        require(head == PRIVATE_RUNTIME_BASE and commits == [], "private_runtime_precommit_parent")
        require(worktree_scope() == PRIVATE_RUNTIME_SCOPE, "private_runtime_precommit_scope")
        return {"acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE, "evidenceCommit": None,
                "implementationCommit": None, "protectedBaselineCommit": PRIVATE_RUNTIME_BASE,
                "repositoryState": "private_runtime_precommit", "sourceCommit": head}
    require(commits and len(commits) <= 2, "private_runtime_history")
    implementation = commits[0]
    require(git_at(directory, "rev-parse", implementation + "^") == PRIVATE_RUNTIME_BASE,
            "private_runtime_implementation_parent")
    require(commit_scope(directory, implementation) == PRIVATE_RUNTIME_SCOPE,
            "private_runtime_implementation_scope")
    require(metadata(directory, implementation) == PRIVATE_RUNTIME_EXECUTOR_METADATA,
            "private_runtime_implementation_metadata")
    if len(commits) == 1:
        require(mode in {"implementation", "correction"}, "private_runtime_evidence_missing")
        return {"acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE, "evidenceCommit": None,
                "implementationCommit": implementation, "protectedBaselineCommit": implementation,
                "repositoryState": "private_runtime_implementation", "sourceCommit": head}
    evidence = commits[1]
    require(git_at(directory, "rev-parse", evidence + "^") == implementation,
            "private_runtime_evidence_parent")
    require(commit_scope(directory, evidence) == {PRIVATE_RUNTIME_EVIDENCE},
            "private_runtime_evidence_scope")
    require(metadata(directory, evidence) == PRIVATE_RUNTIME_EXECUTOR_METADATA,
            "private_runtime_evidence_metadata")
    private_runtime_evidence_contract(
        directory,
        strict_git_json(directory, evidence, PRIVATE_RUNTIME_EVIDENCE,
                        "private_runtime_evidence_json"), implementation)
    return {"acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE, "evidenceCommit": evidence,
            "implementationCommit": implementation, "protectedBaselineCommit": evidence,
            "repositoryState": "private_runtime_review", "sourceCommit": head}


def validate_git(mode):
    branch = git("branch", "--show-current")
    if branch == PRIVATE_RUNTIME_BRANCH:
        return validate_private_runtime_pair(ROOT, mode)
    validate_historical_base(ROOT)
    require(
        run([*GIT, "diff", "--check", BASE], cwd=ROOT).returncode == 0,
        "diff_check",
    )
    head = git("rev-parse", "HEAD")
    if mode == "precommit":
        require(branch == BRANCH, "precommit_branch")
        validate_trusted_probe_status(ROOT, head)
        if head == TRUSTED_PROBE_BASE:
            require(
                worktree_scope()
                == TRUSTED_PROBE_CORRECTION_SCOPE,
                "precommit_trusted_probe_scope",
            )
            return {
                "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
                "evidenceCommit": None,
                "implementationCommit": None,
                "protectedBaselineCommit":
                    TRUSTED_PROBE_BASE,
                "repositoryState":
                    "precommit_trusted_probe",
                "sourceCommit": head,
            }
        if head == TRUSTED_PROBE_IMPLEMENTATION:
            validate_trusted_probe_implementation(ROOT, head)
            require(
                git(
                    "rev-list",
                    "--count",
                    TRUSTED_PROBE_BASE + "..HEAD",
                )
                == "1"
                and git(
                    "rev-list",
                    "--merges",
                    TRUSTED_PROBE_BASE + "..HEAD",
                )
                == "",
                "trusted_probe_implementation_history_shape",
            )
            require(
                worktree_scope()
                == TRUSTED_PROBE_VALIDATOR_SCOPE,
                "precommit_trusted_probe_validator_correction_scope",
            )
            return {
                "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
                "evidenceCommit": None,
                "implementationCommit": head,
                "protectedBaselineCommit": head,
                "repositoryState":
                    "precommit_trusted_probe_validator_correction",
                "sourceCommit": head,
                "validatorCorrectionCommit": None,
            }
        if head == TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION:
            validate_trusted_probe_implementation(
                ROOT,
                TRUSTED_PROBE_IMPLEMENTATION,
            )
            validate_trusted_probe_validator_correction(ROOT, head)
            require(
                git(
                    "rev-list",
                    "--reverse",
                    TRUSTED_PROBE_BASE + "..HEAD",
                ).splitlines()
                == [
                    TRUSTED_PROBE_IMPLEMENTATION,
                    TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                ]
                and git(
                    "rev-list",
                    "--merges",
                    TRUSTED_PROBE_BASE + "..HEAD",
                )
                == "",
                "trusted_probe_validator_correction_history_shape",
            )
            require(
                worktree_scope()
                == TRUSTED_PROBE_VALIDATOR_SCOPE,
                "precommit_trusted_probe_validator_followup_scope",
            )
            return {
                "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
                "evidenceCommit": None,
                "implementationCommit": TRUSTED_PROBE_IMPLEMENTATION,
                "protectedBaselineCommit": head,
                "repositoryState":
                    "precommit_trusted_probe_validator_followup",
                "sourceCommit": head,
                "validatorCorrectionCommit": head,
                "validatorFollowupCommit": None,
            }
        if head == TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP:
            validate_trusted_probe_implementation(
                ROOT,
                TRUSTED_PROBE_IMPLEMENTATION,
            )
            validate_trusted_probe_validator_correction(
                ROOT,
                TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
            )
            validate_trusted_probe_validator_followup(ROOT, head)
            require(
                git(
                    "rev-list",
                    "--reverse",
                    TRUSTED_PROBE_BASE + "..HEAD",
                ).splitlines()
                == [
                    TRUSTED_PROBE_IMPLEMENTATION,
                    TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                    TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
                ]
                and git(
                    "rev-list",
                    "--merges",
                    TRUSTED_PROBE_BASE + "..HEAD",
                )
                == "",
                "trusted_probe_validator_followup_history_shape",
            )
            require(
                worktree_scope()
                == TRUSTED_PROBE_VALIDATOR_SCOPE,
                "precommit_trusted_probe_public_contract_scope",
            )
            return {
                "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
                "evidenceCommit": None,
                "implementationCommit": TRUSTED_PROBE_IMPLEMENTATION,
                "protectedBaselineCommit": head,
                "publicContractFollowupCommit": None,
                "repositoryState":
                    "precommit_trusted_probe_public_contract",
                "sourceCommit": head,
                "validatorCorrectionCommit":
                    TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                "validatorFollowupCommit": head,
            }
        commits = list(
            filter(
                None,
                git(
                    "rev-list",
                    "--reverse",
                    TRUSTED_PROBE_BASE + "..HEAD",
                ).splitlines(),
            )
        )
        require(
            commits
            == [
                TRUSTED_PROBE_IMPLEMENTATION,
                TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
                head,
            ]
            and git(
                "rev-list",
                "--merges",
                TRUSTED_PROBE_BASE + "..HEAD",
            )
            == "",
            "trusted_probe_validator_followup_history_shape",
        )
        validate_trusted_probe_implementation(ROOT, commits[0])
        validate_trusted_probe_validator_correction(ROOT, commits[1])
        validate_trusted_probe_validator_followup(ROOT, commits[2])
        validate_trusted_probe_public_contract_followup(ROOT, head)
        require(
            worktree_scope()
            == TRUSTED_PROBE_EVIDENCE_SCOPE,
            "precommit_trusted_probe_evidence_scope",
        )
        trusted_probe_evidence_contract(
            strict_json(ROOT / TRUSTED_PROBE_EVIDENCE),
            ROOT,
            commits[0],
            commits[1],
            commits[2],
            head,
        )
        return {
            "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
            "evidenceCommit": None,
            "implementationCommit": commits[0],
            "protectedBaselineCommit": head,
            "publicContractFollowupCommit": head,
            "repositoryState":
                "precommit_trusted_probe_evidence",
            "sourceCommit": head,
            "validatorCorrectionCommit": commits[1],
            "validatorFollowupCommit": commits[2],
        }
    require(
        git("status", "--porcelain=v1", "--untracked-files=all") == "",
        "dirty_worktree",
    )
    if mode == "implementation":
        require(branch == BRANCH, "implementation_branch")
        validate_trusted_probe_status(ROOT, head)
        validate_trusted_probe_implementation(ROOT, head)
        require(
            git(
                "rev-list",
                "--count",
                TRUSTED_PROBE_BASE + "..HEAD",
            )
            == "1"
            and git(
                "rev-list",
                "--merges",
                TRUSTED_PROBE_BASE + "..HEAD",
            )
            == "",
            "trusted_probe_implementation_history_shape",
        )
        return {
            "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
            "evidenceCommit": None,
            "implementationCommit": head,
            "protectedBaselineCommit": head,
            "repositoryState": "implementation",
            "sourceCommit": head,
        }
    if mode == "correction":
        require(branch == BRANCH, "correction_branch")
        validate_trusted_probe_status(ROOT, head)
        commits = list(
            filter(
                None,
                git(
                    "rev-list",
                    "--reverse",
                    TRUSTED_PROBE_BASE + "..HEAD",
                ).splitlines(),
            )
        )
        require(
            commits
            in (
                [
                    TRUSTED_PROBE_IMPLEMENTATION,
                    TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                ],
                [
                    TRUSTED_PROBE_IMPLEMENTATION,
                    TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                    head,
                ],
                [
                    TRUSTED_PROBE_IMPLEMENTATION,
                    TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                    TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
                    head,
                ],
            )
            and git(
                "rev-list",
                "--merges",
                TRUSTED_PROBE_BASE + "..HEAD",
            )
            == "",
            "trusted_probe_validator_followup_history_shape",
        )
        validate_trusted_probe_implementation(ROOT, commits[0])
        validate_trusted_probe_validator_correction(ROOT, commits[1])
        followup = None
        public_followup = None
        state = "validator_correction"
        if len(commits) >= 3:
            validate_trusted_probe_validator_followup(ROOT, commits[2])
            followup = commits[2]
            state = "validator_followup"
        if len(commits) == 4:
            validate_trusted_probe_public_contract_followup(ROOT, head)
            public_followup = head
            state = "public_contract_followup"
        return {
            "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
            "evidenceCommit": None,
            "implementationCommit": commits[0],
            "protectedBaselineCommit": head,
            "publicContractFollowupCommit": public_followup,
            "repositoryState": state,
            "sourceCommit": head,
            "validatorCorrectionCommit": commits[1],
            "validatorFollowupCommit": followup,
        }
    return validate_repository(ROOT, branch)


def load_module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    specification = importlib.util.spec_from_loader(name, loader)
    require(specification is not None, "module_spec")
    module = importlib.util.module_from_spec(specification)
    loader.exec_module(module)
    return module


def validate_manifest_and_sources(transaction):
    value = transaction.load_manifest()
    require(
        value["gate"]
        == {
            "acceptanceFile": ACCEPTANCE,
            "acceptedVerdict": ACCEPTED_VERDICT,
            "independentReviewRequired": True,
            "liveApplyAuthorized": False,
            "marker": POST_RECONCILIATION_MARKER,
            "maximumReviewVerdict":
                POST_RECONCILIATION_REVIEW_VERDICT,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
            "reconciledProduction": {
                "companionSHA256":
                    RECONCILIATION_COMPANION_SHA256,
                "configLength": RECONCILED_CONFIG_LENGTH,
                "configSHA256": RECONCILED_CONFIG_SHA256,
                "controlProjectTrustRows": 0,
                "hookLeafRecords": 3,
                "hookParentTables": 1,
                "nonConfigTargetsExact": 7,
                "preimageLength":
                    transaction.LEGACY_CONFIG_DRIFT_LENGTH,
                "preimageSHA256":
                    transaction.LEGACY_CONFIG_DRIFT_SHA256,
                "projectRows": 19,
                "receiptCoreSHA256":
                    transaction.LEGACY_RECEIPT_CORE_SHA256,
                "receiptSHA256":
                    transaction.LEGACY_RECEIPT_SHA256,
                "relevantHelperProcesses": 0,
                "runnerVerifySucceeded": True,
            },
            "reviewBranch": BRANCH,
            "stageBContinuationRequired": True,
        },
        "manifest_gate",
    )
    require(
        value["stageB"]
        == {
            "applyAllowlistOnly": True,
            "connectorOrOauthMutation": False,
            "finalPhase4AndPhase5Doctors": True,
            "fullRollbackAndReturnRequired": True,
            "hookTrustOrRestart":
                "three-exact-owner-trusted-user-hook-hashes-persisted",
            "pluginMcpAppMutation": False,
            "quarantineRealDenialRequired": True,
            "secondApplyMustBeNoop": True,
            "stageBeforeLiveWrites": True,
            "trustedEndToEndRequired": True,
        },
        "manifest_stage_b",
    )
    require(
        value["receipt"]
        == {
            "contentRetained": False,
            "destinationMetadata": [
                "exists",
                "ownerClass",
                "mode",
                "linkCount",
                "size",
                "sha256",
            ],
            "privatePathsRetained": False,
            "requiredBindings": [
                "acceptedControlCommit",
                "sourceCommit",
                "manifestSHA256",
                "generatedSourceHashes",
                "cliVersion",
                "preimageHashes",
                "stagedHashes",
                "applyResult",
                "rollbackState",
                "externalHookTrustOverlay",
                "projectTrustReconciliation",
            ],
            "secretOrAuthValuesRetained": False,
            "stableIdentifiersRetained": False,
        },
        "manifest_receipt",
    )
    accepted = transaction.load_accepted_generated_hashes()
    for row in value["transaction"]["destinations"]:
        require(
            digest(ROOT / row["source"]) == row["sha256"]
            == accepted[row["source"]],
            "source_hash_" + row["id"],
        )
        base_blob = git_blob(ROOT, BASE, row["source"])
        require(
            hashlib.sha256(base_blob).hexdigest() == row["sha256"],
            "accepted_base_source_hash_" + row["id"],
        )


def validate_static():
    for path in ROOT.rglob("*.json"):
        if ".git" not in path.parts:
            strict_json(path)
    python_files = (
        ROOT / "bin/check-phase4-final-probes",
        ROOT / "bin/check-phase5-apply-bundle",
        ROOT / "bin/check-phase5-prep",
        ROOT / "bin/phase4-final-doctor",
        ROOT / "bin/phase5-apply-transaction",
        ROOT / TRUSTED_PROBE_RUNNER,
        ROOT / "bin/phase5-config-transaction",
        ROOT / "bin/phase5-preflight",
        ROOT / "codex/hooks/phase5-contract.py",
    )
    for path in python_files:
        ast.parse(path.read_text())
    checked(["/bin/zsh", "-n", ROOT / "bin/codex-quarantine"])
    for path in (
        ROOT / VALIDATOR,
        ROOT / RUNNER,
        ROOT / TRUSTED_PROBE_RUNNER,
        ROOT / "bin/check-phase4-final-probes",
        ROOT / "bin/check-phase5-prep",
        ROOT / "bin/phase4-final-doctor",
    ):
        require(
            path.is_file()
            and not path.is_symlink()
            and os.access(path, os.X_OK),
            "executable_" + path.name,
        )
    transaction = load_module("phase5_apply_transaction", ROOT / RUNNER)
    validate_manifest_and_sources(transaction)
    environment = transaction.clean_environment(
        Path("/private/tmp/phase5-home"),
        Path("/private/tmp/phase5-home/.codex"),
    )
    require(
        set(environment)
        == {"CODEX_HOME", "HOME", "LANG", "LC_ALL", "PATH", "SHELL"}
        and "PHASE5_ENV_SENTINEL" not in environment,
        "runner_environment_allowlist",
    )
    runner = (ROOT / RUNNER).read_text()
    for forbidden in (
        "shell=True",
        "os.system",
        "shutil.which",
        "command -v",
        "eval(",
    ):
        require(forbidden not in runner, "runner_forbidden_" + forbidden)
    for required in (
        "/Applications/ChatGPT.app/Contents/Resources/codex",
        "DIRECTORY_FLAGS",
        "RENAME_SWAP",
        "RENAME_EXCL",
        "O_CLOEXEC",
        "O_DIRECTORY",
        "O_NOFOLLOW",
        "dir_fd=",
        "directory_chain_changed",
        "make_child_directory",
        "unlink_exact_at",
        "st_nlink != 1",
        "automatic_rollback_failed",
        "rolled-back-after-failure",
        "returned-to-reviewed-state",
        "run_id_reused",
        "partial_transaction_state",
        "reconcile-trust",
        "external-config-overlay.json",
        "config_overlay_contract",
        "exact_hook_overlay",
        "project_region_boundary",
        "LEGACY_PROJECT_INSERT_OFFSET",
        "LEGACY_HOOK_OVERLAY_SHA256",
        "REJECTED_CONFIG_COMPOSER_SHA256",
        "config_overlay_before_byte_drift",
        "config_overlay_after_byte_drift",
        "reconciliation_rollback_failed",
        "rolled-back-after-failure",
    ):
        require(required in runner, "runner_semantic_" + required)
    require(
        "auth.json" not in runner
        and "token" not in runner.lower()
        and "keychain" not in runner.lower(),
        "runner_protected_state_reference",
    )
    preflight = (ROOT / "bin/phase5-preflight").read_text()
    require(
        "doctorOverallObserved" not in preflight
        and "configLoadObserved" in preflight
        and "def doctor_contract(value):" in preflight,
        "preflight_deterministic_doctor_surface",
    )
    corrected_preparation_evidence_contract(
        strict_json(ROOT / EVIDENCE),
        ROOT,
    )
    doc = (ROOT / "docs/phase-5-apply-bundle.md").read_text()
    for required in (
        POST_RECONCILIATION_REVIEW_VERDICT,
        POST_RECONCILIATION_MARKER,
        ACCEPTANCE,
        ACCEPTED_VERDICT,
        "liveApplyAuthorized=false",
        "phase5PassClaimed=false",
        "phase6Authorized=false",
        "PreToolUse",
        "not a root",
        "full rollback",
        "second apply",
        "exact external hook-trust overlay",
        "project trust",
    ):
        require(required.lower() in doc.lower(), "apply_doc_" + required)
    for router in ("ARCHITECTURE.md", "AGENTS.md", "README.md"):
        text = (ROOT / router).read_text()
        for required in (
            POST_RECONCILIATION_REVIEW_VERDICT,
            POST_RECONCILIATION_MARKER,
            BRANCH,
            "liveApplyAuthorized=false",
            "phase5PassClaimed=false",
            "phase6Authorized=false",
        ):
            require(required in text, "router_" + router + "_" + required)
    combined = "\n".join(
        (ROOT / path).read_text(errors="ignore")
        for path in sorted(
            IMPLEMENTATION_SCOPE
            | DETERMINISM_CORRECTION_SCOPE
            | DIRECTORY_CHAIN_CORRECTION_SCOPE
            | HOOK_TRUST_CORRECTION_SCOPE
            | BYTE_EXACTNESS_CORRECTION_SCOPE
            | ACTUAL_LAYOUT_CORRECTION_SCOPE
            | POST_RECONCILIATION_CORRECTION_SCOPE
            | TOPOLOGY_CORRECTION_SCOPE
            | TRUSTED_PROBE_CORRECTION_SCOPE
        )
    )
    require("/" + "Users/" not in combined, "private_path_retained")
    require("Migrate" + "FromWindows" not in combined, "migration_dependency")
    require(
        not re.search(
            r"AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|"
            r"-----BEGIN [A-Z ]*PRIVATE KEY-----|"
            r"\b(?:serial|hardware_uuid|machine_uuid|hostname)\s*[:=]",
            combined,
            re.IGNORECASE,
        ),
        "secret_or_identifier",
    )
    network_surface = "\n".join(
        (ROOT / path).read_text(errors="ignore")
        for path in (
            RUNNER,
            MANIFEST,
            "docs/phase-5-apply-bundle.md",
        )
    )
    require(
        "http://" not in network_surface
        and "https://" not in network_surface
        and "urllib" not in runner
        and "requests" not in runner,
        "external_network_dependency",
    )
    return transaction


def trusted_probe_static():
    probe = load_module(
        "phase5_trusted_probe_validator",
        ROOT / TRUSTED_PROBE_RUNNER,
    )
    manifest = strict_json(ROOT / TRUSTED_PROBE_MANIFEST)
    probe.manifest_contract(manifest)
    require(
        manifest["outputSchema"] == probe.canonical_schema()
        and probe.audit_schema(manifest["outputSchema"]),
        "trusted_probe_schema",
    )
    script = (ROOT / TRUSTED_PROBE_RUNNER).read_text()
    for forbidden in (
        "shell=True",
        "os.system",
        "shutil.which",
        "command -v",
        "eval(",
    ):
        require(forbidden not in script, "trusted_probe_forbidden_" + forbidden)
    for required in (
        "/Applications/ChatGPT.app/Contents/Resources/codex",
        "/usr/bin/env",
        "--ignore-user-config",
        "--ignore-rules",
        "--ephemeral",
        "--output-schema",
        "--output-last-message",
        "gpt-5.6-sol",
        'model_reasoning_effort="max"',
        'approval_policy="never"',
        'web_search="disabled"',
        "mcp_servers={}",
        "real_run_not_authorized",
        "live_precondition",
        "live_postcondition",
    ):
        require(required in script, "trusted_probe_semantic_" + required)
    environment = {
        "HOME": "/private/tmp",
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "SHELL": "/bin/zsh",
    }
    first = checked(
        [ROOT / TRUSTED_PROBE_RUNNER, "validate", "--json"],
        environment=environment,
    )
    second = checked(
        [ROOT / TRUSTED_PROBE_RUNNER, "validate", "--json"],
        environment=environment,
    )
    require(first == second, "trusted_probe_byte_identity")
    value = strict_json_text(first, "trusted_probe_report")
    require(signed_vendor_floor(value.get("checks", {}).get("cliVersion", "")),
            "trusted_probe_cli_floor")
    expected = {
        "checks": {
            "canonicalCli": True,
            "cliVersion": value["checks"]["cliVersion"],
            "commandNegativeCases": 30,
            "hookDiscoveryWithoutUserConfig": True,
            "modelRequests": 0,
            "pathNegativeCases": 8,
            "schemaNegativeCases": 7,
            "sentinelConfigBytePreserved": True,
        },
        "liveApplyAuthorized": False,
        "liveCodexStateMutated": False,
        "mode": "validate",
        "modelRequests": 0,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "schema": 1,
        "systemMutationsPerformed": False,
        "trustedProbeRetryAuthorized": False,
        "verdict": "PHASE5_TRUSTED_PROBE_REPOSITORY_VALID",
    }
    require(
        value == expected,
        "trusted_probe_report_contract",
    )
    refused = run(
        [ROOT / TRUSTED_PROBE_RUNNER, "run", "--json"],
        environment=environment,
    )
    require(
        refused.returncode != 0
        and strict_json_text(refused.stdout, "trusted_probe_refusal")
        == {
            "error": "real_run_not_authorized",
            "mode": "run",
            "schema": 1,
            "verdict": "FAIL",
        },
        "trusted_probe_live_gate",
    )
    return {
        "commandNegativeCases": 30,
        "manifestSHA256": digest(ROOT / TRUSTED_PROBE_MANIFEST),
        "modelRequests": 0,
        "pathNegativeCases": 8,
        "reportSHA256": hashlib.sha256(first.encode()).hexdigest(),
        "runnerSHA256": digest(ROOT / TRUSTED_PROBE_RUNNER),
        "schemaNegativeCases": 7,
    }


def make_layout(transaction, root, *, config=None, control=ROOT, uid=None):
    root = Path(root)
    home = root / "home"
    codex_home = home / ".codex"
    aid_bin = home / "AIDev/bin"
    state_parent = home / "AIDev/state"
    for path, mode in (
        (home, 0o700),
        (codex_home, 0o700),
        (codex_home / "skills", 0o700),
        (home / "AIDev", 0o700),
        (aid_bin, 0o700),
        (state_parent, 0o700),
    ):
        path.mkdir(mode=mode, parents=True, exist_ok=True)
        os.chmod(path, mode)
    config_value = (
        config
        if config is not None
        else (
            '# fixture owner comment\napproval_policy = "on-request"\n'
            'sandbox_mode = "workspace-write"\nmodel = "fixture"\n'
            "[desktop]\nnotifications = true\n"
        )
    )
    (codex_home / "config.toml").write_text(config_value)
    os.chmod(codex_home / "config.toml", 0o600)
    (codex_home / "AGENTS.md").write_text("fixture guidance\n")
    os.chmod(codex_home / "AGENTS.md", 0o644)
    return transaction.Layout(
        home,
        control,
        state_parent / "codex-transactions",
        codex_home,
        aid_bin,
        uid=uid,
    )


def gate_value(character="a"):
    return {
        "acceptedControlCommit": character * 40,
        "protectedBaselineCommit": character * 40,
        "sourceCommit": character * 40,
    }


def expect_error(action, reason):
    try:
        action()
    except Exception:
        return
    raise RuntimeError("negative_accepted_" + reason)


def expect_exact_error(action, expected, reason):
    try:
        action()
    except Exception as error:
        require(str(error) == expected, "unstable_reason_" + reason)
        return
    raise RuntimeError("negative_accepted_" + reason)


def transaction_positive(transaction):
    with tempfile.TemporaryDirectory(
        prefix="phase5-apply-positive-"
    ) as directory:
        root = Path(directory).resolve()
        layout = make_layout(transaction, root)
        original = {
            identifier: transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=identifier != "config",
                user_root=layout.home,
            )["metadata"]
            for identifier, path in layout.targets().items()
        }
        run_one = "p5-" + "1" * 32
        staged = transaction.stage(
            layout, run_one, gate_value("a")
        )
        require(staged["state"] == "staged", "fixture_stage")
        receipt_text = (
            layout.state_root / run_one / "receipt.json"
        ).read_text()
        require(
            str(root) not in receipt_text
            and "/" + "Users/" not in receipt_text
            and "fixture guidance" not in receipt_text
            and "notifications" not in receipt_text,
            "receipt_redaction",
        )
        run_root = layout.state_root / run_one
        require(
            stat.S_IMODE(run_root.stat().st_mode) == 0o700
            and stat.S_IMODE(
                (run_root / "staged").stat().st_mode
            )
            == 0o700
            and stat.S_IMODE(
                (run_root / "preimages").stat().st_mode
            )
            == 0o700
            and all(
                stat.S_IMODE(path.stat().st_mode) == 0o600
                for path in (
                    list((run_root / "staged").iterdir())
                    + list((run_root / "preimages").iterdir())
                    + [run_root / "receipt.json"]
                )
            ),
            "transaction_private_modes",
        )
        applied = transaction.apply_receipt(layout, run_one)
        require(
            applied["state"] == "applied"
            and applied["applyResult"] == "applied",
            "fixture_apply",
        )
        transaction.verify_receipt(layout, run_one)
        run_two = "p5-" + "2" * 32
        transaction.stage(layout, run_two, gate_value("a"))
        noop = transaction.apply_receipt(layout, run_two)
        require(
            noop["state"] == "noop"
            and noop["applyResult"] == "noop",
            "fixture_noop",
        )
        transaction.rollback_receipt(layout, run_two)
        rolled = transaction.rollback_receipt(layout, run_one)
        require(
            rolled["state"] == "rolled-back"
            and rolled["rollbackState"] == "complete",
            "fixture_rollback",
        )
        transaction.verify_rollback(layout, run_one)
        for identifier, path in layout.targets().items():
            current = transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=True,
                user_root=layout.home,
            )
            require(
                transaction.metadata_matches(
                    current, original[identifier]
                ),
                "fixture_exact_preimage_" + identifier,
            )
        returned = transaction.apply_receipt(
            layout, run_one, returning=True
        )
        require(
            returned["state"] == "returned"
            and returned["rollbackState"]
            == "returned-to-reviewed-state",
            "fixture_return",
        )
        transaction.verify_receipt(layout, run_one)
        return {
            "allowlistedTargets": 8,
            "noOp": True,
            "rollback": True,
            "return": True,
        }


def overlay_base_config():
    projects = "".join(
        "[projects."
        + json.dumps("/fixture/phase5-project-" + str(index))
        + ']\ntrust_level = "trusted"\n'
        for index in range(19)
    )
    return (
        '# fixture owner comment\napproval_policy = "on-request"\n'
        'sandbox_mode = "workspace-write"\nmodel = "fixture"\n'
        + projects
        + '\n[features]\nfast_mode = false\n'
    )


def overlay_text(
    transaction,
    layout,
    *,
    records=None,
    project_path=None,
    project_level="trusted",
    extra=b"",
):
    control = (
        str(layout.control.resolve())
        if project_path is None
        else project_path
    )
    source = str(layout.codex_home / "hooks.json")
    rows = (
        list(transaction.HOOK_TRUST_RECORDS)
        if records is None
        else records
    )
    project = (
        "[projects."
        + json.dumps(control)
        + "]\ntrust_level = "
        + json.dumps(project_level)
        + "\n"
    )
    value = "[hooks.state]\n"
    for _event, slot, trusted_hash in rows:
        value += (
            "\n[hooks.state."
            + json.dumps(source + ":" + slot)
            + "]\ntrusted_hash = "
            + json.dumps(trusted_hash)
            + "\n"
        )
    return project.encode(), value.encode() + extra


def prepared_overlay_fixture(
    transaction,
    root,
    *,
    records=None,
    project_path=None,
    project_level="trusted",
    extra=b"",
):
    layout = make_layout(
        transaction,
        root,
        config=overlay_base_config(),
    )
    run_id = "p5-" + "3c" * 16
    transaction.stage(layout, run_id, gate_value("c"))
    transaction.apply_receipt(layout, run_id)
    target = layout.codex_home / "config.toml"
    base = target.read_bytes()
    project, hook_overlay = overlay_text(
        transaction,
        layout,
        records=records,
        project_path=project_path,
        project_level=project_level,
        extra=extra,
    )
    boundary = transaction.project_region_boundary(base)
    target.write_bytes(
        transaction.compose_exact_config(
            base[:boundary]
            + project
            + b"\n"
            + base[boundary:],
            hook_overlay,
        )
    )
    os.chmod(target, 0o600)
    return layout, run_id, target.read_bytes()


def transaction_overlay_positive(transaction):
    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-positive-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        config = layout.codex_home / "config.toml"
        control = str(layout.control.resolve()).encode()
        result = transaction.reconcile_receipt(layout, run_id)
        reconciled = config.read_bytes()
        run_root, receipt = transaction.load_receipt(
            layout,
            run_id,
        )
        hook_overlay = transaction.exact_hook_overlay(layout)
        expected_after = transaction.compose_config_overlay(
            layout,
            run_root,
            transaction.config_base_bytes(
                layout,
                run_root,
                receipt,
                "after",
            ),
            hook_overlay,
            transaction.digest_bytes(hook_overlay),
        )
        require(
            result["state"] == "reconciled"
            and result["hookTrustRecords"] == 3
            and result["projectTrustEntryPresent"] is False
            and control not in reconciled
            and all(
                trusted_hash.encode() in reconciled
                for _event, _slot, trusted_hash
                in transaction.HOOK_TRUST_RECORDS
            )
            and all(
                (
                    "/fixture/phase5-project-" + str(index)
                ).encode()
                in reconciled
                for index in range(19)
            ),
            "overlay_reconciliation",
        )
        require(
            b"[features]\nfast_mode = false\n"
            in reconciled,
            "overlay_retained_later_base_table",
        )
        require(
            reconciled == expected_after,
            "overlay_reconciled_exact_bytes",
        )
        transaction.verify_receipt(layout, run_id)
        second = "p5-" + "4c" * 16
        transaction.stage(layout, second, gate_value("c"))
        noop = transaction.apply_receipt(layout, second)
        require(
            noop["state"] == "noop"
            and config.read_bytes() == reconciled,
            "overlay_second_apply_noop",
        )
        transaction.rollback_receipt(layout, second)
        transaction.rollback_receipt(layout, run_id)
        rolled_back = config.read_bytes()
        expected_before = transaction.compose_config_overlay(
            layout,
            run_root,
            transaction.config_base_bytes(
                layout,
                run_root,
                receipt,
                "before",
            ),
            hook_overlay,
            transaction.digest_bytes(hook_overlay),
        )
        require(
            all(
                trusted_hash.encode() in rolled_back
                for _event, _slot, trusted_hash
                in transaction.HOOK_TRUST_RECORDS
            )
            and control not in rolled_back,
            "overlay_rollback_persistence",
        )
        require(
            rolled_back == expected_before,
            "overlay_rollback_exact_bytes",
        )
        transaction.apply_receipt(
            layout,
            run_id,
            returning=True,
        )
        returned = config.read_bytes()
        require(
            all(
                trusted_hash.encode() in returned
                for _event, _slot, trusted_hash
                in transaction.HOOK_TRUST_RECORDS
            )
            and control not in returned,
            "overlay_return_persistence",
        )
        require(
            returned == expected_after,
            "overlay_return_exact_bytes",
        )
        record = (
            layout.state_root
            / run_id
            / transaction.OVERLAY_RECEIPT
        ).read_text()
        require(
            str(root) not in record
            and "/" + "Users/" not in record
            and "fixture owner" not in record
            and "model = " not in record,
            "overlay_receipt_redaction",
        )
        require(
            drifted != reconciled,
            "overlay_reconciliation_changed_exact_entry",
        )
        return {
            "hookTrustRecords": 3,
            "noOp": True,
            "preexistingProjects": 19,
            "reconciled": True,
            "rollbackReturnPersistence": True,
        }


def transaction_overlay_negatives(transaction):
    cases = 0

    def rejected(name, mutate, *, exact=None):
        nonlocal cases
        with tempfile.TemporaryDirectory(
            prefix="phase5-hook-overlay-negative-" + name + "-"
        ) as directory:
            root = Path(directory).resolve()
            layout, run_id, _drifted = mutate(root)
            action = lambda: transaction.reconcile_receipt(
                layout,
                run_id,
            )
            if exact is None:
                expect_error(action, name)
            else:
                expect_exact_error(action, exact, name)
        cases += 1

    expected = list(transaction.HOOK_TRUST_RECORDS)

    def mutate_config(layout, transform):
        path = layout.codex_home / "config.toml"
        before = path.read_bytes()
        after = transform(before, layout)
        require(after != before, "byte_drift_fixture_changed")
        path.write_bytes(after)
        os.chmod(path, 0o600)
        return after

    def insert_comment(value, _layout):
        marker = b"[hooks.state."
        index = value.index(marker)
        return (
            value[:index]
            + b"# unauthorized nonsemantic byte drift\n"
            + value[index:]
        )

    def insert_prefix_newline(value, _layout):
        marker = b'[projects."/fixture/phase5-project-0"]'
        index = value.index(marker)
        return value[:index] + b"\n" + value[index:]

    def reorder_projects(value, _layout):
        first = (
            b'[projects."/fixture/phase5-project-0"]\n'
            b'trust_level = "trusted"\n'
        )
        second = (
            b'[projects."/fixture/phase5-project-1"]\n'
            b'trust_level = "trusted"\n'
        )
        return value.replace(first + second, second + first, 1)

    def change_equivalent_value(value, _layout):
        return value.replace(
            b'model = "fixture"',
            b"model = 'fixture'",
            1,
        )

    def reformat_hook_suffix(value, _layout):
        return value.replace(
            b'trusted_hash = "',
            b'trusted_hash="',
            1,
        )

    def remove_hook_parent(value, _layout):
        return value.replace(b"[hooks.state]\n\n", b"", 1)

    def reformat_hook_parent(value, _layout):
        return value.replace(
            b"[hooks.state]\n\n",
            b"[hooks.state] # reformatted parent\n\n",
            1,
        )

    def session_end_nonempty(value, _layout):
        return b'hooks.SessionEnd = ["unexpected"]\n' + value

    def session_end_wrong_type(value, _layout):
        return b'hooks.SessionEnd = "unexpected"\n' + value

    def move_project_to_overlay(value, layout):
        project = transaction.exact_project_trust_block(layout) + b"\n"
        without = value.replace(project, b"", 1)
        parent = without.rfind(b"[hooks.state]\n\n")
        require(parent >= 0, "project_position_fixture_parent")
        return without[:parent] + project + without[parent:]

    def rejected_tail_composer(value, layout):
        project = transaction.exact_project_trust_block(layout) + b"\n"
        without = value.replace(project, b"", 1)
        parent_table = b"[hooks.state]\n\n"
        parent = without.rfind(parent_table)
        require(parent >= 0, "rejected_composer_fixture_parent")
        return (
            without[:parent]
            + project
            + without[parent + len(parent_table):]
        )

    byte_drifts = (
        ("comment", insert_comment),
        ("prefix-newline", insert_prefix_newline),
        ("project-reorder", reorder_projects),
        ("equivalent-value", change_equivalent_value),
        ("hook-format", reformat_hook_suffix),
        ("missing-hook-parent", remove_hook_parent),
        ("hook-parent-format", reformat_hook_parent),
        ("project-position", move_project_to_overlay),
        ("rejected-tail-composer", rejected_tail_composer),
    )

    for name, transform in byte_drifts:
        def before_reconciliation(root, mutate=transform):
            layout, run_id, _drifted = prepared_overlay_fixture(
                transaction,
                root,
            )
            value = mutate_config(layout, mutate)
            return layout, run_id, value

        rejected(
            "before-byte-" + name,
            before_reconciliation,
            exact="config_overlay_before_byte_drift",
        )

    for name, transform in (
        ("session-end-nonempty", session_end_nonempty),
        ("session-end-wrong-type", session_end_wrong_type),
    ):
        def session_end_drift(root, mutate=transform):
            layout, run_id, _drifted = prepared_overlay_fixture(
                transaction,
                root,
            )
            mutate_config(layout, mutate)
            return layout, run_id, None

        rejected(
            "before-" + name,
            session_end_drift,
            exact="config_overlay_parser",
        )

    rejected(
        "missing-hook-hash",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            records=expected[:-1],
        ),
    )
    rejected(
        "wrong-hook-hash",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            records=[
                expected[0][0:2] + ("sha256:" + "0" * 64,),
                *expected[1:],
            ],
        ),
    )
    rejected(
        "wrong-hook-slot",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            records=[
                (expected[0][0], "pre_tool_use:1:0", expected[0][2]),
                *expected[1:],
            ],
        ),
    )
    rejected(
        "extra-hook-hash",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            records=[
                *expected,
                (
                    "stop",
                    "stop:0:1",
                    "sha256:" + "1" * 64,
                ),
            ],
        ),
    )

    def wrong_source(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        path = layout.codex_home / "config.toml"
        value = path.read_bytes().replace(
            str(layout.codex_home / "hooks.json").encode(),
            str(layout.codex_home / "other-hooks.json").encode(),
        )
        path.write_bytes(value)
        os.chmod(path, 0o600)
        return layout, run_id, value

    rejected("wrong-hook-source", wrong_source)

    def duplicate_slot(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        path = layout.codex_home / "config.toml"
        source = str(layout.codex_home / "hooks.json")
        _event, slot, trusted_hash = expected[0]
        duplicate = (
            "\n[hooks.state."
            + json.dumps(source + ":" + slot)
            + "]\ntrusted_hash = "
            + json.dumps(trusted_hash)
            + "\n"
        ).encode()
        path.write_bytes(path.read_bytes() + duplicate)
        os.chmod(path, 0o600)
        return layout, run_id, path.read_bytes()

    rejected("duplicate-hook-slot", duplicate_slot)
    rejected(
        "wrong-hook-row-shape",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            extra=b"unexpected = true\n",
        ),
    )

    def arbitrary_hooks(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        path = layout.codex_home / "config.toml"
        value = path.read_bytes().replace(
            b"[hooks.state.",
            b"[[hooks.PreToolUse]]\nmatcher = \"*\"\nhooks = []\n"
            b"[hooks.state.",
            1,
        )
        path.write_bytes(value)
        os.chmod(path, 0o600)
        return layout, run_id, value

    rejected("arbitrary-hooks-drift", arbitrary_hooks)
    rejected(
        "wrong-control-project-level",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            project_level="untrusted",
        ),
    )
    rejected(
        "other-project-addition",
        lambda root: prepared_overlay_fixture(
            transaction,
            root,
            project_path="/fixture/unreviewed-project",
        ),
    )

    def other_config_drift(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        path = layout.codex_home / "config.toml"
        value = path.read_bytes().replace(
            b'model = "fixture"',
            b'model = "unreviewed"',
        )
        path.write_bytes(value)
        os.chmod(path, 0o600)
        return layout, run_id, value

    rejected("other-config-drift", other_config_drift)

    for name, transform in byte_drifts:
        with tempfile.TemporaryDirectory(
            prefix="phase5-hook-overlay-after-byte-" + name + "-"
        ) as directory:
            root = Path(directory).resolve()
            layout, run_id, _drifted = prepared_overlay_fixture(
                transaction,
                root,
            )
            transaction.reconcile_receipt(layout, run_id)
            mutate_config(layout, transform)
            expect_exact_error(
                lambda: transaction.verify_receipt(layout, run_id),
                "verify_target",
                "after-byte-" + name,
            )
        cases += 1

        with tempfile.TemporaryDirectory(
            prefix="phase5-hook-overlay-before-byte-" + name + "-"
        ) as directory:
            root = Path(directory).resolve()
            layout, run_id, _drifted = prepared_overlay_fixture(
                transaction,
                root,
            )
            transaction.reconcile_receipt(layout, run_id)
            transaction.rollback_receipt(layout, run_id)
            mutate_config(layout, transform)
            expect_exact_error(
                lambda: transaction.verify_rollback(
                    layout,
                    run_id,
                ),
                "rollback_verify_target",
                "before-state-byte-" + name,
            )
        cases += 1

    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-noop-byte-drift-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        second = "p5-" + "5c" * 16
        transaction.stage(layout, second, gate_value("c"))
        mutate_config(layout, insert_comment)
        expect_exact_error(
            lambda: transaction.apply_receipt(layout, second),
            "destination_drift",
            "noop-byte-drift",
        )
    cases += 1

    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-rollback-byte-drift-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        mutate_config(layout, insert_prefix_newline)
        expect_exact_error(
            lambda: transaction.rollback_receipt(layout, run_id),
            "partial_state_destination_unknown",
            "rollback-byte-drift",
        )
    cases += 1

    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-return-byte-drift-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        transaction.rollback_receipt(layout, run_id)
        mutate_config(layout, reformat_hook_suffix)
        expect_exact_error(
            lambda: transaction.apply_receipt(
                layout,
                run_id,
                returning=True,
            ),
            "destination_drift",
            "return-byte-drift",
        )
    cases += 1

    for failure_point in range(1, 5):
        with tempfile.TemporaryDirectory(
            prefix="phase5-hook-overlay-failure-"
            + str(failure_point)
            + "-"
        ) as directory:
            root = Path(directory).resolve()
            layout, run_id, drifted = prepared_overlay_fixture(
                transaction,
                root,
            )
            expect_exact_error(
                lambda point=failure_point:
                    transaction.reconcile_receipt(
                        layout,
                        run_id,
                        fail_after=point,
                    ),
                "injected_reconciliation_failure",
                "reconciliation-failure-" + str(failure_point),
            )
            require(
                (layout.codex_home / "config.toml").read_bytes()
                == drifted,
                "reconciliation_failure_exact_rollback",
            )
            root_path = layout.state_root / run_id
            _receipt_root, receipt = transaction.load_receipt(
                layout,
                run_id,
            )
            record = transaction.load_overlay_record(
                layout,
                root_path,
                receipt,
                allow_missing=False,
            )
            require(
                record["state"] == "rolled-back-after-failure"
                and record["rollbackState"] == "complete",
                "reconciliation_failure_receipt",
            )
            transaction.reconcile_receipt(layout, run_id)
        cases += 1

    def stale_overlay_receipt(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        path = (
            layout.state_root
            / run_id
            / transaction.OVERLAY_RECEIPT
        )
        value = strict_json(path)
        value["hookOverlaySHA256"] = "0" * 64
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        os.chmod(path, 0o600)
        return layout, run_id, path.read_bytes()

    rejected("stale-overlay-receipt", stale_overlay_receipt)

    def stale_receipt_core(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        path = layout.state_root / run_id / "receipt.json"
        value = strict_json(path)
        value["sourceCommit"] = "d" * 40
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        os.chmod(path, 0o600)
        return layout, run_id, path.read_bytes()

    rejected("stale-overlay-receipt-core", stale_receipt_core)

    def partial_overlay_state(root):
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        path = (
            layout.state_root
            / run_id
            / "preimages"
            / transaction.OVERLAY_PREIMAGE
        )
        path.write_bytes(b"partial\n")
        os.chmod(path, 0o600)
        return layout, run_id, path.read_bytes()

    rejected("partial-overlay-state", partial_overlay_state)

    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-project-readded-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, _drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        path = layout.codex_home / "config.toml"
        control = str(layout.control.resolve())
        path.write_bytes(
            path.read_bytes()
            + (
                "\n[projects."
                + json.dumps(control)
                + ']\ntrust_level = "trusted"\n'
            ).encode()
        )
        os.chmod(path, 0o600)
        expect_exact_error(
            lambda: transaction.verify_receipt(layout, run_id),
            "verify_target",
            "project-trust-readded",
        )
        cases += 1

    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-manifest-event-"
    ) as directory:
        root = Path(directory).resolve()
        path = root / "manifest.json"
        value = strict_json(ROOT / MANIFEST)
        value["externalConfigOverlay"]["hookTrustRecords"][0][
            "event"
        ] = "postToolUse"
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        expect_exact_error(
            lambda: transaction.load_manifest(path),
            "manifest_external_config_overlay",
            "wrong-hook-event",
        )
        cases += 1

    for name, substitute in (
        (
            "reconciliation-config-symlink",
            lambda path, outside: (
                path.rename(path.with_name("config.original")),
                path.symlink_to(outside),
            ),
        ),
        (
            "reconciliation-config-hardlink",
            lambda path, outside: os.link(path, outside),
        ),
    ):
        with tempfile.TemporaryDirectory(
            prefix="phase5-hook-overlay-" + name + "-"
        ) as directory:
            root = Path(directory).resolve()
            layout, run_id, _drifted = prepared_overlay_fixture(
                transaction,
                root,
            )
            path = layout.codex_home / "config.toml"
            outside = root / "outside-config"
            substitute(path, outside)
            expect_error(
                lambda: transaction.reconcile_receipt(
                    layout,
                    run_id,
                ),
                name,
            )
            if name.endswith("symlink"):
                require(
                    outside.exists() is False,
                    "reconciliation_symlink_outside_write",
                )
            else:
                require(
                    outside.read_bytes() == path.read_bytes(),
                    "reconciliation_hardlink_unchanged",
                )
        cases += 1

    with tempfile.TemporaryDirectory(
        prefix="phase5-hook-overlay-toctou-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, drifted = prepared_overlay_fixture(
            transaction,
            root,
        )
        path = layout.codex_home / "config.toml"
        moved = layout.codex_home / "config.original"
        attack = {"ran": False}

        def substitute_config(identifier, target):
            if identifier == "config-project-trust-reconciliation":
                target.rename(moved)
                target.write_bytes(b'approval_policy = "never"\n')
                os.chmod(target, 0o600)
                attack["ran"] = True

        expect_exact_error(
            lambda: transaction.reconcile_receipt(
                layout,
                run_id,
                before_atomic=substitute_config,
            ),
            "reconciliation_rollback_failed",
            "reconciliation-toctou",
        )
        require(
            attack["ran"]
            and moved.read_bytes() == drifted,
            "reconciliation_toctou_preimage",
        )
        path.unlink()
        moved.rename(path)
        recovered = transaction.recover_reconciliation(
            layout,
            run_id,
        )
        require(
            recovered["state"] == "rolled-back-after-failure"
            and path.read_bytes() == drifted,
            "reconciliation_toctou_recovery",
        )
        cases += 1

    return {
        "cases": cases,
        "failClosed": True,
    }


def fresh_negative(transaction, name, action, *, config=None):
    with tempfile.TemporaryDirectory(
        prefix="phase5-apply-negative-" + name + "-"
    ) as directory:
        root = Path(directory).resolve()
        layout = make_layout(transaction, root, config=config)
        action(root, layout)


def transaction_negatives(transaction):
    cases = 0

    def rejected(name, action, *, config=None):
        nonlocal cases
        fresh_negative(
            transaction,
            name,
            lambda root, layout: expect_error(
                lambda: action(root, layout), name
            ),
            config=config,
        )
        cases += 1

    for name, config in (
        (
            "duplicate-config",
            'approval_policy = "never"\napproval_policy = "never"\n'
            'sandbox_mode = "danger-full-access"\n',
        ),
        (
            "nonscalar-config",
            'approval_policy = { value = "never" }\n'
            'sandbox_mode = "danger-full-access"\n',
        ),
        (
            "malformed-config",
            'approval_policy = "never"\n[desktop\nvalue = true\n',
        ),
    ):
        rejected(
            name,
            lambda _root, layout, n=name: transaction.stage(
                layout, "p5-" + "3" * 32, gate_value("b")
            ),
            config=config,
        )

    def symlink_target(root, layout):
        target = layout.codex_home / "quarantine.config.toml"
        target.symlink_to(layout.codex_home / "config.toml")
        transaction.stage(layout, "p5-" + "4" * 32, gate_value("b"))

    rejected("symlink-target", symlink_target)

    def directory_target(root, layout):
        (layout.codex_home / "quarantine.config.toml").mkdir()
        transaction.stage(layout, "p5-" + "5" * 32, gate_value("b"))

    rejected("nonregular-target", directory_target)

    def hardlink_target(root, layout):
        os.link(
            layout.codex_home / "config.toml",
            layout.codex_home / "config-hardlink",
        )
        transaction.stage(layout, "p5-" + "6" * 32, gate_value("b"))

    rejected("hardlink-target", hardlink_target)

    def wrong_mode(root, layout):
        os.chmod(layout.codex_home / "config.toml", 0o666)
        transaction.stage(layout, "p5-" + "7" * 32, gate_value("b"))

    rejected("wrong-mode", wrong_mode)

    def wrong_owner_class(root, layout):
        wrong = transaction.Layout(
            layout.home,
            layout.control,
            layout.state_root,
            layout.codex_home,
            layout.aid_bin,
            uid=os.getuid() + 1,
        )
        transaction.stage(wrong, "p5-" + "8" * 32, gate_value("b"))

    rejected("wrong-owner-class", wrong_owner_class)

    def unexpected_child(root, layout):
        skill = layout.codex_home / "skills/manage-workstation"
        skill.mkdir()
        (skill / "unexpected").write_text("unexpected\n")
        transaction.stage(layout, "p5-" + "9" * 32, gate_value("b"))

    rejected("unexpected-managed-child", unexpected_child)

    def escaped_layout(root, layout):
        escaped = transaction.Layout(
            layout.home,
            layout.control,
            layout.home / "AIDev/state/codex-transactions",
            layout.codex_home,
            root / "outside-bin",
        )
        (root / "outside-bin").mkdir()
        transaction.stage(
            escaped, "p5-" + "a" * 32, gate_value("b")
        )

    rejected("path-escape", escaped_layout)

    def reused(root, layout):
        run_id = "p5-" + "b" * 32
        transaction.stage(layout, run_id, gate_value("b"))
        transaction.stage(layout, run_id, gate_value("b"))

    rejected("reused-run-id", reused)

    def staged_drift(root, layout):
        run_id = "p5-" + "c" * 32
        transaction.stage(layout, run_id, gate_value("b"))
        path = layout.state_root / run_id / "staged/global-agents"
        path.write_text("drift\n")
        os.chmod(path, 0o600)
        transaction.apply_receipt(layout, run_id)

    rejected("staged-hash-drift", staged_drift)

    def preimage_drift(root, layout):
        run_id = "p5-" + "d" * 32
        transaction.stage(layout, run_id, gate_value("b"))
        path = layout.state_root / run_id / "preimages/config"
        path.write_text("drift\n")
        os.chmod(path, 0o600)
        transaction.apply_receipt(layout, run_id)

    rejected("preimage-hash-drift", preimage_drift)

    def destination_drift(root, layout):
        run_id = "p5-" + "e" * 32
        transaction.stage(layout, run_id, gate_value("b"))
        path = layout.codex_home / "config.toml"
        path.write_text(path.read_text() + "# drift\n")
        transaction.apply_receipt(layout, run_id)

    rejected("destination-drift", destination_drift)

    def stale_receipt(root, layout):
        run_id = "p5-" + "f" * 32
        transaction.stage(layout, run_id, gate_value("b"))
        path = layout.state_root / run_id / "receipt.json"
        value = strict_json(path)
        value["manifestSHA256"] = "0" * 64
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        os.chmod(path, 0o600)
        transaction.apply_receipt(layout, run_id)

    rejected("stale-receipt", stale_receipt)

    def receipt_generated_hash_drift(root, layout):
        run_id = "p5-" + "4a" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        path = layout.state_root / run_id / "receipt.json"
        value = strict_json(path)
        source = sorted(value["generatedSourceHashes"])[0]
        value["generatedSourceHashes"][source] = "0" * 64
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        os.chmod(path, 0o600)
        expect_exact_error(
            lambda: transaction.apply_receipt(layout, run_id),
            "receipt_generated_hashes",
            "receipt-generated-hash-drift",
        )

    fresh_negative(
        transaction,
        "receipt-generated-hash-drift",
        receipt_generated_hash_drift,
    )
    cases += 1

    def receipt_metadata_drift(root, layout):
        run_id = "p5-" + "5a" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        path = layout.state_root / run_id / "receipt.json"
        value = strict_json(path)
        value["targets"][0]["after"]["linkCount"] = 2
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        os.chmod(path, 0o600)
        expect_exact_error(
            lambda: transaction.apply_receipt(layout, run_id),
            "receipt_present_metadata",
            "receipt-metadata-drift",
        )

    fresh_negative(
        transaction,
        "receipt-metadata-drift",
        receipt_metadata_drift,
    )
    cases += 1

    def stale_gate(root, layout):
        run_id = "p5-" + "6a" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        expect_exact_error(
            lambda: transaction.load_receipt(
                layout, run_id, gate_value("c")
            ),
            "stale_receipt_gate",
            "stale-receipt-gate",
        )

    fresh_negative(transaction, "stale-receipt-gate", stale_gate)
    cases += 1

    def staged_mode_drift(root, layout):
        run_id = "p5-" + "7a" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        os.chmod(
            layout.state_root / run_id / "staged/global-agents",
            0o640,
        )
        expect_exact_error(
            lambda: transaction.apply_receipt(layout, run_id),
            "staged_hash_drift",
            "staged-mode-drift",
        )

    fresh_negative(transaction, "staged-mode-drift", staged_mode_drift)
    cases += 1

    def partial_state(root, layout):
        run_id = "p5-" + "0" * 32
        transaction.stage(layout, run_id, gate_value("b"))
        (layout.state_root / run_id / "unexpected").write_text("x\n")
        transaction.apply_receipt(layout, run_id)

    rejected("partial-state", partial_state)

    def state_root_symlink(root, layout):
        real = layout.state_root.parent / "redirected"
        real.mkdir(mode=0o700)
        layout.state_root.symlink_to(real, target_is_directory=True)
        transaction.stage(layout, "p5-" + "8a" * 16, gate_value("b"))

    rejected("state-root-symlink", state_root_symlink)

    def unexpected_state_root_child(root, layout):
        layout.state_root.mkdir(mode=0o700)
        (layout.state_root / "unexpected").write_text("unexpected\n")
        transaction.stage(layout, "p5-" + "8b" * 16, gate_value("b"))

    rejected(
        "unexpected-state-root-child",
        unexpected_state_root_child,
    )

    def managed_directory_symlink(root, layout):
        redirected = layout.codex_home / "redirected-hooks"
        redirected.mkdir(mode=0o700)
        (layout.codex_home / "hooks").symlink_to(
            redirected, target_is_directory=True
        )
        transaction.stage(layout, "p5-" + "9a" * 16, gate_value("b"))

    rejected("managed-directory-symlink", managed_directory_symlink)

    def state_parent_chain_race(root, layout):
        outside = root / "outside-state-parent"
        outside.mkdir(mode=0o700)
        moved = layout.home / "AIDev/state-original"
        original_mkdir = transaction.os.mkdir
        attack = {"ran": False}

        def substitute(name, mode=0o777, *, dir_fd=None):
            if (
                not attack["ran"]
                and name == "codex-transactions"
                and dir_fd is not None
            ):
                layout.state_root.parent.rename(moved)
                layout.state_root.parent.symlink_to(
                    outside,
                    target_is_directory=True,
                )
                attack["ran"] = True
            return original_mkdir(name, mode, dir_fd=dir_fd)

        transaction.os.mkdir = substitute
        try:
            expect_exact_error(
                lambda: transaction.stage(
                    layout,
                    "p5-" + "ca" * 16,
                    gate_value("b"),
                ),
                "directory_chain_changed",
                "state-parent-chain-race",
            )
        finally:
            transaction.os.mkdir = original_mkdir
        require(
            attack["ran"]
            and not any(outside.iterdir())
            and not (moved / "codex-transactions").exists(),
            "state_parent_chain_race_outside_write",
        )
        layout.state_root.parent.unlink()
        moved.rename(layout.state_root.parent)
        require(
            not any(layout.state_root.parent.iterdir()),
            "state_parent_chain_race_preimage",
        )

    fresh_negative(
        transaction,
        "state-parent-chain-race",
        state_parent_chain_race,
    )
    cases += 1

    def run_root_chain_race(root, layout):
        transaction.validate_layout(layout, create_state_root=True)
        outside = root / "outside-run-root"
        outside.mkdir(mode=0o700)
        moved = layout.state_root.parent / "codex-transactions-original"
        run_id = "p5-" + "cb" * 16
        original_mkdir = transaction.os.mkdir
        attack = {"ran": False}

        def substitute(name, mode=0o777, *, dir_fd=None):
            if (
                not attack["ran"]
                and name == run_id
                and dir_fd is not None
            ):
                layout.state_root.rename(moved)
                layout.state_root.symlink_to(
                    outside,
                    target_is_directory=True,
                )
                attack["ran"] = True
            return original_mkdir(name, mode, dir_fd=dir_fd)

        transaction.os.mkdir = substitute
        try:
            expect_exact_error(
                lambda: transaction.create_run_directory(layout, run_id),
                "directory_chain_changed",
                "run-root-chain-race",
            )
        finally:
            transaction.os.mkdir = original_mkdir
        require(
            attack["ran"]
            and not any(outside.iterdir())
            and not (moved / run_id).exists(),
            "run_root_chain_race_outside_write",
        )
        layout.state_root.unlink()
        moved.rename(layout.state_root)
        require(
            not any(layout.state_root.iterdir()),
            "run_root_chain_race_preimage",
        )

    fresh_negative(
        transaction,
        "run-root-chain-race",
        run_root_chain_race,
    )
    cases += 1

    def receipt_parent_chain_race(root, layout):
        run_id = "p5-" + "ce" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        run_root = layout.state_root / run_id
        receipt_path = run_root / "receipt.json"
        before = receipt_path.read_bytes()
        outside = root / "outside-receipt-parent"
        outside.mkdir(mode=0o700)
        moved = layout.state_root / (run_id + "-original")
        original_rename = transaction.libc_rename
        attack = {"ran": False}

        def substitute(parent_fd, source, destination, flag):
            if (
                not attack["ran"]
                and source.startswith(".receipt-")
                and destination == "receipt.json"
            ):
                run_root.rename(moved)
                run_root.symlink_to(
                    outside,
                    target_is_directory=True,
                )
                attack["ran"] = True
            return original_rename(
                parent_fd,
                source,
                destination,
                flag,
            )

        transaction.libc_rename = substitute
        try:
            _, receipt = transaction.load_receipt(layout, run_id)
            expect_exact_error(
                lambda: transaction.atomic_json(
                    receipt_path,
                    receipt,
                    uid=layout.uid,
                    user_root=layout.home,
                ),
                "directory_chain_changed",
                "receipt-parent-chain-race",
            )
        finally:
            transaction.libc_rename = original_rename
        require(
            attack["ran"]
            and not any(outside.iterdir())
            and (moved / "receipt.json").read_bytes() == before
            and not any(
                name.startswith(".receipt-")
                for name in os.listdir(moved)
            ),
            "receipt_parent_chain_race_contract",
        )
        run_root.unlink()
        moved.rename(run_root)
        _, receipt = transaction.load_receipt(layout, run_id)
        require(
            receipt["state"] == "staged"
            and receipt["rollbackState"] == "not-run",
            "receipt_parent_chain_race_state",
        )

    fresh_negative(
        transaction,
        "receipt-parent-chain-race",
        receipt_parent_chain_race,
    )
    cases += 1

    def exact_preimages(layout):
        return {
            identifier: transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=True,
                user_root=layout.home,
            )["metadata"]
            for identifier, path in layout.targets().items()
        }

    def require_preimages(layout, before, reason):
        for identifier, path in layout.targets().items():
            current = transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=True,
                user_root=layout.home,
            )
            require(
                transaction.metadata_matches(
                    current,
                    before[identifier],
                ),
                reason + "_" + identifier,
            )

    def managed_skills_chain_race(root, layout):
        run_id = "p5-" + "cc" * 16
        before = exact_preimages(layout)
        transaction.stage(layout, run_id, gate_value("b"))
        outside = root / "outside-managed-skills"
        outside.mkdir(mode=0o700)
        skills = layout.codex_home / "skills"
        moved = layout.codex_home / "skills-original"
        original_mkdir = transaction.os.mkdir
        attack = {"ran": False}

        def substitute(name, mode=0o777, *, dir_fd=None):
            if (
                not attack["ran"]
                and name == "manage-workstation"
                and dir_fd is not None
            ):
                skills.rename(moved)
                skills.symlink_to(outside, target_is_directory=True)
                attack["ran"] = True
            return original_mkdir(name, mode, dir_fd=dir_fd)

        transaction.os.mkdir = substitute
        try:
            expect_exact_error(
                lambda: transaction.apply_receipt(layout, run_id),
                "automatic_rollback_failed",
                "managed-skills-chain-race",
            )
        finally:
            transaction.os.mkdir = original_mkdir
        _, receipt = transaction.load_receipt(layout, run_id)
        require(
            attack["ran"]
            and receipt["state"] == "rollback-failed"
            and receipt["rollbackState"] == "failed"
            and not any(outside.iterdir())
            and not (moved / "manage-workstation").exists()
            and not (layout.codex_home / "hooks").exists(),
            "managed_skills_chain_race_contract",
        )
        skills.unlink()
        moved.rename(skills)
        transaction.rollback_receipt(layout, run_id)
        transaction.verify_rollback(layout, run_id)
        require_preimages(
            layout,
            before,
            "managed_skills_chain_race_preimage",
        )

    fresh_negative(
        transaction,
        "managed-skills-chain-race",
        managed_skills_chain_race,
    )
    cases += 1

    def target_parent_chain_race(root, layout):
        run_id = "p5-" + "cd" * 16
        before = exact_preimages(layout)
        transaction.stage(layout, run_id, gate_value("b"))
        outside = root / "outside-skill-target"
        outside.mkdir(mode=0o700)
        skills = layout.codex_home / "skills"
        moved = layout.codex_home / "skills-original"
        attack = {"ran": False}

        def substitute(identifier, _path):
            if identifier == "skill-definition" and not attack["ran"]:
                skills.rename(moved)
                skills.symlink_to(outside, target_is_directory=True)
                attack["ran"] = True

        expect_exact_error(
            lambda: transaction.apply_receipt(
                layout,
                run_id,
                before_atomic=substitute,
            ),
            "automatic_rollback_failed",
            "target-parent-chain-race",
        )
        _, receipt = transaction.load_receipt(layout, run_id)
        require(
            attack["ran"]
            and receipt["state"] == "rollback-failed"
            and receipt["rollbackState"] == "failed"
            and not any(outside.iterdir())
            and not (
                moved / "manage-workstation/SKILL.md"
            ).exists(),
            "target_parent_chain_race_contract",
        )
        skills.unlink()
        moved.rename(skills)
        transaction.rollback_receipt(layout, run_id)
        transaction.verify_rollback(layout, run_id)
        require_preimages(
            layout,
            before,
            "target_parent_chain_race_preimage",
        )

    fresh_negative(
        transaction,
        "target-parent-chain-race",
        target_parent_chain_race,
    )
    cases += 1

    def invalid_run_id(root, layout):
        transaction.stage(layout, "../escape", gate_value("b"))

    rejected("invalid-run-id", invalid_run_id)

    def source_symlink(root, layout):
        control = root / "source-control"
        source = control / "codex/global-AGENTS.md"
        source.parent.mkdir(parents=True)
        source.symlink_to(ROOT / "codex/global-AGENTS.md")
        direct = transaction.Layout(
            layout.home,
            control,
            layout.state_root,
            layout.codex_home,
            layout.aid_bin,
        )
        expected = digest(ROOT / "codex/global-AGENTS.md")
        expect_exact_error(
            lambda: transaction.source_bytes(
                direct, "codex/global-AGENTS.md", expected
            ),
            "source_file",
            "source-symlink",
        )

    fresh_negative(transaction, "source-symlink", source_symlink)
    cases += 1

    def manifest_target_drift(root, layout):
        path = root / "manifest.json"
        value = strict_json(ROOT / MANIFEST)
        value["transaction"]["destinations"][0]["target"] = (
            "$HOME/.codex/auth.json"
        )
        path.write_text(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            + "\n"
        )
        expect_exact_error(
            lambda: transaction.load_manifest(path),
            "manifest_destination_contract",
            "manifest-target-drift",
        )

    fresh_negative(transaction, "manifest-target-drift", manifest_target_drift)
    cases += 1

    def toctou(root, layout):
        run_id = "p5-" + "1a" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        moved = layout.codex_home / "config.original"

        def substitute(identifier, path):
            if identifier != "config":
                return
            path.rename(moved)
            path.write_text(
                'approval_policy = "on-request"\n'
                'sandbox_mode = "workspace-write"\n'
            )
            os.chmod(path, 0o600)

        transaction.apply_receipt(
            layout, run_id, before_atomic=substitute
        )

    rejected("toctou-substitution", toctou)

    def automatic_rollback(root, layout):
        run_id = "p5-" + "2a" * 16
        before = {
            identifier: transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=identifier != "config",
                user_root=layout.home,
            )["metadata"]
            for identifier, path in layout.targets().items()
        }
        transaction.stage(layout, run_id, gate_value("b"))
        expect_error(
            lambda: transaction.apply_receipt(
                layout, run_id, fail_after=2
            ),
            "injected_failure",
        )
        _, receipt = transaction.load_receipt(layout, run_id)
        require(
            receipt["state"] == "rolled-back-after-failure"
            and receipt["rollbackState"] == "complete",
            "automatic_rollback_state",
        )
        for identifier, path in layout.targets().items():
            current = transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=True,
                user_root=layout.home,
            )
            require(
                transaction.metadata_matches(
                    current, before[identifier]
                ),
                "automatic_rollback_exact_" + identifier,
            )

    fresh_negative(transaction, "automatic-rollback", automatic_rollback)
    cases += 1

    def post_install_rollback(root, layout):
        run_id = "p5-" + "aa" * 16
        before = {
            identifier: transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=identifier != "config",
                user_root=layout.home,
            )["metadata"]
            for identifier, path in layout.targets().items()
        }
        transaction.stage(layout, run_id, gate_value("b"))

        def corrupt(identifier, path):
            if identifier == "config":
                path.write_bytes(path.read_bytes() + b"# post-rename drift\n")
                os.chmod(path, 0o600)

        expect_exact_error(
            lambda: transaction.apply_receipt(
                layout, run_id, after_atomic=corrupt
            ),
            "post_install_hash",
            "post-install-hash",
        )
        _, receipt = transaction.load_receipt(layout, run_id)
        require(
            receipt["state"] == "rolled-back-after-failure"
            and receipt["rollbackState"] == "complete",
            "post_install_rollback_state",
        )
        for identifier, path in layout.targets().items():
            current = transaction.snapshot_path(
                path,
                layout.uid,
                transaction.MAX_CONFIG,
                allow_absent=True,
                user_root=layout.home,
            )
            require(
                transaction.metadata_matches(
                    current, before[identifier]
                ),
                "post_install_rollback_exact_" + identifier,
            )

    fresh_negative(transaction, "post-install-rollback", post_install_rollback)
    cases += 1

    def rollback_failure(root, layout):
        run_id = "p5-" + "3a" * 16
        transaction.stage(layout, run_id, gate_value("b"))
        transaction.apply_receipt(layout, run_id)
        extra = layout.codex_home / "hooks/unexpected"
        extra.write_text("unexpected\n")
        os.chmod(extra, 0o600)
        expect_error(
            lambda: transaction.rollback_receipt(layout, run_id),
            "rollback_failure",
        )
        _, receipt = transaction.load_receipt(layout, run_id)
        require(
            receipt["state"] == "rollback-failed"
            and receipt["rollbackState"] == "failed",
            "rollback_failure_state",
        )

    fresh_negative(transaction, "rollback-failure", rollback_failure)
    cases += 1
    return {"negativeCases": cases}


def cli_capability():
    facts = CODEX.lstat()
    require(
        stat.S_ISREG(facts.st_mode)
        and not CODEX.is_symlink()
        and os.access(CODEX, os.X_OK)
        and CODEX.resolve(strict=True) == CODEX,
        "canonical_cli",
    )
    with tempfile.TemporaryDirectory(
        prefix="phase5-apply-cli-"
    ) as directory:
        home = Path(directory).resolve()
        environment = {
            "CODEX_HOME": str(home),
            "HOME": str(home),
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "SHELL": "/bin/zsh",
        }
        version = run([CODEX, "--version"], cwd=home, environment=environment)
        root_help = run([CODEX, "--help"], cwd=home, environment=environment)
        exec_help = run(
            [CODEX, "exec", "--help"], cwd=home, environment=environment
        )
        sandbox_help = run(
            [CODEX, "sandbox", "--help"],
            cwd=home,
            environment=environment,
        )
        require(
            version.returncode == 0
            and signed_vendor_floor(version.stdout.strip())
            and root_help.returncode == 0
            and "--strict-config" in root_help.stdout
            and exec_help.returncode == 0
            and all(
                flag in exec_help.stdout
                for flag in (
                    "--ephemeral",
                    "--ignore-rules",
                    "--ignore-user-config",
                    "--profile",
                )
            )
            and sandbox_help.returncode == 0
            and "--permission-profile" in sandbox_help.stdout,
            "canonical_cli_help",
        )
    return True


def relevant_helper_processes():
    total = 0
    for pattern in (
        "[p]hase5-apply-transaction",
        "[p]hase5-config-overlay-parser",
        "[c]odex app-server",
    ):
        result = run(["/usr/bin/pgrep", "-f", pattern])
        require(
            result.returncode in {0, 1},
            "production_layout_helper_probe",
        )
        if result.returncode == 0:
            total += len(
                [line for line in result.stdout.splitlines() if line]
            )
    return total


def reconciled_layout_expectations(transaction, layout, run_id):
    root, receipt = transaction.load_receipt(layout, run_id)
    live = transaction.snapshot_path(
        layout.targets()["config"],
        layout.uid,
        transaction.MAX_CONFIG,
        allow_absent=False,
        user_root=layout.home,
    )
    receipt_snapshot = transaction.snapshot_path(
        root / "receipt.json",
        layout.uid,
        256 * 1024,
        allow_absent=False,
        user_root=layout.home,
    )
    companion = transaction.snapshot_path(
        root / transaction.OVERLAY_RECEIPT,
        layout.uid,
        256 * 1024,
        allow_absent=False,
        user_root=layout.home,
    )
    preimage = transaction.snapshot_path(
        root / "preimages" / transaction.OVERLAY_PREIMAGE,
        layout.uid,
        transaction.MAX_CONFIG,
        allow_absent=False,
        user_root=layout.home,
    )
    after = transaction.config_base_bytes(
        layout,
        root,
        receipt,
        "after",
    )
    return {
        "afterLength": len(after),
        "afterSHA256": transaction.digest_bytes(after),
        "companionSHA256": companion["metadata"]["sha256"],
        "configLength": live["metadata"]["size"],
        "configSHA256": live["metadata"]["sha256"],
        "preimageLength": preimage["metadata"]["size"],
        "preimageSHA256": preimage["metadata"]["sha256"],
        "receiptCoreSHA256":
            transaction.receipt_core_digest(receipt),
        "receiptSHA256": receipt_snapshot["metadata"]["sha256"],
        "runNames": sorted(
            transaction.directory_names(
                root,
                layout.uid,
                {0o700},
                layout.home,
            )
        ),
        "preimageNames": sorted(
            transaction.directory_names(
                root / "preimages",
                layout.uid,
                {0o700},
                layout.home,
            )
        ),
        "stagedNames": sorted(
            transaction.directory_names(
                root / "staged",
                layout.uid,
                {0o700},
                layout.home,
            )
        ),
    }


def reconciled_layout_probe(
    transaction,
    layout,
    run_id,
    expected,
    *,
    check_helpers,
    fixture_helper_counter=None,
):
    root, receipt = transaction.load_receipt(layout, run_id)
    record = transaction.load_overlay_record(
        layout,
        root,
        receipt,
        allow_missing=False,
    )
    before = transaction.config_base_bytes(
        layout,
        root,
        receipt,
        "before",
    )
    after = transaction.config_base_bytes(
        layout,
        root,
        receipt,
        "after",
    )
    overlay = transaction.exact_hook_overlay(layout)
    historical = transaction.compose_project_trust_config(
        layout,
        after,
        overlay,
    )
    reconciled = transaction.compose_exact_config(after, overlay)
    live = transaction.snapshot_path(
        layout.targets()["config"],
        layout.uid,
        transaction.MAX_CONFIG,
        allow_absent=False,
        user_root=layout.home,
    )
    receipt_snapshot = transaction.snapshot_path(
        root / "receipt.json",
        layout.uid,
        256 * 1024,
        allow_absent=False,
        user_root=layout.home,
    )
    companion = transaction.snapshot_path(
        root / transaction.OVERLAY_RECEIPT,
        layout.uid,
        256 * 1024,
        allow_absent=False,
        user_root=layout.home,
    )
    preimage = transaction.snapshot_path(
        root / "preimages" / transaction.OVERLAY_PREIMAGE,
        layout.uid,
        transaction.MAX_CONFIG,
        allow_absent=False,
        user_root=layout.home,
    )
    project_rows = sum(
        line.startswith(b"[projects.")
        for line in live["bytes"].splitlines()
    )
    hook_parents = sum(
        line == b"[hooks.state]"
        for line in live["bytes"].splitlines()
    )
    hook_leaves = sum(
        line.startswith(b"[hooks.state.")
        for line in live["bytes"].splitlines()
    )
    non_config = 0
    for identifier, target in layout.targets().items():
        if identifier == "config":
            continue
        current = transaction.snapshot_path(
            target,
            layout.uid,
            transaction.MAX_CONFIG,
            allow_absent=False,
            user_root=layout.home,
        )
        if transaction.metadata_matches(
            current,
            transaction.target_row(receipt, identifier)["after"],
        ):
            non_config += 1
    if fixture_helper_counter is None:
        helper_count = relevant_helper_processes() if check_helpers else 0
    else:
        # This seam is used only by the isolated synthetic fixture below. The
        # integrated production route supplies no counter and therefore always
        # observes the real process table through relevant_helper_processes().
        require(check_helpers and callable(fixture_helper_counter),
                "fixture_helper_counter")
        helper_count = fixture_helper_counter()
        require(isinstance(helper_count, int) and helper_count >= 0,
                "fixture_helper_counter")
    run_names = sorted(
        transaction.directory_names(
            root,
            layout.uid,
            {0o700},
            layout.home,
        )
    )
    preimage_names = sorted(
        transaction.directory_names(
            root / "preimages",
            layout.uid,
            {0o700},
            layout.home,
        )
    )
    staged_names = sorted(
        transaction.directory_names(
            root / "staged",
            layout.uid,
            {0o700},
            layout.home,
        )
    )
    redacted = companion["bytes"]
    require(
        all(
            token not in redacted
            for token in (
                str(layout.home).encode(),
                b"/" + b"Users/",
                b"auth.json",
                b"Bearer ",
                b"approval_policy",
                b"sandbox_mode",
            )
        ),
        "production_companion_redaction",
    )
    require(
        len(after) == expected["afterLength"]
        and transaction.digest_bytes(after)
        == expected["afterSHA256"]
        and len(live["bytes"]) == expected["configLength"]
        and live["metadata"]["sha256"]
        == expected["configSHA256"]
        and live["bytes"] == reconciled
        and live["metadata"]["mode"]
        == transaction.target_row(receipt, "config")["after"]["mode"]
        and live["metadata"]["linkCount"] == 1
        and preimage["bytes"] == historical
        and preimage["metadata"]["size"]
        == expected["preimageLength"]
        and preimage["metadata"]["sha256"]
        == expected["preimageSHA256"]
        and preimage["metadata"]["mode"] == "0600"
        and preimage["metadata"]["linkCount"] == 1
        and companion["metadata"]["sha256"]
        == expected["companionSHA256"]
        and companion["metadata"]["mode"] == "0600"
        and companion["metadata"]["linkCount"] == 1
        and receipt_snapshot["metadata"]["sha256"]
        == expected["receiptSHA256"]
        and receipt_snapshot["metadata"]["mode"] == "0600"
        and receipt_snapshot["metadata"]["linkCount"] == 1
        and transaction.receipt_core_digest(receipt)
        == expected["receiptCoreSHA256"]
        and run_names == expected["runNames"]
        and preimage_names == expected["preimageNames"]
        and staged_names == expected["stagedNames"]
        and receipt["state"] == "applied"
        and receipt["applyResult"] == "applied"
        and receipt["rollbackState"] == "available"
        and record["state"] == "reconciled"
        and record["rollbackState"] == "not-required"
        and record["configBeforeReconciliationSHA256"]
        == expected["preimageSHA256"]
        and record["reconciledConfigSHA256"]
        == expected["configSHA256"]
        and record["receiptSHA256AtReconciliation"]
        == expected["receiptSHA256"]
        and record["receiptCoreSHA256"]
        == expected["receiptCoreSHA256"]
        and record["hookOverlaySHA256"]
        == transaction.digest_bytes(overlay)
        and project_rows == 19
        and hook_parents == 1
        and hook_leaves == 3
        and transaction.exact_project_trust_block(layout)
        not in live["bytes"]
        and non_config == 7
        and helper_count == 0,
        "reconciled_production_contract",
    )
    return {
        "companion": {
            "linkCount": 1,
            "mode": "0600",
            "rollbackState": record["rollbackState"],
            "sha256": companion["metadata"]["sha256"],
            "state": record["state"],
        },
        "config": {
            "length": len(live["bytes"]),
            "sha256": live["metadata"]["sha256"],
        },
        "controlProjectTrustRows": 0,
        "hookParents": hook_parents,
        "hookTrustRecords": hook_leaves,
        "legacyPreReconciliation": {
            "historicalFixtureRetained": True,
            "length": len(historical),
            "productionAccepted": False,
            "sha256": transaction.digest_bytes(historical),
        },
        "nonConfigTargetsExact": non_config,
        "preimage": {
            "length": preimage["metadata"]["size"],
            "linkCount": 1,
            "mode": "0600",
            "sha256": preimage["metadata"]["sha256"],
        },
        "projectRows": project_rows,
        "readOnly": True,
        "receipt": {
            "applyResult": receipt["applyResult"],
            "coreSHA256":
                transaction.receipt_core_digest(receipt),
            "rollbackState": receipt["rollbackState"],
            "sha256": receipt_snapshot["metadata"]["sha256"],
            "state": receipt["state"],
        },
        "relevantHelperProcesses": helper_count,
        "transactionDirectoryShapeExact": True,
        "schema": 1,
    }


def production_layout_probe(transaction):
    layout = transaction.production_layout()
    expected = {
        "afterLength": transaction.LEGACY_CONFIG_BASE_LENGTH,
        "afterSHA256": transaction.LEGACY_CONFIG_BASE_SHA256,
        "companionSHA256": RECONCILIATION_COMPANION_SHA256,
        "configLength": RECONCILED_CONFIG_LENGTH,
        "configSHA256": RECONCILED_CONFIG_SHA256,
        "preimageLength": transaction.LEGACY_CONFIG_DRIFT_LENGTH,
        "preimageSHA256": transaction.LEGACY_CONFIG_DRIFT_SHA256,
        "receiptCoreSHA256":
            transaction.LEGACY_RECEIPT_CORE_SHA256,
        "receiptSHA256": transaction.LEGACY_RECEIPT_SHA256,
        "runNames": [
            transaction.OVERLAY_RECEIPT,
            "preimages",
            "receipt.json",
            "staged",
        ],
        "preimageNames": [
            "config",
            transaction.OVERLAY_PREIMAGE,
            "global-agents",
            "hook-router.absent",
            "hooks-definition.absent",
            "quarantine-launcher.absent",
            "quarantine-profile.absent",
            "skill-definition.absent",
            "skill-metadata.absent",
        ],
        "stagedNames": [
            "config",
            "global-agents",
            "hook-router",
            "hooks-definition",
            "quarantine-launcher",
            "quarantine-profile",
            "skill-definition",
            "skill-metadata",
        ],
    }
    result = reconciled_layout_probe(
        transaction,
        layout,
        transaction.LEGACY_RUN_ID,
        expected,
        check_helpers=True,
    )
    require(
        result["legacyPreReconciliation"]["length"]
        == transaction.LEGACY_CONFIG_DRIFT_LENGTH
        and result["legacyPreReconciliation"]["sha256"]
        == transaction.LEGACY_CONFIG_DRIFT_SHA256
        and result["config"]["length"]
        == RECONCILED_CONFIG_LENGTH
        and result["config"]["sha256"]
        == RECONCILED_CONFIG_SHA256
        and result["companion"]["sha256"]
        == RECONCILIATION_COMPANION_SHA256,
        "production_reconciliation_binding",
    )
    return result


def production_helper_counter_static_negative():
    """Production must be permanently bound to the real global counter."""
    source = (ROOT / VALIDATOR).read_text()
    start = source.index("def production_layout_probe(")
    end = source.index("\ndef production_helper_counter_static_negative(", start)
    production = source[start:end]
    require("check_helpers=True" in production
            and "fixture_helper_counter" not in production,
            "production_helper_counter_bypass")
    require("helper_count = relevant_helper_processes() if check_helpers else 0" in source,
            "production_helper_counter_real_probe")
    return True


def production_state_negatives(transaction):
    cases = 0
    with tempfile.TemporaryDirectory(
        prefix="phase5-post-reconciliation-state-"
    ) as directory:
        root = Path(directory).resolve()
        layout, run_id, old_live = prepared_overlay_fixture(
            transaction,
            root,
        )
        transaction.reconcile_receipt(layout, run_id)
        expected = reconciled_layout_expectations(
            transaction,
            layout,
            run_id,
        )
        reconciled_layout_probe(
            transaction,
            layout,
            run_id,
            expected,
            check_helpers=False,
        )
        run_root = layout.state_root / run_id
        config = layout.targets()["config"]
        companion = run_root / transaction.OVERLAY_RECEIPT
        preimage = run_root / "preimages" / transaction.OVERLAY_PREIMAGE
        receipt = run_root / "receipt.json"
        target = layout.targets()["global-agents"]
        originals = {
            path: (path.read_bytes(), stat.S_IMODE(path.stat().st_mode))
            for path in (
                config,
                companion,
                preimage,
                receipt,
                target,
            )
        }

        def restore(path):
            value, mode = originals[path]
            path.write_bytes(value)
            os.chmod(path, mode)

        def rejected(action, name):
            nonlocal cases
            action()
            expect_error(
                lambda: reconciled_layout_probe(
                    transaction,
                    layout,
                    run_id,
                    expected,
                    check_helpers=False,
                ),
                name,
            )
            cases += 1

        rejected(lambda: config.write_bytes(old_live), "old-6300-live")
        restore(config)

        transforms = (
            lambda value: value.replace(
                b"[hooks.state.",
                b"# comment drift\n[hooks.state.",
                1,
            ),
            lambda value: b"\n" + value,
            lambda value: value.replace(
                b"model = \"fixture\"",
                b"model = 'fixture'",
                1,
            ),
            lambda value: value.replace(
                b'trust_level = "trusted"',
                b'trust_level=\"trusted\"',
                1,
            ),
            lambda value: value.replace(
                b"[hooks.state]\n\n",
                b"",
                1,
            ),
            lambda value: value.replace(
                b"[hooks.state]\n\n",
                b"[hooks.state] # reformatted\n\n",
                1,
            ),
            lambda value: value.replace(
                b'trusted_hash = "',
                b'trusted_hash="',
                1,
            ),
            lambda value: value + b"\n",
            lambda value: value
            + transaction.exact_project_trust_block(layout),
        )
        for index, transform in enumerate(transforms):
            rejected(
                lambda mutate=transform:
                    config.write_bytes(mutate(originals[config][0])),
                "config-byte-drift-" + str(index),
            )
            restore(config)

        companion_bytes = originals[companion][0]
        companion_value = strict_json_text(
            companion_bytes.decode(),
            "fixture_companion",
        )
        companion.unlink()
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "companion-missing",
        )
        cases += 1
        restore(companion)
        extra = run_root / "unexpected-companion"
        extra.write_text("{}\n")
        os.chmod(extra, 0o600)
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "companion-extra",
        )
        cases += 1
        extra.unlink()
        for name, value in (
            ("companion-malformed", b"{"),
            (
                "companion-duplicate",
                companion_bytes.replace(
                    b"{",
                    b'{"schema":1,',
                    1,
                ),
            ),
            (
                "companion-size",
                companion_bytes + b" ",
            ),
        ):
            rejected(lambda item=value: companion.write_bytes(item), name)
            restore(companion)
        for name, key, value in (
            ("companion-schema", "schema", 2),
            ("companion-state", "state", "prepared"),
            (
                "companion-binding",
                "hookOverlaySHA256",
                "0" * 64,
            ),
        ):
            changed = dict(companion_value)
            changed[key] = value
            encoded = (
                json.dumps(
                    changed,
                    sort_keys=True,
                    separators=(",", ":"),
                )
                + "\n"
            ).encode()
            rejected(
                lambda item=encoded: companion.write_bytes(item),
                name,
            )
            restore(companion)
        os.chmod(companion, 0o640)
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "companion-mode",
        )
        cases += 1
        restore(companion)
        companion_link = run_root / "companion-hardlink"
        os.link(companion, companion_link)
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "companion-link-count",
        )
        cases += 1
        companion_link.unlink()
        expect_error(
            lambda: transaction.snapshot_path(
                companion,
                layout.uid + 1,
                256 * 1024,
                allow_absent=False,
                user_root=layout.home,
            ),
            "companion-owner",
        )
        cases += 1

        preimage.unlink()
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "preimage-missing",
        )
        cases += 1
        restore(preimage)
        preimage_extra = run_root / "preimages/unexpected-overlay"
        preimage_extra.write_text("unexpected\n")
        os.chmod(preimage_extra, 0o600)
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "preimage-extra",
        )
        cases += 1
        preimage_extra.unlink()
        rejected(
            lambda: preimage.write_bytes(
                originals[preimage][0] + b"# drift\n"
            ),
            "preimage-drift",
        )
        restore(preimage)
        os.chmod(preimage, 0o640)
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "preimage-mode",
        )
        cases += 1
        restore(preimage)
        preimage_link = run_root / "preimages/preimage-hardlink"
        os.link(preimage, preimage_link)
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=False,
            ),
            "preimage-link-count",
        )
        cases += 1
        preimage_link.unlink()
        expect_error(
            lambda: transaction.snapshot_path(
                preimage,
                layout.uid + 1,
                transaction.MAX_CONFIG,
                allow_absent=False,
                user_root=layout.home,
            ),
            "preimage-owner",
        )
        cases += 1

        receipt_value = strict_json_text(
            originals[receipt][0].decode(),
            "fixture_receipt",
        )
        receipt_value["sourceCommit"] = "d" * 40
        rejected(
            lambda: receipt.write_text(
                json.dumps(
                    receipt_value,
                    sort_keys=True,
                    separators=(",", ":"),
                )
                + "\n"
            ),
            "receipt-core-drift",
        )
        restore(receipt)
        rejected(
            lambda: target.write_bytes(
                originals[target][0] + b"drift\n"
            ),
            "non-config-target-drift",
        )
        restore(target)

        baseline_helpers = relevant_helper_processes()
        process = subprocess.Popen(
            [
                "/usr/bin/python3",
                "-c",
                "import time; time.sleep(30)",
                "phase5-config-overlay-parser",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        try:
            observed_helpers = None
            for _attempt in range(20):
                observed_helpers = relevant_helper_processes()
                if observed_helpers == baseline_helpers + 1:
                    break
                time.sleep(0.05)
            require(
                observed_helpers == baseline_helpers + 1,
                "helper_fixture_start",
            )
            expect_error(
                lambda: reconciled_layout_probe(
                    transaction,
                    layout,
                    run_id,
                    expected,
                    check_helpers=True,
                    fixture_helper_counter=lambda: 1,
                ),
                "helper-process",
            )
            cases += 1
        finally:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5)
        require(
            relevant_helper_processes() == baseline_helpers,
            "helper_fixture_teardown",
        )
        reconciled_layout_probe(
            transaction,
            layout,
            run_id,
            expected,
            check_helpers=True,
            fixture_helper_counter=lambda: 0,
        )
        expect_error(
            lambda: reconciled_layout_probe(
                transaction,
                layout,
                run_id,
                expected,
                check_helpers=True,
                fixture_helper_counter=lambda: -1,
            ),
            "helper-fixture-counter-negative",
        )
        cases += 1
        require(production_helper_counter_static_negative(),
                "production-helper-counter-static-negative")
        cases += 1
    return {"cases": cases, "failClosed": True}


def synthetic_commit(directory, message, identity, *, allow_empty=False):
    environment = {
        "GIT_AUTHOR_EMAIL": identity[1],
        "GIT_AUTHOR_NAME": identity[0],
        "GIT_COMMITTER_EMAIL": identity[3],
        "GIT_COMMITTER_NAME": identity[2],
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "HOME": str(directory),
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
    }
    command = [*GIT, "commit", "-q", "--no-gpg-sign", "-m", message]
    if allow_empty:
        command.insert(-2, "--allow-empty")
    checked(command, cwd=directory, environment=environment)


def topology_matrix(review_state):
    workspace = Path(
        tempfile.mkdtemp(
            prefix="phase5-post-reconciliation-topology-correction-"
        )
    )
    negatives = 0
    current = git("rev-parse", "HEAD")

    def clone(name):
        destination = workspace / name
        checked(
            [
                *GIT,
                "clone",
                "--no-local",
                "--quiet",
                "--branch",
                BRANCH,
                ROOT,
                destination,
            ]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=destination)
        require(
            git_at(destination, "remote") == ""
            and git_at(destination, "rev-parse", "HEAD") == current,
            "topology_correction_clone",
        )
        return destination

    def validator(directory):
        return run(
            [directory / VALIDATOR, "--git-only", "--json"],
            cwd=directory,
        )

    def rejected(directory, reason, name):
        nonlocal negatives
        result = validator(directory)
        value = strict_json_text(result.stdout)
        require(
            result.returncode != 0
            and value
            == {
                "error": reason,
                "mode": "git-only",
                "schema": 1,
                "verdict": "FAIL",
            },
            "unstable_topology_correction_reason_" + name,
        )
        negatives += 1

    def checkout_current(directory, paths):
        checked(
            [*GIT, "checkout", current, "--", *sorted(paths)],
            cwd=directory,
        )

    def synthetic_pair(
        directory,
        *,
        base=TOPOLOGY_CORRECTION_BASE,
        implementation_identity=EXECUTOR_METADATA,
        implementation_extra=False,
        evidence_identity=EXECUTOR_METADATA,
        evidence_extra=False,
        evidence_raw=None,
        intervening=False,
        reverse=False,
    ):
        checked(
            [*GIT, "checkout", "-q", "-B", "main", base],
            cwd=directory,
        )
        if intervening:
            synthetic_commit(
                directory,
                "Intervening correction fixture",
                EXECUTOR_METADATA,
                allow_empty=True,
            )
        sequence = (
            ("evidence", "implementation")
            if reverse
            else ("implementation", "evidence")
        )
        for kind in sequence:
            if kind == "implementation":
                checkout_current(
                    directory,
                    TOPOLOGY_CORRECTION_SCOPE,
                )
                paths = sorted(
                    TOPOLOGY_CORRECTION_SCOPE
                )
                if implementation_extra:
                    (directory / "implementation-extra").write_text(
                        "extra\n"
                    )
                    paths.append("implementation-extra")
                checked([*GIT, "add", "--", *paths], cwd=directory)
                synthetic_commit(
                    directory,
                    "Synthetic topology correction implementation",
                    implementation_identity,
                )
            else:
                path = directory / TOPOLOGY_CORRECTION_EVIDENCE
                path.parent.mkdir(parents=True, exist_ok=True)
                if evidence_raw is None:
                    checkout_current(
                        directory,
                        TOPOLOGY_CORRECTION_EVIDENCE_SCOPE,
                    )
                else:
                    path.write_text(evidence_raw)
                paths = [TOPOLOGY_CORRECTION_EVIDENCE]
                if evidence_extra:
                    (directory / "evidence-extra").write_text("extra\n")
                    paths.append("evidence-extra")
                checked([*GIT, "add", "--", *paths], cwd=directory)
                synthetic_commit(
                    directory,
                    "Synthetic topology correction evidence",
                    evidence_identity,
                )

    try:
        review = clone("review")
        result = validator(review)
        value = strict_json_text(result.stdout)
        require(
            result.returncode == 0
            and value["repositoryState"] == "review"
            and value["verdict"] == REVIEW_VERDICT
            and value["marker"] == MARKER
            and value["acceptedControlCommit"]
            == APPLY_BUNDLE_ACCEPTANCE
            and value["protectedBaselineCommit"]
            == review_state["evidenceCommit"],
            "topology_correction_review_positive",
        )

        integrated = clone("integrated")
        checked(
            [*GIT, "checkout", "-q", "-B", "main"],
            cwd=integrated,
        )
        value = strict_json_text(validator(integrated).stdout)
        require(
            value["repositoryState"] == "integrated_main"
            and value["verdict"] == ACCEPTED_VERDICT
            and value["acceptedControlCommit"]
            == APPLY_BUNDLE_ACCEPTANCE
            and value["protectedBaselineCommit"]
            == review_state["evidenceCommit"]
            and value["liveApplyAuthorized"] is False
            and value["phase5PassClaimed"] is False
            and value["phase6Authorized"] is False,
            "topology_correction_integrated_positive",
        )
        for index in (1, 2):
            path = integrated / (
                "notes/topology-correction-descendant-" + str(index)
            )
            path.parent.mkdir(exist_ok=True)
            path.write_text("unprotected\n")
            checked(
                [*GIT, "add", "--", path.relative_to(integrated)],
                cwd=integrated,
            )
            synthetic_commit(
                integrated,
                "Unprotected topology correction descendant "
                + str(index),
                EXECUTOR_METADATA,
            )
            require(
                validator(integrated).returncode == 0,
                "topology_correction_unprotected_descendant",
            )

        historical = clone("historical-accepted")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                APPLY_BUNDLE_ACCEPTANCE,
            ],
            cwd=historical,
        )
        historical_result = validator(historical)
        historical_value = strict_json_text(
            historical_result.stdout
        )
        require(
            historical_result.returncode == 0
            and historical_value["repositoryState"]
            == "integrated_main"
            and historical_value["verdict"] == ACCEPTED_VERDICT,
            "historical_acceptance_positive",
        )

        historical_hook = clone("historical-hook-correction")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                HOOK_TRUST_REVIEW_HEAD,
            ],
            cwd=historical_hook,
        )
        historical_hook_result = validator(historical_hook)
        historical_hook_value = strict_json_text(
            historical_hook_result.stdout
        )
        require(
            historical_hook_result.returncode == 0
            and historical_hook_value["repositoryState"]
            == "integrated_main"
            and historical_hook_value["verdict"] == ACCEPTED_VERDICT,
            "historical_hook_correction_positive",
        )

        historical_byte = clone("historical-byte-exactness")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                BYTE_EXACTNESS_REVIEW_HEAD,
            ],
            cwd=historical_byte,
        )
        historical_byte_result = validator(historical_byte)
        historical_byte_value = strict_json_text(
            historical_byte_result.stdout
        )
        require(
            historical_byte_result.returncode == 0
            and historical_byte_value["repositoryState"]
            == "integrated_main"
            and historical_byte_value["verdict"] == ACCEPTED_VERDICT,
            "historical_byte_exactness_positive",
        )

        historical_actual = clone("historical-actual-layout")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                ACTUAL_LAYOUT_REVIEW_HEAD,
            ],
            cwd=historical_actual,
        )
        historical_actual_result = validator(historical_actual)
        historical_actual_value = strict_json_text(
            historical_actual_result.stdout
        )
        require(
            historical_actual_result.returncode == 0
            and historical_actual_value["repositoryState"]
            == "integrated_main"
            and historical_actual_value["verdict"] == ACCEPTED_VERDICT,
            "historical_actual_layout_positive",
        )

        wrong_branch = clone("wrong-branch")
        checked(
            [*GIT, "checkout", "-q", "-b", "unexpected"],
            cwd=wrong_branch,
        )
        rejected(wrong_branch, "unexpected_branch", "wrong-branch")

        detached = clone("detached")
        checked([*GIT, "checkout", "-q", "--detach"], cwd=detached)
        rejected(detached, "unexpected_branch", "detached")

        dirty = clone("dirty")
        (dirty / "dirty").write_text("dirty\n")
        rejected(dirty, "dirty_worktree", "dirty")

        omitted = clone("omitted-extension")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                TOPOLOGY_CORRECTION_BASE,
            ],
            cwd=omitted,
        )
        checkout_current(omitted, {VALIDATOR})
        checked([*GIT, "add", "--", VALIDATOR], cwd=omitted)
        synthetic_commit(
            omitted,
            "Omitted hook evidence",
            EXECUTOR_METADATA,
        )
        rejected(
            omitted,
            "topology_correction_pair_commit_count",
            "omitted-extension",
        )

        reordered = clone("reordered-extension")
        synthetic_pair(reordered, reverse=True)
        rejected(
            reordered,
            "topology_correction_scope",
            "reordered-extension",
        )

        misparented = clone("misparented-extension")
        synthetic_pair(misparented, intervening=True)
        rejected(
            misparented,
            "topology_correction_scope",
            "misparented-extension",
        )

        multifile_implementation = clone(
            "multifile-implementation"
        )
        synthetic_pair(
            multifile_implementation,
            implementation_extra=True,
        )
        rejected(
            multifile_implementation,
            "topology_correction_scope",
            "multifile-implementation",
        )

        wrong_implementation_metadata = clone(
            "wrong-implementation-metadata"
        )
        synthetic_pair(
            wrong_implementation_metadata,
            implementation_identity=COORDINATOR_METADATA,
        )
        rejected(
            wrong_implementation_metadata,
            "topology_correction_metadata",
            "wrong-implementation-metadata",
        )

        multifile_evidence = clone("multifile-evidence")
        synthetic_pair(
            multifile_evidence,
            evidence_extra=True,
        )
        rejected(
            multifile_evidence,
            "topology_correction_evidence_scope",
            "multifile-evidence",
        )

        wrong_evidence_metadata = clone("wrong-evidence-metadata")
        synthetic_pair(
            wrong_evidence_metadata,
            evidence_identity=COORDINATOR_METADATA,
        )
        rejected(
            wrong_evidence_metadata,
            "topology_correction_evidence_metadata",
            "wrong-evidence-metadata",
        )

        malformed_evidence = clone("malformed-evidence")
        synthetic_pair(
            malformed_evidence,
            evidence_raw='{"schema":\n',
        )
        rejected(
            malformed_evidence,
            "topology_correction_evidence_json",
            "malformed-evidence",
        )

        wrong_evidence = clone("wrong-evidence")
        wrong_value = strict_json(ROOT / TOPOLOGY_CORRECTION_EVIDENCE)
        wrong_value["gate"]["phase5PassClaimed"] = True
        synthetic_pair(
            wrong_evidence,
            evidence_raw=json.dumps(
                wrong_value,
                sort_keys=True,
                separators=(",", ":"),
            )
            + "\n",
        )
        rejected(
            wrong_evidence,
            "topology_correction_evidence",
            "wrong-evidence",
        )

        for name, mutate in (
            ("missing-acceptance", "missing"),
            ("wrong-acceptance-parent", "parent"),
            ("wrong-acceptance-scope", "scope"),
            ("wrong-acceptance-metadata", "metadata"),
            ("wrong-acceptance-record", "record"),
        ):
            directory = clone(name)
            checked(
                [
                    *GIT,
                    "checkout",
                    "-q",
                    "-B",
                    "main",
                    DIRECTORY_CHAIN_REVIEW_HEAD,
                ],
                cwd=directory,
            )
            if mutate == "parent":
                synthetic_commit(
                    directory,
                    "Intervening acceptance fixture",
                    EXECUTOR_METADATA,
                    allow_empty=True,
                )
            if mutate != "missing":
                value = acceptance_value(
                    DIRECTORY_CHAIN_IMPLEMENTATION,
                    DIRECTORY_CHAIN_REVIEW_HEAD,
                )
                if mutate == "record":
                    value["phase5PassClaimed"] = True
                path = directory / ACCEPTANCE
                path.write_text(
                    json.dumps(
                        value,
                        sort_keys=True,
                        separators=(",", ":"),
                    )
                    + "\n"
                )
                paths = [ACCEPTANCE]
                if mutate == "scope":
                    (directory / "acceptance-extra").write_text(
                        "extra\n"
                    )
                    paths.append("acceptance-extra")
                checked([*GIT, "add", "--", *paths], cwd=directory)
                synthetic_commit(
                    directory,
                    "Synthetic invalid acceptance",
                    (
                        EXECUTOR_METADATA
                        if mutate == "metadata"
                        else COORDINATOR_METADATA
                    ),
                )
            checkout_current(directory, {VALIDATOR})
            checked([*GIT, "add", "--", VALIDATOR], cwd=directory)
            synthetic_commit(
                directory,
                "Validator after invalid acceptance",
                EXECUTOR_METADATA,
            )
            rejected(
                directory,
                "post_reconciliation_base_not_ancestor",
                name,
            )

        merged = clone("merge-descendant")
        checked(
            [*GIT, "checkout", "-q", "-B", "main"],
            cwd=merged,
        )
        checked([*GIT, "checkout", "-q", "-b", "side"], cwd=merged)
        (merged / "side-note").write_text("side\n")
        checked([*GIT, "add", "--", "side-note"], cwd=merged)
        synthetic_commit(merged, "Side note", EXECUTOR_METADATA)
        checked([*GIT, "checkout", "-q", "main"], cwd=merged)
        (merged / "main-note").write_text("main\n")
        checked([*GIT, "add", "--", "main-note"], cwd=merged)
        synthetic_commit(merged, "Main note", EXECUTOR_METADATA)
        environment = {
            "GIT_AUTHOR_EMAIL": EXECUTOR_METADATA[1],
            "GIT_AUTHOR_NAME": EXECUTOR_METADATA[0],
            "GIT_COMMITTER_EMAIL": EXECUTOR_METADATA[3],
            "GIT_COMMITTER_NAME": EXECUTOR_METADATA[2],
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "HOME": str(merged),
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin",
        }
        checked(
            [*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"],
            cwd=merged,
            environment=environment,
        )
        rejected(
            merged,
            "topology_correction_extension_merge",
            "merge-descendant",
        )

        for name, relative in (
            ("runner-drift", RUNNER),
            ("validator-drift", VALIDATOR),
            (
                "phase4-validator-drift",
                "bin/check-phase4-final-probes",
            ),
            ("phase4-doctor-drift", "bin/phase4-final-doctor"),
            ("phase5-validator-drift", "bin/check-phase5-prep"),
            ("phase5-preflight-drift", "bin/phase5-preflight"),
            ("manifest-drift", MANIFEST),
            (
                "topology-correction-evidence-drift",
                TOPOLOGY_CORRECTION_EVIDENCE,
            ),
            (
                "post-reconciliation-evidence-drift",
                POST_RECONCILIATION_EVIDENCE,
            ),
            (
                "actual-layout-evidence-drift",
                ACTUAL_LAYOUT_EVIDENCE,
            ),
            (
                "byte-exactness-evidence-drift",
                BYTE_EXACTNESS_EVIDENCE,
            ),
            ("hook-evidence-drift", HOOK_TRUST_EVIDENCE),
            ("apply-acceptance-drift", ACCEPTANCE),
            ("generated-source-drift", "codex/global-AGENTS.md"),
        ):
            directory = clone(name)
            checked(
                [*GIT, "checkout", "-q", "-B", "main"],
                cwd=directory,
            )
            path = directory / relative
            path.write_text(path.read_text() + "\n# protected drift\n")
            checked([*GIT, "add", "--", relative], cwd=directory)
            synthetic_commit(
                directory,
                "Protected hook baseline drift",
                EXECUTOR_METADATA,
            )
            rejected(
                directory,
                "protected_descendant_drift:" + relative,
                name,
            )

        nonancestor = clone("nonancestor")
        checked(
            [*GIT, "checkout", "-q", "--orphan", "main"],
            cwd=nonancestor,
        )
        checked([*GIT, "rm", "-q", "-rf", "."], cwd=nonancestor)
        (nonancestor / "orphan").write_text("orphan\n")
        checked([*GIT, "add", "--", "orphan"], cwd=nonancestor)
        synthetic_commit(nonancestor, "Orphan", EXECUTOR_METADATA)
        checkout_current(nonancestor, {VALIDATOR})
        checked([*GIT, "add", "--", VALIDATOR], cwd=nonancestor)
        synthetic_commit(
            nonancestor,
            "Validator on orphan",
            EXECUTOR_METADATA,
        )
        rejected(
            nonancestor,
            "accepted_base_not_ancestor",
            "nonancestor",
        )

        return {
            "historicalAcceptance": True,
            "integratedAndDescendants": 3,
            "invalidAcceptanceExactReasons": 5,
            "negativeCases": negatives,
            "review": True,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def trusted_probe_topology_matrix(review_state):
    workspace = Path(
        tempfile.mkdtemp(prefix="phase5-trusted-probe-topology-")
    )
    current = git("rev-parse", "HEAD")
    negatives = 0

    def clone(name):
        destination = workspace / name
        checked(
            [
                *GIT,
                "clone",
                "--no-local",
                "--quiet",
                "--branch",
                BRANCH,
                ROOT,
                destination,
            ]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=destination)
        require(
            git_at(destination, "remote") == ""
            and git_at(destination, "rev-parse", "HEAD") == current,
            "trusted_probe_clone",
        )
        return destination

    def validator(directory):
        return run(
            [directory / VALIDATOR, "--git-only", "--json"],
            cwd=directory,
        )

    def rejected(directory, reason, name):
        nonlocal negatives
        result = validator(directory)
        require(
            result.returncode != 0
            and strict_json_text(result.stdout)
            == {
                "error": reason,
                "mode": "git-only",
                "schema": 1,
                "verdict": "FAIL",
            },
            "trusted_probe_unstable_reason_" + name,
        )
        negatives += 1

    def checkout_current(directory, paths):
        checked(
            [*GIT, "checkout", current, "--", *sorted(paths)],
            cwd=directory,
        )

    def evidence_value(directory, public_contract_followup):
        value = strict_json(ROOT / TRUSTED_PROBE_EVIDENCE)
        value["publicContractFollowup"]["commit"] = (
            public_contract_followup
        )
        value["publicContractFollowup"]["filesSHA256"] = (
            implementation_hashes(
                directory,
                public_contract_followup,
                TRUSTED_PROBE_VALIDATOR_SCOPE,
            )
        )
        value["publicContractFollowup"]["parent"] = (
            TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP
        )
        value["protectedBaseline"]["reviewChain"] = [
            PRIOR_PROTECTED_BASELINE,
            TRUSTED_PROBE_STATUS,
            TRUSTED_PROBE_BASE,
            TRUSTED_PROBE_IMPLEMENTATION,
            TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
            TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
            public_contract_followup,
        ]
        return value

    def commit_evidence(
        directory,
        public_contract_followup,
        *,
        extra=False,
        identity=EXECUTOR_METADATA,
        raw=None,
    ):
        path = directory / TRUSTED_PROBE_EVIDENCE
        path.parent.mkdir(parents=True, exist_ok=True)
        if raw is None:
            raw = (
                canonical_json(
                    evidence_value(
                        directory,
                        public_contract_followup,
                    )
                )
                + "\n"
            )
        path.write_text(raw)
        paths = [TRUSTED_PROBE_EVIDENCE]
        if extra:
            (directory / "evidence-extra").write_text("extra\n")
            paths.append("evidence-extra")
        checked([*GIT, "add", "--", *paths], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic trusted-probe evidence",
            identity,
        )

    def commit_public_contract_followup(
        directory,
        *,
        extra=False,
        identity=EXECUTOR_METADATA,
    ):
        checkout_current(directory, TRUSTED_PROBE_VALIDATOR_SCOPE)
        paths = sorted(TRUSTED_PROBE_VALIDATOR_SCOPE)
        if extra:
            (directory / "validator-extra").write_text("extra\n")
            paths.append("validator-extra")
        checked([*GIT, "add", "--", *paths], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic trusted-probe public-contract follow-up",
            identity,
        )
        return git_at(directory, "rev-parse", "HEAD")

    def synthetic_pair(
        directory,
        *,
        intervening=False,
        reverse=False,
        public_extra=False,
        public_identity=EXECUTOR_METADATA,
        evidence_extra=False,
        evidence_identity=EXECUTOR_METADATA,
        evidence_raw=None,
    ):
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
            ],
            cwd=directory,
        )
        if intervening:
            synthetic_commit(
                directory,
                "Intervening trusted-probe fixture",
                EXECUTOR_METADATA,
                allow_empty=True,
            )
        if reverse:
            commit_evidence(
                directory,
                review_state["publicContractFollowupCommit"],
                extra=evidence_extra,
                identity=evidence_identity,
                raw=evidence_raw,
            )
            commit_public_contract_followup(
                directory,
                extra=public_extra,
                identity=public_identity,
            )
            return
        public_contract_followup = commit_public_contract_followup(
            directory,
            extra=public_extra,
            identity=public_identity,
        )
        commit_evidence(
            directory,
            public_contract_followup,
            extra=evidence_extra,
            identity=evidence_identity,
            raw=evidence_raw,
        )

    def synthetic_missing_implementation(directory):
        checked(
            [*GIT, "checkout", "-q", "-B", "main", TRUSTED_PROBE_BASE],
            cwd=directory,
        )
        checked(
            [
                *GIT,
                "checkout",
                TRUSTED_PROBE_IMPLEMENTATION,
                "--",
                *sorted(TRUSTED_PROBE_CORRECTION_SCOPE),
            ],
            cwd=directory,
        )
        checked(
            [
                *GIT,
                "add",
                "--",
                *sorted(TRUSTED_PROBE_CORRECTION_SCOPE),
            ],
            cwd=directory,
        )
        synthetic_commit(
            directory,
            "Synthetic replacement trusted-probe implementation",
            EXECUTOR_METADATA,
        )
        checked(
            [
                *GIT,
                "checkout",
                TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
                "--",
                VALIDATOR,
            ],
            cwd=directory,
        )
        checked([*GIT, "add", "--", VALIDATOR], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic first validator correction",
            EXECUTOR_METADATA,
        )
        checked(
            [
                *GIT,
                "checkout",
                TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
                "--",
                VALIDATOR,
            ],
            cwd=directory,
        )
        checked([*GIT, "add", "--", VALIDATOR], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic omitted-fixture validator follow-up",
            EXECUTOR_METADATA,
        )
        public_contract_followup = (
            commit_public_contract_followup(directory)
        )
        commit_evidence(
            directory,
            public_contract_followup,
        )

    def synthetic_missing_first_correction(directory):
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                TRUSTED_PROBE_IMPLEMENTATION,
            ],
            cwd=directory,
        )
        commit_public_contract_followup(directory)
        synthetic_commit(
            directory,
            "Synthetic placeholder omitted-fixture follow-up",
            EXECUTOR_METADATA,
            allow_empty=True,
        )
        synthetic_commit(
            directory,
            "Synthetic placeholder public-contract follow-up",
            EXECUTOR_METADATA,
            allow_empty=True,
        )
        commit_evidence(
            directory,
            git_at(directory, "rev-parse", "HEAD"),
        )

    def synthetic_missing_omitted_followup(directory):
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                TRUSTED_PROBE_FIRST_VALIDATOR_CORRECTION,
            ],
            cwd=directory,
        )
        commit_public_contract_followup(directory)
        synthetic_commit(
            directory,
            "Synthetic placeholder public-contract follow-up",
            EXECUTOR_METADATA,
            allow_empty=True,
        )
        commit_evidence(
            directory,
            git_at(directory, "rev-parse", "HEAD"),
        )

    try:
        review = clone("review")
        result = validator(review)
        value = strict_json_text(result.stdout)
        require(
            result.returncode == 0
            and set(value) == PUBLIC_GIT_ONLY_KEYS
            and value["repositoryState"] == "review"
            and value["verdict"] == REVIEW_VERDICT
            and value["marker"] == MARKER
            and value["protectedBaselineCommit"]
            == review_state["evidenceCommit"],
            "trusted_probe_review_positive",
        )

        integrated = clone("integrated")
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=integrated)
        integrated_value = strict_json_text(validator(integrated).stdout)
        require(
            set(integrated_value) == PUBLIC_GIT_ONLY_KEYS
            and integrated_value["repositoryState"] == "integrated_main"
            and integrated_value["verdict"] == ACCEPTED_VERDICT
            and integrated_value["protectedBaselineCommit"]
            == review_state["evidenceCommit"]
            and integrated_value["liveApplyAuthorized"] is False
            and integrated_value["phase5PassClaimed"] is False
            and integrated_value["phase6Authorized"] is False,
            "trusted_probe_integrated_positive",
        )
        for index in (1, 2):
            note = integrated / (
                "notes/trusted-probe-descendant-" + str(index)
            )
            note.parent.mkdir(exist_ok=True)
            note.write_text("unprotected\n")
            checked(
                [*GIT, "add", "--", note.relative_to(integrated)],
                cwd=integrated,
            )
            synthetic_commit(
                integrated,
                "Trusted-probe unprotected descendant " + str(index),
                EXECUTOR_METADATA,
            )
            require(
                validator(integrated).returncode == 0,
                "trusted_probe_unprotected_descendant",
            )

        historical = clone("historical-status")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                TRUSTED_PROBE_BASE,
            ],
            cwd=historical,
        )
        historical_state = validate_repository(
            historical,
            branch="main",
            head=TRUSTED_PROBE_BASE,
        )
        require(
            historical_state["repositoryState"] == "integrated_main"
            and historical_state["protectedBaselineCommit"]
            == PRIOR_PROTECTED_BASELINE,
            "trusted_probe_historical_status",
        )

        dirty = clone("dirty")
        (dirty / "dirty").write_text("dirty\n")
        rejected(dirty, "dirty_worktree", "dirty")

        omitted = clone("omitted")
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "main",
                TRUSTED_PROBE_OMITTED_FIXTURE_FOLLOWUP,
            ],
            cwd=omitted,
        )
        commit_public_contract_followup(omitted)
        rejected(
            omitted,
            "trusted_probe_pair_commit_count",
            "omitted",
        )

        reordered = clone("reordered")
        synthetic_pair(reordered, reverse=True)
        rejected(
            reordered,
            "trusted_probe_public_contract_followup_scope",
            "reordered",
        )

        misparented = clone("misparented")
        synthetic_pair(misparented, intervening=True)
        rejected(
            misparented,
            "trusted_probe_public_contract_followup_scope",
            "misparented",
        )

        missing_implementation = clone("missing-implementation")
        synthetic_missing_implementation(missing_implementation)
        rejected(
            missing_implementation,
            "trusted_probe_implementation_identity",
            "missing-implementation",
        )

        missing_correction = clone("missing-first-validator-correction")
        synthetic_missing_first_correction(missing_correction)
        rejected(
            missing_correction,
            "trusted_probe_validator_correction_identity",
            "missing-first-validator-correction",
        )

        missing_followup = clone("missing-omitted-fixture-followup")
        synthetic_missing_omitted_followup(missing_followup)
        rejected(
            missing_followup,
            "trusted_probe_validator_followup_identity",
            "missing-omitted-fixture-followup",
        )

        multifile = clone("multifile-public-contract-followup")
        synthetic_pair(multifile, public_extra=True)
        rejected(
            multifile,
            "trusted_probe_public_contract_followup_scope",
            "multifile-public-contract-followup",
        )

        wrong_metadata = clone("wrong-public-contract-followup-metadata")
        synthetic_pair(
            wrong_metadata,
            public_identity=COORDINATOR_METADATA,
        )
        rejected(
            wrong_metadata,
            "trusted_probe_public_contract_followup_metadata",
            "wrong-public-contract-followup-metadata",
        )

        evidence_extra = clone("multifile-evidence")
        synthetic_pair(evidence_extra, evidence_extra=True)
        rejected(
            evidence_extra,
            "trusted_probe_evidence_scope",
            "multifile-evidence",
        )

        evidence_metadata = clone("wrong-evidence-metadata")
        synthetic_pair(
            evidence_metadata,
            evidence_identity=COORDINATOR_METADATA,
        )
        rejected(
            evidence_metadata,
            "trusted_probe_evidence_metadata",
            "wrong-evidence-metadata",
        )

        malformed = clone("malformed-evidence")
        synthetic_pair(malformed, evidence_raw='{"schema":\n')
        rejected(
            malformed,
            "trusted_probe_evidence_json",
            "malformed-evidence",
        )

        wrong_record = clone("wrong-evidence")
        wrong = strict_json(ROOT / TRUSTED_PROBE_EVIDENCE)
        wrong["gate"]["phase5PassClaimed"] = True
        synthetic_pair(
            wrong_record,
            evidence_raw=canonical_json(wrong) + "\n",
        )
        rejected(
            wrong_record,
            "trusted_probe_evidence",
            "wrong-evidence",
        )

        merged = clone("merge")
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=merged)
        checked([*GIT, "checkout", "-q", "-b", "side"], cwd=merged)
        (merged / "side-note").write_text("side\n")
        checked([*GIT, "add", "--", "side-note"], cwd=merged)
        synthetic_commit(merged, "Side note", EXECUTOR_METADATA)
        checked([*GIT, "checkout", "-q", "main"], cwd=merged)
        (merged / "main-note").write_text("main\n")
        checked([*GIT, "add", "--", "main-note"], cwd=merged)
        synthetic_commit(merged, "Main note", EXECUTOR_METADATA)
        environment = {
            "GIT_AUTHOR_EMAIL": EXECUTOR_METADATA[1],
            "GIT_AUTHOR_NAME": EXECUTOR_METADATA[0],
            "GIT_COMMITTER_EMAIL": EXECUTOR_METADATA[3],
            "GIT_COMMITTER_NAME": EXECUTOR_METADATA[2],
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "HOME": str(merged),
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin",
        }
        checked(
            [*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"],
            cwd=merged,
            environment=environment,
        )
        rejected(
            merged,
            "trusted_probe_extension_merge",
            "merge",
        )

        for name, relative in (
            ("runner-drift", TRUSTED_PROBE_RUNNER),
            ("manifest-drift", TRUSTED_PROBE_MANIFEST),
            ("validator-drift", VALIDATOR),
            ("doctor-drift", "bin/phase4-final-doctor"),
            ("apply-runner-drift", RUNNER),
            ("prior-evidence-drift", TOPOLOGY_CORRECTION_EVIDENCE),
            ("new-evidence-drift", TRUSTED_PROBE_EVIDENCE),
            ("contract-drift", "docs/phase-5-apply-bundle.md"),
        ):
            directory = clone(name)
            checked([*GIT, "checkout", "-q", "-B", "main"], cwd=directory)
            path = directory / relative
            path.write_text(path.read_text() + "\n# protected drift\n")
            checked([*GIT, "add", "--", relative], cwd=directory)
            synthetic_commit(
                directory,
                "Protected trusted-probe drift",
                EXECUTOR_METADATA,
            )
            rejected(
                directory,
                "protected_descendant_drift:" + relative,
                name,
            )

        nonancestor = clone("nonancestor")
        checked(
            [*GIT, "checkout", "-q", "--orphan", "main"],
            cwd=nonancestor,
        )
        checked([*GIT, "rm", "-q", "-rf", "."], cwd=nonancestor)
        (nonancestor / "orphan").write_text("orphan\n")
        checked([*GIT, "add", "--", "orphan"], cwd=nonancestor)
        synthetic_commit(nonancestor, "Orphan", EXECUTOR_METADATA)
        checkout_current(nonancestor, {VALIDATOR})
        checked([*GIT, "add", "--", VALIDATOR], cwd=nonancestor)
        synthetic_commit(
            nonancestor,
            "Validator on orphan",
            EXECUTOR_METADATA,
        )
        rejected(
            nonancestor,
            "accepted_base_not_ancestor",
            "nonancestor",
        )

        return {
            "historicalStatus": True,
            "integratedAndDescendants": 3,
            "negativeCases": negatives,
            "review": True,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def private_runtime_repository_baseline(review_state):
    """Exercise the accepted private-runtime pair without any live state."""
    workspace = Path(tempfile.mkdtemp(prefix="phase5-private-runtime-base-"))
    try:
        clone = workspace / "control"
        checked(
            [
                *GIT,
                "clone",
                "--no-local",
                "--quiet",
                "--branch",
                PRIVATE_RUNTIME_BRANCH,
                ROOT,
                clone,
            ]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=clone)
        apply_one = checked([clone / VALIDATOR, "--git-only", "--json"], cwd=clone)
        apply_two = checked([clone / VALIDATOR, "--git-only", "--json"], cwd=clone)
        prep_one = checked([clone / "bin/check-phase5-prep", "--git-only", "--json"], cwd=clone)
        prep_two = checked([clone / "bin/check-phase5-prep", "--git-only", "--json"], cwd=clone)
        apply_value = strict_json_text(apply_one)
        prep_value = strict_json_text(prep_one)
        require(
            git_at(clone, "remote") == ""
            and git_at(clone, "rev-parse", "HEAD") == review_state["evidenceCommit"]
            and apply_one == apply_two
            and prep_one == prep_two
            and apply_value["repositoryState"] == "private_runtime_review"
            and apply_value["verdict"] == PRIVATE_RUNTIME_VERDICT
            and prep_value["repositoryState"] == "private_runtime_review"
            and prep_value["verdict"] == PRIVATE_RUNTIME_VERDICT,
            "private_runtime_accepted_baseline",
        )
        return {
            "applySHA256": hashlib.sha256(apply_one.encode()).hexdigest(),
            "noOrigin": True,
            "phase5PrepSHA256": hashlib.sha256(prep_one.encode()).hexdigest(),
            "repositoryOnly": True,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def private_runtime_topology_matrix(review_state):
    """Fail-closed Git-only review matrix for the private-runtime pair."""
    workspace = Path(tempfile.mkdtemp(prefix="phase5-private-runtime-topology-"))
    current = git("rev-parse", "HEAD")
    negatives = 0

    def clone(name):
        directory = workspace / name
        checked(
            [
                *GIT,
                "clone",
                "--no-local",
                "--quiet",
                "--branch",
                PRIVATE_RUNTIME_BRANCH,
                ROOT,
                directory,
            ]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=directory)
        require(
            git_at(directory, "remote") == ""
            and git_at(directory, "rev-parse", "HEAD") == current,
            "private_runtime_topology_clone",
        )
        return directory

    def validator(directory):
        return run([directory / VALIDATOR, "--git-only", "--json"], cwd=directory)

    def rejected(directory, reason, name):
        nonlocal negatives
        result = validator(directory)
        require(
            result.returncode != 0
            and strict_json_text(result.stdout)
            == {
                "error": reason,
                "mode": "git-only",
                "schema": 1,
                "verdict": "FAIL",
            },
            "private_runtime_unstable_reason_" + name,
        )
        negatives += 1

    def write_evidence(directory, kind, identity=PRIVATE_RUNTIME_EXECUTOR_METADATA):
        """Rewrite only the evidence child in a disposable clone."""
        checked([*GIT, "reset", "--soft", "HEAD^"], cwd=directory)
        path = directory / PRIVATE_RUNTIME_EVIDENCE
        if kind == "malformed":
            raw = '{"schema":\n'
        else:
            value = strict_json(ROOT / PRIVATE_RUNTIME_EVIDENCE)
            if kind == "raw-binding":
                value["bindings"]["implementationRawCommitSHA256"] = "0" * 64
            elif kind == "blob-binding":
                value["bindings"]["implementationBlobsSHA256"]["AGENTS.md"] = "0" * 64
            raw = canonical_json(value) + "\n"
        path.write_text(raw)
        paths = [PRIVATE_RUNTIME_EVIDENCE]
        if kind == "multifile":
            extra = directory / "evidence-extra"
            extra.write_text("extra\n")
            paths.append("evidence-extra")
        checked([*GIT, "add", "--", *paths], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic private-runtime evidence",
            identity,
        )

    def descendant(directory, path, text):
        target = directory / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        checked([*GIT, "add", "--", path], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic private-runtime descendant",
            PRIVATE_RUNTIME_EXECUTOR_METADATA,
        )

    try:
        positive = clone("positive-no-origin")
        value = strict_json_text(validator(positive).stdout)
        require(
            value["repositoryState"] == "private_runtime_review"
            and value["protectedBaselineCommit"] == review_state["evidenceCommit"]
            and value["verdict"] == PRIVATE_RUNTIME_VERDICT,
            "private_runtime_topology_positive",
        )

        missing = clone("evidence-missing")
        checked(
            [*GIT, "checkout", "-q", "-B", PRIVATE_RUNTIME_BRANCH, "HEAD^"],
            cwd=missing,
        )
        rejected(missing, "private_runtime_evidence_missing", "missing")

        for kind, reason in (
            ("malformed", "private_runtime_evidence_json"),
            ("multifile", "private_runtime_evidence_scope"),
            ("raw-binding", "private_runtime_evidence_raw_bindings"),
            ("blob-binding", "private_runtime_evidence_raw_bindings"),
        ):
            directory = clone("evidence-" + kind)
            write_evidence(directory, kind)
            rejected(directory, reason, kind)

        wrong_metadata = clone("wrong-evidence-metadata")
        write_evidence(wrong_metadata, "valid", COORDINATOR_METADATA)
        rejected(wrong_metadata, "private_runtime_evidence_metadata", "wrong-metadata")

        dirty_untracked = clone("dirty-untracked")
        (dirty_untracked / "untracked").write_text("fixture\n")
        rejected(dirty_untracked, "private_runtime_dirty", "dirty-untracked")

        dirty_tracked = clone("dirty-tracked")
        (dirty_tracked / "README.md").write_text("dirty\n")
        rejected(dirty_tracked, "private_runtime_dirty", "dirty-tracked")

        detached = clone("detached")
        checked([*GIT, "checkout", "-q", "--detach"], cwd=detached)
        rejected(detached, "unexpected_branch", "detached")

        wrong_branch = clone("wrong-branch")
        checked([*GIT, "checkout", "-q", "-B", "fixture-branch"], cwd=wrong_branch)
        rejected(wrong_branch, "unexpected_branch", "wrong-branch")

        origin = clone("origin")
        checked([*GIT, "remote", "add", "origin", "https://example.invalid/control"], cwd=origin)
        rejected(origin, "private_runtime_origin", "origin")

        substitute_base = clone("substitute-base")
        checked(
            [*GIT, "checkout", "-q", "-B", PRIVATE_RUNTIME_BRANCH, PRIVATE_RUNTIME_BASE + "^"],
            cwd=substitute_base,
        )
        checked([*GIT, "checkout", current, "--", VALIDATOR], cwd=substitute_base)
        checked([*GIT, "add", "--", VALIDATOR], cwd=substitute_base)
        synthetic_commit(
            substitute_base,
            "Synthetic private-runtime validator route",
            PRIVATE_RUNTIME_EXECUTOR_METADATA,
        )
        rejected(substitute_base, "command_failed_git:", "substitute-base")

        safe_descendant = clone("safe-descendant")
        descendant(safe_descendant, "notes/private-runtime-descendant", "fixture\n")
        rejected(safe_descendant, "private_runtime_history", "safe-descendant")

        protected_drift = clone("protected-drift")
        descendant(protected_drift, "AGENTS.md", "protected drift\n")
        rejected(protected_drift, "private_runtime_history", "protected-drift")

        merged = clone("merge")
        checked([*GIT, "checkout", "-q", "-b", "fixture-side"], cwd=merged)
        descendant(merged, "notes/private-runtime-side", "fixture\n")
        checked([*GIT, "checkout", "-q", PRIVATE_RUNTIME_BRANCH], cwd=merged)
        checked(
            [
                *GIT,
                "-c",
                "user.name=Phase 5 Executor",
                "-c",
                "user.email=phase5-executor@agent-first-mac.invalid",
                "merge",
                "--no-ff",
                "--no-gpg-sign",
                "fixture-side",
                "-m",
                "Synthetic private-runtime merge",
            ],
            cwd=merged,
        )
        rejected(merged, "private_runtime_merge", "merge")

        return {
            "negativeCases": negatives,
            "noOriginPositive": True,
            "safeDescendantsRejected": True,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def repository_only_baseline():
    workspace = Path(
        tempfile.mkdtemp(prefix="phase5-trusted-probe-baseline-")
    )
    try:
        clone = workspace / "control"
        checked(
            [*GIT, "clone", "--no-local", "--quiet", ROOT, clone]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=clone)
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=clone)
        require(git_at(clone, "remote") == "", "baseline_remote")

        phase4_one = checked(
            [clone / "bin/check-phase4-final-probes", "--git-only"],
            cwd=clone,
        )
        phase4_two = checked(
            [clone / "bin/check-phase4-final-probes", "--git-only"],
            cwd=clone,
        )
        phase4_unsupported = run(
            [
                clone / "bin/check-phase4-final-probes",
                "--git-only",
                "--json",
            ],
            cwd=clone,
        )
        phase5_one = checked(
            [clone / "bin/check-phase5-prep", "--git-only", "--json"],
            cwd=clone,
        )
        phase5_two = checked(
            [clone / "bin/check-phase5-prep", "--git-only", "--json"],
            cwd=clone,
        )
        require(
            phase4_one == phase4_two
            and strict_json_text(phase4_one)["verdict"] == "PASS"
            and phase4_unsupported.returncode != 0
            and strict_json_text(phase4_unsupported.stdout)
            == {"reason": "usage", "result": "fail"}
            and phase5_one == phase5_two
            and strict_json_text(phase5_one)["verdict"]
            == "ACCEPTED_PREPARATION",
            "repository_only_validators",
        )

        phase5_prep_contract = load_module(
            "phase5_prep_public_contract_fixture",
            clone / "bin/check-phase5-prep",
        )
        former_public_shape = {
            "acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE,
            "evidenceCommit": git_at(clone, "rev-parse", "HEAD"),
            "implementationCommit": TRUSTED_PROBE_IMPLEMENTATION,
            "liveApplyAuthorized": False,
            "marker": MARKER,
            "mode": "git-only",
            "phase5PassClaimed": False,
            "phase6Authorized": False,
            "protectedBaselineCommit":
                git_at(clone, "rev-parse", "HEAD"),
            "repositoryState": "trusted_probe_review",
            "schema": 1,
            "sourceCommit": git_at(clone, "rev-parse", "HEAD"),
            "stageBContinuationRequired": True,
            "trustedProbeRetryAuthorized": False,
            "verdict": REVIEW_VERDICT,
        }
        original_phase5_prep_run = phase5_prep_contract.run

        def former_public_shape_run(
            arguments,
            cwd=clone,
            environment=None,
            stdin=None,
        ):
            if (
                Path(str(arguments[0]))
                == phase5_prep_contract.APPLY_BUNDLE_VALIDATOR
            ):
                return subprocess.CompletedProcess(
                    arguments,
                    0,
                    canonical_json(former_public_shape) + "\n",
                )
            return original_phase5_prep_run(
                arguments,
                cwd=cwd,
                environment=environment,
                stdin=stdin,
            )

        phase5_prep_contract.run = former_public_shape_run
        former_public_failure = None
        try:
            phase5_prep_contract.validate_apply_bundle_state("review")
        except RuntimeError as error:
            former_public_failure = str(error)
        finally:
            phase5_prep_contract.run = original_phase5_prep_run
        require(
            former_public_failure == "apply_bundle_validator_contract",
            "former_public_review_contract_reason",
        )

        fixture = workspace / "phase4-doctor.json"
        fixture.write_text(
            json.dumps(
                {
                    "checks": {
                        "artifactBindings": True,
                        "auditAndStagingBounded": True,
                        "emergencyEnabledState": True,
                        "generation3Current": True,
                        "genericSudoDenied": True,
                        "noRelevantProcess": True,
                        "phase2AcceptedLiveDoctor": True,
                        "phase3AcceptedEvidence": True,
                        "previousGenerationAvailable": True,
                        "rootContractReady": True,
                        "unknownCommandDenied": True,
                    },
                    "schema": 1,
                },
                sort_keys=True,
                separators=(",", ":"),
            )
            + "\n"
        )
        doctor_one = checked(
            [clone / "bin/phase4-final-doctor", "--fixture", fixture, "--json"],
            cwd=clone,
        )
        doctor_two = checked(
            [clone / "bin/phase4-final-doctor", "--fixture", fixture, "--json"],
            cwd=clone,
        )
        require(
            doctor_one == doctor_two
            and strict_json_text(doctor_one)["verdict"] == "PASS",
            "phase4_doctor_fixture_identity",
        )

        preflight = load_module(
            "phase5_preflight_repository_fixture",
            clone / "bin/phase5-preflight",
        )

        def preflight_fixture():
            config = (
                'approval_policy = "never"\n'
                'sandbox_mode = "danger-full-access"\n'
                '[desktop]\nnotifications = true\n'
            )
            return canonical_json(
                {
                    "config":
                        preflight.top_level_managed_facts(
                            config,
                            config_load_ok=True,
                        ),
                    "doctor": preflight.doctor_contract(
                        {
                            "checks": {
                                "config.load": {"status": "ok"}
                            },
                            "overallStatus": "warning",
                        }
                    ),
                    "liveProfileRead": False,
                    "schema": 1,
                }
            )

        preflight_one = preflight_fixture()
        preflight_two = preflight_fixture()
        require(
            preflight_one == preflight_two
            and strict_json_text(preflight_one)["config"][
                "trustedBaseline"
            ]
            is True,
            "phase5_preflight_fixture_identity",
        )
        return {
            "liveProfileRead": False,
            "phase4SupportedArgv": ["--git-only"],
            "phase4DoctorFixtureSHA256":
                hashlib.sha256(doctor_one.encode()).hexdigest(),
            "phase4ValidatorSHA256":
                hashlib.sha256(phase4_one.encode()).hexdigest(),
            "phase4UnsupportedArgv": ["--git-only", "--json"],
            "phase4UnsupportedReason": "usage",
            "formerPublicReviewFailure":
                "apply_bundle_validator_contract",
            "phase5PreflightFixtureSHA256":
                hashlib.sha256(preflight_one.encode()).hexdigest(),
            "phase5ValidatorSHA256":
                hashlib.sha256(phase5_one.encode()).hexdigest(),
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def inherited_baseline():
    workspace = Path(tempfile.mkdtemp(prefix="phase5-apply-base-"))
    try:
        clone = workspace / "control"
        checked(
            [*GIT, "clone", "--no-local", "--quiet", ROOT, clone]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=clone)
        checked([*GIT, "checkout", "-q", "-B", "main", BASE], cwd=clone)
        require(git_at(clone, "remote") == "", "base_clone_remote")
        phase4 = checked([clone / "bin/check-phase4-final-probes"], cwd=clone)
        historical_phase5 = run(
            [clone / "bin/check-phase5-prep", "--json"],
            cwd=clone,
        )
        historical_phase5_value = strict_json_text(
            historical_phase5.stdout,
            "historical_phase5_validator",
        )
        require(
            (
                historical_phase5.returncode == 0
                and historical_phase5_value["verdict"]
                == "ACCEPTED_PREPARATION"
            )
            or (
                historical_phase5.returncode != 0
                and historical_phase5_value
                == {
                    "error": "preflight_byte_identity",
                    "mode": "final",
                    "schema": 1,
                    "verdict": "FAIL",
                }
            ),
            "historical_phase5_validator_boundary",
        )
        doctor_human = checked(
            [clone / "bin/phase4-final-doctor"], cwd=clone
        )
        doctor_one = checked(
            [clone / "bin/phase4-final-doctor", "--json"], cwd=clone
        )
        doctor_two = checked(
            [clone / "bin/phase4-final-doctor", "--json"], cwd=clone
        )
        preflight_one = checked(
            [clone / "bin/phase5-preflight", "--json"], cwd=clone
        )
        preflight_two = checked(
            [clone / "bin/phase5-preflight", "--json"], cwd=clone
        )

        def normalized_historical_preflight(text):
            value = strict_json_text(
                text,
                "historical_phase5_preflight",
            )
            cli = value.get("cli")
            require(
                isinstance(cli, dict)
                and cli.get("doctorOverallObserved")
                in {"ok", "warning", "fail"}
                and value.get("overall")
                == "PHASE5_PREPARATION_PREFLIGHT_PASS"
                and value.get("checks", {}).get("activeConfigLoads")
                is True,
                "historical_phase5_preflight_contract",
            )
            del cli["doctorOverallObserved"]
            return json.dumps(
                value,
                sort_keys=True,
                separators=(",", ":"),
            )

        normalized_one = normalized_historical_preflight(preflight_one)
        normalized_two = normalized_historical_preflight(preflight_two)
        corrected_phase5 = checked(
            [ROOT / "bin/check-phase5-prep", "--json"],
            cwd=ROOT,
        )
        corrected_preflight_one = checked(
            [ROOT / "bin/phase5-preflight", "--json"],
            cwd=ROOT,
        )
        corrected_preflight_two = checked(
            [ROOT / "bin/phase5-preflight", "--json"],
            cwd=ROOT,
        )
        corrected_preflight = strict_json_text(
            corrected_preflight_one,
            "corrected_phase5_preflight",
        )
        require(
            strict_json_text(phase4)["verdict"] == "PASS"
            and strict_json_text(corrected_phase5)["verdict"]
            == "ACCEPTED_PREPARATION"
            and "PASS" in doctor_human
            and doctor_one == doctor_two
            and strict_json_text(doctor_one)["verdict"] == "PASS"
            and normalized_one == normalized_two
            and corrected_preflight_one == corrected_preflight_two
            and corrected_preflight["overall"]
            == "PHASE5_PREPARATION_PREFLIGHT_PASS",
            "accepted_base_validators",
        )
        return {
            "phase4DoctorSHA256":
                hashlib.sha256(doctor_one.encode()).hexdigest(),
            "phase4Validator": True,
            "phase5AcceptedBasePreflightContractSHA256":
                hashlib.sha256(normalized_one.encode()).hexdigest(),
            "phase5CorrectedPreflightSHA256":
                hashlib.sha256(
                    corrected_preflight_one.encode()
                ).hexdigest(),
            "phase5CorrectedValidator": True,
            "phase5HistoricalValidatorBounded": True,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def malicious_git_probe(branch=BRANCH):
    with tempfile.TemporaryDirectory(
        prefix="phase5-apply-malicious-git-"
    ) as directory:
        clone = Path(directory) / "control"
        checked(
            [
                *GIT,
                "clone",
                "--no-local",
                "--quiet",
                "--branch",
                branch,
                ROOT,
                clone,
            ]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=clone)
        marker = Path(directory) / "executed"
        monitor = clone / ".git/fsmonitor"
        monitor.write_text(
            "#!/bin/sh\n/usr/bin/touch " + str(marker) + "\n"
        )
        monitor.chmod(0o755)
        hook = clone / ".git/hooks/post-checkout"
        hook.write_text(
            "#!/bin/sh\n/usr/bin/touch " + str(marker) + "\n"
        )
        hook.chmod(0o755)
        checked([*GIT, "config", "core.fsmonitor", str(monitor)], cwd=clone)
        checked(
            [*GIT, "config", "core.hooksPath", str(clone / ".git/hooks")],
            cwd=clone,
        )
        result = run(
            [clone / VALIDATOR, "--git-only", "--json"], cwd=clone
        )
        require(
            result.returncode == 0 and not marker.exists(),
            "malicious_git_executed",
        )
    return True


def final_report(state, mode, checks=None):
    private_runtime = state["repositoryState"] in {
        "private_runtime_implementation",
        "private_runtime_review",
    }
    review = state["repositoryState"] in {
        "review",
        "trusted_probe_review",
        "private_runtime_review",
    }
    integrated = state["repositoryState"] == "integrated_main"
    public_repository_state = (
        "review"
        if state["repositoryState"] == "trusted_probe_review"
        else state["repositoryState"]
    )
    verdict = (
        PRIVATE_RUNTIME_VERDICT if state["repositoryState"] == "private_runtime_review"
        else REVIEW_VERDICT
        if review
        else ACCEPTED_VERDICT
        if integrated
        else mode.upper().replace("-", "_") + "_VALID"
    )
    value = {
        "acceptedControlCommit": state["acceptedControlCommit"],
        "checks": checks,
        "evidenceCommit": state["evidenceCommit"],
        "implementationCommit": state["implementationCommit"],
        "liveApplyAuthorized": False,
        "marker": (PRIVATE_RUNTIME_MARKER if private_runtime else MARKER),
        "mode": mode,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "protectedBaselineCommit": state["protectedBaselineCommit"],
        "repositoryState": public_repository_state,
        "schema": 1,
        "sourceCommit": state["sourceCommit"],
        "stageBContinuationRequired": True,
        "verdict": verdict,
    }
    if checks is None:
        value.pop("checks")
    return value


CURRENT_MAIN_MARKER = "CHECKPOINT_PHASE5_CURRENT_MAIN_RUNTIME_PHASE4_DOCTOR_COMPATIBILITY_REVIEW"
CURRENT_MAIN_VERDICT = "PHASE5_CURRENT_MAIN_RUNTIME_PHASE4_DOCTOR_COMPATIBILITY_PREPARED_FOR_INDEPENDENT_REVIEW"
POST_INTEGRATION_MARKER = "CHECKPOINT_PHASE5_POST_INTEGRATION_PHASE2_DOCTOR_COMPATIBILITY_CORRECTION_REVIEW"
POST_INTEGRATION_VERDICT = "PHASE5_POST_INTEGRATION_PHASE2_DOCTOR_COMPATIBILITY_CORRECTION_PREPARED_FOR_INDEPENDENT_REVIEW"
POST_PRIVATE_ROUTING_MARKER = "CHECKPOINT_PHASE5_PRIVATE_CURRENT_RUNTIME_POST_INTEGRATION_ROUTING_CORRECTION_REVIEW"
POST_PRIVATE_ROUTING_VERDICT = "PHASE5_PRIVATE_CURRENT_RUNTIME_POST_INTEGRATION_ROUTING_CORRECTION_PREPARED_FOR_INDEPENDENT_REVIEW"
RUNNER_GATE_MARKER = "CHECKPOINT_PHASE5_CURRENT_MAIN_RUNNER_GATE_REBASE_REVIEW"
RUNNER_GATE_VERDICT = "PHASE5_CURRENT_MAIN_RUNNER_GATE_REBASE_PREPARED_FOR_INDEPENDENT_REVIEW"
CURRENT_SHAPE_MARKER = "CHECKPOINT_PHASE5_CURRENT_PRIVATE_RUNTIME_SHAPE_CORRECTION_REVIEW"
CURRENT_SHAPE_VERDICT = "PHASE5_CURRENT_PRIVATE_RUNTIME_SHAPE_CORRECTION_PREPARED_FOR_INDEPENDENT_REVIEW"


def current_main_compatibility(*, repository_only=False, mode="git-only"):
    if git("branch", "--show-current") == PRIVATE_RUNTIME_BRANCH:
        return None
    prep_mode = "--implementation" if mode == "implementation" else "--git-only"
    result = run([ROOT / "bin/check-phase5-prep", prep_mode, "--json"])
    if result.returncode != 0:
        try:
            failure = strict_json_text(result.stdout).get("error")
        except Exception:
            failure = None
        if failure == "post_integration_implementation_commit_identity":
            raise RuntimeError(failure)
        return None
    value = strict_json_text(result.stdout)
    if value.get("marker") not in {CURRENT_MAIN_MARKER, POST_INTEGRATION_MARKER, POST_PRIVATE_ROUTING_MARKER, RUNNER_GATE_MARKER, CURRENT_SHAPE_MARKER}:
        return None
    if not repository_only:
        preflight = run([ROOT / "bin/phase5-preflight", "--json"])
        require(preflight.returncode == 0 and strict_json_text(preflight.stdout)["overall"] == "PHASE5_PREPARATION_PREFLIGHT_PASS",
                "current_main_preflight")
    return {"implementation": value["reviewedTaskHead"],
            "baseline": value["protectedBaselineCommit"], "state": value["repositoryState"]}


def current_private_runtime_shape_fixtures(transaction):
    """Exercise the production closed comparator with synthetic bytes only."""
    with tempfile.TemporaryDirectory(prefix="phase5-current-shape-") as directory:
        root = Path(directory).resolve()
        layout = make_layout(transaction, root)
        manifest = transaction.load_manifest()
        grammar = manifest["privateCurrentRuntimeReconciliation"]["publicGrammar"]
        accepted = manifest["_acceptedRuntimeContract"]
        node = accepted["mcp"]["node_repl"]
        computer = accepted["mcp"]["computer-use"]
        resource = transaction.CODEX.parent
        lines = [
            'model = "fixture"', 'model_reasoning_effort = "max"',
            'sandbox_mode = "danger-full-access"', 'approval_policy = "never"',
            'service_tier = "fixture"', 'notify = false',
        ]
        for table in grammar["tables"]:
            if table["header"] == "hook-leaf":
                index = sum(1 for line in lines if line.startswith("[hooks.state.\""))
                source = str(layout.codex_home / "hooks.json") + ":" + transaction.HOOK_TRUST_RECORDS[index][1]
                lines.append("[hooks.state." + json.dumps(source) + "]")
            elif table["header"] == "plugins":
                index = sum(1 for line in lines if line.startswith('[plugins."'))
                lines.append('[plugins."' + grammar["pluginTableOrder"][index] + '"]')
            else:
                lines.append("[" + table["header"] + "]")
            for key in table["keys"]:
                if key == "trusted_hash":
                    index = sum(1 for line in lines if line.startswith("trusted_hash = "))
                    value = json.dumps(transaction.HOOK_TRUST_RECORDS[index][2])
                elif key == "enabled":
                    if table["header"] == "plugins":
                        plugin = grammar["pluginTableOrder"][sum(
                            1 for line in lines if line.startswith('[plugins."')) - 1]
                        value = json.dumps(accepted["plugins"][plugin])
                    else:
                        value = json.dumps(computer["enabled"])
                elif key == "args":
                    value = json.dumps((computer if table["header"] == "mcp_servers.computer-use" else node)["transport"]["args"], separators=(",", ":"))
                elif key == "startup_timeout_sec":
                    value = str(node["startupTimeout"])
                elif key == "cwd":
                    value = '"."'
                elif key == "url":
                    value = json.dumps(accepted["mcp"]["openaiDeveloperDocs"]["transport"]["url"])
                elif key == "NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S":
                    value = '"' + "a" * 64 + '"'
                elif key == "BROWSER_USE_CODEX_APP_VERSION":
                    value = json.dumps(accepted["appVersion"])
