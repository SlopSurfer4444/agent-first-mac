def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def signed_vendor_floor(observed, floor="codex-cli 0.145.0-alpha.18"):
    """Numeric vendor floor; an unchanged signed identity may update in place."""
    match = re.fullmatch(r"codex-cli (\d+)\.(\d+)\.(\d+)(?:-alpha\.(\d+)(?:\.(\d+))?)?", observed)
    minimum = re.fullmatch(r"codex-cli (\d+)\.(\d+)\.(\d+)(?:-alpha\.(\d+)(?:\.(\d+))?)?", floor)
    if match is None or minimum is None:
        return False
    def parts(value):
        stable = tuple(int(value.group(index)) for index in (1, 2, 3))
        # Stable releases are above matching alpha releases; later alpha
        # components compare numerically rather than lexicographically.
        prerelease = value.group(4)
        return stable, (1, 0, 0) if prerelease is None else (0, int(prerelease), int(value.group(5) or 0))
    return parts(match) >= parts(minimum)


def run(arguments, cwd=ROOT, environment=None, stdin=None):
    return subprocess.run(
        [str(item) for item in arguments],
        cwd=cwd,
        env=environment,
        input=stdin,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def checked(arguments, cwd=ROOT, environment=None, stdin=None):
    result = run(arguments, cwd=cwd, environment=environment, stdin=stdin)
    require(
        result.returncode == 0,
        "command_failed_"
        + Path(str(arguments[0])).name
        + ":"
        + result.stdout[-1000:],
    )
    return result.stdout


def git_at(directory, *arguments):
    return checked([*GIT, *arguments], cwd=directory).strip()


def git(*arguments):
    return git_at(ROOT, *arguments)


def strict_json_text(text, reason="json"):
    def unique(pairs):
        value = {}
        for key, item in pairs:
            require(key not in value, reason + "_duplicate")
            value[key] = item
        return value

    return json.loads(text, object_pairs_hook=unique)


def strict_json(path):
    return strict_json_text(Path(path).read_text(), str(path))


def canonical_json(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def commit_scope(directory, commit):
    output = git_at(
        directory,
        "diff-tree",
        "--no-commit-id",
        "--name-only",
        "-r",
        commit,
    )
    return set(filter(None, output.splitlines()))


def metadata(directory, commit):
    return git_at(
        directory,
        "show",
        "-s",
        "--format=%an%n%ae%n%cn%n%ce",
        commit,
    ).splitlines()


def git_blob(directory, commit, path):
    result = subprocess.run(
        [*GIT, "show", commit + ":" + path],
        cwd=directory,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    require(result.returncode == 0, "missing_commit_blob_" + path)
    return result.stdout


def strict_git_json(directory, commit, path, reason):
    try:
        return strict_json_text(
            git_blob(directory, commit, path).decode(),
            reason,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError):
        raise RuntimeError(reason)


def implementation_hashes(directory, implementation, scope):
    return {
        path: hashlib.sha256(
            git_blob(directory, implementation, path)
        ).hexdigest()
        for path in sorted(scope)
    }


def worktree_scope(directory=ROOT):
    output = checked(
        [*GIT, "status", "--porcelain=v1", "--untracked-files=all"],
        cwd=directory,
    )
    return {
        line[3:]
        for line in output.splitlines()
        if len(line) > 3
    }


def validate_historical_base(directory, head="HEAD"):
    require(
        run(
            [*GIT, "merge-base", "--is-ancestor", BASE, head],
            cwd=directory,
        ).returncode
        == 0,
        "accepted_base_not_ancestor",
    )
    require(
        git_at(directory, "rev-parse", BASE + "^") == BASE_PARENT,
        "accepted_base_parent",
    )
    require(
        commit_scope(directory, BASE) == set(),
        "accepted_base_scope",
    )
    require(
        metadata(directory, BASE) == COORDINATOR_METADATA,
        "accepted_base_metadata",
    )
    require(
        git_at(directory, "rev-parse", BASE_PARENT + "^")
        == PROTECTED_IMPLEMENTATION,
        "protected_evidence_parent",
    )
    require(
        commit_scope(directory, BASE_PARENT)
        == {"evidence/phase-5/descendant-protected-baseline-correction.json"},
        "protected_evidence_scope",
    )
    require(
        metadata(directory, BASE_PARENT) == EXECUTOR_METADATA,
        "protected_evidence_metadata",
    )
    require(
        git_at(directory, "rev-parse", PROTECTED_IMPLEMENTATION + "^")
        == "e0f3a339cd39642bc4e631957f562bd4c981466c",
        "protected_implementation_parent",
    )
    require(
        metadata(directory, PROTECTED_IMPLEMENTATION)
        == EXECUTOR_METADATA,
        "protected_implementation_metadata",
    )
    require(
        run(
            [*GIT, "merge-base", "--is-ancestor", PHASE4_ACCEPTANCE, BASE],
            cwd=directory,
        ).returncode
        == 0
        and run(
            [*GIT, "merge-base", "--is-ancestor", PHASE5_ACCEPTANCE, BASE],
            cwd=directory,
        ).returncode
        == 0,
        "historical_acceptance_not_ancestor",
    )


def acceptance_value(implementation, evidence):
    return {
        "implementationCommit": implementation,
        "liveApplyAuthorized": False,
        "ownerAuthorizationCommit": OWNER_AUTHORIZATION,
        "phase": "phase5_codex_contract_apply_bundle",
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "reviewMarker": DIRECTORY_CHAIN_MARKER,
        "reviewedTaskHead": evidence,
        "schema": 1,
        "stageBContinuationRequired": True,
        "systemMutationDuringAcceptance": False,
        "verdict": ACCEPTED_VERDICT,
    }


def validate_acceptance_value(value, implementation, evidence):
    require(value == acceptance_value(implementation, evidence), "acceptance_record")


def evidence_value_contract(
    value,
    directory,
    implementation,
    review_rollback,
):
    require(
        set(value)
        == {
            "authority",
            "base",
            "branch",
            "gate",
            "implementation",
            "phase",
            "protectedState",
            "rollback",
            "schema",
            "systemMutations",
            "tests",
            "transaction",
        },
        "evidence_keys",
    )
    require(
        value["schema"] == 1
        and value["phase"] == "phase5_codex_contract_apply_bundle_preparation"
        and value["base"] == BASE
        and value["branch"] == BRANCH,
        "evidence_header",
    )
    require(
        value["authority"]
        == {
