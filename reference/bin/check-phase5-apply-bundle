def config_overlay_cleanup_fixtures(transaction):
    """Drive real overlay cleanup for every parser-failure partition.

    Popen and RPC are replaced only to make the parser outcome deterministic.
    ``config_snapshot_in_run`` itself owns the descriptor-rooted write, unlink,
    retained-fd nlink check, directory removal, and close sequence exercised
    below.  No private fixture byte or temporary path is emitted.
    """
    cases = 0
    for name, returncode, stderr, rpc_failure in (
        ("nonzero", 9, "", False),
        ("stderr", 0, "parser diagnostic", False),
        ("rpc", 0, "", True),
    ):
        with tempfile.TemporaryDirectory(prefix="phase5-overlay-cleanup-") as directory:
            root = Path(directory).resolve()
            layout = make_layout(transaction, root)
            run_root = layout.state_root / "overlay-fixture"
            run_root.mkdir(mode=0o700, parents=True)
            os.chmod(run_root, 0o700)
            private = b"fixture-private-overlay-not-for-output\n"
            opened, outstanding, handles = [], set(), []
            observed = {"nlinkZero": False}
            original_open = transaction.os.open
            original_close = transaction.os.close
            original_fstat = transaction.os.fstat
            original_handle_close = transaction.DirectoryHandle.close
            original_popen = transaction.subprocess.Popen
            original_rpc = transaction.rpc_response

            class Pipe:
                def close(self):
                    return None

            class Stderr:
                def read(self):
                    return stderr

            class Process:
                def __init__(self):
                    self.stdin = Pipe()
                    self.stderr = Stderr()
                    self.returncode = returncode

                def wait(self, timeout=None):
                    return self.returncode

                def terminate(self):
                    self.returncode = returncode

                def kill(self):
                    self.returncode = returncode

            def tracked_open(*args, **kwargs):
                descriptor = original_open(*args, **kwargs)
                opened.append(descriptor)
                outstanding.add(descriptor)
                return descriptor

            def tracked_close(descriptor):
                original_close(descriptor)
                outstanding.discard(descriptor)

            def tracked_fstat(descriptor):
                facts = original_fstat(descriptor)
                if facts.st_nlink == 0:
                    observed["nlinkZero"] = True
                return facts

            def tracked_handle_close(handle):
                original_handle_close(handle)
                handles.append(handle)

            def rpc(_process, _request, _identifier):
                if rpc_failure:
                    transaction.fail("config_overlay_parser")
                return {} if _identifier == 1 else {"config": {}, "origins": {}}

            transaction.os.open = tracked_open
            transaction.os.close = tracked_close
            transaction.os.fstat = tracked_fstat
            transaction.DirectoryHandle.close = tracked_handle_close
            transaction.subprocess.Popen = lambda *_args, **_kwargs: Process()
            transaction.rpc_response = rpc
            try:
                try:
                    transaction.config_snapshot_in_run(layout, run_root, private)
                except transaction.TransactionError as error:
                    output = str(error)
                else:
                    raise RuntimeError("overlay-cleanup-accepted-" + name)
            finally:
                transaction.os.open = original_open
                transaction.os.close = original_close
                transaction.os.fstat = original_fstat
                transaction.DirectoryHandle.close = original_handle_close
                transaction.subprocess.Popen = original_popen
                transaction.rpc_response = original_rpc
            require(output == "config_overlay_parser" and
                    private.decode() not in output and str(run_root) not in output and
                    not list(run_root.iterdir()) and observed["nlinkZero"] and
                    not outstanding and handles and all(handle.closed for handle in handles),
                    "config_overlay_cleanup_" + name)
            cases += 1
    return {"cases": cases, "failClosed": True, "privateOutput": False}


_BRIDGE_V52_DOCTOR_MODULE = None


def bridge_v52_load_doctor():
    global _BRIDGE_V52_DOCTOR_MODULE
    if _BRIDGE_V52_DOCTOR_MODULE is None:
        name = "bridge_v52_apply_doctor"
        loader = importlib.machinery.SourceFileLoader(
            name, str(ROOT / "bin/phase4-final-doctor"))
        module = types.ModuleType(name)
        module.__file__ = loader.path
        loader.exec_module(module)
        _BRIDGE_V52_DOCTOR_MODULE = module
    return _BRIDGE_V52_DOCTOR_MODULE


def bridge_v52_apply_direct(mode):
    doctor = bridge_v52_load_doctor()
    root_state = doctor.bridge_v52_classify_repository_state(
        ROOT, dict(os.environ))
    require(doctor.bridge_v52_repository_state_is_sealed(root_state),
            "bridge52_repository_state_seal")
    if mode == "implementation":
        require(root_state.state is doctor.BRIDGE_V52_IMPLEMENTATION_STATE,
                "bridge52_implementation_state")
        state = root_state.state.value
    else:
        require(root_state.state in {
            doctor.BRIDGE_V52_REVIEW_STATE, doctor.BRIDGE_V52_MAIN_STATE,
        },
                "bridge52_implementation_state")
        state = root_state.state.value
    return {
        "acceptedControlCommit": doctor.BRIDGE_V52_BASE,
        "evidenceCommit": root_state.evidence,
        "implementationCommit": root_state.implementation,
        "liveApplyAuthorized": False,
        "marker": doctor.BRIDGE_V52_MARKER,
        "mode": mode,
        "phase5ApplyAuthorized": False,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "protectedBaselineCommit": doctor.BRIDGE_V52_BASE,
        "repositoryState": state,
        "schema": 1,
        "sourceCommit": root_state.head,
        "stageBContinuationRequired": True,
        "verdict":
            "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
            "PREPARED_FOR_INDEPENDENT_REVIEW",
    }


def bridge_v52_apply_entrypoint(raw_arguments):
    mode = ("implementation"
            if raw_arguments == ["--implementation", "--json"] else
            "git-only" if raw_arguments == ["--git-only", "--json"] else
            None)
    if mode is None:
        print(json.dumps({"error": "bridge52_usage", "mode": "unknown",
                          "schema": 1, "verdict": "FAIL"},
                         sort_keys=True, separators=(",", ":")))
        return 1
    try:
        value = bridge_v52_apply_direct(mode)
    except Exception as error:
        raw_reason = str(error)
        reason = (raw_reason if re.fullmatch(r"bridge52_[a-z0-9_]+",
                                             raw_reason)
                  else "bridge52_internal")
        print(json.dumps({"error": reason, "mode": mode, "schema": 1,
                          "verdict": "FAIL"},
                         sort_keys=True, separators=(",", ":")))
        return 1
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    return 0


def main():
    raw_arguments = list(sys.argv[1:])
    branch_probe = run([*GIT, "branch", "--show-current"])
    head_probe = run([*GIT, "rev-parse", "HEAD"])
    bridge_candidate = (
        branch_probe.returncode == head_probe.returncode == 0
        and branch_probe.stdout.strip() in {
            "codex/phase5-bridge-merge-compatibility-correction-v52", "main",
        }
        and head_probe.stdout.strip() !=
            "8fb22fe994c6967481cdda8c98e9b85cc9df435c"
        and run([
            *GIT, "merge-base", "--is-ancestor",
            "8fb22fe994c6967481cdda8c98e9b85cc9df435c", "HEAD",
        ]).returncode == 0
    )
    if bridge_candidate:
        return bridge_v52_apply_entrypoint(raw_arguments)
    parser = argparse.ArgumentParser()
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--precommit", action="store_true")
    modes.add_argument("--implementation", action="store_true")
    modes.add_argument("--correction", action="store_true")
    modes.add_argument("--git-only", action="store_true")
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()
    mode = (
        "precommit"
        if arguments.precommit
        else "implementation"
        if arguments.implementation
        else "correction"
        if arguments.correction
        else "git-only"
        if arguments.git_only
        else "final"
    )
    try:
        current = current_main_compatibility(
            repository_only=mode in {"git-only", "implementation"}, mode=mode)
        if current is not None:
            if mode == "final" and current["state"] in {"current_main_compatibility_main", "post_integration_main", "private_runtime_integrated_main", "post_private_routing_main", "private_runtime_runner_gate_main", "current_private_runtime_shape_main"}:
                value = {
                    "error": "signed_vendor_runtime_reconciliation_required",
                    "mode": mode,
                    "schema": 1,
                    "verdict": "FAIL",
                }
                print(json.dumps(value, sort_keys=True, separators=(",", ":")))
                return 1
            marker = (CURRENT_SHAPE_MARKER if current["state"].startswith("current_private_runtime_shape_")
                      else RUNNER_GATE_MARKER if current["state"].startswith("private_runtime_runner_gate_")
                      else POST_PRIVATE_ROUTING_MARKER if current["state"].startswith("post_private_routing_")
                      else POST_INTEGRATION_MARKER if current["state"].startswith("post_integration_")
                      else PRIVATE_RUNTIME_MARKER if current["state"].startswith("private_runtime_integrated_")
                      else CURRENT_MAIN_MARKER)
            verdict = (CURRENT_SHAPE_VERDICT if current["state"].startswith("current_private_runtime_shape_")
                       else RUNNER_GATE_VERDICT if current["state"].startswith("private_runtime_runner_gate_")
                       else POST_PRIVATE_ROUTING_VERDICT if current["state"].startswith("post_private_routing_")
                       else POST_INTEGRATION_VERDICT if current["state"].startswith("post_integration_")
                       else PRIVATE_RUNTIME_VERDICT if current["state"].startswith("private_runtime_integrated_")
                       else CURRENT_MAIN_VERDICT)
            value = {"acceptedControlCommit": APPLY_BUNDLE_ACCEPTANCE, "liveApplyAuthorized": False, "marker": marker, "mode": mode,
                     "phase5ApplyAuthorized": False, "phase5PassClaimed": False,
                     "phase6Authorized": False, "protectedBaselineCommit": current["baseline"],
                     "repositoryState": current["state"], "schema": 1, "sourceCommit": git("rev-parse", "HEAD"),
                     "stageBContinuationRequired": True, "verdict": verdict}
            print(json.dumps(value, sort_keys=True, separators=(",", ":")) if arguments.json else json.dumps(value, indent=2, sort_keys=True))
            return 0
        state = validate_git(mode)
        if mode == "git-only":
            value = final_report(state, mode)
        else:
            transaction = validate_static()
            cli_capability()
            trusted_probe = trusted_probe_static()
            production_negatives = production_state_negatives(
                transaction
            )
            positive = transaction_positive(transaction)
            negatives = transaction_negatives(transaction)
            overlay_positive = transaction_overlay_positive(
                transaction
            )
            overlay_negatives = transaction_overlay_negatives(
                transaction
            )
            current_shape = current_private_runtime_shape_fixtures(transaction)
            overlay_cleanup = config_overlay_cleanup_fixtures(transaction)
            topology = None
            baseline = None
            malicious = None
            live_layout = None
            repository_only = (
                state["repositoryState"] != "integrated_main"
                or mode != "final"
            )
            if not repository_only:
                live_layout = production_layout_probe(transaction)
            if (
                mode == "final"
                and state["repositoryState"]
                == "trusted_probe_review"
            ):
                topology = trusted_probe_topology_matrix(state)
                baseline = repository_only_baseline()
                malicious = malicious_git_probe()
            elif (
                mode == "final"
                and state["repositoryState"]
                == "private_runtime_review"
            ):
                topology = private_runtime_topology_matrix(state)
                baseline = private_runtime_repository_baseline(state)
                malicious = malicious_git_probe(PRIVATE_RUNTIME_BRANCH)
            checks = {
                "acceptedBase": (
                    baseline is not None
                    or state["repositoryState"] == "integrated_main"
                    or mode != "final"
                ),
                "postReconciliationProductionState": (
                    repository_only
                    or (
                        live_layout is not None
                        and live_layout["config"]["length"]
                        == RECONCILED_CONFIG_LENGTH
                        and live_layout["config"]["sha256"]
                        == RECONCILED_CONFIG_SHA256
                        and live_layout["projectRows"] == 19
                        and live_layout["controlProjectTrustRows"] == 0
                        and live_layout["hookParents"] == 1
                        and live_layout["hookTrustRecords"] == 3
                        and live_layout["nonConfigTargetsExact"] == 7
                        and live_layout["relevantHelperProcesses"] == 0
                        and live_layout["companion"]["sha256"]
                        == RECONCILIATION_COMPANION_SHA256
                        and live_layout["companion"]["state"]
                        == "reconciled"
                        and live_layout["companion"]["rollbackState"]
                        == "not-required"
                        and live_layout["receipt"]["state"] == "applied"
                        and live_layout["receipt"]["applyResult"]
                        == "applied"
                        and live_layout["receipt"]["rollbackState"]
                        == "available"
                        and live_layout["legacyPreReconciliation"][
                            "productionAccepted"
                        ]
                        is False
                    )
                ),
                "postReconciliationStateNegativeMatrix":
                    production_negatives["cases"] >= 30
                    and production_negatives["failClosed"] is True,
                "canonicalCli": True,
                "maliciousGitNonexecution": (
                    malicious is not None
                    or state["repositoryState"] == "integrated_main"
                    or mode != "final"
                ),
                "static": True,
                "topologyMatrix": (
                    (
                        topology is not None
                        and topology["negativeCases"]
                        >= (
                            15
                            if state["repositoryState"]
                            == "private_runtime_review"
                            else 18
                        )
                    )
                    or state["repositoryState"] == "integrated_main"
                    or mode != "final"
                ),
                "transactionNegativeMatrix":
                    negatives["negativeCases"] >= 30,
                "transactionOverlayNegativeMatrix":
                    overlay_negatives["cases"] >= 53,
                "transactionOverlayPositive":
                    overlay_positive["hookTrustRecords"] == 3
                    and overlay_positive["preexistingProjects"] == 19,
                "currentPrivateRuntimeShape": current_shape["failClosed"]
                    and current_shape["projectRows"] == 25
                    and current_shape["externalAdditions"] == 6
                    and current_shape["tableHeaders"] == 54
                    and overlay_cleanup["failClosed"]
                    and overlay_cleanup["cases"] == 3
                    and overlay_cleanup["privateOutput"] is False,
                "transactionPositive":
                    positive["allowlistedTargets"] == 8,
                "trustedProbeRepositoryValidation":
                    trusted_probe["modelRequests"] == 0
                    and trusted_probe["commandNegativeCases"] == 30
                    and trusted_probe["pathNegativeCases"] == 8
                    and trusted_probe["schemaNegativeCases"] == 7,
                "zeroLiveProfileReadForReview": (
                    not repository_only
                    or live_layout is None
                ),
            }
            require(all(checks.values()), "incomplete_validation")
            value = final_report(state, mode, checks)
            value["trustedProbeRepositoryValidation"] = trusted_probe
            value["productionValidation"] = (
                {
                    "liveProfileRead": False,
                    "productionStateFixtureMatrix":
                        production_negatives,
                    "reconciledConfigLength":
                        RECONCILED_CONFIG_LENGTH,
                    "reconciledConfigSHA256":
                        RECONCILED_CONFIG_SHA256,
                }
                if repository_only
                else live_layout
            )
            if topology is not None:
                value["topologyMatrix"] = topology
            if baseline is not None:
                value["acceptedBaseValidation"] = baseline
        print(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            if arguments.json
            else json.dumps(value, indent=2, sort_keys=True)
        )
        return 0
    except Exception as error:
        value = {
            "error": str(error),
            "mode": mode,
            "schema": 1,
            "verdict": "FAIL",
        }
        print(
            json.dumps(value, sort_keys=True, separators=(",", ":"))
            if arguments.json
            else json.dumps(value, indent=2, sort_keys=True)
        )
        return 1


if __name__ == "__main__":
    sys.exit(main())
