#!/usr/bin/python3
"""Fail-closed static validation for the productivity lifecycle declaration."""

import json
from pathlib import Path
import re
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from productivity_ownership import PREFERENCES, declaration, managed_preferences, preference_plan


ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "manifests/productivity-baseline.json"
MODULE = ROOT / "darwin/productivity.nix"


def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def main():
    require(sys.argv[1:] == [], "usage")
    manifest = json.loads(MANIFEST.read_text())
    module = MODULE.read_text()
    flake = (ROOT / "flake.nix").read_text()
    lock = json.loads((ROOT / "flake.lock").read_text())
    homebrew = (ROOT / "darwin/homebrew.nix").read_text()
    managed = managed_preferences(manifest)
    declaration(manifest)
    selector = re.search(r"managedPreferences = \[([^]]*)\];", module)
    require(selector is not None, "preference_selector_missing")
    declared_keys = re.findall(r'"([A-Za-z]+)"', selector.group(1))
    require(re.sub(r'"[A-Za-z]+"|\s', '', selector.group(1)) == '' and
            declared_keys == managed, "preference_selector_manifest_drift")
    entries = re.findall(r'^    ([A-Za-z]+) = \{ path = \[ ([^]]+) \]; value = ([^;]+); \};$',
                         module, re.MULTILINE)
    require(len(entries) == len(PREFERENCES) and
            {key for key, _, _ in entries} == set(PREFERENCES), "preference_declarations")
    for key, path, value in entries:
        domain, setting = PREFERENCES[key]
        domains = {"com.apple.dock": "dock", "com.apple.finder": "finder",
                   "com.apple.AppleMultitouchTrackpad": "trackpad",
                   "com.apple.WindowManager": "WindowManager",
                   "com.apple.screencapture": "screencapture"}
        expected_path = (["CustomUserPreferences", domain, setting]
                         if domain == "com.apple.widgets" else
                         [domains.get(domain, domain), setting])
        actual_path = re.findall(r'"([^"]+)"', path)
        require(actual_path == expected_path and
                re.sub(r'"[^"]+"|\s', '', path) == '', "managed_preference_path_drift")
        target = manifest["desiredState"].get(key)
        if key == "widgetAppearance":
            target = manifest["desiredState"]["widgetAppearanceRaw"]
        if key == "screenshotLocationClass":
            require(value == "screenshotsDirectory", "managed_preference_value_drift")
        else:
            require(json.loads(value) == target and type(json.loads(value)) is type(target),
                    "managed_preference_value_drift")
    require(declaration(manifest) == {"formula": [], "cask": ["iina", "keka", "localsend", "raycast", "shottr"]},
            "managed_collision_declaration_drift")
    require(manifest["ownershipObservation"]["targetedExternalApplicationRoot"] == "/Applications",
            "targeted_collision_root_drift")

    require(manifest["schema"] == 1, "manifest_schema")
    require(manifest["profile"] == "m5-air-productivity-baseline", "profile_name")
    require(type(manifest["profileActive"]) is bool, "profile_active_type")
    require(type(manifest["fullColorWidgetsActive"]) is bool,
            "widget_profile_active_type")
    battery_low_power = manifest["desiredState"]["batteryLowPowerMode"]
    require(type(battery_low_power) is bool, "battery_low_power_type")
    require(manifest["desiredState"]["acLowPowerMode"] is False,
            "ac_low_power_drift")
    require(manifest["ownerAuthorization"]["liveApplyAuthorized"] is True,
            "owner_apply_gate")
    require(manifest["ownerAuthorization"]["phase6Claimed"] is False,
            "phase6_claim")
    require(manifest["source"]["revision"] ==
            "76fe02659c00bef75e12fbfdd45ca665115e9302", "nixpkgs_revision")
    require(lock["nodes"]["nixpkgs"]["locked"]["rev"] ==
            manifest["source"]["revision"], "lock_revision_drift")

    expected_apps = {
        "IINA": ("iina", "1.4.2", "IINA.app", "com.colliderli.iina", "67CQ77V27R"),
        "Keka": ("keka", "1.6.0", "Keka.app", "com.aone.keka", "4FG648TM2A"),
        "LocalSend": ("localsend-preserved", "1.17.0", "LocalSend.app",
                      "org.localsend.localsendApp", "3W7H4PYMCV"),
        "Raycast": ("raycast", "1.104.17", "Raycast.app", "com.raycast.macos",
                    "SY64MV22J9"),
        "Shottr": ("shottr", "1.9.1", "Shottr.app", "cc.ffitch.shottr",
                   "2Y683PRQWN"),
    }
    require(len(manifest["applications"]) == len(expected_apps), "application_count")
    actual_apps = {
        app["name"]: (app["attribute"], app["version"], app["bundleName"],
                      app["bundleIdentifier"], app["teamIdentifier"])
        for app in manifest["applications"]
    }
    require(actual_apps == expected_apps, "application_identity_drift")
    require(manifest["applications"][2]["darwinSourceHash"] ==
            "sha256-/fGkLuE+uf3WrpTcWIOYHooJWZ51i94j9uZ3xPq1yTw=",
            "localsend_source_hash")

    flag = re.search(r"productivityProfileEnabled = (true|false);", module)
    require(flag is not None, "profile_flag_missing")
    require((flag.group(1) == "true") == manifest["profileActive"],
            "profile_flag_manifest_drift")
    widget_flag = re.search(r"fullColorWidgetsEnabled = (true|false);", module)
    require(widget_flag is not None, "widget_profile_flag_missing")
    require((widget_flag.group(1) == "true") == manifest["fullColorWidgetsActive"],
            "widget_profile_flag_manifest_drift")
    battery_flag = re.search(r"batteryLowPowerEnabled = (true|false);", module)
    require(battery_flag is not None, "battery_low_power_flag_missing")
    require((battery_flag.group(1) == "true") ==
            manifest["desiredState"]["batteryLowPowerMode"],
            "battery_low_power_flag_manifest_drift")

    required_module_fragments = [
        "pkgs.iina", "pkgs.keka", "pkgs.localsend.overrideAttrs",
        "pkgs.raycast", "pkgs.shottr", "dontFixup = true;",
        "/usr/bin/ditto \"LocalSend.app\"",
        "[ \"keka\" \"raycast\" \"shottr\" ]",
        "networking.applicationFirewall", "enableStealthMode",
        "managedPreferences = [", "lib.foldl' lib.recursiveUpdate",
        "lib.setAttrByPath item.path item.value", "system.defaults = selectedDefaults",
        'value = "RegularAutomatic";', '"wvous-br-corner" ]; value = 14;',
        "AppleInterfaceStyleSwitchesAutomatically", "InitialKeyRepeat",
        "KeyRepeat", "TrackpadThreeFingerDrag", "EnableTilingByEdgeDrag",
        "EnableTiledWindowMargins", "Pictures/Screenshots",
        "/usr/bin/pmset -b lowpowermode", "/usr/bin/pmset -c lowpowermode 0",
    ]
    for fragment in required_module_fragments:
        require(fragment in module, "module_contract_missing")

    require("./darwin/productivity.nix" in flake, "flake_module_import")
    for forbidden in ["/Users/example-user", "BEGIN PRIVATE KEY", "oauth_token", "access_token"]:
        require(forbidden not in module and forbidden not in MANIFEST.read_text(),
                "forbidden_repository_material")

    for empty_declaration in ["taps = [ ];", "brews = [ ];", "casks = [ ];",
                              "masApps = { };"]:
        require(empty_declaration in homebrew, "homebrew_managed_payload_drift")
    require('lib.optionalString (owns "batteryLowPowerMode")' in module and
            'lib.optionalString (owns "acLowPowerMode")' in module and
            'lib.optionalString (owns "screenshotLocationClass")' in module,
            "released_preference_write")
    require(re.search(r'system\.defaults = selectedDefaults // \{\s*'
                      r'SoftwareUpdate\.AutomaticallyInstallMacOSUpdates = true;\s*\};',
                      module) is not None and
            module.count("/usr/bin/pmset -b lowpowermode") == 1 and
            module.count("/usr/bin/pmset -c lowpowermode 0") == 1,
            "released_preference_write")

    require(manifest["permissions"]["automaticGrantAllowed"] is False,
            "automatic_tcc_grant")
    require(manifest["desiredState"]["iconAppearance"] == "RegularAutomatic",
            "icon_appearance_drift")
    require(manifest["desiredState"]["dockAutohide"] is False,
            "dock_autohide_drift")
    require(manifest["prestate"]["bottomRightHotCorner"] == "Quick Note" and
            manifest["prestate"]["bottomRightHotCornerRaw"] == 14,
            "hot_corner_prestate_drift")
    require(manifest["desiredState"]["bottomRightHotCorner"] == "Quick Note" and
            manifest["desiredState"]["bottomRightHotCornerRaw"] == 14,
            "hot_corner_target_drift")
    require(manifest["desiredState"]["clickWallpaperToShowDesktop"] is True,
            "click_wallpaper_desktop_target_drift")
    require(manifest["prestate"]["widgetAppearance"] == "Automatic" and
            manifest["prestate"]["widgetAppearanceRaw"] == 0,
            "widget_prestate_drift")
    require(manifest["desiredState"]["widgetAppearance"] == "Never" and
            manifest["desiredState"]["widgetAppearanceRaw"] == 1,
            "widget_target_drift")
    runtime = manifest["ownerRuntimePreferences"]
    require(type(runtime["lowPowerMode"]) is str and
            runtime["lowPowerMode"] == ("Only on Battery" if battery_low_power else "Never") and
            runtime["chargeLimitPercent"] == 90,
            "battery_runtime_preferences")
    require(runtime["approvedLoginItems"] == ["Raycast", "Shottr"],
            "approved_login_items")
    require(runtime["hotkeys"] == {
        "raycastLauncher": "Option+Space",
        "raycastClipboardHistory": "Option+V",
        "raycastEmojiSearch": "Option+E",
        "raycastWindowLeft": "Control+Option+Left",
        "raycastWindowRight": "Control+Option+Right",
        "raycastWindowMaximize": "Control+Option+Return",
        "raycastWindowCenter": "Control+Option+C",
        "shottrFullscreen": "Command+Shift+1",
        "shottrArea": "Command+Shift+2",
        "shottrInstantTextRecognition": "Control+Option+Command+O",
    }, "runtime_hotkeys")
    require(runtime["shottrCaptureBehavior"] == {
        "afterAreaCrop": "Editor",
        "afterScreenshot": ["Show", "Copy"],
        "automaticSave": False,
    }, "shottr_capture_behavior")
    require(runtime["systemConveniences"] == {
        "showBatteryPercentageInMenuBar": True,
        "bottomRightHotCorner": "Quick Note",
        "clickWallpaperToShowDesktop": True,
    }, "system_conveniences")
    require(runtime["approvedPrivacyGrants"] == {
        "Raycast": ["Accessibility"],
        "Shottr": ["Screen Recording"],
        "LocalSend": ["Local Network only if requested by macOS"],
    }, "approved_privacy_grants")
    require(runtime["withheldRaycastGrants"] ==
            ["Calendars", "Contacts", "Files and Folders"],
            "raycast_privacy_boundary")
    require(runtime["timeMachineDestinationConfigured"] is False,
            "time_machine_boundary")
    require(manifest["rollback"]["userDataMutation"] is False,
            "rollback_user_data")

    print(json.dumps({
        "schema": 1,
        "result": "pass",
        "profileActive": manifest["profileActive"],
        "fullColorWidgetsActive": manifest["fullColorWidgetsActive"],
        "applicationCount": len(expected_apps),
        "managedHomebrewPayloadCount": 0,
        "externalHomebrewAllowed": True,
        "preferencePlan": preference_plan(manifest),
        "floatingInputsAllowed": False,
        "automaticPermissionGrantAllowed": False,
        "batteryLowPowerMode": manifest["desiredState"]["batteryLowPowerMode"],
    }, indent=2, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(json.dumps({"result": "fail", "reason": str(error)}, sort_keys=True))
        raise SystemExit(1)
