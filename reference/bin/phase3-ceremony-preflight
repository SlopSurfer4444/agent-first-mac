#!/usr/bin/python3
"""Read-only identity and Git gate for the reviewed Phase 3 ceremony intent."""

import json
from pathlib import Path
import plistlib
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
BASE = "46597a386212e8007e1fa4ef2decddbcbc5c99a2"
BRANCH = "codex/phase-3-permissions-apply"
PREPARATION = ROOT / "manifests/phase3-capabilities.json"
INTENT = ROOT / "manifests/phase3-ceremony-intent.json"


def run(argv):
    completed = subprocess.run(
        [str(value) for value in argv], cwd=ROOT, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False,
    )
    return completed.returncode, completed.stdout.strip()


def resolve(value):
    return Path.home() / value[6:] if value.startswith("$HOME/") else Path(value)


def canonical_path_status(value):
    """Attest a symbolic manifest path without returning any resolved target."""
    try:
        path = resolve(value)
        absolute = path.absolute()
        if not absolute.is_absolute():
            return "unprovable"
        current = Path(absolute.anchor)
        for component in absolute.parts[1:]:
            current = current / component
            if current.is_symlink():
                return "redirected_or_symlink"
        if not path.is_dir():
            return "unprovable"
        if path.resolve(strict=True) != absolute:
            return "redirected_or_symlink"
    except (OSError, RuntimeError):
        return "unprovable"
    return "verified"


def plist(path, key):
    try:
        with path.open("rb") as handle:
            return plistlib.load(handle).get(key)
    except (OSError, plistlib.InvalidFileException):
        return None


def parse_numeric_version(value):
    if not isinstance(value, str) or re.fullmatch(r"[0-9]+(?:\.[0-9]+)+", value) is None:
        return None
    return tuple(int(component) for component in value.split("."))


def version_at_or_above(observed, floor):
    observed_parts = parse_numeric_version(observed)
    floor_parts = parse_numeric_version(floor)
    if observed_parts is None or floor_parts is None:
        return None
    width = max(len(observed_parts), len(floor_parts))
    return observed_parts + (0,) * (width - len(observed_parts)) >= \
        floor_parts + (0,) * (width - len(floor_parts))


def expected_identities(stage):
    preparation = json.loads(PREPARATION.read_text())
    intent = json.loads(INTENT.read_text())
    by_id = {item["id"]: item for item in preparation["logical_identities"]}
    result = [dict(by_id[item]) for item in intent["required_identity_refs"]]
    textedit = dict(intent["computer_use_targets"][0])
    textedit.update({
        "observed_version": plist(Path(textedit["path"]) / "Contents/Info.plist",
                                  "CFBundleShortVersionString"),
        "version_policy": "live_system_version",
        "signature_verification": "deep_strict",
    })
    result.append(textedit)
    result.append(dict(by_id["google_chrome"]))
    for rule in intent["signed_vendor_update_policy"]["identity_floors"]:
        item = next(candidate for candidate in result
                    if candidate["id"] == rule["identity_ref"])
        item["version_policy"] = "minimum_floor"
        item["floor_identity_ref"] = rule["floor_identity_ref"]
        item["floor_version"] = by_id[rule["floor_identity_ref"]]["observed_version"]
    return result


def inspect(item):
    path = resolve(item["path"])
    path_status = canonical_path_status(item["path"])
    facts = {
        "canonical_path": item["path"],
        "canonical_path_status": path_status,
    }
    if path_status != "verified":
        return compare(item, facts)
    info = path / "Contents/Info.plist"
    if not info.is_file():
        info = path / "Info.plist"
    facts.update({
        "bundle_id": plist(info, "CFBundleIdentifier"),
        "version": plist(info, "CFBundleShortVersionString"),
    })
    _, output = run(["/usr/bin/codesign", "-dv", "--verbose=4", path])
    match = re.search(r"^TeamIdentifier=(.+)$", output, re.MULTILINE)
    facts["team_id"] = None if not match or match.group(1) == "not set" else match.group(1)
    _, output = run(["/usr/bin/codesign", "-dr", "-", path])
    match = re.search(r"^designated => (.+)$", output, re.MULTILINE)
    facts["designated_requirement"] = match.group(1) if match else None
    verify = ["/usr/bin/codesign", "--verify", "--strict", path]
    if item.get("signature_verification") == "deep_strict":
        verify.insert(2, "--deep")
    status, _ = run(verify)
    facts["signature_valid"] = status == 0
    if str(path).startswith("/System/"):
        facts["gatekeeper_assessment"] = "not_applicable_system_app"
    elif path.suffix == ".app":
        status, _ = run(["/usr/sbin/spctl", "-a", "-t", "exec", path])
        facts["gatekeeper_assessment"] = "accepted" if status == 0 else "rejected"
    else:
        facts["gatekeeper_assessment"] = "not_applicable_embedded_or_plugin"
    return compare(item, facts)


def compare(item, facts):
    expected = {
        "bundle_id": item["bundle_id"],
        "team_id": item.get("team_id"),
        "designated_requirement": item["designated_requirement"],
    }
    if item.get("version_policy") == "minimum_floor":
        expected["canonical_path"] = item["path"]
        expected["canonical_path_status"] = "verified"
    elif item.get("version_policy") != "live_system_version":
        expected["version"] = item["observed_version"]
    mismatches = sorted(key for key, value in expected.items() if facts.get(key) != value)
    if item.get("version_policy") == "minimum_floor":
        meets_floor = version_at_or_above(facts.get("version"), item["floor_version"])
        if meets_floor is None:
            version_status = "malformed"
            mismatches.append("version")
        elif not meets_floor:
            version_status = "below_floor"
            mismatches.append("version")
        else:
            version_status = "at_or_above_floor"
        version = {
            "floor_identity_ref": item["floor_identity_ref"],
            "floor_source": "accepted_preparation",
            "floor_version": item["floor_version"],
            "observed_version": facts.get("version"),
            "status": version_status,
        }
    else:
        version = {
            "floor_identity_ref": None,
            "floor_source": "live_system_version",
            "floor_version": None,
            "observed_version": facts.get("version"),
            "status": "live_system_version",
        }
    if facts.get("signature_valid") is not True:
        mismatches.append("signature_valid")
    if facts.get("gatekeeper_assessment") not in {
        "accepted", "not_applicable_system_app", "not_applicable_embedded_or_plugin",
    }:
        mismatches.append("gatekeeper_assessment")
    return {
        "id": item["id"],
        "status": "mismatch" if mismatches else "verified_identity",
        "facts": facts,
        "mismatch_fields": sorted(set(mismatches)),
        "version": version,
    }


def fixture_compare(item, fixture):
    facts = dict(fixture.get("identities", {}).get(item["id"], {}))
    if item.get("version_policy") == "minimum_floor":
        facts.setdefault("canonical_path_status", "verified")
    return compare(item, facts)


def git_facts():
    branch_status, branch = run(["/usr/bin/git", "branch", "--show-current"])
    base_status, _ = run(["/usr/bin/git", "merge-base", "--is-ancestor", BASE, "HEAD"])
    clean_status, dirty = run(["/usr/bin/git", "status", "--porcelain"])
    return {
        "base_is_ancestor": base_status == 0,
        "branch": branch if branch_status == 0 else "unknown",
        "branch_expected": branch_status == 0 and branch == BRANCH,
        "clean": clean_status == 0 and dirty == "",
    }


def prerequisites(fixture):
    if fixture is not None:
        return {
            "developer_group_present": fixture["developer_group_present"],
            "devtools_security": fixture["devtools_security"],
        }
    status, groups = run(["/usr/bin/id", "-Gn"])
    dev_status, dev = run(["/usr/sbin/DevToolsSecurity", "-status"])
    return {
        "developer_group_present": status == 0 and "_developer" in groups.split(),
        "devtools_security": "enabled" if dev_status == 0 and "enabled" in dev.lower()
        else "disabled",
    }


def main():
    args = sys.argv[1:]
    json_mode = False
    fixture_path = None
    stage = "intent"
    while args:
        arg = args.pop(0)
        if arg == "--json":
            json_mode = True
        elif arg == "--fixture" and args:
            fixture_path = Path(args.pop(0))
        elif arg == "--stage" and args:
            stage = args.pop(0)
        else:
            raise SystemExit("usage: phase3-ceremony-preflight [--json] [--fixture PATH] [--stage intent|post-reconciliation]")
    if stage not in {"intent", "post-reconciliation"}:
        raise SystemExit("unsupported stage")
    fixture = json.loads(fixture_path.read_text()) if fixture_path else None
    if fixture is not None and fixture.get("schema") != 1:
        raise SystemExit("unsupported fixture schema")
    intent = json.loads(INTENT.read_text())
    expected = expected_identities(stage)
    identities = [
        fixture_compare(item, fixture)
        if fixture is not None else inspect(item) for item in expected
    ]
    by_id = {item["id"]: item for item in identities}
    installed = by_id["authorization_plugin_installed"]
    embedded = by_id["authorization_plugin_embedded"]
    locked_aligned = (
        installed["status"] == "verified_identity"
        and embedded["status"] == "verified_identity"
        and installed["facts"].get("version") == embedded["facts"].get("version")
    )
    reconciliation_required = not locked_aligned
    git = git_facts()
    identity_failure = any(item["status"] != "verified_identity" for item in identities)
    git_failure = not (git["base_is_ancestor"] and git["branch_expected"] and git["clean"])
    reconciliation_failure = stage == "post-reconciliation" and not locked_aligned
    blocked = identity_failure or git_failure or reconciliation_failure
    report = {
        "schema": 1,
        "phase": "phase3_permission_ceremony_intent",
        "stage": stage,
        "read_only": True,
        "fixture_mode": fixture is not None,
        "control_git": git,
        "identities": identities,
        "locked_use": {
            "aligned": locked_aligned,
            "status": "ready" if locked_aligned else "vendor_reconciliation_required",
            "reconciliation_required": reconciliation_required,
            "action": "vendor_reconciliation_required" if reconciliation_required
            else "skip_already_aligned",
        },
        "prerequisites": prerequisites(fixture),
        "permission_state_read": False,
        "product_allowlist_read": False,
        "system_mutations_performed": False,
        "verdict": "BLOCKED" if blocked else (
            "CEREMONY_IDENTITY_READY" if locked_aligned
            else "CEREMONY_IDENTITY_READY_RECONCILIATION_REQUIRED"
        ),
        "verdict_ceiling": intent["authority"]["verdict_ceiling"],
    }
    if json_mode:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"Phase 3 ceremony preflight: {report['verdict']}")
        for item in identities:
            print(f"{item['status'].upper():18} {item['id']}")
        print(f"LOCKED_USE        {report['locked_use']['status']}")
        print("TCC and product permission state: not read")
    raise SystemExit(1 if blocked else 0)


if __name__ == "__main__":
    main()
