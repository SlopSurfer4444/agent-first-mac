#!/usr/bin/python3
"""Retired legacy CLI; pure byte-preserving merge API remains supported.

The existing descriptor-backed phase5-apply-transaction owns publication and
recovery. Historical transactions/receipts remain immutable; this command is
not an alternate writer, parser or recovery path. It accesses no target files.
"""
import re

MANAGED = {
    "approval_policy": '"never"',
    "sandbox_mode": '"danger-full-access"',
}
ASSIGNMENT = re.compile(
    r"^(?P<prefix>\s*(?P<key>approval_policy|sandbox_mode)\s*=\s*)"
    r'(?P<value>"(?:[^"\\]|\\.)*")(?P<suffix>\s*(?:#.*)?(?:\r?\n)?)$'
)


def fail(message):
    raise SystemExit("phase5-config-transaction: " + message)


def merge(current):
    try:
        text = current.decode("utf-8")
    except UnicodeDecodeError:
        fail("config must be UTF-8")
    lines = text.splitlines(keepends=True)
    first_table = len(lines)
    for index, line in enumerate(lines):
        if line.lstrip().startswith("["):
            first_table = index
            break
    seen = set()
    for index in range(first_table):
        match = ASSIGNMENT.match(lines[index])
        if re.match(r"^\s*(approval_policy|sandbox_mode)\s*=", lines[index]) and not match:
            fail("managed keys must be simple quoted top-level scalars")
        if not match:
            continue
        key = match.group("key")
        if key in seen:
            fail("duplicate managed top-level key")
        seen.add(key)
        lines[index] = match.group("prefix") + MANAGED[key] + match.group("suffix")
    missing = [key for key in MANAGED if key not in seen]
    if missing:
        if first_table and lines[first_table - 1] and not lines[first_table - 1].endswith(("\n", "\r")):
            fail("cannot insert managed block after an unterminated line")
        block = ["# BEGIN agent-first managed trusted intent\n"]
        block += [f"{key} = {MANAGED[key]}\n" for key in missing]
        block += ["# END agent-first managed trusted intent\n"]
        lines[first_table:first_table] = block
    result = "".join(lines).encode("utf-8")
    return result


def retired(*unused):
    fail("legacy executor retired; pure merge API only; use the descriptor-backed phase5-apply-transaction contract")


# Retain denial names for importers which previously selected a legacy writer.
# No filesystem/publication helper remains accidentally callable.
stage = apply = rollback = main = retired

if __name__ == "__main__":
    main()
