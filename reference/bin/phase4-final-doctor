def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def run(argv, cwd=ROOT, environment=None):
    if environment is None:
        environment = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
    return subprocess.run(
        [str(value) for value in argv], cwd=cwd,
        env=environment, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, check=False,
    )


def checked(argv, cwd=ROOT, environment=None):
    result = run(argv, cwd=cwd, environment=environment)
    require(result.returncode == 0,
            "command_failed_" + Path(str(argv[0])).name)
    return result.stdout


def git(*arguments, cwd=ROOT):
    return checked([*GIT, *arguments], cwd=cwd).strip()


def git_object_exists(name, *, object_type=None, cwd=ROOT):
    """Return a closed object-existence result without leaking Git stderr.

    This helper is deliberately the only non-throwing object lookup used by
    current-main receipt validation.  Callers must not perform ancestry, tree,
    or policy work until it returns true.
    """
    result = run([*GIT, "cat-file", "-e", name], cwd=cwd)
    if result.returncode != 0:
        return False
    if object_type is None:
        return True
    probe = run([*GIT, "cat-file", "-t", name], cwd=cwd)
    return probe.returncode == 0 and probe.stdout.strip() == object_type


def digest(path):
    value = hashlib.sha256()
    with Path(path).open("rb") as stream:
        while True:
            chunk = stream.read(65536)
            if not chunk:
                break
            value.update(chunk)
    return value.hexdigest()


def path_digest(path):
    return hashlib.sha256(str(path).encode()).hexdigest()


def strict_json(path):
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            require(isinstance(key, str) and key not in value, "duplicate_json_key")
            value[key] = item
        return value

    return json.loads(Path(path).read_text(), object_pairs_hook=unique_object)


def strict_json_text(text):
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            require(isinstance(key, str) and key not in value, "duplicate_json_key")
            value[key] = item
        return value

    return json.loads(text, object_pairs_hook=unique_object)


def commit_scope(commit, cwd=ROOT):
    output = git(
        "diff-tree", "--no-commit-id", "--name-only", "-r", commit, cwd=cwd
    )
    return set(filter(None, output.splitlines()))


def commit_metadata(commit, cwd=ROOT):
    return git(
        "show", "-s", "--format=%an%n%ae%n%cn%n%ce", commit, cwd=cwd
    ).splitlines()


def validate_preparation_evidence(reviewed_head, implementation):
    value = strict_json(ROOT / PREPARATION_EVIDENCE)
    require(set(value) == {
        "acceptedState", "base", "branch", "conditionalAcceptance",
        "finalizationImplementationCommit", "gate", "historicalProvenance",
        "phase", "rollback", "schema", "systemMutations", "tests",
        "unchangedArtifacts",
    }, "preparation_evidence_keys")
    require(value["schema"] == 1 and
            value["phase"] == "phase4_final_standalone_integration_preparation" and
            value["base"] == FINALIZATION_BASE and value["branch"] == REVIEW_BRANCH and
            value["finalizationImplementationCommit"] == implementation,
            "preparation_evidence_header")
    require(value["gate"] == {
        "independentReviewRequired": True,
        "l3Claimed": False,
        "marker": MARKER,
        "maximumVerdict": REVIEW_VERDICT,
        "phase4PassClaimed": False,
        "phase5Authorized": False,
    }, "preparation_evidence_gate")
    require(value["conditionalAcceptance"] == {
        "acceptanceCommitFiles": [ACCEPTANCE],
        "acceptanceCommitMustDirectlyFollowReviewedHead": True,
        "acceptanceRecordCreatedByExecutor": False,
        "coordinatorMetadataRequired": True,
        "integratedBranch": "main",
        "reviewBranch": REVIEW_BRANCH,
    }, "preparation_evidence_acceptance")
    require(value["systemMutations"] == {
        "applySystem": False,
        "emergencyAction": False,
        "generationOrProfile": False,
        "installedRootOrSystem": False,
        "performed": False,
        "sudoPasswordOrInteractivePrompt": False,
    }, "preparation_evidence_mutations")
    require(value["historicalProvenance"]["operationalDependency"] is False,
            "preparation_evidence_external_dependency")
    require(all(value["tests"].values()), "preparation_evidence_tests")
    require(value["unchangedArtifacts"] == {
        "brokerSHA256": BROKER_SHA256,
        "emergencyArtifactSHA256":
            "9eb393257a71cf190b2131443eb617f9c17e56adcf5716472558bd9039885cec",
        "emergencyManifestSHA256":
            "01b9df839bb9de049207ef4570068b7d336619bf51b0942c89b1d87dcd3748a6",
        "policySHA256": POLICY_SHA256,
        "receiptSHA256": RECEIPT_SHA256,
    }, "preparation_evidence_artifacts")
    require(run([*GIT, "merge-base", "--is-ancestor", reviewed_head, "HEAD"])
            .returncode == 0,
            "preparation_evidence_reviewed_head")
    return value


def validate_review_chain(reviewed_head):
    implementation = git("rev-parse", reviewed_head + "^")
    require(git("rev-parse", implementation + "^") == FINALIZATION_BASE,
            "finalization_parent")
    require(commit_scope(implementation) == IMPLEMENTATION_SCOPE,
            "finalization_implementation_scope")
    require(commit_scope(reviewed_head) == EVIDENCE_SCOPE,
            "finalization_evidence_scope")
    require(commit_metadata(implementation) == EXECUTOR_METADATA and
            commit_metadata(reviewed_head) == EXECUTOR_METADATA,
            "finalization_commit_metadata")
    require(git("rev-list", "--count", FINALIZATION_BASE + ".." + reviewed_head) == "2" and
            git("rev-list", "--merges", FINALIZATION_BASE + ".." + reviewed_head) == "",
            "finalization_history_shape")
    validate_preparation_evidence(reviewed_head, implementation)
    return implementation


def validate_acceptance_value(value, reviewed_head, implementation):
    require(set(value) == {
        "acceptedOn", "coordinatorReview", "gate", "phase", "reviewMarker",
        "reviewedFinalizationHead", "reviewedImplementationCommit", "schema",
        "systemMutationDuringAcceptance",
    }, "acceptance_keys")
    require(isinstance(value["acceptedOn"], str) and
            re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value["acceptedOn"]) is not None,
            "acceptance_date")
    require(value["schema"] == 1 and value["phase"] == "phase4_typed_root_broker" and
            value["reviewMarker"] == MARKER and
            value["reviewedFinalizationHead"] == reviewed_head and
            value["reviewedImplementationCommit"] == implementation and
            value["systemMutationDuringAcceptance"] is False,
            "acceptance_header")
    require(value["coordinatorReview"] == {
        "componentValidator": "PASS",
        "emergencyDisableRecoveryVerified": True,
        "finalDoctor": "PASS",
        "liveStateVerified": True,
        "repositoryContractVerified": True,
        "selfReportIsAcceptance": False,
    }, "acceptance_review")
    require(value["gate"] == {
        "acceptedLevel": ACCEPTED_LEVEL,
        "backupDeferredAcceptedRisk": True,
        "l3Claimed": True,
        "phase4Complete": True,
        "phase4PassClaimed": True,
        "phase5Authorized": False,
        "verdict": "PASS",
    }, "acceptance_gate")
    return value


def retained_protected_path(path):
    if path in {"AGENTS.md", "ARCHITECTURE.md", "README.md"}:
        return True
    if (
        path.startswith("codex/")
        or path.startswith("docs/phase-5")
        or path.startswith("evidence/phase-5/")
        or path.startswith("skills/manage-workstation/")
        or path
        in {
            "bin/check-phase5-prep",
            "bin/codex-quarantine",
            "bin/phase5-config-transaction",
            "bin/phase5-preflight",
            "bin/phase5-apply-transaction",
            "manifests/codex-contract.json",
            "manifests/phase5-apply-bundle.json",
            "manifests/trusted-repos.json",
            "manifests/trusted-repos.schema.json",
            "tests/fixtures/phase5-contract-cases.json",
            "tests/fixtures/phase5-skill-triggers.json",
        }
    ):
        return True
    return (
        path == "Package.swift"
        or path.startswith("Sources/AidAdmin")
        or path.startswith("bin/build-phase4")
        or path.startswith("bin/check-phase4")
        or path.startswith("bin/phase4")
        or path.startswith("docs/phase-4")
        or path.startswith("evidence/phase-4/")
        or path.startswith("install-bundles/phase-4/")
        or path.startswith("policy/aid-admin")
        or path == "policy/sudoers.d/agent-first-mac-aid-admin"
        or path.startswith("tests/AidAdmin")
    )


def validate_phase5_descendant_baseline():
    result = run(
        [ROOT / "bin/check-phase5-prep", "--git-only", "--json"]
    )
    try:
        value = strict_json_text(result.stdout)
    except (json.JSONDecodeError, TypeError, ValueError) as error:
        raise RuntimeError("phase5_validator_invalid_output") from error
    if result.returncode != 0:
        reason = value.get("error")
        require(isinstance(reason, str) and bool(reason), "phase5_validator_failed")
        raise RuntimeError(reason)
    require(
        value.get("phase5ApplyAuthorized") is False
        and value.get("phase5PassClaimed") is False
        and value.get("phase6Authorized") is False
        and value.get("preparationOnly") is True
        and value.get("repositoryState")
        in {
            "apply_bundle_integrated",
            "apply_bundle_review",
            "correction_review",
            "integrated_main",
        },
        "phase5_validator_contract",
    )
    if git("rev-parse", "HEAD") == PHASE5_ACCEPTANCE_COMMIT:
        return PHASE5_ACCEPTANCE_COMMIT
    protected_baseline = value.get("protectedBaselineCommit")
    require(
        isinstance(protected_baseline, str)
        and re.fullmatch(r"[0-9a-f]{40}", protected_baseline) is not None
        and run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                protected_baseline,
                "HEAD",
            ]
        ).returncode
        == 0,
        "phase5_protected_baseline",
    )
    return protected_baseline


def validate_accepted_descendant():
    require(commit_scope(ACCEPTANCE_COMMIT) == ACCEPTANCE_SCOPE,
            "acceptance_commit_scope")
    require(commit_metadata(ACCEPTANCE_COMMIT) == COORDINATOR_METADATA,
            "acceptance_commit_metadata")
    require(git("rev-parse", ACCEPTANCE_COMMIT + "^") == ACCEPTED_REVIEWED_HEAD,
            "acceptance_commit_parent")
    implementation = validate_review_chain(ACCEPTED_REVIEWED_HEAD)
    committed = git("show", ACCEPTANCE_COMMIT + ":" + ACCEPTANCE)
    validate_acceptance_value(
        strict_json_text(committed), ACCEPTED_REVIEWED_HEAD, implementation)
    require((ROOT / ACCEPTANCE).read_text() == committed + "\n",
            "acceptance_worktree_drift")
    require(run([*GIT, "merge-base", "--is-ancestor", ACCEPTANCE_COMMIT, "HEAD"])
            .returncode == 0, "acceptance_commit_not_ancestor")
    require(git("rev-list", "--merges", FINALIZATION_BASE + "..HEAD") == "",
            "accepted_descendant_merge")
    if git("rev-parse", "HEAD") == ACCEPTANCE_COMMIT:
        return implementation
    protected_baseline = validate_phase5_descendant_baseline()
    changed = set(filter(None, git(
        "diff", "--name-only", protected_baseline + "..HEAD").splitlines()))
    protected = sorted(path for path in changed if retained_protected_path(path))
    require(
        not protected,
        "protected_descendant_drift"
        + (":" + ",".join(protected) if protected else ""),
    )
    return implementation


def repository_state():
    require(git("status", "--porcelain=v1", "--untracked-files=all") == "",
            "dirty_worktree")
    branch = git("branch", "--show-current")
    require(branch in {
                REVIEW_BRANCH,
                DESCENDANT_REVIEW_BRANCH,
                APPLY_BUNDLE_REVIEW_BRANCH,
                "main",
            },
            "wrong_or_detached_branch")
    require(run([*GIT, "merge-base", "--is-ancestor", FINALIZATION_BASE, "HEAD"])
            .returncode == 0, "finalization_base_not_ancestor")
    if branch == REVIEW_BRANCH:
        reviewed_head = git("rev-parse", "HEAD")
        implementation = validate_review_chain(reviewed_head)
        require(not (ROOT / ACCEPTANCE).exists(), "acceptance_present_on_review_branch")
        return {
            "acceptanceCommitPresent": False,
            "branch": REVIEW_BRANCH,
            "implementationCommit": implementation,
            "repositoryState": "review",
            "reviewedFinalizationHead": reviewed_head,
        }

    implementation = validate_accepted_descendant()
    return {
        "acceptanceCommitPresent": True,
        "branch": branch,
        "implementationCommit": implementation,
        "repositoryState": (
            "accepted_main" if branch == "main" else "accepted_descendant_review"
        ),
        "reviewedFinalizationHead": ACCEPTED_REVIEWED_HEAD,
    }


def exact_file(path, mode, size, expected_hash=None, owner=None):
    value = Path(path)
    facts = value.lstat()
    required_owner = os.getuid() if owner == "caller" else 0
    require(stat.S_ISREG(facts.st_mode) and not value.is_symlink() and
            facts.st_uid == required_owner and stat.S_IMODE(facts.st_mode) == mode and
            facts.st_size == size, "file_contract_" + value.name)
    if expected_hash is not None:
        require(digest(value) == expected_hash, "file_hash_" + value.name)
    return value


def exact_directory(path, mode, size):
    value = Path(path)
    facts = value.lstat()
    require(stat.S_ISDIR(facts.st_mode) and not value.is_symlink() and
            facts.st_uid == facts.st_gid == 0 and
            stat.S_IMODE(facts.st_mode) == mode and facts.st_size == size,
            "directory_contract_" + value.name)


def current_main_receipt_file(receipt):
    """Return an unambiguous receipt path after its filesystem boundary check."""
    value = Path(receipt)
    facts = value.lstat()
    require(stat.S_ISREG(facts.st_mode) and not value.is_symlink() and
            facts.st_uid == os.getuid() and facts.st_nlink == 1 and
            stat.S_IMODE(facts.st_mode) == 0o400 and
            1 <= facts.st_size <= 4096, "current_main_receipt_file")
    return value


def current_main_command_facts(root, unknown, generic, validate):
    """Derive bounded command facts; fixtures use these exact raw-result paths."""
    return {
        "genericSudoDenied": {"trueDenied": generic.returncode != 0,
                              "validateDenied": validate.returncode != 0},
        "rootDoctor": {"outputBounded": len(root.stdout.encode()) <= 16384,
                       "returncode": root.returncode, "value": strict_json_text(root.stdout)},
        "unknownCommandDenied": {"outputBounded": len(unknown.stdout.encode()) <= 4096,
                                  "reason": "unknown_command" if unknown.stdout == "aid-admin: rejected: unknown_command\n" else "other",
                                  "returncode": unknown.returncode},
    }


def current_main_emergency_enabled(paths=None):
    paths = paths or ["/etc/agent-first-mac/aid-admin.disabled",
                      "/etc/agent-first-mac/aid-admin.disabled.new",
                      "/etc/sudoers.d/agent-first-mac-aid-admin.disabled"]
    return not any(os.path.lexists(path) for path in paths)


def current_main_process_names(output):
    return [Path(item.strip()).name for item in output.splitlines()]


def current_main_generation_fact(link, store_root=Path("/nix/store")):
    """Read one numbered link without treating a bridge symlink as a store target."""
    link = Path(link)
    link_facts = link.lstat()
    raw_target = os.readlink(link)
    prefix = str(store_root) + "/"
    component = raw_target[len(prefix):] if raw_target.startswith(prefix) else ""
    canonical_single_store_object = (bool(component) and "/" not in component and
                                     component not in {".", ".."} and
                                     raw_target == prefix + component)
    direct = Path(raw_target) if canonical_single_store_object else None
    resolved = link.resolve(strict=True)
    facts = resolved.lstat()
    direct_facts = direct.lstat() if direct is not None and os.path.lexists(direct) else None
    return {"gid": facts.st_gid, "kind": "directory" if stat.S_ISDIR(facts.st_mode) else "other",
            "mode": stat.S_IMODE(facts.st_mode), "path": str(resolved),
            "substituted": not (stat.S_ISLNK(link_facts.st_mode) and
                                  canonical_single_store_object and direct_facts is not None and
                                  stat.S_ISDIR(direct_facts.st_mode) and not stat.S_ISLNK(direct_facts.st_mode) and
                                  direct.resolve(strict=True) == resolved),
            "uid": facts.st_uid}


CURRENT_MAIN_FACT_KEYS = {
    "artifacts", "directories", "emergencyEnabled", "genericSudoDenied",
    "historicalTargets", "narHash", "phase2Accepted", "phase3Accepted",
    "processes", "profileTarget", "receipt", "receiptFile", "rootDoctor",
    "target", "targets", "unknownCommandDenied", "versionFile", "versionLink",
    "versionValue",
}
RUNNER_GATE_CONTROL = "1f8be8188983e08a1f3a47a88917c2c439a456a4"
RUNNER_GATE_TREE = "62f0c39cded532260e3ef689904d7b348a9af425"
RUNNER_GATE_OWNER_PARENT = "515f2d8fef374662505a742e754812861d47a08d"
RUNNER_GATE_OWNER_SCOPE = {"ARCHITECTURE.md", "bin/check-productivity-baseline", "bin/productivity-doctor", "darwin/productivity.nix", "manifests/productivity-baseline.json"}


def validate_current_main_facts(facts, control=ROOT, runner_route=False):
    """Validate bounded, explicit current-generation facts.

    The production doctor gathers these facts from its fixed paths.  The Phase 4
    matrix feeds the identical validator synthetic facts, so a production
    comparison cannot silently become a fixture-only assertion.
    """
    require(set(facts) == CURRENT_MAIN_FACT_KEYS, "current_main_facts_schema")
    receipt_file = facts["receiptFile"]
    require(receipt_file == {"kind": "file", "mode": 0o400, "nlink": 1,
                             "owner": "caller", "sizeBounded": True,
                             "symlink": False}, "current_main_receipt_file")
    receipt = facts["receipt"]
    require(set(receipt) == {"controlCommit", "controlTree", "policyHash", "reviewed",
                             "schema", "targetSystemNarHash", "targetSystemPath"} and
            receipt["schema"] == 1 and receipt["reviewed"] is True and
            isinstance(receipt["controlCommit"], str) and
            re.fullmatch(r"[0-9a-f]{40}", receipt["controlCommit"]) is not None and
            isinstance(receipt["targetSystemNarHash"], str) and
            1 <= len(receipt["targetSystemNarHash"]) <= 512,
            "current_main_receipt")
    base = RUNNER_GATE_CONTROL if runner_route else "a2a607956745ca9a3f85960b3da0b98463a33880"
    require(git_object_exists(receipt["controlCommit"] + "^{commit}",
                              object_type="commit", cwd=control) and
            run([*GIT, "merge-base", "--is-ancestor", base, receipt["controlCommit"]], cwd=control).returncode == 0 and
            run([*GIT, "merge-base", "--is-ancestor", receipt["controlCommit"], "HEAD"], cwd=control).returncode == 0 and
            receipt["controlTree"] == git("rev-parse", receipt["controlCommit"] + "^{tree}", cwd=control) and
            receipt["policyHash"] == POLICY_SHA256,
            "current_main_receipt_bindings")
    if runner_route:
        require(receipt["controlCommit"] == RUNNER_GATE_CONTROL and receipt["controlTree"] == RUNNER_GATE_TREE and
                git("rev-parse", RUNNER_GATE_CONTROL + "^", cwd=control) == RUNNER_GATE_OWNER_PARENT and
                commit_scope(RUNNER_GATE_CONTROL, cwd=control) == RUNNER_GATE_OWNER_SCOPE and
                commit_scope(RUNNER_GATE_OWNER_PARENT, cwd=control) == RUNNER_GATE_OWNER_SCOPE,
                "runner_gate_owner_receipt_bindings")
    targets = facts["targets"]
    require(isinstance(targets, dict) and all(isinstance(number, int) and number > 0
            for number in targets), "current_main_generations")
    for number, target in targets.items():
        require(isinstance(target, dict) and set(target) == {"gid", "kind", "mode", "path", "substituted", "uid"} and
                target["kind"] == "directory" and target["uid"] == target["gid"] == 0 and
                target["mode"] & 0o022 == 0 and target["substituted"] is False and
                isinstance(target["path"], str) and target["path"].startswith("/nix/store/"),
                "current_main_generation_" + str(number))
    require(2 in targets and 3 in targets and facts["profileTarget"] == facts["target"]["path"] ==
            receipt["targetSystemPath"] and facts["target"]["path"] in
            [item["path"] for item in targets.values()], "current_main_generation")
    if runner_route:
        require({2, 3, 20, 21} <= set(targets) and not any(number > 21 for number in targets) and
                facts["target"] == targets[21] and
                targets[20]["path"] != targets[21]["path"], "runner_gate_current_generations")
    historical = facts["historicalTargets"]
    require(historical == {"generation2PathSHA256": PREVIOUS_PATH_SHA256,
                           "generation3PathSHA256": TARGET_PATH_SHA256},
            "current_main_historical_generations")
    target = facts["target"]
    require(target == targets[[number for number, item in targets.items()
                               if item["path"] == facts["profileTarget"]][0]],
            "current_main_target")
    link, file = facts["versionLink"], facts["versionFile"]
    require(link == {"gid": 0, "kind": "symlink", "mode": 0o755, "uid": 0} and
            file == {"gid": 0, "kind": "file", "modeWritable": False,
                     "owner": 0, "parent": "/nix/store", "sizeBounded": True},
            "current_main_version_link")
    version = facts["versionValue"]
    sources = strict_json(control / "manifests/package-sources.json")["sources"]
    darwin, nixpkgs = sources["nix_darwin"]["revision"], sources["nixpkgs"]["revision"]
    require(set(version) == {"configurationRevision", "darwinLabel", "darwinRevision", "nixpkgsRevision"} and
            version == {"configurationRevision": receipt["controlCommit"],
                        "darwinLabel": "26.05." + darwin[:7], "darwinRevision": darwin,
                        "nixpkgsRevision": nixpkgs}, "current_main_configuration_revision")
    require(facts["narHash"] == receipt["targetSystemNarHash"], "current_main_target_nar")
    for name in ("audit", "staging"):
        require(facts["directories"].get(name) == {"gid": 0, "kind": "directory", "mode": 0o700,
                                                     "symlink": False, "uid": 0},
                "current_main_directory_" + name)
    require(facts["artifacts"] == {"broker": True, "policy": True, "sudoers": True} and
            facts["emergencyEnabled"] is True and
            facts["rootDoctor"] == {"outputBounded": True, "returncode": 0, "value": {
                "checks": {"emergency_disable_absent": True, "installed_artifact_attestation": True,
                           "installed_contract": True, "policy_hash": True},
                "command": "doctor-root", "problems": [], "readOnly": True, "schema": 1,
                "systemMutationsPerformed": False, "verdict": "ROOT_CONTRACT_READY"}} and
            facts["unknownCommandDenied"] == {"outputBounded": True, "reason": "unknown_command", "returncode": 64} and
            facts["genericSudoDenied"] == {"trueDenied": True, "validateDenied": True} and
            facts["phase2Accepted"] is True and facts["phase3Accepted"] is True,
            "current_main_root_contract")
    require(not set(facts["processes"]) & {"aid-admin", "aid-admin-bootstrap", "aid-admin-emergency-action", "darwin-rebuild", "nix-env", "sudo"},
            "current_main_process")
    return {"caseCount": 15, "caseIDs": [
        "artifacts", "directories", "emergency", "generations", "historical",
        "nar", "phase2", "phase3", "processes", "receipt", "revision",
        "root", "target", "version", "versionLink"], "result": "pass"}


def generation_targets():
    profile = Path("/nix/var/nix/profiles/system")
    result = {}
    for path in profile.parent.glob("system-*-link"):
        match = re.fullmatch(r"system-([1-9][0-9]{0,8})-link", path.name)
        if match is not None:
            facts = path.lstat()
            require(stat.S_ISLNK(facts.st_mode) and facts.st_uid == 0,
                    "generation_link_contract")
            target = path.resolve(strict=True)
            target_facts = target.lstat()
            require(str(target).startswith("/nix/store/") and
                    stat.S_ISDIR(target_facts.st_mode) and target_facts.st_uid == 0 and
                    target_facts.st_mode & 0o022 == 0, "generation_target_contract")
            result[int(match.group(1))] = target
    return result


def validate_phase3_evidence():
    for relative, expected in PHASE3_HASHES.items():
        require(digest(ROOT / relative) == expected,
                "phase3_evidence_hash_" + Path(relative).stem)
    acceptance = strict_json(ROOT / "evidence/phase-3/permissions-acceptance.json")
    verification = strict_json(ROOT / "evidence/phase-3/permissions-apply-verification.json")
    require(acceptance["schema"] == 1 and
            acceptance["phase"] == "phase3_permission_ceremony" and
            acceptance["gate"] == {
                "l2_remains_claimed": True,
                "l3_claimed": False,
                "next_gate": "phase4_typed_root_broker_preparation_not_started",
                "phase3_complete": True,
                "verdict": "PASS",
            }, "phase3_acceptance_contract")
    require(
        verification["schema"] == 1 and
        verification["phase"] == "phase3_permission_ceremony_apply_verification" and
        verification["ceremony"][
            "ceremony_system_mutations_bounded_to_reviewed_intent"
        ] is True and
        verification["complete_cycle_1"]["prompt_free"] is True and
        verification["targeted_repeats"]["prompt_free"] is True and
        verification["owner_override"] == {
            "commissioning_override_explicit": True,
            "one_complete_seven_probe_cycle_accepted": True,
            "second_identical_locked_use_cycle_waived": True,
            "synthetic_lock_used_as_evidence": False,
            "targeted_repeats_of_six_ordinary_probes_accepted": True,
        } and
        verification["gate"] == {
            "independent_acceptance_review_required": True,
            "l2_remains_claimed": True,
            "l3_claimed": False,
            "phase3_pass_claimed": False,
            "verdict": "READY_FOR_INDEPENDENT_PHASE3_ACCEPTANCE_REVIEW",
        },
        "phase3_verification_contract",
    )
    require(verification["scope"] == {
        "aid_admin_or_root_broker_mutated": False,
        "backup_or_cloud_mutated": False,
        "hooks_skills_or_codex_config_mutated": False,
        "repository_migration_or_next_phase_started": False,
        "vpn_profile_or_session_mutated": False,
    }, "phase3_verification_scope")
    return True


def json_exact(actual, expected):
    """Compare parsed JSON without Python's bool/int numeric coercion."""
    if type(actual) is not type(expected):
        return False
    if type(expected) is dict:
        return (set(actual) == set(expected) and
                all(json_exact(actual[key], expected[key]) for key in expected))
    if type(expected) is list:
        return (len(actual) == len(expected) and
                all(json_exact(item, expected_item)
                    for item, expected_item in zip(actual, expected)))
    return actual == expected


def validate_historical_phase2_doctor_output(first, second):
    """Accept only the immutable Phase 2 doctor's closed, repeatable receipt."""
    value = strict_json_text(first)
    require(first == second and len(first.encode()) <= 32768 and
            set(value) == {"checks", "phase", "read_only", "redaction", "schema", "verdict"} and
            type(value["schema"]) is int and value["schema"] == 1 and
            value["phase"] == "phase2_package_bootstrap" and
            value["read_only"] is True and
            value["redaction"] == "bounded_no_private_paths_or_stable_machine_identifiers" and
            value["verdict"] == "PASS" and isinstance(value["checks"], list) and
            [item.get("id") for item in value["checks"]] == [
                "standalone_contract", "control_git", "flake_lock", "lix_daemon_receipt_store",
                "darwin_home_manager_generations", "homebrew_empty_arm64", "ownership_and_path"] and
            all(set(item) == {"facts", "id", "status"} and item["status"] == "pass" and
                json_exact(item["facts"], PHASE2_HISTORICAL_FACTS[item["id"]])
                for item in value["checks"]), "phase2_historical_live_doctor")
    return True


def validate_historical_phase2_doctor_runs(first, second):
    require(first.returncode == second.returncode == 0,
            "phase2_historical_doctor_rc")
    return validate_historical_phase2_doctor_output(first.stdout, second.stdout)


