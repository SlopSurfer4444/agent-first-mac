def validate_historical_phase2_topology(repository, acceptance=PHASE2_HISTORICAL_ACCEPTANCE,
                                        reviewed=PHASE2_HISTORICAL_REVIEWED):
    """Keep the Phase 2 receipt immutable while main advances linearly."""
    require(git("status", "--porcelain=v1", cwd=repository) == "",
            "phase2_historical_source_dirty")
    require(run([*GIT, "cat-file", "-e", acceptance + "^{commit}"], cwd=repository).returncode == 0,
            "phase2_historical_acceptance_missing")
    require(run([*GIT, "cat-file", "-e", reviewed + "^{commit}"], cwd=repository).returncode == 0,
            "phase2_historical_reviewed_missing")
    require(git("rev-parse", acceptance + "^", cwd=repository) == reviewed,
            "phase2_historical_acceptance_parent")
    require(run([*GIT, "merge-base", "--is-ancestor", acceptance, "ba3efb94b0623174250e943e3f914f0797496382"],
                cwd=repository).returncode == 0,
            "phase2_historical_acceptance_nonancestor")
    require(run([*GIT, "merge-base", "--is-ancestor", acceptance, "HEAD"], cwd=repository).returncode == 0 and
            run([*GIT, "merge-base", "--is-ancestor", PHASE2_CURRENT_CONTROL, "HEAD"], cwd=repository).returncode == 0 and
            git("rev-list", "--merges", PHASE2_CURRENT_CONTROL + "..HEAD", cwd=repository) == "",
            "phase2_current_main_ancestry")
    return True


def validate_historical_phase2_clone(clone, acceptance=PHASE2_HISTORICAL_ACCEPTANCE):
    require(git("remote", cwd=clone) == "", "phase2_historical_clone_origin")
    require(git("branch", "--show-current", cwd=clone) == "main",
            "phase2_historical_clone_branch")
    require(git("rev-parse", "HEAD", cwd=clone) == acceptance,
            "phase2_historical_clone_head")
    require(git("status", "--porcelain=v1", cwd=clone) == "",
            "phase2_historical_clone_dirty")
    return True


def phase2_doctor(repository_state_value):
    if repository_state_value == "current_main_runner_gate":
        # The immutable Phase 2 doctor observes its own historical 19/18 live
        # positions.  Current 21/20 is attested by this route instead.
        validate_historical_phase2_topology(ROOT)
        return True
    if repository_state_value == "current_main_compatibility":
        repository = ROOT
        validate_historical_phase2_topology(repository)
        with tempfile.TemporaryDirectory(prefix="phase2-current-main-") as directory:
            clone = Path(directory) / "control"
            checked([*GIT, "clone", "--no-local", "--no-checkout", repository, clone],
                    environment=CLEAN_ENVIRONMENT)
            checked([*GIT, "remote", "remove", "origin"], cwd=clone,
                    environment=CLEAN_ENVIRONMENT)
            checked([*GIT, "checkout", "-B", "main", PHASE2_HISTORICAL_ACCEPTANCE], cwd=clone,
                    environment=CLEAN_ENVIRONMENT)
            validate_historical_phase2_clone(clone)
            first = run([clone / "bin/phase2-doctor", "--json"], cwd=clone,
                        environment=CLEAN_ENVIRONMENT)
            second = run([clone / "bin/phase2-doctor", "--json"], cwd=clone,
                         environment=CLEAN_ENVIRONMENT)
        return validate_historical_phase2_doctor_runs(first, second)
    repository = (
        ROOT
        if repository_state_value.startswith("accepted_")
        else Path.home() / "AIDev/control"
    )
    if repository != ROOT:
        expected = (
            "a2a607956745ca9a3f85960b3da0b98463a33880"
            if repository_state_value == "current_main_compatibility"
            else CONTROL_COMMIT
        )
        require(git("rev-parse", "HEAD", cwd=repository) == expected and
                git("branch", "--show-current", cwd=repository) == "main" and
                git("status", "--porcelain=v1", cwd=repository) == "",
                "phase2_protected_main")
    first = checked([repository / "bin/phase2-doctor", "--json"], cwd=repository,
                    environment=CLEAN_ENVIRONMENT)
    second = checked([repository / "bin/phase2-doctor", "--json"], cwd=repository,
                     environment=CLEAN_ENVIRONMENT)
    require(first == second and strict_json_text(first)["verdict"] == "PASS",
            "phase2_live_doctor")
    return True


def live_checks(repository_state_value):
    broker = exact_file("/usr/local/libexec/aid-admin", 0o555, 483712, BROKER_SHA256)
    exact_file("/etc/agent-first-mac/aid-admin-policy.json", 0o444, 1617,
               POLICY_SHA256)
    exact_file("/etc/agent-first-mac/aid-admin-install.json", 0o400, 341)
    exact_file("/etc/sudoers.d/agent-first-mac-aid-admin", 0o440, 122)
    receipt = exact_file(
        Path.home() / "AIDev/state/phase-4/apply-receipts" /
        (CONTROL_COMMIT + ".json"), 0o400, 431, RECEIPT_SHA256, owner="caller")
    receipt_value = strict_json(receipt)
    require(set(receipt_value) == {
        "controlCommit", "controlTree", "policyHash", "reviewed", "schema",
        "targetSystemNarHash", "targetSystemPath",
    } and receipt_value["schema"] == 1 and receipt_value["reviewed"] is True and
            receipt_value["controlCommit"] == CONTROL_COMMIT and
            receipt_value["policyHash"] == POLICY_SHA256,
            "receipt_binding")

    root = run(["/usr/bin/sudo", "-n", broker, "doctor-root", "--json"],
               environment=CLEAN_ENVIRONMENT)
    require(root.returncode == 0 and len(root.stdout.encode()) <= 16384,
            "root_doctor_execution")
    root_value = strict_json_text(root.stdout)
    require(root_value == {
        "checks": {
            "emergency_disable_absent": True,
            "installed_artifact_attestation": True,
            "installed_contract": True,
            "policy_hash": True,
        },
        "command": "doctor-root",
        "problems": [],
        "readOnly": True,
        "schema": 1,
        "systemMutationsPerformed": False,
        "verdict": "ROOT_CONTRACT_READY",
    }, "root_doctor_contract")
    unknown = run(["/usr/bin/sudo", "-n", broker, "unknown"],
                  environment=CLEAN_ENVIRONMENT)
    require(unknown.returncode == 64 and "unknown_command" in unknown.stdout and
            len(unknown.stdout.encode()) <= 4096, "unknown_command_not_denied")
    generic = run(["/usr/bin/sudo", "-n", "/usr/bin/true"],
                  environment=CLEAN_ENVIRONMENT)
    validate = run(["/usr/bin/sudo", "-n", "-v"], environment=CLEAN_ENVIRONMENT)
    require(generic.returncode != 0 and validate.returncode != 0,
            "generic_sudo_unexpectedly_allowed")

    emergency_paths = [
        "/etc/agent-first-mac/aid-admin.disabled",
        "/etc/agent-first-mac/aid-admin.disabled.new",
        "/etc/sudoers.d/agent-first-mac-aid-admin.disabled",
    ]
    require(not any(os.path.lexists(path) for path in emergency_paths),
            "unexpected_emergency_path")
    exact_directory("/var/log/agent-first-mac/aid-admin", 0o700, 192)
    exact_directory("/var/db/agent-first-mac/staging", 0o700, 160)

    targets = generation_targets()
    profile = Path("/nix/var/nix/profiles/system")
    require(set(targets) == {1, 2, 3} and
            Path(os.readlink(profile)).name == "system-3-link" and
            profile.resolve(strict=True) == targets[3] ==
            Path("/run/current-system").resolve(strict=True) and
            path_digest(targets[3]) == TARGET_PATH_SHA256 and
            path_digest(targets[2]) == PREVIOUS_PATH_SHA256 and
            targets[3] == Path(receipt_value["targetSystemPath"]).resolve(strict=True),
            "generation_state")

    processes = checked(["/bin/ps", "-axo", "comm="], environment=CLEAN_ENVIRONMENT)
    validate = run(["/usr/bin/sudo", "-n", "-v"], environment=CLEAN_ENVIRONMENT)
    blocked = {
        "aid-admin", "aid-admin-bootstrap", "aid-admin-emergency-action",
        "darwin-rebuild", "nix-env", "sudo",
    }
    require(not any(Path(line.strip()).name in blocked
                    for line in processes.splitlines()), "relevant_process_present")
    require(validate_phase3_evidence(), "phase3_evidence")
    require(phase2_doctor(repository_state_value), "phase2_doctor")
    return {
        "artifactBindings": True,
        "auditAndStagingBounded": True,
        "emergencyEnabledState": True,
        "historicalGeneration3Retained": True,
        "genericSudoDenied": True,
        "noRelevantProcess": True,
        "phase2AcceptedLiveDoctor": True,
        "phase3AcceptedEvidence": True,
        "previousGenerationAvailable": True,
        "rootContractReady": True,
        "unknownCommandDenied": True,
    }


def fixture_checks(path):
    value = strict_json(path)
    require(set(value) == {"checks", "schema"} and value["schema"] == 1 and
            isinstance(value["checks"], dict) and
            set(value["checks"]) == LIVE_CHECK_KEYS and
            all(isinstance(item, bool) for item in value["checks"].values()),
            "fixture_schema")
    return value["checks"]


def report(repository, checks):
    problems = sorted(key for key, value in checks.items() if value is not True)
    accepted = repository["repositoryState"].startswith("accepted_")
    if problems:
        verdict = "BLOCKED"
    elif accepted:
        verdict = "PASS"
    else:
        verdict = REVIEW_VERDICT
    return {
        "acceptedLevel": ACCEPTED_LEVEL if accepted and not problems else "L2",
        "checks": dict(sorted(checks.items())),
        "handoff": "none" if accepted and not problems else
            "coordinator_create_single_acceptance_commit_after_independent_review",
        "l3Claimed": accepted and not problems,
        "phase": "phase4_typed_root_broker",
        "phase4PassClaimed": accepted and not problems,
        "phase5Authorized": False,
        "problems": problems,
        "readOnly": True,
        "repository": repository,
        "schema": 1,
        "systemMutationsPerformed": False,
        "verdict": verdict,
    }


CURRENT_MAIN_MARKER = "CHECKPOINT_PHASE5_CURRENT_MAIN_RUNTIME_PHASE4_DOCTOR_COMPATIBILITY_REVIEW"
POST_INTEGRATION_MARKER = "CHECKPOINT_PHASE5_POST_INTEGRATION_PHASE2_DOCTOR_COMPATIBILITY_CORRECTION_REVIEW"
POST_PRIVATE_ROUTING_MARKER = "CHECKPOINT_PHASE5_PRIVATE_CURRENT_RUNTIME_POST_INTEGRATION_ROUTING_CORRECTION_REVIEW"
RUNNER_GATE_MARKER = "CHECKPOINT_PHASE5_CURRENT_MAIN_RUNNER_GATE_REBASE_REVIEW"
CURRENT_SHAPE_MARKER = "CHECKPOINT_PHASE5_CURRENT_PRIVATE_RUNTIME_SHAPE_CORRECTION_REVIEW"


def current_main_compatibility():
    result = run([ROOT / "bin/check-phase5-prep", "--git-only", "--json"])
    if result.returncode != 0:
        return None
    value = strict_json_text(result.stdout)
    if value.get("marker") not in {CURRENT_MAIN_MARKER, POST_INTEGRATION_MARKER, POST_PRIVATE_ROUTING_MARKER, RUNNER_GATE_MARKER, CURRENT_SHAPE_MARKER}:
        return None
    runner_route = value.get("marker") in {RUNNER_GATE_MARKER, CURRENT_SHAPE_MARKER}
    control = Path.home() / "AIDev/control"
    receipt_path = Path.home() / "AIDev/state/phase-4/apply-receipts/" / \
        ((RUNNER_GATE_CONTROL if runner_route else "a2a607956745ca9a3f85960b3da0b98463a33880") + ".json")
    receipt = current_main_receipt_file(receipt_path)
    receipt_value = strict_json(receipt)
    exact_file("/usr/local/libexec/aid-admin", 0o555, 483712, BROKER_SHA256)
    exact_file("/etc/agent-first-mac/aid-admin-policy.json", 0o444, 1617, POLICY_SHA256)
    exact_file("/etc/sudoers.d/agent-first-mac-aid-admin", 0o440, 122)
    targets = generation_targets()
    profile, current = Path("/nix/var/nix/profiles/system"), Path("/run/current-system")
    target = current.resolve(strict=True)
    target_facts = target.lstat()
    version_link = target / "darwin-version.json"
    link_facts = version_link.lstat()
    version_file = version_link.resolve(strict=True)
    file_facts = version_file.lstat()
    version_value = strict_json(version_file)
    nar = checked(["/nix/var/nix/profiles/default/bin/nix-store", "--query", "--hash", target],
                  environment=CLEAN_ENVIRONMENT).strip()
    directories = {}
    for name, path in (("audit", Path("/var/log/agent-first-mac/aid-admin")),
                       ("staging", Path("/var/db/agent-first-mac/staging"))):
        facts = path.lstat()
        directories[name] = {"gid": facts.st_gid, "kind": "directory" if stat.S_ISDIR(facts.st_mode) else "other",
                             "mode": stat.S_IMODE(facts.st_mode), "symlink": path.is_symlink(), "uid": facts.st_uid}
    processes = checked(["/bin/ps", "-axo", "comm="], environment=CLEAN_ENVIRONMENT)
    root = run(["/usr/bin/sudo", "-n", "/usr/local/libexec/aid-admin", "doctor-root", "--json"],
               environment=CLEAN_ENVIRONMENT)
    unknown = run(["/usr/bin/sudo", "-n", "/usr/local/libexec/aid-admin", "unknown"],
                  environment=CLEAN_ENVIRONMENT)
    generic = run(["/usr/bin/sudo", "-n", "/usr/bin/true"], environment=CLEAN_ENVIRONMENT)
    validate = run(["/usr/bin/sudo", "-n", "-v"], environment=CLEAN_ENVIRONMENT)
    normalized_targets = {}
    for number, item in targets.items():
        link = Path("/nix/var/nix/profiles/system").parent / ("system-" + str(number) + "-link")
        normalized_targets[number] = current_main_generation_fact(link)
        require(normalized_targets[number]["path"] == str(item), "current_main_generation_resolution")
    command_facts = current_main_command_facts(root, unknown, generic, validate)
    facts = {
        "artifacts": {"broker": True, "policy": True, "sudoers": True}, "directories": directories,
        "emergencyEnabled": current_main_emergency_enabled(),
        "genericSudoDenied": command_facts["genericSudoDenied"],
        "historicalTargets": {"generation2PathSHA256": path_digest(targets[2]), "generation3PathSHA256": path_digest(targets[3])},
        "narHash": nar, "phase2Accepted": phase2_doctor(
            "current_main_runner_gate" if runner_route else "current_main_compatibility"),
        "phase3Accepted": validate_phase3_evidence(),
        "processes": current_main_process_names(processes),
        "profileTarget": str(profile.resolve(strict=True)), "receipt": receipt_value,
        "receiptFile": {"kind": "file", "mode": stat.S_IMODE(receipt.lstat().st_mode), "nlink": receipt.lstat().st_nlink,
                        "owner": "caller" if receipt.lstat().st_uid == os.getuid() else "other", "sizeBounded": 1 <= receipt.lstat().st_size <= 4096,
                        "symlink": receipt.is_symlink()},
        "rootDoctor": command_facts["rootDoctor"],
        "target": normalized_targets[[number for number, item in targets.items() if item == target][0]], "targets": normalized_targets,
        "unknownCommandDenied": command_facts["unknownCommandDenied"],
        "versionFile": {"gid": file_facts.st_gid, "kind": "file" if stat.S_ISREG(file_facts.st_mode) else "other",
                        "modeWritable": bool(file_facts.st_mode & 0o022), "owner": file_facts.st_uid,
                        "parent": str(version_file.parent), "sizeBounded": 1 <= file_facts.st_size <= 4096},
        "versionLink": {"gid": link_facts.st_gid, "kind": "symlink" if stat.S_ISLNK(link_facts.st_mode) else "other",
                        "mode": stat.S_IMODE(link_facts.st_mode), "uid": link_facts.st_uid}, "versionValue": version_value,
    }
    validate_current_main_facts(facts, control, runner_route=runner_route)
    return {"artifactBindings": True, "auditAndStagingBounded": True,
            "emergencyEnabledState": True, "historicalGeneration3Retained": True,
            "genericSudoDenied": True, "noRelevantProcess": True,
            "phase2AcceptedLiveDoctor": True, "phase3AcceptedEvidence": True,
            "previousGenerationAvailable": True, "rootContractReady": True,
            "unknownCommandDenied": True}


