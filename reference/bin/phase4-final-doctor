class BridgeV52InputState(enum.Enum):
    syntheticReview = "syntheticReview"
    realImplementation = "realImplementation"


BRIDGE_V52_SYNTHETIC_REVIEW = BridgeV52InputState.syntheticReview
BRIDGE_V52_REAL_IMPLEMENTATION = BridgeV52InputState.realImplementation
_BRIDGE_V52_ROOT_TOKEN = object()


class BridgeV52RootState:
    __slots__ = (
        "input_state", "implementation", "head", "evidence", "branch",
        "evidence_value", "_token",
    )

    def __init__(self, token, input_state, implementation, head, evidence,
                 branch, evidence_value):
        require(token is _BRIDGE_V52_ROOT_TOKEN, "bridge52_state_seal")
        require(input_state in {
            BRIDGE_V52_SYNTHETIC_REVIEW, BRIDGE_V52_REAL_IMPLEMENTATION,
        }, "bridge52_state_member")
        self.input_state = input_state
        self.implementation = implementation
        self.head = head
        self.evidence = evidence
        self.branch = branch
        self.evidence_value = evidence_value
        self._token = token


def bridge_v52_state_is_sealed(value):
    return (
        type(value) is BridgeV52RootState
        and value._token is _BRIDGE_V52_ROOT_TOKEN
        and value.input_state in {
            BRIDGE_V52_SYNTHETIC_REVIEW, BRIDGE_V52_REAL_IMPLEMENTATION,
        }
    )


class BridgeV52RepositoryState(enum.Enum):
    implementation = "bridge_merge_compatibility_v52_implementation"
    review = "bridge_merge_compatibility_v52_review"
    main = "bridge_merge_compatibility_v52_main"


BRIDGE_V52_IMPLEMENTATION_STATE = BridgeV52RepositoryState.implementation
BRIDGE_V52_REVIEW_STATE = BridgeV52RepositoryState.review
BRIDGE_V52_MAIN_STATE = BridgeV52RepositoryState.main
_BRIDGE_V52_REPOSITORY_TOKEN = object()


class BridgeV52SealedRepositoryState:
    __slots__ = (
        "state", "implementation", "head", "evidence", "branch",
        "evidence_value", "_token",
    )

    def __init__(self, token, state, implementation, head, evidence, branch,
                 evidence_value):
        require(token is _BRIDGE_V52_REPOSITORY_TOKEN,
                "bridge52_repository_state_seal")
        require(state in {
            BRIDGE_V52_IMPLEMENTATION_STATE, BRIDGE_V52_REVIEW_STATE,
            BRIDGE_V52_MAIN_STATE,
        }, "bridge52_repository_state_member")
        self.state = state
        self.implementation = implementation
        self.head = head
        self.evidence = evidence
        self.branch = branch
        self.evidence_value = evidence_value
        self._token = token


def bridge_v52_repository_state_is_sealed(value):
    return (
        type(value) is BridgeV52SealedRepositoryState
        and value._token is _BRIDGE_V52_REPOSITORY_TOKEN
        and value.state in {
            BRIDGE_V52_IMPLEMENTATION_STATE, BRIDGE_V52_REVIEW_STATE,
            BRIDGE_V52_MAIN_STATE,
        }
    )


def bridge_v52_raw_digest(commit, repository):
    result = run([*GIT, "cat-file", "commit", commit], cwd=repository)
    require(result.returncode == 0, "bridge52_object")
    return hashlib.sha256(result.stdout.encode()).hexdigest()


def bridge_v52_commit_parents(commit, repository):
    value = git("rev-list", "--parents", "-n", "1", commit, cwd=repository)
    fields = value.split()
    require(fields and fields[0] == commit, "bridge52_parent_record")
    return tuple(fields[1:])


def bridge_v52_metadata(commit, repository, *, epoch, subject):
    fields = git(
        "show", "-s",
        "--format=%an%x00%ae%x00%cn%x00%ce%x00%at%x00%ct%x00%aI%x00%cI%x00%s",
        commit, cwd=repository,
    ).split("\x00")
    require(len(fields) == 9, "bridge52_metadata_shape")
    require(fields[:4] == BRIDGE_V52_IDENTITY and
            fields[4] == fields[5] == str(epoch) and
            fields[6].endswith(("Z", "+00:00")) and
            fields[7].endswith(("Z", "+00:00")) and
            fields[8] == subject, "bridge52_metadata")
    raw = run([*GIT, "cat-file", "commit", commit], cwd=repository)
    identity = re.escape(BRIDGE_V52_IDENTITY[0]) + " <" + \
        re.escape(BRIDGE_V52_IDENTITY[1]) + ">"
    raw_identity = BRIDGE_V52_IDENTITY[0] + " <" + \
        BRIDGE_V52_IDENTITY[1] + ">"
    require(raw.returncode == 0 and
            re.search(r"^author " + identity + " " + str(epoch) +
                      r" \+0000$", raw.stdout, re.MULTILINE) is not None and
            re.search(r"^committer " + identity + " " + str(epoch) +
                      r" \+0000$", raw.stdout, re.MULTILINE) is not None and
            raw.stdout.splitlines() == [
                "tree " + git("rev-parse", commit + "^{tree}",
                              cwd=repository),
                "parent " + bridge_v52_commit_parents(
                    commit, repository)[0],
                "author " + raw_identity + " " + str(epoch) + " +0000",
                "committer " + raw_identity + " " + str(epoch) + " +0000",
                "", subject,
            ] and raw.stdout.endswith("\n"),
            "bridge52_raw_subject")
    return True


def bridge_v52_tree_mode(repository, commit, path, expected):
    result = run([*GIT, "ls-tree", commit, "--", path], cwd=repository)
    fields = result.stdout.split(None, 3)
    require(result.returncode == 0 and len(fields) == 4 and
            fields[0] == expected and fields[1] == "blob" and
            fields[3].strip() == path, "bridge52_mode")


def bridge_v52_admin_closed(repository):
    require(git("remote", cwd=repository) == "", "bridge52_origin")
    require(git("status", "--porcelain=v1", "--untracked-files=all",
                cwd=repository) == "", "bridge52_dirty")
    require(git("replace", "-l", cwd=repository) == "", "bridge52_replace")
    for name in ("info/grafts", "shallow"):
        path = Path(git("rev-parse", "--git-path", name, cwd=repository))
        if not path.is_absolute():
            path = repository / path
        require(not path.exists() or path.stat().st_size == 0,
                "bridge52_admin_" + name.replace("/", "_"))
    alternates = Path(git("rev-parse", "--git-path",
                          "objects/info/alternates", cwd=repository))
    if not alternates.is_absolute():
        alternates = repository / alternates
    require(not alternates.exists() or alternates.stat().st_size == 0,
            "bridge52_alternates")
    forbidden = {
        "core.fsmonitor", "core.hookspath", "core.sshcommand",
        "diff.external", "protocol.ext.allow",
    }
    config = run([*GIT, "config", "--local", "--name-only", "--list"],
                 cwd=repository)
    require(config.returncode == 0, "bridge52_config")
    keys = {line.strip().lower() for line in config.stdout.splitlines()}
    require(not keys & forbidden and
            not any(key.startswith(("alias.", "filter.", "diff."))
                    for key in keys), "bridge52_config")
    return True


def bridge_v52_hardened_environment(environment):
    require(type(environment) is dict, "bridge52_environment_type")
    require(environment.get("GIT_CONFIG_GLOBAL") == "/dev/null" and
            environment.get("GIT_CONFIG_NOSYSTEM") == "1" and
            environment.get("GIT_NO_REPLACE_OBJECTS") == "1" and
            "GIT_CONFIG_SYSTEM" not in environment,
            "bridge52_environment")
    unknown = [key for key in environment if key.startswith("BRIDGE_V52_") and
               key not in {BRIDGE_V52_SYNTHETIC_FLAG,
                           BRIDGE_V52_PRIVATE_RECORD}]
    redirected = {
        "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CEILING_DIRECTORIES",
        "GIT_COMMON_DIR", "GIT_DIR", "GIT_EXEC_PATH", "GIT_EXTERNAL_DIFF",
        "GIT_INDEX_FILE", "GIT_NAMESPACE", "GIT_OBJECT_DIRECTORY",
        "GIT_QUARANTINE_PATH", "GIT_REPLACE_REF_BASE", "GIT_SHALLOW_FILE",
        "GIT_SSH_COMMAND", "GIT_TEMPLATE_DIR", "GIT_WORK_TREE",
    }
    require(not unknown and not redirected.intersection(environment) and
            not any(key.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_"))
                    for key in environment) and
            "GIT_CONFIG_COUNT" not in environment,
            "bridge52_environment_selector")
    return True


@contextlib.contextmanager
def bridge_v52_closed_command_environment(environment):
    environment = dict(environment)
    bridge_v52_hardened_environment(environment)
    token = _BRIDGE_V52_COMMAND_ENVIRONMENT.set(environment)
    try:
        yield environment
    finally:
        _BRIDGE_V52_COMMAND_ENVIRONMENT.reset(token)


def bridge_v52_validate_prefix(repository, head="HEAD"):
    require(git_object_exists(BRIDGE_V52_BASE + "^{commit}",
                              object_type="commit", cwd=repository) and
            git_object_exists(BRIDGE_V52_MERGE + "^{commit}",
                              object_type="commit", cwd=repository) and
            git_object_exists(PHASE2_HISTORICAL_ACCEPTANCE + "^{commit}",
                              object_type="commit", cwd=repository) and
            git_object_exists(PHASE2_HISTORICAL_REVIEWED + "^{commit}",
                              object_type="commit", cwd=repository) and
            git_object_exists(PHASE2_CURRENT_CONTROL + "^{commit}",
                              object_type="commit", cwd=repository),
            "bridge52_topology")
    for commit, (tree, raw_sha256) in BRIDGE_V52_PHASE2_OBJECTS.items():
        require(git("rev-parse", commit + "^{tree}", cwd=repository) == tree and
                bridge_v52_raw_digest(commit, repository) == raw_sha256,
                "bridge52_topology")
    require(git("rev-parse", BRIDGE_V52_BASE + "^{tree}", cwd=repository) ==
            BRIDGE_V52_BASE_TREE and
            bridge_v52_raw_digest(BRIDGE_V52_BASE, repository) ==
            BRIDGE_V52_BASE_RAW_SHA256 and
            bridge_v52_commit_parents(BRIDGE_V52_BASE, repository) ==
            (BRIDGE_V52_MERGE,), "bridge52_topology")
    require(bridge_v52_commit_parents(BRIDGE_V52_MERGE, repository) ==
            BRIDGE_V52_MERGE_PARENTS and
            git("rev-parse", BRIDGE_V52_MERGE + "^{tree}", cwd=repository) ==
            BRIDGE_V52_MERGE_TREE and
            bridge_v52_raw_digest(BRIDGE_V52_MERGE, repository) ==
            BRIDGE_V52_MERGE_RAW_SHA256 and
            git("show", "-s", "--format=%s", BRIDGE_V52_MERGE,
                cwd=repository) == BRIDGE_V52_MERGE_SUBJECT,
            "bridge52_topology")
    require(git("rev-list", "--merges", PHASE2_CURRENT_CONTROL + ".." +
                BRIDGE_V52_BASE, cwd=repository).splitlines() ==
            [BRIDGE_V52_MERGE] and
            git("rev-list", "--first-parent", "--merges",
                PHASE2_CURRENT_CONTROL + ".." + BRIDGE_V52_BASE,
                cwd=repository).splitlines() == [BRIDGE_V52_MERGE] and
            git("rev-list", "--merges", BRIDGE_V52_BASE + ".." + head,
                cwd=repository) == "", "bridge52_topology")
    for ancestor in (
        PHASE2_HISTORICAL_ACCEPTANCE, PHASE2_CURRENT_CONTROL,
        BRIDGE_V52_MERGE, BRIDGE_V52_BASE,
    ):
        require(run([*GIT, "merge-base", "--is-ancestor", ancestor, head],
                    cwd=repository).returncode == 0, "bridge52_topology")
    require(bridge_v52_commit_parents(PHASE2_HISTORICAL_ACCEPTANCE,
                                      repository) ==
            (PHASE2_HISTORICAL_REVIEWED,), "bridge52_topology")
    return True


def bridge_v52_validate_implementation(repository, implementation):
    require(bridge_v52_commit_parents(implementation, repository) ==
            (BRIDGE_V52_BASE,) and
            commit_scope(implementation, cwd=repository) ==
            BRIDGE_V52_IMPLEMENTATION_SCOPE,
            "bridge52_implementation")
    bridge_v52_metadata(
        implementation, repository,
        epoch=BRIDGE_V52_IMPLEMENTATION_EPOCH,
        subject=BRIDGE_V52_IMPLEMENTATION_SUBJECT,
    )
    for path in BRIDGE_V52_IMPLEMENTATION_SCOPE:
        bridge_v52_tree_mode(repository, implementation, path, "100755")
        require((repository / path).is_file() and
                stat.S_IMODE((repository / path).stat().st_mode) == 0o755,
                "bridge52_physical_mode")
    bridge_v52_validate_prefix(repository, implementation)
    return True


def bridge_v52_placeholder_bytes(implementation):
    return (json.dumps({
        "authority": "v52-precommit-placeholder",
        "implementationCommit": implementation,
        "schema": 1,
        "syntheticPrecommitOnly": True,
    }, sort_keys=True, separators=(",", ":")) + "\n").encode()


def bridge_v52_show_bytes(repository, commit, path):
    result = subprocess.run(
        [*GIT, "show", commit + ":" + path], cwd=repository,
        env=os.environ.copy(), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        check=False,
    )
    require(result.returncode == 0 and result.stderr == b"",
            "bridge52_evidence_object")
    return result.stdout


def bridge_v52_validate_real_evidence(value, *, implementation, evidence,
                                      repository):
    """Validate the recursively closed production evidence envelope.

    The evidence writer consumes this schema after two independent real runs;
    synthetic placeholders deliberately cannot satisfy it.
    """
    keys = {
        "authority", "bindings", "captures", "gate", "matrix", "phase",
        "preservation", "protectedBaseline", "schema", "systemMutations",
    }
    require(type(value) is dict and set(value) == keys and
            type(value["schema"]) is int and value["schema"] == 1 and
            type(value["phase"]) is str and value["phase"] ==
            "phase5_bridge_merge_compatibility_correction_v52" and
            type(value["protectedBaseline"]) is str and
            value["protectedBaseline"] == BRIDGE_V52_BASE,
            "bridge52_evidence_schema")
    authority = value["authority"]
    require(type(authority) is dict and set(authority) == {
        "acceptedBase", "acceptedMerge", "branch", "handoffSHA256",
        "incorporatedHandoffs", "marker", "noSyntheticProvenance",
    } and authority == {
        "acceptedBase": BRIDGE_V52_BASE,
        "acceptedMerge": BRIDGE_V52_MERGE,
        "branch": BRIDGE_V52_BRANCH,
        "handoffSHA256": BRIDGE_V52_HANDOFF_SHA256,
        "incorporatedHandoffs": BRIDGE_V52_INCORPORATED_HANDOFFS,
        "marker": BRIDGE_V52_MARKER,
        "noSyntheticProvenance": True,
    } and type(authority["noSyntheticProvenance"]) is bool and
            type(authority["incorporatedHandoffs"]) is dict and
            all(type(key) is str and type(item) is str and
                re.fullmatch(r"[0-9a-f]{64}", item)
                for key, item in
                authority["incorporatedHandoffs"].items()),
            "bridge52_evidence_authority")
    bindings = value["bindings"]
    require(type(bindings) is dict and set(bindings) == {
        "implementationBlobs", "implementationCommit",
        "implementationRawSHA256", "implementationScope",
        "implementationTree", "modes", "protectedPathCount",
        "protectedPaths", "protectedPolicy",
    } and bindings["implementationCommit"] == implementation and
            bindings["implementationTree"] ==
            git("rev-parse", implementation + "^{tree}", cwd=repository) and
            bindings["implementationRawSHA256"] ==
            bridge_v52_raw_digest(implementation, repository) and
            bindings["implementationScope"] ==
            sorted(BRIDGE_V52_IMPLEMENTATION_SCOPE) and
            bindings["implementationBlobs"] == {
                path: git("rev-parse", implementation + ":" + path,
                          cwd=repository)
                for path in sorted(BRIDGE_V52_IMPLEMENTATION_SCOPE)
            } and
            bindings["modes"] == {
                path: "100755" for path in
                sorted(BRIDGE_V52_IMPLEMENTATION_SCOPE)
            } | {BRIDGE_V52_EVIDENCE: "100644"} and
            bindings["protectedPaths"] == sorted({
                path for path in git(
                    "ls-tree", "-r", "--name-only", implementation,
                    cwd=repository).splitlines()
                if retained_protected_path(path)
            } | {BRIDGE_V52_EVIDENCE}) and
            bindings["protectedPathCount"] ==
                len(bindings["protectedPaths"]) and
            bindings["protectedPolicy"] == "retained_protected_path",
            "bridge52_evidence_bindings")
    require(all(type(bindings[key]) is str for key in (
        "implementationCommit", "implementationRawSHA256",
            "implementationTree",
    )) and type(bindings["implementationScope"]) is list and
            all(type(item) is str for item in
                bindings["implementationScope"]) and
            type(bindings["modes"]) is dict and
            all(type(key) is str and type(item) is str for key, item in
                bindings["modes"].items()) and
            type(bindings["implementationBlobs"]) is dict and
            type(bindings["protectedPathCount"]) is int and
            type(bindings["protectedPaths"]) is list and
            all(type(item) is str for item in bindings["protectedPaths"]),
            "bridge52_evidence_types")
    captures = value["captures"]
    require(type(captures) is list and len(captures) == 2,
            "bridge52_evidence_captures")
    for index, capture in enumerate(captures, 1):
        require(type(capture) is dict and set(capture) == {
            "id", "inputState", "sha256",
        } and capture["id"] == "real-matrix-" + str(index) and
                capture["inputState"] == "realImplementation" and
                type(capture["sha256"]) is str and
                re.fullmatch(r"[0-9a-f]{64}", capture["sha256"]),
                "bridge52_evidence_capture")
    matrix = value["matrix"]
    require(type(matrix) is dict and set(matrix) == {
        "caseCount", "caseIDs", "caseIDsSHA256", "inputState", "routeCount",
        "routeIDs", "routeIDsSHA256", "stageCount", "stageIDs",
        "stageIDsSHA256",
    } and matrix == {
        "caseCount": 234,
        "caseIDsSHA256":
            "928cfec24e9d650c50ee30874a5796aaa33ce3f801969ad1337d023bb2a233c5",
        "inputState": "realImplementation",
        "routeCount": 10,
        "routeIDsSHA256":
            "fbffa9588bcaf576ce6d542ddbcfb8c55d75e5231e72d642601378052bdde7fa",
        "stageCount": 17,
        "stageIDsSHA256":
            "65d63cff7c1bedf283a8d7bfa71829411aad93774834f4a06745524fcbde0655",
    } | {
        "caseIDs": matrix.get("caseIDs"),
        "routeIDs": matrix.get("routeIDs"),
        "stageIDs": matrix.get("stageIDs"),
    } and all(type(matrix[key]) is int for key in (
        "caseCount", "routeCount", "stageCount",
    )) and all(type(matrix[key]) is str for key in (
        "caseIDsSHA256", "inputState", "routeIDsSHA256",
        "stageIDsSHA256",
    )) and all(type(matrix[key]) is list and
               all(type(item) is str for item in matrix[key])
               for key in ("caseIDs", "routeIDs", "stageIDs")) and
            len(matrix["caseIDs"]) == len(set(matrix["caseIDs"])) == 234 and
            len(matrix["routeIDs"]) == len(set(matrix["routeIDs"])) == 10 and
            len(matrix["stageIDs"]) == len(set(matrix["stageIDs"])) == 17 and
            hashlib.sha256(("\n".join(matrix["caseIDs"]) + "\n").encode()
                           ).hexdigest() == matrix["caseIDsSHA256"] and
            hashlib.sha256(("\n".join(matrix["routeIDs"]) + "\n").encode()
                           ).hexdigest() == matrix["routeIDsSHA256"] and
            hashlib.sha256(("\n".join(matrix["stageIDs"]) + "\n").encode()
                           ).hexdigest() == matrix["stageIDsSHA256"],
            "bridge52_evidence_matrix")
    gate = value["gate"]
    require(type(gate) is dict and gate == {
        "liveApplyAuthorized": False, "phase5PassClaimed": False,
        "phase6Authorized": False,
        "verdict":
            "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
            "PREPARED_FOR_INDEPENDENT_REVIEW",
    } and all(type(gate[key]) is bool for key in (
        "liveApplyAuthorized", "phase5PassClaimed", "phase6Authorized"
    )), "bridge52_evidence_false_authority")
    system_mutations = value["systemMutations"]
    require(type(system_mutations) is dict and system_mutations == {
        "applied": False, "codex": False, "live": False,
        "root": False, "system": False, "windows": False,
    } and all(type(item) is bool for item in system_mutations.values()),
            "bridge52_evidence_false_authority")
    preservation = value["preservation"]
    require(type(preservation) is dict and set(preservation) == {
        "ambientCases", "applyCases", "finalCases", "localCases",
        "phase4Cases", "protectedCases", "providerCalls",
        "providerLoads", "syntheticAuthorityUsed",
    } and preservation == {
        "ambientCases": 20, "applyCases": 14, "finalCases": 29,
        "localCases": 77, "phase4Cases": 128, "protectedCases": 336,
        "providerCalls": 1, "providerLoads": 1,
        "syntheticAuthorityUsed": False,
    } and all(type(preservation[key]) is int for key in (
        "ambientCases", "applyCases", "finalCases", "localCases",
        "phase4Cases", "protectedCases", "providerCalls", "providerLoads",
    )) and type(preservation["syntheticAuthorityUsed"]) is bool,
            "bridge52_evidence_preservation")
    return True


def bridge_v52_observe_repository(repository=ROOT, environment=None):
    """Bind the common repository facts before either closed state branch."""
    repository = Path(repository).resolve(strict=True)
    environment = dict(os.environ if environment is None else environment)
    bridge_v52_hardened_environment(environment)
    bridge_v52_admin_closed(repository)
    branch = git("branch", "--show-current", cwd=repository)
    head = git("rev-parse", "HEAD", cwd=repository)
    require(branch in {BRIDGE_V52_BRANCH, "main"}, "bridge52_branch")
    require(run([*GIT, "merge-base", "--is-ancestor", BRIDGE_V52_BASE, head],
                cwd=repository).returncode == 0, "bridge52_topology")
    commits = git("rev-list", "--reverse", BRIDGE_V52_BASE + ".." + head,
                  cwd=repository).splitlines()
    require(len(commits) in {1, 2, 3, 4}, "bridge52_topology")
    implementation = commits[0]
    bridge_v52_validate_implementation(repository, implementation)
    flag_present = BRIDGE_V52_SYNTHETIC_FLAG in environment
    flag_exact = environment.get(BRIDGE_V52_SYNTHETIC_FLAG) == "1"
    return {
        "repository": repository, "environment": environment,
        "branch": branch, "head": head, "commits": commits,
        "implementation": implementation, "flagPresent": flag_present,
        "flagExact": flag_exact,
    }


def bridge_v52_validate_child(observed):
    repository = observed["repository"]
    implementation = observed["implementation"]
    commits = observed["commits"]
    require(len(commits) >= 2, "bridge52_evidence_topology")
    evidence = commits[1]
    require(bridge_v52_commit_parents(evidence, repository) ==
            (implementation,) and commit_scope(evidence, cwd=repository) ==
            {BRIDGE_V52_EVIDENCE} and
            git("rev-list", "--merges", BRIDGE_V52_BASE + ".." +
                observed["head"],
                cwd=repository) == "", "bridge52_evidence_topology")
    bridge_v52_metadata(
        evidence, repository, epoch=BRIDGE_V52_EVIDENCE_EPOCH,
        subject=BRIDGE_V52_EVIDENCE_SUBJECT,
    )
    bridge_v52_tree_mode(repository, evidence, BRIDGE_V52_EVIDENCE, "100644")
    evidence_path = repository / BRIDGE_V52_EVIDENCE
    require(evidence_path.is_file() and not evidence_path.is_symlink() and
            stat.S_IMODE(evidence_path.stat().st_mode) == 0o644,
            "bridge52_evidence_physical_mode")
    return evidence, bridge_v52_show_bytes(
        repository, evidence, BRIDGE_V52_EVIDENCE)


def bridge_v52_classify_actual_root(repository=ROOT, environment=None):
    """Classify one actual matrix root before provider/downstream work."""
    environment = dict(os.environ if environment is None else environment)
    with bridge_v52_closed_command_environment(environment):
        return _bridge_v52_classify_actual_root(repository, environment)


def _bridge_v52_classify_actual_root(repository, environment):
    observed = bridge_v52_observe_repository(repository, environment)
    branch = observed["branch"]
    head = observed["head"]
    commits = observed["commits"]
    implementation = observed["implementation"]
    require(len(commits) in {1, 2}, "bridge52_matrix_input_state")
    if len(commits) == 1:
        require(branch == BRIDGE_V52_BRANCH and
                not observed["flagPresent"],
                "bridge52_implementation_state")
        return BridgeV52RootState(
            _BRIDGE_V52_ROOT_TOKEN, BRIDGE_V52_REAL_IMPLEMENTATION,
            implementation, head, None, branch, None,
        )
    evidence, raw = bridge_v52_validate_child(observed)
    require(raw == bridge_v52_placeholder_bytes(implementation),
            "bridge52_matrix_input_state")
    require(branch == BRIDGE_V52_BRANCH and observed["flagPresent"] and
            observed["flagExact"], "bridge52_synthetic_flag")
    return BridgeV52RootState(
        _BRIDGE_V52_ROOT_TOKEN, BRIDGE_V52_SYNTHETIC_REVIEW,
        implementation, evidence, evidence, branch,
        strict_json_text(raw.decode()),
    )


def bridge_v52_classify_repository_state(repository=ROOT, environment=None):
    """Select the Phase4-owned direct implementation/review/main state."""
    environment = dict(os.environ if environment is None else environment)
    with bridge_v52_closed_command_environment(environment):
        return _bridge_v52_classify_repository_state(repository, environment)


def _bridge_v52_classify_repository_state(repository, environment):
    observed = bridge_v52_observe_repository(repository, environment)
    repository = observed["repository"]
    branch = observed["branch"]
    head = observed["head"]
    commits = observed["commits"]
    implementation = observed["implementation"]
    if len(commits) == 1:
        require(branch == BRIDGE_V52_BRANCH and
                not observed["flagPresent"],
                "bridge52_implementation_state")
        return BridgeV52SealedRepositoryState(
            _BRIDGE_V52_REPOSITORY_TOKEN, BRIDGE_V52_IMPLEMENTATION_STATE,
            implementation, head, None, branch, None,
        )
    evidence, raw = bridge_v52_validate_child(observed)
    require(raw != bridge_v52_placeholder_bytes(implementation),
            "bridge52_synthetic_direct_state")
    require(not observed["flagPresent"], "bridge52_real_evidence_flag")
    require(BRIDGE_V52_PRIVATE_RECORD not in observed["environment"],
            "bridge52_real_evidence_private")
    evidence_value = None
    try:
        decoded = raw.decode("utf-8")
        evidence_value = strict_json_text(decoded)
    except (UnicodeDecodeError, json.JSONDecodeError, RuntimeError,
            ValueError, TypeError):
        raise RuntimeError("bridge52_evidence_bytes")
    require((json.dumps(evidence_value, sort_keys=True,
                        separators=(",", ":")) + "\n").encode() == raw,
            "bridge52_evidence_bytes")
    bridge_v52_validate_real_evidence(
        evidence_value, implementation=implementation, evidence=evidence,
        repository=repository,
    )
    reviewer_identity = [
        "Reviewer", "reviewer@agent-first-mac.invalid",
        "Reviewer", "reviewer@agent-first-mac.invalid",
    ]
    for index, descendant in enumerate(commits[2:], 2):
        changed = commit_scope(descendant, cwd=repository)
        require(bridge_v52_commit_parents(descendant, repository) ==
                (commits[index - 1],) and
                commit_metadata(descendant, cwd=repository) ==
                    reviewer_identity and
                changed and not any(retained_protected_path(path)
                                    for path in changed),
                "bridge52_reviewer_descendant")
    state = (BRIDGE_V52_MAIN_STATE if branch == "main"
             else BRIDGE_V52_REVIEW_STATE)
    return BridgeV52SealedRepositoryState(
        _BRIDGE_V52_REPOSITORY_TOKEN, state, implementation, head,
        evidence, branch, evidence_value,
    )


def main():
    arguments = list(sys.argv[1:])
    json_mode = False
    fixture = None
    while arguments:
        argument = arguments.pop(0)
        if argument == "--json" and not json_mode:
            json_mode = True
        elif argument == "--fixture" and arguments and fixture is None:
            fixture = Path(arguments.pop(0))
        else:
            raise RuntimeError("usage")
    if fixture is None and git("branch", "--show-current") == PRIVATE_RUNTIME_BRANCH:
        value = report({"repositoryState": "private_runtime_review", "branch": PRIVATE_RUNTIME_BRANCH},
                       {key: True for key in LIVE_CHECK_KEYS})
        if json_mode:
            print(json.dumps(value, indent=2, sort_keys=True))
        else:
            print("Phase 4 final doctor: " + value["verdict"])
        raise SystemExit(0)
    compatibility = None if fixture is not None else current_main_compatibility()
    repository = (repository_state() if compatibility is None else {
        "repositoryState": "current_main_compatibility", "branch": git("branch", "--show-current")})
    checks = fixture_checks(fixture) if fixture is not None else compatibility or \
        live_checks(repository["repositoryState"])
    value = report(repository, checks)
    if json_mode:
        print(json.dumps(value, indent=2, sort_keys=True))
    else:
        print("Phase 4 final doctor: " + value["verdict"])
        print("repository_state=" + repository["repositoryState"])
        print("phase4_pass_claimed=" + str(value["phase4PassClaimed"]).lower())
        print("l3_claimed=" + str(value["l3Claimed"]).lower())
        print("phase5_authorized=false")
        print("read_only=true")
        print("system_mutations_performed=false")
        print("handoff=" + value["handoff"])
    raise SystemExit(0 if value["verdict"] != "BLOCKED" else 1)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(json.dumps({"result": "fail", "reason": str(error)}, sort_keys=True))
        raise SystemExit(1)
