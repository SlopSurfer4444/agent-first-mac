}

assert historical['phase'] == 'phase2a_package_bootstrap_preparation'
assert historical['system_mutations']['performed'] is False
assert historical['gate']['verdict'] == 'PREPARED_FOR_INDEPENDENT_REVIEW'
assert phase2_evidence['schema'] == 1
assert phase2_evidence['phase'] == 'phase2_package_bootstrap'
assert phase2_evidence['applied_authority'] == {
