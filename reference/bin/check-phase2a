}
assert acceptance['review_packet'] == {
    'doctor_contract_commit': 'ce1feef19fa89b63396a51e0f936c759505fc4ee',
    'doctor_evidence_commit': 'e7beb60fb985ab053ab04f3de2ee379316126659',
    'path': 'evidence/phase-2/verification.json',
}
assert acceptance['system_mutation_during_independent_review'] is False
assert acceptance['live_state']['temporary_mutation_processes'] == 0
assert acceptance['live_state']['darwin'] == {
    'current_generation': 2,
    'previous_generation': 1,
    'returned_to_accepted_generation': True,
}

architecture = (root / 'ARCHITECTURE.md').read_text()
agents = (root / 'AGENTS.md').read_text()
readme = (root / 'README.md').read_text()
for required in (
    'This repository alone is the operational authority',
    'the newest explicit owner decision',
    '$HOME/AIDev/control',
    '/nix/store',
    '/opt/homebrew',
    '/Applications',
    'exactly one primary installation/update owner',
    'adopt before reinstalling',
