assert acceptance['independent_review']['doctor_json_repeat_sha256'] == \
    '64c4c027df0fa0f26b7f9d062e57520ca72ad8f9d1554d34a290b9738ba0ec9e'
assert acceptance['integration'] == {
    'control_main_fast_forwarded': True,
    'main_head_before_acceptance_record': 'e7beb60fb985ab053ab04f3de2ee379316126659',
