#!/usr/bin/python3
"""Exact user LaunchAgent for RustDesk via the existing strict SSH alias."""
import sys
sys.dont_write_bytecode = True
sys.pycache_prefix = "/dev/null"
import argparse
import json
import os
from pathlib import Path
import plistlib
import re
import socket
import stat
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]
LABEL = 'com.aidev.rustdesk-ssh-tunnel'
PORT = 22118
ARGS = ['/usr/bin/ssh', '-N', '-T', '-o', 'BatchMode=yes', '-o',
        'ExitOnForwardFailure=yes', '-o', 'ConnectTimeout=10', '-o',
        'ServerAliveInterval=30', '-o', 'ServerAliveCountMax=3',
        '-L', '127.0.0.1:22118:127.0.0.1:21118', 'windows-host']

class Failure(ValueError):
    pass

def need(value, reason):
    if not value:
        raise Failure(reason)

def run(args, timeout=15):
    return subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, timeout=timeout, check=False)

def target():
    need(os.getuid() != 0, 'refusing_root')
    return Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')

def service():
    return f'gui/{os.getuid()}/{LABEL}'

def rendered():
    return plistlib.dumps({'Label': LABEL, 'ProgramArguments': ARGS,
                          'RunAtLoad': True, 'KeepAlive': True, 'ThrottleInterval': 15,
                          'StandardOutPath': '/dev/null', 'StandardErrorPath': '/dev/null'},
                         sort_keys=True)

def safe_parent(path):
    for parent in (path.parent, *path.parent.parents):
        need(not parent.is_symlink() and parent.is_dir(), 'unsafe_parent')
    info = path.parent.stat()
    need(info.st_uid == os.getuid() and not info.st_mode & 0o022, 'unsafe_parent')

def exact(path):
    if not path.exists() and not path.is_symlink():
        return False
    info = path.lstat()
    need(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
         and stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1
         and path.read_bytes() == rendered(), 'managed_plist_drift')
    return True

def loaded_pid():
    proc = run(['/bin/launchctl', 'print', service()])
    if proc.returncode:
        # Only documented not-found result is absence, not arbitrary tool failure.
        need(b'Could not find service' in proc.stderr, 'launchctl_inspection_failed')
        return None
    text = proc.stdout.decode('utf-8', errors='replace')
    match = re.search(r'^\s*pid = (\d+)\s*$', text, re.M)
    return int(match.group(1)) if match else 0

def verify_loaded_job(path):
    loaded = run(['/bin/launchctl', 'print', service()])
    need(loaded.returncode == 0, 'loaded_job_unavailable')
    text = loaded.stdout.decode('utf-8', errors='replace')
    paths = re.findall(r'^\s*path = (.+)$', text, re.M)
    programs = re.findall(r'^\s*program = (.+)$', text, re.M)
    blocks = re.findall(r'^\s*arguments = \{\s*\n(.*?)^\s*\}', text, re.M | re.S)
    argv = [line.strip() for line in blocks[0].splitlines() if line.strip()] if len(blocks) == 1 else []
    need(paths == [str(path)] and programs == [ARGS[0]] and argv == ARGS,
         'loaded_job_identity_mismatch')

def listener_pids():
    proc = run(['/usr/sbin/lsof', '-nP', '-a', '-iTCP:22118', '-sTCP:LISTEN', '-Fpn'])
    need(proc.returncode in (0, 1), 'listener_inspection_failed')
    result, pid = {}, None
    for line in proc.stdout.decode().splitlines():
        if line.startswith('p'):
            pid = int(line[1:])
        elif line.startswith('n'):
            need(pid is not None, 'listener_inspection_failed')
            result.setdefault(pid, []).append(line[1:])
    return result

def protocol_probe():
    with socket.create_connection(('127.0.0.1', PORT), timeout=5) as sock:
        sock.settimeout(5)
        data = sock.recv(128)
    # The endpoint sends its initial framed RustDesk protobuf greeting without auth.
    # Bytes stay in memory; authentication/UI success remains a separate owner check.
    need(len(data) > 1, 'remote_protocol_unavailable')

def doctor():
    path = target()
    safe_parent(path)
    need(exact(path), 'managed_plist_absent')
    pid = loaded_pid()
    need(pid is not None and pid > 0, 'tunnel_not_running')
    verify_loaded_job(path)
    cmd = run(['/bin/ps', '-p', str(pid), '-o', 'command='])
    need(cmd.returncode == 0 and cmd.stdout.strip() == ' '.join(ARGS).encode(), 'tunnel_process_mismatch')
    need(listener_pids() == {pid: ['127.0.0.1:22118']}, 'tunnel_listener_mismatch')
    protocol_probe()

def require_guard(source_guard):
    need(callable(source_guard) and source_guard() is True, 'current_source_drift')


def admitted_mutation(operation, commit):
    need(operation in ('apply', 'rollback'), 'invalid_operation')
    need(re.fullmatch('[0-9a-f]{40}', commit or '') is not None, 'invalid_commit')
    import sys
    sys.path.insert(0, str(ROOT))
    from lib.workstation_maintenance_delivery import admitted_source
    result = []
    def mutate(head, *, source_guard):
        need(head == commit, 'source_commit_mismatch')
        require_guard(source_guard)
        result.append({'apply': apply, 'rollback': rollback}[operation](source_guard))
        require_guard(source_guard)
        return True
    admitted_source(ROOT, full=False, operation_check=mutate)
    need(len(result) == 1, 'source_operation_not_completed')
    return result[0]

def rollback(source_guard):
    require_guard(source_guard)
    path = target()
    safe_parent(path)
    present = exact(path)
    pid = loaded_pid()
    if not present:
        need(pid is None, 'unowned_service_conflict')
        return False
    if pid is not None:
        # launchd caches arguments; matching disk bytes/path alone is insufficient.
        verify_loaded_job(path)
        require_guard(source_guard)
        need(exact(path), 'managed_plist_changed')
        need(run(['/bin/launchctl', 'bootout', service()]).returncode == 0, 'bootout_failed')
        need(loaded_pid() is None, 'service_still_loaded')
    need(exact(path), 'managed_plist_changed')
    require_guard(source_guard)
    path.unlink()
    require_guard(source_guard)
    return True

def apply(source_guard):
    require_guard(source_guard)
    path = target()
    safe_parent(path)
    if exact(path):
        doctor()
        return False
    need(loaded_pid() is None, 'unowned_service_conflict')
    need(listener_pids() == {}, 'port_already_owned')
    # O_EXCL preserves a concurrent owner's file; no unknown state is overwritten.
    require_guard(source_guard)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'wb') as handle:
            handle.write(rendered())
            handle.flush()
            os.fsync(handle.fileno())
        require_guard(source_guard)
        need(exact(path), 'managed_plist_changed')
        need(loaded_pid() is None and listener_pids() == {}, 'concurrent_target_conflict')
        require_guard(source_guard)
        need(run(['/bin/launchctl', 'bootstrap', f'gui/{os.getuid()}', str(path)]).returncode == 0,
             'bootstrap_failed')
        for attempt in range(10):
            require_guard(source_guard)
            try:
                doctor()
            except (Failure, OSError):
                if attempt == 9:
                    raise
                time.sleep(1)
                continue
            require_guard(source_guard)
            return True
    except BaseException:
        # Guard drift preserves exact artifacts for later admitted recovery.
        rollback(source_guard)
        raise

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('command', choices=['apply', 'doctor', 'rollback'])
    parser.add_argument('--commit')
    args = parser.parse_args()
    try:
        changed = (doctor() if args.command == 'doctor' else
                   admitted_mutation(args.command, args.commit))
        print(json.dumps({'scope': 'rustdesk-loopback-ssh-tunnel', 'verdict': 'PASS',
                          'operation': args.command, 'changed': bool(changed)}))
        return 0
    except (Failure, OSError, subprocess.SubprocessError, ValueError) as error:
        print(json.dumps({'scope': 'rustdesk-loopback-ssh-tunnel', 'verdict': 'FAIL',
                          'operation': args.command,
                          'reason': str(error) if isinstance(error, Failure) else 'bounded_runtime_failure'}))
        return 1

if __name__ == '__main__':
    raise SystemExit(main())
