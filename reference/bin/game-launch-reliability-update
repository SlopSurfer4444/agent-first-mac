#!/usr/bin/python3
"""Fixed-path reviewed game launch deployment; never dispatches or stops games."""
import sys
sys.dont_write_bytecode=True
import argparse,contextlib,fcntl,hashlib,importlib.machinery,importlib.util,json,os,pwd,re,stat,subprocess
from pathlib import Path
HOME=Path(pwd.getpwuid(os.getuid()).pw_dir)
CONTROL=HOME/'AIDev/control'
SOURCE_PATH=Path(__file__).absolute()
HUB=HOME/'Library/Application Support/Adapted Games'
DS3=HOME/'Library/Application Support/Adapted Games DS3'
CS2=HOME/'Library/Application Support/CS2 Standalone'
GAMES=HOME/'Games';BIN=HOME/'AIDev/bin';STATE=HOME/'AIDev/state'
CANDIDATE=STATE/'game-launch-reliability-candidate'
POLICY='manifests/game-launch-reliability.json'
NATIVE_POLICY='manifests/game-app-launcher-errors.json'
NAMESPACE='game-launch-reliability'
ARCHIVES='game-launch-reliability-archives'
ARCHIVE_OWNER=b'{"schema":1,"owner":"control-games-hub","purpose":"game-launch-reliability-archives"}\n'
OWNER=b'{"schema":1,"owner":"control-games-hub","purpose":"game-launch-reliability"}\n'
APPS=('CS2.app','Prince — Ubisoft Connect.app','Steam — другие игры.app','Dark Souls III.app')
TARGETS={'helper':'aid-bin/game-launch-admission','hub.launcher':'hub/games-play','cs2.launcher':'cs2/cs2-play','ds3.lifecycle':'ds3/ds3-runtime'}
TARGETS.update({'native-'+str(i):'games/'+name+'/Contents/MacOS/launcher' for i,name in enumerate(APPS)})
TARGETS.update({'hub.receipt':'hub/receipt.json','ds3.receipt':'ds3/receipt.json','cs2.receipt':'cs2/runtime/.owner.json'})
ORDER=tuple(TARGETS)
SOURCES={'helper':'bin/game-launch-admission','hub.launcher':'bin/games-play','cs2.launcher':'bin/cs2-play','ds3.lifecycle':'bin/ds3-runtime'}
LIBRARY_SOURCES={'lib/game_operation_readiness.py','lib/operation_readiness.py'}
CANDIDATE_FILES={'helper':'game-launch-admission','hub.launcher':'games-play','cs2.launcher':'cs2-play','ds3.lifecycle':'ds3-runtime'}
CANDIDATE_FILES.update({'native-'+str(i):name+'/Contents/MacOS/launcher' for i,name in enumerate(APPS)})
GUARDS={'hub/manifest.json','ds3/manifest.json','cs2/runtime/.manifest.json','ds3/ds3-play',
        'ds3/borderless/manifest.json','ds3/borderless/receipt.json','ds3/borderless/helper.exe',
        'ds3/borderless/helper.c','ds3/borderless/build-provenance.json','ds3/borderless/final-fixture-results.json'}
GUARDS.update('games/'+name+'/'+rel for name in APPS for rel in ('Contents/Info.plist','Contents/Resources/Game.icns'))
FIELDS={'schema','id','owner','nativePolicySha256','previousNativePolicySha256','sourceFiles','previousFiles','desiredFiles','guards','servers'}
class Blocked(RuntimeError):pass
def need(ok,reason):
    if not ok:raise Blocked(reason)
def digest(raw):return hashlib.sha256(raw).hexdigest()
def encode(value):return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False)+'\n').encode()
def pin(value,n=64):return type(value) is str and re.fullmatch('[0-9a-f]{'+str(n)+'}',value) is not None
def decode(raw):
    need(len(raw)<=1024*1024,'metadata_limit')
    def pairs(rows):
        value={}
        for k,v in rows:need(k not in value,'duplicate_json_key');value[k]=v
        return value
    try:return json.loads(raw,object_pairs_hook=pairs)
    except (ValueError,UnicodeError,RecursionError):raise Blocked('invalid_json') from None
def command(argv,timeout=120,env=None):
    result=subprocess.run([str(x) for x in argv],capture_output=True,timeout=timeout,env=env)
    need(result.returncode==0 and len(result.stdout)<=2*1024*1024,'command_failed_'+Path(argv[0]).name)
    return result.stdout

def source_check(commit):
    need(os.getuid()>0 and os.getuid()==os.geteuid(),'owner_required')
    need(SOURCE_PATH==CONTROL/'bin/game-launch-reliability-update','canonical_source_required');need(pin(commit,40),'invalid_commit')
    git=['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL]
    need(command(git+['rev-parse','HEAD']).decode().strip()==commit and command(git+['branch','--show-current']).decode().strip()=='main'
         and command(git+['status','--porcelain']).decode().strip()=='','clean_exact_main_required')

def operation_ready(commit,operation,checks,target_guard):
    loader=importlib.machinery.SourceFileLoader('game_scoped_ready',str(CONTROL/'lib/game_operation_readiness.py'))
    module=importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name,loader));loader.exec_module(module)
    return module.ready(CONTROL,commit,operation,checks=checks,target_guard=target_guard)

def source_gate(commit,root=None,value=None,action='apply'):
    source_check(commit);need(root is not None and value is not None,'operation_targets_required')
    before={rel:read(root,rel) for rel in TARGETS.values()}
    def held():
        root.bound();root._operation_lock_check()
        return all(read(root,rel)==image for rel,image in before.items())
    def owner():
        current,_,_=policy(root);need(current==value,'operation_policy_drift');guards(root,value)
        for rel,expected in (('hub/receipt.json','control-games-hub'),('ds3/receipt.json','control-ds3-marshal-fix'),('cs2/runtime/.owner.json','control-cs2-standalone')):
            need(decode(root.read(rel)[0]).get('owner')==expected,'operation_payload_owner')
        return True
    def recovery():
        state=root.anchors['state']
        if state.exists(NAMESPACE):
            need(state.read(NAMESPACE+'/owner.json')==(OWNER,0o600),'state_namespace_collision')
            with state.parent(NAMESPACE+'/.unused') as (fd,_,check):
                need(set(os.listdir(fd))<={'owner.json','transaction'},'state_namespace_drift');check()
            if action!='archive-settled' and root.exists('state/transaction/journal.json'):
                raw=root.read('state/transaction/journal.json')[0]
                plan_raw=root.read('state/transaction/plan.json')[0];plan_sha=digest(plan_raw)
                try:decode(raw)
                except Blocked:
                    prepared=encode({'schema':1,'planSha256':plan_sha,'phase':'prepared','intent':None})
                    need(action=='apply' and prepared.startswith(raw),'staging_unknown_drift');predecessor(root,value,{key:before[rel] for key,rel in TARGETS.items()})
                else:
                    old_plan=decode(plan_raw)
                    need(old_plan.get('acceptedCommit')==commit,'previous_settled_transaction_archive_required')
                    _,native,policy_sha=policy(root);tx=Transaction(root,plan_sha,commit,value,native,policy_sha)
                    for key,rel in TARGETS.items():need(read(root,rel) in tuple(tx.images[key].values()),'target_unknown_drift')
        return True
    checks={'payload-owner':owner,'recovery':recovery}
    if action not in ('recover','rollback','archive-settled'):checks['wine-target']=lambda: (inactive(root,value) is None)
    result=operation_ready(commit,'wine-recovery' if action in ('recover','rollback','archive-settled') else 'wine-install',checks,held)
    need(result.get('scopedCandidateReady') is True,'scoped_operation_readiness_required');source_check(commit)

def engine():
    loader=importlib.machinery.SourceFileLoader('launch_descriptor_engine',str(CONTROL/'bin/wine-runtime-overlay'))
    spec=importlib.util.spec_from_loader(loader.name,loader);module=importlib.util.module_from_spec(spec);loader.exec_module(module);return module

def anchor(e,path):
    obj=object.__new__(e.Root);obj.path=path;obj.chain=[];fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY)
    obj.chain.append((None,None,fd,e.identity(os.fstat(fd))))
    try:
        for part in path.parts[1:]:
            parent=fd;fd=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent);facts=os.fstat(fd)
            need(facts.st_uid in (0,os.getuid()) and not facts.st_mode&0o022,'unsafe_fixed_root')
            obj.chain.append((parent,part,fd,e.identity(facts)))
        obj.fd=fd;need(os.fstat(fd).st_uid==os.getuid(),'foreign_fixed_root');return obj
    except BaseException:obj.close();raise

def make_root(e):
    class LiveRoot(e.Root):
        def __init__(self):
            self.anchors={}
            try:
                for key,path in (('hub',HUB),('ds3',DS3),('cs2',CS2),('games',GAMES),('aid-bin',BIN),('state',STATE),('candidate',CANDIDATE),('source',CONTROL)):
                    self.anchors[key]=anchor(e,path)
            except BaseException:self.close();raise
        def close(self):
            for root in self.anchors.values():root.close()
            self.anchors={}
        def bound(self):
            for root in self.anchors.values():root.bound()
        @contextlib.contextmanager
        def parent(self,rel):
            self.bound();base,inner=rel.split('/',1)
            need(base in self.anchors,'unsupported_root')
            if base=='state' and inner.startswith('transaction'):inner=NAMESPACE+'/'+inner
            elif base=='state' and inner=='owner.json':inner=NAMESPACE+'/owner.json'
            with self.anchors[base].parent(inner) as opened:yield opened
        def exists(self,rel):
            try:return super().exists(rel)
            except FileNotFoundError:return False
        def namespace(self):
            state=self.anchors['state']
            if state.exists(NAMESPACE):need(state.read(NAMESPACE+'/owner.json')[0]==OWNER,'state_namespace_collision')
            else:state.mkdir(NAMESPACE);state.write_new(NAMESPACE+'/owner.json',OWNER)
            with state.parent(NAMESPACE+'/.unused') as (fd,_,check):need(set(os.listdir(fd))<={'owner.json','transaction'},'state_namespace_drift');check()
    return LiveRoot()

def read(root,rel):return root.read(rel) if root.exists(rel) else None
def image(value):return None if value is None else {'sha256':digest(value[0]),'mode':value[1]}
def image_schema(value,absent=False):
    need(absent and value is None or type(value) is dict and set(value)=={'sha256','mode'} and pin(value['sha256']) and type(value['mode']) is int
         and 0<=value['mode']<=0o777 and not value['mode']&0o022,'image_schema')

def policy(root):
    raw=root.read('source/'+POLICY)[0];value=decode(raw)
    need(type(value) is dict and type(value.get('schema')) is int and value['schema'] in (1,2)
         and set(value)==(FIELDS if value['schema']==1 else FIELDS|{'receiptPreimages'})
         and value['id']=='game-launch-reliability' and value['owner']=='control-games-hub','policy_schema')
    if value['schema']==2:need(value['receiptPreimages']=='observed-owned','receipt_preimage_policy')
    need(pin(value['nativePolicySha256']) and pin(value['previousNativePolicySha256']),'native_policy_pin')
    need(type(value['previousFiles']) is dict and set(value['previousFiles'])==set(TARGETS),'previous_scope')
    need(type(value['desiredFiles']) is dict and set(value['desiredFiles'])==set(CANDIDATE_FILES),'desired_scope')
    need(type(value['sourceFiles']) is dict and set(value['sourceFiles'])==set(SOURCES.values())|{'bin/game-app-launcher.m'}|LIBRARY_SOURCES and all(pin(p) for p in value['sourceFiles'].values()),'source_scope')
    for key,row in value['previousFiles'].items():image_schema(row,absent=(key=='helper'))
    for row in value['desiredFiles'].values():image_schema(row)
    need(type(value['guards']) is dict and set(value['guards'])==GUARDS and type(value['servers']) is dict and set(value['servers'])=={'hub','ds3','cs2'},'guard_schema')
    for row in value['guards'].values():image_schema(row)
    for key,row in value['servers'].items():image_schema(row)
    need(any(digest(root.read('source/'+path)[0])==value['previousNativePolicySha256'] for path in ('manifests/game-app-launchers.json',NATIVE_POLICY)),'predecessor_native_policy_binding')
    native_raw=root.read('source/'+NATIVE_POLICY)[0];native=decode(native_raw)
    need(digest(native_raw)==value['nativePolicySha256'] and type(native) is dict and type(native.get('schema')) is int and native['schema']==1
         and native.get('owner')=='control-game-app-launchers' and type(native.get('builtApps')) is dict and set(native['builtApps'])==set(APPS),'native_policy_binding')
    need(native.get('sourceSha256')==value['sourceFiles']['bin/game-app-launcher.m'],'native_source_binding')
    for i,name in enumerate(APPS):
        need(native['builtApps'][name]['Contents/MacOS/launcher']==value['desiredFiles']['native-'+str(i)],'native_executable_binding')
        for rel in ('Contents/Info.plist','Contents/Resources/Game.icns'):
            need(value['guards'].get('games/'+name+'/'+rel)==native['builtApps'][name][rel],'native_opaque_guard')
    for rel,expected in value['sourceFiles'].items():need(digest(root.read('source/'+rel)[0])==expected,'source_payload_drift')
    for key,rel in CANDIDATE_FILES.items():need(image(root.read('candidate/'+rel))==value['desiredFiles'][key],'candidate_drift')
    for key,rel in SOURCES.items():need(value['desiredFiles'][key]['sha256']==value['sourceFiles'][rel],'source_candidate_disagreement')
    return value,native,digest(raw)

def guards(root,value):
    for rel,expected in value['guards'].items():need(image(root.read(rel))==expected,'guard_drift')
    for name,base,target in (('games-play',HUB,'games-play'),('ds3-play',DS3,'ds3-play'),('cs2-play',CS2,'cs2-play')):
        with root.parent('aid-bin/'+name) as (fd,leaf,check):
            facts=os.stat(leaf,dir_fd=fd,follow_symlinks=False)
            need(stat.S_ISLNK(facts.st_mode) and facts.st_uid==os.getuid() and os.readlink(leaf,dir_fd=fd)==str(base/target),'resolver_drift');check()

def inactive(root,value):
    need(not root.exists('state/game-launch-pending.json'),'launch_reservation_pending')
    for name,base,prefix in (('hub',HUB,HUB/'profiles/prince'),('ds3',DS3,DS3/'profiles/ds3'),('cs2',CS2,CS2/'prefix')):
        server=base/'runtime/engine/bin/wineserver'
        need(image(root.read(name+'/runtime/engine/bin/wineserver'))==value['servers'][name],'unchanged_server_drift')
        rel=name+('/prefix/.unused' if name=='cs2' else '/profiles/'+prefix.name+'/.unused')
        with root.parent(rel) as (fd,_,check):
            facts=os.fstat(fd);need(facts.st_uid==os.getuid() and not facts.st_mode&0o077,'prefix_not_private');check()
        env={'HOME':str(HOME),'PATH':'/usr/bin:/bin:/usr/sbin:/sbin','LANG':'en_US.UTF-8','WINEPREFIX':str(prefix),'WINESERVER':str(server),
             'DYLD_FALLBACK_LIBRARY_PATH':str(base/'runtime/Frameworks')+':/usr/lib'}
        try:command([server,'-w'],timeout=3,env=env)
        except subprocess.TimeoutExpired:raise Blocked('prefix_active') from None

def gate(root,commit,value):source_gate(commit,root,value);guards(root,value);inactive(root,value)

def local_gate(root,commit,value):
    root._operation_lock_check()
    source_check(commit)
    current,_,_=policy(root)
    need(current==value,'operation_policy_drift')
    guards(root,value);inactive(root,value)

@contextlib.contextmanager
def locks(root):
    held=[];bindings=[]
    try:
        # Same order as CS2 launcher: existing local lock before shared lock.
        for rel in ('cs2/.launcher.lock','state/games-hub.lock'):
            with root.parent(rel) as (fd,name,check):
                lock=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd);held.append(lock);facts=os.fstat(lock)
                need(stat.S_ISREG(facts.st_mode) and facts.st_uid==os.getuid() and facts.st_nlink==1 and not facts.st_mode&0o077,'unsafe_lock')
                try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
                except BlockingIOError:raise Blocked('launcher_busy') from None
                check();need(os.stat(name,dir_fd=fd,follow_symlinks=False).st_ino==facts.st_ino,'lock_binding_drift')
                def binding(rel=rel,ino=facts.st_ino):
                    with root.parent(rel) as (parent,leaf,bound):
                        bound();need(os.stat(leaf,dir_fd=parent,follow_symlinks=False).st_ino==ino,'lock_binding_drift')
                bindings.append(binding)
        def bound():
            for binding in bindings:binding()
        root._operation_lock_check=bound
        try:yield;bound()
        finally:del root._operation_lock_check
    finally:
        for fd in reversed(held):os.close(fd)

def receipts(before,value,native,commit):
    out={}
    for key in ('hub.receipt','ds3.receipt','cs2.receipt'):
        current=decode(before[key][0]);need(type(current) is dict,'receipt_schema')
        if key=='cs2.receipt':
            need(type(current.get('schemaVersion')) is int and current['schemaVersion']==1 and current.get('owner')=='control-cs2-standalone'
                 and current.get('launcherSha256')==value['previousFiles']['cs2.launcher']['sha256'],'cs2_receipt_preimage')
            wanted=dict(current,launcherSha256=value['desiredFiles']['cs2.launcher']['sha256'],launcherCommit=commit)
        else:
            names=[name for name in APPS if (name=='Dark Souls III.app')==(key=='ds3.receipt')]
            need(type(current.get('schema')) is int and current['schema']==1 and current.get('owner')==('control-games-hub' if key=='hub.receipt' else 'control-ds3-marshal-fix')
                 and current.get('appPolicySha256')==value['previousNativePolicySha256'],'app_receipt_preimage')
            wanted=dict(current,appLaunchers={name:native['builtApps'][name] for name in names},appPolicySha256=value['nativePolicySha256'],appCommit=commit)
            field,source=('launcherSha256','hub.launcher') if key=='hub.receipt' else ('lifecycleSha256','ds3.lifecycle')
            need(current.get(field)==value['previousFiles'][source]['sha256'],'launcher_receipt_preimage')
            wanted[field]=value['desiredFiles'][source]['sha256']
            if key=='hub.receipt':wanted['launchAdmissionSha256']=value['desiredFiles']['helper']['sha256'];wanted['launchReliabilityCommit']=commit
        out[key]=(encode(wanted),0o600)
    return out

def plan(root,commit,value,native,policy_sha):
    before={key:read(root,rel) for key,rel in TARGETS.items()}
    predecessor(root,value,before)
    after={key:root.read('candidate/'+rel) for key,rel in CANDIDATE_FILES.items()};after.update(receipts(before,value,native,commit))
    result={'schema':1,'kind':'game-launch-reliability','acceptedCommit':commit,'policySha256':policy_sha,
            'targets':{key:{'before':image(before[key]),'after':image(after[key])} for key in ORDER}}
    return result,before,after

def predecessor(root,value,before):
    observed=value['schema']==2
    receipt_keys={'hub.receipt','ds3.receipt','cs2.receipt'}
    need(all(image(before[key])==value['previousFiles'][key] for key in TARGETS if not observed or key not in receipt_keys),'predecessor_drift')
    if not observed:return
    previous_native=None
    for path in ('manifests/game-app-launchers.json',NATIVE_POLICY):
        raw=root.read('source/'+path)[0]
        if digest(raw)==value['previousNativePolicySha256']:previous_native=decode(raw);break
    need(type(previous_native) is dict and type(previous_native.get('builtApps')) is dict,'previous_native_inventory')
    for key,owner,field,payload,guard in (
        ('hub.receipt','control-games-hub','launcherSha256','hub.launcher','hub/manifest.json'),
        ('ds3.receipt','control-ds3-marshal-fix','lifecycleSha256','ds3.lifecycle','ds3/manifest.json'),
        ('cs2.receipt','control-cs2-standalone','launcherSha256','cs2.launcher','cs2/runtime/.manifest.json')):
        need(before[key] is not None and before[key][1]==0o600,'receipt_preimage_mode')
        receipt=decode(before[key][0]);schema='schemaVersion' if key=='cs2.receipt' else 'schema'
        need(type(receipt) is dict and type(receipt.get(schema)) is int and receipt[schema]==1
             and receipt.get('owner')==owner and receipt.get(field)==value['previousFiles'][payload]['sha256']
             and receipt.get('manifestSha256')==value['guards'][guard]['sha256'],'owned_receipt_preimage')
        if key!='cs2.receipt':
            names=[name for name in APPS if (name=='Dark Souls III.app')==(key=='ds3.receipt')]
            need(receipt.get('appPolicySha256')==value['previousNativePolicySha256']
                 and receipt.get('appLaunchers')=={name:previous_native['builtApps'][name] for name in names},'app_receipt_preimage')

def partial_write(root,rel,wanted):
    if root.exists(rel):
        current=root.read(rel);need(current[1]==wanted[1] and wanted[0].startswith(current[0]),'staging_unknown_drift')
        if current==wanted:return
        with root.parent(rel) as (fd,name,check):check();os.unlink(name,dir_fd=fd);os.fsync(fd)
    root.write_new(rel,*wanted)

def stage(root,p,before,after):
    root.namespace()
    if not root.exists('state/transaction'):root.mkdir('state/transaction')
    expected={'plan.json','journal.json'}|{key+'.'+side for key in ORDER for side,images in (('before',before),('after',after)) if images[key] is not None}
    with root.parent('state/transaction/.unused') as (fd,_,check):need(set(os.listdir(fd))<=expected,'staging_inventory_drift');check()
    for key in ORDER:
        for side,images in (('before',before),('after',after)):
            if images[key] is not None:partial_write(root,'state/transaction/'+key+'.'+side,images[key])
    raw=encode(p);partial_write(root,'state/transaction/plan.json',(raw,0o600))
    partial_write(root,'state/transaction/journal.json',(encode({'schema':1,'planSha256':digest(raw),'phase':'prepared','intent':None}),0o600))

def swap(root,rel,wanted,expected,event=lambda _:None,before_publish=lambda:None):
    need(read(root,rel)==expected,'target_changed_before_replace')
    if wanted==expected:return
    if wanted is None:
        with root.parent(rel) as (fd,name,check):check();need(read(root,rel)==expected,'target_changed_before_replace');event('before-replace:'+rel);before_publish();check();need(read(root,rel)==expected,'target_changed_before_replace');os.unlink(name,dir_fd=fd);os.fsync(fd)
    else:
        stage_rel=root.stage_name(rel)
        if root.exists(stage_rel):need(root.read(stage_rel)==wanted,'replacement_stage_drift')
        else:root.write_new(stage_rel,*wanted)
        event('staged:'+rel)
        with root.parent(rel) as (fd,name,check),root.parent(stage_rel) as (staged_fd,staged_name,staged_check):
            check();staged_check();need(read(root,rel)==expected,'target_changed_before_replace');event('before-replace:'+rel);before_publish();check();staged_check()
            need(read(root,rel)==expected and root.read(stage_rel)==wanted,'target_changed_before_replace')
            need(os.fstat(fd).st_dev==os.fstat(staged_fd).st_dev,'cross_device_stage')
            os.replace(staged_name,name,src_dir_fd=staged_fd,dst_dir_fd=fd);os.fsync(fd);os.fsync(staged_fd)
    event('replaced:'+rel)

class Transaction:
    def __init__(self,root,expected,commit,value,native,policy_sha,event=lambda _:None):
        need(pin(expected),'plan_pin_required');self.root=root;self.sha=expected;self.commit=commit;self.value=value;self.native=native;self.policy_sha=policy_sha;self.event=event
        raw,_=root.read('state/transaction/plan.json');need(digest(raw)==expected,'plan_binding_drift');self.plan=decode(raw)
        p=self.plan;need(type(p) is dict and set(p)=={'schema','kind','acceptedCommit','policySha256','targets'} and type(p['schema']) is int and p['schema']==1
                        and p['kind']=='game-launch-reliability' and p['acceptedCommit']==commit and p['policySha256']==policy_sha
                        and type(p['targets']) is dict and set(p['targets'])==set(TARGETS),'plan_schema')
        self.images={};before={};after={}
        for key in ORDER:
            row=p['targets'][key];need(type(row) is dict and set(row)=={'before','after'},'target_schema');self.images[key]={}
            if value['schema']==1 or key not in {'hub.receipt','ds3.receipt','cs2.receipt'}:
                need(row['before']==value['previousFiles'][key],'predecessor_plan_drift')
            for side in ('before','after'):
                image_schema(row[side],absent=(key=='helper' and side=='before'))
                rel='state/transaction/'+key+'.'+side
                data=None if row[side] is None else root.read(rel)
                need(image(data)==row[side],'backup_drift');self.images[key][side]=data
            before[key]=self.images[key]['before'];after[key]=self.images[key]['after']
        expected_receipts=receipts(before,value,native,commit)
        predecessor(root,value,before)
        for key in ORDER:
            wanted=expected_receipts[key] if key in expected_receipts else root.read('candidate/'+CANDIDATE_FILES[key])
            need(after[key]==wanted,'afterimage_source_relation')
        self.journal()

    def journal(self):
        value=decode(self.root.read('state/transaction/journal.json')[0])
        need(type(value) is dict and set(value)=={'schema','planSha256','phase','intent'} and type(value['schema']) is int and value['schema']==1 and value['planSha256']==self.sha
             and value['phase'] in ('prepared','applying','applied','rolling-back','rolled-back') and value['intent'] in (None,*ORDER),'journal_schema')
        return value

    def checkpoint(self,phase,intent=None):
        rel='state/transaction/journal.json';old=self.root.read(rel)
        wanted=(encode({'schema':1,'planSha256':self.sha,'phase':phase,'intent':intent}),0o600)
        swap(self.root,rel,wanted,old,self.event);self.event('journal:'+phase+(':'+intent if intent else ''))

    def reconcile_journal_stage(self):
        rel='state/transaction/journal.json';stage_rel=self.root.stage_name(rel)
        if not self.root.exists(stage_rel):return
        current=self.journal();raw,mode=self.root.read(stage_rel);pending=decode(raw)
        transitions={'prepared':{'applying','applied','rolled-back'},'applying':{'applying','applied'},'applied':{'rolling-back'},'rolling-back':{'rolling-back','rolled-back'},'rolled-back':{'applying'}}
        need(type(pending) is dict and set(pending)==set(current) and type(pending['schema']) is int and pending['schema']==1
             and pending['planSha256']==self.sha and type(pending['phase']) is str and pending['phase'] in transitions[current['phase']] and pending['intent'] in (None,*ORDER) and mode==0o600,'journal_stage_drift')
        if pending['phase'] in ('applied','rolled-back'):
            need(pending['intent'] is None and self.side('after' if pending['phase']=='applied' else 'before'),'journal_terminal_drift')
        swap(self.root,rel,(raw,mode),self.root.read(rel),self.event)

    def check_gate(self):gate(self.root,self.commit,self.value)

    def verify(self):
        self.check_gate()
        expected={'plan.json','journal.json'}|{key+'.'+side for key in ORDER for side in ('before','after') if self.images[key][side] is not None}
        stages={Path(self.root.stage_name(rel)).name for rel in (*TARGETS.values(),'state/transaction/journal.json')}
        with self.root.parent('state/transaction/.unused') as (fd,_,check):
            observed=set(os.listdir(fd));need(expected<=observed and observed<=expected|stages,'transaction_inventory_drift');check()
        for key,rel in TARGETS.items():
            need(read(self.root,rel) in tuple(self.images[key].values()),'target_unknown_drift')
            staged=self.root.stage_name(rel)
            if self.root.exists(staged):need(self.root.read(staged) in tuple(v for v in self.images[key].values() if v is not None),'replacement_stage_drift')
            for side in ('before','after'):
                if self.images[key][side] is not None:need(self.root.read('state/transaction/'+key+'.'+side)==self.images[key][side],'backup_drift')
        self.journal()

    def side(self,side):return all(read(self.root,rel)==self.images[key][side] for key,rel in TARGETS.items())

    def run(self,side,recover=False):
        self.verify();current=self.journal();stage_rel=self.root.stage_name('state/transaction/journal.json')
        if recover:
            if self.root.exists(stage_rel):self.reconcile_journal_stage();current=self.journal()
            need(current['phase'] in ('applying','rolling-back','applied','rolled-back'),'no_interrupted_transaction')
            side='after' if current['phase'] in ('applying','applied') else 'before'
        else:
            need(not self.root.exists(stage_rel) and current['phase'] not in ('applying','rolling-back'),'explicit_recovery_required')
        start,end=('applying','applied') if side=='after' else ('rolling-back','rolled-back')
        if self.side(side):
            if current['phase']!=end:self.checkpoint(end)
            return {'state':end.upper(),'changed':False,'liveStateChanged':False,'installedAcceptanceClaimed':False,'validationScope':'launch-closure-and-declared-guards','runtimeHealthClaimed':False,'sourceRollbackSuccessorRequired':side=='before'}
        if not recover:need(self.side('before' if side=='after' else 'after'),'mixed_state_requires_recovery')
        self.checkpoint(start)
        try:
            for key in (ORDER if side=='after' else tuple(reversed(ORDER))):
                observed=read(self.root,TARGETS[key]);wanted=self.images[key][side]
                if observed==wanted:continue
                self.verify();self.checkpoint(start,key)
                swap(self.root,TARGETS[key],wanted,observed,self.event,before_publish=self.check_gate)
            self.verify();need(self.side(side),'postimage_mismatch');self.checkpoint(end)
        except Exception:
            # Keep durable direction and every exact backup. Explicit recovery
            # follows that direction; no unverified automatic rollback occurs.
            raise
        return {'state':end.upper(),'changed':True,'liveStateChanged':True,'installedAcceptanceClaimed':False,
                'sourceRollbackSuccessorRequired':side=='before','validationScope':'launch-closure-and-declared-guards','runtimeHealthClaimed':False}

def renderer_successor(root,commit,old_commit):
    """Read-only exact six-target renderer closure; return its proven preimage view."""
    renderer_encode=lambda value:(json.dumps(value,indent=2)+'\n').encode()
    manifest=decode(root.read('ds3/manifest.json')[0]);override=manifest.get('rendererOverride')
    if override is None:return root,None
    e=engine()
    override_fields={'d3d11Sha256','provenanceSha256','policySha256','transactionCommit','diagnosticCapable'}
    need(type(override) is dict and set(override) in (override_fields,override_fields|{'nativeBorderlessCapable','traceProtocolVersion'})
         and all(pin(override.get(k)) for k in ('d3d11Sha256','provenanceSha256','policySha256'))
         and type(override.get('diagnosticCapable')) is bool
         and ('nativeBorderlessCapable' not in override or type(override['nativeBorderlessCapable']) is bool)
         and ('traceProtocolVersion' not in override or type(override['traceProtocolVersion']) is int and override['traceProtocolVersion']==2)
         and manifest.get('schema')==4 and pin(override.get('transactionCommit'),40),'renderer_successor_override')
    revision=override['transactionCommit'];git=['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL]
    common=command(git+['merge-base',old_commit,revision]).decode().strip()
    need(common in (old_commit,revision),'renderer_successor_ancestry')
    command(git+['merge-base','--is-ancestor',revision,commit])
    base='ds3/.renderer-'+revision
    with root.parent('ds3/.unused') as (fd,_,check):
        names=os.listdir(fd);transactions=[n for n in names if n.startswith('.renderer-')]
        need(len(transactions)<=8 and not any(n.startswith('.ds3-renderer-') for n in names),'renderer_successor_pending_inventory')
        for name in transactions:
            need(re.fullmatch(r'\.renderer-[0-9a-f]{40}',name) is not None,'renderer_successor_transaction_name')
            other,other_mode=root.read('ds3/'+name+'/record.json');value=e.decode(other,limit=32*1024*1024)
            need(other_mode==0o600 and type(value) is dict and value.get('phase')=='complete' and value.get('intent') is None,'renderer_successor_pending')
        check()
    # A previous launch generation may already include this renderer. Its
    # unchanged endpoints are bound by the historical overlay below; rewinding
    # that baseline would discard the generation being proved.
    if revision!=old_commit and common==revision:
        for rel,wanted_mode in (('ds3/runtime/engine/lib/wine/x86_64-windows/d3d11.dll',0o755),
                                ('ds3/profiles/ds3/drive_c/windows/system32/d3d11.dll',0o644)):
            data,mode=root.read(rel)
            need(mode==wanted_mode and digest(data)==override['d3d11Sha256'],'renderer_baseline_pair_drift')
        root.bound();root._operation_lock_check()
        return root,None
    raw,mode=root.read(base+'/record.json');need(mode==0o600,'renderer_successor_record_mode')
    record=e.decode(raw,limit=32*1024*1024)
    targets={'runtime':'ds3/runtime/engine/lib/wine/x86_64-windows/d3d11.dll',
             'prefix':'ds3/profiles/ds3/drive_c/windows/system32/d3d11.dll',
             'manifest':'ds3/manifest.json','borderless':'ds3/borderless/manifest.json',
             'borderlessReceipt':'ds3/borderless/receipt.json','receipt':'ds3/receipt.json'}
    need(type(record) is dict and set(record)=={'schema','commit','policy','images','treeRows','phase','direction','intent'}
         and type(record['schema']) is int and record['schema']==1 and record['commit']==revision
         and record['phase']=='complete' and record['direction']=='after' and record['intent'] is None
         and type(record['images']) is dict and set(record['images'])==set(targets),'renderer_successor_record')
    policy=record['policy'];source_names={'d3d11.dll','source.tar.gz','provenance.json'}
    policy_fields={'schema','id','owner','previousRendererSha256','candidateFiles','diagnosticCapable'}
    need(type(policy) is dict and type(policy.get('schema')) is int and policy['schema'] in (1,2)
         and set(policy)==(policy_fields|{'nativeBorderlessCapable','traceProtocolVersion'} if policy['schema']==2 else policy_fields)
         and (policy['schema']==1 or type(policy['nativeBorderlessCapable']) is bool) and policy['id']=='ds3-renderer-update'
         and (policy['schema']==1 or type(policy['traceProtocolVersion']) is int and policy['traceProtocolVersion']==2)
         and policy['owner']=='control-ds3-marshal-fix' and pin(policy['previousRendererSha256'])
         and type(policy['candidateFiles']) is dict and set(policy['candidateFiles'])==source_names
         and all(pin(h) for h in policy['candidateFiles'].values()) and type(policy['diagnosticCapable']) is bool,
         'renderer_successor_policy')
    historical=command(git+['show',revision+':manifests/ds3-renderer-update.json'])
    need(renderer_encode(decode(historical))==renderer_encode(policy),'renderer_successor_source_binding')
    for rel,names in ((base,{'record.json','source'}|{k+'.'+s for k in targets for s in ('before','after')}),(base+'/source',source_names)):
        with root.parent(rel+'/.unused') as (fd,_,check):
            facts=os.fstat(fd);need(facts.st_uid==os.getuid() and stat.S_IMODE(facts.st_mode)==0o700 and set(os.listdir(fd))==names,'renderer_successor_inventory');check()
    files={}
    for name in source_names:
        data,mode=root.read(base+'/source/'+name);need(mode==0o600 and digest(data)==policy['candidateFiles'][name],'renderer_successor_candidate');files[name]=data
    provenance=decode(files['provenance.json'])
    need(type(provenance) is dict and provenance.get('d3d11Sha256')==policy['candidateFiles']['d3d11.dll']
         and provenance.get('sourceArchiveSha256')==policy['candidateFiles']['source.tar.gz']
         and provenance.get('nativeBridgeModified') is False and provenance.get('diagnosticCapable')==policy['diagnosticCapable'],'renderer_successor_provenance')
    if policy['schema']==2:need(provenance.get('nativeBorderlessCapable') is policy['nativeBorderlessCapable'],'renderer_successor_borderless_provenance')
    if policy['schema']==2:need(type(provenance.get('traceProtocolVersion')) is int and provenance['traceProtocolVersion']==policy['traceProtocolVersion'],'renderer_successor_trace_protocol_provenance')
    images={side:{} for side in ('before','after')};modes={}
    for key,row in record['images'].items():
        need(type(row) is dict and set(row)=={'before','after','mode'} and type(row['mode']) is int
             and row['mode']==(0o755 if key=='runtime' else 0o644 if key=='prefix' else 0o600),'renderer_successor_image')
        modes[key]=row['mode']
        for side in images:
            data,mode=root.read(base+'/'+key+'.'+side)
            need(mode==0o600 and pin(row[side]) and digest(data)==row[side],'renderer_successor_backup');images[side][key]=data
        need(root.read(targets[key])==(images['after'][key],modes[key]),'renderer_successor_endpoint')
    old=decode(images['before']['manifest']);br=decode(images['before']['borderless'])
    receipt=decode(images['before']['receipt']);brr=decode(images['before']['borderlessReceipt'])
    need(old.get('schema')==4,'renderer_successor_predecessor_schema')
    rel='engine/lib/wine/x86_64-windows/d3d11.dll';previous=policy['previousRendererSha256'];desired=policy['candidateFiles']['d3d11.dll']
    prior=old.get('rendererOverride');prior_hash=old.get('sourceCriticalHashes',{}).get(rel)
    if prior is not None:
        need(type(prior) is dict and set(prior) in (override_fields,override_fields|{'nativeBorderlessCapable','traceProtocolVersion'})
             and all(pin(prior.get(k)) for k in ('d3d11Sha256','provenanceSha256','policySha256'))
             and ('nativeBorderlessCapable' not in prior or type(prior['nativeBorderlessCapable']) is bool)
             and ('traceProtocolVersion' not in prior or type(prior['traceProtocolVersion']) is int and prior['traceProtocolVersion']==2)
             and pin(prior.get('transactionCommit'),40) and type(prior.get('diagnosticCapable')) is bool,'renderer_successor_prior_override')
        # The retained launch/overlay generation already owns this renderer.
        # Rewind only its new successor, never an older baseline transaction.
        need(prior['transactionCommit']!=revision,'renderer_successor_prior_cycle')
        command(git+['merge-base','--is-ancestor',prior['transactionCommit'],old_commit])
        prior_hash=prior['d3d11Sha256']
    need(prior_hash==previous and digest(images['before']['runtime'])==digest(images['before']['prefix'])==previous,'renderer_successor_predecessor')
    rows=record['treeRows'];actual=e.tree_rows(root,'ds3/runtime')
    need(type(rows) is list and len(rows)==len(actual),'renderer_successor_rows')
    wanted_rows=[list(row) for row in actual];matches=[r for r in wanted_rows if r[0]==rel]
    need(len(matches)==1 and matches[0]==[rel,0o755,desired],'renderer_successor_rows')
    matches[0][2]=previous;need(wanted_rows==rows,'renderer_successor_rows')
    new_override={'d3d11Sha256':desired,'provenanceSha256':policy['candidateFiles']['provenance.json'],
                  'policySha256':digest(renderer_encode(policy)),'transactionCommit':revision,'diagnosticCapable':policy['diagnosticCapable']}
    if policy['schema']==2:new_override.update(nativeBorderlessCapable=policy['nativeBorderlessCapable'],traceProtocolVersion=policy['traceProtocolVersion'])
    wanted={'runtime':files['d3d11.dll'],'prefix':files['d3d11.dll'],'manifest':renderer_encode(dict(old,rendererOverride=new_override)),
            'borderless':renderer_encode(dict(br,nativeBinding=dict(br['nativeBinding'],d3d11Sha256=desired)))}
    tree=e.tree_hash(actual)
    wanted['receipt']=renderer_encode(dict(receipt,manifestSha256=digest(wanted['manifest']),runtimeTreeSha256=tree))
    wanted['borderlessReceipt']=renderer_encode(dict(brr,manifestSha256=digest(wanted['borderless']),baseManifestSha256=digest(wanted['manifest']),baseRuntimeTreeSha256=tree))
    need(wanted==images['after'] and override==new_override,'renderer_successor_derived_images')
    preimages={targets[key]:(data,modes[key]) for key,data in images['before'].items()}
    class PreimageView:
        def __getattr__(self,name):return getattr(root,name)
        def read(self,rel,**kwargs):return preimages[rel] if rel in preimages else root.read(rel,**kwargs)
    root.bound();root._operation_lock_check()
    return PreimageView(),{'commit':revision,'recordSha256':digest(raw),'receipt':image(root.read('ds3/receipt.json'))}


def downstream_overlay_proof(root,commit,old_commit,launch_plan):
    """Prove a bounded unique chain of retained applied overlays, without execution.

    Historical snapshots must link every target and full runtime tree into the
    next snapshot. Only the final snapshot is compared to installed endpoints.
    Prepared, rollback and ambiguous histories never supply a predecessor.
    """
    root,renderer=renderer_successor(root,commit,old_commit)
    e=engine();state=root.anchors['state'];root.bound();root._operation_lock_check()
    owner=b'{"schema":1,"owner":"control-games-hub","purpose":"wine-runtime-overlay"}\n'
    archives='wine-runtime-overlay-archives'
    archive_owner=b'{"schema":1,"owner":"control-games-hub","purpose":"wine-runtime-overlay-archives"}\n'
    git=['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL]
    def blob(revision,path):return command(git+['show',revision+':'+path])
    historical_launch=blob(old_commit,POLICY)
    need(digest(historical_launch)==launch_plan['policySha256'],'downstream_launch_policy_binding')
    launch_value=decode(historical_launch)
    need(launch_value.get('schema') in (1,2) and launch_value.get('id')=='game-launch-reliability'
         and launch_value.get('owner')=='control-games-hub'
         and set(launch_value.get('previousFiles',{}))==set(TARGETS)
         and set(launch_value.get('desiredFiles',{}))==set(CANDIDATE_FILES),'downstream_launch_policy_schema')
    historical_native=blob(old_commit,NATIVE_POLICY)
    need(digest(historical_native)==launch_value.get('nativePolicySha256'),'downstream_launch_native_binding')
    launch_before={key:read(root,'state/transaction/'+key+'.before') for key in TARGETS}
    launch_receipts=receipts(launch_before,launch_value,decode(historical_native),old_commit)
    for key,row in launch_plan['targets'].items():
        need(image(launch_before[key])==row['before'],'downstream_launch_before_backup')
        if launch_value['schema']==1 or key not in {'hub.receipt','ds3.receipt','cs2.receipt'}:
            need(row['before']==launch_value['previousFiles'][key],'downstream_launch_predecessor_binding')
        wanted=image(launch_receipts[key]) if key in launch_receipts else launch_value['desiredFiles'][key]
        need(row['after']==wanted,'downstream_launch_after_binding')
    def node(namespace,successor=None):
        need(state.read(namespace+'/owner.json')==(owner,0o600),'downstream_owner')
        with state.parent(namespace+'/.unused') as (fd,_,check):
            need(stat.S_IMODE(os.fstat(fd).st_mode)==0o700 and set(os.listdir(fd))=={'owner.json','transaction'},'downstream_namespace_inventory');check()
        raw,mode=state.read(namespace+'/transaction/plan.json')
        need(mode==0o600,'downstream_plan_mode');plan_raw=e.decode(raw,limit=e.MAX_PLAN_BYTES)
        need(type(plan_raw) is dict,'downstream_plan_schema')
        next_commit=plan_raw.get('acceptedCommit')
        need(pin(next_commit,40) and next_commit!=commit,'downstream_commit')
        same_launch_commit=next_commit==old_commit
        need(not same_launch_commit or successor is None and namespace=='wine-runtime-overlay'
             and plan_raw.get('kind')=='wine-runtime-installed-policy-overlay','downstream_same_commit_scope')
        need(command(git+['cat-file','-t',next_commit]).decode().strip()=='commit','downstream_commit_type')
        later=successor.plan['acceptedCommit'] if successor is not None else commit
        need(next_commit!=later,'downstream_chain_cycle')
        for before,after in ((old_commit,next_commit),(next_commit,later)):
            command(git+['merge-base','--is-ancestor',before,after])
        if successor is not None:
            need(namespace==archives+'/'+next_commit+'-'+digest(raw),'downstream_archive_binding')
        historical_policy=blob(next_commit,'manifests/wine-runtime-overlay.json')
        historical_source=blob(next_commit,'manifests/ds3-source-hub-v1.json')
        historical_lifecycle=blob(next_commit,'bin/ds3-runtime')
        class View:
            def __getattr__(self,name):return getattr(root,name)
            @contextlib.contextmanager
            def parent(self,rel):
                if rel.startswith('state/transaction'):
                    need(rel=='state/transaction' or rel.startswith('state/transaction/'),'downstream_state_path')
                    with state.parent(namespace+'/'+rel.split('/',1)[1]) as value:yield value
                else:
                    with root.parent(rel) as value:yield value
            def read(self,rel,**kwargs):
                if rel=='payload/policy.json':return historical_policy,root.read('source/manifests/wine-runtime-overlay.json')[1]
                if rel=='payload/source-hub-v1.json':return historical_source,root.read('source/manifests/ds3-source-hub-v1.json')[1]
                if not rel.startswith('state/transaction'):return root.read(rel,**kwargs)
                return e.Root.read(self,rel,**kwargs)
            def exists(self,rel):return e.Root.exists(self,rel)
        view=View();tx=e.Transaction(view,digest(raw),source_only=False)
        installed_policy=tx.plan['kind']=='wine-runtime-installed-policy-overlay'
        extended=installed_policy or tx.plan['kind']=='wine-winemac-oleacc-runtime-overlay'
        if same_launch_commit:
            need(all(e.image(*tx.images[key]['before'])==launch_plan['targets'][key]['after']
                     for key in ('ds3.lifecycle','hub.receipt','ds3.receipt')),'downstream_same_commit_link')
        need(extended or tx.plan['kind']=='wine-winemac-pe-pair-overlay','downstream_kind')
        journal=tx.journal()
        need(journal['phase']=='applied' and journal['intent'] is None
             and view.read('state/transaction/journal.json')[1]==0o600,'downstream_not_settled')
        inventory={'plan.json','journal.json'}|{key+'.'+side for key in tx.order for side in ('before','after')}
        with view.parent('state/transaction/.unused') as (fd,_,check):
            need(stat.S_IMODE(os.fstat(fd).st_mode)==0o700 and set(os.listdir(fd))==inventory,'downstream_transaction_inventory');check()
        for rel in (*tx.targets.values(),'state/transaction/journal.json'):
            need(not view.exists(e.Root.stage_name(rel)),'downstream_pending_stage')
        e.verify_images(view,tx.plan['guards'])
        if successor is None:
            need(tx.side('after'),'downstream_after_drift')
        else:
            need(set(tx.targets)<=set(successor.targets),'downstream_chain_scope')
            for key in tx.targets:
                need(tx.images[key]['after']==successor.images[key]['before'],'downstream_chain_images')
            for name in ('hub','ds3'):
                need(tx.plan['runtimeRows'][name]['after']==successor.plan['runtimeRows'][name]['before'],'downstream_chain_rows')
        policy=e.decode(historical_policy)
        need(type(policy) is dict and set(policy)==(e.EXTENDED_POLICY_FIELDS if extended else e.POLICY_FIELDS) and type(policy.get('schema')) is int
             and policy['schema']==(2 if extended else 1) and policy.get('id')=='wine-runtime-overlay'
             and policy.get('owner')=='control-games-hub','downstream_policy_schema')
        desired=policy['desiredRuntimeHashes' if extended else 'desiredPEHashes']
        need(type(desired) is dict and set(desired)==(set(e.RUNTIME_PAYLOADS) if extended else {e.PE32,e.PE}) and all(pin(x) for x in desired.values()),'downstream_runtime_scope')
        hm,hr,dm,dr,br=[e.decode(tx.images[key]['before'][0]) for key in ('hub.manifest','hub.receipt','ds3.manifest','ds3.receipt','ds3.borderless-receipt')]
        need(digest(tx.images['hub.manifest']['before'][0])==policy['previousHubManifestSha256']
             and digest(tx.images['ds3.manifest']['before'][0])==policy['previousDS3ManifestSha256']
             and hm.get('criticalHashes')==policy['previousHubCriticalHashes']
             and digest(historical_source)==policy['sourceHubManifestSha256']==dm.get('sourceHubManifestSha256')
             and e.decode(historical_source).get('criticalHashes')==policy['sourceCriticalHashes']==dm.get('sourceCriticalHashes'),
             'downstream_before_policy_binding')
        need(tx.images['ds3.lifecycle']['after'][0]==historical_lifecycle
             and digest(historical_lifecycle)==policy['lifecycleSha256'],'downstream_lifecycle_binding')
        for name in ('hub','ds3'):
            before_rows,after_rows=[tx.plan['runtimeRows'][name][side] for side in ('before','after')]
            wanted=[[row[0],row[1],desired[row[0]]] if row[0] in desired else row for row in before_rows]
            need(after_rows==wanted,'downstream_runtime_rows')
            if successor is None:need(e.tree_rows(view,name+'/runtime')==after_rows,'downstream_runtime_rows')
            for suffix,rel in ((('pe32',e.PE32),('pe64',e.PE),('unix',e.UNIX),('ole32',e.OLE32),('ole64',e.OLE64)) if extended else (('pe32',e.PE32),('pe64',e.PE))):
                key=name+'.'+suffix;old,new=tx.images[key]['before'],tx.images[key]['after']
                need(new[1]==old[1] and digest(new[0])==desired[rel]
                     and [rel,old[1],digest(old[0])] in before_rows,'downstream_runtime_images')
        wanted_hm=dict(hm,criticalHashes=dict(hm['criticalHashes'],**desired),runtimeOverlayPolicySha256=digest(historical_policy))
        if installed_policy:
            e.verify_policy_inventory(view)
            for key,wanted in (('ds3.policy-source',historical_policy),('ds3.source-hub',historical_source)):
                need(tx.images[key]['before'][1]==tx.images[key]['after'][1]==0o600
                     and tx.images[key]['after'][0]==wanted,'downstream_installed_policy_transition')
            class BeforePolicyView:
                def __getattr__(self,name):return getattr(view,name)
                def read(self,rel,**kwargs):
                    for key in ('ds3.policy-source','ds3.source-hub'):
                        if rel==tx.targets[key]:return tx.images[key]['before']
                    return view.read(rel,**kwargs)
            predecessor=None;launch_proof=None
            if dm.get('schema') in (3,4) and same_launch_commit:
                predecessor=launch_before['ds3.lifecycle'][0]
                # This proof is local to an exactly linked retained current
                # operation. It cannot authorize an arbitrary old helper.
                class HistoricalLaunchProof:
                    before_lifecycle=predecessor
                    installed_lifecycle=tx.images['ds3.lifecycle']['before'][0]
                    def revalidate(self):
                        root.bound();root._operation_lock_check()
                        launch_raw,launch_mode=root.read('state/transaction/plan.json')
                        need(launch_mode==0o600 and decode(launch_raw)==launch_plan,'downstream_launch_plan_drift')
                        j,jmode=root.read('state/transaction/journal.json')
                        need(jmode==0o600 and decode(j)=={'schema':1,'planSha256':digest(launch_raw),'phase':'applied','intent':None},'downstream_launch_not_settled')
                        for key in ('ds3.lifecycle','hub.receipt','ds3.receipt'):
                            need(read(root,'state/transaction/'+key+'.before')==launch_before[key]
                                 and image(read(root,'state/transaction/'+key+'.after'))==launch_plan['targets'][key]['after']
                                 and view.read('state/transaction/'+key+'.before')==tx.images[key]['before']
                                 and e.image(*tx.images[key]['before'])==launch_plan['targets'][key]['after'],'downstream_launch_proof_drift')
                launch_proof=HistoricalLaunchProof();launch_proof.revalidate()
            kwargs={'launch_proof':launch_proof} if dm.get('schema')==4 and launch_proof is not None else {}
            e.verify_policy_source(BeforePolicyView(),dm,hm,tx.images['ds3.lifecycle']['before'][0],predecessor,**kwargs)
        wanted_dm=dict(dm,schema=4 if installed_policy else 3 if extended else 2,runtimeOverrides=desired,runtimeOverlayPolicySha256=digest(historical_policy))
        for key,wanted in (('hub.manifest',wanted_hm),('ds3.manifest',wanted_dm)):
            need(tx.images[key]['after']==(e.encode(wanted),tx.images[key]['before'][1]),'downstream_manifest_transition')
        for name,receipt in (('hub',hr),('ds3',dr)):
            wanted=dict(receipt,commit=next_commit,manifestSha256=digest(tx.images[name+'.manifest']['after'][0]),
                        runtimeTreeSha256=e.tree_hash(tx.plan['runtimeRows'][name]['after']))
            if name=='ds3':wanted['lifecycleSha256']=policy['lifecycleSha256']
            need(tx.images[name+'.receipt']['after']==(e.encode(wanted),tx.images[name+'.receipt']['before'][1]),'downstream_receipt_transition')
        wanted_br=dict(br,commit=next_commit,baseManifestSha256=digest(tx.images['ds3.manifest']['after'][0]),
                       baseRuntimeTreeSha256=e.tree_hash(tx.plan['runtimeRows']['ds3']['after']))
        need(tx.images['ds3.borderless-receipt']['after']==(e.encode(wanted_br),tx.images['ds3.borderless-receipt']['before'][1]),'downstream_borderless_transition')
        return tx, {'commit':next_commit,'planSha256':digest(raw),
                    'journalSha256':digest(view.read('state/transaction/journal.json')[0])}
    current,proof=node('wine-runtime-overlay')
    shared={'ds3.lifecycle','hub.receipt','ds3.receipt'}
    endpoints={key:e.image(*current.images[key]['after']) for key in shared}
    chain=[proof];seen={proof['planSha256']}
    while any(e.image(*current.images[key]['before'])!=launch_plan['targets'][key]['after'] for key in shared):
        need(len(chain)<8,'downstream_chain_limit')
        need(state.read(archives+'/owner.json')==(archive_owner,0o600),'downstream_archive_owner')
        with state.parent(archives+'/.unused') as (fd,_,check):
            names=set(os.listdir(fd));need(stat.S_IMODE(os.fstat(fd).st_mode)==0o700 and 'owner.json' in names and len(names)<=33,'downstream_archive_inventory');check()
        matches=[]
        for name in sorted(names-{'owner.json'}):
            need(re.fullmatch('[0-9a-f]{40}-[0-9a-f]{64}',name) is not None,'downstream_archive_name')
            namespace=archives+'/'+name
            raw,mode=state.read(namespace+'/transaction/plan.json')
            need(mode==0o600,'downstream_plan_mode')
            plan=e.decode(raw,limit=e.MAX_PLAN_BYTES)
            journal_raw,journal_mode=state.read(namespace+'/transaction/journal.json')
            journal=e.decode(journal_raw)
            need(type(plan) is dict and type(journal) is dict,'downstream_archive_schema')
            # Prepared neighbours are retained evidence, never an applied link.
            if journal.get('phase')!='applied':continue
            need(journal_mode==0o600 and journal.get('intent') is None and journal.get('planSha256')==digest(raw),'downstream_archive_journal')
            targets=plan.get('targets',{})
            need(type(targets) is dict,'downstream_archive_targets')
            if all(type(targets.get(key)) is dict and targets[key].get('after')==e.image(*current.images[key]['before']) for key in shared):
                matches.append(namespace)
        need(len(matches)==1,'downstream_chain_missing_or_ambiguous')
        current,proof=node(matches[0],current)
        need(proof['planSha256'] not in seen,'downstream_chain_cycle')
        seen.add(proof['planSha256']);chain.append(proof)
    root.bound();root._operation_lock_check()
    if renderer is not None:endpoints['ds3.receipt']=renderer['receipt']
    return {'chain':chain,'endpoints':endpoints,'renderer':renderer}


def archive_settled(root,commit,old_commit,expected,event=lambda _:None):
    need(pin(old_commit,40) and old_commit!=commit and pin(expected),'archive_binding_required')
    command(['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL,'merge-base','--is-ancestor',old_commit,commit])
    state=root.anchors['state'];need(state.read(NAMESPACE+'/owner.json')==(OWNER,0o600),'state_namespace_collision')
    raw,_=root.read('state/transaction/plan.json');need(digest(raw)==expected,'plan_binding_drift');p=decode(raw)
    need(type(p) is dict and set(p)=={'schema','kind','acceptedCommit','policySha256','targets'} and type(p['schema']) is int and p['schema']==1
         and p['kind']=='game-launch-reliability' and p['acceptedCommit']==old_commit and pin(p['policySha256'])
         and type(p['targets']) is dict and set(p['targets'])==set(TARGETS),'archive_plan_schema')
    j=decode(root.read('state/transaction/journal.json')[0])
    need(type(j) is dict and set(j)=={'schema','planSha256','phase','intent'} and type(j['schema']) is int and j['schema']==1 and j['planSha256']==expected
         and j['phase'] in ('applied','rolled-back') and j['intent'] is None,'archive_requires_settlement')
    side='after' if j['phase']=='applied' else 'before';inventory={'plan.json','journal.json'}
    changed={key for key,rel in TARGETS.items() if image(read(root,rel))!=p['targets'][key][side]}
    downstream=None
    if changed:
        need(side=='after' and changed<={'ds3.lifecycle','hub.receipt','ds3.receipt'},'archive_endpoint_drift')
        downstream=downstream_overlay_proof(root,commit,old_commit,p)
    endpoints={key:downstream['endpoints'][key] if downstream is not None and key in downstream['endpoints'] else row[side]
               for key,row in p['targets'].items()}
    for key,rel in TARGETS.items():
        row=p['targets'][key];need(type(row) is dict and set(row)=={'before','after'},'archive_target_schema')
        for image_side in ('before','after'):
            image_schema(row[image_side],absent=(key=='helper' and image_side=='before'))
            backup='state/transaction/'+key+'.'+image_side
            need(image(read(root,backup))==row[image_side],'backup_drift')
            if row[image_side] is not None:inventory.add(key+'.'+image_side)
        need(image(read(root,rel))==endpoints[key],'archive_endpoint_drift')
    with root.parent('state/transaction/.unused') as (fd,_,check):need(set(os.listdir(fd))==inventory,'archive_requires_no_stages');check()
    if not state.exists(ARCHIVES):state.mkdir(ARCHIVES);state.write_new(ARCHIVES+'/owner.json',ARCHIVE_OWNER)
    need(state.read(ARCHIVES+'/owner.json')==(ARCHIVE_OWNER,0o600),'archive_owner_drift')
    with state.parent(NAMESPACE) as (src,leaf,check),state.parent(ARCHIVES+'/.unused') as (dst,_,bound):
        check();bound();root._operation_lock_check();source_check(commit)
        facts=os.stat(leaf,dir_fd=src,follow_symlinks=False)
        origin=(facts.st_dev,facts.st_ino,facts.st_mode,facts.st_uid)
        need(stat.S_ISDIR(facts.st_mode) and facts.st_uid==os.getuid() and stat.S_IMODE(facts.st_mode)==0o700,'archive_namespace_mode')
        need(stat.S_IMODE(os.fstat(dst).st_mode)==0o700,'archive_parent_mode')
        import ctypes
        libc=ctypes.CDLL('/usr/lib/libSystem.B.dylib',use_errno=True)
        function=libc.renameatx_np;function.argtypes=(ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint);function.restype=ctypes.c_int
        name=old_commit+'-'+expected
        event('before-archive')
        source_check(commit)
        check();bound();need(root.read('state/transaction/plan.json')[0]==raw and root.read('state/transaction/journal.json')[0]==encode(j),'archive_record_drift')
        if downstream is not None:
            need(downstream_overlay_proof(root,commit,old_commit,p)==downstream,'downstream_proof_drift')
        for key,rel in TARGETS.items():
            need(image(read(root,rel))==endpoints[key],'archive_endpoint_drift')
            for image_side in ('before','after'):
                need(image(read(root,'state/transaction/'+key+'.'+image_side))==p['targets'][key][image_side],'backup_drift')
        need(state.read(NAMESPACE+'/owner.json')==(OWNER,0o600),'state_namespace_collision')
        with root.parent('state/transaction/.unused') as (fd,_,guard):
            need(set(os.listdir(fd))==inventory,'archive_requires_no_stages');guard()
        now=os.stat(leaf,dir_fd=src,follow_symlinks=False);need((now.st_dev,now.st_ino,now.st_mode,now.st_uid)==origin,'archive_namespace_drift')
        status=function(src,os.fsencode(leaf),dst,os.fsencode(name),4)
        if status!=0:raise OSError(ctypes.get_errno(),os.strerror(ctypes.get_errno()))
        os.fsync(src);os.fsync(dst);check();bound()
    return {'state':'SETTLED_TRANSACTION_ARCHIVED','changed':True,'installedTargetsChanged':False,'liveStateChanged':True,'installedAcceptanceClaimed':False,'planSha256':expected,'oldSourceCommit':old_commit}

def operate(operation,commit,expected=None,event=lambda _:None,old_commit=None):
    need(operation in ('plan','apply','rollback','return','recover','archive-settled'),'unsupported_operation');need(operation=='archive-settled' or old_commit is None,'old_commit_archive_only');source_check(commit)
    e=engine();root=make_root(e)
    try:
        with locks(root):
            value,native,policy_sha=policy(root)
            source_gate(commit,root,value,operation);local_gate(root,commit,value)
            if operation=='archive-settled':return archive_settled(root,commit,old_commit,expected,event)
            # Private invocation closure: full readiness was observed once
            # under these locks; each callback freshly checks local drift.
            class OperationTransaction(Transaction):
                def check_gate(self):local_gate(root,commit,value)
            journal_exists=root.exists('state/transaction/journal.json')
            if operation=='plan':
                if journal_exists:
                    need(pin(expected),'existing_transaction_plan_pin_required');tx=OperationTransaction(root,expected,commit,value,native,policy_sha);tx.verify()
                    return {'state':'PLANNED_EXISTING_TRANSACTION','planSha256':expected,'phase':tx.journal()['phase'],'changed':False,'liveStateChanged':False}
                p,_,_=plan(root,commit,value,native,policy_sha)
                return {'state':'PLANNED_READ_ONLY','planSha256':digest(encode(p)),'changed':False,'liveStateChanged':False}
            need(pin(expected),'reviewed_plan_pin_required')
            if operation=='apply' and journal_exists:
                raw,mode=root.read('state/transaction/journal.json')
                try:decode(raw)
                except Blocked:
                    p,before,after=plan(root,commit,value,native,policy_sha)
                    need(digest(encode(p))==expected,'prestate_changed_since_plan')
                    prepared=encode({'schema':1,'planSha256':expected,'phase':'prepared','intent':None})
                    need(mode==0o600 and prepared.startswith(raw),'staging_unknown_drift')
                    stage(root,p,before,after)
            if operation=='apply' and not journal_exists:
                p,before,after=plan(root,commit,value,native,policy_sha);need(digest(encode(p))==expected,'prestate_changed_since_plan')
                stage(root,p,before,after)
            tx=OperationTransaction(root,expected,commit,value,native,policy_sha,event)
            return tx.run('before' if operation=='rollback' else 'after',recover=operation=='recover')
    finally:root.close()

def main():
    os.umask(0o077);parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('operation',choices=('plan','apply','rollback','return','recover','archive-settled'));parser.add_argument('commit');parser.add_argument('--plan-sha256');parser.add_argument('--old-commit')
    args=parser.parse_args();print(json.dumps(operate(args.operation,args.commit,args.plan_sha256,old_commit=args.old_commit),sort_keys=True))
if __name__=='__main__':
    try:main()
    except (OSError,RuntimeError,subprocess.SubprocessError,UnicodeError) as error:
        unknown=getattr(error,'settlement_failed',False) is not False or getattr(error,'private_owner',None) is not None
        print(json.dumps({'state':'UNKNOWN' if unknown else 'BLOCKED','reason':'operation_settlement_unconfirmed' if unknown else str(error) if isinstance(error,RuntimeError) else type(error).__name__,'installedAcceptanceClaimed':False,'validationScope':'launch-closure-and-declared-guards','runtimeHealthClaimed':False,'automaticRetryAllowed':False,'custodyUnknown':unknown},sort_keys=True));sys.exit(1)
