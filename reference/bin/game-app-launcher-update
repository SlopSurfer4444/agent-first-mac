#!/usr/bin/python3
"""Exact native executable/receipt update; never launches or stops a client."""
import sys
sys.dont_write_bytecode=True
sys.pycache_prefix = "/dev/null"
import fcntl,importlib.machinery,importlib.util,os,re,stat,tempfile
from pathlib import Path
loader=importlib.machinery.SourceFileLoader('game_apps',str(Path(__file__).resolve().with_name('game-app-launchers')))
spec=importlib.util.spec_from_loader(loader.name,loader);h=importlib.util.module_from_spec(spec);loader.exec_module(h)

def targets():
    result={str(i):h.HOME/'Games'/name/'Contents/MacOS/launcher' for i,name in enumerate(h.NAMES)}
    result.update(hub=h.HUB/'receipt.json',ds3=h.DS3/'receipt.json')
    return result

def source_check(commit):
    h.need(h.HERE == h.CONTROL and Path(__file__).absolute() == h.CONTROL/'bin/game-app-launcher-update','canonical_source_required')
    h.need(type(commit) is str and re.fullmatch('[0-9a-f]{40}',commit),'invalid_commit')
    sys.path.insert(0,str(h.CONTROL))
    from lib.scoped_source_admission import check
    check(h.CONTROL,commit,entrypoints=('bin/game-app-launcher-update',))

def status():
    """Only the four launcher bundles and the two owned receipt fields.

    Updating Finder executables neither executes Wine nor changes a prefix,
    runtime, lifecycle helper or migration README. Their health is unrelated.
    """
    receipts={key:h.load(path) for key,path in targets().items() if key in ('hub','ds3')}
    m=h.policy_for_digest(receipts['ds3'].get('appPolicySha256'))
    h.need(h.bundle_inventory(h.HOME/'Games')==m['builtApps'],'installed_app_drift')
    for key,receipt in receipts.items():
        names=[n for n in h.NAMES if (n=='Dark Souls III.app')==(key=='ds3')]
        h.need(receipt.get('appPolicySha256')==h.policy_digest(m) and receipt.get('appLaunchers')=={n:m['builtApps'][n] for n in names},'app_receipt_drift')
    return True

def source_gate(commit,recovery_check=None):
    source_check(commit);bridge=h.module_bridge()
    def owner():
        for key,expected in (('hub','control-games-hub'),('ds3','control-ds3-marshal-fix')):
            h.need(h.load(targets()[key]).get('owner')==expected,'operation_payload_owner')
        return True
    def recovery():
        if recovery_check is not None:recovery_check()
        else:
            transaction=h.HUB/('.game-app-errors-'+commit)
            if transaction.exists() or transaction.is_symlink():check(transaction,commit)
        return True
    snapshot=lambda:({str(p):h.image(p) for p in targets().values()},h.bundle_inventory(h.HOME/'Games'))
    held=bridge.bound(snapshot)
    checks={'payload-owner':owner,'recovery':recovery}
    if recovery_check is None:checks['wine-target']=status
    report=bridge.ready(h.CONTROL,commit,'wine-recovery' if recovery_check else 'wine-install',checks=checks,target_guard=held)
    h.need(report.get('scopedCandidateReady') is True,'scoped_operation_readiness_required')
    source_check(commit)
    return held

def policies():
    old=h.policy(h.MANIFEST);new=h.policy(h.ERROR_POLICY)
    h.need(new.get('previousPolicySha256') == h.sha(h.HERE/h.MANIFEST),'previous_policy_binding')
    for name in h.NAMES:
        for rel in ('Contents/Info.plist','Contents/Resources/Game.icns'):
            h.need(old['builtApps'][name][rel] == new['builtApps'][name][rel],'non_executable_update')
    return old,new

def receipt_after(before,new,commit,key):
    names=[name for name in h.NAMES if (name == 'Dark Souls III.app') == (key == 'ds3')]
    return dict(before,appLaunchers={name:new['builtApps'][name] for name in names},appPolicySha256=h.policy_digest(new),appCommit=commit)

def check(transaction,commit,side=None):
    old,new=policies();j=h.load(transaction/'journal.json');mapped=targets()
    h.need(set(j) == set(mapped),'update_journal_schema')
    for key,target in mapped.items():
        row=j[key];h.need(set(row) == {'before','after'},'update_journal_schema')
        for phase in ('before','after'):h.need(h.image(transaction/(key+'.'+phase)) == row[phase],'update_backup_drift')
        observed=h.image(target);h.need(observed == row[side] if side else observed in (row['before'],row['after']),'update_target_drift')
    for i,name in enumerate(h.NAMES):
        expected={phase:dict(kind='file',**m['builtApps'][name]['Contents/MacOS/launcher']) for phase,m in (('before',old),('after',new))}
        h.need(j[str(i)] == expected,'update_executable_binding')
    for key in ('hub','ds3'):
        before=h.load(transaction/(key+'.before'));after=h.load(transaction/(key+'.after'))
        names=[name for name in h.NAMES if (name == 'Dark Souls III.app') == (key == 'ds3')]
        h.need(before.get('appPolicySha256') == h.policy_digest(old) and before.get('appLaunchers') == {n:old['builtApps'][n] for n in names},'update_receipt_preimage')
        h.need(after == receipt_after(before,new,commit,key),'update_receipt_relation')
        h.need(j[key]['before']['mode'] == j[key]['after']['mode'] == 0o600,'update_receipt_mode')
    return j

def restore(transaction,commit):
    j=check(transaction,commit)
    for key,target in reversed(list(targets().items())):
        observed=h.image(target);h.need(observed in (j[key]['before'],j[key]['after']),'update_target_changed')
        h.replace_image(transaction/(key+'.before'),target,observed)
    check(transaction,commit,'before')

def update(commit,candidate):
    held=source_gate(commit);old,new=policies();h.candidate_check(candidate,new);status()
    current=h.load(h.DS3/'receipt.json')
    if current.get('appPolicySha256') == h.policy_digest(new):return {'state':'GAME_APP_ERRORS_INSTALLED','changed':False,'gameStarted':False}
    h.need(current.get('appPolicySha256') == h.policy_digest(old),'update_previous_policy')
    transaction=h.HUB/('.game-app-errors-'+commit);mapped=targets()
    if transaction.exists() or transaction.is_symlink():j=check(transaction,commit,'before')
    else:
        pending=Path(tempfile.mkdtemp(prefix='.game-app-errors-stage-',dir=h.HUB));j={}
        for key,target in mapped.items():
            h.copy_image(target,pending/(key+'.before'));j[key]={'before':h.image(target),'after':None}
        for i,name in enumerate(h.NAMES):h.copy_image(candidate/name/'Contents/MacOS/launcher',pending/(str(i)+'.after'))
        for key in ('hub','ds3'):h.write_image(pending/(key+'.after'),h.jb(receipt_after(h.load(pending/(key+'.before')),new,commit,key)))
        for key in mapped:j[key]['after']=h.image(pending/(key+'.after'))
        h.write_image(pending/'journal.json',h.jb(j));check(pending,commit,'before');os.rename(pending,transaction)
    # Recheck the exact source and staged target preimages at publication,
    # without rerunning the complete diagnostic or unrelated game validators.
    source_check(commit);h.need(held() is True,'launcher_target_drift');check(transaction,commit,'before')
    try:
        for key,target in mapped.items():h.replace_image(transaction/(key+'.after'),target,j[key]['before'])
        check(transaction,commit,'after');status()
    except Exception:
        restore(transaction,commit);raise
    return {'state':'GAME_APP_ERRORS_INSTALLED','changed':True,'gameStarted':False}

def rollback(commit,apply_commit):
    h.need(type(apply_commit) is str and re.fullmatch('[0-9a-f]{40}',apply_commit),'invalid_apply_commit')
    source_gate(commit,lambda:check(h.HUB/('.game-app-errors-'+apply_commit),apply_commit))
    restore(h.HUB/('.game-app-errors-'+apply_commit),apply_commit);status()
    return {'state':'GAME_APP_ERRORS_ROLLED_BACK','gameStarted':False}

def main():
    os.umask(0o077);args=sys.argv[1:];h.safe_dir(h.HOME/'AIDev/state')
    fd=os.open(h.HOME/'AIDev/state/games-hub.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
    s=os.fstat(fd);h.need(stat.S_ISREG(s.st_mode) and s.st_uid == os.getuid() and s.st_nlink == 1 and not s.st_mode & 0o022,'unsafe_lock')
    with os.fdopen(fd,'w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        if len(args)==3 and args[0]=='install':result=update(args[1],Path(args[2]))
        elif len(args)==3 and args[0]=='rollback':result=rollback(args[1],args[2])
        elif args==['status']:
            status();result={'state':'GAME_APP_LAUNCHERS_VALID','sourcePolicyCurrent':h.load(h.DS3/'receipt.json')['appPolicySha256']==h.policy_digest(h.policy()),'gameStarted':False}
        else:raise RuntimeError('usage: game-app-launcher-update install COMMIT CANDIDATE | rollback COMMIT APPLY_COMMIT | status')
    print(h.jb(result).decode())
if __name__=='__main__':
    try:main()
    except Exception as e:
        print(h.jb({'state':'BLOCKED','reason':str(e) if type(e) is RuntimeError else type(e).__name__}).decode());sys.exit(1)
