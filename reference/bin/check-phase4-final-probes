def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def run(argv, cwd=ROOT, env=None):
    return subprocess.run([str(value) for value in argv], cwd=cwd, env=env, text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)


def checked(argv, cwd=ROOT, env=None):
    value = run(argv, cwd=cwd, env=env)
    require(value.returncode == 0,
            f"command_failed_{Path(str(argv[0])).name}: {value.stdout[-1800:]}")
    return value.stdout


def git(*args, cwd=ROOT):
    return checked([*GIT, *args], cwd=cwd).strip()


def digest(path):
    value = hashlib.sha256()
    with path.open("rb") as stream:
        while chunk := stream.read(65536):
            value.update(chunk)
    return value.hexdigest()


def digest_text(value):
    return hashlib.sha256(value.encode()).hexdigest()


def commit_scope(commit, cwd=ROOT):
    return set(git(
        "diff-tree", "--no-commit-id", "--name-only", "-r", commit, cwd=cwd
    ).splitlines())


def worktree_scope():
    lines = checked([*GIT, "status", "--porcelain=v1", "--untracked-files=all"]).splitlines()
    return {line[3:] for line in lines if len(line) > 3}


def validate_metadata(commit, expected=EXECUTOR_METADATA, cwd=ROOT):
    values = git(
        "show", "-s", "--format=%an%n%ae%n%cn%n%ce", commit, cwd=cwd
    ).splitlines()
    require(values == expected, "commit_metadata")


def strict_json(path):
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            require(isinstance(key, str) and key not in value, "duplicate_json_key")
            value[key] = item
        return value

    return json.loads(Path(path).read_text(), object_pairs_hook=unique_object)


def validate_historical_history():
    chain = [
        (INITIAL_IMPLEMENTATION, TASK_PARENT, IMPLEMENTATION_SCOPE),
        (INITIAL_EVIDENCE_COMMIT, INITIAL_IMPLEMENTATION, EVIDENCE_SCOPE),
        (CLONE_CORRECTION, INITIAL_EVIDENCE_COMMIT, CORRECTION_SCOPE),
        (ACCEPTED_FINAL_HEAD, CLONE_CORRECTION, EVIDENCE_SCOPE),
        (ATOMICITY_IMPLEMENTATION, ACCEPTED_FINAL_HEAD, ATOMICITY_SCOPE),
        (ACCEPTED_ATOMICITY_HEAD, ATOMICITY_IMPLEMENTATION, EVIDENCE_SCOPE),
        (TTY_IMPLEMENTATION, ACCEPTED_ATOMICITY_HEAD, TTY_SCOPE),
        (ACCEPTED_TTY_HEAD, TTY_IMPLEMENTATION, EVIDENCE_SCOPE),
        (VISUDO_IMPLEMENTATION, ACCEPTED_TTY_HEAD, VISUDO_SCOPE),
        (ACCEPTED_VISUDO_HEAD, VISUDO_IMPLEMENTATION, EVIDENCE_SCOPE),
    ]
    for commit, parent, expected_scope in chain:
        require(git("rev-parse", commit + "^") == parent and
                commit_scope(commit) == expected_scope,
                "accepted_history_" + commit[:8])
        validate_metadata(commit)
    require(git("rev-list", "--count", TASK_PARENT + ".." + ACCEPTED_VISUDO_HEAD) == "10" and
            git("rev-list", "--merges", TASK_PARENT + ".." + ACCEPTED_VISUDO_HEAD) == "",
            "accepted_history_shape")
    validate_emergency_evidence(VISUDO_IMPLEMENTATION)


def validate_review_chain(reviewed_head):
    require(git("rev-list", "--count", TASK_PARENT + ".." + reviewed_head) == "12" and
            git("rev-list", "--merges", TASK_PARENT + ".." + reviewed_head) == "",
            "finalization_history_shape")
    implementation = git("rev-parse", reviewed_head + "^")
    require(git("rev-parse", implementation + "^") == ACCEPTED_VISUDO_HEAD and
            commit_scope(implementation) == FINALIZATION_SCOPE,
            "finalization_implementation_history")
    require(commit_scope(reviewed_head) == FINAL_EVIDENCE_SCOPE,
            "finalization_evidence_history")
    validate_metadata(implementation)
    validate_metadata(reviewed_head)
    return implementation, validate_final_evidence(implementation)


def retained_protected_path(path):
    if path in {"AGENTS.md", "ARCHITECTURE.md", "README.md"}:
        return True
    if (
        path.startswith("codex/")
        or path.startswith("docs/phase-5")
        or path.startswith("evidence/phase-5/")
        or path.startswith("skills/manage-workstation/")
        or path
        in {
            "bin/check-phase5-prep",
            "bin/codex-quarantine",
            "bin/phase5-config-transaction",
            "bin/phase5-preflight",
            "bin/phase5-apply-transaction",
            "manifests/codex-contract.json",
            "manifests/phase5-apply-bundle.json",
            "manifests/trusted-repos.json",
            "manifests/trusted-repos.schema.json",
            "tests/fixtures/phase5-contract-cases.json",
            "tests/fixtures/phase5-skill-triggers.json",
        }
    ):
        return True
    return (
        path == "Package.swift"
        or path.startswith("Sources/AidAdmin")
        or path.startswith("bin/build-phase4")
        or path.startswith("bin/check-phase4")
        or path.startswith("bin/phase4")
        or path.startswith("docs/phase-4")
        or path.startswith("evidence/phase-4/")
        or path.startswith("install-bundles/phase-4/")
        or path.startswith("policy/aid-admin")
        or path == "policy/sudoers.d/agent-first-mac-aid-admin"
        or path.startswith("tests/AidAdmin")
    )


def validate_phase5_descendant_baseline(directory, head):
    resolved_head = git("rev-parse", head, cwd=directory)
    result = run(
        [directory / "bin/check-phase5-prep", "--git-only", "--json"],
        cwd=directory,
    )
    try:
        value = strict_json_text(result.stdout)
    except (json.JSONDecodeError, TypeError, ValueError) as error:
        raise RuntimeError("phase5_validator_invalid_output") from error
    if result.returncode != 0:
        reason = value.get("error")
        require(isinstance(reason, str) and bool(reason), "phase5_validator_failed")
        raise RuntimeError(reason)
    require(
        value.get("phase5ApplyAuthorized") is False
        and value.get("phase5PassClaimed") is False
        and value.get("phase6Authorized") is False
        and value.get("preparationOnly") is True
        and value.get("repositoryState")
        in {
            "apply_bundle_integrated",
            "apply_bundle_review",
            "correction_review",
            "integrated_main",
        },
        "phase5_validator_contract",
    )
    if resolved_head == PHASE5_ACCEPTANCE_COMMIT:
        return PHASE5_ACCEPTANCE_COMMIT
    protected_baseline = value.get("protectedBaselineCommit")
    require(
        isinstance(protected_baseline, str)
        and re.fullmatch(r"[0-9a-f]{40}", protected_baseline) is not None
        and run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                protected_baseline,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "phase5_protected_baseline",
    )
    return protected_baseline


def validate_phase4_acceptance_object(
        directory, acceptance_commit, reviewed_head=ACCEPTED_REVIEWED_HEAD):
    require(
        git("rev-parse", acceptance_commit + "^", cwd=directory) == reviewed_head,
        "acceptance_commit_parent",
    )
    require(
        commit_scope(acceptance_commit, cwd=directory) == ACCEPTANCE_SCOPE,
        "acceptance_commit_scope",
    )
    validate_metadata(
        acceptance_commit, COORDINATOR_METADATA, cwd=directory)
    implementation = git("rev-parse", reviewed_head + "^", cwd=directory)
    value = strict_json_text(
        git("show", acceptance_commit + ":evidence/phase-4/acceptance.json",
            cwd=directory)
    )
    validate_acceptance_value(value, reviewed_head, implementation)
    return implementation


def validate_phase4_descendant(directory, head="HEAD"):
    require(
        run(
            [*GIT, "merge-base", "--is-ancestor", ACCEPTANCE_COMMIT, head],
            cwd=directory,
        ).returncode == 0,
        "acceptance_commit_not_ancestor",
    )
    require(
        git(
            "rev-list",
            "--merges",
            ACCEPTANCE_COMMIT + ".." + head,
            cwd=directory,
        )
        == "",
        "accepted_descendant_merge",
    )
    resolved_head = git("rev-parse", head, cwd=directory)
    if resolved_head == ACCEPTANCE_COMMIT:
        return ACCEPTANCE_COMMIT
    protected_baseline = validate_phase5_descendant_baseline(directory, head)
    changed = set(
        filter(
            None,
            git(
                "diff",
                "--name-only",
                protected_baseline + ".." + head,
                cwd=directory,
            ).splitlines(),
        )
    )
    protected = sorted(path for path in changed if retained_protected_path(path))
    require(
        not protected,
        "protected_descendant_drift"
        + (":" + ",".join(protected) if protected else ""),
    )
    return protected_baseline


def validate_accepted_phase4():
    implementation, evidence = validate_review_chain(ACCEPTED_REVIEWED_HEAD)
    require(
        implementation
        == git("rev-parse", ACCEPTED_REVIEWED_HEAD + "^"),
        "accepted_review_implementation",
    )
    validate_phase4_acceptance_object(ROOT, ACCEPTANCE_COMMIT)
    require(
        (ROOT / "evidence/phase-4/acceptance.json").read_text()
        == git(
            "show",
            ACCEPTANCE_COMMIT + ":evidence/phase-4/acceptance.json",
        )
        + "\n",
        "acceptance_worktree_drift",
    )
    validate_phase4_descendant(ROOT)
    return implementation, evidence


def validate_git(mode):
    branch = git("branch", "--show-current")
    require(run([*GIT, "merge-base", "--is-ancestor", TASK_PARENT, "HEAD"]).returncode == 0,
            "task_parent_not_ancestor")
    validate_historical_history()
    if mode == "finalization-contract":
        require(branch == BRANCH and git("rev-parse", "HEAD") == ACCEPTED_VISUDO_HEAD,
                "finalization_contract_parent")
        require(worktree_scope() == FINALIZATION_SCOPE, "finalization_contract_scope")
        return None, None, "review_contract", None
    if mode == "finalization-implementation":
        require(branch == BRANCH and
                git("status", "--porcelain=v1", "--untracked-files=all") == "",
                "finalization_implementation_state")
        implementation = git("rev-parse", "HEAD")
        require(git("rev-parse", "HEAD^") == ACCEPTED_VISUDO_HEAD and
                commit_scope(implementation) == FINALIZATION_SCOPE,
                "finalization_implementation_history")
        validate_metadata(implementation)
        return implementation, None, "review_implementation", None

    require(git("status", "--porcelain=v1", "--untracked-files=all") == "",
            "dirty_worktree")
    if branch == BRANCH:
        reviewed_head = git("rev-parse", "HEAD")
        implementation, evidence = validate_review_chain(reviewed_head)
        require(not ACCEPTANCE.exists(), "acceptance_present_on_review_branch")
        repository_state = "review"
    elif branch in {
        "main",
        DESCENDANT_REVIEW_BRANCH,
        APPLY_BUNDLE_REVIEW_BRANCH,
    }:
        implementation, evidence = validate_accepted_phase4()
        reviewed_head = ACCEPTED_REVIEWED_HEAD
        repository_state = (
            "accepted_main"
            if branch == "main"
            else "accepted_descendant_review"
        )
    else:
        raise RuntimeError("wrong_or_detached_branch")
    if mode in ("clone", "clone-git-only"):
        require(git("remote") == "", "clone_has_remote")
    return implementation, evidence, repository_state, reviewed_head


def validate_emergency_evidence(implementation):
    value = strict_json(EMERGENCY_EVIDENCE)
    require(set(value) == {"atomicityCorrection", "authority", "base", "branch", "bundle", "gate",
                           "fullVisudoCompatibilityCorrection",
                           "idempotence", "implementationCommit", "phase", "rollback",
                           "schema", "systemMutations", "tests", "ttyForegroundCorrection"},
            "evidence_keys")
    require(value["schema"] == 1 and value["phase"] == "phase4_final_probes_preparation" and
            value["base"] == TASK_PARENT and value["branch"] == BRANCH and
            value["implementationCommit"] == implementation, "evidence_header")
    require(value["authority"] == {"controlMain": CONTROL_MAIN,
                                    "migrationMain": HISTORICAL_MIGRATION_PROVENANCE},
            "evidence_authority")
    require(value["gate"] == {"independentReviewRequired": True,
                               "l3Claimed": False, "marker": EMERGENCY_MARKER,
                               "maximumVerdict": EMERGENCY_VERDICT,
                               "phase4PassClaimed": False,
                               "phase5Authorized": False}, "evidence_gate")
    require(value["atomicityCorrection"] == {
        "descriptorBackedParentValidation": True,
        "noReplaceTransitions": True,
        "ownerDisableVerificationFailureRetainsDisabledState": True,
        "ownerRecoveryVerificationFailureSameBoundaryRollback": True,
    }, "evidence_atomicity")
    require(value["ttyForegroundCorrection"] == {
        "freshSudoForegroundGroupInherited": True,
        "interactiveBytesCaptured": False,
        "mockSecretEchoSuppressed": True,
        "productionPTYSynthesized": False,
        "ptyIntegrationPassed": True,
        "standardInputInherited": True,
    }, "evidence_tty_foreground")
    require(value["fullVisudoCompatibilityCorrection"] == {
        "bareDefaultOwnerPermissionCheckRemoved": True,
        "boundedDiagnosticClassification": True,
        "canonicalMainSyntaxParse": True,
        "declarativeReadOnlySymlinkIncludeFixture": True,
        "malformedIncludedPolicyRejected": True,
        "trustedCanonicalMainAndDirectoryMetadata": True,
    }, "evidence_full_visudo")
    require(all(value["tests"].values()), "evidence_tests")
    require(value["systemMutations"] == {
        "auditAndStagingAlreadyCurrentRecords": True,
        "emergencyDisableOrRecoveryExecuted": False,
        "newGenerationCreated": False,
        "profileOrCurrentSystemChanged": False,
        "repoOrIntentMutationOutsideCommits": False,
    }, "evidence_system_mutations")
    require(value["rollback"] == {
        "emergencyFixtureExactStateRollback": True,
        "generation2Retained": True,
        "ownerRecoveryVerificationFailureRollbackTested": True,
        "ownerRollbackReturnPreviouslyVerified": True,
    }, "evidence_rollback")
    return value


def validate_final_evidence(implementation):
    value = strict_json(FINAL_EVIDENCE)
    require(set(value) == {
        "acceptedState", "base", "branch", "conditionalAcceptance",
        "finalizationImplementationCommit", "gate", "historicalProvenance",
        "phase", "rollback", "schema", "systemMutations", "tests",
        "unchangedArtifacts",
    }, "final_evidence_keys")
    require(value["schema"] == 1 and
            value["phase"] == "phase4_final_standalone_integration_preparation" and
            value["base"] == ACCEPTED_VISUDO_HEAD and value["branch"] == BRANCH and
            value["finalizationImplementationCommit"] == implementation,
            "final_evidence_header")
    require(value["acceptedState"] == {
        "acceptedLevel": "L2",
        "backup": "deferred_accepted_risk",
        "currentGeneration": 3,
        "emergencyDisableRecoveryVerified": True,
        "idempotenceVerified": True,
        "phase2": "PASS",
        "phase3": "PASS",
        "phase4PassClaimed": False,
        "phase5Authorized": False,
        "rollbackReturnVerified": True,
    }, "final_evidence_accepted_state")
    require(value["conditionalAcceptance"] == {
        "acceptanceCommitFiles": ["evidence/phase-4/acceptance.json"],
        "acceptanceCommitMustDirectlyFollowReviewedHead": True,
        "acceptanceRecordCreatedByExecutor": False,
        "coordinatorMetadataRequired": True,
        "integratedBranch": "main",
        "reviewBranch": BRANCH,
    }, "final_evidence_acceptance")
    require(value["gate"] == {
        "independentReviewRequired": True,
        "l3Claimed": False,
        "marker": MARKER,
        "maximumVerdict": VERDICT,
        "phase4PassClaimed": False,
        "phase5Authorized": False,
    }, "final_evidence_gate")
    require(value["historicalProvenance"] == {
        "coordinatorEvidenceCommit": COORDINATOR_EVIDENCE,
        "operationalDependency": False,
    }, "final_evidence_provenance")
    require(value["rollback"] == {
        "currentGeneration": 3,
        "emergencyState": "enabled_exact",
        "generation2Available": True,
        "gitOnlyForThisPreparation": True,
        "systemRollbackRequired": False,
    }, "final_evidence_rollback")
    require(value["systemMutations"] == {
        "applySystem": False,
        "emergencyAction": False,
        "generationOrProfile": False,
        "installedRootOrSystem": False,
        "performed": False,
        "sudoPasswordOrInteractivePrompt": False,
    }, "final_evidence_mutations")
    require(set(value["tests"]) == {
        "acceptedComponentSuites", "cleanNoOriginClone", "doctorFixtureNegativeMatrix",
        "finalDoctorHumanAndStableJSON", "gitAcceptanceNegativeMatrix",
        "maliciousGitConfigNonExecution", "phase2StaticAndRepeatedDoctor",
        "phase3AcceptanceCompatibility", "protectedStateClean",
        "redactionPathIdentifierDependencyScans", "reviewAndSyntheticAcceptedMain",
    } and all(value["tests"].values()), "final_evidence_tests")
    require(value["unchangedArtifacts"] == {
        "brokerSHA256": BROKER_SHA256,
        "emergencyArtifactSHA256":
            "9eb393257a71cf190b2131443eb617f9c17e56adcf5716472558bd9039885cec",
        "emergencyManifestSHA256":
            "01b9df839bb9de049207ef4570068b7d336619bf51b0942c89b1d87dcd3748a6",
        "policySHA256": POLICY_SHA256,
        "receiptSHA256": RECEIPT_SHA256,
    }, "final_evidence_artifacts")
    return value


def validate_acceptance_value(value, reviewed_head, implementation):
    require(set(value) == {
        "acceptedOn", "coordinatorReview", "gate", "phase", "reviewMarker",
        "reviewedFinalizationHead", "reviewedImplementationCommit", "schema",
        "systemMutationDuringAcceptance",
    }, "acceptance_keys")
    require(isinstance(value["acceptedOn"], str) and
            re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", value["acceptedOn"]),
            "acceptance_date")
    require(value["schema"] == 1 and value["phase"] == "phase4_typed_root_broker" and
            value["reviewMarker"] == MARKER and
            value["reviewedFinalizationHead"] == reviewed_head and
            value["reviewedImplementationCommit"] == implementation and
            value["systemMutationDuringAcceptance"] is False,
            "acceptance_header")
    require(value["coordinatorReview"] == {
        "componentValidator": "PASS",
        "emergencyDisableRecoveryVerified": True,
        "finalDoctor": "PASS",
        "liveStateVerified": True,
        "repositoryContractVerified": True,
        "selfReportIsAcceptance": False,
    }, "acceptance_review")
    require(value["gate"] == {
        "acceptedLevel": ACCEPTED_LEVEL,
        "backupDeferredAcceptedRisk": True,
        "l3Claimed": True,
        "phase4Complete": True,
        "phase4PassClaimed": True,
        "phase5Authorized": False,
        "verdict": "PASS",
    }, "acceptance_gate")
    return value


def validate_acceptance(reviewed_head, implementation):
    return validate_acceptance_value(
        strict_json(ACCEPTANCE), reviewed_head, implementation)


def validate_manifest():
    manifest_path = BUNDLE / "review-manifest.json"
    manifest = json.loads(manifest_path.read_text())
    require(set(manifest) == {"acceptedBases", "actionSurface", "architecture", "artifact",
                              "authenticationBoundaries", "buildProvenance", "gates",
                              "fullSudoersValidation",
                              "installedContract", "interactiveTTYContract", "privacy",
                              "reviewMarker", "rollback",
                              "schema", "transitionContract", "verdict"}, "manifest_keys")
    require(manifest["schema"] == 1 and manifest["verdict"] == EMERGENCY_VERDICT and
            manifest["reviewMarker"] == EMERGENCY_MARKER, "manifest_header")
    require(manifest["acceptedBases"] == {"controlMain": CONTROL_MAIN,
                                           "migrationMain": HISTORICAL_MIGRATION_PROVENANCE,
                                           "taskParent": TASK_PARENT}, "manifest_bases")
    require(manifest["actionSurface"] == {
        "disable": "aid-admin-emergency-action disable",
        "otherInputRejected": True,
        "recover": "aid-admin-emergency-action recover",
    }, "manifest_action_surface")
    require(manifest["authenticationBoundaries"] == {
        "disableFreshStandardSudo": True, "disablePasswordPrompts": 1,
        "disableVerificationFailureRetainsDisabledState": True,
        "recoveryFreshStandardSudo": True, "recoveryPasswordPrompts": 1,
        "recoveryVerificationBeforeTimestampClear": True,
        "recoveryVerificationFailureSameBoundaryRollback": True,
        "timestampClearedAfterEachAction": True,
    }, "manifest_authentication")
    require(manifest["fullSudoersValidation"] == {
        "bareDefaultOwnerPermissionCheckUsed": False,
        "canonicalMain": "/private/etc/sudoers",
        "declarativeSymlinkIncludesAllowed": True,
        "diagnosticClasses": ["access", "include_unavailable", "rejected", "syntax"],
        "diagnosticOutputRetained": False,
        "explicitSyntaxArguments": ["-cf", "/private/etc/sudoers"],
        "includedPolicySyntaxCovered": True,
        "mainMetadata": "root:wheel 0440 regular",
    }, "manifest_full_sudoers")
    require(manifest["transitionContract"] == {
        "descriptorBackedParentValidation": True,
        "directoryRelativeFixedPathOperations": True,
        "noReplacePrimitive": "renameatx_np(RENAME_EXCL)",
        "parents": {
            "/etc/agent-first-mac": "root:wheel 0755",
            "/etc/sudoers.d": "root:wheel 0755",
            "/private/etc": "root:wheel 0755",
            "/private/etc/sudoers.d": "root:wheel 0755 same-directory-as-/etc/sudoers.d",
            "/usr/local/libexec": "root:wheel 0755",
            "/var/db/agent-first-mac/staging": "root:wheel 0700",
            "/var/log/agent-first-mac/aid-admin": "root:wheel 0700",
        },
    }, "manifest_transition_contract")
    require(manifest["interactiveTTYContract"] == {
        "childForegroundGroupVerified": True,
        "controllingTTYRequired": True,
        "fileActions": False,
        "foregroundGroupInherited": True,
        "interactiveOutputCaptured": False,
        "passwordBytesHandled": "standard-sudo-and-terminal-only",
        "processGroupAttribute": False,
        "runner": "posix_spawn",
        "standardInputInherited": True,
        "synthesizedPTY": False,
    }, "manifest_interactive_tty")
    require(manifest["rollback"] == {
        "exactEnabledOrDisabledStateProven": True,
        "ownerRecoveryVerificationFailureReturnsDisabled": True,
        "recursiveDeletion": False,
        "retainsAuditStagingAndGenerations": True,
        "unexpectedDestinationNeverOverwritten": True,
    }, "manifest_rollback")
    require(manifest["gates"] == {"emergencyActionExecuted": False,
                                  "independentReviewRequired": True, "l3Claimed": False,
                                  "phase4PassClaimed": False, "phase5Authorized": False},
            "manifest_gates")
    require(manifest["privacy"] == {"environmentRetained": False,
                                    "hostnameRetained": False,
                                    "ownerIdentityRetained": False,
                                    "ownerUIDRetained": False,
                                    "passwordHandledOutsideStandardSudo": False,
                                    "secretsRetained": False}, "manifest_privacy")
    artifact = BUNDLE / manifest["artifact"]["path"]
    facts = artifact.lstat()
    require(manifest["artifact"]["modeClass"] ==
            "executable-not-group-or-world-writable", "manifest_artifact_mode_class")
    require(artifact.is_file() and not artifact.is_symlink() and
            stat.S_IMODE(facts.st_mode) & 0o111 != 0 and
            stat.S_IMODE(facts.st_mode) & 0o022 == 0 and
            digest(artifact) == manifest["artifact"]["sha256"] and
            facts.st_size == manifest["artifact"]["size"], "manifest_artifact")
    contract = manifest["installedContract"]
    require(contract["binary"] == {"mode": "0555", "sha256": BROKER_SHA256,
                                    "size": 483712} and
            contract["policy"] == {"mode": "0444", "sha256": POLICY_SHA256,
                                    "size": 1617} and
            contract["sudoers"] == {"mode": "0440", "sha256": SUDOERS_SHA256,
                                     "size": 122} and
            contract["receipt"] == {"mode": "0400", "sha256": RECEIPT_SHA256,
                                     "size": 431}, "manifest_installed_contract")
    for path, expected in manifest["buildProvenance"]["sourceFileSHA256"].items():
        require(digest(ROOT / path) == expected, f"source_hash_{path}")
    return manifest, artifact


def validate_static():
    for path in ROOT.rglob("*.json"):
        if ".build" not in path.parts:
            json.loads(path.read_text())
    for path in (ROOT / "bin").iterdir():
        if path.is_file() and path.read_bytes().startswith(b"#!/usr/bin/python3"):
            compile(path.read_text(), str(path), "exec")
    swift_paths = [ROOT / "Sources/AidAdminEmergencyCore/AidAdminEmergencyCore.swift",
                   ROOT / "Sources/AidAdminEmergencyAction/main.swift"]
    swift = "\n".join(path.read_text() for path in swift_paths)
    for forbidden in (r"\bsystem\s*\(", r"\bpopen\s*\(", r"/bin/(?:sh|zsh)"):
        require(re.search(forbidden, swift) is None, f"swift_forbidden_{forbidden}")
    for required in ("O_NOFOLLOW", "deriveEmergencyStandardSudoOwner", "SUDO_UID",
                     "SUDO_USER", "getpwuid", "getpwnam", "/usr/bin/sudo",
                     "/usr/sbin/visudo", "openat", "fstatat", "renameatx_np",
                     "mainSudoersPath", "classifyFullVisudoFailure",
                     "RENAME_EXCL", "sudoers-moved", "marker-created",
                     "revocationOnly", "rollbackRecovery",
                     "runInteractive", "posix_spawn", "isatty", "tcgetpgrp", "getpgid",
                     "exact_managed_grant_absent=true",
                     "recovery_verification_failed", "ROOT_CONTRACT_READY",
                     "EmergencyArtifactExpectations.production"):
        require(required in swift, f"emergency_semantic_{required}")
    require('arguments: ["-c"]' not in swift and
            'arguments: ["-cf", physical(Self.mainSudoersPath)]' in swift,
            "full_visudo_explicit_main_contract")
    interactive = re.search(
        r"public func runInteractive\([\s\S]*?private func cStringVector", swift)
    require(interactive is not None and "Process()" not in interactive.group(0) and
            "Pipe()" not in interactive.group(0) and
            "POSIX_SPAWN_SETPGROUP" not in swift and
            "POSIX_SPAWN_SETSID" not in swift, "interactive_runner_semantics")
    require(re.search(r"\brename\s*\(", swift) is None, "replacing_rename_present")
    tests = (ROOT / "tests/AidAdminEmergencyTests/AidAdminEmergencyTests.swift").read_text()
    for required in ("symlinkMatrix", "hashAndAttestationDriftMatrix",
                     "wrongModeAndOwnerMatrix", "unexpectedStateMatrix",
                     "disablePartialFailureRollbackMatrix",
                     "recoveryPartialFailureRollbackMatrix", "visudoFailureMatrix",
                     "rollbackFailureIsDistinct", "parentTrustAndRaceMatrix",
                     "noReplaceDestinationMatrix", "ownerOrchestrationMatrix",
                     "foregroundPTYIntegration", "runPTYForegroundHelper", "forkpty",
                     "explicitMainVisudoIntegration", "bare_global_visudo_regression",
                     "legacy_owner_permission_check_should_fail",
                     "malformed_included_policy_accepted",
                     "fixture_echo_disabled=true", "pty_process_stopped_or_timed_out",
                     "recovery_verification_failed_rolled_back",
                     "recovery_verification_failed_rollback_failed",
                     "disable_timestamp_clear_failed_state_retained", "revokeWithBrokenRuntime",
                     "noRecursiveOrUnrelatedMutation"):
        require(required in tests, f"emergency_test_semantic_{required}")
    tracked = sorted(IMPLEMENTATION_SCOPE | FINALIZATION_SCOPE)
    text = "\n".join((ROOT / path).read_text(errors="ignore") for path in tracked
                       if (ROOT / path).is_file() and
                       path != "install-bundles/phase-4/aid-admin-emergency/aid-admin-emergency-action")
    require(
        re.search(r"/" + r"Users/[A-Za-z0-9._-]+", text) is None,
        "private_path_retained",
    )
    require(re.search(r"\b(?:serial|hardware_uuid|machine_uuid|hostname)\s*[:=]",
                      text, re.IGNORECASE) is None, "stable_identifier_retained")
    require("Migrate" + "FromWindows" not in text, "external_operational_dependency")
    require("BEGIN " + "PRIVATE KEY" not in text and "NOPASSWD:" + " ALL" not in text,
            "secret_or_broad_sudoers")
    for router in ("ARCHITECTURE.md", "AGENTS.md", "README.md"):
        content = (ROOT / router).read_text()
        for required in (
            VERDICT, MARKER, "review-state: " + VERDICT,
            "integrated-main-state: Phase 4 PASS / L3 Agent-ready",
            "phase4_pass_claimed=false", "l3_claimed=false",
            "phase5_authorized=false", "evidence/phase-4/acceptance.json",
        ):
            require(required in content, f"router_{router}_{required}")
    doctor = (ROOT / "bin/phase4-final-doctor").read_text()
    for required in (
        "ROOT_CONTRACT_READY", "unknown_command_not_denied",
        "generic_sudo_unexpectedly_allowed", "generation_state",
        "phase2_live_doctor", "phase3_acceptance_contract",
        "acceptance_commit_scope", "coordinator_create_single_acceptance_commit",
        "systemMutationsPerformed", "--fixture",
    ):
        require(required in doctor, "final_doctor_semantic_" + required)
    for forbidden in ("shell=True", "os.system", "Popen(", "getpass", "input("):
        require(forbidden not in doctor, "final_doctor_forbidden_" + forbidden)
    require(os.access(ROOT / "bin/build-phase4-emergency-bundle", os.X_OK) and
            os.access(ROOT / "bin/check-phase4-final-probes", os.X_OK) and
            os.access(ROOT / "bin/phase4-final-doctor", os.X_OK),
            "tooling_not_executable")
    require(run([*GIT, "diff", "--check", ACCEPTED_VISUDO_HEAD]).returncode == 0,
            "diff_check")
    require(run([*GIT, "fsck", "--full", "--no-reflogs"]).returncode == 0, "git_fsck")


def negative_behavior(binary):
    cases = [[], ["unknown"], ["disable", "extra"], ["recover", "extra"],
             ["__root-disable"], ["__root-recover"], ["disable;id"], ["$(id)"]]
    environment = {"HOME": "/var/empty", "LANG": "C", "LC_ALL": "C",
                   "PATH": "/usr/bin:/bin", "TMPDIR": "/var/empty",
                   "SECRET_TOKEN": "must-not-appear"}
    values = []
    for arguments in cases:
        result = run([binary, *arguments], env=environment)
        require(result.returncode != 0 and "must-not-appear" not in result.stdout,
                f"negative_action_{arguments}")
        values.append((arguments, result.returncode, result.stdout))
    return values


def validate_builds_and_tests(committed):
    workspace = Path(tempfile.mkdtemp(prefix="phase4-emergency-validation."))
    try:
        generated = workspace / "bundle"
        output = checked([ROOT / "bin/build-phase4-emergency-bundle", "--output", generated])
        build = json.loads(output.splitlines()[-1])
        require(build["result"] == "pass" and build["ownerIdentityRetained"] is False,
                "emergency_two_builds")
        generated_artifact = generated / "aid-admin-emergency-action"
        require(negative_behavior(committed) == negative_behavior(generated_artifact),
                "emergency_rebuilt_behavior")
        tests = workspace / "aid-admin-emergency-tests"
        checked(["/usr/bin/swiftc", "-O", "-parse-as-library",
                 ROOT / "Sources/AidAdminEmergencyCore/AidAdminEmergencyCore.swift",
                 ROOT / "tests/AidAdminEmergencyTests/AidAdminEmergencyTests.swift",
                 "-o", tests])
        test_value = json.loads(checked([tests]).splitlines()[-1])
        require(test_value == {"provenanceCases": 12, "result": "pass", "tests": 16},
                "emergency_fixture_matrix")

        owner = pwd.getpwuid(os.getuid()).pw_name
        require(re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", owner) is not None,
                "owner_identity_class")
        template = (ROOT / "policy/sudoers.d/agent-first-mac-aid-admin").read_text()
        rendered = workspace / "rendered-sudoers"
        rendered.write_text(template.replace("@@AGENT_OWNER@@", owner))
        rendered.chmod(0o440)
        require(run(["/usr/sbin/visudo", "-cf", rendered]).returncode == 0 and
                digest(rendered) == SUDOERS_SHA256 and rendered.stat().st_size == 122,
                "ephemeral_exact_owner_visudo")
        component_scratch = workspace / "accepted-component-scratch"
        broker_tests = checked([
            "/usr/bin/swift", "run", "-c", "release", "--scratch-path",
            component_scratch, "aid-admin-tests",
        ])
        bootstrap_tests = checked([
            "/usr/bin/swift", "run", "-c", "release", "--scratch-path",
            component_scratch, "aid-admin-bootstrap-tests",
        ])
        require('{"result":"pass","tests":15}' in broker_tests,
                "accepted_broker_tests")
        require('{"invokerSemanticCases":20,"result":"pass","tests":14}' in
                bootstrap_tests, "accepted_bootstrap_tests")
        return {"acceptedBootstrapFixtureGroups": 14,
                "acceptedBootstrapInvokerSemanticCases": 20,
                "acceptedBrokerTests": 15,
                "behaviorCases": 8, "fixtureGroups": 16, "provenanceCases": 12,
                "twoCleanBuilds": True, "visudo": True,
                "generatedArtifactSHA256": digest(generated_artifact)}
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def live_file(path, mode, size, sha256=None):
    value = Path(path)
    facts = value.lstat()
    require(stat.S_ISREG(facts.st_mode) and not value.is_symlink() and facts.st_uid == 0 and
            facts.st_gid == 0 and stat.S_IMODE(facts.st_mode) == mode and
            facts.st_size == size, f"live_file_{value.name}")
    if sha256 is not None:
        require(digest(value) == sha256, f"live_hash_{value.name}")


def live_directory(path, mode):
    value = Path(path)
    facts = value.lstat()
    require(stat.S_ISDIR(facts.st_mode) and not value.is_symlink() and
            facts.st_uid == 0 and facts.st_gid == 0 and
            stat.S_IMODE(facts.st_mode) == mode, f"live_directory_{value.name}")
    return facts


def generation_targets():
    profile = Path("/nix/var/nix/profiles/system")
    result = {}
    for path in profile.parent.glob("system-*-link"):
        match = re.fullmatch(r"system-([1-9][0-9]{0,8})-link", path.name)
        if match:
            result[int(match.group(1))] = path.resolve(strict=True)
    return result


def validate_live():
    canonical_etc = live_directory("/private/etc", 0o755)
    canonical_sudoers = live_directory("/private/etc/sudoers.d", 0o755)
    logical_sudoers = Path("/etc/sudoers.d").stat()
    require(canonical_sudoers.st_dev == logical_sudoers.st_dev and
            canonical_sudoers.st_ino == logical_sudoers.st_ino,
            "live_sudoers_directory_alias")
    main_sudoers = Path("/private/etc/sudoers").lstat()
    require(stat.S_ISREG(main_sudoers.st_mode) and main_sudoers.st_uid == 0 and
            main_sudoers.st_gid == 0 and stat.S_IMODE(main_sudoers.st_mode) == 0o440 and
            0 < main_sudoers.st_size <= 64 * 1024 and canonical_etc.st_ino > 0,
            "live_main_sudoers_metadata")
    declarative = Path("/private/etc/sudoers.d/10-nix-darwin-extra-config")
    require(declarative.is_symlink(), "live_declarative_include_link")
    intermediate = Path(os.readlink(declarative))
    require(intermediate.is_symlink(), "live_declarative_include_chain")
    target = intermediate.resolve(strict=True)
    target_facts = target.lstat()
    require(str(target).startswith("/nix/store/") and stat.S_ISREG(target_facts.st_mode) and
            target_facts.st_uid == 0 and target_facts.st_gid == 0 and
            stat.S_IMODE(target_facts.st_mode) == 0o444,
            "live_declarative_include_target")
    live_file("/usr/local/libexec/aid-admin", 0o555, 483712, BROKER_SHA256)
    live_file("/etc/agent-first-mac/aid-admin-policy.json", 0o444, 1617, POLICY_SHA256)
    live_file("/etc/agent-first-mac/aid-admin-install.json", 0o400, 341)
    live_file("/etc/sudoers.d/agent-first-mac-aid-admin", 0o440, 122)
    require(not os.path.lexists("/etc/agent-first-mac/aid-admin.disabled") and
            not os.path.lexists("/etc/sudoers.d/agent-first-mac-aid-admin.disabled"),
            "unexpected_disabled_state")
    receipt = Path.home() / "AIDev/state/phase-4/apply-receipts" / f"{CONTROL_MAIN}.json"
    facts = receipt.lstat()
    require(stat.S_ISREG(facts.st_mode) and not receipt.is_symlink() and
            facts.st_uid == os.getuid() and stat.S_IMODE(facts.st_mode) == 0o400 and
            facts.st_size == 431 and digest(receipt) == RECEIPT_SHA256, "live_receipt")
    receipt_value = json.loads(receipt.read_text())
    targets = generation_targets()
    current = Path("/nix/var/nix/profiles/system")
    require(set(targets) == {1, 2, 3} and Path(os.readlink(current)).name == "system-3-link" and
            current.resolve(strict=True) == targets[3] ==
            Path("/run/current-system").resolve(strict=True), "live_generation_state")
    require(digest_text(str(targets[2])) == PREVIOUS_PATH_SHA256 and
            digest_text(str(targets[3])) == TARGET_PATH_SHA256 and
            targets[3] == Path(receipt_value["targetSystemPath"]).resolve(strict=True),
            "live_generation_binding")
    audit = Path("/var/log/agent-first-mac/aid-admin").lstat()
    staging = Path("/var/db/agent-first-mac/staging").lstat()
    require(stat.S_ISDIR(audit.st_mode) and audit.st_uid == audit.st_gid == 0 and
            stat.S_IMODE(audit.st_mode) == 0o700 and audit.st_size == 192,
            "live_audit_already_current")
    require(stat.S_ISDIR(staging.st_mode) and staging.st_uid == staging.st_gid == 0 and
            stat.S_IMODE(staging.st_mode) == 0o700 and staging.st_size == 160,
            "live_staging_already_current")
    accepted = strict_json(EMERGENCY_EVIDENCE)
    require(accepted["idempotence"]["rootDoctorHumanAndJSON"] == "ROOT_CONTRACT_READY",
            "accepted_root_doctor_baseline")
    processes = checked(["/bin/ps", "-axo", "comm="])
    blocked = {"aid-admin", "sudo", "nix-env", "darwin-rebuild",
               "aid-admin-bootstrap", "aid-admin-emergency-action"}
    require(not any(Path(line.strip()).name in blocked for line in processes.splitlines()),
            "stale_process")
    return {"auditSize": 192, "stagingSize": 160, "currentGeneration": 3,
            "canonicalMainSudoersMetadata": True,
            "declarativeReadOnlySymlinkInclude": True,
            "acceptedRootDoctorBaseline": "ROOT_CONTRACT_READY",
            "rootDoctorReexecuted": False}


def validate_phase3_compatibility():
    for relative, expected in PHASE3_HASHES.items():
        require(digest(ROOT / relative) == expected,
                "phase3_hash_" + Path(relative).stem)
    acceptance = strict_json(ROOT / "evidence/phase-3/permissions-acceptance.json")
    verification = strict_json(
        ROOT / "evidence/phase-3/permissions-apply-verification.json")
    require(acceptance["schema"] == 1 and
            acceptance["phase"] == "phase3_permission_ceremony" and
            acceptance["gate"]["verdict"] == "PASS" and
            acceptance["gate"]["phase3_complete"] is True and
            acceptance["gate"]["l3_claimed"] is False,
            "phase3_acceptance_contract")
    require(verification["scope"] == {
        "aid_admin_or_root_broker_mutated": False,
        "backup_or_cloud_mutated": False,
        "hooks_skills_or_codex_config_mutated": False,
        "repository_migration_or_next_phase_started": False,
        "vpn_profile_or_session_mutated": False,
    } and verification["gate"]["phase3_pass_claimed"] is False,
            "phase3_verification_contract")
    return True


def validate_compatibility(repository_state):
    control = (
        ROOT
        if repository_state.startswith("accepted_")
        else Path.home() / "AIDev/control"
    )
    if repository_state == "review":
        require(git("rev-parse", "HEAD", cwd=control) == CONTROL_MAIN and
                git("branch", "--show-current", cwd=control) == "main" and
                git("status", "--porcelain=v1", cwd=control) == "",
                "protected_control_main")
        lines = git("worktree", "list", "--porcelain", cwd=control).splitlines()
        for line in lines:
            if not line.startswith("worktree "):
                continue
            worktree = Path(line.removeprefix("worktree "))
            if worktree.resolve() == ROOT.resolve():
                continue
            require(git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=worktree) == "", "protected_worktree_dirty_" + worktree.name)
        checked([control / "bin/check-phase2a"], cwd=control)
    doctor_one = checked([control / "bin/phase2-doctor", "--json"], cwd=control)
    doctor_two = checked([control / "bin/phase2-doctor", "--json"], cwd=control)
    require(doctor_one == doctor_two and strict_json_text(doctor_one)["verdict"] == "PASS",
            "phase2_doctor")
    require(digest(ROOT / "evidence/phase-2/acceptance.json") ==
            "3032fa9bd817ebc16d9917ae413b298469eeb998630d861164e030f1a1d811e6",
            "phase2_acceptance_hash")
    require(validate_phase3_compatibility(), "phase3_compatibility")
    return {
        "phase2DoctorSHA256": hashlib.sha256(doctor_one.encode()).hexdigest(),
        "phase2StaticValidator": repository_state == "review",
        "phase3AcceptanceCompatibility": True,
    }


def strict_json_text(text):
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            require(key not in value, "duplicate_runtime_json_key")
            value[key] = item
        return value

    return json.loads(text, object_pairs_hook=unique_object)


def positive_doctor_fixture():
    return {
        "artifactBindings": True,
        "auditAndStagingBounded": True,
        "emergencyEnabledState": True,
        "generation3Current": True,
        "genericSudoDenied": True,
        "noRelevantProcess": True,
        "phase2AcceptedLiveDoctor": True,
        "phase3AcceptedEvidence": True,
        "previousGenerationAvailable": True,
        "rootContractReady": True,
        "unknownCommandDenied": True,
    }


def write_doctor_fixture(path, overrides=None):
    checks = positive_doctor_fixture()
    checks.update(overrides or {})
    path.write_text(json.dumps({"checks": checks, "schema": 1},
                               indent=2, sort_keys=True) + "\n")


def doctor_result(repository, fixture, *arguments, environment=None):
    return run([repository / "bin/phase4-final-doctor", *arguments,
                "--fixture", fixture], cwd=repository, env=environment)


def validate_final_doctor(repository_state, fixture=None):
    command = [ROOT / "bin/phase4-final-doctor"]
    if fixture is not None:
        command += ["--fixture", fixture]
    human = checked(command)
    first = checked([*command, "--json"])
    second = checked([*command, "--json"])
    value = strict_json_text(first)
    accepted = repository_state.startswith("accepted_")
    expected = "PASS" if accepted else VERDICT
    require(first == second and value["verdict"] == expected and
            value["readOnly"] is True and value["systemMutationsPerformed"] is False and
            not value["problems"] and expected in human,
            "final_doctor_stability")
    require(value["phase4PassClaimed"] is accepted and
            value["l3Claimed"] is accepted and
            value["phase5Authorized"] is False,
            "final_doctor_conditional_status")
    return {
        "jsonSHA256": hashlib.sha256(first.encode()).hexdigest(),
        "repositoryState": repository_state,
        "verdict": value["verdict"],
    }


def validate_doctor_fixture_matrix(repository):
    workspace = Path(tempfile.mkdtemp(prefix="phase4-final-doctor-matrix."))
    try:
        positive = workspace / "positive.json"
        write_doctor_fixture(positive)
        human = doctor_result(repository, positive)
        first = doctor_result(repository, positive, "--json")
        second = doctor_result(repository, positive, "--json")
        require(human.returncode == first.returncode == second.returncode == 0 and
                first.stdout == second.stdout and
                strict_json_text(first.stdout)["verdict"] in {VERDICT, "PASS"},
                "doctor_positive_fixture")
        negative_cases = {
            "root_doctor_failure": {"rootContractReady": False},
            "disabled_marker": {"emergencyEnabledState": False},
            "disabled_sibling": {"emergencyEnabledState": False},
            "generation_drift": {"generation3Current": False},
            "hash_drift": {"artifactBindings": False},
            "generic_sudo_broad": {"genericSudoDenied": False},
            "unknown_command_accepted": {"unknownCommandDenied": False},
            "relevant_process": {"noRelevantProcess": False},
        }
        for name, overrides in negative_cases.items():
            fixture = workspace / (name + ".json")
            write_doctor_fixture(fixture, overrides)
            result = doctor_result(repository, fixture, "--json")
            require(result.returncode != 0 and
                    strict_json_text(result.stdout)["verdict"] == "BLOCKED",
                    "doctor_negative_" + name)
        return {"positiveCases": 1, "negativeCases": len(negative_cases),
                "stableJSON": True}
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def validate_current_main_fact_matrix(repository, runner_route=False,
                                      case_recorder=None):
    """Exercise the production current-main validator with bounded pure facts."""
    workspace = Path(tempfile.mkdtemp(prefix="phase4-current-main-receipt."))
    try:
        loader = importlib.machinery.SourceFileLoader(
            "phase4_final_doctor_fixture",
            str(repository / "bin/phase4-final-doctor"),
        )
        module = types.ModuleType(loader.name)
        module.__file__ = loader.path
        loader.exec_module(module)

        def write(path, contents="receipt"):
            path.write_text(contents)
            path.chmod(0o400)
            return path

        def rejected(path, name):
            try:
                module.current_main_receipt_file(path)
            except RuntimeError as error:
                require(str(error) == "current_main_receipt_file",
                        "current_main_receipt_reason_" + name)
                return
            raise RuntimeError("current_main_receipt_accepted_" + name)

        positive = write(workspace / "positive.json")
        require(module.current_main_receipt_file(positive) == positive,
                "current_main_receipt_positive")

        hard_link = workspace / "hard-link.json"
        os.link(positive, hard_link)
        require(positive.lstat().st_nlink == 2,
                "current_main_receipt_hard_link_fixture")
        rejected(positive, "hard_link")
        hard_link.unlink()

        symlink_target = write(workspace / "symlink-target.json")
        symlink = workspace / "receipt-symlink.json"
        symlink.symlink_to(symlink_target)
        rejected(symlink, "symlink")

        mode = write(workspace / "wrong-mode.json")
        mode.chmod(0o600)
        rejected(mode, "mode")

        empty = write(workspace / "empty.json", "")
        rejected(empty, "empty")

        oversized = write(workspace / "oversized.json", "x" * 4097)
        rejected(oversized, "oversized")
        sources = module.strict_json(repository / "manifests/package-sources.json")["sources"]
        darwin, nixpkgs = sources["nix_darwin"]["revision"], sources["nixpkgs"]["revision"]
        commit = module.RUNNER_GATE_CONTROL if runner_route else "a2a607956745ca9a3f85960b3da0b98463a33880"
        target = {"gid": 0, "kind": "directory", "mode": 0o555,
                  "path": "/nix/store/current-fixture", "substituted": False, "uid": 0}
        def facts():
            return {
                "artifacts": {"broker": True, "policy": True, "sudoers": True},
                "directories": {"audit": {"gid": 0, "kind": "directory", "mode": 0o700, "symlink": False, "uid": 0},
