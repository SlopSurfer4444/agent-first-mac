            return denied
        for name in ambient_surfaces:
            restored.append((name, getattr(module, name)))
            setattr(module, name, ambient_denied(name))
        try:
            require(module.validate_historical_phase2_doctor_output(
                phase2_one, phase2_two), "historical_phase2_positive")
            def phase2_rejected(name, mutate, *, repeat=False):
                value = module.strict_json_text(phase2_one)
