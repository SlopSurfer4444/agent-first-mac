        if case_recorder is not None:
            case_recorder("phase4-raw-generation-intermediate")
        require(module.current_main_process_names("/usr/local/libexec/aid-admin-emergency-action\n") == ["aid-admin-emergency-action"],
                "raw_emergency_action_process")
        if case_recorder is not None:
            case_recorder("phase4-raw-emergency-action-process")
        def fact_rejected(name, mutate):
            value = facts()
            mutate(value)
            observed_commands = []
            original_run = module.run
            if name == "receipt_unknown_revision":
                def observed_run(argv, *arguments, **keywords):
                    observed_commands.append(tuple(str(item) for item in argv))
                    return original_run(argv, *arguments, **keywords)
                module.run = observed_run
            try:
                module.validate_current_main_facts(value, repository, runner_route=runner_route)
            except RuntimeError as error:
                if name == "receipt_unknown_revision":
                    require(str(error) == "current_main_receipt_bindings" and
                            len(observed_commands) == 1 and
                            "cat-file" in observed_commands[0] and
                            observed_commands[0][-2:] ==
                                ("-e", "f" * 40 + "^{commit}") and
                            not any("merge-base" in command
                                    for command in observed_commands),
                            "current_main_receipt_missing_object")
                if case_recorder is not None:
                    exact_name = {
                        "version_link_wrong_mode": "version-file-writable",
                        "version_link_wrong_type": "version-file-wrong-type",
                        "version_link_wrong_mode_0777":
                            "version-link-mode-0777",
                        "version_link_wrong_mode_other":
                            "version-link-mode-other",
                        "collector_emergency_marker_present":
                            "collector-emergency-marker",
                        "collector_emergency_action_process":
                            "emergency-process",
                        "generic_sudo_true_allowed": "generic-sudo-true",
                        "generic_sudo_validate_allowed":
                            "generic-sudo-validate",
                        "historical_generation2_drift":
                            "generation2-drift",
                        "historical_generation3_drift":
                            "generation3-drift",
                        "runner_target_current20": "target-current-20",
                        "runner_receipt_515": "receipt-owner-parent",
                        "runner_nar": "wrong-nar",
                        "runner_version": "wrong-version",
                        "runner_revision": "wrong-revision",
                    }.get(name, name.replace("_", "-"))
                    prefix = "phase4-runner-" if name.startswith("runner_") \
                        else "phase4-fact-"
                    case_recorder(prefix + exact_name.removeprefix("runner-"))
                return
            finally:
                module.run = original_run
            raise RuntimeError("current_main_fact_accepted_" + name)
        cases = {
            "profile_current_mismatch": lambda value: value.update(profileTarget="/nix/store/other"),
            "receipt_missing": lambda value: value["receipt"].pop("reviewed"),
            "receipt_malformed": lambda value: value["receipt"].update(schema=2),
            "receipt_unknown_revision": lambda value: value["receipt"].update(controlCommit="f" * 40),
            "receipt_non_ancestor": lambda value: value["receipt"].update(controlCommit="217602def502f515f5c0c554f1d4c1d0aaabcb26"),
            "receipt_wrong_tree": lambda value: value["receipt"].update(controlTree="0" * 40),
            "receipt_wrong_policy": lambda value: value["receipt"].update(policyHash="0" * 64),
            "receipt_wrong_target": lambda value: value["receipt"].update(targetSystemPath="/nix/store/other"),
            "receipt_wrong_nar": lambda value: value.update(narHash="sha256-wrong"),
            "receipt_symlink": lambda value: value["receiptFile"].update(symlink=True),
            "receipt_hardlink": lambda value: value["receiptFile"].update(nlink=2),
            "receipt_wrong_owner": lambda value: value["receiptFile"].update(owner="other"),
            "receipt_wrong_mode": lambda value: value["receiptFile"].update(mode=0o600),
            "receipt_wrong_size": lambda value: value["receiptFile"].update(sizeBounded=False),
            "version_missing": lambda value: value["versionValue"].pop("darwinLabel"),
            "version_extra": lambda value: value["versionValue"].update(extra=True),
            "version_malformed": lambda value: value["versionValue"].update(configurationRevision="not-a-revision"),
            "version_wrong_configuration": lambda value: value["versionValue"].update(configurationRevision="5e130deb88175ba596fa5a5a45cc5c9c896ef37d"),
            "version_wrong_darwin": lambda value: value["versionValue"].update(darwinRevision="0" * 40),
            "version_wrong_nixpkgs": lambda value: value["versionValue"].update(nixpkgsRevision="0" * 40),
            "version_wrong_label": lambda value: value["versionValue"].update(darwinLabel="wrong"),
            "target_outside_store": lambda value: value["target"].update(path="/tmp/current"),
            "target_substituted": lambda value: value["target"].update(substituted=True),
            "target_writable": lambda value: value["target"].update(mode=0o775),
            "target_wrong_owner": lambda value: value["target"].update(uid=501),
            "target_wrong_type": lambda value: value["target"].update(kind="file"),
            "version_link_escape": lambda value: value["versionFile"].update(parent="/tmp"),
            "version_link_wrong_owner": lambda value: value["versionLink"].update(uid=501),
            "version_link_wrong_mode_0777": lambda value: value["versionLink"].update(mode=0o777),
            "version_link_wrong_mode_other": lambda value: value["versionLink"].update(mode=0o700),
            "version_link_wrong_mode": lambda value: value["versionFile"].update(modeWritable=True),
            "version_link_wrong_type": lambda value: value["versionFile"].update(kind="directory"),
            "historical_generation2_drift": lambda value: value["historicalTargets"].update(generation2PathSHA256="0" * 64),
            "historical_generation3_drift": lambda value: value["historicalTargets"].update(generation3PathSHA256="0" * 64),
            "broker_failure": lambda value: value["artifacts"].update(broker=False),
            "policy_failure": lambda value: value["artifacts"].update(policy=False),
            "sudoers_failure": lambda value: value["artifacts"].update(sudoers=False),
            "emergency_failure": lambda value: value.update(emergencyEnabled=False),
            "collector_emergency_marker_present": lambda value: value.update(emergencyEnabled=False),
            "root_doctor_failure": lambda value: value["rootDoctor"].update(returncode=1),
            "root_doctor_unbounded": lambda value: value["rootDoctor"].update(outputBounded=False),
            "root_doctor_schema": lambda value: value["rootDoctor"]["value"].update(schema=2),
            "unknown_command_failure": lambda value: value["unknownCommandDenied"].update(returncode=0),
            "unknown_command_unbounded": lambda value: value["unknownCommandDenied"].update(outputBounded=False),
            "unknown_command_reason": lambda value: value["unknownCommandDenied"].update(reason="other"),
            "generic_sudo_true_allowed": lambda value: value["genericSudoDenied"].update(trueDenied=False),
            "generic_sudo_validate_allowed": lambda value: value["genericSudoDenied"].update(validateDenied=False),
            "phase2_failure": lambda value: value.update(phase2Accepted=False),
            "phase3_failure": lambda value: value.update(phase3Accepted=False),
            "collector_emergency_action_process": lambda value: value.update(processes=["aid-admin-emergency-action"]),
            "audit_symlink": lambda value: value["directories"]["audit"].update(symlink=True),
            "audit_wrong_type": lambda value: value["directories"]["audit"].update(kind="file"),
            "audit_wrong_owner": lambda value: value["directories"]["audit"].update(uid=501),
            "audit_wrong_group": lambda value: value["directories"]["audit"].update(gid=20),
            "audit_wrong_mode": lambda value: value["directories"]["audit"].update(mode=0o755),
            "staging_symlink": lambda value: value["directories"]["staging"].update(symlink=True),
            "staging_wrong_type": lambda value: value["directories"]["staging"].update(kind="file"),
            "staging_wrong_owner": lambda value: value["directories"]["staging"].update(uid=501),
            "staging_wrong_group": lambda value: value["directories"]["staging"].update(gid=20),
            "staging_wrong_mode": lambda value: value["directories"]["staging"].update(mode=0o755),
        }
        for name, mutate in cases.items():
            fact_rejected(name, mutate)
        if runner_route:
            runner_cases = {
                "runner_missing_20": lambda value: value["targets"].pop(20),
                "runner_missing_21": lambda value: value["targets"].pop(21),
                "runner_wrong_20": lambda value: value["targets"][20].update(uid=501),
                "runner_wrong_21": lambda value: value["targets"][21].update(uid=501),
                "runner_target_current20": lambda value: value.update(target=value["targets"][20].copy(), profileTarget=value["targets"][20]["path"]),
                "runner_20_equals_21": lambda value: value["targets"][20].update(path=value["targets"][21]["path"]),
                "runner_later_22": lambda value: value["targets"].update({22: value["target"].copy()}),
                "runner_receipt_515": lambda value: value["receipt"].update(controlCommit=module.RUNNER_GATE_OWNER_PARENT),
                "runner_receipt_intermediate": lambda value: value["receipt"].update(controlCommit="6bf2e2f66e81c1acbdfeaa6e84d2c882ca4bd540"),
                "runner_receipt_wrong_commit": lambda value: value["receipt"].update(controlCommit="0" * 40),
                "runner_receipt_wrong_tree": lambda value: value["receipt"].update(controlTree="0" * 40),
                "runner_receipt_wrong_target": lambda value: value["receipt"].update(targetSystemPath="/nix/store/other"),
                "runner_nar": lambda value: value.update(narHash="sha256-wrong"),
                "runner_version": lambda value: value["versionValue"].update(darwinLabel="wrong"),
                "runner_revision": lambda value: value["versionValue"].update(configurationRevision=module.RUNNER_GATE_OWNER_PARENT),
            }
            for name, mutate in runner_cases.items():
                fact_rejected(name, mutate)

            # Replace objects only inside an isolated no-origin clone.  These
            # tests reach the production validator's owner-chain reads rather
            # than claiming an owner-history case through unrelated drift.
            owner_clone = workspace / "runner-owner-history"
            checked([*GIT, "clone", "--no-local", "--quiet", repository, owner_clone])
            checked([*GIT, "remote", "remove", "origin"], cwd=owner_clone)
            def owner_rejected(name, object_name, tree, parent):
                replacement = checked([*GIT, "commit-tree", tree, "-p", parent,
                                       "-m", "owner substitution"], cwd=owner_clone).strip()
                checked([*GIT, "replace", object_name, replacement], cwd=owner_clone)
                sentinel = object()
                prior = os.environ.pop("GIT_NO_REPLACE_OBJECTS", sentinel)
                try:
                    module.validate_current_main_facts(facts(), owner_clone, runner_route=True)
                except RuntimeError:
                    if case_recorder is not None:
                        case_recorder("runner-owner-history-" + name)
                    return
                else:
                    raise RuntimeError("runner_owner_history_accepted_" + name)
                finally:
                    if prior is sentinel:
                        os.environ.pop("GIT_NO_REPLACE_OBJECTS", None)
                    else:
                        os.environ["GIT_NO_REPLACE_OBJECTS"] = prior
                    deleted = run([*GIT, "replace", "-d", object_name],
                                  cwd=owner_clone)
                    require(deleted.returncode == 0 and
                            git("replace", "-l", cwd=owner_clone) == "",
                            "runner_owner_history_cleanup_" + name)
            owner_rejected("parent", module.RUNNER_GATE_CONTROL,
                           module.git("rev-parse", module.RUNNER_GATE_CONTROL + "^{tree}", cwd=owner_clone),
                           "6bf2e2f66e81c1acbdfeaa6e84d2c882ca4bd540")
            owner_rejected("scope", module.RUNNER_GATE_OWNER_PARENT,
                           module.git("rev-parse", "6bf2e2f66e81c1acbdfeaa6e84d2c882ca4bd540^{tree}", cwd=owner_clone),
                           module.git("rev-parse", "6bf2e2f66e81c1acbdfeaa6e84d2c882ca4bd540^", cwd=owner_clone))
            cases.update(runner_cases)
        raw_case_ids = ["generic_true_allowed", "generic_validate_allowed", "root_extra", "root_malformed",
                        "root_minimal", "root_unbounded", "unknown_rc", "unknown_reason", "unknown_prefix",
                        "unknown_suffix", "unknown_extra", "unknown_newline_drift", "unknown_unbounded",
                        "emergency_marker", "generation_dot", "generation_double_separator", "generation_parent_escape",
                        "generation_relative", "generation_trailing_slash", "generation_store_escape",
                        "generation_final_symlink", "generation_bridge", "generation_intermediate", "emergency_action_process"]
        return {"caseIDs": sorted(cases), "closedCaseCount": len(cases), "collectorRawCaseIDs": raw_case_ids,
                "collectorRawNegativeCases": 24, "positiveCases": 1,
                "historicalPhase2DoctorNegativeCases": 7,
                "historicalPhase2AmbientCaseIDs": list(ambient_surfaces),
                "historicalPhase2AmbientCases": len(ambient_surfaces),
                "historicalPhase2AmbientCalls": len(ambient_calls),
                "receiptFilesystemNegativeCases": 5, "realHardLinkRejected": True,
                "secureDirectoriesDifferentHistoricalSizes": True}
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def acceptance_value(reviewed_head, implementation, **overrides):
    value = {
        "acceptedOn": "2026-07-17",
        "coordinatorReview": {
            "componentValidator": "PASS",
            "emergencyDisableRecoveryVerified": True,
            "finalDoctor": "PASS",
            "liveStateVerified": True,
            "repositoryContractVerified": True,
            "selfReportIsAcceptance": False,
        },
        "gate": {
            "acceptedLevel": ACCEPTED_LEVEL,
            "backupDeferredAcceptedRisk": True,
            "l3Claimed": True,
            "phase4Complete": True,
            "phase4PassClaimed": True,
            "phase5Authorized": False,
            "verdict": "PASS",
        },
        "phase": "phase4_typed_root_broker",
        "reviewMarker": MARKER,
        "reviewedFinalizationHead": reviewed_head,
        "reviewedImplementationCommit": implementation,
        "schema": 1,
        "systemMutationDuringAcceptance": False,
    }
    for key, item in overrides.items():
        if key.startswith("gate_"):
            value["gate"][key.removeprefix("gate_")] = item
        else:
            value[key] = item
    return value


def fixture_environment(directory, identity):
    return {
        "GIT_AUTHOR_EMAIL": identity[1],
        "GIT_AUTHOR_NAME": identity[0],
        "GIT_COMMITTER_EMAIL": identity[3],
        "GIT_COMMITTER_NAME": identity[2],
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "HOME": str(directory),
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
    }


def fixture_commit(directory, message, identity=EXECUTOR_METADATA, allow_empty=False):
    arguments = [*GIT, "commit", "-q", "--no-gpg-sign", "-m", message]
    if allow_empty:
        arguments.insert(-2, "--allow-empty")
    checked(
        arguments,
        cwd=directory,
        env=fixture_environment(directory, identity),
    )


def validate_git_matrix(reviewed_head, implementation):
    workspace = Path(tempfile.mkdtemp(prefix="phase4-final-git-matrix."))
    isolated_home = workspace / "isolated-home"
    isolated_home.mkdir()
    isolated_environment = {
        "HOME": str(isolated_home),
        "LC_ALL": "C",
        "LANG": "C",
        "PATH": "/usr/bin:/bin",
    }
    source_branch = git("branch", "--show-current")
    current_head = git("rev-parse", "HEAD")
    negative_cases = 0

    def clone(name):
        destination = workspace / name
        checked([
            *GIT, "clone", "--no-local", "--quiet", "--branch",
            source_branch, ROOT, destination,
        ])
        checked([*GIT, "remote", "remove", "origin"], cwd=destination)
        require(git("rev-parse", "HEAD", cwd=destination) == current_head,
                "clone_correction_head")
        return destination

    def validator(directory, argument="--git-only", environment=None):
        return run([directory / "bin/check-phase4-final-probes", argument],
                   cwd=directory, env=environment)

    def rejected(action, reason):
        nonlocal negative_cases
        try:
            action()
        except (RuntimeError, ValueError, KeyError, TypeError):
            negative_cases += 1
            return
        raise RuntimeError("phase4_topology_negative_accepted_" + reason)

    def rejected_reason(action, reason, name):
        nonlocal negative_cases
        try:
            action()
        except (RuntimeError, ValueError, KeyError, TypeError) as error:
            require(str(error) == reason, "unstable_reason_" + name)
            negative_cases += 1
            return
        raise RuntimeError("phase4_topology_negative_accepted_" + name)

    def validator_rejected(directory, reason, name):
        nonlocal negative_cases
        result = validator(directory)
        require(
            result.returncode != 0
            and strict_json_text(result.stdout)
            == {"reason": reason, "result": "fail"},
            "unstable_validator_reason_" + name,
        )
        negative_cases += 1

    def commit_path_drift(
            name, relative, *, delete=False, expected_reason=None):
        directory = clone(name)
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=directory)
        path = directory / relative
        if delete:
            path.unlink()
        elif relative.startswith("bin/"):
            path.write_text(
                path.read_text() + "# synthetic harmless drift\n"
            )
        else:
            text = path.read_text()
            require('"schema": 1' in text, "json_drift_fixture")
            path.write_text(text.replace('"schema": 1', '"schema": 2', 1))
        checked([*GIT, "add", "-A", "--", relative], cwd=directory)
        fixture_commit(directory, "Synthetic protected descendant drift")
        validator_rejected(
            directory,
            expected_reason or "protected_descendant_drift:" + relative,
            name,
        )
        return directory

    def candidate(
            name, *, value=None, raw=None, extra=False,
            identity=COORDINATOR_METADATA, wrong_parent=False, include=True):
        directory = clone(name)
        checked([
            *GIT, "checkout", "-q", "-B", "fixture", ACCEPTED_REVIEWED_HEAD,
        ], cwd=directory)
        if wrong_parent:
            fixture_commit(
                directory, "Intervening Phase 4 fixture", allow_empty=True)
        paths = []
        if include:
            acceptance = directory / "evidence/phase-4/acceptance.json"
            acceptance.write_text(
                raw
                if raw is not None
                else json.dumps(
                    value or acceptance_value(reviewed_head, implementation),
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            )
            paths.append("evidence/phase-4/acceptance.json")
        if extra:
            (directory / "unexpected-acceptance-file").write_text("unexpected\n")
            paths.append("unexpected-acceptance-file")
        if paths:
            checked([*GIT, "add", "--", *paths], cwd=directory)
        fixture_commit(
            directory,
            "Synthetic Phase 4 acceptance",
            identity=identity,
            allow_empty=not paths,
        )
        return directory, git("rev-parse", "HEAD", cwd=directory)

    try:
        clean = clone("clean")
        require(validator(clean, "--clone", isolated_environment).returncode == 0,
                "clean_no_origin_clone_full")
        marker = workspace / "malicious-git-executed"
        malicious = clean / ".git/malicious-fsmonitor"
        malicious.write_text("#!/bin/sh\n/usr/bin/touch '" + str(marker) + "'\nexit 0\n")
        malicious.chmod(0o755)
        hook = clean / ".git/hooks/post-checkout"
        hook.write_text("#!/bin/sh\n/usr/bin/touch '" + str(marker) + "'\nexit 0\n")
        hook.chmod(0o755)
        checked([*GIT, "config", "core.fsmonitor", str(malicious)], cwd=clean)
        checked([*GIT, "config", "core.hooksPath", str(clean / ".git/hooks")], cwd=clean)
        require(validator(clean, "--clone-git-only", isolated_environment).returncode == 0 and
                not marker.exists(), "malicious_git_config_executed")
        doctor_matrix = validate_doctor_fixture_matrix(clean)

        dirty = clone("dirty")
        (dirty / "dirty").write_text("dirty\n")
        validator_rejected(dirty, "dirty_worktree", "dirty")

        detached = clone("detached")
        checked([*GIT, "checkout", "-q", "--detach"], cwd=detached)
        validator_rejected(
            detached, "wrong_or_detached_branch", "detached"
        )

        wrong = clone("wrong-branch")
        checked([*GIT, "checkout", "-q", "-b", "unexpected"], cwd=wrong)
        validator_rejected(
            wrong, "wrong_or_detached_branch", "wrong-branch"
        )

        original = clone("original-acceptance")
        validate_phase4_acceptance_object(original, ACCEPTANCE_COMMIT)
        checked([
            *GIT, "checkout", "-q", "-B", "fixture-main", ACCEPTANCE_COMMIT,
        ], cwd=original)
        validate_phase4_descendant(original)

        accepted = clone("accepted-main-descendant")
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=accepted)
        accepted_output = validator(accepted, "--clone-git-only", isolated_environment)
        require(
            accepted_output.returncode == 0
            and strict_json_text(accepted_output.stdout)["verdict"] == "PASS",
            "synthetic_accepted_main_descendant",
        )
        fixture_commit(accepted, "Future descendant one", allow_empty=True)
        require(validator(accepted, "--clone-git-only").returncode == 0,
                "one_descendant_rejected")
        fixture_commit(accepted, "Future descendant two", allow_empty=True)
        require(validator(accepted, "--clone-git-only").returncode == 0,
                "two_descendants_rejected")
        accepted_fixture = workspace / "accepted-fixture.json"
        write_doctor_fixture(accepted_fixture)
        accepted_doctor = doctor_result(accepted, accepted_fixture, "--json")
        require(accepted_doctor.returncode == 0 and
                strict_json_text(accepted_doctor.stdout)["verdict"] == "PASS",
                "synthetic_accepted_main_doctor")

        missing, missing_commit = candidate("missing-acceptance", include=False)
        rejected(
            lambda: validate_phase4_acceptance_object(missing, missing_commit),
            "missing_acceptance",
        )
        tampered, tampered_commit = candidate(
            "tampered-acceptance",
            value=acceptance_value(
                reviewed_head, implementation, gate_phase5Authorized=True),
        )
        rejected(
            lambda: validate_phase4_acceptance_object(tampered, tampered_commit),
            "wrong_record",
        )
        multifile, multifile_commit = candidate(
            "multifile-acceptance", extra=True)
        rejected(
            lambda: validate_phase4_acceptance_object(multifile, multifile_commit),
            "multifile",
        )
        misparented, misparented_commit = candidate(
            "misparented-acceptance", wrong_parent=True)
        rejected(
            lambda: validate_phase4_acceptance_object(
                misparented, misparented_commit),
            "wrong_parent",
        )
        wrong_metadata, wrong_metadata_commit = candidate(
            "wrong-metadata", identity=EXECUTOR_METADATA)
        rejected(
            lambda: validate_phase4_acceptance_object(
                wrong_metadata, wrong_metadata_commit),
            "wrong_metadata",
        )
        malformed, malformed_commit = candidate(
            "malformed-record", raw='{"schema":\n')
        rejected(
            lambda: validate_phase4_acceptance_object(
                malformed, malformed_commit),
            "malformed_record",
        )
        nonancestor = clone("nonancestor")
        rejected_reason(
            lambda: validate_phase4_descendant(
                nonancestor, ACCEPTED_REVIEWED_HEAD),
            "acceptance_commit_not_ancestor",
            "nonancestor_acceptance",
        )

        merged = clone("merge-descendant")
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=merged)
        checked([*GIT, "checkout", "-q", "-b", "side"], cwd=merged)
        fixture_commit(merged, "Side descendant", allow_empty=True)
        checked([*GIT, "checkout", "-q", "main"], cwd=merged)
        fixture_commit(merged, "Main descendant", allow_empty=True)
        checked(
            [*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"],
            cwd=merged,
            env=fixture_environment(merged, EXECUTOR_METADATA),
        )
        validator_rejected(
            merged,
            "accepted_descendant_merge",
            "merge-descendant",
        )

        for name, relative, expected_reason in (
            (
                "phase4-contract-drift",
                "evidence/phase-4/final-integration-preparation.json",
                "final_evidence_header",
            ),
            (
                "phase4-acceptance-drift",
                "evidence/phase-4/acceptance.json",
                "acceptance_worktree_drift",
            ),
            ("phase5-acceptance-drift", PHASE5_ACCEPTANCE, None),
            (
                "compatibility-evidence-drift",
                PHASE5_COMPATIBILITY_EVIDENCE,
                None,
            ),
            (
                "followup-evidence-drift",
                PHASE5_DESCENDANT_EVIDENCE,
                None,
            ),
            ("phase5-validator-drift", "bin/check-phase5-prep", None),
            (
                "phase4-validator-drift",
                "bin/check-phase4-final-probes",
                None,
            ),
            ("phase4-doctor-drift", "bin/phase4-final-doctor", None),
            (
                "phase5-contract-drift",
                "manifests/codex-contract.json",
                None,
            ),
        ):
            drift = commit_path_drift(
                name, relative, expected_reason=expected_reason
            )
            if relative == "bin/phase4-final-doctor":
                fixture = workspace / "doctor-self-drift.json"
                write_doctor_fixture(fixture)
                doctor_drift = doctor_result(
                    drift, fixture, "--json"
                )
                require(
                    doctor_drift.returncode != 0
                    and strict_json_text(doctor_drift.stdout)
                    == {
                        "reason":
                            "protected_descendant_drift:"
                            "bin/phase4-final-doctor",
                        "result": "fail",
                    },
                    "doctor_self_drift_accepted",
                )
        commit_path_drift(
            "followup-evidence-delete",
            PHASE5_DESCENDANT_EVIDENCE,
            delete=True,
        )
        return {
            "doctor": doctor_matrix,
            "acceptedAndDescendantPositiveCases": 4,
            "cleanNoOriginCorrectionReview": True,
            "cleanNoOriginMainDescendant": True,
            "negativeCases": negative_cases,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


