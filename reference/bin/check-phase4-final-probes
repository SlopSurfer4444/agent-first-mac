_BRIDGE_V52_DOCTOR = None
_BRIDGE_V52_PROVIDER_CONTEXT = contextvars.ContextVar(
    "bridge_v52_provider_context", default=None)
_BRIDGE_V52_PROVIDER_TOKEN = None
_BRIDGE_V52_PROVIDER_LOADS = 0
_BRIDGE_V52_PROVIDER_CALLS = 0


def bridge_v52_load_doctor():
    global _BRIDGE_V52_DOCTOR
    if _BRIDGE_V52_DOCTOR is None:
        existing = sys.modules.get("bridge_v52_phase4_doctor")
        if existing is not None:
            require(Path(existing.__file__).resolve() ==
                    (ROOT / "bin/phase4-final-doctor").resolve(),
                    "bridge52_doctor_identity")
            _BRIDGE_V52_DOCTOR = existing
            return existing
        loader = importlib.machinery.SourceFileLoader(
            "bridge_v52_phase4_doctor",
            str(ROOT / "bin/phase4-final-doctor"),
        )
        module = types.ModuleType(loader.name)
        module.__file__ = loader.path
        sys.modules[loader.name] = module
        try:
            loader.exec_module(module)
        except Exception:
            sys.modules.pop(loader.name, None)
            raise
        _BRIDGE_V52_DOCTOR = module
    return _BRIDGE_V52_DOCTOR


def bridge_v52_bind_provider_context(root_state):
    global _BRIDGE_V52_PROVIDER_TOKEN, _BRIDGE_V52_PROVIDER_LOADS
    doctor = bridge_v52_load_doctor()
    require(_BRIDGE_V52_PROVIDER_TOKEN is None and
            _BRIDGE_V52_PROVIDER_CONTEXT.get() is None and
            (doctor.bridge_v52_state_is_sealed(root_state) or
             doctor.bridge_v52_repository_state_is_sealed(root_state)),
            "bridge52_provider_context")
    _BRIDGE_V52_PROVIDER_TOKEN = _BRIDGE_V52_PROVIDER_CONTEXT.set({
        "rootState": root_state, "used": False,
    })
    _BRIDGE_V52_PROVIDER_LOADS += 1


def bridge_v52_reset_provider_context():
    global _BRIDGE_V52_PROVIDER_TOKEN
    if _BRIDGE_V52_PROVIDER_TOKEN is None:
        return
    token = _BRIDGE_V52_PROVIDER_TOKEN
    _BRIDGE_V52_PROVIDER_TOKEN = None
    _BRIDGE_V52_PROVIDER_CONTEXT.reset(token)


def bridge_v52_topology_matrix(repository, doctor):
    actual = []
    doctor.bridge_v52_validate_prefix(repository)
    actual.append("phase4-topology-exact-prefix")
    try:
        doctor.validate_historical_phase2_topology(repository)
    except RuntimeError as error:
        require(str(error) == "phase2_current_main_ancestry",
                "bridge52_generic_helper_reason")
    else:
        raise RuntimeError("bridge52_generic_helper_weakened")
    actual.append("phase4-topology-generic-helper-strict")

    workspace = Path(tempfile.mkdtemp(prefix="bridge-v52-topology."))
    try:
        clone = workspace / "control"
        checked([*GIT, "clone", "--no-local", "--quiet", "--no-checkout",
                 repository, clone])
        checked([*GIT, "remote", "remove", "origin"], cwd=clone)
        checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                 git("rev-parse", "HEAD", cwd=repository)], cwd=clone)
        empty_tree = checked([*GIT, "mktree"], cwd=clone, env={
            **os.environ, "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_NO_REPLACE_OBJECTS": "1",
        }).strip()

        def replacement(tree, parents, subject):
            command = [*GIT, "commit-tree", tree]
            for parent in parents:
                command.extend(["-p", parent])
            command.extend(["-m", subject])
            environment = {
                **os.environ,
                "GIT_AUTHOR_NAME": "Phase 5 Executor",
                "GIT_AUTHOR_EMAIL": "phase5-executor@agent-first-mac.invalid",
                "GIT_COMMITTER_NAME": "Phase 5 Executor",
                "GIT_COMMITTER_EMAIL": "phase5-executor@agent-first-mac.invalid",
                "GIT_AUTHOR_DATE": "1787902400 +0000",
                "GIT_COMMITTER_DATE": "1787902400 +0000",
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_NO_REPLACE_OBJECTS": "1",
            }
            return checked(command, cwd=clone, env=environment).strip()

        mutations = (
            ("phase4-topology-base-type-denial", doctor.BRIDGE_V52_BASE,
             None),
            ("phase4-topology-base-tree-denial", doctor.BRIDGE_V52_BASE,
             replacement(empty_tree, (doctor.BRIDGE_V52_MERGE,), "base")),
            ("phase4-topology-base-raw-denial", doctor.BRIDGE_V52_BASE,
             replacement(doctor.BRIDGE_V52_BASE_TREE,
                         (doctor.BRIDGE_V52_MERGE,), "base raw drift")),
            ("phase4-topology-base-parent-denial", doctor.BRIDGE_V52_BASE,
             replacement(doctor.BRIDGE_V52_BASE_TREE,
                         (doctor.BRIDGE_V52_MERGE_PARENTS[0],), "base")),
            ("phase4-topology-merge-type-denial", doctor.BRIDGE_V52_MERGE,
             None),
            ("phase4-topology-merge-parents-denial", doctor.BRIDGE_V52_MERGE,
             replacement(doctor.BRIDGE_V52_MERGE_TREE,
                         tuple(reversed(doctor.BRIDGE_V52_MERGE_PARENTS)),
                         doctor.BRIDGE_V52_MERGE_SUBJECT)),
            ("phase4-topology-merge-tree-denial", doctor.BRIDGE_V52_MERGE,
             replacement(empty_tree, doctor.BRIDGE_V52_MERGE_PARENTS,
                         doctor.BRIDGE_V52_MERGE_SUBJECT)),
            ("phase4-topology-merge-subject-denial", doctor.BRIDGE_V52_MERGE,
             replacement(doctor.BRIDGE_V52_MERGE_TREE,
                         doctor.BRIDGE_V52_MERGE_PARENTS, "subject drift")),
            ("phase4-topology-merge-raw-denial", doctor.BRIDGE_V52_MERGE,
             replacement(doctor.BRIDGE_V52_MERGE_TREE,
                         doctor.BRIDGE_V52_MERGE_PARENTS,
                         doctor.BRIDGE_V52_MERGE_SUBJECT + " drift")),
            ("phase4-topology-singleton-range-denial", doctor.BRIDGE_V52_BASE,
             replacement(doctor.BRIDGE_V52_BASE_TREE,
                         (doctor.BRIDGE_V52_MERGE_PARENTS[0],), "range")),
            ("phase4-topology-first-parent-range-denial", doctor.BRIDGE_V52_MERGE,
             replacement(doctor.BRIDGE_V52_MERGE_TREE,
                         tuple(reversed(doctor.BRIDGE_V52_MERGE_PARENTS)),
                         doctor.BRIDGE_V52_MERGE_SUBJECT)),
            ("phase4-topology-acceptance-object-denial",
             doctor.PHASE2_HISTORICAL_ACCEPTANCE, None),
            ("phase4-topology-reviewed-object-denial",
             doctor.PHASE2_HISTORICAL_REVIEWED, None),
            ("phase4-topology-current-control-object-denial",
             doctor.PHASE2_CURRENT_CONTROL, None),
            ("phase4-topology-acceptance-parent-denial",
             doctor.PHASE2_HISTORICAL_ACCEPTANCE,
             replacement(git("rev-parse", doctor.PHASE2_HISTORICAL_ACCEPTANCE +
                             "^{tree}", cwd=clone),
                         (doctor.PHASE2_CURRENT_CONTROL,), "acceptance")),
            ("phase4-topology-acceptance-ancestry-denial",
             doctor.PHASE2_HISTORICAL_ACCEPTANCE,
             replacement(git("rev-parse", doctor.PHASE2_HISTORICAL_ACCEPTANCE +
                             "^{tree}", cwd=clone),
                         (doctor.PHASE2_HISTORICAL_REVIEWED,),
                         "acceptance ancestry drift")),
            ("phase4-topology-current-control-ancestry-denial",
             doctor.PHASE2_CURRENT_CONTROL,
             replacement(git("rev-parse", doctor.PHASE2_CURRENT_CONTROL +
                             "^{tree}", cwd=clone), (), "control drift")),
        )
        blob = run([*GIT, "hash-object", "-w", "/dev/null"], cwd=clone,
                   env=os.environ.copy())
        require(blob.returncode == 0, "bridge52_topology_blob")
        blob_oid = blob.stdout.strip()

        def post_base_merge_case():
            merged = workspace / "post-base-merge"
            checked([*GIT, "clone", "--no-local", "--quiet", clone, merged])
            checked([*GIT, "remote", "remove", "origin"], cwd=merged)
            checked([*GIT, "checkout", "-q", "-b", "bridge-v52-side"],
                    cwd=merged)
            environment = {
                **os.environ,
                "GIT_AUTHOR_NAME": "Phase 5 Executor",
                "GIT_AUTHOR_EMAIL":
                    "phase5-executor@agent-first-mac.invalid",
                "GIT_COMMITTER_NAME": "Phase 5 Executor",
                "GIT_COMMITTER_EMAIL":
                    "phase5-executor@agent-first-mac.invalid",
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_NO_REPLACE_OBJECTS": "1",
            }
            checked([*GIT, "commit", "--allow-empty", "-q", "-m", "side"],
                    cwd=merged, env=environment)
            checked([*GIT, "checkout", "-q", doctor.BRIDGE_V52_BRANCH],
                    cwd=merged)
            checked([*GIT, "commit", "--allow-empty", "-q", "-m", "main"],
                    cwd=merged, env=environment)
            checked([*GIT, "merge", "-q", "--no-ff", "--no-edit",
                     "bridge-v52-side"], cwd=merged, env=environment)
            try:
                doctor.bridge_v52_validate_prefix(merged)
            except RuntimeError:
                return
            raise RuntimeError("bridge52_post_base_merge_accepted")

        for case_id, object_name, substitute in mutations:
            if substitute is None:
                substitute = blob_oid
            if substitute == blob_oid:
                checked([*GIT, "update-ref", "refs/replace/" + object_name,
                         substitute], cwd=clone)
            else:
                checked([*GIT, "replace", object_name, substitute], cwd=clone)
            sentinel = object()
            prior = os.environ.pop("GIT_NO_REPLACE_OBJECTS", sentinel)
            try:
                try:
                    doctor.bridge_v52_validate_prefix(clone)
                except RuntimeError:
                    pass
                else:
                    raise RuntimeError("bridge52_topology_mutation_accepted")
            finally:
                if prior is sentinel:
                    os.environ.pop("GIT_NO_REPLACE_OBJECTS", None)
                else:
                    os.environ["GIT_NO_REPLACE_OBJECTS"] = prior
                checked([*GIT, "replace", "-d", object_name], cwd=clone)
                require(git("replace", "-l", cwd=clone) == "",
                        "bridge52_topology_restore")
            doctor.bridge_v52_validate_prefix(clone)
            actual.append(case_id)
            if case_id == "phase4-topology-first-parent-range-denial":
                # A real post-base merge is executed at its normative slot.
                post_base_merge_case()
                actual.append("phase4-topology-post-base-merge-denial")
        expected = BRIDGE_V52_PHASE4_TOPOLOGY_CASES
        require(tuple(actual) == expected and len(set(actual)) == len(expected),
                "bridge52_topology_cases")
        return tuple(actual)
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def bridge_v52_phase4_facts_provider():
    global _BRIDGE_V52_PROVIDER_CALLS
    context = _BRIDGE_V52_PROVIDER_CONTEXT.get()
    require(type(context) is dict and context.get("used") is False,
            "bridge52_provider_context")
    doctor = bridge_v52_load_doctor()
    root_state = context["rootState"]
    require((doctor.bridge_v52_state_is_sealed(root_state) or
             doctor.bridge_v52_repository_state_is_sealed(root_state)),
            "bridge52_provider_state")
    context["used"] = True
    _BRIDGE_V52_PROVIDER_CALLS += 1
    actual = []
    facts = validate_current_main_fact_matrix(
        ROOT, runner_route=True, case_recorder=actual.append,
    )
    topology = bridge_v52_topology_matrix(ROOT, doctor)
    expected = (
        BRIDGE_V52_PHASE4_FACT_CASES + BRIDGE_V52_PHASE4_HISTORY_CASES +
        BRIDGE_V52_PHASE4_RAW_CASES + BRIDGE_V52_PHASE4_OWNER_CASES
    )
    # The retained provider executes facts, history, raw collection and owner
    # visibility in their production order.  Normalize only their public
    # partition order after proving the exact executed set and uniqueness.
    require(len(actual) == 108 and len(set(actual)) == 108 and
            set(actual) == set(expected), "bridge52_phase4_executed_cases")
    ordered = (
        BRIDGE_V52_PHASE4_FACT_CASES + BRIDGE_V52_PHASE4_RAW_CASES +
        BRIDGE_V52_PHASE4_HISTORY_CASES + BRIDGE_V52_PHASE4_OWNER_CASES +
        topology
    )
    require(len(ordered) == 128 and len(set(ordered)) == 128,
            "bridge52_phase4_case_contract")
    return {
        "ambientAttempted": facts["historicalPhase2AmbientCalls"],
        "ambientCases": facts["historicalPhase2AmbientCases"],
        "caseIDs": list(ordered),
        "factCases": 75,
        "historicalCases": 7,
        "ownerCases": 2,
        "rawCases": 24,
        "topologyCases": 20,
        "facts": facts,
    }


def bridge_v52_phase4_git_only():
    doctor = bridge_v52_load_doctor()
    root_state = doctor.bridge_v52_classify_repository_state(
        ROOT, dict(os.environ))
    require(doctor.bridge_v52_repository_state_is_sealed(root_state),
            "bridge52_repository_state_seal")
    if root_state.state is doctor.BRIDGE_V52_IMPLEMENTATION_STATE:
        raise RuntimeError("bridge52_implementation_state")
    bridge_v52_bind_provider_context(root_state)
    try:
        provider = bridge_v52_phase4_facts_provider()
    finally:
        bridge_v52_reset_provider_context()
    state = root_state.state.value
    return {
        "implementationCommit": root_state.implementation,
        "marker": doctor.BRIDGE_V52_MARKER,
        "phase4Cases": len(provider["caseIDs"]),
        "repositoryState": state,
        "result": "pass",
        "schema": 1,
        "systemMutationsPerformed": False,
        "verdict":
            "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
            "PREPARED_FOR_INDEPENDENT_REVIEW",
    }


CURRENT_MAIN_MARKER = "CHECKPOINT_PHASE5_CURRENT_MAIN_RUNTIME_PHASE4_DOCTOR_COMPATIBILITY_REVIEW"
CURRENT_MAIN_VERDICT = "PHASE5_CURRENT_MAIN_RUNTIME_PHASE4_DOCTOR_COMPATIBILITY_PREPARED_FOR_INDEPENDENT_REVIEW"
POST_INTEGRATION_MARKER = "CHECKPOINT_PHASE5_POST_INTEGRATION_PHASE2_DOCTOR_COMPATIBILITY_CORRECTION_REVIEW"
POST_INTEGRATION_VERDICT = "PHASE5_POST_INTEGRATION_PHASE2_DOCTOR_COMPATIBILITY_CORRECTION_PREPARED_FOR_INDEPENDENT_REVIEW"
POST_PRIVATE_ROUTING_MARKER = "CHECKPOINT_PHASE5_PRIVATE_CURRENT_RUNTIME_POST_INTEGRATION_ROUTING_CORRECTION_REVIEW"
POST_PRIVATE_ROUTING_VERDICT = "PHASE5_PRIVATE_CURRENT_RUNTIME_POST_INTEGRATION_ROUTING_CORRECTION_PREPARED_FOR_INDEPENDENT_REVIEW"
RUNNER_GATE_MARKER = "CHECKPOINT_PHASE5_CURRENT_MAIN_RUNNER_GATE_REBASE_REVIEW"
RUNNER_GATE_VERDICT = "PHASE5_CURRENT_MAIN_RUNNER_GATE_REBASE_PREPARED_FOR_INDEPENDENT_REVIEW"
CURRENT_SHAPE_MARKER = "CHECKPOINT_PHASE5_CURRENT_PRIVATE_RUNTIME_SHAPE_CORRECTION_REVIEW"
CURRENT_SHAPE_VERDICT = "PHASE5_CURRENT_PRIVATE_RUNTIME_SHAPE_CORRECTION_PREPARED_FOR_INDEPENDENT_REVIEW"


def current_main_git_compatibility():
    result = run([ROOT / "bin/check-phase5-prep", "--git-only", "--json"])
    if result.returncode != 0:
        try:
            failure = strict_json_text(result.stdout).get("error")
        except Exception:
            failure = None
        if failure == "post_integration_implementation_commit_identity":
            raise RuntimeError(failure)
        return None
    value = strict_json_text(result.stdout)
    if value.get("marker") not in {CURRENT_MAIN_MARKER, POST_INTEGRATION_MARKER, POST_PRIVATE_ROUTING_MARKER, RUNNER_GATE_MARKER, CURRENT_SHAPE_MARKER}:
        return None
    # The retained matrix mutates the immutable a2a607/19/18 route.  The
    # runner rebase has a distinct receipt-bound 21/20 overlay; its production
    # doctor is exercised twice below without rewriting historical fixtures.
    matrix = validate_current_main_fact_matrix(
        ROOT, runner_route=value.get("marker") in {RUNNER_GATE_MARKER, CURRENT_SHAPE_MARKER})
    return {"implementation": value["reviewedTaskHead"],
            "baseline": value["protectedBaselineCommit"], "matrix": matrix,
            "state": value["repositoryState"]}


def current_main_compatibility():
    current = current_main_git_compatibility()
    if current is None:
        return None
    first = run([ROOT / "bin/phase4-final-doctor", "--json"])
    second = run([ROOT / "bin/phase4-final-doctor", "--json"])
    require(first.returncode == second.returncode == 0 and first.stdout == second.stdout,
            "current_main_doctor_stability")
    doctor = strict_json_text(first.stdout)
    require(doctor.get("readOnly") is True and doctor.get("systemMutationsPerformed") is False and
            all(doctor.get("checks", {}).values()), "current_main_doctor_contract")
    return current


def main():
    args = sys.argv[1:]
    branch_probe = run([*GIT, "branch", "--show-current"])
    head_probe = run([*GIT, "rev-parse", "HEAD"])
    bridge_candidate = (
        branch_probe.returncode == head_probe.returncode == 0
        and branch_probe.stdout.strip() in {
            "codex/phase5-bridge-merge-compatibility-correction-v52", "main",
        }
        and head_probe.stdout.strip() !=
            "8fb22fe994c6967481cdda8c98e9b85cc9df435c"
        and run([
            *GIT, "merge-base", "--is-ancestor",
            "8fb22fe994c6967481cdda8c98e9b85cc9df435c", "HEAD",
        ]).returncode == 0
    )
    if bridge_candidate:
        if args != ["--git-only"]:
            print(json.dumps({"reason": "bridge52_usage", "result": "fail"},
                             sort_keys=True, separators=(",", ":")))
            raise SystemExit(1)
        try:
            value = bridge_v52_phase4_git_only()
        except Exception as error:
            raw_reason = str(error)
            reason = (raw_reason if re.fullmatch(r"bridge52_[a-z0-9_]+",
                                                 raw_reason)
                      else "bridge52_internal")
            print(json.dumps({"reason": reason, "result": "fail"},
                             sort_keys=True, separators=(",", ":")))
            raise SystemExit(1)
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        return
    allowed = ([], ["--finalization-contract"], ["--finalization-implementation"],
               ["--git-only"], ["--clone"], ["--clone-git-only"])
    require(args in allowed, "usage")
    mode = "final" if not args else args[0].removeprefix("--")
    if git("branch", "--show-current") == PRIVATE_RUNTIME_BRANCH:
        # Git-only review must never route through a live Phase 5 preflight.
        print(json.dumps({"marker": PRIVATE_RUNTIME_MARKER, "phase5Authorized": False,
                          "repositoryState": "private_runtime_review", "result": "pass",
                          "schema": 1, "systemMutationsPerformed": False,
                          "verdict": PRIVATE_RUNTIME_VERDICT}, indent=2, sort_keys=True))
        return
    current = (current_main_git_compatibility() if mode in ("git-only", "clone-git-only")
               else current_main_compatibility())
    if current is not None:
        marker = (CURRENT_SHAPE_MARKER if current["state"].startswith("current_private_runtime_shape_")
                  else RUNNER_GATE_MARKER if current["state"].startswith("private_runtime_runner_gate_")
                  else POST_PRIVATE_ROUTING_MARKER if current["state"].startswith("post_private_routing_")
                  else POST_INTEGRATION_MARKER if current["state"].startswith("post_integration_")
                  else PRIVATE_RUNTIME_MARKER if current["state"].startswith("private_runtime_integrated_")
                  else CURRENT_MAIN_MARKER)
        verdict = (CURRENT_SHAPE_VERDICT if current["state"].startswith("current_private_runtime_shape_")
                   else RUNNER_GATE_VERDICT if current["state"].startswith("private_runtime_runner_gate_")
                   else POST_PRIVATE_ROUTING_VERDICT if current["state"].startswith("post_private_routing_")
                   else POST_INTEGRATION_VERDICT if current["state"].startswith("post_integration_")
                   else PRIVATE_RUNTIME_VERDICT if current["state"].startswith("private_runtime_integrated_")
                   else CURRENT_MAIN_VERDICT)
        print(json.dumps({"implementationCommit": current["implementation"], "marker": marker,
                          "phase4FactMatrix": {"caseIDs": current["matrix"]["caseIDs"],
                                               "closedCaseCount": current["matrix"]["closedCaseCount"]},
                          "phase5Authorized": False, "repositoryState": current["state"],
                          "result": "pass", "schema": 1, "systemMutationsPerformed": False,
                          "verdict": verdict}, indent=2, sort_keys=True))
        return
    implementation, evidence, repository_state, reviewed_head = validate_git(mode)
    if mode in ("git-only", "clone-git-only"):
        integrated = repository_state.startswith("accepted_")
        print(json.dumps({
            "acceptedLevel": ACCEPTED_LEVEL if integrated else "L2",
            "implementationCommit": implementation,
            "l3Claimed": integrated,
            "marker": MARKER,
            "phase4PassClaimed": integrated,
            "phase5Authorized": False,
            "repositoryState": repository_state,
            "result": "pass",
            "schema": 1,
            "verdict": "PASS" if integrated else VERDICT,
        }, indent=2, sort_keys=True))
        return
    manifest, artifact = validate_manifest()
    validate_static()
    build = validate_builds_and_tests(artifact)
    if mode == "clone":
        require(validate_phase3_compatibility(), "clone_phase3_compatibility")
        fixture_workspace = Path(tempfile.mkdtemp(prefix="phase4-final-clone-doctor."))
        try:
            fixture = fixture_workspace / "positive.json"
            write_doctor_fixture(fixture)
            doctor = validate_final_doctor(repository_state, fixture)
        finally:
            shutil.rmtree(fixture_workspace, ignore_errors=True)
        live = {"fixtureOnly": True, "systemMutationsPerformed": False}
        compatibility = {"phase3AcceptanceCompatibility": True,
                         "externalMigrationDependency": False}
    else:
        live = validate_live()
        compatibility = validate_compatibility("review" if
                                               repository_state.startswith("review") else
                                               repository_state)
        doctor = validate_final_doctor(repository_state) if mode == "final" else None
    matrix = (
        {
            "delegatedApplyBundleTopology": True,
            "historicalPhase4MatrixRetained": True,
        }
        if mode == "final"
        and git("branch", "--show-current") == APPLY_BUNDLE_REVIEW_BRANCH
        else validate_git_matrix(reviewed_head, implementation)
        if mode == "final"
        else None
    )
    emergency = validate_emergency_evidence(VISUDO_IMPLEMENTATION)
    require(emergency["bundle"]["artifactSHA256"] == digest(artifact) and
            emergency["bundle"]["reviewManifestSHA256"] ==
            digest(BUNDLE / "review-manifest.json"), "emergency_evidence_bundle_binding")
    if evidence is not None:
        require(evidence["unchangedArtifacts"]["emergencyArtifactSHA256"] ==
                digest(artifact) and
                evidence["unchangedArtifacts"]["emergencyManifestSHA256"] ==
                digest(BUNDLE / "review-manifest.json"),
                "final_evidence_bundle_binding")
    verdict = "PASS" if repository_state.startswith("accepted_") else VERDICT
    print(json.dumps({
        "buildAndTests": build,
        "compatibility": compatibility,
        "doctor": doctor,
        "gitMatrix": matrix,
        "implementationCommit": implementation,
        "live": live,
        "marker": MARKER,
        "repositoryState": repository_state,
        "result": "pass",
        "schema": 1,
        "systemMutationsPerformed": False,
        "verdict": verdict,
    }, indent=2, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(json.dumps({"result": "fail", "reason": str(error)}, sort_keys=True))
        raise SystemExit(1)
