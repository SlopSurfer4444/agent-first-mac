        raw_rejected("unknown_rc", unknown=raw_result(0, "aid-admin: rejected: unknown_command\n"))
        raw_rejected("unknown_reason", unknown=raw_result(64, "other"))
        raw_rejected("unknown_prefix", unknown=raw_result(64, "prefix aid-admin: rejected: unknown_command\n"))
