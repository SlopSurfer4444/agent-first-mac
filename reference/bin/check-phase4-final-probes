                "emergencyEnabled": True, "genericSudoDenied": {"trueDenied": True, "validateDenied": True},
                "historicalTargets": {"generation2PathSHA256": module.PREVIOUS_PATH_SHA256,
                                      "generation3PathSHA256": module.TARGET_PATH_SHA256},
                "narHash": "sha256-current-fixture", "phase2Accepted": True, "phase3Accepted": True,
                "processes": [], "profileTarget": target["path"],
                "receipt": {"controlCommit": commit, "controlTree": module.git("rev-parse", commit + "^{tree}", cwd=repository),
                            "policyHash": module.POLICY_SHA256, "reviewed": True, "schema": 1,
                            "targetSystemNarHash": "sha256-current-fixture", "targetSystemPath": target["path"]},
                "receiptFile": {"kind": "file", "mode": 0o400, "nlink": 1, "owner": "caller", "sizeBounded": True, "symlink": False},
                "rootDoctor": {"outputBounded": True, "returncode": 0, "value": {
                    "checks": {"emergency_disable_absent": True, "installed_artifact_attestation": True,
                               "installed_contract": True, "policy_hash": True},
                    "command": "doctor-root", "problems": [], "readOnly": True, "schema": 1,
                    "systemMutationsPerformed": False, "verdict": "ROOT_CONTRACT_READY"}}, "target": target.copy(),
                "targets": ({2: {**target, "path": "/nix/store/historical-two"},
                             3: {**target, "path": "/nix/store/historical-three"},
                             20: {**target, "path": "/nix/store/runner-retained"},
                             21: target.copy()} if runner_route else
                            {2: {**target, "path": "/nix/store/historical-two"},
                             3: {**target, "path": "/nix/store/historical-three"}, 19: target.copy()}),
                "unknownCommandDenied": {"outputBounded": True, "reason": "unknown_command", "returncode": 64},
                "versionFile": {"gid": 0, "kind": "file", "modeWritable": False, "owner": 0, "parent": "/nix/store", "sizeBounded": True},
                "versionLink": {"gid": 0, "kind": "symlink", "mode": 0o755, "uid": 0},
                "versionValue": {"configurationRevision": commit, "darwinLabel": "26.05." + darwin[:7],
                                 "darwinRevision": darwin, "nixpkgsRevision": nixpkgs},
            }
        positive_facts = facts()
        if runner_route:
            positive_facts["receipt"]["controlTree"] = module.RUNNER_GATE_TREE
        result = module.validate_current_main_facts(positive_facts, repository, runner_route=runner_route)
        require(result["caseCount"] == 15 and len(result["caseIDs"]) == 15 and
                len(set(result["caseIDs"])) == 15, "current_main_fact_case_ids")
        historical_commit = "2fdbd7e7419fc049565f87b29a21b7dd1838a754"
        historical_objects = (
            ("bin/phase2-doctor", "4cd4660200a0e51acd9de9f768f41dca7648f233",
             16133,
             "8046abcbae70fe39c76dd2bcf489c4a2913e629a310b6ae04c737656f2c69f36"),
            ("evidence/phase-2/acceptance.json",
             "9b548f40d0c6aa8bba3ab2e0695dc82f5cf56d30", 2251,
             "3032fa9bd817ebc16d9917ae413b298469eeb998630d861164e030f1a1d811e6"),
        )
        for relative, oid, length, expected_digest in historical_objects:
            git_environment = dict(os.environ)
            git_environment.update({
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_NO_REPLACE_OBJECTS": "1",
