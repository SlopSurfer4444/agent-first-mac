        raw_rejected("generic_validate_allowed", validate=raw_result(0, ""))
        emergency_paths = [workspace / "disabled", workspace / "disabled-new", workspace / "sudoers-disabled"]
        require(module.current_main_emergency_enabled([str(path) for path in emergency_paths]), "raw_emergency_positive")
        emergency_paths[0].write_text("marker")
        require(not module.current_main_emergency_enabled([str(path) for path in emergency_paths]), "raw_emergency_marker")
        if case_recorder is not None:
