                value.update(derived)
                module.validate_current_main_facts(value, repository, runner_route=runner_route)
            except (RuntimeError, ValueError, KeyError, TypeError):
                if case_recorder is not None:
                    case_recorder("phase4-raw-" + name.replace("_", "-"))
                return
            raise RuntimeError("current_main_raw_accepted_" + name)
        raw_rejected("root_minimal", root=raw_result(0, '{"verdict":"ROOT_CONTRACT_READY"}'))
        raw_rejected("root_extra", root=raw_result(0, json.dumps({**positive_facts["rootDoctor"]["value"], "extra": True})))
        raw_rejected("root_malformed", root=raw_result(0, '{"schema":'))
