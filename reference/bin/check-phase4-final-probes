            phase2_rejected("schema", lambda value: value.update(schema=2))
            phase2_rejected("extra", lambda value: value.update(extra=True))
            phase2_rejected("check_set", lambda value: value["checks"].pop())
            phase2_rejected("check_status", lambda value:
                            value["checks"][0].update(status="fail"))
            phase2_rejected("verdict", lambda value:
                            value.update(verdict="FAIL"))
            phase2_rejected("redaction", lambda value:
                            value.update(redaction="other"))
            phase2_rejected("repeat", lambda value: value.update(extra=True),
                            repeat=True)
            require(ambient_calls == [], "historical_phase2_ambient_access")
        finally:
            for name, original in reversed(restored):
                setattr(module, name, original)
        root_json = json.dumps(positive_facts["rootDoctor"]["value"], sort_keys=True)
        def raw_result(returncode, stdout):
            return types.SimpleNamespace(returncode=returncode, stdout=stdout)
        def raw_rejected(name, root=None, unknown=None, generic=None, validate=None):
            value = facts()
            try:
