#!/usr/bin/python3
"""Fixed-path reviewed Wine PE update adapter. Source preparation is not apply authority."""
import sys
sys.dont_write_bytecode = True
import argparse
import contextlib
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess

HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
CONTROL = HOME/'AIDev/control'
SOURCE_PATH = Path(__file__).absolute()
HUB = HOME/'Library/Application Support/Adapted Games'
DS3 = HOME/'Library/Application Support/Adapted Games DS3'
STATE = HOME/'AIDev/state'
CANDIDATE = STATE/'wine-runtime-overlay-candidate'
NAMESPACE = 'wine-runtime-overlay'
ARCHIVES = 'wine-runtime-overlay-archives'
OWNER_BYTES = b'{"schema":1,"owner":"control-games-hub","purpose":"wine-runtime-overlay"}\n'
ARCHIVE_OWNER_BYTES = b'{"schema":1,"owner":"control-games-hub","purpose":"wine-runtime-overlay-archives"}\n'
POLICY = 'manifests/wine-runtime-overlay.json'
DELIVERY = 'manifests/wine-runtime-update.json'
ADMISSION = HOME/'AIDev/bin/game-launch-admission'
DELIVERY_FIELDS = {'schema','id','owner','overlayPolicySha256','candidateFiles','requiredLaunchAdmissionSha256'}
CANDIDATE_FILES = {'winemac-i386.drv','winemac-x86_64.drv','wine-source.tar.gz','source.patch','build-provenance.json','LGPL-NOTICE.txt'}
EXTENDED_CANDIDATE_FILES = CANDIDATE_FILES | {'winemac-x86_64.so','oleacc-i386.dll','oleacc-x86_64.dll'}
PE32 = 'engine/lib/wine/i386-windows/winemac.drv'
PE64 = 'engine/lib/wine/x86_64-windows/winemac.drv'
ARCHIVE_IMMUTABLE_SOURCE = (POLICY,DELIVERY,'manifests/games-hub.json','manifests/ds3-marshal-fix.json',
                            'manifests/ds3-source-hub-v1.json','bin/ds3-runtime','bin/ds3-play',
                            'bin/games-play','bin/game-launch-admission','lib/game_operation_readiness.py','lib/operation_readiness.py')


class Blocked(RuntimeError):
    pass


def need(ok, reason):
    if not ok:
        raise Blocked(reason)


def pin(value, length=64):
    return type(value) is str and re.fullmatch('[0-9a-f]{'+str(length)+'}',value) is not None


def digest(data):
    return hashlib.sha256(data).hexdigest()


def run(argv, timeout=120, env=None):
    result=subprocess.run([str(x) for x in argv],capture_output=True,timeout=timeout,env=env)
    need(result.returncode == 0,'command_failed_'+Path(argv[0]).name)
    need(len(result.stdout) <= 2*1024*1024,'command_output_limit')
    return result.stdout


def source_check(commit):
    need(SOURCE_PATH == CONTROL/'bin/games-runtime-update','canonical_source_required')
    need(pin(commit,40),'invalid_commit')
    def git(*args):
        return run(['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL,*args]).decode().strip()
    need(git('rev-parse','HEAD') == commit and git('branch','--show-current') == 'main'
         and git('status','--porcelain') == '', 'clean_exact_main_required')


def operation_ready(commit,operation,checks,target_guard):
    loader=importlib.machinery.SourceFileLoader('game_scoped_ready',str(CONTROL/'lib/game_operation_readiness.py'))
    module=importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name,loader));loader.exec_module(module)
    return module.ready(CONTROL,commit,operation,checks=checks,target_guard=target_guard)

def renderer_archive_view(root,commit,old_commit):
    # Reuse the exact renderer proof owned by the launch archive adapter.
    path=Path(__file__).absolute().parent/'game-launch-reliability-update'
    loader=importlib.machinery.SourceFileLoader('renderer_archive_successor',str(path))
    module=importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name,loader));loader.exec_module(module)
    return module.renderer_successor(root,commit,old_commit)


def source_gate(commit,engine=None,root=None,action='apply'):
    source_check(commit);need(engine is not None and root is not None,'operation_targets_required')
    definition=engine.decode(root.read('payload/update-policy.json')[0])
    need(type(definition) is dict and type(definition.get('schema')) is int and definition['schema'] in (1,2,3),'delivery_policy_schema')
    prerequisite=action=='bootstrap-policy-source'
    archival=action in ('archive-prepared','archive-applied','archive-rolled-back')
    recovery_action=action in ('recover','rollback','archive-prepared','archive-applied','archive-rolled-back')
    # The prerequisite alone may start without its two fixed files. Archives
    # bind the recorded old scope; neither route can mint an 18-target plan.
    selected=dict(engine.POLICY_SOURCE_TARGETS if definition['schema']==3 and not (prerequisite or archival)
                  else engine.EXTENDED_TARGETS if definition['schema']>=2 else engine.TARGETS)
    if definition['schema']==3 and root.exists('ds3/policy-source'):
        engine.verify_policy_inventory(root)
        selected.update({key:rel for key,rel in engine.POLICY_SOURCE_TARGETS.items() if key not in engine.EXTENDED_TARGETS})
    def transaction():
        root.validate_namespace();raw=root.read('state/transaction/plan.json')[0]
        tx=engine.Transaction(root,digest(raw),source_only=False)
        need(tx.targets in (engine.TARGETS,engine.EXTENDED_TARGETS,engine.POLICY_SOURCE_TARGETS),'operation_target_scope')
        need(archival or tx.plan['acceptedCommit']==commit,'transaction_source_commit_drift')
        tx.journal()
        return tx
    if root.anchors['state'].exists(NAMESPACE) and root.exists('state/transaction/journal.json'):
        # The old recorded kind and the current desired kind are both fixed
        # engine scopes. No plan-selected arbitrary path enters this guard.
        selected.update(transaction().targets)
    before={rel:root.read(rel) for rel in selected.values()}
    def held():
        root.bound();root._operation_lock_check()
        return all(root.read(rel)==image for rel,image in before.items())
    def owner():
        delivery(engine,root)
        for name,expected in (('hub','control-games-hub'),('ds3','control-ds3-marshal-fix')):
            need(engine.decode(root.read(name+'/receipt.json')[0]).get('owner')==expected,'operation_payload_owner')
        return True
    def recovery():
        state=root.anchors['state']
        if state.exists(NAMESPACE):
            root.validate_namespace()
            if root.exists('state/transaction/journal.json'):
                tx=transaction()
                endpoint_root=root
                if action=='archive-applied':endpoint_root,_=renderer_archive_view(root,commit,tx.plan['acceptedCommit'])
                for key,rel in tx.targets.items():need(endpoint_root.read(rel) in tuple(tx.images[key].values()),'target_unknown_drift')
        return True
    checks={'payload-owner':owner,'recovery':recovery}
    if not recovery_action:
        def target():
            _,policy=delivery(engine,root);inactive(root,policy);return True
        checks['wine-target']=target
    result=operation_ready(commit,'wine-recovery' if recovery_action else 'wine-install',checks,held)
    need(result.get('scopedCandidateReady') is True,'scoped_operation_readiness_required');source_check(commit)


def load_engine():
    loader=importlib.machinery.SourceFileLoader('reviewed_wine_runtime_overlay',str(CONTROL/'bin/wine-runtime-overlay'))
    spec=importlib.util.spec_from_loader(loader.name,loader)
    module=importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def launch_bridge(root,commit,phase):
    loader=importlib.machinery.SourceFileLoader('game_delivery_bridge',str(CONTROL/'lib/game_delivery_bridge.py'))
    module=importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name,loader));loader.exec_module(module)
    return module.launch_bridge(CONTROL,root,commit,phase=phase)


@contextlib.contextmanager
def prerequisite_bridge(engine,root,commit,action):
    definition=engine.decode(root.read('payload/update-policy.json')[0])
    if action not in ('archive-applied','bootstrap-policy-source') or definition.get('schema')!=3 \
       or digest(root.read('admission/helper')[0])==definition.get('requiredLaunchAdmissionSha256'):
        yield
        return
    # Only the first prerequisite and terminal archival may use the exact
    # reviewed launch predecessor. Ordinary apply still requires the new helper.
    with launch_bridge(root,commit,'predecessor') as proof:
        root._launch_predecessor=proof
        try:yield
        finally:del root._launch_predecessor


def build_delivery(engine,root,commit,definition,policy,publish=False):
    desired=policy['desiredRuntimeHashes' if definition['schema']>=2 else 'desiredPEHashes']
    kwargs=dict(publish=publish,source_only=False,runtime_sha256=desired if definition['schema']>=2 else None,
                installed_policy_source=definition['schema']==3)
    def build():
        return engine.build(root,commit,desired[PE32],desired[PE64],definition['overlayPolicySha256'],**kwargs)
    if definition['schema']==3:
        dm=engine.decode(root.read('ds3/manifest.json')[0])
        old=engine.decode(root.read('ds3/policy-source/overlay-policy.json')[0])
        if dm.get('schema') in (3,4) and old.get('lifecycleSha256')!=digest(root.read('ds3/ds3-runtime')[0]):
            # Launch deployment changes the helper before the overlay. Bind
            # its complete settled transition instead of erasing old ancestry.
            with launch_bridge(root,commit,'settled') as proof:
                proof.revalidate()
                need(proof.installed_lifecycle==root.read('ds3/ds3-runtime')[0],'launch_bridge_lifecycle_drift')
                kwargs['predecessor_lifecycle']=proof.before_lifecycle
                if dm.get('schema')==4:kwargs['launch_proof']=proof
                result=build()
                proof.revalidate()
                return result
    return build()


def anchor(engine,path):
    """Open a fixed native root, retaining every no-follow ancestor descriptor."""
    need(path.is_absolute(),'absolute_fixed_root_required')
    obj=object.__new__(engine.Root)
    obj.path=path
    obj.chain=[]
    fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY)
    obj.chain.append((None,None,fd,engine.identity(os.fstat(fd))))
    try:
        for name in path.parts[1:]:
            parent=fd
            fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent)
            info=os.fstat(fd)
            need(info.st_uid in (0,os.getuid()) and not info.st_mode & 0o022,'unsafe_fixed_root')
            obj.chain.append((parent,name,fd,engine.identity(info)))
        obj.fd=fd
        need(os.fstat(fd).st_uid == os.getuid(),'foreign_fixed_root')
        return obj
    except BaseException:
        obj.close()
        raise


def make_root(engine):
    class LiveRoot(engine.Root):
        def __init__(self):
            self.anchors={}
            try:
                for name,path in (('hub',HUB),('ds3',DS3),('state',STATE),('candidate',CANDIDATE),
                                  ('control',CONTROL),('admission',ADMISSION.parent)):
                    self.anchors[name]=anchor(engine,path)
            except BaseException:
                self.close();raise

        def bound(self):
            for value in self.anchors.values():
                value.bound()

        def lock(self):
            # The engine also enters its lock. Reuse this root's already held
            # operation lock, not a second independently opened flock.
            return read_only_lock(self)

        def replace(self,rel,data,mode,expected,event=lambda _:None):
            def publication(name):
                event(name)
                if name.startswith('before-replace:'):
                    # Only operate installs this private closure. Direct
                    # engine users retain their legacy explicit gate contract.
                    check=getattr(self,'_publication_check',None)
                    if check is not None:check()
            return super().replace(rel,data,mode,expected,event=publication)

        def close(self):
            for value in self.anchors.values():
                value.close()
            self.anchors={}

        @contextlib.contextmanager
        def parent(self,rel):
            self.bound()
            if rel.startswith('hub/') or rel.startswith('ds3/'):
                base,inner=rel.split('/',1)
            elif rel == 'state/games-hub.lock' or rel == 'state/game-launch-pending.json':
                base,inner='state',rel.split('/',1)[1]
            elif rel.startswith('state/transaction'):
                need(rel == 'state/transaction' or rel.startswith('state/transaction/'),'unsupported_state_path')
                base,inner='state',NAMESPACE+'/'+rel.split('/',1)[1]
            elif rel == 'state/owner.json':
                base,inner='state',NAMESPACE+'/owner.json'
            elif rel == 'admission/helper':
                base,inner='admission',ADMISSION.name
            elif rel.startswith('payload/candidate/'):
                base,inner='candidate',rel.removeprefix('payload/candidate/')
                need(inner in EXTENDED_CANDIDATE_FILES,'candidate_path_not_declared')
            elif rel == 'payload/policy.json':
                base,inner='control',POLICY
            elif rel == 'payload/update-policy.json':
                base,inner='control',DELIVERY
            elif rel == 'payload/current-hub-manifest.json':
                base,inner='control','manifests/games-hub.json'
            elif rel == 'payload/source-hub-v1.json':
                base,inner='control','manifests/ds3-source-hub-v1.json'
            elif rel == 'payload/ds3-runtime':
                base,inner='control','bin/ds3-runtime'
            elif rel.startswith('payload/') and rel.removeprefix('payload/') in EXTENDED_CANDIDATE_FILES:
                base,inner='candidate',rel.removeprefix('payload/')
            else:
                raise Blocked('unsupported_fixed_path')
            with self.anchors[base].parent(inner) as opened:
                yield opened

        def exists(self,rel):
            try:
                return super().exists(rel)
            except FileNotFoundError:
                return False

        def ensure_namespace(self):
            state=self.anchors['state']
            if state.exists(NAMESPACE):
                need(state.read(NAMESPACE+'/owner.json')[0] == OWNER_BYTES,'state_namespace_collision')
            else:
                state.mkdir(NAMESPACE)
                state.write_new(NAMESPACE+'/owner.json',OWNER_BYTES)
            self.validate_namespace()

        def validate_namespace(self):
            state=self.anchors['state']
            need(state.read(NAMESPACE+'/owner.json')[0] == OWNER_BYTES,'state_namespace_collision')
            with state.parent(NAMESPACE+'/.unused') as (fd,_,check):
                need(set(os.listdir(fd)) <= {'owner.json','transaction'},'state_namespace_drift')
                check()
    return LiveRoot()


def delivery(engine,root):
    definition=engine.decode(root.read('payload/update-policy.json')[0])
    need(type(definition) is dict and set(definition) == DELIVERY_FIELDS and type(definition['schema']) is int and definition['schema'] in (1,2,3)
         and definition['id'] == 'wine-runtime-update' and definition['owner'] == 'control-games-hub','delivery_policy_schema')
    need(pin(definition['overlayPolicySha256']) and pin(definition['requiredLaunchAdmissionSha256'])
         and type(definition['candidateFiles']) is dict and set(definition['candidateFiles']) == (EXTENDED_CANDIDATE_FILES if definition['schema'] >= 2 else CANDIDATE_FILES)
         and all(pin(value) for value in definition['candidateFiles'].values()),'delivery_pin_schema')
    raw=root.read('payload/policy.json')[0]
    need(digest(raw) == definition['overlayPolicySha256'],'overlay_policy_pin_mismatch')
    policy=engine.decode(raw)
    need(type(policy) is dict and set(policy) == (engine.EXTENDED_POLICY_FIELDS if definition['schema'] >= 2 else engine.POLICY_FIELDS) and type(policy.get('schema')) is int and policy['schema'] == (2 if definition['schema'] >= 2 else 1)
         and policy['id'] == 'wine-runtime-overlay' and policy['owner'] == 'control-games-hub','overlay_policy_schema')
    extended = definition['schema'] >= 2
    desired = policy['desiredRuntimeHashes' if extended else 'desiredPEHashes']
    need(type(desired) is dict and set(desired) == (set(engine.RUNTIME_PAYLOADS) if extended else {PE32,PE64})
         and all(pin(value) for value in desired.values())
         and desired[PE32] == definition['candidateFiles']['winemac-i386.drv']
         and all(desired[rel] == definition['candidateFiles'][name] for rel,name in engine.RUNTIME_PAYLOADS.items() if extended or rel in (PE32,PE64)),'overlay_delivery_disagreement')
    # Hub status keeps its exact source/installed byte equality. The accepted
    # source must declare the precise successor this planner will publish.
    installed_hub=engine.decode(root.read('hub/manifest.json')[0])
    need(type(installed_hub) is dict and type(policy.get('previousHubCriticalHashes')) is dict,'hub_manifest_schema')
    desired_hub=dict(installed_hub,criticalHashes=dict(policy['previousHubCriticalHashes'],**desired),runtimeOverlayPolicySha256=definition['overlayPolicySha256'])
    need(root.read('payload/current-hub-manifest.json')[0] == engine.encode(desired_hub),'declared_hub_source_successor_drift')
    for name,expected in definition['candidateFiles'].items():
        need(digest(root.read('payload/candidate/'+name)[0]) == expected,'candidate_source_drift')
    provenance=engine.decode(root.read('payload/candidate/build-provenance.json')[0])
    fields={'schema','runtimeHashes' if extended else 'peHashes','sourceArchiveSha256','patchSha256','upstreamCommit','installed'}
    need(type(provenance) is dict and set(provenance) == fields and type(provenance['schema']) is int and provenance['schema'] == (2 if extended else 1)
         and provenance['runtimeHashes' if extended else 'peHashes'] == desired and provenance['sourceArchiveSha256'] == definition['candidateFiles']['wine-source.tar.gz']
         and provenance['patchSha256'] == definition['candidateFiles']['source.patch'] and (provenance['upstreamCommit'] is None or pin(provenance['upstreamCommit'],40))
         and provenance['installed'] is False,'candidate_provenance_binding')
    admission_raw=root.read('admission/helper')[0]
    if digest(admission_raw)!=definition['requiredLaunchAdmissionSha256']:
        proof=getattr(root,'_launch_predecessor',None)
        need(definition['schema']==3 and proof is not None,'launch_admission_prerequisite')
        proof.revalidate()
        need(proof.admission==admission_raw,'launch_admission_predecessor_drift')
        need(digest(proof.desired_admission)==definition['requiredLaunchAdmissionSha256'],
             'launch_admission_successor_disagreement')
    return definition,policy


def bootstrap_policy_source(engine,root,commit,fresh):
    """First schema3 migration only, with historical source read as data."""
    need(not root.exists('state/transaction'),'bootstrap_requires_archived_transaction')
    definition,policy=delivery(engine,root)
    need(definition['schema'] == 3,'bootstrap_delivery_schema')
    desired=policy['desiredRuntimeHashes']
    def exact_before():
        return engine.build(root,commit,desired[PE32],desired[PE64],definition['overlayPolicySha256'],publish=False,source_only=False,runtime_sha256=desired)['planSha256']
    before_plan=exact_before()
    dm=engine.decode(root.read('ds3/manifest.json')[0]);dr=engine.decode(root.read('ds3/receipt.json')[0]);hm=engine.decode(root.read('hub/manifest.json')[0])
    need(dm.get('schema') == 3 and pin(dr.get('commit'),40),'bootstrap_installed_generation')
    old_commit=dr['commit']
    git=['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL]
    need(run(git+['cat-file','-t',old_commit]).decode().strip() == 'commit','bootstrap_source_commit_missing')
    try:run(git+['merge-base','--is-ancestor',old_commit,commit])
    except Blocked:raise Blocked('bootstrap_source_not_ancestor')
    old_policy=run(git+['show',old_commit+':'+POLICY])
    old_source=run(git+['show',old_commit+':manifests/ds3-source-hub-v1.json'])
    old_lifecycle=run(git+['show',old_commit+':bin/ds3-runtime'])
    need(digest(old_policy) == dm.get('runtimeOverlayPolicySha256')
         and digest(old_source) == dm.get('sourceHubManifestSha256')
         and old_lifecycle == root.read('ds3/ds3-runtime')[0]
         and digest(old_lifecycle) == dr.get('lifecycleSha256'),'bootstrap_historical_binding')
    # Validate the same exact fixed closure as schema4 before creating files.
    # Content checks do not grant authority; the descriptor-bound bootstrap
    # publishes only after a repeat full installed-state plan and local gate.
    original=engine.decode(old_source);previous=engine.decode(old_policy)
    need(type(previous) is dict and set(previous) == engine.EXTENDED_POLICY_FIELDS
         and type(previous.get('schema')) is int and previous['schema'] == 2
         and previous.get('id') == 'wine-runtime-overlay' and previous.get('owner') == 'control-games-hub'
         and previous.get('lifecycleSha256') == digest(old_lifecycle)
         and previous.get('desiredRuntimeHashes') == dm.get('runtimeOverrides')
         and previous.get('sourceHubManifestSha256') == dm['sourceHubManifestSha256']
         and previous.get('sourceCriticalHashes') == dm['sourceCriticalHashes']
         and type(previous.get('previousHubCriticalHashes')) is dict
         and hm.get('criticalHashes') == dict(previous['previousHubCriticalHashes'],**dm['runtimeOverrides'])
         and hm.get('runtimeOverlayPolicySha256') == dm['runtimeOverlayPolicySha256']
         and type(original) is dict and original.get('id') == 'games-hub' and original.get('owner') == 'control-games-hub'
         and original.get('criticalHashes') == dm['sourceCriticalHashes'],'bootstrap_historical_closure')
    loader=importlib.machinery.SourceFileLoader('reviewed_ds3_policy_source_bootstrap',str(CONTROL/'bin/ds3-policy-source-bootstrap'))
    spec=importlib.util.spec_from_loader(loader.name,loader);module=importlib.util.module_from_spec(spec);loader.exec_module(module)
    def gate():
        fresh(commit)
        need(exact_before() == before_plan,'bootstrap_installed_state_changed')
    result=module.bootstrap(root.anchors['ds3'],old_policy,old_source,policy_sha256=digest(old_policy),source_hub_sha256=digest(old_source),gate=gate)
    result.update(liveStateChanged=result['changed'],installedAcceptanceClaimed=False,installedGenerationUnchanged=True)
    return result


def inactive(root,policy):
    # Prefix availability metadata only; never recurse into profiles or open
    # a registry, account, save, configuration or game content file.
    need(not root.exists('state/game-launch-pending.json'),'launch_reservation_pending')
    server='engine/bin/wineserver'
    pins=policy.get('previousHubCriticalHashes')
    need(type(pins) is dict and pin(pins.get(server)),'server_pin_missing')
    for name,base,prefix in (('hub',HUB,HUB/'profiles/prince'),('ds3',DS3,DS3/'profiles/ds3')):
        need(digest(root.read(name+'/runtime/'+server)[0]) == pins[server],'unchanged_server_drift')
        with root.parent(name+'/profiles/.unused') as (fd,_,check):
            info=os.stat(prefix.name,dir_fd=fd,follow_symlinks=False)
            need(stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and not info.st_mode & 0o022,'prefix_unavailable')
            check()
        env={'HOME':str(HOME),'PATH':'/usr/bin:/bin','WINEPREFIX':str(prefix),'WINESERVER':str(base/'runtime'/server)}
        try:
            run([base/'runtime'/server,'-w'],timeout=3,env=env)
        except subprocess.TimeoutExpired:
            raise Blocked('prefix_active')


def gate(engine,root,commit):
    source_gate(commit,engine,root)
    return local_gate(engine,root,commit)


def local_gate(engine,root,commit):
    held=getattr(root,'_operation_lock_check',None)
    if held is not None:held()
    source_check(commit)
    if root.exists('state/transaction'):root.validate_namespace()
    definition,policy=delivery(engine,root)
    inactive(root,policy)
    if definition['schema'] == 3 and root.exists('ds3/policy-source'):
        # Also bind the schema4 directory after the potentially slow prefix
        # probes, including the immediate callback before each replacement.
        engine.verify_policy_inventory(root)
    return {'sourceAccepted':True,'doctorReady':True,'prefixesInactive':True}


@contextlib.contextmanager
def read_only_lock(root):
    # Plan creates neither a lock nor a transaction namespace.
    held=getattr(root,'_operation_lock_check',None)
    if held is not None:
        held()
        yield
        held()
        return
    with root.parent('state/games-hub.lock') as (parent,name,check):
        fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=parent)
        try:
            info=os.fstat(fd)
            need(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and info.st_nlink == 1 and not info.st_mode & 0o022,'unsafe_lock')
            import fcntl
            fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
            check()
            need(os.stat(name,dir_fd=parent,follow_symlinks=False).st_ino == info.st_ino,'lock_binding_drift')
            def bound():
                check()
                need(os.stat(name,dir_fd=parent,follow_symlinks=False).st_ino == info.st_ino,'lock_binding_drift')
            root._operation_lock_check=bound
            try:
                yield
                bound()
            finally:
                del root._operation_lock_check
        finally:
            os.close(fd)


def exclusive_rename(source_parent,source_name,destination_parent,destination_name):
    """Darwin's real atomic exclusive rename; never emulate check-then-rename."""
    need(sys.platform == 'darwin','exclusive_rename_unavailable')
    need('/' not in source_name and '/' not in destination_name,'invalid_archive_basename')
    import ctypes
    library=ctypes.CDLL('/usr/lib/libSystem.B.dylib',use_errno=True)
    function=library.renameatx_np
    function.argtypes=(ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint)
    function.restype=ctypes.c_int
    # macOS SDK sys/stdio.h declares RENAME_EXCL = 0x00000004.
    status=function(source_parent,os.fsencode(source_name),destination_parent,os.fsencode(destination_name),0x00000004)
    if status != 0:
        number=ctypes.get_errno()
        raise OSError(number,os.strerror(number))


def archive_source_ancestry(engine,root,old_commit,current_commit):
    need(pin(old_commit,40) and old_commit != current_commit,'distinct_old_source_commit_required')
    git=['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL]
    need(run(git+['cat-file','-t',old_commit]).decode().strip() == 'commit','old_source_commit_missing')
    try:
        run(git+['merge-base','--is-ancestor',old_commit,current_commit])
    except Blocked:
        raise Blocked('old_source_not_ancestor')
    for path in ARCHIVE_IMMUTABLE_SOURCE:
        need(run(git+['show',old_commit+':'+path]) == root.anchors['control'].read(path)[0],
             'archive_source_scope_changed')


def archive_prepared(engine,root,current_commit,old_commit,expected_plan,terminal_applied=False,terminal_rolled_back=False):
    """Retain a proved exact terminal/prepared namespace; never rebind it."""
    need(type(terminal_applied) is bool and type(terminal_rolled_back) is bool
         and not (terminal_applied and terminal_rolled_back),'archive_terminal_selection')
    terminal = terminal_applied or terminal_rolled_back
    exact_side = 'after' if terminal_applied else 'before'
    exact_phase = 'applied' if terminal_applied else 'rolled-back' if terminal_rolled_back else 'prepared'
    need(pin(expected_plan) and pin(old_commit,40),'archive_old_binding_required')
    with read_only_lock(root), prerequisite_bridge(engine,root,current_commit,'archive-applied' if terminal_applied else 'archive-rolled-back' if terminal_rolled_back else 'archive-prepared'):
        source_gate(current_commit,engine,root,'archive-applied' if terminal_applied else 'archive-rolled-back' if terminal_rolled_back else 'archive-prepared')
        fresh=lambda _: local_gate(engine,root,current_commit)
        fresh(current_commit)
        endpoint_root=root
        if terminal:
            need(pin(old_commit,40) and old_commit != current_commit,'distinct_old_source_commit_required')
            git=['/usr/bin/git','-c','core.hooksPath=/dev/null','-C',CONTROL]
            need(run(git+['cat-file','-t',old_commit]).decode().strip() == 'commit','old_source_commit_missing')
            try: run(git+['merge-base','--is-ancestor',old_commit,current_commit])
            except Blocked: raise Blocked('old_source_not_ancestor')
            historical_policy=run(git+['show',old_commit+':'+POLICY])
            historical_source=run(git+['show',old_commit+':manifests/ds3-source-hub-v1.json'])
            class HistoricalRoot:
                # Only immutable source guards are read from the pinned old
                # commit. Live gates continue using root/current intent.
                def read(self,rel,**kwargs):
                    if rel == 'payload/policy.json':return historical_policy,root.read(rel)[1]
                    if rel == 'payload/source-hub-v1.json':return historical_source,root.read(rel)[1]
                    return endpoint_root.read(rel,**kwargs)
                def __getattr__(self,name):return getattr(endpoint_root,name)
            transaction_root=HistoricalRoot()
        else:
            archive_source_ancestry(engine,root,old_commit,current_commit)
            transaction_root=root
        state=root.anchors['state']
        def prepared_records(tx):
            root.validate_namespace()
            with state.parent(NAMESPACE+'/.unused') as (fd,_,check):
                need(stat.S_IMODE(os.fstat(fd).st_mode) == 0o700,'namespace_not_private')
                need(set(os.listdir(fd)) == {'owner.json','transaction'},'archive_namespace_inventory')
                check()
            need(state.read(NAMESPACE+'/owner.json')[1] == 0o600,'archive_owner_mode')
            journal=tx.journal()
            need(journal['phase'] == exact_phase and journal['intent'] is None,'archive_requires_terminal_null_intent' if terminal else 'archive_requires_prepared_null_intent')
            need(root.read('state/transaction/journal.json')[1] == 0o600,'archive_journal_mode')
            expected={'plan.json','journal.json'}|{key+'.'+side for key in tx.order for side in ('before','after')}
            with root.parent('state/transaction/.unused') as (fd,_,check):
                need(stat.S_IMODE(os.fstat(fd).st_mode) == 0o700,'transaction_not_private')
                need(set(os.listdir(fd)) == expected,'archive_requires_no_stages')
                check()
        def exact_prepared():
            nonlocal endpoint_root
            renderer_proof=None
            if terminal_applied:endpoint_root,renderer_proof=renderer_archive_view(root,current_commit,old_commit)
            root.validate_namespace()
            raw,mode=root.read('state/transaction/plan.json')
            need((0 if terminal else engine.MAX_METADATA_BYTES) < len(raw) <= engine.MAX_PLAN_BYTES and mode == 0o600,'archive_not_large_plan_repair')
            tx=engine.Transaction(transaction_root,expected_plan,gate=fresh,source_only=False)
            need(tx.plan['acceptedCommit'] == old_commit,'archive_old_source_binding')
            prepared_records(tx)
            tx.preflight(mixed=False)
            need(tx.side(exact_side),'archive_requires_complete_after' if terminal_applied else 'archive_requires_complete_before')
            for name in ('hub','ds3'):
                need(engine.tree_rows(endpoint_root,name+'/runtime') == tx.plan['runtimeRows'][name][exact_side],
                     'archive_runtime_not_before')
            # Fresh gates are observations, not a lease on journal/inventory.
            # Re-read the exact records after the gate, before claiming prepared.
            prepared_records(tx)
            if terminal_applied:
                _,after_proof=renderer_archive_view(root,current_commit,old_commit)
                need(after_proof==renderer_proof,'renderer_archive_proof_drift')
            return tx
        exact_prepared()
        # Capture the bound source directory identity before creating archive
        # state. All payload/prefix/namespace checks are repeated before rename.
        with state.parent(NAMESPACE) as (source_parent,source_name,source_check):
            source_identity=engine.identity(os.stat(source_name,dir_fd=source_parent,follow_symlinks=False))
            if not state.exists(ARCHIVES):
                state.mkdir(ARCHIVES)
                state.write_new(ARCHIVES+'/owner.json',ARCHIVE_OWNER_BYTES)
            need(state.read(ARCHIVES+'/owner.json') == (ARCHIVE_OWNER_BYTES,0o600),'archive_parent_owner')
            with state.parent(ARCHIVES+'/.unused') as (destination_parent,_,destination_check):
                need(stat.S_IMODE(os.fstat(destination_parent).st_mode) == 0o700,'archive_parent_not_private')
                for name in os.listdir(destination_parent):
                    if name == 'owner.json':continue
                    need(re.fullmatch('[0-9a-f]{40}-[0-9a-f]{64}',name) is not None,'archive_parent_inventory')
                    info=os.stat(name,dir_fd=destination_parent,follow_symlinks=False)
                    need(stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) == 0o700,'archive_parent_entry')
                destination_name=old_commit+'-'+expected_plan
                tx=exact_prepared()
                if not terminal: archive_source_ancestry(engine,root,old_commit,current_commit)
                source_check();destination_check()
                need(engine.identity(os.stat(source_name,dir_fd=source_parent,follow_symlinks=False)) == source_identity,
                     'archive_source_directory_drift')
                need(os.fstat(source_parent).st_dev == os.fstat(destination_parent).st_dev,'cross_device_archive')
                fresh(current_commit)
                prepared_records(tx)
                if terminal:
                    # The final local gate can expose drift. Recheck the entire
                    # old installed closure after it, not just the journal.
                    tx=exact_prepared()
                    need(tx.side(exact_side),'archive_requires_complete_after' if terminal_applied else 'archive_requires_complete_before')
                    for name in ('hub','ds3'):
                        need(engine.tree_rows(endpoint_root,name+'/runtime') == tx.plan['runtimeRows'][name][exact_side],
                             'archive_runtime_not_after' if terminal_applied else 'archive_runtime_not_before')
                    prepared_records(tx)
                    source_check();destination_check()
                    need(engine.identity(os.stat(source_name,dir_fd=source_parent,follow_symlinks=False)) == source_identity,
                         'archive_source_directory_drift')
                exclusive_rename(source_parent,source_name,destination_parent,destination_name)
                os.fsync(source_parent);os.fsync(destination_parent)
                need(engine.identity(os.stat(destination_name,dir_fd=destination_parent,follow_symlinks=False)) == source_identity,
                     'archive_published_identity_drift')
                source_check();destination_check()
        return {'state':'APPLIED_TRANSACTION_ARCHIVED' if terminal_applied else 'ROLLED_BACK_TRANSACTION_ARCHIVED' if terminal_rolled_back else 'PREPARED_TRANSACTION_ARCHIVED','changed':True,'liveStateChanged':True,'installedTargetsChanged':False,
                'oldSourceCommit':old_commit,'currentSourceCommit':current_commit,'planSha256':expected_plan,
                'oldTransactionRebound':False,'installedAcceptanceClaimed':False}


def operate(operation,commit,expected_plan=None,old_commit=None):
    need(operation in ('plan','apply','rollback','return','recover','archive-prepared','archive-applied','archive-rolled-back','bootstrap-policy-source'),'unsupported_operation')
    need(operation in ('archive-prepared','archive-applied','archive-rolled-back') or old_commit is None,'old_binding_archive_only')
    source_check(commit)
    engine=load_engine()
    root=make_root(engine)
    try:
        if operation in ('archive-prepared','archive-applied','archive-rolled-back'):return archive_prepared(engine,root,commit,old_commit,expected_plan,terminal_applied=operation == 'archive-applied',terminal_rolled_back=operation == 'archive-rolled-back')
        with read_only_lock(root), prerequisite_bridge(engine,root,commit,operation):
            source_gate(commit,engine,root,operation)
            # Made only after scoped operation readiness under the lock.
            # No persisted or caller-supplied PASS exists.
            fresh=lambda exact: local_gate(engine,root,exact)
            root._publication_check=lambda: fresh(commit)
            if operation == 'bootstrap-policy-source':
                need(expected_plan is None,'bootstrap_has_no_runtime_plan')
                fresh(commit)
                return bootstrap_policy_source(engine,root,commit,fresh)
            if operation == 'plan':
                fresh(commit)
                definition,policy=delivery(engine,root)
                desired=policy['desiredRuntimeHashes' if definition['schema'] >= 2 else 'desiredPEHashes']
                if root.exists('state/transaction'):
                    root.validate_namespace()
                    need(pin(expected_plan),'existing_transaction_plan_pin_required')
                    tx=engine.Transaction(root,expected_plan,gate=fresh,source_only=False)
                    need(tx.plan['acceptedCommit'] == commit,'transaction_source_commit_drift')
                    tx.preflight(mixed=True)
                    return {'state':'PLANNED_EXISTING_TRANSACTION','changed':False,'liveStateChanged':False,'journalPhase':tx.journal()['phase'],'planSha256':expected_plan}
                return build_delivery(engine,root,commit,definition,policy)
            need(pin(expected_plan),'reviewed_plan_pin_required')
            if operation == 'apply' and not root.exists('state/transaction'):
                fresh(commit)
                definition,policy=delivery(engine,root)
                desired=policy['desiredRuntimeHashes' if definition['schema'] >= 2 else 'desiredPEHashes']
                planned=build_delivery(engine,root,commit,definition,policy)
                need(planned['planSha256'] == expected_plan,'prestate_changed_since_plan')
                root.ensure_namespace()
                prepared=build_delivery(engine,root,commit,definition,policy,publish=True)
                need(prepared['planSha256'] == expected_plan,'prepared_plan_drift')
            tx=engine.Transaction(root,expected_plan,gate=fresh,source_only=False)
            root.validate_namespace()
            need(tx.plan['acceptedCommit'] == commit,'transaction_source_commit_drift')
            result=tx.run('before' if operation == 'rollback' else 'after',recover=operation == 'recover')
            # The engine's fixture report always says liveStateChanged=false.
            # This fixed-path route separately reports installed mutation.
            result['liveStateChanged']=result['changed']
            result['sourceCommitUnchanged']=True
            result['installedAcceptanceClaimed']=False
            if result['state'] == 'ROLLED-BACK':
                # DS3's generation is independently runnable from schema4,
                # while the hub still retains its canonical source equality.
                result['sourceRollbackSuccessorRequired']=True
                result['ds3RuntimePolicySourceIndependent']=engine.decode(tx.images['ds3.manifest']['before'][0]).get('schema') == 4
            return result
    finally:
        root.close()


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation',choices=('plan','apply','rollback','return','recover','archive-prepared','archive-applied','archive-rolled-back','bootstrap-policy-source'))
    parser.add_argument('accepted_commit')
    parser.add_argument('--plan-sha256')
    parser.add_argument('--old-commit')
    args=parser.parse_args()
    os.umask(0o077)
    print(json.dumps(operate(args.operation,args.accepted_commit,args.plan_sha256,args.old_commit)))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        unknown=getattr(error,'settlement_failed',False) is not False or getattr(error,'private_owner',None) is not None
        print(json.dumps({'state':'UNKNOWN' if unknown else 'BLOCKED','reason':'operation_settlement_unconfirmed' if unknown else str(error) if isinstance(error,Blocked) or type(error).__name__ == 'Blocked' else type(error).__name__,
                          'installedAcceptanceClaimed':False,'automaticRetryAllowed':False,'custodyUnknown':unknown}))
        sys.exit(1)
