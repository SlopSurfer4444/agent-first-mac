def validate_post_integration_commit_identity(commit, parent, policy_name):
    """Rebuild the exact raw commit object, without trusting its evidence."""
    policy = POST_INTEGRATION_COMMIT_POLICY[policy_name]
    tree = git("rev-parse", commit + "^{tree}")
    content = (
        "tree " + tree + "\n" +
        "parent " + parent + "\n" +
        "author " + policy["author"] + " " + str(policy["epoch"]) + " " + policy["timezone"] + "\n" +
        "committer " + policy["committer"] + " " + str(policy["epoch"]) + " " + policy["timezone"] + "\n\n" +
        policy["message"]
    ).encode()
    raw = b"commit " + str(len(content)).encode() + b"\0" + content
    require(hashlib.sha1(raw).hexdigest() == commit and
            subprocess.run([*GIT, "cat-file", "-p", commit], cwd=ROOT,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           check=False).stdout == content,
            "post_integration_" + policy_name + "_commit_identity")
    return tree


