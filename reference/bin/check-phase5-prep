    """Exact immutable identity carrier for one retained reviewer root."""
    __slots__ = ()

    def __new__(cls, fields):
        require(type(fields) is tuple and len(fields) == 3,
                "bridge52_reviewer_setup_container")
        return tuple.__new__(cls, fields)


