        }
        and all(value["tests"].values()),
        "compatibility_evidence_tests",
    )


def validate_compatibility_correction_evidence(implementation):
    validate_compatibility_correction_evidence_value(
        strict_json(ROOT / COMPATIBILITY_EVIDENCE), implementation
    )


def validate_descendant_baseline_evidence_value(
    value, directory, implementation
):
    require(
        set(value)
        == {
            "acceptedState",
            "base",
            "branch",
            "correction",
            "gate",
            "phase",
            "protectedContract",
            "protectedState",
            "rollback",
            "schema",
            "systemMutations",
            "tests",
        },
        "descendant_evidence_keys",
    )
    require(
        value["schema"] == 1
        and value["phase"]
        == "phase5_descendant_protected_baseline_correction"
        and value["base"] == FIRST_COMPATIBILITY_EVIDENCE_COMMIT
        and value["branch"] == BRANCH,
        "descendant_evidence_header",
    )
    require(
        value["acceptedState"]
        == {
            "phase4AcceptanceCommit": BASE,
            "phase5AcceptanceCommit": ACCEPTANCE_COMMIT,
            "phase5ApplyAuthorized": False,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
            "preparationVerdict": ACCEPTED_VERDICT,
        },
        "descendant_evidence_accepted_state",
    )
    require(
        value["correction"]
        == {
            "acceptanceRecordCreated": False,
            "acceptanceRecordModified": False,
            "appendOnly": True,
            "firstCompatibilityEvidenceCommit":
                FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
            "firstCompatibilityImplementationCommit":
                FIRST_COMPATIBILITY_IMPLEMENTATION,
            "implementationCommit": implementation,
            "implementationFilesSHA256":
                implementation_file_hashes(directory, implementation),
            "parent": FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
            "protectedBaselineIsEvidenceCommit": True,
        },
        "descendant_evidence_correction",
    )
    require(
        value["gate"]
        == {
            "independentReviewRequired": True,
            "marker": DESCENDANT_BASELINE_MARKER,
            "maximumExecutorVerdict": DESCENDANT_BASELINE_VERDICT,
            "phase5ApplyAuthorized": False,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
        },
        "descendant_evidence_gate",
    )
    require(
        value["protectedContract"]
        == {
            "firstCompatibilityPairExact": True,
            "historicalAcceptanceObjectsExact": True,
            "newPairFirstAfterCompatibilityEvidence": True,
            "postBaselineProtectedDriftDenied": True,
            "validatorAndDoctorSurfacesProtected": True,
        },
        "descendant_evidence_protected_contract",
    )
    require(
        value["protectedState"]
        == {
            "allProtectedWorktreesCleanClaimed": False,
            "controlMainAndMigrationClean": True,
            "externalBlocker": "unrelated-phase4-worktree-tracked-deletion",
            "observedEntry":
                "install-bundles/phase-4/aid-admin/"
                "launch-owner-authenticated-install.zsh",
            "targetCleanAfterCommitRequired": True,
            "unrelatedWorktreeTouched": False,
        },
        "descendant_evidence_protected_state",
    )
    require(
        value["rollback"]
        == {
            "acceptanceRecordsUnchanged": True,
            "liveRollbackRequired": False,
            "systemStateChanged": False,
        },
        "descendant_evidence_rollback",
    )
    require(
        value["systemMutations"]
        == {
            "codexLiveState": False,
            "hooksOrSkillsInstalled": False,
            "performed": False,
            "pluginsMcpAppsOauth": False,
            "rootOrSystem": False,
        },
        "descendant_evidence_mutations",
    )
    require(
        set(value["tests"]) == DESCENDANT_BASELINE_TEST_KEYS
        and all(value["tests"].values()),
        "descendant_evidence_tests",
    )


