    )
    require(
        set(value["tests"])
        == {
            "cleanNoOriginCorrectionReview",
            "cleanNoOriginMainDescendant",
            "diffCheck",
            "gitFsck",
            "phase4ComponentSuites",
            "phase4FinalDoctorHuman",
