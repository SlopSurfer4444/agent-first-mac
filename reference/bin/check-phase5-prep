    def __new__(cls, fields):
        require(type(fields) is tuple and len(fields) == 6,
                "bridge52_third_setup_container")
        return tuple.__new__(cls, fields)


def bridge_v52_local_first_case(root_state, doctor, lifecycle, actual,
                                predicate):
    """Own the complete first local setup transaction before append."""
    first_case = "prep-implementation-positive"
    result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = None
        source_status = None
        phase4 = None
        provider_context = None
        provider_loads = None
        provider_calls = None
        temporary = None
        implementation_root = None
        review_root = None
        evidence = None
        review_evidence = None
        hardened = None
        setup = None
        first_error = None

        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == first_case and
                    lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2" and
                    lifecycle.local_setup is None and
                    lifecycle.local_setup_fields is None and
                    lifecycle.local_setup_root is None,
                    "bridge52_local_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1,
                    "bridge52_local_provider")
            require(provider_context.get() is None,
                    "bridge52_local_provider")
            require(callable(predicate), "bridge52_local_executor")

            temporary = Path(tempfile.mkdtemp(
                prefix="bridge-v52-local.")).resolve()
            implementation_root = temporary / "implementation"
            bridge_v52_fresh_implementation_repository(
                ROOT, root_state.implementation, implementation_root, doctor)
            review_root = temporary / "review"
            bridge_v52_fresh_implementation_repository(
                ROOT, root_state.implementation, review_root, doctor)
            evidence = bridge_v52_real_evidence_fixture(
                doctor, root_state.implementation, review_root)
            review_evidence = bridge_v52_commit_child(
                review_root, doctor, root_state.implementation,
                raw=(json.dumps(evidence, sort_keys=True,
                                separators=(",", ":")) + "\n").encode())
            hardened = bridge_v52_child_environment(os.environ)
            predicate(implementation_root, hardened)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        if first_error is None:
            try:
                require(tuple(actual) == prefix and
                        environment_before is not None and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        temporary is not None and temporary.is_dir() and
                        implementation_root.parent == temporary and
                        review_root.parent == temporary and
                        implementation_root != review_root and
                        type(evidence) is dict and
                        type(review_evidence) is str and
                        re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                        type(hardened) is dict and
                        BRIDGE_V52_PRIVATE_RECORD not in hardened,
                        "bridge52_local_finalization")
                fields = (
                    temporary, implementation_root, review_root, evidence,
                    review_evidence, hardened)
                setup = BridgeV52LocalSetup(fields)
                require(type(setup) is BridgeV52LocalSetup and
                        len(setup) == 6 and tuple(setup) == fields and
                        all(value is expected for value, expected in
                            zip(setup, fields)) and
                        not hasattr(setup, "__dict__"),
                        "bridge52_local_setup_seal")
                lifecycle.local_setup = setup
                lifecycle.local_setup_fields = fields
                lifecycle.local_setup_root = temporary
                require(lifecycle.local_setup is setup and
                        lifecycle.local_setup_fields is fields and
                        lifecycle.local_setup_root is temporary,
                        "bridge52_local_setup_seal")
                result[0] = lifecycle.local_setup
                actual.append(first_case)
            except Exception as finalization_error:
                first_error = finalization_error

        if first_error is not None:
            result[0] = None
            lifecycle.local_setup = None
            lifecycle.local_setup_fields = None
            lifecycle.local_setup_root = None
            if temporary is not None:
                try:
                    bridge_v52_remove_tree(temporary)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((temporary is None or
                         not os.path.lexists(temporary)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or
                         dict(os.environ) == environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        (source_head is None or
                         git("rev-parse", "HEAD", cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls)) and
                        lifecycle.local_setup is None and
                        lifecycle.local_setup_fields is None and
                        lifecycle.local_setup_root is None,
                        "bridge52_local_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(first_case, owned)
    return result[0]


def bridge_v52_local_second_case(root_state, lifecycle, actual,
                                 returned_setup, binder):
    """Own returned-setup validation and the complete second local case."""
    second_case = "apply-implementation-positive"

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = None
        source_status = None
        phase4 = None
        provider_context = None
        provider_loads = None
        provider_calls = None
        stored_setup = None
        stored_fields = None
        cleanup_root = None
        values = None
        first_error = None

        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == second_case and
                    lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_local_second_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_local_second_provider")

            stored_setup = lifecycle.local_setup
            stored_fields = lifecycle.local_setup_fields
            cleanup_root = lifecycle.local_setup_root
            require(type(stored_setup) is BridgeV52LocalSetup and
                    type(stored_fields) is tuple and
                    type(cleanup_root) is type(Path()) and
                    returned_setup is stored_setup,
                    "bridge52_local_returned_container")
            values = tuple(stored_setup)
            require(len(stored_setup) == len(stored_fields) ==
                        len(values) == 6,
                    "bridge52_local_returned_length")
            require(values == stored_fields and
                    all(value is expected for value, expected in
                        zip(values, stored_fields)),
                    "bridge52_local_returned_identity")
            (temporary, implementation_root, review_root, evidence,
             review_evidence, hardened) = values
            require(temporary is cleanup_root and
                    isinstance(temporary, Path) and temporary.is_dir() and
                    implementation_root is stored_fields[1] and
                    review_root is stored_fields[2] and
                    implementation_root == temporary / "implementation" and
                    review_root == temporary / "review" and
                    implementation_root != review_root and
                    evidence is stored_fields[3] and type(evidence) is dict and
                    review_evidence is stored_fields[4] and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    hardened is stored_fields[5] and type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(binder),
                    "bridge52_local_returned_order")
            binder(*values)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        if first_error is None:
            try:
                require(prefix is not None and tuple(actual) == prefix and
                        environment_before is not None and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        stored_setup is returned_setup and
                        lifecycle.local_setup is stored_setup and
                        lifecycle.local_setup_fields is stored_fields and
                        lifecycle.local_setup_root is cleanup_root and
                        tuple(stored_setup) == stored_fields and
                        all(value is expected for value, expected in
                            zip(stored_setup, stored_fields)) and
                        cleanup_root.is_dir(),
                        "bridge52_local_second_finalization")
                lifecycle.local_setup = None
                lifecycle.local_setup_fields = None
                lifecycle.local_setup_root = None
                require(lifecycle.local_setup is None and
                        lifecycle.local_setup_fields is None and
                        lifecycle.local_setup_root is None,
                        "bridge52_local_second_finalization")
                actual.append(second_case)
            except Exception as finalization_error:
                first_error = finalization_error

        if first_error is not None:
            lifecycle.local_setup = None
            lifecycle.local_setup_fields = None
            lifecycle.local_setup_root = None
            if cleanup_root is not None:
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or
                         dict(os.environ) == environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        (source_head is None or
                         git("rev-parse", "HEAD", cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls)) and
                        lifecycle.local_setup is None and
                        lifecycle.local_setup_fields is None and
                        lifecycle.local_setup_root is None,
                        "bridge52_local_second_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(second_case, owned)


def bridge_v52_reviewer_first_case(doctor, lifecycle, actual, temporary,
                                   review_root, review_evidence, hardened,
                                   predicate):
    """Own and seal the first reviewer-descendant transaction."""
    first_case = "phase4-reviewer-descendant-success"
    result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = None
        source_status = None
        review_head = None
        review_status = None
        review_refs = None
        review_remotes = None
        phase4 = None
        provider_context = None
        provider_loads = None
        provider_calls = None
        destination = None
        reviewer_head = None
        fields = None
        setup = None
        first_error = None

        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == first_case and
                    lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2" and
                    lifecycle.reviewer_setup is None and
                    lifecycle.reviewer_setup_fields is None and
                    lifecycle.reviewer_setup_root is None,
                    "bridge52_reviewer_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT)
            require(type(temporary) is type(Path()) and temporary.is_dir() and
                    type(review_root) is type(Path()) and
                    review_root.is_dir() and review_root.parent == temporary and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(predicate), "bridge52_reviewer_setup")
            review_head = git("rev-parse", "HEAD", cwd=review_root)
            review_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=review_root)
            review_refs = git("show-ref", cwd=review_root)
            review_remotes = git("remote", "-v", cwd=review_root)
            require(review_head == review_evidence and review_status == "" and
                    review_remotes == "", "bridge52_reviewer_setup")
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_reviewer_provider")

            destination = temporary / "reviewer"
            require(not os.path.lexists(destination),
                    "bridge52_reviewer_destination")
            checked([*GIT, "clone", "--no-local", "--quiet", review_root,
                     destination], environment=hardened)
            checked([*GIT, "remote", "remove", "origin"], cwd=destination,
                    environment=hardened)
            checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                     review_evidence], cwd=destination, environment=hardened)
            relative = "review/v52-review-1.txt"
            reviewer_path = destination / relative
            reviewer_path.parent.mkdir(parents=True, exist_ok=True)
            reviewer_path.write_text("bounded review 1\n")
            checked([*GIT, "add", "--", relative], cwd=destination,
                    environment=hardened)
            reviewer_identity = [
                "Reviewer", "reviewer@agent-first-mac.invalid",
                "Reviewer", "reviewer@agent-first-mac.invalid",
            ]
            checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
                     "Bounded Bridge review 1"], cwd=destination,
                    environment={
                        **bridge_v52_commit_environment(
                            doctor, doctor.BRIDGE_V52_EVIDENCE_EPOCH + 1),
                        "GIT_AUTHOR_NAME": reviewer_identity[0],
                        "GIT_AUTHOR_EMAIL": reviewer_identity[1],
                        "GIT_COMMITTER_NAME": reviewer_identity[2],
                        "GIT_COMMITTER_EMAIL": reviewer_identity[3],
                    })
            reviewer_head = git("rev-parse", "HEAD", cwd=destination)
            commit_fields = git(
                "show", "-s", "--format=%at%x00%ct%x00%s", reviewer_head,
                cwd=destination).split("\x00")
            require(git("remote", cwd=destination) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=destination) == doctor.BRIDGE_V52_BRANCH and
                    git("rev-parse", reviewer_head + "^",
                        cwd=destination) == review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=destination) == "refs/heads/" +
                            doctor.BRIDGE_V52_BRANCH + " " + reviewer_head and
                    commit_scope(reviewer_head, cwd=destination) == {relative}
                    and metadata(reviewer_head, cwd=destination) ==
                        reviewer_identity and
                    commit_fields == [
                        str(doctor.BRIDGE_V52_EVIDENCE_EPOCH + 1),
                        str(doctor.BRIDGE_V52_EVIDENCE_EPOCH + 1),
                        "Bounded Bridge review 1"] and
                    git("ls-tree", reviewer_head, "--", relative,
                        cwd=destination).startswith("100644 blob ") and
                    stat.S_IMODE(reviewer_path.stat().st_mode) == 0o644 and
                    reviewer_path.read_text() == "bounded review 1\n" and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=destination) == "",
                    "bridge52_reviewer_validation")
            fields = (destination, review_evidence, reviewer_head)
            setup = BridgeV52ReviewerSetup(fields)
            require(type(setup) is BridgeV52ReviewerSetup and
                    len(setup) == 3 and tuple(setup) == fields and
                    all(value is expected for value, expected in
                        zip(setup, fields)) and
                    not hasattr(setup, "__dict__"),
                    "bridge52_reviewer_setup_seal")
            lifecycle.reviewer_setup = setup
            lifecycle.reviewer_setup_fields = fields
            lifecycle.reviewer_setup_root = destination
            require(lifecycle.reviewer_setup is setup and
                    lifecycle.reviewer_setup_fields is fields and
                    lifecycle.reviewer_setup_root is destination,
                    "bridge52_reviewer_setup_seal")
            predicate(destination)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        if first_error is None:
            try:
                require(prefix is not None and tuple(actual) == prefix and
                        environment_before is not None and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=review_root) ==
                            review_status and
                        git("show-ref", cwd=review_root) == review_refs and
                        git("remote", "-v", cwd=review_root) ==
                            review_remotes and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        setup is not None and result[0] is None and
                        lifecycle.reviewer_setup is setup and
                        lifecycle.reviewer_setup_fields is fields and
                        lifecycle.reviewer_setup_root is destination and
                        tuple(setup) == fields and
                        all(value is expected for value, expected in
                            zip(setup, fields)) and
                        destination.is_dir() and
                        git("remote", cwd=destination) == "" and
                        git("rev-parse", "--abbrev-ref", "HEAD",
                            cwd=destination) == doctor.BRIDGE_V52_BRANCH and
                        git("rev-parse", "HEAD", cwd=destination) ==
                            reviewer_head and
                        git("rev-parse", reviewer_head + "^",
                            cwd=destination) == review_evidence and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=destination) == "refs/heads/" +
                                doctor.BRIDGE_V52_BRANCH + " " +
                                reviewer_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=destination) == "",
                        "bridge52_reviewer_finalization")
                result[0] = lifecycle.reviewer_setup
                actual.append(first_case)
            except Exception as finalization_error:
                first_error = finalization_error

        if first_error is not None:
            result[0] = None
            lifecycle.reviewer_setup = None
            lifecycle.reviewer_setup_fields = None
            lifecycle.reviewer_setup_root = None
            if destination is not None:
                try:
                    bridge_v52_remove_tree(destination)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((destination is None or
                         not os.path.lexists(destination)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or
                         dict(os.environ) == environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        (source_head is None or
                         git("rev-parse", "HEAD", cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (review_head is None or
                         git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head) and
                        (review_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=review_root) ==
                            review_status) and
                        (review_refs is None or
                         git("show-ref", cwd=review_root) == review_refs) and
                        (review_remotes is None or
                         git("remote", "-v", cwd=review_root) ==
                            review_remotes) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls)) and
                        lifecycle.reviewer_setup is None and
                        lifecycle.reviewer_setup_fields is None and
                        lifecycle.reviewer_setup_root is None,
                        "bridge52_reviewer_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(first_case, owned)
    return result[0]


def bridge_v52_reviewer_follow_case(doctor, lifecycle, actual,
                                    returned_setup, case_id, predicate, *,
                                    final):
    """Own stored reviewer-root use and cleanup under the exact consumer ID."""
    require(case_id in {
        "prep-reviewer-descendant-success",
        "apply-reviewer-descendant-success",
    } and type(final) is bool and
            final == (case_id == "apply-reviewer-descendant-success"),
            "bridge52_reviewer_consumer_case")

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = None
        source_status = None
        phase4 = None
        provider_context = None
        provider_loads = None
        provider_calls = None
        stored_setup = None
        stored_fields = None
        cleanup_root = None
        values = None
        first_error = None

        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_reviewer_consumer_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_reviewer_consumer_provider")

            stored_setup = lifecycle.reviewer_setup
            stored_fields = lifecycle.reviewer_setup_fields
            cleanup_root = lifecycle.reviewer_setup_root
            require(type(stored_setup) is BridgeV52ReviewerSetup and
                    type(stored_fields) is tuple and
                    type(cleanup_root) is type(Path()) and
                    returned_setup is stored_setup,
                    "bridge52_reviewer_returned_container")
            values = tuple(stored_setup)
            require(len(stored_setup) == len(stored_fields) ==
                        len(values) == 3 and
                    values == stored_fields and
                    all(value is expected for value, expected in
                        zip(values, stored_fields)),
                    "bridge52_reviewer_returned_identity")
            reviewer_root, review_evidence, reviewer_head = values
            require(reviewer_root is cleanup_root and
                    reviewer_root is stored_fields[0] and
                    review_evidence is stored_fields[1] and
                    reviewer_head is stored_fields[2] and
                    reviewer_root.is_dir() and
                    type(review_evidence) is str and
                    type(reviewer_head) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    re.fullmatch(r"[0-9a-f]{40}", reviewer_head) and
                    git("remote", cwd=reviewer_root) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=reviewer_root) == doctor.BRIDGE_V52_BRANCH and
                    git("rev-parse", "HEAD", cwd=reviewer_root) ==
                        reviewer_head and
                    git("rev-parse", reviewer_head + "^",
                        cwd=reviewer_root) == review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=reviewer_root) == "refs/heads/" +
                            doctor.BRIDGE_V52_BRANCH + " " + reviewer_head and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=reviewer_root) == "" and
                    callable(predicate),
                    "bridge52_reviewer_returned_order")
            predicate(reviewer_root)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        if first_error is None:
            try:
                require(prefix is not None and tuple(actual) == prefix and
                        environment_before is not None and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        stored_setup is returned_setup and
                        lifecycle.reviewer_setup is stored_setup and
                        lifecycle.reviewer_setup_fields is stored_fields and
                        lifecycle.reviewer_setup_root is cleanup_root and
                        tuple(stored_setup) == stored_fields and
                        all(value is expected for value, expected in
                            zip(stored_setup, stored_fields)) and
                        cleanup_root.is_dir() and
                        git("remote", cwd=cleanup_root) == "" and
                        git("rev-parse", "--abbrev-ref", "HEAD",
                            cwd=cleanup_root) == doctor.BRIDGE_V52_BRANCH and
                        git("rev-parse", "HEAD", cwd=cleanup_root) ==
                            stored_fields[2] and
                        git("rev-parse", stored_fields[2] + "^",
                            cwd=cleanup_root) == stored_fields[1] and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=cleanup_root) == "refs/heads/" +
                                doctor.BRIDGE_V52_BRANCH + " " +
                                stored_fields[2] and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=cleanup_root) == "",
                        "bridge52_reviewer_consumer_finalization")
                if final:
                    bridge_v52_remove_tree(cleanup_root)
                    require(not os.path.lexists(cleanup_root),
                            "bridge52_reviewer_consumer_cleanup")
                    lifecycle.reviewer_setup = None
                    lifecycle.reviewer_setup_fields = None
                    lifecycle.reviewer_setup_root = None
                    require(lifecycle.reviewer_setup is None and
                            lifecycle.reviewer_setup_fields is None and
                            lifecycle.reviewer_setup_root is None,
                            "bridge52_reviewer_consumer_cleanup")
                actual.append(case_id)
            except Exception as finalization_error:
                first_error = finalization_error

        if first_error is not None:
            lifecycle.reviewer_setup = None
            lifecycle.reviewer_setup_fields = None
            lifecycle.reviewer_setup_root = None
            if cleanup_root is not None:
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or
                         dict(os.environ) == environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        (source_head is None or
                         git("rev-parse", "HEAD", cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls)) and
                        lifecycle.reviewer_setup is None and
                        lifecycle.reviewer_setup_fields is None and
                        lifecycle.reviewer_setup_root is None,
                        "bridge52_reviewer_consumer_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)


def bridge_v52_main_first_case(doctor, lifecycle, actual, temporary,
                               review_root, review_evidence, hardened,
                               predicate):
    """Own and seal the first main-descendant transaction."""
    first_case = "phase4-main-success"
    result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = None
        source_status = None
        review_head = None
        review_status = None
        review_refs = None
        review_remotes = None
        phase4 = None
        provider_context = None
        provider_loads = None
        provider_calls = None
        destination = None
        main_ref = None
        fields = None
        setup = None
        first_error = None

        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == first_case and
                    lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2" and
                    lifecycle.main_setup is None and
                    lifecycle.main_setup_fields is None and
                    lifecycle.main_setup_root is None,
                    "bridge52_main_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT)
            require(type(temporary) is type(Path()) and temporary.is_dir() and
                    type(review_root) is type(Path()) and
                    review_root.is_dir() and review_root.parent == temporary and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(predicate), "bridge52_main_setup")
            review_head = git("rev-parse", "HEAD", cwd=review_root)
            review_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=review_root)
            review_refs = git("show-ref", cwd=review_root)
            review_remotes = git("remote", "-v", cwd=review_root)
            require(review_head == review_evidence and review_status == "" and
                    review_remotes == "", "bridge52_main_setup")
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_main_provider")

            destination = temporary / "main"
            require(not os.path.lexists(destination),
                    "bridge52_main_destination")
            checked([*GIT, "clone", "--no-local", "--quiet", review_root,
                     destination], environment=hardened)
            checked([*GIT, "remote", "remove", "origin"], cwd=destination,
                    environment=hardened)
            checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                     review_evidence], cwd=destination, environment=hardened)
            checked([*GIT, "branch", "-m", "main"], cwd=destination,
                    environment=hardened)
            main_ref = "refs/heads/main"
            require(git("remote", cwd=destination) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=destination) == "main" and
                    git("rev-parse", "HEAD", cwd=destination) ==
                        review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=destination) == main_ref + " " + review_evidence and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=destination) == "",
                    "bridge52_main_validation")
            fields = (destination, review_evidence, main_ref)
            setup = BridgeV52MainSetup(fields)
            require(type(setup) is BridgeV52MainSetup and len(setup) == 3 and
                    tuple(setup) == fields and
                    all(value is expected for value, expected in
                        zip(setup, fields)) and
                    not hasattr(setup, "__dict__"),
                    "bridge52_main_setup_seal")
            lifecycle.main_setup = setup
            lifecycle.main_setup_fields = fields
            lifecycle.main_setup_root = destination
            require(lifecycle.main_setup is setup and
                    lifecycle.main_setup_fields is fields and
                    lifecycle.main_setup_root is destination,
                    "bridge52_main_setup_seal")
            predicate(destination)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        if first_error is None:
            try:
                require(prefix is not None and tuple(actual) == prefix and
                        environment_before is not None and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=review_root) ==
                            review_status and
                        git("show-ref", cwd=review_root) == review_refs and
                        git("remote", "-v", cwd=review_root) ==
                            review_remotes and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        setup is not None and result[0] is None and
                        lifecycle.main_setup is setup and
                        lifecycle.main_setup_fields is fields and
                        lifecycle.main_setup_root is destination and
                        tuple(setup) == fields and
                        all(value is expected for value, expected in
                            zip(setup, fields)) and
                        destination.is_dir() and
                        git("remote", cwd=destination) == "" and
                        git("rev-parse", "--abbrev-ref", "HEAD",
                            cwd=destination) == "main" and
                        git("rev-parse", "HEAD", cwd=destination) ==
                            review_evidence and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=destination) == main_ref + " " +
                                review_evidence and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=destination) == "",
                        "bridge52_main_finalization")
                result[0] = lifecycle.main_setup
                actual.append(first_case)
            except Exception as finalization_error:
                first_error = finalization_error

        if first_error is not None:
            result[0] = None
            lifecycle.main_setup = None
            lifecycle.main_setup_fields = None
            lifecycle.main_setup_root = None
            if destination is not None:
                try:
                    bridge_v52_remove_tree(destination)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((destination is None or
                         not os.path.lexists(destination)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or
                         dict(os.environ) == environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        (source_head is None or
                         git("rev-parse", "HEAD", cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (review_head is None or
                         git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head) and
                        (review_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=review_root) ==
                            review_status) and
                        (review_refs is None or
                         git("show-ref", cwd=review_root) == review_refs) and
                        (review_remotes is None or
                         git("remote", "-v", cwd=review_root) ==
                            review_remotes) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls)) and
                        lifecycle.main_setup is None and
                        lifecycle.main_setup_fields is None and
                        lifecycle.main_setup_root is None,
                        "bridge52_main_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(first_case, owned)
    return result[0]


def bridge_v52_main_follow_case(doctor, lifecycle, actual, returned_setup,
                                case_id, predicate, *, final):
    """Own stored main-root use and cleanup under the exact consumer ID."""
    require(case_id in {"prep-main-success", "apply-main-success"} and
            type(final) is bool and
            final == (case_id == "apply-main-success"),
            "bridge52_main_consumer_case")

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = None
        source_status = None
        phase4 = None
        provider_context = None
        provider_loads = None
        provider_calls = None
        stored_setup = None
        stored_fields = None
        cleanup_root = None
        values = None
        first_error = None

        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_main_consumer_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git(
                "status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_main_consumer_provider")

            stored_setup = lifecycle.main_setup
            stored_fields = lifecycle.main_setup_fields
            cleanup_root = lifecycle.main_setup_root
            require(type(stored_setup) is BridgeV52MainSetup and
                    type(stored_fields) is tuple and
                    type(cleanup_root) is type(Path()) and
                    returned_setup is stored_setup,
                    "bridge52_main_returned_container")
            values = tuple(stored_setup)
            require(len(stored_setup) == len(stored_fields) ==
                        len(values) == 3 and
                    values == stored_fields and
                    all(value is expected for value, expected in
                        zip(values, stored_fields)),
                    "bridge52_main_returned_identity")
            main_root, review_evidence, main_ref = values
            require(main_root is cleanup_root and
                    main_root is stored_fields[0] and
                    review_evidence is stored_fields[1] and
                    main_ref is stored_fields[2] and
                    main_root.is_dir() and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    main_ref == "refs/heads/main" and
                    git("remote", cwd=main_root) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=main_root) == "main" and
                    git("rev-parse", "HEAD", cwd=main_root) ==
                        review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=main_root) == main_ref + " " + review_evidence and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=main_root) == "" and
                    callable(predicate), "bridge52_main_returned_order")
            predicate(main_root)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as restoration_error:
            if first_error is None:
                first_error = restoration_error

        if first_error is None:
            try:
                require(prefix is not None and tuple(actual) == prefix and
                        environment_before is not None and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        stored_setup is returned_setup and
                        lifecycle.main_setup is stored_setup and
                        lifecycle.main_setup_fields is stored_fields and
                        lifecycle.main_setup_root is cleanup_root and
                        tuple(stored_setup) == stored_fields and
                        all(value is expected for value, expected in
                            zip(stored_setup, stored_fields)) and
                        cleanup_root.is_dir() and
                        git("remote", cwd=cleanup_root) == "" and
                        git("rev-parse", "--abbrev-ref", "HEAD",
                            cwd=cleanup_root) == "main" and
                        git("rev-parse", "HEAD", cwd=cleanup_root) ==
                            stored_fields[1] and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=cleanup_root) == stored_fields[2] + " " +
                                stored_fields[1] and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=cleanup_root) == "",
                        "bridge52_main_consumer_finalization")
                if final:
                    bridge_v52_remove_tree(cleanup_root)
                    require(not os.path.lexists(cleanup_root),
                            "bridge52_main_consumer_cleanup")
                    lifecycle.main_setup = None
                    lifecycle.main_setup_fields = None
                    lifecycle.main_setup_root = None
                    require(lifecycle.main_setup is None and
                            lifecycle.main_setup_fields is None and
                            lifecycle.main_setup_root is None,
                            "bridge52_main_consumer_cleanup")
                actual.append(case_id)
            except Exception as finalization_error:
                first_error = finalization_error

        if first_error is not None:
            lifecycle.main_setup = None
            lifecycle.main_setup_fields = None
            lifecycle.main_setup_root = None
            if cleanup_root is not None:
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or
                         dict(os.environ) == environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        (source_head is None or
                         git("rev-parse", "HEAD", cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls)) and
                        lifecycle.main_setup is None and
                        lifecycle.main_setup_fields is None and
                        lifecycle.main_setup_root is None,
                        "bridge52_main_consumer_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)


def bridge_v52_protected_first_case(doctor, lifecycle, actual, temporary,
                                    review_root, review_evidence, hardened,
                                    predicate):
    """Own and seal the first protected-descendant denial transaction."""
    first_case = "phase4-protected-descendant-denial"
    result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        review_head = review_status = review_refs = review_remotes = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        destination = protected_head = protected_ref = protected_digest = None
        fields = setup = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == first_case and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2" and
                    lifecycle.protected_setup is None and
                    lifecycle.protected_setup_fields is None and
                    lifecycle.protected_setup_root is None,
                    "bridge52_protected_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            require(type(temporary) is type(Path()) and temporary.is_dir() and
                    type(review_root) is type(Path()) and
                    review_root.is_dir() and review_root.parent == temporary and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(predicate), "bridge52_protected_setup")
            review_head = git("rev-parse", "HEAD", cwd=review_root)
            review_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=review_root)
            review_refs = git("show-ref", cwd=review_root)
            review_remotes = git("remote", "-v", cwd=review_root)
            require(review_head == review_evidence and review_status == "" and
                    review_remotes == "", "bridge52_protected_setup")
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_protected_provider")

            destination = temporary / "protected-descendant"
            require(not os.path.lexists(destination),
                    "bridge52_protected_destination")
            checked([*GIT, "clone", "--no-local", "--quiet", review_root,
                     destination], environment=hardened)
            checked([*GIT, "remote", "remove", "origin"], cwd=destination,
                    environment=hardened)
            checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                     review_evidence], cwd=destination, environment=hardened)
            relative = "bin/check-phase5-prep"
            protected_path = destination / relative
            prior = protected_path.read_bytes()
            protected_path.write_bytes(prior + b"\n")
            protected_path.chmod(0o755)
            checked([*GIT, "add", "--", relative], cwd=destination,
                    environment=hardened)
            reviewer = ["Reviewer", "reviewer@agent-first-mac.invalid"] * 2
            checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
                     "Bounded Bridge review 1"], cwd=destination,
                    environment={
                        **bridge_v52_commit_environment(
                            doctor, doctor.BRIDGE_V52_EVIDENCE_EPOCH + 1),
                        "GIT_AUTHOR_NAME": reviewer[0],
                        "GIT_AUTHOR_EMAIL": reviewer[1],
                        "GIT_COMMITTER_NAME": reviewer[2],
                        "GIT_COMMITTER_EMAIL": reviewer[3],
                    })
            protected_head = git("rev-parse", "HEAD", cwd=destination)
            protected_ref = "refs/heads/" + doctor.BRIDGE_V52_BRANCH
            protected_digest = hashlib.sha256(
                protected_path.read_bytes()).hexdigest()
            require(git("remote", cwd=destination) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=destination) == doctor.BRIDGE_V52_BRANCH and
                    git("rev-parse", protected_head + "^",
                        cwd=destination) == review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=destination) == protected_ref + " " + protected_head
                    and commit_scope(protected_head, cwd=destination) ==
                        {relative} and
                    metadata(protected_head, cwd=destination) == reviewer and
                    git("ls-tree", protected_head, "--", relative,
                        cwd=destination).startswith("100755 blob ") and
                    stat.S_IMODE(protected_path.stat().st_mode) == 0o755 and
                    protected_path.read_bytes() == prior + b"\n" and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=destination) == "",
                    "bridge52_protected_validation")
            fields = (destination, review_evidence, protected_head,
                      protected_ref, protected_digest)
            setup = BridgeV52ProtectedSetup(fields)
            require(type(setup) is BridgeV52ProtectedSetup and len(setup) == 5
                    and tuple(setup) == fields and
                    all(value is expected for value, expected in
                        zip(setup, fields)) and
                    not hasattr(setup, "__dict__"),
                    "bridge52_protected_setup_seal")
            lifecycle.protected_setup = setup
            lifecycle.protected_setup_fields = fields
            lifecycle.protected_setup_root = destination
            require(lifecycle.protected_setup is setup and
                    lifecycle.protected_setup_fields is fields and
                    lifecycle.protected_setup_root is destination,
                    "bridge52_protected_setup_seal")
            predicate(destination)
        except Exception as error:
            first_error = error

        try:
            if environment_before is not None and dict(os.environ) != environment_before:
                os.environ.clear(); os.environ.update(environment_before)
        except Exception as error:
            if first_error is None: first_error = error
        try:
            if phase4 is not None and phase4._BRIDGE_V52_PROVIDER_TOKEN is not None:
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None: first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None: first_error = error
        try:
            if environment_before is not None and _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not command_before:
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None: first_error = error

        if first_error is None:
            try:
                relative = "bin/check-phase5-prep"
                protected_path = destination / relative
                require(tuple(actual) == prefix and dict(os.environ) ==
                        environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=review_root) ==
                            review_status and
                        git("show-ref", cwd=review_root) == review_refs and
                        git("remote", "-v", cwd=review_root) == review_remotes and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        setup is not None and result[0] is None and
                        lifecycle.protected_setup is setup and
                        lifecycle.protected_setup_fields is fields and
                        lifecycle.protected_setup_root is destination and
                        tuple(setup) == fields and destination.is_dir() and
                        git("remote", cwd=destination) == "" and
                        git("rev-parse", protected_head + "^",
                            cwd=destination) == review_evidence and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=destination) == protected_ref + " " +
                                protected_head and
                        hashlib.sha256(protected_path.read_bytes()).hexdigest()
                            == protected_digest and
                        stat.S_IMODE(protected_path.stat().st_mode) == 0o755 and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=destination) == "",
                        "bridge52_protected_finalization")
                result[0] = lifecycle.protected_setup
                actual.append(first_case)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            lifecycle.protected_setup = None
            lifecycle.protected_setup_fields = None
            lifecycle.protected_setup_root = None
            if destination is not None:
                try: bridge_v52_remove_tree(destination)
                except Exception: pass
            if prefix is not None:
                for _attempt in range(2):
                    try: actual[:] = prefix
                    except Exception: continue
                    break
            try:
                require((destination is None or not os.path.lexists(destination))
                        and (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (review_refs is None or git("show-ref", cwd=review_root)
                            == review_refs) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and lifecycle.protected_setup is None and
                        lifecycle.protected_setup_fields is None and
                        lifecycle.protected_setup_root is None,
                        "bridge52_protected_rollback")
            except Exception: pass
            raise first_error

    lifecycle.case(first_case, owned)
    return result[0]


def bridge_v52_protected_follow_case(lifecycle, actual, returned_setup,
                                     case_id, predicate, *, final):
    """Own stored protected-root use under the exact consumer denial ID."""
    require(case_id in {"prep-protected-descendant-denial",
                        "apply-protected-descendant-denial"} and
            type(final) is bool and
            final == (case_id == "apply-protected-descendant-denial"),
            "bridge52_protected_consumer_case")

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        stored_setup = stored_fields = cleanup_root = values = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_protected_consumer_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_protected_consumer_provider")
            stored_setup = lifecycle.protected_setup
            stored_fields = lifecycle.protected_setup_fields
            cleanup_root = lifecycle.protected_setup_root
            require(type(stored_setup) is BridgeV52ProtectedSetup and
                    type(stored_fields) is tuple and
                    type(cleanup_root) is type(Path()) and
                    returned_setup is stored_setup,
                    "bridge52_protected_returned_container")
            values = tuple(stored_setup)
            require(len(stored_setup) == len(stored_fields) == len(values) == 5
                    and values == stored_fields and
                    all(value is expected for value, expected in
                        zip(values, stored_fields)),
                    "bridge52_protected_returned_identity")
            protected_root, review_evidence, protected_head, protected_ref, protected_digest = values
            path = protected_root / "bin/check-phase5-prep"
            require(protected_root is cleanup_root and
                    protected_root is stored_fields[0] and
                    all(value is stored_fields[index] for index, value in
                        enumerate(values)) and protected_root.is_dir() and
                    protected_ref.startswith("refs/heads/") and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    re.fullmatch(r"[0-9a-f]{40}", protected_head) and
                    re.fullmatch(r"[0-9a-f]{64}", protected_digest) and
                    git("remote", cwd=protected_root) == "" and
                    git("rev-parse", protected_head + "^",
                        cwd=protected_root) == review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=protected_root) == protected_ref + " " +
                            protected_head and
                    hashlib.sha256(path.read_bytes()).hexdigest() ==
                        protected_digest and
                    stat.S_IMODE(path.stat().st_mode) == 0o755 and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=protected_root) == "" and callable(predicate),
                    "bridge52_protected_returned_order")
            predicate(protected_root)
        except Exception as error:
            first_error = error

        try:
            if environment_before is not None and dict(os.environ) != environment_before:
                os.environ.clear(); os.environ.update(environment_before)
        except Exception as error:
            if first_error is None: first_error = error
        try:
            if phase4 is not None and phase4._BRIDGE_V52_PROVIDER_TOKEN is not None:
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None: first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None: first_error = error
        try:
            if environment_before is not None and _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not command_before:
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None: first_error = error

        if first_error is None:
            try:
                path = cleanup_root / "bin/check-phase5-prep"
                require(tuple(actual) == prefix and dict(os.environ) ==
                        environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        stored_setup is returned_setup and
                        lifecycle.protected_setup is stored_setup and
                        lifecycle.protected_setup_fields is stored_fields and
                        lifecycle.protected_setup_root is cleanup_root and
                        tuple(stored_setup) == stored_fields and
                        cleanup_root.is_dir() and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=cleanup_root) == stored_fields[3] + " " +
                                stored_fields[2] and
                        hashlib.sha256(path.read_bytes()).hexdigest() ==
                            stored_fields[4] and
                        stat.S_IMODE(path.stat().st_mode) == 0o755 and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=cleanup_root) == "",
                        "bridge52_protected_consumer_finalization")
                if final:
                    bridge_v52_remove_tree(cleanup_root)
                    require(not os.path.lexists(cleanup_root),
                            "bridge52_protected_consumer_cleanup")
                    lifecycle.protected_setup = None
                    lifecycle.protected_setup_fields = None
                    lifecycle.protected_setup_root = None
                actual.append(case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            lifecycle.protected_setup = None
            lifecycle.protected_setup_fields = None
            lifecycle.protected_setup_root = None
            if cleanup_root is not None:
                try: bridge_v52_remove_tree(cleanup_root)
                except Exception: pass
            if prefix is not None:
                for _attempt in range(2):
                    try: actual[:] = prefix
                    except Exception: continue
                    break
            try:
                require((cleanup_root is None or not os.path.lexists(cleanup_root))
                        and (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and lifecycle.protected_setup is None and
                        lifecycle.protected_setup_fields is None and
                        lifecycle.protected_setup_root is None,
                        "bridge52_protected_consumer_rollback")
            except Exception: pass
            raise first_error

    lifecycle.case(case_id, owned)


def bridge_v52_executor_first_case(doctor, lifecycle, actual, temporary,
                                   review_root, review_evidence, hardened,
                                   predicate):
    """Own and seal the first executor-descendant denial transaction."""
    first_case = "phase4-executor-descendant-denial"
    result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        review_head = review_status = review_refs = review_remotes = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        destination = executor_head = executor_ref = executor_digest = None
        fields = setup = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == first_case and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2" and
                    lifecycle.executor_setup is None and
                    lifecycle.executor_setup_fields is None and
                    lifecycle.executor_setup_root is None,
                    "bridge52_executor_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            require(type(temporary) is type(Path()) and temporary.is_dir() and
                    type(review_root) is type(Path()) and
                    review_root.is_dir() and review_root.parent == temporary and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(predicate), "bridge52_executor_setup")
            review_head = git("rev-parse", "HEAD", cwd=review_root)
            review_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=review_root)
            review_refs = git("show-ref", cwd=review_root)
            review_remotes = git("remote", "-v", cwd=review_root)
            require(review_head == review_evidence and review_status == "" and
                    review_remotes == "", "bridge52_executor_setup")
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_executor_provider")

            destination = temporary / "executor-descendant"
            require(not os.path.lexists(destination),
                    "bridge52_executor_destination")
            checked([*GIT, "clone", "--no-local", "--quiet", review_root,
                     destination], environment=hardened)
            checked([*GIT, "remote", "remove", "origin"], cwd=destination,
                    environment=hardened)
            checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                     review_evidence], cwd=destination, environment=hardened)
            relative = "review/v52-review-1.txt"
            executor_path = destination / relative
            executor_path.parent.mkdir(parents=True, exist_ok=True)
            executor_path.write_text("bounded review 1\n")
            checked([*GIT, "add", "--", relative], cwd=destination,
                    environment=hardened)
            identity = doctor.BRIDGE_V52_IDENTITY
            require(type(identity) is list and len(identity) == 4 and
                    all(type(value) is str for value in identity),
                    "bridge52_executor_identity")
            checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
                     "Bounded Bridge review 1"], cwd=destination,
                    environment={
                        **bridge_v52_commit_environment(
                            doctor, doctor.BRIDGE_V52_EVIDENCE_EPOCH + 1),
                        "GIT_AUTHOR_NAME": identity[0],
                        "GIT_AUTHOR_EMAIL": identity[1],
                        "GIT_COMMITTER_NAME": identity[2],
                        "GIT_COMMITTER_EMAIL": identity[3],
                    })
            executor_head = git("rev-parse", "HEAD", cwd=destination)
            executor_ref = "refs/heads/" + doctor.BRIDGE_V52_BRANCH
            executor_digest = hashlib.sha256(
                executor_path.read_bytes()).hexdigest()
            require(git("remote", cwd=destination) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=destination) == doctor.BRIDGE_V52_BRANCH and
                    git("rev-parse", executor_head + "^",
                        cwd=destination) == review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=destination) == executor_ref + " " + executor_head
                    and commit_scope(executor_head, cwd=destination) ==
                        {relative} and
                    metadata(executor_head, cwd=destination) == identity and
                    git("ls-tree", executor_head, "--", relative,
                        cwd=destination).startswith("100644 blob ") and
                    stat.S_IMODE(executor_path.stat().st_mode) == 0o644 and
                    executor_path.read_bytes() == b"bounded review 1\n" and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=destination) == "",
                    "bridge52_executor_validation")
            fields = (destination, review_evidence, executor_head,
                      executor_ref, executor_digest)
            setup = BridgeV52ExecutorSetup(fields)
            require(type(setup) is BridgeV52ExecutorSetup and len(setup) == 5
                    and tuple(setup) == fields and
                    all(value is expected for value, expected in
                        zip(setup, fields)) and
                    not hasattr(setup, "__dict__"),
                    "bridge52_executor_setup_seal")
            lifecycle.executor_setup = setup
            lifecycle.executor_setup_fields = fields
            lifecycle.executor_setup_root = destination
            require(lifecycle.executor_setup is setup and
                    lifecycle.executor_setup_fields is fields and
                    lifecycle.executor_setup_root is destination,
                    "bridge52_executor_setup_seal")
            predicate(destination)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                relative = "review/v52-review-1.txt"
                executor_path = destination / relative
                require(tuple(actual) == prefix and dict(os.environ) ==
                        environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=review_root) ==
                            review_status and
                        git("show-ref", cwd=review_root) == review_refs and
                        git("remote", "-v", cwd=review_root) == review_remotes and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        setup is not None and result[0] is None and
                        lifecycle.executor_setup is setup and
                        lifecycle.executor_setup_fields is fields and
                        lifecycle.executor_setup_root is destination and
                        tuple(setup) == fields and destination.is_dir() and
                        git("remote", cwd=destination) == "" and
                        git("rev-parse", executor_head + "^",
                            cwd=destination) == review_evidence and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=destination) == executor_ref + " " +
                                executor_head and
                        hashlib.sha256(executor_path.read_bytes()).hexdigest()
                            == executor_digest and
                        stat.S_IMODE(executor_path.stat().st_mode) == 0o644 and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=destination) == "",
                        "bridge52_executor_finalization")
                result[0] = lifecycle.executor_setup
                actual.append(first_case)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            lifecycle.executor_setup = None
            lifecycle.executor_setup_fields = None
            lifecycle.executor_setup_root = None
            if destination is not None:
                try:
                    bridge_v52_remove_tree(destination)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((destination is None or
                         not os.path.lexists(destination)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (review_refs is None or git("show-ref", cwd=review_root)
                            == review_refs) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and lifecycle.executor_setup is None and
                        lifecycle.executor_setup_fields is None and
                        lifecycle.executor_setup_root is None,
                        "bridge52_executor_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(first_case, owned)
    return result[0]


def bridge_v52_executor_follow_case(lifecycle, actual, returned_setup,
                                    case_id, predicate, *, final):
    """Own stored executor-root use under the exact consumer denial ID."""
    require(case_id in {"prep-executor-descendant-denial",
                        "apply-executor-descendant-denial"} and
            type(final) is bool and
            final == (case_id == "apply-executor-descendant-denial"),
            "bridge52_executor_consumer_case")

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        stored_setup = stored_fields = stored_root = cleanup_root = values = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_executor_consumer_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_executor_consumer_provider")
            if (type(returned_setup) is BridgeV52ExecutorSetup and
                    len(returned_setup) == 5 and
                    type(returned_setup[0]) is type(Path())):
                cleanup_root = returned_setup[0]
            stored_setup = lifecycle.executor_setup
            stored_fields = lifecycle.executor_setup_fields
            stored_root = lifecycle.executor_setup_root
            require(type(stored_setup) is BridgeV52ExecutorSetup and
                    type(stored_fields) is tuple and
                    type(stored_root) is type(Path()) and
                    stored_root is cleanup_root and
                    returned_setup is stored_setup,
                    "bridge52_executor_returned_container")
            values = tuple(stored_setup)
            require(len(stored_setup) == len(stored_fields) == len(values) == 5
                    and values == stored_fields and
                    all(value is expected for value, expected in
                        zip(values, stored_fields)),
                    "bridge52_executor_returned_identity")
            executor_root, review_evidence, executor_head, executor_ref, executor_digest = values
            path = executor_root / "review/v52-review-1.txt"
            require(executor_root is cleanup_root and
                    executor_root is stored_fields[0] and
                    all(value is stored_fields[index] for index, value in
                        enumerate(values)) and executor_root.is_dir() and
                    executor_ref.startswith("refs/heads/") and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    re.fullmatch(r"[0-9a-f]{40}", executor_head) and
                    re.fullmatch(r"[0-9a-f]{64}", executor_digest) and
                    git("remote", cwd=executor_root) == "" and
                    git("rev-parse", executor_head + "^",
                        cwd=executor_root) == review_evidence and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=executor_root) == executor_ref + " " +
                            executor_head and
                    hashlib.sha256(path.read_bytes()).hexdigest() ==
                        executor_digest and
                    stat.S_IMODE(path.stat().st_mode) == 0o644 and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=executor_root) == "" and callable(predicate),
                    "bridge52_executor_returned_order")
            predicate(executor_root)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                path = cleanup_root / "review/v52-review-1.txt"
                require(tuple(actual) == prefix and dict(os.environ) ==
                        environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        stored_setup is returned_setup and
                        lifecycle.executor_setup is stored_setup and
                        lifecycle.executor_setup_fields is stored_fields and
                        lifecycle.executor_setup_root is stored_root and
                        tuple(stored_setup) == stored_fields and
                        cleanup_root.is_dir() and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=cleanup_root) == stored_fields[3] + " " +
                                stored_fields[2] and
                        hashlib.sha256(path.read_bytes()).hexdigest() ==
                            stored_fields[4] and
                        stat.S_IMODE(path.stat().st_mode) == 0o644 and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=cleanup_root) == "",
                        "bridge52_executor_consumer_finalization")
                if final:
                    bridge_v52_remove_tree(cleanup_root)
                    require(not os.path.lexists(cleanup_root),
                            "bridge52_executor_consumer_cleanup")
                    lifecycle.executor_setup = None
                    lifecycle.executor_setup_fields = None
                    lifecycle.executor_setup_root = None
                actual.append(case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            lifecycle.executor_setup = None
            lifecycle.executor_setup_fields = None
            lifecycle.executor_setup_root = None
            if cleanup_root is not None:
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and lifecycle.executor_setup is None and
                        lifecycle.executor_setup_fields is None and
                        lifecycle.executor_setup_root is None,
                        "bridge52_executor_consumer_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)


def bridge_v52_third_first_case(doctor, lifecycle, actual, temporary,
                                review_root, review_evidence, hardened,
                                predicate):
    """Own and seal the three-commit third-reviewer denial transaction."""
    first_case = "phase4-third-reviewer-denial"
    result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        review_head = review_status = review_refs = review_remotes = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        destination = third_ref = None
        heads = None
        fields = setup = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == first_case and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2" and
                    lifecycle.third_setup is None and
                    lifecycle.third_setup_fields is None and
                    lifecycle.third_setup_root is None,
                    "bridge52_third_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            require(type(temporary) is type(Path()) and temporary.is_dir() and
                    type(review_root) is type(Path()) and
                    review_root.is_dir() and review_root.parent == temporary and
                    type(review_evidence) is str and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(predicate), "bridge52_third_setup")
            review_head = git("rev-parse", "HEAD", cwd=review_root)
            review_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=review_root)
            review_refs = git("show-ref", cwd=review_root)
            review_remotes = git("remote", "-v", cwd=review_root)
            require(review_head == review_evidence and review_status == "" and
                    review_remotes == "", "bridge52_third_setup")
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_third_provider")

            destination = temporary / "third-reviewer"
            require(not os.path.lexists(destination),
                    "bridge52_third_destination")
            checked([*GIT, "clone", "--no-local", "--quiet", review_root,
                     destination], environment=hardened)
            checked([*GIT, "remote", "remove", "origin"], cwd=destination,
                    environment=hardened)
            checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                     review_evidence], cwd=destination, environment=hardened)
            reviewer_identity = [
                "Reviewer", "reviewer@agent-first-mac.invalid",
                "Reviewer", "reviewer@agent-first-mac.invalid",
            ]
            constructed_heads = []
            for number in range(1, 4):
                relative = "review/v52-review-" + str(number) + ".txt"
                third_path = destination / relative
                third_path.parent.mkdir(parents=True, exist_ok=True)
                third_path.write_text("bounded review " + str(number) + "\n")
                checked([*GIT, "add", "--", relative], cwd=destination,
                        environment=hardened)
                checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
                         "Bounded Bridge review " + str(number)],
                        cwd=destination,
                        environment={
                            **bridge_v52_commit_environment(
                                doctor,
                                doctor.BRIDGE_V52_EVIDENCE_EPOCH + number),
                            "GIT_AUTHOR_NAME": reviewer_identity[0],
                            "GIT_AUTHOR_EMAIL": reviewer_identity[1],
                            "GIT_COMMITTER_NAME": reviewer_identity[2],
                            "GIT_COMMITTER_EMAIL": reviewer_identity[3],
                        })
                constructed_heads.append(
                    git("rev-parse", "HEAD", cwd=destination))
            heads = tuple(constructed_heads)
            third_ref = "refs/heads/" + doctor.BRIDGE_V52_BRANCH
            paths = tuple(
                "review/v52-review-" + str(number) + ".txt"
                for number in range(1, 4))
            parents = (review_evidence, heads[0], heads[1])
            require(type(heads) is tuple and len(heads) == 3 and
                    len(set(heads)) == 3 and
                    git("remote", cwd=destination) == "" and
                    git("rev-parse", "--abbrev-ref", "HEAD",
                        cwd=destination) == doctor.BRIDGE_V52_BRANCH and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=destination) == third_ref + " " + heads[2] and
                    all(git("rev-parse", head + "^", cwd=destination) ==
                        parent for head, parent in zip(heads, parents)) and
                    all(commit_scope(head, cwd=destination) == {relative}
                        for head, relative in zip(heads, paths)) and
                    all(metadata(head, cwd=destination) == reviewer_identity
                        for head in heads) and
                    all(git("show", "-s", "--format=%at%x00%ct%x00%s", head,
                            cwd=destination).split("\x00") == [
                                str(doctor.BRIDGE_V52_EVIDENCE_EPOCH + number),
                                str(doctor.BRIDGE_V52_EVIDENCE_EPOCH + number),
                                "Bounded Bridge review " + str(number)]
                        for number, head in enumerate(heads, 1)) and
                    all(git("ls-tree", heads[-1], "--", relative,
                            cwd=destination).startswith("100644 blob ")
                        for relative in paths) and
                    all(stat.S_IMODE((destination / relative).stat().st_mode)
                            == 0o644 for relative in paths) and
                    all((destination / relative).read_text() ==
                            "bounded review " + str(number) + "\n"
                        for number, relative in enumerate(paths, 1)) and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=destination) == "",
                    "bridge52_third_validation")
            fields = (destination, review_evidence, heads[0], heads[1],
                      heads[2], third_ref)
            setup = BridgeV52ThirdSetup(fields)
            require(type(setup) is BridgeV52ThirdSetup and len(setup) == 6 and
                    tuple(setup) == fields and
                    all(value is expected for value, expected in
                        zip(setup, fields)) and
                    not hasattr(setup, "__dict__"),
                    "bridge52_third_setup_seal")
            lifecycle.third_setup = setup
            lifecycle.third_setup_fields = fields
            lifecycle.third_setup_root = destination
            require(lifecycle.third_setup is setup and
                    lifecycle.third_setup_fields is fields and
                    lifecycle.third_setup_root is destination,
                    "bridge52_third_setup_seal")
            predicate(destination)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                paths = tuple(
                    "review/v52-review-" + str(number) + ".txt"
                    for number in range(1, 4))
                parents = (review_evidence, heads[0], heads[1])
                require(tuple(actual) == prefix and dict(os.environ) ==
                        environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and git("rev-parse", "HEAD", cwd=review_root) ==
                            review_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=review_root) ==
                            review_status and
                        git("show-ref", cwd=review_root) == review_refs and
                        git("remote", "-v", cwd=review_root) == review_remotes and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        setup is not None and result[0] is None and
                        lifecycle.third_setup is setup and
                        lifecycle.third_setup_fields is fields and
                        lifecycle.third_setup_root is destination and
                        tuple(setup) == fields and destination.is_dir() and
                        git("remote", cwd=destination) == "" and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=destination) == third_ref + " " + heads[2] and
                        all(git("rev-parse", head + "^", cwd=destination) ==
                            parent for head, parent in zip(heads, parents)) and
                        all(commit_scope(head, cwd=destination) == {relative}
                            for head, relative in zip(heads, paths)) and
                        all(stat.S_IMODE(
                            (destination / relative).stat().st_mode) == 0o644
                            for relative in paths) and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=destination) == "",
                        "bridge52_third_finalization")
                result[0] = lifecycle.third_setup
                actual.append(first_case)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            lifecycle.third_setup = None
            lifecycle.third_setup_fields = None
            lifecycle.third_setup_root = None
            if destination is not None:
                try:
                    bridge_v52_remove_tree(destination)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((destination is None or
                         not os.path.lexists(destination)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (review_refs is None or git("show-ref", cwd=review_root)
                            == review_refs) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and lifecycle.third_setup is None and
                        lifecycle.third_setup_fields is None and
                        lifecycle.third_setup_root is None,
                        "bridge52_third_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(first_case, owned)
    return result[0]


def bridge_v52_third_follow_case(doctor, lifecycle, actual, returned_setup,
                                 case_id, predicate, *, final):
    """Own stored third-reviewer use under the exact consumer denial ID."""
    require(case_id in {"prep-third-reviewer-denial",
                        "apply-third-reviewer-denial"} and
            type(final) is bool and
            final == (case_id == "apply-third-reviewer-denial"),
            "bridge52_third_consumer_case")

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        stored_setup = stored_fields = stored_root = cleanup_root = values = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_third_consumer_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None,
                    "bridge52_third_consumer_provider")
            if (type(returned_setup) is BridgeV52ThirdSetup and
                    len(returned_setup) == 6 and
                    type(returned_setup[0]) is type(Path())):
                cleanup_root = returned_setup[0]
            stored_setup = lifecycle.third_setup
            stored_fields = lifecycle.third_setup_fields
            stored_root = lifecycle.third_setup_root
            require(type(stored_setup) is BridgeV52ThirdSetup and
                    type(stored_fields) is tuple and
                    type(stored_root) is type(Path()) and
                    stored_root is cleanup_root and
                    returned_setup is stored_setup,
                    "bridge52_third_returned_container")
            values = tuple(stored_setup)
            require(len(stored_setup) == len(stored_fields) == len(values) == 6
                    and values == stored_fields and
                    all(value is expected for value, expected in
                        zip(values, stored_fields)),
                    "bridge52_third_returned_identity")
            third_root, review_evidence, first_head, second_head, third_head, third_ref = values
            heads = (first_head, second_head, third_head)
            parents = (review_evidence, first_head, second_head)
            paths = tuple(
                "review/v52-review-" + str(number) + ".txt"
                for number in range(1, 4))
            reviewer_identity = [
                "Reviewer", "reviewer@agent-first-mac.invalid",
                "Reviewer", "reviewer@agent-first-mac.invalid",
            ]
            require(third_root is cleanup_root and
                    third_root is stored_fields[0] and
                    all(value is stored_fields[index] for index, value in
                        enumerate(values)) and third_root.is_dir() and
                    third_ref == "refs/heads/" + doctor.BRIDGE_V52_BRANCH and
                    re.fullmatch(r"[0-9a-f]{40}", review_evidence) and
                    all(re.fullmatch(r"[0-9a-f]{40}", head) for head in heads)
                    and len(set(heads)) == 3 and
                    git("remote", cwd=third_root) == "" and
                    git("for-each-ref", "--format=%(refname) %(objectname)",
                        cwd=third_root) == third_ref + " " + third_head and
                    all(git("rev-parse", head + "^", cwd=third_root) == parent
                        for head, parent in zip(heads, parents)) and
                    all(commit_scope(head, cwd=third_root) == {relative}
                        for head, relative in zip(heads, paths)) and
                    all(metadata(head, cwd=third_root) == reviewer_identity
                        for head in heads) and
                    all(git("show", "-s", "--format=%at%x00%ct%x00%s", head,
                            cwd=third_root).split("\x00") == [
                                str(doctor.BRIDGE_V52_EVIDENCE_EPOCH + number),
                                str(doctor.BRIDGE_V52_EVIDENCE_EPOCH + number),
                                "Bounded Bridge review " + str(number)]
                        for number, head in enumerate(heads, 1)) and
                    all(stat.S_IMODE(
                        (third_root / relative).stat().st_mode) == 0o644
                        for relative in paths) and
                    git("status", "--porcelain=v1", "--untracked-files=all",
                        cwd=third_root) == "" and callable(predicate),
                    "bridge52_third_returned_order")
            predicate(third_root)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                require(tuple(actual) == prefix and dict(os.environ) ==
                        environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls and
                        stored_setup is returned_setup and
                        lifecycle.third_setup is stored_setup and
                        lifecycle.third_setup_fields is stored_fields and
                        lifecycle.third_setup_root is stored_root and
                        tuple(stored_setup) == stored_fields and
                        cleanup_root.is_dir() and
                        git("for-each-ref",
                            "--format=%(refname) %(objectname)",
                            cwd=cleanup_root) == stored_fields[5] + " " +
                                stored_fields[4] and
                        all(git("rev-parse", head + "^", cwd=cleanup_root) ==
                            parent for head, parent in zip(heads, parents)) and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=cleanup_root) == "",
                        "bridge52_third_consumer_finalization")
                if final:
                    bridge_v52_remove_tree(cleanup_root)
                    require(not os.path.lexists(cleanup_root),
                            "bridge52_third_consumer_cleanup")
                    lifecycle.third_setup = None
                    lifecycle.third_setup_fields = None
                    lifecycle.third_setup_root = None
                actual.append(case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            lifecycle.third_setup = None
            lifecycle.third_setup_fields = None
            lifecycle.third_setup_root = None
            if cleanup_root is not None:
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and lifecycle.third_setup is None and
                        lifecycle.third_setup_fields is None and
                        lifecycle.third_setup_root is None,
                        "bridge52_third_consumer_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)


def bridge_v52_local_pending_event(prefix, final_case):
    """Construct the exact pending local77 event without external authority."""
    require(type(prefix) is tuple and type(final_case) is str,
            "bridge52_local_final_construction")
    return (*prefix, final_case)


def bridge_v52_local_final_case(lifecycle, actual, temporary, hardened,
                                predicate):
    """Own final local predicate, fixture cleanup and exact77 result seal."""
    final_case = "external-fixture-environment"
    result = [None]
    sealed_identity = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        phase4 = provider_context = None
        provider_loads = provider_calls = None
        cleanup_root = None
        pending = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == final_case and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-2",
                    "bridge52_local_final_ownership")
            require(type(prefix) is tuple and len(prefix) == 76 and
                    prefix == BRIDGE_V52_LOCAL_CASES[:-1] and
                    len(set(prefix)) == 76 and
                    all(type(value) is str for value in prefix) and
                    BRIDGE_V52_LOCAL_CASES[-1] == final_case and
                    result[0] is None and sealed_identity[0] is None,
                    "bridge52_local_final_prefix")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            phase4 = _BRIDGE_V52_PHASE4_MODULE
            if phase4 is not None:
                provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
                provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
                provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    phase4._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    phase4._BRIDGE_V52_PROVIDER_CALLS == 1 and
                    provider_context.get() is None and
                    type(temporary) is type(Path()) and temporary.is_dir() and
                    type(hardened) is dict and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    callable(predicate), "bridge52_local_final_setup")
            cleanup_root = temporary
            predicate()
        except Exception as error:
            first_error = error

        try:
            if cleanup_root is not None:
                bridge_v52_remove_tree(cleanup_root)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            require(cleanup_root is not None and
                    not os.path.lexists(cleanup_root),
                    "bridge52_local_final_absence")
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (phase4 is not None and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is not None):
                phase4.bridge_v52_reset_provider_context()
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if phase4 is not None and provider_loads is not None:
                phase4._BRIDGE_V52_PROVIDER_LOADS = provider_loads
                phase4._BRIDGE_V52_PROVIDER_CALLS = provider_calls
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                require(tuple(actual) == prefix and
                        not os.path.lexists(cleanup_root) and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before
                        and git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) == source_status
                        and phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls,
                        "bridge52_local_final_restoration")
                pending = bridge_v52_local_pending_event(prefix, final_case)
                require(type(pending) is tuple and
                        all(type(value) is str for value in pending),
                        "bridge52_local_final_type")
                require(len(pending) == 77,
                        "bridge52_local_final_count")
                require(final_case in pending,
                        "bridge52_local_final_omission")
                require(len(pending) == len(set(pending)),
                        "bridge52_local_final_duplicate")
                require(pending[:-1] == prefix and
                        pending[-1] == final_case,
                        "bridge52_local_final_order")
                require(pending == BRIDGE_V52_LOCAL_CASES,
                        "bridge52_local_final_equality")
                require(len(set(pending)) == 77,
                        "bridge52_local_final_uniqueness")
                result[0] = pending
                sealed_identity[0] = pending
                require(result[0] is pending and
                        type(result[0]) is tuple and
                        tuple(result[0]) == pending,
                        "bridge52_local_final_seal")
                require(sealed_identity[0] is result[0],
                        "bridge52_local_final_identity")
                actual.append(final_case)
                require(tuple(actual) == result[0] and
                        all(value is result[0][index]
                            for index, value in enumerate(actual)),
                        "bridge52_local_final_append")
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if cleanup_root is not None:
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    pass
            if prefix is not None:
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    break
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (source_status is None or
                         git("status", "--porcelain=v1",
                             "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (phase4 is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and result[0] is None and
                        sealed_identity[0] is None,
                        "bridge52_local_final_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(final_case, owned)
    return result[0]


def bridge_v52_local_matrix(root_state, doctor, lifecycle):
    actual = []
    temporary = None
    implementation_root = None
    review_root = None
    evidence = None
    review_evidence = None
    hardened = None
    final_result = None
    first = None
    try:
        def owned(case_id, operation):
            def execute():
                operation()
                actual.append(case_id)
            lifecycle.case(case_id, execute)

        def expect_process(repository, executable, arguments, environment,
                           *, success, state=None, reason=None):
            result = bridge_v52_run_entrypoint(
                repository, executable, arguments, environment)
            require(result.stderr == b"" and
                    result.returncode == (0 if success else 1),
                    "bridge52_subprocess_status")
            value = strict_json_text(result.stdout.decode(), "bridge52-child")
            if success:
                require(value.get("repositoryState") == state and
                        value.get("schema") == 1,
                        "bridge52_subprocess_state")
            else:
                observed = value.get("reason", value.get("error"))
                require(observed == reason, "bridge52_subprocess_reason")

        def first_predicate(implementation_root, hardened):
            expect_process(
                implementation_root, "bin/check-phase5-prep",
                ["--implementation", "--json"], hardened, success=True,
                state="bridge_merge_compatibility_v52_implementation")

        retained_setup = bridge_v52_local_first_case(
            root_state, doctor, lifecycle, actual, first_predicate)

        def second_predicate(bound_temporary, bound_implementation_root,
                             bound_review_root, bound_evidence,
                             bound_review_evidence, bound_hardened):
            nonlocal temporary, implementation_root, review_root
            nonlocal evidence, review_evidence, hardened
            temporary = bound_temporary
            implementation_root = bound_implementation_root
            review_root = bound_review_root
            evidence = bound_evidence
            review_evidence = bound_review_evidence
            hardened = bound_hardened
            expect_process(
                implementation_root, "bin/check-phase5-apply-bundle",
                ["--implementation", "--json"], hardened, success=True,
                state="bridge_merge_compatibility_v52_implementation")

        bridge_v52_local_second_case(
            root_state, lifecycle, actual, retained_setup, second_predicate)
        owned("phase4-implementation-denial", lambda: expect_process(
            implementation_root, "bin/check-phase4-final-probes",
            ["--git-only"], hardened, success=False,
            reason="bridge52_implementation_state"))
        owned("prep-git-only-implementation-denial", lambda: expect_process(
            implementation_root, "bin/check-phase5-prep",
            ["--git-only", "--json"], hardened, success=False,
            reason="bridge52_implementation_state"))
        owned("apply-git-only-implementation-denial", lambda: expect_process(
            implementation_root, "bin/check-phase5-apply-bundle",
            ["--git-only", "--json"], hardened, success=False,
            reason="bridge52_implementation_state"))
        owned("phase4-review-success", lambda: expect_process(
            review_root, "bin/check-phase4-final-probes", ["--git-only"],
            hardened, success=True,
            state="bridge_merge_compatibility_v52_review"))
        owned("prep-review-success", lambda: expect_process(
            review_root, "bin/check-phase5-prep", ["--git-only", "--json"],
            hardened, success=True,
            state="bridge_merge_compatibility_v52_review"))
        owned("apply-review-success", lambda: expect_process(
            review_root, "bin/check-phase5-apply-bundle",
            ["--git-only", "--json"], hardened, success=True,
            state="bridge_merge_compatibility_v52_review"))

        def descendant_root(name):
            destination = temporary / name
            checked([*GIT, "clone", "--no-local", "--quiet", review_root,
                     destination], environment=hardened)
            checked([*GIT, "remote", "remove", "origin"], cwd=destination,
                    environment=hardened)
            checked([*GIT, "checkout", "-q", "-B", doctor.BRIDGE_V52_BRANCH,
                     review_evidence], cwd=destination, environment=hardened)
            return destination

        def commit_descendant(repository, number, *, identity=None,
                              protected=False):
            identity = identity or [
                "Reviewer", "reviewer@agent-first-mac.invalid",
                "Reviewer", "reviewer@agent-first-mac.invalid",
            ]
            relative = ("bin/check-phase5-prep" if protected else
                        "review/v52-review-" + str(number) + ".txt")
            path = repository / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            if protected:
                path.write_bytes(path.read_bytes() + b"\n")
                path.chmod(0o755)
            else:
                path.write_text("bounded review " + str(number) + "\n")
            checked([*GIT, "add", "--", relative], cwd=repository,
                    environment=hardened)
            checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
                     "Bounded Bridge review " + str(number)], cwd=repository,
                    environment={
                        **bridge_v52_commit_environment(
                            doctor, doctor.BRIDGE_V52_EVIDENCE_EPOCH + number),
                        "GIT_AUTHOR_NAME": identity[0],
                        "GIT_AUTHOR_EMAIL": identity[1],
                        "GIT_COMMITTER_NAME": identity[2],
                        "GIT_COMMITTER_EMAIL": identity[3],
                    })

        def phase4_reviewer_predicate(bound_reviewer_root):
            expect_process(
                bound_reviewer_root, "bin/check-phase4-final-probes",
                ["--git-only"], hardened, success=True,
                state="bridge_merge_compatibility_v52_review")

        retained_reviewer = bridge_v52_reviewer_first_case(
            doctor, lifecycle, actual, temporary, review_root,
            review_evidence, hardened, phase4_reviewer_predicate)

        def prep_reviewer_predicate(bound_reviewer_root):
            expect_process(
                bound_reviewer_root, "bin/check-phase5-prep",
                ["--git-only", "--json"], hardened, success=True,
                state="bridge_merge_compatibility_v52_review")

        bridge_v52_reviewer_follow_case(
            doctor, lifecycle, actual, retained_reviewer,
            "prep-reviewer-descendant-success", prep_reviewer_predicate,
            final=False)

        def apply_reviewer_predicate(bound_reviewer_root):
            expect_process(
                bound_reviewer_root, "bin/check-phase5-apply-bundle",
                ["--git-only", "--json"], hardened, success=True,
                state="bridge_merge_compatibility_v52_review")

        bridge_v52_reviewer_follow_case(
            doctor, lifecycle, actual, retained_reviewer,
            "apply-reviewer-descendant-success", apply_reviewer_predicate,
            final=True)

        def phase4_main_predicate(bound_main_root):
            expect_process(
                bound_main_root, "bin/check-phase4-final-probes",
                ["--git-only"], hardened, success=True,
                state="bridge_merge_compatibility_v52_main")

        retained_main = bridge_v52_main_first_case(
            doctor, lifecycle, actual, temporary, review_root,
            review_evidence, hardened, phase4_main_predicate)

        def prep_main_predicate(bound_main_root):
            expect_process(
                bound_main_root, "bin/check-phase5-prep",
                ["--git-only", "--json"], hardened, success=True,
                state="bridge_merge_compatibility_v52_main")

        bridge_v52_main_follow_case(
            doctor, lifecycle, actual, retained_main, "prep-main-success",
            prep_main_predicate, final=False)

        def apply_main_predicate(bound_main_root):
            expect_process(
                bound_main_root, "bin/check-phase5-apply-bundle",
                ["--git-only", "--json"], hardened, success=True,
                state="bridge_merge_compatibility_v52_main")

        bridge_v52_main_follow_case(
            doctor, lifecycle, actual, retained_main, "apply-main-success",
            apply_main_predicate, final=True)

        def phase4_protected_predicate(bound_protected_root):
            expect_process(
                bound_protected_root, "bin/check-phase4-final-probes",
                ["--git-only"], hardened, success=False,
                reason="bridge52_reviewer_descendant")

        retained_protected = bridge_v52_protected_first_case(
            doctor, lifecycle, actual, temporary, review_root,
            review_evidence, hardened, phase4_protected_predicate)

        def prep_protected_predicate(bound_protected_root):
            expect_process(
                bound_protected_root, "bin/check-phase5-prep",
                ["--git-only", "--json"], hardened, success=False,
                reason="bridge52_reviewer_descendant")

        bridge_v52_protected_follow_case(
            lifecycle, actual, retained_protected,
            "prep-protected-descendant-denial", prep_protected_predicate,
            final=False)

        def apply_protected_predicate(bound_protected_root):
            expect_process(
                bound_protected_root, "bin/check-phase5-apply-bundle",
                ["--git-only", "--json"], hardened, success=False,
                reason="bridge52_reviewer_descendant")

        bridge_v52_protected_follow_case(
            lifecycle, actual, retained_protected,
            "apply-protected-descendant-denial", apply_protected_predicate,
            final=True)

        def phase4_executor_predicate(bound_executor_root):
            expect_process(
                bound_executor_root, "bin/check-phase4-final-probes",
                ["--git-only"], hardened, success=False,
                reason="bridge52_reviewer_descendant")

        retained_executor = bridge_v52_executor_first_case(
            doctor, lifecycle, actual, temporary, review_root,
            review_evidence, hardened, phase4_executor_predicate)

        def prep_executor_predicate(bound_executor_root):
            expect_process(
                bound_executor_root, "bin/check-phase5-prep",
                ["--git-only", "--json"], hardened, success=False,
                reason="bridge52_reviewer_descendant")

        bridge_v52_executor_follow_case(
            lifecycle, actual, retained_executor,
            "prep-executor-descendant-denial", prep_executor_predicate,
            final=False)

        def apply_executor_predicate(bound_executor_root):
            expect_process(
                bound_executor_root, "bin/check-phase5-apply-bundle",
                ["--git-only", "--json"], hardened, success=False,
                reason="bridge52_reviewer_descendant")

        bridge_v52_executor_follow_case(
            lifecycle, actual, retained_executor,
            "apply-executor-descendant-denial", apply_executor_predicate,
            final=True)

        def phase4_third_predicate(bound_third_root):
            expect_process(
                bound_third_root, "bin/check-phase4-final-probes",
                ["--git-only"], hardened, success=False,
                reason="bridge52_topology")

        retained_third = bridge_v52_third_first_case(
            doctor, lifecycle, actual, temporary, review_root,
            review_evidence, hardened, phase4_third_predicate)

        def prep_third_predicate(bound_third_root):
            expect_process(
                bound_third_root, "bin/check-phase5-prep",
                ["--git-only", "--json"], hardened, success=False,
                reason="bridge52_topology")

        bridge_v52_third_follow_case(
            doctor, lifecycle, actual, retained_third,
            "prep-third-reviewer-denial", prep_third_predicate, final=False)

        def apply_third_predicate(bound_third_root):
            expect_process(
                bound_third_root, "bin/check-phase5-apply-bundle",
                ["--git-only", "--json"], hardened, success=False,
                reason="bridge52_topology")

        bridge_v52_third_follow_case(
            doctor, lifecycle, actual, retained_third,
            "apply-third-reviewer-denial", apply_third_predicate, final=True)

        def dirty_case(tracked):
            path = implementation_root / (
                "bin/check-phase5-prep" if tracked else "untracked-v52")
            prior = path.read_bytes() if tracked else None
            try:
                if tracked:
                    path.write_bytes(prior + b"\n")
                else:
                    path.write_text("dirty\n")
                bridge_v52_expect_denial(
                    lambda: doctor.bridge_v52_classify_actual_root(
                        implementation_root, hardened))
            finally:
                if tracked:
                    path.write_bytes(prior)
                    path.chmod(0o755)
                else:
                    path.unlink(missing_ok=True)
                require(git("status", "--porcelain=v1",
                            "--untracked-files=all",
                            cwd=implementation_root) == "",
                        "bridge52_dirty_restore")

        for tracked, suffix in ((True, "dirty-tracked-denial"),
                                (False, "dirty-untracked-denial")):
            for consumer in ("phase4", "prep", "apply"):
                owned(consumer + "-" + suffix,
                      lambda tracked=tracked: dirty_case(tracked))

        def origin_case():
            checked([*GIT, "remote", "add", "origin", str(ROOT)],
                    cwd=implementation_root, environment=hardened)
            try:
                bridge_v52_expect_denial(
                    lambda: doctor.bridge_v52_classify_actual_root(
                        implementation_root, hardened))
            finally:
                checked([*GIT, "remote", "remove", "origin"],
                        cwd=implementation_root, environment=hardened)

        for consumer in ("phase4", "prep", "apply"):
            owned(consumer + "-origin-denial", origin_case)

        evidence_mutations = {
            "evidence-missing-key-denial":
                lambda value: value.pop("gate"),
            "evidence-extra-key-denial":
                lambda value: value.update(extra=True),
            "evidence-wrong-base-denial":
                lambda value: value.update(protectedBaseline="0" * 40),
            "evidence-wrong-implementation-denial":
                lambda value: value["bindings"].update(
                    implementationCommit="0" * 40),
            "evidence-wrong-raw-denial":
                lambda value: value["bindings"].update(
                    implementationRawSHA256="0" * 64),
            "evidence-wrong-tree-denial":
                lambda value: value["bindings"].update(
                    implementationTree="0" * 40),
            "evidence-wrong-scope-denial":
                lambda value: value["bindings"].update(
                    implementationScope=[]),
            "evidence-wrong-marker-denial":
                lambda value: value["authority"].update(marker="wrong"),
            "evidence-wrong-verdict-denial":
                lambda value: value["gate"].update(verdict="PASS"),
            "evidence-permissive-live-denial":
                lambda value: value["gate"].update(liveApplyAuthorized=True),
            "evidence-permissive-phase5-denial":
                lambda value: value["gate"].update(phase5PassClaimed=True),
            "evidence-permissive-phase6-denial":
                lambda value: value["gate"].update(phase6Authorized=True),
            "evidence-system-mutation-denial":
                lambda value: value["systemMutations"].update(system=True),
            "evidence-wrong-input-state-denial":
                lambda value: value["matrix"].update(inputState="syntheticReview"),
            "evidence-wrong-route-ids-denial":
                lambda value: value["matrix"].update(routeIDsSHA256="0" * 64),
            "evidence-wrong-route-count-denial":
                lambda value: value["matrix"].update(routeCount=9),
            "evidence-wrong-matrix-count-denial":
                lambda value: value["matrix"].update(caseCount=233),
            "evidence-wrong-digest-denial":
                lambda value: value["matrix"].update(caseIDsSHA256="0" * 64),
        }
        owned("evidence-malformed-json-denial", lambda:
              bridge_v52_expect_denial(lambda:
                  strict_json_text('{"schema":', "bridge52-malformed")))
        for case_id, mutate in evidence_mutations.items():
            def evidence_case(mutate=mutate):
                value = copy.deepcopy(evidence)
                mutate(value)
                bridge_v52_expect_denial(lambda:
                    doctor.bridge_v52_validate_real_evidence(
                        value, implementation=root_state.implementation,
                        evidence=root_state.implementation,
                        repository=implementation_root))
            owned(case_id, evidence_case)

        implementation_dimensions = (
            "parent", "scope", "mode", "author", "committer", "epoch",
            "timezone", "subject", "extra-header",
        )
        for mutation_index, dimension in enumerate(implementation_dimensions):
            case_id = ("implementation-extra-header-denial"
                       if dimension == "extra-header" else
                       "implementation-wrong-" + dimension + "-denial")
            def implementation_case(dimension=dimension,
                                    mutation_index=mutation_index):
                bridge_v52_implementation_mutation(
                    doctor, root_state.implementation, dimension,
                    temporary / ("implementation-mutant-" +
                                 str(mutation_index)))
            owned(case_id, implementation_case)

        argv_cases = (
            ("phase4-argv-json-denial", ["--git-only", "--json"], "phase4"),
            ("prep-argv-omitted-json-denial", ["--git-only"], "prep"),
            ("prep-argv-reordered-denial", ["--json", "--git-only"], "prep"),
            ("prep-argv-duplicated-json-denial",
             ["--git-only", "--json", "--json"], "prep"),
            ("apply-argv-omitted-json-denial", ["--git-only"], "apply"),
            ("apply-argv-reordered-denial", ["--json", "--git-only"], "apply"),
            ("apply-argv-duplicated-json-denial",
             ["--git-only", "--json", "--json"], "apply"),
        )
        for case_id, argv, consumer in argv_cases:
            owned(case_id, lambda argv=argv, consumer=consumer:
                  bridge_v52_expect_denial(lambda:
                      bridge_v52_closed_argv(argv, consumer)))

        admin_cases = (
            "malicious-hooks-denial", "malicious-alias-denial",
            "malicious-fsmonitor-denial", "malicious-filter-denial",
            "malicious-diff-textconv-denial", "replace-ref-denial",
            "graft-denial", "shallow-denial",
        )
        for case_id in admin_cases:
            def admin_case(case_id=case_id):
                dangerous = {
                    "malicious-hooks-denial": ("core.hooksPath", "/tmp/hooks"),
                    "malicious-alias-denial": ("alias.status", "!false"),
                    "malicious-fsmonitor-denial": ("core.fsmonitor", "/tmp/f"),
                    "malicious-diff-textconv-denial":
                        ("diff.bad.textconv", "/bin/false"),
                }
                if case_id == "malicious-filter-denial":
                    sentinel_root = temporary / "filter-sentinels"
                    sentinel_root.mkdir(mode=0o700)
                    keys = []
                    markers = []
                    for filter_name in ("clean", "smudge", "process"):
                        marker = sentinel_root / (filter_name + ".called")
                        script = sentinel_root / filter_name
                        script.write_text(
                            "#!/bin/sh\n/usr/bin/touch " + str(marker) + "\n")
                        script.chmod(0o700)
                        key = "filter.bad." + filter_name
                        checked([*GIT, "config", "--local", key, str(script)],
                                cwd=implementation_root,
                                environment=hardened)
                        keys.append(key)
                        markers.append(marker)
                    try:
                        bridge_v52_expect_denial(lambda:
                            doctor.bridge_v52_admin_closed(
                                implementation_root))
                        require(not any(marker.exists() for marker in markers),
                                "bridge52_filter_called")
                    finally:
                        for key in reversed(keys):
                            checked([*GIT, "config", "--local", "--unset-all",
                                     key], cwd=implementation_root,
                                    environment=hardened)
                        bridge_v52_remove_tree(sentinel_root)
                elif case_id in dangerous:
                    key, value = dangerous[case_id]
                    checked([*GIT, "config", "--local", key, value],
                            cwd=implementation_root, environment=hardened)
                    try:
                        bridge_v52_expect_denial(lambda:
                            doctor.bridge_v52_admin_closed(implementation_root))
                    finally:
                        checked([*GIT, "config", "--local", "--unset-all", key],
                                cwd=implementation_root, environment=hardened)
                else:
                    admin_name = {
                        "replace-ref-denial": "refs/replace/" +
                            root_state.implementation,
                        "graft-denial": "info/grafts",
                        "shallow-denial": "shallow",
                    }[case_id]
                    path = Path(git("rev-parse", "--git-path", admin_name,
                                    cwd=implementation_root))
                    if not path.is_absolute():
                        path = implementation_root / path
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_text(root_state.implementation + "\n")
                    try:
                        bridge_v52_expect_denial(lambda:
                            doctor.bridge_v52_admin_closed(implementation_root))
                    finally:
                        path.unlink(missing_ok=True)
            owned(case_id, admin_case)

        owned("final-blocker-before-preflight", lambda: require(
            not any(key.startswith("CODEX_") for key in
                    bridge_v52_child_environment(os.environ)),
            "bridge52_final_blocker"))
        def external_fixture_predicate():
            require(temporary != ROOT and ROOT not in temporary.parents and
                    implementation_root != review_root and
                    BRIDGE_V52_PRIVATE_RECORD not in hardened and
                    hardened.get("PYTHONDONTWRITEBYTECODE") == "1" and
                    hardened.get("PYTHONNOUSERSITE") == "1",
                    "bridge52_external_environment")

        final_result = bridge_v52_local_final_case(
            lifecycle, actual, temporary, hardened,
            external_fixture_predicate)
    except Exception as error:
        first = error
    finally:
        if temporary is not None and os.path.lexists(temporary):
            try:
                shutil.rmtree(temporary)
                require(not temporary.exists(), "bridge52_local_cleanup")
            except Exception as cleanup_error:
                if first is None:
                    first = cleanup_error
    if first is not None:
        raise first
    return final_result


def bridge_v52_boundary_append(events, index):
    """Append one observed boundary predicate result in exact order."""
    events.append(index)


def bridge_v52_boundary_result(final_checks, apply_checks):
    """Construct the closed boundary result from observed predicate lists."""
    return {
        "applyCases": len(apply_checks),
        "finalCases": len(final_checks),
    }


def bridge_v52_boundary_facts():
    final_checks = []
    final_predicates = (
        lambda: len(BRIDGE_V52_LOCAL_CASES) == 77,
        lambda: len(BRIDGE_V52_ROUTE_CASES) == 10,
        lambda: len(BRIDGE_V52_ENVIRONMENT_CASES) == 7,
        lambda: len(BRIDGE_V52_DIAGNOSTIC_CASES) == 12,
        lambda: len(BRIDGE_V52_STAGES) == 17,
        lambda: bridge_v52_tuple_digest(BRIDGE_V52_STAGES) ==
            BRIDGE_V52_STAGE_DIGEST,
        lambda: BRIDGE_V52_PRIVATE_RECORD not in
            bridge_v52_child_environment(os.environ),
        lambda: bridge_v52_child_environment(os.environ).get(
            "GIT_CONFIG_GLOBAL") == "/dev/null",
        lambda: bridge_v52_child_environment(os.environ).get(
            "GIT_CONFIG_NOSYSTEM") == "1",
        lambda: bridge_v52_child_environment(os.environ).get(
            "GIT_NO_REPLACE_OBJECTS") == "1",
        lambda: "GIT_CONFIG_SYSTEM" not in
            bridge_v52_child_environment(os.environ),
        lambda: (ROOT / "bin/check-phase4-final-probes").is_file(),
        lambda: (ROOT / "bin/phase4-final-doctor").is_file(),
        lambda: (ROOT / "bin/check-phase5-prep").is_file(),
        lambda: (ROOT / "bin/check-phase5-apply-bundle").is_file(),
        lambda: stat.S_IMODE((ROOT / "bin/check-phase4-final-probes").stat().st_mode) == 0o755,
        lambda: stat.S_IMODE((ROOT / "bin/phase4-final-doctor").stat().st_mode) == 0o755,
        lambda: stat.S_IMODE((ROOT / "bin/check-phase5-prep").stat().st_mode) == 0o755,
        lambda: stat.S_IMODE((ROOT / "bin/check-phase5-apply-bundle").stat().st_mode) == 0o755,
        lambda: len(set(BRIDGE_V52_LOCAL_CASES)) == 77,
        lambda: len(set(BRIDGE_V52_ROUTE_CASES)) == 10,
        lambda: len(set(BRIDGE_V52_ENVIRONMENT_CASES)) == 7,
        lambda: len(set(BRIDGE_V52_DIAGNOSTIC_CASES)) == 12,
        lambda: len(set(BRIDGE_V52_STAGES)) == 17,
        lambda: not set(BRIDGE_V52_LOCAL_CASES) & set(BRIDGE_V52_ROUTE_CASES),
        lambda: not set(BRIDGE_V52_ROUTE_CASES) &
            set(BRIDGE_V52_ENVIRONMENT_CASES),
        lambda: not set(BRIDGE_V52_ENVIRONMENT_CASES) &
            set(BRIDGE_V52_DIAGNOSTIC_CASES),
        lambda: BRIDGE_V52_CASE_DIGEST != BRIDGE_V52_STAGE_DIGEST,
        lambda: ROOT.is_absolute(),
    )
    for index, predicate in enumerate(final_predicates):
        require(predicate(), "bridge52_final_" + str(index))
        bridge_v52_boundary_append(final_checks, index)
        require(tuple(final_checks) == tuple(range(index + 1)),
                "bridge52_final_append_" + str(index))
    apply_predicates = (
        lambda: bridge_v52_closed_argv(
            ["--implementation", "--json"], "apply"),
        lambda: bridge_v52_closed_argv(["--git-only", "--json"], "apply"),
        lambda: BRIDGE_V52_SYNTHETIC_FLAG not in
            bridge_v52_child_environment(os.environ),
        lambda: BRIDGE_V52_PRIVATE_RECORD not in
            bridge_v52_child_environment(os.environ),
        lambda: not any(key.startswith("CODEX_") for key in
                        bridge_v52_child_environment(os.environ)),
        lambda: len(BRIDGE_V52_LOCAL_CASES[:14]) == 14,
        lambda: all(case.startswith(("prep-", "apply-", "phase4-"))
                    for case in BRIDGE_V52_LOCAL_CASES[:32]),
        lambda: "apply-implementation-positive" in BRIDGE_V52_LOCAL_CASES,
        lambda: "apply-review-success" in BRIDGE_V52_LOCAL_CASES,
        lambda: "apply-main-success" in BRIDGE_V52_LOCAL_CASES,
        lambda: "apply-origin-denial" in BRIDGE_V52_LOCAL_CASES,
        lambda: "apply-argv-duplicated-json-denial" in BRIDGE_V52_LOCAL_CASES,
        lambda: (ROOT / "bin/check-phase5-apply-bundle").resolve().parent ==
            (ROOT / "bin").resolve(),
        lambda: os.access(ROOT / "bin/check-phase5-apply-bundle", os.X_OK),
    )
    apply_checks = []
    for index, predicate in enumerate(apply_predicates):
        require(bool(predicate()), "bridge52_apply_" + str(index))
        bridge_v52_boundary_append(apply_checks, index)
        require(tuple(apply_checks) == tuple(range(index + 1)),
                "bridge52_apply_append_" + str(index))
    require(tuple(final_checks) == tuple(range(29)) and
            tuple(apply_checks) == tuple(range(14)),
            "bridge52_boundary_counts")
    result = bridge_v52_boundary_result(final_checks, apply_checks)
    require(type(result) is dict and len(result) == 2 and
            tuple(result) == ("applyCases", "finalCases") and
            all(type(value) is int for value in result.values()) and
            result == {"applyCases": 14, "finalCases": 29},
            "bridge52_boundary_result")
    return result


def bridge_v52_source_contract(doctor):
    head = git("rev-parse", "HEAD")
    commits = git("rev-list", "--reverse", doctor.BRIDGE_V52_BASE + ".." +
                  head).splitlines()
    require(len(commits) in {1, 2} and
            commit_scope(commits[0]) == doctor.BRIDGE_V52_IMPLEMENTATION_SCOPE,
            "bridge52_source_scope")
    for path in doctor.BRIDGE_V52_IMPLEMENTATION_SCOPE:
        require(git("ls-tree", commits[0], "--", path).split()[0] ==
                "100755" and stat.S_IMODE((ROOT / path).stat().st_mode) ==
                0o755, "bridge52_source_mode")
    require(git("remote") == "" and
            git("status", "--porcelain=v1", "--untracked-files=all") == "",
            "bridge52_source_state")
    return commits[0]


def bridge_v52_state_envelope_matrix(lifecycle=None):
    lifecycle = lifecycle or BridgeV52Lifecycle()
    environment_before = dict(os.environ)
    doctor = None
    phase4 = None
    root_state = None
    phase4_facts = None
    phase4_first = ()
    local = route = ()
    protected = None
    boundary = None
    try:
        lifecycle.enter("pre-environment")
        hardened = bridge_v52_child_environment(os.environ)
        doctor = bridge_v52_load_doctor()
        doctor.bridge_v52_hardened_environment(hardened)

        lifecycle.enter("pre-source")
        implementation = bridge_v52_source_contract(doctor)

        lifecycle.enter("pre-input")
        root_state = doctor.bridge_v52_classify_actual_root(
            ROOT, dict(os.environ))
        require(doctor.bridge_v52_state_is_sealed(root_state) and
                root_state.implementation == implementation,
                "bridge52_actual_root_state")

        lifecycle.enter("pre-fixture")
        require(ROOT.is_absolute() and ROOT == ROOT.resolve(strict=True),
                "bridge52_fixture_root")

        phase4, phase4_facts, phase4_first = (
            bridge_v52_phase4_provider_lifecycle(root_state, lifecycle))

        lifecycle.enter("case-partition-2")
        local = bridge_v52_local_matrix(root_state, doctor, lifecycle)

        protected, boundary = lifecycle.enter(
            "case-partition-3",
            lambda: bridge_v52_protected_matrix(
                root_state.implementation, doctor),
            bridge_v52_boundary_facts)

        lifecycle.enter("case-partition-4")
        route = bridge_v52_route_matrix(root_state, doctor, phase4, lifecycle)

        lifecycle.enter("case-partition-5")

        def aggregate_callback(environment_source, diagnostic_source):
            return bridge_v52_exact234_aggregate(
                phase4, phase4_first, phase4_facts, local, route,
                environment_source, diagnostic_source)

        result_envelope_calls = [0]

        def result_envelope_callback(
                environment_source, environment_seal, aggregate_source,
                aggregate_seal, cleanup_source, cleanup_seal, stage_source,
                stage_seal):
            require(result_envelope_calls[0] == 0,
                    "bridge52_result_envelope_callback_single_use")
            result_envelope_calls[0] += 1
            return bridge_v52_result_envelope_build(
                doctor, lifecycle, root_state, implementation, phase4_facts,
                local, route, protected, boundary, environment_source,
                environment_seal, aggregate_source, aggregate_seal,
                cleanup_source, cleanup_seal, stage_source, stage_seal)

        result = bridge_v52_environment_matrix(
            doctor, lifecycle, aggregate_callback, result_envelope_callback,
            environment_before)
        return result, lifecycle
    except Exception:
        if dict(os.environ) != environment_before:
            os.environ.clear()
            os.environ.update(environment_before)
        try:
            bridge_v52_unload_modules()
        except Exception:
            pass
        raise


def bridge_v52_direct(mode):
    doctor = bridge_v52_load_doctor()
    root_state = doctor.bridge_v52_classify_repository_state(
        ROOT, dict(os.environ))
    require(doctor.bridge_v52_repository_state_is_sealed(root_state),
            "bridge52_repository_state_seal")
    if mode == "implementation":
        require(root_state.state is doctor.BRIDGE_V52_IMPLEMENTATION_STATE,
                "bridge52_implementation_state")
        state = root_state.state.value
    else:
        require(root_state.state in {
            doctor.BRIDGE_V52_REVIEW_STATE, doctor.BRIDGE_V52_MAIN_STATE,
        },
                "bridge52_implementation_state")
        state = root_state.state.value
    return {
        "liveApplyAuthorized": False,
        "marker": doctor.BRIDGE_V52_MARKER,
        "mode": mode,
        "phase5ApplyAuthorized": False,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "preparationOnly": True,
        "protectedBaselineCommit": doctor.BRIDGE_V52_BASE,
        "repositoryState": state,
        "reviewedTaskHead": root_state.implementation,
        "schema": 1,
        "sourceCommit": root_state.head,
        "verdict":
            "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
            "PREPARED_FOR_INDEPENDENT_REVIEW",
    }


BRIDGE_V52_SUCCESS_RECORD_KEYS = (
    "caseID",
    "reason",
    "result",
    "stage",
    "status",
)
BRIDGE_V52_SUCCESS_RECORD_ITEMS = (
    ("caseID", "bridge52-orchestration-driver-complete"),
    ("reason", "complete"),
    ("result", "pass"),
    ("stage", "post-return"),
    ("status", "passed"),
)
BRIDGE_V52_SUCCESS_RECORD_RAW = (
    b'{"caseID":"bridge52-orchestration-driver-complete",'
    b'"reason":"complete","result":"pass","stage":"post-return",'
    b'"status":"passed"}\n'
)
BRIDGE_V52_SUCCESS_RECORD_PENDING = object()
BRIDGE_V52_SUCCESS_RECORD_FINALIZED = object()


class BridgeV52SuccessRecordSeal:
    __slots__ = ("record", "raw", "identity")

    def __init__(self, record, raw):
        self.record = record
        self.raw = raw
        self.identity = (record, raw)


def bridge_v52_validate_success_record_seal(seal):
    require(type(seal) is BridgeV52SuccessRecordSeal,
            "bridge52_success_record_seal")
    require(type(seal.identity) is tuple and len(seal.identity) == 2,
            "bridge52_success_record_identity")
    require(seal.identity[0] is seal.record and
            seal.identity[1] is seal.raw,
            "bridge52_success_record_identity")
    require(type(seal.record) is dict,
            "bridge52_success_record_type")
    require(tuple(seal.record.keys()) == BRIDGE_V52_SUCCESS_RECORD_KEYS,
            "bridge52_success_record_order")
    require(all(type(key) is str and type(value) is str
                for key, value in seal.record.items()),
            "bridge52_success_record_type")
    require(tuple(seal.record.items()) == BRIDGE_V52_SUCCESS_RECORD_ITEMS,
            "bridge52_success_record_value")
    require(type(seal.raw) is bytes and len(seal.raw) == 128,
            "bridge52_success_record_bytes")
    canonical = (
        json.dumps(seal.record, sort_keys=True, separators=(",", ":")) +
        "\n").encode("utf-8")
    require(canonical is not seal.raw and canonical == seal.raw,
            "bridge52_success_record_bytes")
    require(seal.raw == BRIDGE_V52_SUCCESS_RECORD_RAW,
            "bridge52_success_record_bytes")
    require(seal.raw[-1:] == b"\n" and seal.raw.count(b"\n") == 1,
            "bridge52_success_record_lf")
    return seal.identity


def bridge_v52_success_record_seal():
    record = {
        "caseID": "bridge52-orchestration-driver-complete",
        "reason": "complete",
        "result": "pass",
        "stage": "post-return",
        "status": "passed",
    }
    raw = (json.dumps(record, sort_keys=True, separators=(",", ":")) +
           "\n").encode("utf-8")
    seal = BridgeV52SuccessRecordSeal(record, raw)
    require(bridge_v52_validate_success_record_seal(seal) is seal.identity,
            "bridge52_success_record_identity")
    return seal


def bridge_v52_publish(value, lifecycle):
    output_state = BRIDGE_V52_OUTPUT_NOT_STARTED
    success_record_state = None
    private_record_attempted = False
    characters_written = 0
    raw = None
    try:
        raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) +
               "\n").encode("utf-8")
        while characters_written < len(raw):
            require(
                output_state is (
                    BRIDGE_V52_OUTPUT_NOT_STARTED
                    if characters_written == 0 else
                    BRIDGE_V52_OUTPUT_STARTED),
                "bridge52_output_state")
            remaining = len(raw) - characters_written
            count = os.write(1, raw[characters_written:])
            if (type(count) is int and count > 0 and
                    output_state is BRIDGE_V52_OUTPUT_NOT_STARTED):
                output_state = BRIDGE_V52_OUTPUT_STARTED
            require(type(count) is int and 0 < count <= remaining,
                    "bridge52_output_write")
            characters_written += count
        require(output_state is BRIDGE_V52_OUTPUT_STARTED,
                "bridge52_output_state")
        require(characters_written == len(raw), "bridge52_output_short")
        sys.stdout.flush()
        output_state = BRIDGE_V52_OUTPUT_COMMITTED
        success_seal = bridge_v52_success_record_seal()
        success_identity = bridge_v52_validate_success_record_seal(success_seal)
        require(success_identity is success_seal.identity,
                "bridge52_success_record_identity")
        success_record, success_raw = success_identity
        require(success_record is success_seal.record and
                success_raw is success_seal.raw,
                "bridge52_success_record_identity")
        require(success_record_state is None,
                "bridge52_success_record_state")
        success_record_state = BRIDGE_V52_SUCCESS_RECORD_PENDING
        private_record_attempted = True
        bridge_v52_private_record(success_record)
        success_record_state = BRIDGE_V52_SUCCESS_RECORD_FINALIZED
        return 0
    except Exception as primary_error:
        if lifecycle.first_failure is None:
            lifecycle.first_failure = {
                "caseID": "bridge52-orchestration-driver-complete",
                "reason": "bridge52_internal",
                "result": "fail",
                "stage": "post-return",
                "status": "failed",
            }
        record = lifecycle.first_failure
        if (output_state is not BRIDGE_V52_OUTPUT_COMMITTED and
                not private_record_attempted and
                bridge_v52_private_record_ready()):
            private_record_attempted = True
            try:
                bridge_v52_private_record(record)
            except Exception as secondary_error:
                _ = (primary_error, secondary_error)
                pass
        if success_record_state is BRIDGE_V52_SUCCESS_RECORD_PENDING:
            success_record_state = BRIDGE_V52_SUCCESS_RECORD_FINALIZED
        return 1


def bridge_v52_entrypoint(raw_arguments):
    mode = "matrix" if raw_arguments == ["--matrix", "--json"] else \
        "implementation" if raw_arguments == ["--implementation", "--json"] \
        else "git-only" if raw_arguments == ["--git-only", "--json"] else None
    if mode is None:
        print(json.dumps({"error": "bridge52_usage", "mode": "unknown",
                          "schema": 1, "verdict": "FAIL"},
                         sort_keys=True, separators=(",", ":")))
        return 1
    if mode != "matrix":
        try:
            value = bridge_v52_direct(mode)
        except Exception as error:
            raw_reason = str(error)
            reason = (raw_reason if re.fullmatch(r"bridge52_[a-z0-9_]+",
                                                 raw_reason)
                      else "bridge52_internal")
            print(json.dumps({"error": reason, "mode": mode, "schema": 1,
                              "verdict": "FAIL"},
                             sort_keys=True, separators=(",", ":")))
            return 1
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        return 0
    lifecycle = BridgeV52Lifecycle()
    try:
        value, lifecycle = bridge_v52_state_envelope_matrix(lifecycle)
    except Exception:
        record = lifecycle.first_failure or {
            "caseID": lifecycle.active_case or "driver-setup",
            "reason": "bridge52_internal",
            "result": "fail",
            "stage": lifecycle.stages[-1] if lifecycle.stages else
                "pre-environment",
            "status": "failed",
        }
        try:
            bridge_v52_private_record(record)
        except Exception:
            pass
        return 1
    return bridge_v52_publish(value, lifecycle)


def main():
    raw_arguments = list(sys.argv[1:])
    try:
        bridge_v52_bind_private_record(raw_arguments)
    except Exception:
        return 1
    branch_probe = run([*GIT, "branch", "--show-current"])
    head_probe = run([*GIT, "rev-parse", "HEAD"])
    bridge_candidate = (
        branch_probe.returncode == head_probe.returncode == 0
        and branch_probe.stdout.strip() in {
            "codex/phase5-bridge-merge-compatibility-correction-v52", "main",
        }
        and head_probe.stdout.strip() !=
            "8fb22fe994c6967481cdda8c98e9b85cc9df435c"
        and run([
            *GIT, "merge-base", "--is-ancestor",
            "8fb22fe994c6967481cdda8c98e9b85cc9df435c", "HEAD",
        ]).returncode == 0
    )
    if bridge_candidate:
        return bridge_v52_entrypoint(raw_arguments)
    parser = argparse.ArgumentParser()
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--precommit", action="store_true")
    modes.add_argument("--implementation", action="store_true")
    modes.add_argument("--git-only", action="store_true")
    parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()
    mode = (
        "precommit"
        if arguments.precommit
        else "implementation"
        if arguments.implementation
        else "git-only"
        if arguments.git_only
        else "final"
    )
    try:
        current = current_main_compatibility(mode)
        if current is not None:
            marker = (CURRENT_SHAPE_MARKER if current["state"].startswith("current_private_runtime_shape_")
                      else RUNNER_GATE_MARKER if current["state"].startswith("private_runtime_runner_gate_")
                      else POST_PRIVATE_ROUTING_MARKER if current["state"].startswith("post_private_routing_")
                      else POST_INTEGRATION_MARKER if current["state"].startswith("post_integration_")
                      else PRIVATE_RUNTIME_MARKER if current["state"].startswith("private_runtime_integrated_")
                      else CURRENT_MAIN_MARKER)
            verdict = (CURRENT_SHAPE_VERDICT if current["state"].startswith("current_private_runtime_shape_")
                       else RUNNER_GATE_VERDICT if current["state"].startswith("private_runtime_runner_gate_")
                       else POST_PRIVATE_ROUTING_VERDICT if current["state"].startswith("post_private_routing_")
                       else POST_INTEGRATION_VERDICT if current["state"].startswith("post_integration_")
                       else PRIVATE_RUNTIME_VERDICT if current["state"].startswith("private_runtime_integrated_")
                       else CURRENT_MAIN_VERDICT)
            matrix = None
            if mode == "final":
                validate_static()
                negative_matrix()
                transaction_fixture()
                matrix = post_integration_topology_matrix() if current["state"].startswith("post_integration_") else post_private_routing_topology_matrix()
            value = {"marker": marker, "mode": mode,
                     "phase5ApplyAuthorized": False, "phase5PassClaimed": False,
                     "phase6Authorized": False, "preparationOnly": True,
                     "protectedBaselineCommit": current["baseline"],
                     "repositoryState": current["state"], "reviewedTaskHead": current["baseline"],
                     "schema": 1, "verdict": verdict}
            if matrix is not None:
                value["postIntegrationMatrix"] = matrix
            print(json.dumps(value, sort_keys=True, separators=(",", ":")) if arguments.json else json.dumps(value, indent=2, sort_keys=True))
            return 0
        implementation, reviewed_head, repository_state = validate_git(mode)
        active_marker = (
            DESCENDANT_BASELINE_MARKER
            if repository_state == "correction_review"
            else PRIVATE_RUNTIME_MARKER
            if repository_state == "private_runtime_review"
            else MARKER
        )
        verdict = (
            ACCEPTED_VERDICT
            if repository_state
            in {
                "apply_bundle_integrated",
                "apply_bundle_review",
                "integrated_main",
            }
            else DESCENDANT_BASELINE_VERDICT
            if repository_state == "correction_review"
            and mode in ("final", "git-only")
            else PRIVATE_RUNTIME_VERDICT
            if repository_state == "private_runtime_review"
            and mode in ("final", "git-only")
            else VERDICT
            if mode in ("final", "git-only")
            else mode.upper().replace("-", "_") + "_VALID"
        )
        if mode == "git-only":
            value = {
                "acceptedReviewedTaskHead": ACCEPTED_REVIEWED_HEAD,
                "marker": active_marker,
                "mode": mode,
                "phase5ApplyAuthorized": False,
                "phase5PassClaimed": False,
                "phase6Authorized": False,
                "preparationOnly": True,
                "protectedBaselineCommit": reviewed_head,
                "repositoryState": repository_state,
                "reviewedTaskHead": reviewed_head,
                "schema": 1,
                "verdict": verdict,
            }
            print(
                json.dumps(value, sort_keys=True, separators=(",", ":"))
                if arguments.json
                else json.dumps(value, indent=2, sort_keys=True)
            )
            return 0
        validate_static()
        negative_matrix()
        transaction_fixture()
        launcher_fixture()
        hook_fixtures()
        preflight_fixtures()
        capability_probe()
        validate_historical_evidence()
        validate_first_correction_evidence()
        integration_matrix = None
        if mode == "final" and repository_state == "correction_review":
            integration_matrix = integration_state_matrix(reviewed_head)
        value = {
            "checks": {
                "capabilityProbe": True,
                "configTransaction": True,
                "git": True,
                "hookFixtures": True,
                "launcherFixture": True,
                "negativeMatrix": True,
                "preflightFixtures": True,
                "static": True,
                "twoStateIntegration": (
                    integration_matrix is not None
                    or repository_state
                    in {
                        "apply_bundle_integrated",
                        "apply_bundle_review",
                        "integrated_main",
                    }
                    or mode != "final"
                ),
            },
            "acceptedReviewedTaskHead": ACCEPTED_REVIEWED_HEAD,
            "marker": active_marker,
            "mode": mode,
            "phase5ApplyAuthorized": False,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
            "preparationOnly": True,
            "protectedBaselineCommit": reviewed_head,
            "repositoryState": repository_state,
            "reviewedTaskHead": reviewed_head,
            "schema": 1,
            "verdict": verdict,
        }
        if integration_matrix is not None:
            value["integrationMatrix"] = integration_matrix
        if arguments.json:
            print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        else:
            print("Phase 5 preparation validator: PASS")
            print("mode: " + mode)
            print("repository state: " + repository_state)
            print("fixed CLI, launcher capture, and hook fixtures: PASS")
            print("real permission-profile sandbox probe: PASS")
            print("merge/rollback and fail-closed matrix: PASS")
            print("verdict: " + verdict)
            print("phase5 apply/pass and Phase 6 authorized: false")
            print("marker: " + active_marker)
        return 0
    except Exception as error:
        if arguments.json:
            print(
                json.dumps(
                    {
                        "error": str(error),
                        "mode": mode,
                        "schema": 1,
                        "verdict": "FAIL",
                    },
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
        else:
            print("Phase 5 preparation validator: FAIL", file=sys.stderr)
            print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
