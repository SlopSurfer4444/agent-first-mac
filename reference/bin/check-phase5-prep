                    tuple(item[1] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_fourth_mapping")
            entry = bridge_v52_environment_fourth_bind(schedule)
            require(type(entry) is tuple and len(entry) == 2 and
                    entry is schedule[3] and entry[0] is case_id and
                    entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[3],
                    "bridge52_environment_fourth_bind")
            value = dict(base)
