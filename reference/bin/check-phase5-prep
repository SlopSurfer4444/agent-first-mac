REGISTRY_ROOT = re.compile(
    r"^\$HOME/AIDev/(?:control|(?:repos|worktrees)/"
    r"[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*)$"
)


def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def run(arguments, cwd=ROOT, environment=None, stdin=None, *,
        start_new_session=False, timeout=None):
    if environment is None:
        environment = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
    return subprocess.run(
        [str(item) for item in arguments],
        cwd=cwd,
        env=environment,
        input=stdin,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        start_new_session=start_new_session,
        timeout=timeout,
        check=False,
    )


def checked(arguments, cwd=ROOT, environment=None, stdin=None):
    result = run(arguments, cwd=cwd, environment=environment, stdin=stdin)
    require(
        result.returncode == 0,
        "command_failed_"
        + Path(str(arguments[0])).name
        + ":"
        + result.stdout[-800:],
    )
    return result.stdout


def git(*arguments, cwd=ROOT):
    return checked([*GIT, *arguments], cwd=cwd).strip()


def git_at(directory, *arguments):
    return checked([*GIT, *arguments], cwd=directory).strip()


def commit_range_paths(base, head, directory=ROOT):
    """Return every path touched by any commit in ``base..head``.

    A net tree comparison is insufficient for a protected baseline because a
    later commit can restore the original blob.  This walks the linear history
    and retains the union of each commit's own changed paths.
    """
    paths = set()
    for commit in filter(None, git("rev-list", "--reverse", base + ".." + head,
                                   cwd=directory).splitlines()):
        paths.update(filter(None, git("diff-tree", "--no-commit-id", "--name-only",
                                      "-r", commit, cwd=directory).splitlines()))
    return paths


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def strict_json(path):
    def unique(pairs):
        value = {}
        for key, item in pairs:
            require(key not in value, "duplicate_json_key_" + str(path))
            value[key] = item
        return value

    return json.loads(Path(path).read_text(), object_pairs_hook=unique)


def strict_json_text(text, source="runtime"):
    def unique(pairs):
        value = {}
        for key, item in pairs:
            require(key not in value, "duplicate_json_key_" + source)
            value[key] = item
        return value

    return json.loads(text, object_pairs_hook=unique)


def load_module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    specification = importlib.util.spec_from_loader(name, loader)
    require(specification is not None, "module_spec_" + name)
    module = importlib.util.module_from_spec(specification)
    loader.exec_module(module)
    return module


def commit_scope(commit, cwd=ROOT):
    output = git(
        "diff-tree", "--no-commit-id", "--name-only", "-r", commit, cwd=cwd
    )
    return set(filter(None, output.splitlines()))


def worktree_scope():
    output = checked([*GIT, "status", "--porcelain=v1", "--untracked-files=all"])
    return {line[3:] for line in output.splitlines() if len(line) > 3}


def metadata(commit, cwd=ROOT):
    return git(
        "show", "-s", "--format=%an%n%ae%n%cn%n%ce", commit, cwd=cwd
    ).splitlines()


def git_blob_digest(directory, commit, path):
    result = subprocess.run(
        [*GIT, "show", commit + ":" + path],
        cwd=directory,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    require(result.returncode == 0, "missing_commit_blob:" + path)
    return hashlib.sha256(result.stdout).hexdigest()


def implementation_file_hashes(directory, commit):
    return {
        path: git_blob_digest(directory, commit, path)
        for path in sorted(DESCENDANT_BASELINE_IMPLEMENTATION_SCOPE)
    }


def retained_protected_path(path):
    if path in {"AGENTS.md", "ARCHITECTURE.md", "README.md"}:
        return True
    if (
        path in PHASE5_PROTECTED_PATHS
        or path.startswith("codex/")
        or path.startswith("docs/phase-5")
        or path.startswith("evidence/phase-5/")
        or path.startswith("skills/manage-workstation/")
    ):
        return True
    return (
        path == "Package.swift"
        or path.startswith("Sources/AidAdmin")
        or path.startswith("bin/build-phase4")
        or path.startswith("bin/check-phase4")
        or path.startswith("bin/phase4")
        or path.startswith("docs/phase-4")
        or path.startswith("evidence/phase-4/")
        or path.startswith("install-bundles/phase-4/")
        or path.startswith("policy/aid-admin")
        or path == "policy/sudoers.d/agent-first-mac-aid-admin"
        or path.startswith("tests/AidAdmin")
    )


def validate_historical_topology():
    require(git("rev-parse", REVIEWED_HEAD + "^") == ORIGINAL_IMPLEMENTATION, "historical_evidence_parent")
    require(git("rev-parse", ORIGINAL_IMPLEMENTATION + "^") == BASE, "historical_implementation_parent")
    require(
        git("rev-parse", FIRST_CORRECTION_IMPLEMENTATION + "^") == REVIEWED_HEAD,
        "first_correction_implementation_parent",
    )
    require(
        git("rev-parse", FIRST_CORRECTION_EVIDENCE_COMMIT + "^")
        == FIRST_CORRECTION_IMPLEMENTATION,
        "first_correction_evidence_parent",
    )
    require(commit_scope(ORIGINAL_IMPLEMENTATION) == ORIGINAL_SCOPE, "historical_implementation_scope")
    require(commit_scope(REVIEWED_HEAD) == {HISTORICAL_EVIDENCE}, "historical_evidence_scope")
    require(
        commit_scope(FIRST_CORRECTION_IMPLEMENTATION) == CORRECTION_SCOPE,
        "first_correction_implementation_scope",
    )
    require(
        commit_scope(FIRST_CORRECTION_EVIDENCE_COMMIT) == {CORRECTION_EVIDENCE},
        "first_correction_evidence_scope",
    )
    require(metadata(ORIGINAL_IMPLEMENTATION) == METADATA, "historical_implementation_metadata")
    require(metadata(REVIEWED_HEAD) == METADATA, "historical_evidence_metadata")
    require(
        metadata(FIRST_CORRECTION_IMPLEMENTATION) == METADATA,
        "first_correction_implementation_metadata",
    )
    require(
        metadata(FIRST_CORRECTION_EVIDENCE_COMMIT) == METADATA,
        "first_correction_evidence_metadata",
    )
    require(
        git("rev-list", "--count", BASE + ".." + FIRST_CORRECTION_EVIDENCE_COMMIT)
        == "4",
        "historical_count",
    )
    require(
        git("rev-list", "--merges", BASE + ".." + FIRST_CORRECTION_EVIDENCE_COMMIT)
        == "",
        "historical_merge",
    )


def validate_prior_review_history():
    validate_historical_topology()
    require(
        git("rev-parse", INTEGRATION_CORRECTION_IMPLEMENTATION + "^")
        == FIRST_CORRECTION_EVIDENCE_COMMIT,
        "integration_correction_implementation_parent",
    )
    require(
        git("rev-parse", INTEGRATION_CORRECTION_EVIDENCE_COMMIT + "^")
        == INTEGRATION_CORRECTION_IMPLEMENTATION,
        "integration_correction_evidence_parent",
    )
    require(
        commit_scope(INTEGRATION_CORRECTION_IMPLEMENTATION)
        == INTEGRATION_CORRECTION_SCOPE,
        "integration_correction_implementation_scope",
    )
    require(
        commit_scope(INTEGRATION_CORRECTION_EVIDENCE_COMMIT)
        == {INTEGRATION_CORRECTION_EVIDENCE},
        "integration_correction_evidence_scope",
    )
    require(
        metadata(INTEGRATION_CORRECTION_IMPLEMENTATION) == METADATA,
        "integration_correction_metadata",
    )
    require(
        metadata(INTEGRATION_CORRECTION_EVIDENCE_COMMIT) == METADATA,
        "integration_correction_evidence_metadata",
    )
    require(
        git(
            "rev-list",
            "--count",
            BASE + ".." + INTEGRATION_CORRECTION_EVIDENCE_COMMIT,
        )
        == "6",
        "prior_review_history_count",
    )
    require(
        git(
            "rev-list",
            "--merges",
            BASE + ".." + INTEGRATION_CORRECTION_EVIDENCE_COMMIT,
        )
        == "",
        "prior_review_history_merge",
    )
    validate_integration_correction_evidence(
        INTEGRATION_CORRECTION_IMPLEMENTATION
    )


def acceptance_value(reviewed_head, **overrides):
    value = {
        "phase": "phase5_codex_contract_preparation",
        "phase5ApplyAuthorized": False,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "preparationOnly": True,
        "reviewMarker": MARKER,
        "reviewedTaskHead": reviewed_head,
        "schema": 1,
        "verdict": ACCEPTED_VERDICT,
    }
    value.update(overrides)
    return value


def validate_acceptance_value(value, reviewed_head):
    require(
        set(value)
        == {
            "phase",
            "phase5ApplyAuthorized",
            "phase5PassClaimed",
            "phase6Authorized",
            "preparationOnly",
            "reviewMarker",
            "reviewedTaskHead",
            "schema",
            "verdict",
        },
        "acceptance_keys",
    )
    require(value == acceptance_value(reviewed_head), "acceptance_contract")
    return value


def strict_acceptance(path, reviewed_head):
    return validate_acceptance_value(strict_json(path), reviewed_head)


def validate_review_history(reviewed_head):
    validate_prior_review_history()
    require(
        git("rev-list", "--count", BASE + ".." + reviewed_head) == "8",
        "review_history_count",
    )
    implementation = git("rev-parse", reviewed_head + "^")
    require(
        git("rev-parse", implementation + "^")
        == INTEGRATION_CORRECTION_EVIDENCE_COMMIT,
        "source_transport_implementation_parent",
    )
    require(
        commit_scope(implementation) == SOURCE_TRANSPORT_CORRECTION_SCOPE,
        "source_transport_implementation_scope",
    )
    require(
        commit_scope(reviewed_head) == {SOURCE_TRANSPORT_CORRECTION_EVIDENCE},
        "source_transport_evidence_scope",
    )
    require(metadata(implementation) == METADATA, "source_transport_metadata")
    require(metadata(reviewed_head) == METADATA, "source_transport_evidence_metadata")
    require(
        git("rev-list", "--merges", BASE + ".." + reviewed_head) == "",
        "review_history_merge",
    )
    validate_source_transport_correction_evidence(implementation)
    return implementation


def validate_phase5_acceptance_object(
        directory, acceptance_commit, reviewed_head=ACCEPTED_REVIEWED_HEAD):
    require(
        git_at(directory, "rev-parse", acceptance_commit + "^") == reviewed_head,
        "acceptance_commit_parent",
    )
    require(
        commit_scope(acceptance_commit, cwd=directory) == {ACCEPTANCE_EVIDENCE},
        "acceptance_commit_scope",
    )
    require(
        metadata(acceptance_commit, cwd=directory) == COORDINATOR_METADATA,
        "acceptance_commit_metadata",
    )
    value = strict_json_text(
        git_at(
            directory,
            "show",
            acceptance_commit + ":" + ACCEPTANCE_EVIDENCE,
        ),
        "acceptance_commit",
    )
    validate_acceptance_value(value, reviewed_head)
    return value


def validate_first_compatibility_pair(directory, head="HEAD"):
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "first_compatibility_evidence_not_ancestor",
    )
    require(
        git_at(
            directory,
            "rev-parse",
            FIRST_COMPATIBILITY_IMPLEMENTATION + "^",
        )
        == ACCEPTANCE_COMMIT,
        "first_compatibility_implementation_parent",
    )
    require(
        git_at(
            directory,
            "rev-parse",
            FIRST_COMPATIBILITY_EVIDENCE_COMMIT + "^",
        )
        == FIRST_COMPATIBILITY_IMPLEMENTATION,
        "first_compatibility_evidence_parent",
    )
    require(
        commit_scope(
            FIRST_COMPATIBILITY_IMPLEMENTATION, cwd=directory
        )
        == COMPATIBILITY_CORRECTION_SCOPE,
        "first_compatibility_implementation_scope",
    )
    require(
        commit_scope(
            FIRST_COMPATIBILITY_EVIDENCE_COMMIT, cwd=directory
        )
        == COMPATIBILITY_EVIDENCE_SCOPE,
        "first_compatibility_evidence_scope",
    )
    require(
        metadata(FIRST_COMPATIBILITY_IMPLEMENTATION, cwd=directory)
        == METADATA
        and metadata(FIRST_COMPATIBILITY_EVIDENCE_COMMIT, cwd=directory)
        == METADATA,
        "first_compatibility_metadata",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--count",
            ACCEPTANCE_COMMIT
            + ".."
            + FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
        )
        == "2"
        and git_at(
            directory,
            "rev-list",
            "--merges",
            ACCEPTANCE_COMMIT
            + ".."
            + FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
        )
        == "",
        "first_compatibility_history_shape",
    )
    value = strict_json_text(
        git_at(
            directory,
            "show",
            FIRST_COMPATIBILITY_EVIDENCE_COMMIT
            + ":"
            + COMPATIBILITY_EVIDENCE,
        ),
        "first_compatibility_evidence",
    )
    validate_compatibility_correction_evidence_value(
        value, FIRST_COMPATIBILITY_IMPLEMENTATION
    )


def validate_descendant_implementation(directory, implementation):
    require(
        git_at(directory, "rev-parse", implementation + "^")
        == FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
        "descendant_implementation_parent",
    )
    require(
        commit_scope(implementation, cwd=directory)
        == DESCENDANT_BASELINE_IMPLEMENTATION_SCOPE,
        "descendant_implementation_scope",
    )
    require(
        metadata(implementation, cwd=directory) == METADATA,
        "descendant_implementation_metadata",
    )


def validate_descendant_baseline_pair(directory, head="HEAD"):
    require(
        run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
                head,
            ],
            cwd=directory,
        ).returncode
        == 0,
        "first_compatibility_evidence_not_ancestor",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            FIRST_COMPATIBILITY_EVIDENCE_COMMIT + ".." + head,
        )
        == "",
        "descendant_pair_merge",
    )
    commits = list(
        filter(
            None,
            git_at(
                directory,
                "rev-list",
                "--reverse",
                FIRST_COMPATIBILITY_EVIDENCE_COMMIT + ".." + head,
            ).splitlines(),
        )
    )
    require(len(commits) >= 2, "descendant_pair_commit_count")
    implementation, evidence_commit = commits[:2]
    validate_descendant_implementation(directory, implementation)
    require(
        git_at(directory, "rev-parse", evidence_commit + "^")
        == implementation,
        "descendant_evidence_parent",
    )
    require(
        commit_scope(evidence_commit, cwd=directory)
        == DESCENDANT_BASELINE_EVIDENCE_SCOPE,
        "descendant_evidence_scope",
    )
    require(
        metadata(evidence_commit, cwd=directory) == METADATA,
        "descendant_evidence_metadata",
    )
    try:
        value = strict_json_text(
            git_at(
                directory,
                "show",
                evidence_commit + ":" + DESCENDANT_BASELINE_EVIDENCE,
            ),
            "descendant_baseline_evidence",
        )
    except (json.JSONDecodeError, TypeError, ValueError) as error:
        raise RuntimeError("descendant_evidence_json") from error
    validate_descendant_baseline_evidence_value(
        value, directory, implementation
    )
    return implementation, evidence_commit


def validate_phase5_descendant(directory, head="HEAD"):
    require(
        run(
            [*GIT, "merge-base", "--is-ancestor", ACCEPTANCE_COMMIT, head],
            cwd=directory,
        ).returncode == 0,
        "acceptance_commit_not_ancestor",
    )
    require(
        git_at(
            directory,
            "rev-list",
            "--merges",
            ACCEPTANCE_COMMIT + ".." + head,
        )
        == "",
        "accepted_descendant_merge",
    )
    resolved_head = git_at(directory, "rev-parse", head)
    if resolved_head == ACCEPTANCE_COMMIT:
        return ACCEPTANCE_COMMIT
    validate_first_compatibility_pair(directory, head)
    _, protected_baseline = validate_descendant_baseline_pair(directory, head)
    changed = set(
        filter(
            None,
            git_at(
                directory,
                "diff",
                "--name-only",
                protected_baseline + ".." + head,
            ).splitlines(),
        )
    )
    protected = sorted(path for path in changed if retained_protected_path(path))
    require(
        not protected,
        "protected_descendant_drift"
        + (":" + ",".join(protected) if protected else ""),
    )
    return protected_baseline


def validate_accepted_through_first_compatibility():
    implementation = validate_review_history(ACCEPTED_REVIEWED_HEAD)
    validate_phase5_acceptance_object(ROOT, ACCEPTANCE_COMMIT)
    validate_first_compatibility_pair(ROOT)
    return implementation


def validate_accepted_preparation():
    implementation = validate_accepted_through_first_compatibility()
    validate_phase5_descendant(ROOT)
    return implementation


def validate_integrated_main():
    implementation = validate_accepted_preparation()
    return implementation, ACCEPTED_REVIEWED_HEAD


def validate_apply_bundle_state(expected_state):
    result = run(
        [APPLY_BUNDLE_VALIDATOR, "--git-only", "--json"],
        cwd=ROOT,
    )
    try:
        value = strict_json_text(result.stdout, "apply_bundle_validator")
    except (json.JSONDecodeError, TypeError, ValueError) as error:
        raise RuntimeError("apply_bundle_validator_output") from error
    if result.returncode != 0:
        reason = value.get("error")
        require(
            isinstance(reason, str) and bool(reason),
            "apply_bundle_validator_failed",
        )
        raise RuntimeError(reason)
    require(
        set(value)
        == {
            "acceptedControlCommit",
            "evidenceCommit",
            "implementationCommit",
            "liveApplyAuthorized",
            "marker",
            "mode",
            "phase5PassClaimed",
            "phase6Authorized",
            "protectedBaselineCommit",
            "repositoryState",
            "schema",
            "sourceCommit",
            "stageBContinuationRequired",
            "verdict",
        }
        and value["schema"] == 1
        and value["mode"] == "git-only"
        and value["repositoryState"] == expected_state
        and value["liveApplyAuthorized"] is False
        and value["phase5PassClaimed"] is False
        and value["phase6Authorized"] is False
        and value["stageBContinuationRequired"] is True
        and isinstance(value["protectedBaselineCommit"], str)
        and re.fullmatch(r"[0-9a-f]{40}", value["protectedBaselineCommit"])
        is not None
        and run(
            [
                *GIT,
                "merge-base",
                "--is-ancestor",
                value["protectedBaselineCommit"],
                "HEAD",
            ],
            cwd=ROOT,
        ).returncode
        == 0,
        "apply_bundle_validator_contract",
    )
    return value


def validate_descendant_baseline_correction(mode):
    validate_accepted_through_first_compatibility()
    head = git("rev-parse", "HEAD")
    if mode == "precommit":
        if head == FIRST_COMPATIBILITY_EVIDENCE_COMMIT:
            require(
                worktree_scope()
                == DESCENDANT_BASELINE_IMPLEMENTATION_SCOPE,
                "descendant_precommit_scope",
            )
            return None, None
        validate_descendant_implementation(ROOT, head)
        require(
            worktree_scope() == DESCENDANT_BASELINE_EVIDENCE_SCOPE,
            "descendant_evidence_precommit_scope",
        )
        validate_descendant_baseline_evidence_value(
            strict_json(ROOT / DESCENDANT_BASELINE_EVIDENCE),
            ROOT,
            head,
        )
        return head, head
    if mode == "implementation":
        validate_descendant_implementation(ROOT, head)
        require(
            git(
                "rev-list",
                "--count",
                FIRST_COMPATIBILITY_EVIDENCE_COMMIT + "..HEAD",
            )
            == "1"
            and git(
                "rev-list",
                "--merges",
                FIRST_COMPATIBILITY_EVIDENCE_COMMIT + "..HEAD",
            )
            == "",
            "descendant_implementation_history_shape",
        )
        return head, head

    implementation, evidence_commit = validate_descendant_baseline_pair(ROOT)
    require(
        head == evidence_commit
        and git(
            "rev-list",
            "--count",
            FIRST_COMPATIBILITY_EVIDENCE_COMMIT + "..HEAD",
        )
        == "2",
        "descendant_review_history_shape",
    )
    validate_phase5_descendant(ROOT)
    return implementation, evidence_commit


def validate_git(mode):
    branch = git("branch", "--show-current")
    if branch == PRIVATE_RUNTIME_BRANCH:
        validator_mode = "--implementation" if mode == "implementation" else "--git-only"
        result = run([APPLY_BUNDLE_VALIDATOR, validator_mode, "--json"], cwd=ROOT)
        require(result.returncode == 0, "private_runtime_apply_validator")
        value = strict_json_text(result.stdout, "private_runtime_apply_validator")
        require(value.get("marker") == PRIVATE_RUNTIME_MARKER
                and value.get("repositoryState")
                == ("private_runtime_implementation" if mode == "implementation"
                    else "private_runtime_review")
                and value.get("phase5PassClaimed") is False
                and value.get("phase6Authorized") is False,
                "private_runtime_apply_contract")
        return (value.get("implementationCommit"),
                value.get("protectedBaselineCommit"),
                "private_runtime_review")
    if branch == RUNNER_GATE_BRANCH:
        require(mode in {"implementation", "git-only", "final"}, "runner_gate_mode")
        current = current_main_compatibility(mode)
        require(current["state"] in {"private_runtime_runner_gate_implementation", "private_runtime_runner_gate_review"},
                "runner_gate_branch_state")
        return current["implementation"], current["baseline"], current["state"]
    require(
        run([*GIT, "merge-base", "--is-ancestor", BASE, "HEAD"]).returncode == 0,
        "base_not_ancestor",
    )
    require(run([*GIT, "diff", "--check", BASE]).returncode == 0, "diff_check")
    validate_prior_review_history()
    if mode == "precommit":
        require(branch == BRANCH, "precommit_wrong_branch")
        implementation, reviewed_head = validate_descendant_baseline_correction(mode)
        return implementation, reviewed_head, "correction_review"
    require(git("status", "--porcelain=v1", "--untracked-files=all") == "", "dirty_worktree")
    if mode == "implementation":
        require(branch == BRANCH, "implementation_wrong_branch")
        implementation, reviewed_head = validate_descendant_baseline_correction(mode)
        return implementation, reviewed_head, "correction_review"
    if branch == BRANCH:
        implementation, reviewed_head = validate_descendant_baseline_correction(mode)
        repository_state = "correction_review"
    elif branch == APPLY_BUNDLE_BRANCH:
        value = validate_apply_bundle_state("review")
        implementation = ACCEPTED_REVIEWED_HEAD
        reviewed_head = value["protectedBaselineCommit"]
        repository_state = "apply_bundle_review"
    elif branch == "main":
        value = validate_apply_bundle_state("integrated_main")
        implementation = ACCEPTED_REVIEWED_HEAD
        reviewed_head = value["protectedBaselineCommit"]
        repository_state = "apply_bundle_integrated"
    else:
        raise RuntimeError("unexpected_branch")
    return implementation, reviewed_head, repository_state


def validate_quarantine(text):
    require(
        "sandbox_mode" not in text and "sandbox_workspace_write" not in text,
        "quarantine_legacy_mix",
    )
    require('default_permissions = "quarantine"' in text, "quarantine_default")
    require('inherit = "none"' in text, "quarantine_inherit")
    require(
        'enabled = false' in text.split("[permissions.quarantine.network]", 1)[1],
        "quarantine_network",
    )
    require(
        '":root"' not in text and re.search(r'(?m)^\s*"~/', text) is None,
        "quarantine_broad_read",
    )
    require(
        re.search(r'(?m)^\s*"/', text) is None and "../" not in text,
        "quarantine_outside_path",
    )
    for pattern in (
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/*credentials*",
        "**/*secret*",
    ):
        require(f'"{pattern}" = "deny"' in text, "quarantine_secret_glob")
    for flag in (
        "apps",
        "browser_use",
        "browser_use_external",
        "browser_use_full_cdp_access",
        "computer_use",
        "in_app_browser",
        "plugins",
        "remote_plugin",
        "skill_mcp_dependency_install",
    ):
        require(
            re.search(r"(?m)^" + re.escape(flag) + r"\s*=\s*false$", text),
            "quarantine_feature_" + flag,
        )
    path_match = re.search(
        r'(?m)^set\s*=\s*\{\s*PATH\s*=\s*"([^"]+)"\s*\}$', text
    )
    require(
        path_match
        and path_match.group(1) == "/usr/bin:/bin:/usr/sbin:/sbin",
        "quarantine_path",
    )


def validate_registry(value):
    require(set(value) == {"schema", "repositories"} and value["schema"] == 1, "registry_shape")
    require(isinstance(value["repositories"], list) and value["repositories"], "registry_items")
    roots = set()
    identifiers = set()
    for item in value["repositories"]:
        require(
            set(item)
            == {
                "adoptedCommit",
                "canonicalRoot",
                "id",
                "provenance",
                "route",
                "trust",
            },
            "registry_item_keys",
        )
        root = item["canonicalRoot"]
        require(isinstance(root, str) and REGISTRY_ROOT.fullmatch(root), "registry_root")
        require(root not in roots, "registry_duplicate_root")
        roots.add(root)
        require(
            isinstance(item["id"], str)
            and re.fullmatch(r"[a-z0-9][a-z0-9-]*", item["id"])
            and item["id"] not in identifiers,
            "registry_id",
        )
        identifiers.add(item["id"])
        require(re.fullmatch(r"[0-9a-f]{40}", item["adoptedCommit"]), "registry_commit")
        require(item["route"] == "trusted", "registry_route")
        if root == "$HOME/AIDev/control":
            require(
                item["trust"] == "trusted-control"
                and item["provenance"] == "reviewed-control",
                "registry_control_policy",
            )
        else:
            require(
                item["trust"] == "trusted-repo"
                and item["provenance"] == "reviewed-clone",
                "registry_repo_policy",
            )


def validate_hooks(value):
    require(
        set(value) == {"hooks"}
        and set(value["hooks"]) == {"SessionStart", "PreToolUse", "Stop"},
        "hook_events",
    )
    session = value["hooks"]["SessionStart"]
    pretool = value["hooks"]["PreToolUse"]
    stop = value["hooks"]["Stop"]
    require(len(session) == len(pretool) == len(stop) == 1, "hook_groups")
    require(session[0].get("matcher") == "startup|resume|clear|compact", "hook_session_matcher")
    require(pretool[0].get("matcher") == "^Bash$", "hook_pretool_matcher")
    commands = [
        session[0]["hooks"][0],
        pretool[0]["hooks"][0],
        stop[0]["hooks"][0],
    ]
    require(all(item["type"] == "command" for item in commands), "hook_types")
    require(
        commands[0]
        == {
            "type": "command",
            "command": '/usr/bin/python3 "$HOME/AIDev/control/codex/hooks/phase5-contract.py" context',
            "timeout": 10,
            "statusMessage": "Routing workstation contract",
        },
        "hook_context_definition",
    )
    require(
        commands[1]
        == {
            "type": "command",
            "command": '/usr/bin/python3 "$HOME/AIDev/control/codex/hooks/phase5-contract.py" warn',
            "timeout": 5,
            "statusMessage": "Checking workstation routing",
        },
        "hook_warn_definition",
    )
    require(
        commands[2]
        == {
            "type": "command",
            "command": '/usr/bin/python3 "$HOME/AIDev/control/codex/hooks/phase5-contract.py" verify',
            "timeout": 15,
            "statusMessage": "Checking control handoff",
        },
        "hook_verify_definition",
    )
    require(
        all(
            "--dangerously-bypass-hook-trust" not in item["command"]
            for item in commands
        ),
        "hook_trust_bypass",
    )


def validate_skill():
    text = (ROOT / "skills/manage-workstation/SKILL.md").read_text()
    require(text.startswith("---\n") and text.count("---") == 2, "skill_frontmatter")
    header, body = text.split("---\n", 2)[1:]
    require(re.search(r"(?m)^name: manage-workstation$", header), "skill_name")
    description = re.search(r"(?m)^description: (.+)$", header)
    require(
        description
        and all(
            word in description.group(1).lower()
            for word in ("install", "adopt", "update", "remove", "repair", "repo-local")
        ),
        "skill_trigger_description",
    )
    require(
        len(body.splitlines()) < 80
        and "one primary" in body.lower()
        and "build before" in body.lower(),
        "skill_body",
    )
    agents = (ROOT / "skills/manage-workstation/agents/openai.yaml").read_text()
    require('display_name: "Manage Workstation"' in agents, "skill_openai_name")
    require('default_prompt: "Use $manage-workstation ' in agents, "skill_default_prompt")
    fixtures = strict_json(ROOT / "tests/fixtures/phase5-skill-triggers.json")
    require(
        set(fixtures) == {"noTrigger", "schema", "trigger"} and fixtures["schema"] == 1,
        "skill_fixture_shape",
    )
    require(
        len(fixtures["trigger"]) >= 4 and len(fixtures["noTrigger"]) >= 3,
        "skill_fixture_count",
    )
    require(
        any("global" in item.lower() or "workstation" in item.lower() for item in fixtures["trigger"])
        and all(
            "repo" in item.lower() or "project" in item.lower()
            for item in fixtures["noTrigger"]
        ),
        "skill_trigger_boundary",
    )


def validate_manifest(value):
    require(
        value["schema"] == 1
        and value["phase"] == "phase5_codex_contract_preparation",
        "manifest_header",
    )
    require(value["acceptedBase"] == BASE and value["preparationOnly"] is True, "manifest_base")
    require(
        value["cli"]
        == {
            "canonicalPath": str(CODEX),
            "fileContract": "regular-executable-non-symlink",
            "observedVersion": "codex-cli 0.145.0-alpha.18",
            "source": "chatgpt-app-bundle",
        },
        "manifest_cli",
    )
    require(
        value["gate"]
        == {
            "applyAuthorized": False,
            "independentReviewRequired": True,
            "marker": MARKER,
            "maximumVerdict": VERDICT,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
        },
        "manifest_gate",
    )
    require(
        value["trusted"]
        == {
            "approvalPolicy": "never",
            "newEnvironmentInheritance": False,
            "sandboxMode": "danger-full-access",
        },
        "manifest_trusted",
    )
    require(
        value["transaction"]["allowedManagedKeys"]
        == ["approval_policy", "sandbox_mode"],
        "manifest_merge_keys",
    )
    require(
        value["transaction"]["preserveUnknownKeys"] is True
        and value["transaction"]["rollback"] == "exact-byte-preimage",
        "manifest_transaction",
    )
    extensions = value["extensions"]
    require(extensions["futureAppsDefault"] == "deny-unlisted", "manifest_future_apps")
    require(extensions["marketplaceMutationAuthorized"] is False, "manifest_marketplace")
    require(
        extensions["pluginCanonicalOwnerRoot"] == "$HOME",
        "manifest_plugin_owner_root",
    )
    require(
        extensions["appModelToolAvailability"] == "apply-gate-required",
        "manifest_app_availability",
    )
    require(
        extensions["mcpObservedVersionPolicy"]
        == "installed-cli-does-not-expose-server-versions; identity-enabled-auth-transport-and-timeouts-are-exact; version-health-tools-and-smoke-are-apply-gate-required",
        "manifest_mcp_version_policy",
    )
    app_ids = set()
    for app in extensions["apps"]:
        require(
            set(app)
            == {
                "availability",
                "id",
                "destructiveAutoApprove",
                "oauthMutationAuthorized",
                "openWorldAutoApprove",
                "policy",
            },
            "manifest_app_keys",
        )
        app_ids.add(app["id"])
        require(
            app["availability"] == "apply-gate-required"
            and app["policy"] == "preserve-if-present"
            and app["destructiveAutoApprove"] is False
            and app["openWorldAutoApprove"] is False
            and app["oauthMutationAuthorized"] is False,
            "manifest_app_approval",
        )
    require(app_ids == EXPECTED_APPS and len(app_ids) == len(extensions["apps"]), "manifest_app_ids")
    require(
        value["integration"]
        == {
            "acceptanceFile": ACCEPTANCE_EVIDENCE,
            "acceptedVerdict": ACCEPTED_VERDICT,
            "coordinatorIdentity": {
                "email": "coordinator@agent-first-mac.invalid",
                "name": "Agent-First Mac Coordinator",
            },
            "integratedBranch": "main",
            "phase5ApplyAuthorized": False,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
            "reviewBranch": BRANCH,
            "reviewVerdict": VERDICT,
        },
        "manifest_integration",
    )
    plugins = []
    plugin_ids = set()
    for item in extensions["plugins"]:
        identifier = item.get("id")
        require(
            isinstance(identifier, str) and identifier.count("@") == 1,
            "manifest_plugin_identity",
        )
        name, marketplace = identifier.split("@")
        source_classes = {
            "openai-bundled": (
                "codex-home-app-managed-bundled-marketplace",
                "codex-home-app-managed-bundled-plugin",
            ),
            "openai-curated": (
                "not-exposed",
                "codex-home-app-managed-curated-plugin",
            ),
            "openai-primary-runtime": (
                "owner-home-primary-runtime-marketplace",
                "owner-home-primary-runtime-plugin",
            ),
        }
        require(marketplace in source_classes and bool(name), "manifest_plugin_marketplace")
        require(
            set(item)
            == {
                "approvalPolicyObserved",
                "enabledObserved",
                "enabledTools",
                "id",
                "installPolicyObserved",
                "observedVersion",
                "owner",
                "policy",
                "smoke",
                "source",
            },
            "manifest_plugin_keys",
        )
        require(
            item["enabledObserved"] is True
            and item["approvalPolicyObserved"]
            == (
                "ON_USE"
                if marketplace == "openai-primary-runtime"
                else "ON_INSTALL"
            )
            and item["enabledTools"]
            == "not-exposed-by-installed-cli-apply-gate-required"
            and item["installPolicyObserved"] == "AVAILABLE"
            and item["owner"] == "openai"
            and item["policy"] == "preserve-installed-observed",
            "manifest_plugin_state",
        )
        require(
            item["smoke"] == "apply-gate-required"
            and item["source"]
            == {
                "marketplace": marketplace,
                "marketplaceSourceClass": source_classes[marketplace][0],
                "pathClass": source_classes[marketplace][1],
                "relativePath": "plugins/" + name,
                "sourceType": "local",
            },
            "manifest_plugin_state",
        )
        require(item["id"] not in plugin_ids, "manifest_plugin_duplicate")
        plugin_ids.add(item["id"])
        plugins.append((item["id"], item["observedVersion"]))
    require(tuple(plugins) == EXPECTED_PLUGINS, "manifest_plugins")
    expected_mcp_transports = {
        "computer-use": {
            "args": ["mcp"],
            "commandRelative": (
                "Codex Computer Use.app/Contents/SharedSupport/"
                "SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient"
            ),
            "commandResolver": "disabled-cwd-relative-observed",
            "cwdPolicy": "relative-dot-observed-disabled",
            "envKeys": [],
            "envMode": "none",
            "envValueClasses": {},
            "forwardedEnvKeys": [],
            "type": "stdio",
        },
        "node_repl": {
            "args": [],
            "commandRelative": "cua_node/bin/node_repl",
            "commandResolver": "chatgpt-app-resources",
            "cwdPolicy": "none",
            "envKeys": [
                "BROWSER_USE_AVAILABLE_BACKENDS",
                "BROWSER_USE_CODEX_APP_BUILD_FLAVOR",
                "BROWSER_USE_CODEX_APP_VERSION",
                "CODEX_CLI_PATH",
                "CODEX_HOME",
                "NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER",
                "NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME",
                "NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE",
                "NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS",
                "NODE_REPL_NODE_MODULE_DIRS",
                "NODE_REPL_NODE_PATH",
                "NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S",
                "NODE_REPL_TRUSTED_CODE_PATHS",
                "SKY_CUA_SERVICE_PATH",
            ],
            "envMode": "explicit-map",
            "envValueClasses": {
                "BROWSER_USE_AVAILABLE_BACKENDS": "comma-separated-safe-identifiers",
                "BROWSER_USE_CODEX_APP_BUILD_FLAVOR": "bounded-safe-token",
                "BROWSER_USE_CODEX_APP_VERSION": "dotted-version",
                "CODEX_CLI_PATH": "canonical-chatgpt-cli",
                "CODEX_HOME": "canonical-codex-home",
                "NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER": "bounded-single-line-instruction",
                "NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME": "bounded-single-line-instruction",
                "NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE": "bounded-single-line-instruction",
                "NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS": "positive-decimal-milliseconds",
                "NODE_REPL_NODE_MODULE_DIRS": "chatgpt-resource-directory",
                "NODE_REPL_NODE_PATH": "chatgpt-resource-file",
                "NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S": "comma-separated-sha256",
                "NODE_REPL_TRUSTED_CODE_PATHS": "canonical-codex-home",
                "SKY_CUA_SERVICE_PATH": "owner-home-codex-computer-use-app",
            },
            "forwardedEnvKeys": [],
            "type": "stdio",
        },
        "openaiDeveloperDocs": {
            "bearerTokenEnvVar": None,
            "envHttpHeaders": "none",
            "httpHeaders": "none",
            "type": "streamable_http",
            "url": "https://developers.openai.com/mcp",
        },
    }
    mcp = []
    mcp_ids = set()
    for item in extensions["mcp"]:
        require(
            set(item)
            == {
                "auth",
                "disabledReasonObserved",
                "enabledObserved",
                "enabledTools",
                "id",
                "policy",
                "smoke",
                "startupHealth",
                "startupTimeoutSecObserved",
                "toolTimeoutSecObserved",
                "transport",
            }
            and isinstance(item["enabledObserved"], bool)
            and item["auth"]
            == {
                "credentialMaterialAuthorized": False,
                "statusObserved": "unsupported",
                "storageClass": "not-exposed-by-installed-cli",
            }
            and item["disabledReasonObserved"] is None
            and item["enabledTools"]
            == "not-exposed-by-installed-cli-apply-gate-required"
            and item["policy"] == "preserve-current-no-auth",
            "manifest_mcp_item",
        )
        require(
            item["id"] in expected_mcp_transports
            and item["transport"] == expected_mcp_transports[item["id"]]
            and item["smoke"] == "apply-gate-required"
            and item["startupHealth"] == "apply-gate-required"
            and item["startupTimeoutSecObserved"]
            == (120.0 if item["id"] == "node_repl" else None)
            and item["toolTimeoutSecObserved"] is None,
            "manifest_mcp_transport",
        )
        require(item["id"] not in mcp_ids, "manifest_mcp_duplicate")
        mcp_ids.add(item["id"])
        mcp.append((item["id"], item["enabledObserved"]))
    require(tuple(mcp) == EXPECTED_MCP, "manifest_mcp")
    generated = value["generatedFiles"]
    require({item["source"] for item in generated} == GENERATED_SOURCES, "generated_scope")
    require(len({item["target"] for item in generated}) == len(generated), "generated_targets")
    for item in generated:
        require(re.fullmatch(r"[0-9a-f]{64}", item["sha256"]), "generated_hash_format")
        require(digest(ROOT / item["source"]) == item["sha256"], "generated_hash_" + item["source"])
    require(
        value["hooks"]
        == {
            "allowedEvents": ["SessionStart", "PreToolUse", "Stop"],
            "installationAuthorized": False,
            "rootBoundary": False,
            "trustBypassAuthorized": False,
        },
        "manifest_hooks",
    )
    require(
        value["quarantine"]["environment"]
        == {
            "allowlist": ["CODEX_HOME", "HOME", "LANG", "LC_ALL", "PATH", "SHELL"],
            "codexHome": "$HOME/.codex",
            "inheritAmbient": False,
        }
        and value["quarantine"]["promptDelimiter"] == "--"
        and value["quarantine"]["unsafeRootCharacters"]
        == "reject-backslash-double-quote-c0-del",
        "manifest_quarantine_launcher",
    )


def validate_static():
    for path in ROOT.rglob("*.json"):
        strict_json(path)
    for path in (
        ROOT / "bin/check-phase4-final-probes",
        ROOT / "bin/check-phase5-prep",
        ROOT / "bin/phase4-final-doctor",
        ROOT / "bin/phase5-config-transaction",
        ROOT / "bin/phase5-preflight",
        ROOT / "codex/hooks/phase5-contract.py",
    ):
        ast.parse(path.read_text())
    checked(["/bin/zsh", "-n", ROOT / "bin/codex-quarantine"])
    guidance = (ROOT / "codex/global-AGENTS.md").read_text()
    require(
        len(guidance.encode()) <= 4096 and len(guidance.split()) <= 300,
        "global_guidance_budget",
    )
    require(
        "$manage-workstation" in guidance
        and "codex-quarantine" in guidance
        and "not a root or trust boundary" in guidance,
        "global_guidance_routing",
    )
    trusted = (ROOT / "codex/trusted-intent.toml").read_text()
    require(
        re.findall(r"(?m)^([a-z_]+)\s*=", trusted)
        == ["approval_policy", "sandbox_mode"],
        "trusted_intent_keys",
    )
    require(
        "shell_environment_policy" not in trusted and "inherit" not in trusted,
        "trusted_environment",
    )
    validate_quarantine((ROOT / "codex/quarantine.config.toml").read_text())
    launcher = (ROOT / "bin/codex-quarantine").read_text()
    require(
        "readonly CODEX_BINARY='/Applications/ChatGPT.app/Contents/Resources/codex'"
        in launcher
        and "command -v codex" not in launcher
        and '"$*"' not in launcher,
        "launcher_fixed_cli",
    )
    require(
        "exec /usr/bin/env -i" in launcher
        and 'CODEX_HOME="$OWNER_HOME/.codex"' in launcher
        and re.search(r"(?m)^\s*--\s*\\$", launcher)
        and re.search(r'(?m)^\s*"\$prompt"$', launcher),
        "launcher_environment_delimiter",
    )
    for flag in (
        "--ignore-user-config",
        "--ignore-rules",
        "--ephemeral",
        "--profile quarantine",
        "--cd",
    ):
        require(flag in launcher, "launcher_flag_" + flag)
    require("--sandbox" not in launcher and "aid-admin" not in launcher, "launcher_boundary")
    preflight_text = (ROOT / "bin/phase5-preflight").read_text()
    require("shutil.which" not in preflight_text and str(CODEX) in preflight_text, "preflight_fixed_cli")
    transaction_text = (ROOT / "bin/phase5-config-transaction").read_text()
    require(str(CODEX) in transaction_text and "--strict-config" in transaction_text, "transaction_strict_cli")
    registry = strict_json(ROOT / "manifests/trusted-repos.json")
    validate_registry(registry)
    schema = strict_json(ROOT / "manifests/trusted-repos.schema.json")
    route_schema = schema["properties"]["repositories"]["items"]["properties"]["route"]
    require(route_schema == {"const": "trusted"}, "registry_schema_route")
    validate_hooks(strict_json(ROOT / "codex/hooks.json"))
    validate_skill()
    validate_manifest(strict_json(ROOT / "manifests/codex-contract.json"))
    routers = {
        name: (ROOT / name).read_text()
        for name in ("ARCHITECTURE.md", "AGENTS.md", "README.md")
    }
    for name, text in routers.items():
        for required in (
            "review-state: PHASE5_PREPARATION_PREPARED_FOR_INDEPENDENT_REVIEW",
            "integrated-main-state: ACCEPTED_PREPARATION",
            ACCEPTANCE_EVIDENCE,
            "phase5ApplyAuthorized=false",
            "phase5PassClaimed=false",
            "phase6Authorized=false",
        ):
            require(required in text, "integration_router_" + name + "_" + required)
    phase5_doc = (ROOT / "docs/phase-5-codex-contract.md").read_text()
    for required in (
        ACCEPTANCE_COMMIT,
        COMPATIBILITY_MARKER,
        COMPATIBILITY_VERDICT,
        FIRST_COMPATIBILITY_IMPLEMENTATION,
        FIRST_COMPATIBILITY_EVIDENCE_COMMIT,
        DESCENDANT_BASELINE_MARKER,
        DESCENDANT_BASELINE_VERDICT,
        "linear descendants",
        "protected descendant baseline",
        "protected Phase 4 and Phase 5",
    ):
        require(required in phase5_doc, "compatibility_doc_" + required)
    scan_scope = (
        ORIGINAL_SCOPE
        | CORRECTION_SCOPE
        | INTEGRATION_CORRECTION_SCOPE
        | SOURCE_TRANSPORT_CORRECTION_SCOPE
        | {HISTORICAL_EVIDENCE, CORRECTION_EVIDENCE}
    )
    if (ROOT / INTEGRATION_CORRECTION_EVIDENCE).exists():
        scan_scope.add(INTEGRATION_CORRECTION_EVIDENCE)
    if (ROOT / SOURCE_TRANSPORT_CORRECTION_EVIDENCE).exists():
        scan_scope.add(SOURCE_TRANSPORT_CORRECTION_EVIDENCE)
    if (ROOT / ACCEPTANCE_EVIDENCE).exists():
        scan_scope.add(ACCEPTANCE_EVIDENCE)
    if (ROOT / COMPATIBILITY_EVIDENCE).exists():
        scan_scope.add(COMPATIBILITY_EVIDENCE)
    if (ROOT / DESCENDANT_BASELINE_EVIDENCE).exists():
        scan_scope.add(DESCENDANT_BASELINE_EVIDENCE)
    combined = "\n".join(
        (ROOT / item).read_text(errors="ignore")
        for item in sorted(scan_scope)
        if (ROOT / item).is_file()
    )
    private_home_prefix = "/" + "Users/"
    external_repo_name = "Migrate" + "FromWindows"
    require(
        private_home_prefix not in combined and external_repo_name not in combined,
        "private_or_external_path",
    )
    allowed_mcp_url = "https://" + "developers." + "openai.com/mcp"
    require(
        combined.count(allowed_mcp_url) == 3
        and "developers." + "openai.com"
        not in combined.replace(allowed_mcp_url, ""),
        "external_network_dependency",
    )
    require(
        not re.search(
            r"AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|"
            r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
            combined,
        ),
        "secret_pattern",
    )


def expect_reject(function, reason):
    try:
        function()
    except (
        RuntimeError,
        SystemExit,
        IndexError,
        KeyError,
        TypeError,
        ValueError,
    ):
        return
    raise RuntimeError("negative_passed_" + reason)


def negative_matrix():
    base = (ROOT / "codex/quarantine.config.toml").read_text()
    mutations = {
        "legacy_mix": base + '\nsandbox_mode = "read-only"\n',
        "root_read": base.replace('":minimal" = "read"', '":root" = "read"'),
        "home_read": base.replace('":minimal" = "read"', '"~/" = "read"'),
        "outside_read": base.replace('":minimal" = "read"', '"/private/var/example" = "read"'),
        "secret_glob": base.replace('"**/.env" = "deny"\n', ""),
        "inherit": base.replace('inherit = "none"', 'inherit = "all"'),
        "network": base.replace(
            "[permissions.quarantine.network]\nenabled = false",
            "[permissions.quarantine.network]\nenabled = true",
        ),
        "plugin": base.replace("plugins = false", "plugins = true"),
        "aid_admin": base.replace(
            "/usr/bin:/bin:/usr/sbin:/sbin", "$HOME/AIDev/bin:/usr/bin:/bin"
        ),
    }
    for name, text in mutations.items():
        expect_reject(lambda value=text: validate_quarantine(value), name)
    registry = strict_json(ROOT / "manifests/trusted-repos.json")
    wildcard = copy.deepcopy(registry)
    wildcard["repositories"][0]["canonicalRoot"] = "$HOME/AIDev/repos/*"
    expect_reject(lambda: validate_registry(wildcard), "wildcard_registry")
    malformed = copy.deepcopy(registry)
    del malformed["repositories"][0]["adoptedCommit"]
    expect_reject(lambda: validate_registry(malformed), "malformed_registry")
    wrong_route = copy.deepcopy(registry)
    wrong_route["repositories"][0]["route"] = "quarantine"
    expect_reject(lambda: validate_registry(wrong_route), "registry_quarantine_route")
    hooks = strict_json(ROOT / "codex/hooks.json")
    hooks["hooks"]["PostToolUse"] = []
    expect_reject(lambda: validate_hooks(hooks), "unexpected_hook")
    hooks = strict_json(ROOT / "codex/hooks.json")
    hooks["hooks"]["PreToolUse"][0]["hooks"][0]["command"] += " --changed"
    expect_reject(lambda: validate_hooks(hooks), "changed_hook_definition")
    manifest = strict_json(ROOT / "manifests/codex-contract.json")
    blanket = copy.deepcopy(manifest)
    blanket["extensions"]["apps"].append(
        {
            "id": "_default",
            "availability": "assumed-installed",
            "destructiveAutoApprove": True,
            "openWorldAutoApprove": True,
            "oauthMutationAuthorized": True,
            "policy": "preserve-installed",
        }
    )
    expect_reject(lambda: validate_manifest(blanket), "blanket_apps")
    plugin_state = copy.deepcopy(manifest)
    plugin_state["extensions"]["plugins"][0]["enabledObserved"] = False
    expect_reject(lambda: validate_manifest(plugin_state), "plugin_enabled_drift")
    plugin_version = copy.deepcopy(manifest)
    plugin_version["extensions"]["plugins"][0]["observedVersion"] = "drift"
    expect_reject(lambda: validate_manifest(plugin_version), "plugin_version_drift")
    plugin_reorder = copy.deepcopy(manifest)
    plugin_reorder["extensions"]["plugins"][0], plugin_reorder["extensions"]["plugins"][1] = (
        plugin_reorder["extensions"]["plugins"][1],
        plugin_reorder["extensions"]["plugins"][0],
    )
    expect_reject(lambda: validate_manifest(plugin_reorder), "plugin_order_drift")
    plugin_source = copy.deepcopy(manifest)
    plugin_source["extensions"]["plugins"][0]["source"]["pathClass"] = "unreviewed"
    expect_reject(lambda: validate_manifest(plugin_source), "plugin_source_drift")
    plugin_marketplace = copy.deepcopy(manifest)
    plugin_marketplace["extensions"]["plugins"][0]["source"]["marketplace"] = "local"
    expect_reject(
        lambda: validate_manifest(plugin_marketplace),
        "plugin_marketplace_drift",
    )
    mcp_state = copy.deepcopy(manifest)
    mcp_state["extensions"]["mcp"][0]["enabledObserved"] = True
    expect_reject(lambda: validate_manifest(mcp_state), "mcp_enabled_drift")
    mcp_reorder = copy.deepcopy(manifest)
    mcp_reorder["extensions"]["mcp"][0], mcp_reorder["extensions"]["mcp"][1] = (
        mcp_reorder["extensions"]["mcp"][1],
        mcp_reorder["extensions"]["mcp"][0],
    )
    expect_reject(lambda: validate_manifest(mcp_reorder), "mcp_order_drift")
    mcp_command = copy.deepcopy(manifest)
    mcp_command["extensions"]["mcp"][0]["transport"]["commandRelative"] = "unreviewed"
    expect_reject(lambda: validate_manifest(mcp_command), "mcp_command_drift")
    mcp_sky_class = copy.deepcopy(manifest)
    mcp_sky_class["extensions"]["mcp"][1]["transport"]["envValueClasses"][
        "SKY_CUA_SERVICE_PATH"
    ] = "openai-bundled-computer-use-version-subdirectory"
    expect_reject(lambda: validate_manifest(mcp_sky_class), "mcp_sky_class_drift")
    mcp_timeout = copy.deepcopy(manifest)
    mcp_timeout["extensions"]["mcp"][1]["startupTimeoutSecObserved"] = 1.0
    expect_reject(lambda: validate_manifest(mcp_timeout), "mcp_timeout_drift")
    generated = copy.deepcopy(manifest)
    generated["generatedFiles"][0]["sha256"] = "0" * 64
    expect_reject(lambda: validate_manifest(generated), "generated_hash_drift")
    cli = copy.deepcopy(manifest)
    cli["cli"]["canonicalPath"] = "codex"
    expect_reject(lambda: validate_manifest(cli), "ambient_cli")
    expect_reject(
        lambda: require(
            {"unexpected"} == COMPATIBILITY_CORRECTION_SCOPE,
            "scope",
        ),
        "unexpected_git_scope",
    )


def transaction_fixture():
    tool = ROOT / "bin/phase5-config-transaction"
    with tempfile.TemporaryDirectory(prefix="phase5-transaction-") as directory:
        root = Path(directory).resolve()
        codex_home = root / ".codex"
        state = root / "state"
        codex_home.mkdir()
        state.mkdir()
        current = codex_home / "config.toml"
        original = (
            '# owner comment\napproval_policy = "on-request" # preserve comment\n'
            'sandbox_mode = "workspace-write"\nmodel = "fixture-model"\n\n'
            '[shell_environment_policy]\ninherit = "none"\n'
            "[desktop]\nnotifications = true\n"
            '[projects."private-path"]\ntrust_level = "trusted"\n'
        ).encode()
        current.write_bytes(original)
        current.chmod(0o640)
        staged = state / "staged.toml"
        backup = state / "backup.bin"
        receipt = state / "receipt.json"
        commit = "a" * 40
        common = [
            "--codex-home",
            codex_home,
            "--current",
            current,
            "--receipt",
            receipt,
            "--reviewed-commit",
            commit,
        ]
        checked(
            [
                sys.executable,
                tool,
                "stage",
                *common,
                "--staged",
                staged,
                "--backup",
                backup,
            ]
        )
        generated = staged.read_bytes()
        require(
            all((path.stat().st_mode & 0o777) == 0o600 for path in (staged, backup, receipt)),
            "transaction_private_modes",
        )
        require(
            b'model = "fixture-model"' in generated
            and b'[shell_environment_policy]\ninherit = "none"' in generated
            and b"notifications = true" in generated
            and b'trust_level = "trusted"' in generated,
            "transaction_unmanaged_preservation",
        )
        checked([sys.executable, tool, "apply", *common, "--staged", staged])
        require(
            current.read_bytes() == generated
            and (current.stat().st_mode & 0o777) == 0o640,
            "transaction_apply",
        )
        checked([sys.executable, tool, "rollback", *common, "--backup", backup])
        require(
            current.read_bytes() == original
            and (current.stat().st_mode & 0o777) == 0o640,
            "transaction_exact_rollback",
        )

        missing_home = root / "missing/.codex"
        missing_state = root / "missing/state"
        missing_home.mkdir(parents=True)
        missing_state.mkdir()
        missing_current = missing_home / "config.toml"
        missing_original = (
            'model = "fixture-model"\n[desktop]\nnotifications = true\n'
        ).encode()
        missing_current.write_bytes(missing_original)
        missing_common = [
            "--codex-home",
            missing_home,
            "--current",
            missing_current,
            "--receipt",
            missing_state / "receipt",
            "--reviewed-commit",
            commit,
        ]
        checked(
            [
                sys.executable,
                tool,
                "stage",
                *missing_common,
                "--staged",
                missing_state / "staged",
                "--backup",
                missing_state / "backup",
            ]
        )
        missing_generated = (missing_state / "staged").read_bytes()
        require(
            b'model = "fixture-model"' in missing_generated
            and b"notifications = true" in missing_generated
            and b'approval_policy = "never"' in missing_generated
            and b'sandbox_mode = "danger-full-access"' in missing_generated,
            "transaction_missing_key_merge",
        )

        for name, content in (
            (
                "duplicate",
                b'approval_policy = "never"\napproval_policy = "never"\n'
                b'sandbox_mode = "danger-full-access"\n',
            ),
            (
                "nonscalar",
                b'approval_policy = { value = "never" }\n'
                b'sandbox_mode = "danger-full-access"\n',
            ),
            (
                "malformed",
                b'approval_policy = "never"\nsandbox_mode = "danger-full-access"\n'
                b"[desktop\nnotifications = true\n",
            ),
        ):
            bad_home = root / (name + "/.codex")
            bad_state = root / (name + "/state")
            bad_home.mkdir(parents=True)
            bad_state.mkdir()
            bad_current = bad_home / "config.toml"
            bad_current.write_bytes(content)
            expect_reject(
                lambda ch=bad_home, cs=bad_state, cc=bad_current: checked(
                    [
                        sys.executable,
                        tool,
                        "stage",
                        "--codex-home",
                        ch,
                        "--current",
                        cc,
                        "--staged",
                        cs / "staged",
                        "--backup",
                        cs / "backup",
                        "--receipt",
                        cs / "receipt",
                        "--reviewed-commit",
                        commit,
                    ]
                ),
                "transaction_" + name,
            )
            require(not any(bad_state.iterdir()), "transaction_failure_outputs_" + name)

        drift_home = root / "drift/.codex"
        drift_state = root / "drift/state"
        drift_home.mkdir(parents=True)
        drift_state.mkdir()
        drift_current = drift_home / "config.toml"
        drift_current.write_bytes(original)
        drift_common = [
            "--codex-home",
            drift_home,
            "--current",
            drift_current,
            "--receipt",
            drift_state / "receipt",
            "--reviewed-commit",
            commit,
        ]
        checked(
            [
                sys.executable,
                tool,
                "stage",
                *drift_common,
                "--staged",
                drift_state / "staged",
                "--backup",
                drift_state / "backup",
            ]
        )
        drift_current.write_bytes(original + b"# drift\n")
        expect_reject(
            lambda: checked(
                [
                    sys.executable,
                    tool,
                    "apply",
                    *drift_common,
                    "--staged",
                    drift_state / "staged",
                ]
            ),
            "transaction_apply_drift",
        )

        protected = codex_home / "auth.json"
        protected.write_text("{}")
        expect_reject(
            lambda: checked(
                [
                    sys.executable,
                    tool,
                    "stage",
                    "--codex-home",
                    codex_home,
                    "--current",
                    protected,
                    "--staged",
                    state / "x",
                    "--backup",
                    state / "y",
                    "--receipt",
                    state / "z",
                    "--reviewed-commit",
                    commit,
                ]
            ),
            "protected_target",
        )
        expect_reject(
            lambda: checked(
                [
                    sys.executable,
                    tool,
                    "stage",
                    *common,
                    "--staged",
                    codex_home / "staged",
                    "--backup",
                    state / "outside-backup",
                    "--receipt",
                    state / "outside-receipt",
                ]
            ),
            "state_inside_codex_home",
        )


def launcher_fixture():
    fixture = strict_json(FIXTURES)["launcher"]
    launcher_text = (ROOT / "bin/codex-quarantine").read_text()
    canonical_line = (
        "readonly CODEX_BINARY='/Applications/ChatGPT.app/Contents/Resources/codex'"
    )
    owner_line = (
        "readonly OWNER_HOME=$(/usr/bin/python3 -c "
        "'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)')"
    )
    require(launcher_text.count(canonical_line) == 1, "launcher_fixture_cli_binding")
    require(launcher_text.count(owner_line) == 1, "launcher_fixture_home_binding")
    with tempfile.TemporaryDirectory(prefix="phase5-launcher-") as directory:
        root = Path(directory).resolve()
        owner_home = root / "owner home"
        codex_home = owner_home / ".codex"
        quarantine = owner_home / "AIDev/quarantine"
        workspace = quarantine / "repo with spaces"
        codex_home.mkdir(parents=True)
        workspace.mkdir(parents=True)
        capture_file = root / "capture.json"
        capture_cli = root / "capture-codex"
        capture_source = root / "capture.c"
        capture_source.write_text(
            "#include <stdio.h>\n"
            "extern char **environ;\n"
            "int main(int argc, char **argv) {\n"
            "  FILE *stream = fopen("
            + json.dumps(str(capture_file))
            + ', "w");\n'
            "  if (stream == NULL) return 90;\n"
            '  for (int i = 1; i < argc; i++) fprintf(stream, "A:%s\\n", argv[i]);\n'
            '  for (char **item = environ; *item != NULL; item++) fprintf(stream, "E:%s\\n", *item);\n'
            "  return fclose(stream) == 0 ? 0 : 91;\n"
            "}\n"
        )
        checked(["/usr/bin/clang", capture_source, "-o", capture_cli])
        fake_bin = root / "fake-bin"
        fake_bin.mkdir()
        fake_marker = root / "fake-path-executed"
        fake_codex = fake_bin / "codex"
        fake_codex.write_text(
            "#!/usr/bin/python3\n"
            "from pathlib import Path\n"
            + "Path("
            + repr(str(fake_marker))
            + ").write_text('executed')\n"
        )
        fake_codex.chmod(0o755)
        fixture_launcher = root / "codex-quarantine"
        replaced = launcher_text.replace(
            canonical_line, "readonly CODEX_BINARY=" + shlex.quote(str(capture_cli))
        ).replace(owner_line, "readonly OWNER_HOME=" + shlex.quote(str(owner_home)))
        fixture_launcher.write_text(replaced)
        fixture_launcher.chmod(0o755)
        environment = os.environ.copy()
        environment.update(
            {
                "CODEX_HOME": str(root / "ambient-codex-home"),
                "HOME": str(root / "ambient-home"),
                "PATH": str(fake_bin) + ":/usr/bin:/bin",
                "PHASE5_SECRET_SENTINEL": "must-not-reach-cli",
            }
        )
        result = run(
            [
                fixture_launcher,
                "--root",
                workspace,
                "--",
                fixture["prompt"],
            ],
            environment=environment,
        )
        require(result.returncode == 0, "launcher_capture_execution:" + result.stdout[-400:])
        require(capture_file.is_file(), "launcher_capture_missing")
        capture_lines = capture_file.read_text().splitlines()
        arguments = [line[2:] for line in capture_lines if line.startswith("A:")]
        launched_environment = dict(
            line[2:].split("=", 1)
            for line in capture_lines
            if line.startswith("E:") and "=" in line
        )
        require(arguments[0] == "exec", "launcher_capture_subcommand")
        require(arguments[-2:] == ["--", fixture["prompt"]], "launcher_prompt_delimiter")
        require(arguments.count("--") == 1, "launcher_single_delimiter")
        require(
            f'projects."{workspace}".trust_level="untrusted"' in arguments,
            "launcher_project_override",
        )
        require(not fake_marker.exists(), "launcher_fake_path_executed")
        require(
            set(launched_environment)
            == {"CODEX_HOME", "HOME", "LANG", "LC_ALL", "PATH", "SHELL"},
            "launcher_environment_allowlist",
        )
        require(
            launched_environment["HOME"] == str(owner_home)
            and launched_environment["CODEX_HOME"] == str(codex_home)
            and launched_environment["PATH"] == "/usr/bin:/bin:/usr/sbin:/sbin"
            and "PHASE5_SECRET_SENTINEL" not in launched_environment,
            "launcher_environment_values",
        )
        for suffix in fixture["unsafeRootSuffixes"]:
            unsafe = quarantine / ("unsafe" + suffix)
            unsafe.mkdir()
            capture_file.unlink(missing_ok=True)
            denied = run(
                [fixture_launcher, "--root", unsafe, "--", "task"],
                environment=environment,
            )
            require(
                denied.returncode == 2 and not capture_file.exists(),
                "launcher_unsafe_root",
            )
        capture_file.unlink(missing_ok=True)
        multiple = run(
            [fixture_launcher, "--root", workspace, "--", "one", "two"],
            environment=environment,
        )
        require(
            multiple.returncode == 2 and not capture_file.exists(),
            "launcher_single_prompt",
        )


def hook_fixtures():
    hook = load_module(
        "phase5_contract_hook", ROOT / "codex/hooks/phase5-contract.py"
    )
    cases = strict_json(FIXTURES)["hookCases"]
    with tempfile.TemporaryDirectory(prefix="phase5-hooks-") as directory:
        fixture_root = Path(directory).resolve()
        home = fixture_root / "home"
        control = home / "AIDev/control"
        control_worktree = home / "AIDev/worktrees/control/task"
        quarantine = home / "AIDev/quarantine/input"
        trusted = home / "AIDev/repos/trusted"
        unknown = home / "AIDev/repos/unknown"
        generic = home / "AIDev/scratch/generic"
        outside = fixture_root / "outside"
        registry_path = control / "manifests/trusted-repos.json"
        for path in (
            control,
            control_worktree,
            quarantine,
            trusted,
            unknown,
            generic,
            outside,
        ):
            path.mkdir(parents=True, exist_ok=True)
        registry_path.parent.mkdir(parents=True, exist_ok=True)
        checked([*GIT, "init", "-q", trusted])
        checked([*GIT, "init", "-q", unknown])

        def write_registry(root_value="$HOME/AIDev/repos/trusted"):
            registry = {
                "repositories": [
                    {
                        "adoptedCommit": "a" * 40,
                        "canonicalRoot": root_value,
                        "id": "trusted-fixture",
                        "provenance": "reviewed-clone",
                        "route": "trusted",
                        "trust": "trusted-repo",
                    }
                ],
                "schema": 1,
            }
            registry_path.write_text(
                json.dumps(registry, sort_keys=True, separators=(",", ":"))
            )

        write_registry()
        paths = {
            "control": control,
            "control-worktree": control_worktree,
            "registered-trusted": trusted,
            "quarantine": quarantine,
            "unknown-git": unknown,
            "non-git": generic,
        }
        for case in cases["routes"]:
            actual = hook.zone(
                str(paths[case["name"]]),
                home=home,
                registry_path=registry_path,
            )
            require(actual == case["route"], "hook_route_" + case["name"])
            output = io.StringIO()
            with contextlib.redirect_stdout(output):
                hook.context(
                    {"cwd": str(paths[case["name"]])},
                    home=home,
                    registry_path=registry_path,
                )
            response = json.loads(output.getvalue())
            if actual == "unknown_git":
                require(
                    response.get("continue") is False
                    and "codex-quarantine" in response.get("systemMessage", "")
                    and str(paths[case["name"]]) not in output.getvalue(),
                    "hook_unknown_git_stop",
                )
            else:
                require(
                    response["hookSpecificOutput"]["hookEventName"]
                    == "SessionStart",
                    "hook_context_shape_" + case["name"],
                )

        for case in cases["preTool"]:
            output = io.StringIO()
            with contextlib.redirect_stdout(output):
                hook.warn(
                    {
                        "tool_input": {"command": case["command"]},
                        "tool_name": "Bash",
                    }
                )
            if case["warn"]:
                response = json.loads(output.getvalue())
                require(set(response) == {"systemMessage"}, "hook_pretool_output_fields")
                require(
                    "PHASE5_SECRET_SENTINEL" not in output.getvalue()
                    and case["command"] not in output.getvalue(),
                    "hook_pretool_no_command_log",
                )
            else:
                require(output.getvalue() == "", "hook_pretool_benign")

        hook_text = (ROOT / "codex/hooks/phase5-contract.py").read_text()
        home_definition = (
            "def canonical_home():\n"
            "    return Path(pwd.getpwuid(os.getuid()).pw_dir).resolve(strict=True)"
        )
        require(hook_text.count(home_definition) == 1, "hook_fixture_home_binding")
        fixture_hook = fixture_root / "phase5-contract.py"
        fixture_hook.write_text(
            hook_text.replace(
                home_definition,
                "def canonical_home():\n"
                + "    return Path("
                + repr(str(home))
                + ").resolve(strict=True)",
            )
        )
        direct_unknown = run(
            [sys.executable, fixture_hook, "context"],
            stdin=json.dumps(
                {"cwd": str(unknown), "hook_event_name": "SessionStart"}
            ),
        )
        require(direct_unknown.returncode == 0, "hook_direct_unknown_git")
        direct_unknown_value = json.loads(direct_unknown.stdout)
        require(
            direct_unknown_value.get("continue") is False
            and "codex-quarantine"
            in direct_unknown_value.get("systemMessage", ""),
            "hook_direct_unknown_git_stop",
        )
        direct_control = run(
            [sys.executable, fixture_hook, "context"],
            stdin=json.dumps(
                {"cwd": str(control), "hook_event_name": "SessionStart"}
            ),
        )
        require(direct_control.returncode == 0, "hook_direct_control")
        require(
            json.loads(direct_control.stdout)["hookSpecificOutput"][
                "hookEventName"
            ]
            == "SessionStart",
            "hook_direct_control_shape",
        )

        link = home / "AIDev/repos/link"
        link.symlink_to(outside, target_is_directory=True)
        write_registry("$HOME/AIDev/repos/link")
        try:
            hook.trusted_roots(home, registry_path=registry_path)
            symlink_rejected = False
        except hook.RegistryError:
            symlink_rejected = True
        require(symlink_rejected, "hook_registry_symlink_escape")
        require(
            hook.zone(unknown, home=home, registry_path=registry_path)
            == "registry_invalid",
            "hook_registry_fail_closed",
        )
        write_registry("$HOME/AIDev/repos/*")
        try:
            hook.trusted_roots(home, registry_path=registry_path)
            wildcard_rejected = False
        except hook.RegistryError:
            wildcard_rejected = True
        require(wildcard_rejected, "hook_registry_wildcard")

    direct_warn = run(
        [sys.executable, ROOT / "codex/hooks/phase5-contract.py", "warn"],
        stdin=json.dumps(
            {
                "cwd": str(ROOT),
                "hook_event_name": "PreToolUse",
                "tool_input": {"command": "brew install fixture"},
                "tool_name": "Bash",
            }
        ),
    )
    require(direct_warn.returncode == 0, "hook_direct_warn")
    require(set(json.loads(direct_warn.stdout)) == {"systemMessage"}, "hook_direct_warn_shape")


def preflight_fixtures():
    preflight = load_module("phase5_preflight", ROOT / "bin/phase5-preflight")
    fixtures = strict_json(FIXTURES)
    require(fixtures["schema"] == 1, "contract_fixture_schema")
    for case in fixtures["configCases"]:
        facts = preflight.top_level_managed_facts(
            case["text"], config_load_ok=case["configLoadOk"]
        )
        require(
            facts["trustedBaseline"] is case["trustedBaseline"],
            "preflight_config_" + case["name"],
        )
    shape = lambda value: isinstance(value, dict) and value.get("ok") is True
    valid = preflight.command_json(
        [sys.executable, "-c", 'import json; print(json.dumps({"ok": True}))'],
        shape,
    )
    require(valid == {"ok": True}, "command_json_positive")
    require(
        preflight.command_json(
            [
                sys.executable,
                "-c",
                'import json, sys; print(json.dumps({"ok": True})); sys.exit(1)',
            ],
            shape,
        )
        is None,
        "command_json_nonzero",
    )
    require(
        preflight.command_json(
            [sys.executable, "-c", 'import json; print(json.dumps({"wrong": True}))'],
            shape,
        )
        is None,
        "command_json_shape",
    )
    manifest = strict_json(ROOT / "manifests/codex-contract.json")
    expected_plugins = preflight.expected_plugin_inventory(manifest)
    expected_observed_plugins = []
    for item in expected_plugins:
        observed = dict(item)
        observed["versionObserved"] = observed.pop("minimumVersion")
        expected_observed_plugins.append(observed)
    expected_mcp = preflight.expected_mcp_inventory(manifest)
    with tempfile.TemporaryDirectory(
        prefix="phase5-inventory-contract-"
    ) as directory:
        fixture_root = Path(directory).resolve()
        fixture_home = fixture_root / "owner"
        fixture_home.mkdir()

        def plugin_rows(owner_home, symlink_first=False):
            installed = []
            for index, item in enumerate(expected_plugins):
                name, marketplace = item["id"].split("@")
                if marketplace == "openai-bundled":
                    marketplace_root = (
                        owner_home
                        / ".codex/.tmp/bundled-marketplaces"
                        / marketplace
                    )
                elif marketplace == "openai-curated":
                    marketplace_root = owner_home / ".codex/.tmp/plugins"
                else:
                    marketplace_root = (
                        owner_home
                        / ".cache/codex-runtimes/codex-primary-runtime/plugins"
                        / marketplace
                    )
                marketplace_root.mkdir(parents=True, exist_ok=True)
                plugin_path = marketplace_root / item["source"]["relativePath"]
                plugin_path.parent.mkdir(parents=True, exist_ok=True)
                if symlink_first and index == 0:
                    outside = owner_home.parent / "symlink-outside"
                    outside.mkdir(exist_ok=True)
                    plugin_path.symlink_to(outside, target_is_directory=True)
                else:
                    plugin_path.mkdir(exist_ok=True)
                row = {
                    "authPolicy": item["approvalPolicyObserved"],
                    "enabled": item["enabled"],
                    "installPolicy": item["installPolicyObserved"],
                    "installed": item["installed"],
                    "marketplaceName": marketplace,
                    "name": name,
                    "pluginId": item["id"],
                    "source": {
                        "path": str(plugin_path),
                        "source": item["source"]["sourceType"],
                    },
                    "version": item["minimumVersion"],
                }
                if item["source"]["marketplaceSourceClass"] != "not-exposed":
                    row["marketplaceSource"] = {
                        "source": str(marketplace_root),
                        "sourceType": "local",
                    }
                installed.append(row)
            return {"available": [], "installed": installed}

        raw_plugins = plugin_rows(fixture_home)
        require(
            preflight.observed_plugin_inventory(
                raw_plugins,
                expected_plugins,
                owner_home=fixture_home,
            )
            == expected_observed_plugins,
            "preflight_plugin_exact",
        )

        higher_numeric = copy.deepcopy(raw_plugins)
        higher_numeric["installed"][0]["version"] = "26.723.12216"
        expected_higher_numeric = copy.deepcopy(expected_observed_plugins)
        expected_higher_numeric[0]["versionObserved"] = "26.723.12216"
        require(
            preflight.observed_plugin_inventory(
                higher_numeric,
                expected_plugins,
                owner_home=fixture_home,
            )
            == expected_higher_numeric,
            "preflight_plugin_higher_numeric",
        )

        opaque_index = next(
            index
            for index, item in enumerate(expected_plugins)
            if preflight.parsed_numeric_version(item["minimumVersion"]) is None
        )
        require(
            preflight.observed_plugin_inventory(
                raw_plugins,
                expected_plugins,
                owner_home=fixture_home,
            )[opaque_index]["versionObserved"]
            == expected_plugins[opaque_index]["minimumVersion"],
            "preflight_plugin_opaque_exact",
        )

        def plugin_rejected(name, mutate):
            value = copy.deepcopy(raw_plugins)
            mutate(value)
            require(
                preflight.observed_plugin_inventory(
                    value,
                    expected_plugins,
                    owner_home=fixture_home,
                )
                is None,
                "preflight_plugin_" + name,
            )

        plugin_rejected(
            "enabled_drift",
            lambda value: value["installed"][0].update({"enabled": False}),
        )
        plugin_rejected(
            "version_drift",
            lambda value: value["installed"][0].update({"version": "drift"}),
        )
        plugin_rejected(
            "lower_numeric_version",
            lambda value: value["installed"][0].update({"version": "26.723.12214"}),
        )
        plugin_rejected(
            "opaque_version_drift",
            lambda value: value["installed"][opaque_index].update(
                {"version": "bd2122cc"}
            ),
        )
        plugin_rejected(
            "malformed_version",
            lambda value: value["installed"][0].update({"version": None}),
        )
        plugin_rejected(
            "source_path_drift",
            lambda value: value["installed"][0]["source"].update(
                {"path": "/tmp/unreviewed-plugin-source"}
            ),
        )
        plugin_rejected(
            "source_type_drift",
            lambda value: value["installed"][0]["source"].update(
                {"source": "unreviewed"}
            ),
        )
        plugin_rejected(
            "marketplace_name_drift",
            lambda value: value["installed"][0].update(
                {"marketplaceName": "unreviewed"}
            ),
        )
        plugin_rejected(
            "marketplace_source_drift",
            lambda value: value["installed"][0]["marketplaceSource"].update(
                {"source": "/tmp/unreviewed-marketplace"}
            ),
        )
        plugin_rejected(
            "marketplace_source_type_drift",
            lambda value: value["installed"][0]["marketplaceSource"].update(
                {"sourceType": "git"}
            ),
        )
        plugin_rejected(
            "path_escape",
            lambda value: value["installed"][0]["source"].update(
                {
                    "path": str(
                        fixture_home
                        / ".codex/.tmp/bundled-marketplaces/openai-bundled"
                        / "../plugins/browser"
                    )
                }
            ),
        )
        plugin_rejected(
            "malformed_extra",
            lambda value: value["installed"].append({"pluginId": "malformed"}),
        )
        plugin_rejected(
            "duplicate",
            lambda value: value["installed"].append(
                copy.deepcopy(value["installed"][0])
            ),
        )
        plugin_rejected(
            "wrong_boolean",
            lambda value: value["installed"][0].update({"enabled": "true"}),
        )
        plugin_rejected(
            "missing_version",
            lambda value: value["installed"][0].pop("version"),
        )
        plugin_rejected(
            "installed_order",
            lambda value: value["installed"].__setitem__(
                slice(0, 2),
                [value["installed"][1], value["installed"][0]],
            ),
        )
        plugin_rejected(
            "missing_id",
            lambda value: value["installed"][0].pop("pluginId"),
        )
        plugin_rejected(
            "installed_false",
            lambda value: value["installed"][0].update({"installed": False}),
        )
        plugin_rejected(
            "unexpected_extra",
            lambda value: value["installed"].append(
                {
                    **copy.deepcopy(value["installed"][0]),
                    "pluginId": "unexpected@fixture",
                }
            ),
        )
        plugin_rejected(
            "available_extra",
            lambda value: value["available"].append(
                {"pluginId": "unexpected"}
            ),
        )
        symlink_home = fixture_root / "symlink-owner"
        symlink_home.mkdir()
        require(
            preflight.observed_plugin_inventory(
                plugin_rows(symlink_home, symlink_first=True),
                expected_plugins,
                owner_home=symlink_home,
            )
            is None,
            "preflight_plugin_symlink_escape",
        )
        nonzero_plugin = preflight.command_json(
            [
                sys.executable,
                "-c",
                "import sys; print("
                + repr(
                    json.dumps(
                        raw_plugins,
                        sort_keys=True,
                        separators=(",", ":"),
                    )
                )
                + "); sys.exit(1)",
            ],
            lambda value: preflight.observed_plugin_inventory(
                value,
                expected_plugins,
                owner_home=fixture_home,
            )
            is not None,
        )
        require(nonzero_plugin is None, "preflight_plugin_nonzero_json")

        fixture_codex_home = fixture_home / ".codex"
        fixture_codex_home.mkdir(exist_ok=True)
        app_resources = fixture_root / "ChatGPT.app/Contents/Resources"
        app_resources.mkdir(parents=True)
        fixture_cli = app_resources / "codex"
        fixture_cli.write_text("#!/bin/sh\nexit 0\n")
        fixture_cli.chmod(0o755)
        node_command = app_resources / "cua_node/bin/node_repl"
        node_command.parent.mkdir(parents=True)
        node_command.write_text("#!/bin/sh\nexit 0\n")
        node_command.chmod(0o755)
        node_modules = app_resources / "cua_node/node_modules"
        node_modules.mkdir()
        node_path = app_resources / "cua_node/node"
        node_path.write_text("fixture\n")
        sky_root = fixture_codex_home / "computer-use"
        sky_path = sky_root / "Codex Computer Use.app"
        sky_path.mkdir(parents=True)
        legacy_sky_path = (
            fixture_home
            / ".codex/plugins/cache/openai-bundled/computer-use"
            / "1.0.1000451"
            / "Codex Computer Use.app"
        )
        legacy_sky_path.mkdir(parents=True)
        outside_sky_path = fixture_root / "outside/Codex Computer Use.app"
        outside_sky_path.mkdir(parents=True)
        nested_sky_path = sky_root / "nested/Codex Computer Use.app"
        nested_sky_path.mkdir(parents=True)
        symlink_target = sky_root / "symlink-target"
        symlink_target.mkdir()
        symlink_sky_path = sky_root / "Symlink Computer Use.app"
        symlink_sky_path.symlink_to(symlink_target, target_is_directory=True)
        file_sky_path = sky_root / "Not A Directory.app"
        file_sky_path.write_text("fixture\n")
        node_env = {
            "BROWSER_USE_AVAILABLE_BACKENDS": "browser,chrome",
            "BROWSER_USE_CODEX_APP_BUILD_FLAVOR": "fixture",
            "BROWSER_USE_CODEX_APP_VERSION": "1.2.3",
            "CODEX_CLI_PATH": str(fixture_cli),
            "CODEX_HOME": str(fixture_codex_home),
            "NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER": "Fixture browser instructions.",
            "NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME": "Fixture chrome instructions.",
            "NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE": "Fixture computer-use instructions.",
            "NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS": "5000",
            "NODE_REPL_NODE_MODULE_DIRS": str(node_modules),
            "NODE_REPL_NODE_PATH": str(node_path),
            "NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S": (
                "a" * 64 + "," + "b" * 64
            ),
            "NODE_REPL_TRUSTED_CODE_PATHS": str(fixture_codex_home),
            "SKY_CUA_SERVICE_PATH": str(sky_path),
        }
        raw_mcp = [
            {
                "auth_status": "unsupported",
                "disabled_reason": None,
                "enabled": False,
                "name": "computer-use",
                "startup_timeout_sec": None,
                "tool_timeout_sec": None,
                "transport": {
                    "args": ["mcp"],
                    "command": (
                        "./Codex Computer Use.app/Contents/SharedSupport/"
                        "SkyComputerUseClient.app/Contents/MacOS/"
                        "SkyComputerUseClient"
                    ),
                    "cwd": ".",
                    "env": None,
                    "env_vars": [],
                    "type": "stdio",
                },
            },
            {
                "auth_status": "unsupported",
                "disabled_reason": None,
                "enabled": True,
                "name": "node_repl",
                "startup_timeout_sec": 120.0,
                "tool_timeout_sec": None,
                "transport": {
                    "args": [],
                    "command": str(node_command),
                    "cwd": None,
                    "env": node_env,
                    "env_vars": [],
                    "type": "stdio",
                },
            },
            {
                "auth_status": "unsupported",
                "disabled_reason": None,
                "enabled": True,
                "name": "openaiDeveloperDocs",
                "startup_timeout_sec": None,
                "tool_timeout_sec": None,
                "transport": {
                    "bearer_token_env_var": None,
                    "env_http_headers": None,
                    "http_headers": None,
                    "type": "streamable_http",
                    "url": "https://developers.openai.com/mcp",
                },
            },
        ]
        mcp_context = {
            "owner_home": fixture_home,
            "app_resources": app_resources,
            "cli_path": fixture_cli,
        }
        require(
            preflight.observed_mcp_inventory(
                raw_mcp,
                expected_mcp,
                **mcp_context,
            )
            == expected_mcp,
            "preflight_mcp_exact",
        )

        def mcp_rejected(name, mutate):
            value = copy.deepcopy(raw_mcp)
            mutate(value)
            require(
                preflight.observed_mcp_inventory(
                    value,
                    expected_mcp,
                    **mcp_context,
                )
                is None,
                "preflight_mcp_" + name,
            )

        def drift_env_key(value):
            environment = value[1]["transport"]["env"]
            environment["UNREVIEWED_ENV"] = environment.pop(
                "BROWSER_USE_CODEX_APP_BUILD_FLAVOR"
            )

        mcp_rejected(
            "enabled_drift",
            lambda value: value[0].update(
                {"enabled": not value[0]["enabled"]}
            ),
        )
        reordered_mcp = copy.deepcopy(raw_mcp)
        reordered_mcp[0], reordered_mcp[1] = reordered_mcp[1], reordered_mcp[0]
        require(
            preflight.observed_mcp_inventory(
                reordered_mcp,
                expected_mcp,
                **mcp_context,
            )
            == expected_mcp,
            "preflight_mcp_raw_order_normalized",
        )
        mcp_rejected(
            "command_drift",
            lambda value: value[0]["transport"].update(
                {"command": "/tmp/unreviewed-mcp-launcher"}
            ),
        )
        mcp_rejected(
            "args_drift",
            lambda value: value[0]["transport"].update({"args": ["unreviewed"]}),
        )
        mcp_rejected(
            "cwd_drift",
            lambda value: value[0]["transport"].update({"cwd": "/tmp"}),
        )
        mcp_rejected("env_key_drift", drift_env_key)
        mcp_rejected(
            "env_value_class_drift",
            lambda value: value[1]["transport"]["env"].update(
                {"CODEX_HOME": str(fixture_root / "unreviewed")}
            ),
        )
        mcp_rejected(
            "sky_legacy_plugin_cache",
            lambda value: value[1]["transport"]["env"].update(
                {"SKY_CUA_SERVICE_PATH": str(legacy_sky_path)}
            ),
        )
        mcp_rejected(
            "sky_outside_owner_home",
            lambda value: value[1]["transport"]["env"].update(
                {"SKY_CUA_SERVICE_PATH": str(outside_sky_path)}
            ),
        )
        mcp_rejected(
            "sky_nested_component",
            lambda value: value[1]["transport"]["env"].update(
                {"SKY_CUA_SERVICE_PATH": str(nested_sky_path)}
            ),
        )
        mcp_rejected(
            "sky_symlink",
            lambda value: value[1]["transport"]["env"].update(
                {"SKY_CUA_SERVICE_PATH": str(symlink_sky_path)}
            ),
        )
        mcp_rejected(
            "sky_non_directory",
            lambda value: value[1]["transport"]["env"].update(
                {"SKY_CUA_SERVICE_PATH": str(file_sky_path)}
            ),
        )
        mcp_rejected(
            "forwarded_env_drift",
            lambda value: value[1]["transport"].update(
                {"env_vars": ["UNREVIEWED_ENV"]}
            ),
        )
        mcp_rejected(
            "http_url_drift",
            lambda value: value[2]["transport"].update(
                {"url": "https://example.invalid/mcp"}
            ),
        )
        mcp_rejected(
            "http_bearer_drift",
            lambda value: value[2]["transport"].update(
                {"bearer_token_env_var": "TOKEN_ENV"}
            ),
        )
        mcp_rejected(
            "http_header_drift",
            lambda value: value[2]["transport"].update({"http_headers": {}}),
        )
        mcp_rejected(
            "http_env_header_drift",
            lambda value: value[2]["transport"].update(
                {"env_http_headers": {}}
            ),
        )
        mcp_rejected(
            "startup_timeout_drift",
            lambda value: value[1].update({"startup_timeout_sec": 121.0}),
        )
        mcp_rejected(
            "tool_timeout_drift",
            lambda value: value[1].update({"tool_timeout_sec": 60.0}),
        )
        mcp_rejected(
            "auth_status_drift",
            lambda value: value[1].update({"auth_status": "oauth"}),
        )
        mcp_rejected(
            "transport_type_drift",
            lambda value: value[1]["transport"].update(
                {"type": "streamable_http"}
            ),
        )
        mcp_rejected(
            "malformed_extra",
            lambda value: value.append({"name": "malformed"}),
        )
        mcp_rejected(
            "duplicate",
            lambda value: value.append(copy.deepcopy(value[0])),
        )
        mcp_rejected(
            "wrong_boolean",
            lambda value: value[0].update({"enabled": 1}),
        )
        mcp_rejected("missing_id", lambda value: value[0].pop("name"))
        mcp_rejected(
            "unexpected_extra",
            lambda value: value.append(
                {**copy.deepcopy(value[0]), "name": "unexpected-mcp"}
            ),
        )
        mcp_rejected(
            "transport_shape",
            lambda value: value[0]["transport"].update({"unexpected": True}),
        )
        nonzero_mcp = preflight.command_json(
            [
                sys.executable,
                "-c",
                "import sys; print("
                + repr(
                    json.dumps(
                        raw_mcp,
                        sort_keys=True,
                        separators=(",", ":"),
                    )
                )
                + "); sys.exit(1)",
            ],
            lambda value: preflight.observed_mcp_inventory(
                value,
                expected_mcp,
                **mcp_context,
            )
            is not None,
        )
        require(nonzero_mcp is None, "preflight_mcp_nonzero_json")

    def forced_doctor_report(overall, config_load):
        value = preflight.collect(
            {
                "checks": {
                    "config.load": {
                        "status": config_load,
                    },
                },
                "overallStatus": overall,
            }
        )
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
        )

    warning_overall = forced_doctor_report("warning", "ok")
    fail_overall = forced_doctor_report("fail", "ok")
    require(
        warning_overall == fail_overall,
        "preflight_doctor_overall_volatility",
    )
    forced_report = json.loads(warning_overall)
    require(
        forced_report["cli"]["configLoadObserved"] == "ok"
        and "doctorOverallObserved" not in forced_report["cli"]
        and forced_report["checks"]["activeConfigLoads"] is True
        and forced_report["overall"]
        == "PHASE5_PREPARATION_PREFLIGHT_PASS",
        "preflight_config_load_observation",
    )
    failed_config = json.loads(
        forced_doctor_report("warning", "fail")
    )
    require(
        failed_config["cli"]["configLoadObserved"] == "fail"
        and failed_config["checks"]["activeConfigLoads"] is False
        and failed_config["checks"]["trustedBaselinePreserved"] is False
        and failed_config["overall"]
        == "PHASE5_PREPARATION_PREFLIGHT_FAIL",
        "preflight_config_load_fail_closed",
    )

    first = checked([sys.executable, ROOT / "bin/phase5-preflight", "--json"])
    second = checked([sys.executable, ROOT / "bin/phase5-preflight", "--json"])
    require(first == second, "preflight_byte_identity")
    report = json.loads(first)
    require(report["overall"] == "PHASE5_PREPARATION_PREFLIGHT_PASS", "preflight_live")
    require(
        report["checks"]["installedPluginsExact"] is True
        and report["checks"]["installedMcpExact"] is True
        and report["checks"]["trustedBaselinePreserved"] is True,
        "preflight_exact_checks",
    )
    require(
        report["cli"]["configLoadObserved"] == "ok"
        and "doctorOverallObserved" not in report["cli"],
        "preflight_deterministic_doctor_surface",
    )
    require(
        "/" + "Users/" not in first
        and "PHASE5_SECRET_SENTINEL" not in first,
        "preflight_redaction",
    )
    with tempfile.TemporaryDirectory(prefix="phase5-preflight-path-") as directory:
        root = Path(directory).resolve()
        fake_bin = root / "bin"
        fake_bin.mkdir()
        marker = root / "fake-codex-executed"
        fake_codex = fake_bin / "codex"
        fake_codex.write_text(
            "#!/usr/bin/python3\n"
            "from pathlib import Path\n"
            + "Path("
            + repr(str(marker))
            + ").write_text('executed')\n"
        )
        fake_codex.chmod(0o755)
        environment = os.environ.copy()
        environment.update(
            {
                "CODEX_HOME": str(root / "ambient-codex-home"),
                "PATH": str(fake_bin) + ":/usr/bin:/bin",
                "PHASE5_SECRET_SENTINEL": "must-not-reach-preflight-cli",
            }
        )
        fixed = checked(
            [sys.executable, ROOT / "bin/phase5-preflight", "--json"],
            environment=environment,
        )
        require(
            json.loads(fixed)["overall"] == "PHASE5_PREPARATION_PREFLIGHT_PASS"
            and not marker.exists()
            and "PHASE5_SECRET_SENTINEL" not in fixed,
            "preflight_fake_path",
        )


def strict_config_probe(config_home, environment):
    missing_schema = Path(config_home) / "must-not-exist.json"
    require(not missing_schema.exists(), "strict_probe_schema_exists")
    result = run(
        [
            CODEX,
            "--strict-config",
            "exec",
            "--ephemeral",
            "--output-schema",
            missing_schema,
            "--",
            "phase5-static-config-parse",
        ],
        cwd=Path(config_home),
        environment=environment,
        stdin="",
        start_new_session=True,
    )
    return (
        result.returncode != 0
        and "Failed to read output schema file " in result.stdout
        and str(missing_schema) in result.stdout
        and "Error loading config.toml:" not in result.stdout
    )


def loopback_network_probe(base, environment):
    server_code = (
        "import socket\n"
        "server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n"
        "server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n"
        "server.bind(('127.0.0.1', 0))\n"
        "server.listen(4)\n"
        "print(server.getsockname()[1], flush=True)\n"
        "while True:\n"
        "    connection, _ = server.accept()\n"
        "    with connection:\n"
        "        connection.recv(4096)\n"
        "        connection.sendall("
        "b'HTTP/1.1 200 OK\\r\\nContent-Length: 16\\r\\nConnection: close\\r\\n"
        "\\r\\nphase5-loopback\\n')\n"
    )
    server_environment = {
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        "PYTHONUNBUFFERED": "1",
    }
    process = subprocess.Popen(
        [sys.executable, "-c", server_code],
        env=server_environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    port = None
    try:
        require(process.stdout is not None, "loopback_stdout")
        selector = selectors.DefaultSelector()
        try:
            selector.register(process.stdout, selectors.EVENT_READ)
            require(bool(selector.select(timeout=5)), "loopback_start_timeout")
        finally:
            selector.close()
        line = process.stdout.readline().strip()
        require(re.fullmatch(r"[0-9]{1,5}", line) is not None, "loopback_port_shape")
        port = int(line)
        require(1 <= port <= 65535 and process.poll() is None, "loopback_start")
        url = "http://127.0.0.1:" + str(port) + "/phase5"
        direct_environment = dict(environment)
        direct_environment.pop("PHASE5_SECRET_SENTINEL", None)
        direct = run(
            [
                "/usr/bin/curl",
                "--noproxy",
                "*",
                "-fsS",
                "--max-time",
                "2",
                url,
            ],
            environment=direct_environment,
        )
        require(
            direct.returncode == 0 and direct.stdout == "phase5-loopback\n",
            "loopback_control",
        )
        denied = run(
            [
                *base,
                "/usr/bin/curl",
                "--noproxy",
                "*",
                "-fsS",
                "--max-time",
                "2",
                url,
            ],
            environment=environment,
            start_new_session=True,
        )
        require(denied.returncode != 0, "sandbox_network")
    finally:
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5)
    require(process.poll() is not None, "loopback_process_remains")
    require(
        run(["/bin/ps", "-p", str(process.pid)], environment=server_environment).returncode
        != 0,
        "loopback_pid_remains",
    )
    require(port is not None, "loopback_port_missing")
    connection = None
    try:
        connection = socket.create_connection(("127.0.0.1", port), timeout=0.2)
        listener_closed = False
    except OSError:
        listener_closed = True
    finally:
        if connection is not None:
            connection.close()
    require(listener_closed, "loopback_listener_remains")


def capability_probe():
    require(
        CODEX.is_file()
        and not CODEX.is_symlink()
        and os.access(CODEX, os.X_OK)
        and CODEX.resolve() == CODEX,
        "canonical_codex_missing",
    )
    observed = checked([CODEX, "--version"]).strip()
    match = re.fullmatch(r"codex-cli (\d+)\.(\d+)\.(\d+)(?:-alpha\.(\d+)(?:\.(\d+))?)?", observed)
    require(match is not None and (int(match.group(1)), int(match.group(2)), int(match.group(3))) >= (0, 145, 0),
            "canonical_codex_version")
    with tempfile.TemporaryDirectory(prefix="phase5-codex-home-") as directory:
        root = Path(directory).resolve()
        home = root / "codex-home"
        user_home = root / "user-home"
        workspace = root / "workspace"
        home.mkdir()
        user_home.mkdir()
        workspace.mkdir()
        shutil.copyfile(
            ROOT / "codex/quarantine.config.toml",
            home / "quarantine.config.toml",
        )
        (workspace / "visible.txt").write_text("visible\n")
        (workspace / ".env").write_text("SECRET=denied\n")
        outside = root / "outside.txt"
        outside.write_text("outside\n")
        environment = {
            "CODEX_HOME": str(home),
            "HOME": str(user_home),
            "LANG": "C",
            "LC_ALL": "C",
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "PHASE5_SECRET_SENTINEL": "must-not-inherit",
            "SHELL": "/bin/zsh",
        }
        for source in (
            "codex/trusted-intent.toml",
            "codex/quarantine.config.toml",
        ):
            strict_home = root / ("strict-" + Path(source).stem)
            strict_home.mkdir()
            shutil.copyfile(ROOT / source, strict_home / "config.toml")
            strict_environment = dict(environment)
            strict_environment["CODEX_HOME"] = str(strict_home)
            require(
                strict_config_probe(strict_home, strict_environment),
                "strict_config_positive_" + Path(source).stem,
            )
        base = [
            CODEX,
            "sandbox",
            "--profile",
            "quarantine",
            "--permission-profile",
            "quarantine",
            "--cd",
            workspace,
        ]
        require(
            run([*base, "/bin/cat", "visible.txt"], environment=environment,
                start_new_session=True).returncode
            == 0,
            "sandbox_workspace_read",
        )
        require(
            run([*base, "/bin/cat", str(outside)], environment=environment,
                start_new_session=True).returncode
            != 0,
            "sandbox_outside_read",
        )
        require(
            run([*base, "/bin/cat", ".env"], environment=environment,
                start_new_session=True).returncode
            != 0,
            "sandbox_secret_read",
        )
        env_result = run([*base, "/usr/bin/env"], environment=environment,
                         start_new_session=True)
        require(
            env_result.returncode == 0
            and "PHASE5_SECRET_SENTINEL" not in env_result.stdout,
            "sandbox_environment",
        )
        require(
            run(
                [*base, "/bin/sh", "-c", "command -v aid-admin"],
                environment=environment,
                start_new_session=True,
            ).returncode
            != 0,
            "sandbox_aid_admin",
        )
        loopback_network_probe(base, environment)
        bad_home = root / "bad-home"
        bad_home.mkdir()
        (bad_home / "config.toml").write_text("unknown_phase5_key = true\n")
        bad_environment = dict(environment)
        bad_environment["CODEX_HOME"] = str(bad_home)
        require(
            not strict_config_probe(bad_home, bad_environment),
            "strict_config_negative",
        )


def synthetic_commit(directory, message, identity, allow_empty=False):
    environment = {
        "GIT_AUTHOR_EMAIL": identity[1],
        "GIT_AUTHOR_NAME": identity[0],
        "GIT_COMMITTER_EMAIL": identity[3],
        "GIT_COMMITTER_NAME": identity[2],
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_NOSYSTEM": "1",
        "HOME": str(directory),
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
    }
    arguments = [*GIT, "commit", "-q", "--no-gpg-sign", "-m", message]
    if allow_empty:
        arguments.insert(-2, "--allow-empty")
    checked(arguments, cwd=directory, environment=environment)


def commit_synthetic_acceptance(
    directory,
    reviewed_head,
    *,
    value=None,
    raw=None,
    include=True,
    extra=False,
    identity=COORDINATOR_METADATA,
    wrong_parent=False,
):
    checked([*GIT, "checkout", "-q", "-b", "main"], cwd=directory)
    if wrong_parent:
        synthetic_commit(directory, "Intervening fixture", METADATA, allow_empty=True)
    paths = []
    if include:
        acceptance_path = directory / ACCEPTANCE_EVIDENCE
        acceptance_path.parent.mkdir(parents=True, exist_ok=True)
        acceptance_path.write_text(
            raw
            if raw is not None
            else json.dumps(
                value or acceptance_value(reviewed_head),
                sort_keys=True,
                separators=(",", ":"),
            )
            + "\n"
        )
        paths.append(acceptance_path.relative_to(directory))
    if extra:
        extra_path = directory / "phase5-acceptance-extra"
        extra_path.write_text("unexpected\n")
        paths.append(extra_path.relative_to(directory))
    if paths:
        checked([*GIT, "add", "--", *paths], cwd=directory)
    synthetic_commit(
        directory,
        "Accept Phase 5 preparation",
        identity,
        allow_empty=not paths,
    )


def integration_state_matrix(reviewed_head):
    workspace = Path(tempfile.mkdtemp(prefix="phase5-integration-matrix-"))
    negative_cases = 0
    current_head = git("rev-parse", "HEAD")

    def clone(name):
        destination = workspace / name
        checked(
            [
                *GIT,
                "clone",
                "--no-local",
                "--quiet",
                "--branch",
                BRANCH,
                ROOT,
                destination,
            ]
        )
        checked([*GIT, "remote", "remove", "origin"], cwd=destination)
        require(git_at(destination, "remote") == "", "synthetic_clone_remote")
        require(
            git_at(destination, "rev-parse", "HEAD") == current_head,
            "synthetic_clone_correction_head",
        )
        return destination

    def validator(directory):
        return run(
            [directory / "bin/check-phase5-prep", "--git-only", "--json"],
            cwd=directory,
        )

    def rejected(action, name):
        nonlocal negative_cases
        try:
            action()
        except (
            RuntimeError,
            SystemExit,
            IndexError,
            KeyError,
            TypeError,
            ValueError,
        ):
            negative_cases += 1
            return
        raise RuntimeError("integration_negative_accepted_" + name)

    def rejected_reason(action, reason, name):
        nonlocal negative_cases
        try:
            action()
        except (
            RuntimeError,
            SystemExit,
            IndexError,
            KeyError,
            TypeError,
            ValueError,
        ) as error:
            require(str(error) == reason, "unstable_reason_" + name)
            negative_cases += 1
            return
        raise RuntimeError("integration_negative_accepted_" + name)

    def validator_rejected(directory, reason, name):
        nonlocal negative_cases
        result = validator(directory)
        value = json.loads(result.stdout)
        require(
            result.returncode != 0
            and value
            == {
                "error": reason,
                "mode": "git-only",
                "schema": 1,
                "verdict": "FAIL",
            },
            "unstable_validator_reason_" + name,
        )
        negative_cases += 1

    def checkout_main(directory, commit=current_head):
        checked(
            [*GIT, "checkout", "-q", "-B", "main", commit],
            cwd=directory,
        )

    def commit_path_drift(name, relative, *, transform=None, delete=False):
        directory = clone(name)
        checkout_main(directory)
        path = directory / relative
        if delete:
            path.unlink()
        elif transform is None:
            if relative.startswith("bin/"):
                path.write_text(
                    path.read_text() + "# synthetic harmless drift\n"
                )
            else:
                text = path.read_text()
                require('"schema": 1' in text, "json_drift_fixture")
                path.write_text(
                    text.replace('"schema": 1', '"schema": 2', 1)
                )
        else:
            path.write_text(transform(path.read_text()))
        checked([*GIT, "add", "-A", "--", relative], cwd=directory)
        synthetic_commit(directory, "Synthetic protected descendant drift", METADATA)
        validator_rejected(
            directory,
            "protected_descendant_drift:" + relative,
            name,
        )
        return directory

    def write_current_implementation(directory, *, extra=False):
        for relative in sorted(DESCENDANT_BASELINE_IMPLEMENTATION_SCOPE):
            target = directory / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes((ROOT / relative).read_bytes())
        paths = sorted(DESCENDANT_BASELINE_IMPLEMENTATION_SCOPE)
        if extra:
            extra_path = directory / "descendant-pair-extra"
            extra_path.write_text("unexpected\n")
            paths.append("descendant-pair-extra")
        checked([*GIT, "add", "--", *paths], cwd=directory)

    def commit_synthetic_implementation(
        directory, *, identity=METADATA, extra=False
    ):
        write_current_implementation(directory, extra=extra)
        synthetic_commit(
            directory,
            "Synthetic descendant baseline implementation",
            identity,
        )
        return git_at(directory, "rev-parse", "HEAD")

    def commit_synthetic_evidence(
        directory,
        implementation,
        *,
        value=None,
        raw=None,
        identity=METADATA,
        extra=False,
    ):
        evidence = directory / DESCENDANT_BASELINE_EVIDENCE
        evidence.parent.mkdir(parents=True, exist_ok=True)
        if raw is None:
            candidate_value = copy.deepcopy(
                value
                if value is not None
                else strict_json(ROOT / DESCENDANT_BASELINE_EVIDENCE)
            )
            candidate_value["correction"]["implementationCommit"] = implementation
            candidate_value["correction"]["implementationFilesSHA256"] = (
                implementation_file_hashes(directory, implementation)
            )
            evidence.write_text(
                json.dumps(candidate_value, indent=2, sort_keys=True) + "\n"
            )
        else:
            evidence.write_text(raw)
        paths = [DESCENDANT_BASELINE_EVIDENCE]
        if extra:
            extra_path = directory / "descendant-evidence-extra"
            extra_path.write_text("unexpected\n")
            paths.append("descendant-evidence-extra")
        checked([*GIT, "add", "--", *paths], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic descendant baseline evidence",
            identity,
        )
        return git_at(directory, "rev-parse", "HEAD")

    def candidate(
        name,
        *,
        value=None,
        raw=None,
        include=True,
        extra=False,
        identity=COORDINATOR_METADATA,
        wrong_parent=False,
    ):
        directory = clone(name)
        checked(
            [
                *GIT,
                "checkout",
                "-q",
                "-B",
                "fixture",
                ACCEPTED_REVIEWED_HEAD,
            ],
            cwd=directory,
        )
        if wrong_parent:
            synthetic_commit(
                directory, "Intervening fixture", METADATA, allow_empty=True)
        paths = []
        if include:
            acceptance_path = directory / ACCEPTANCE_EVIDENCE
            acceptance_path.parent.mkdir(parents=True, exist_ok=True)
            acceptance_path.write_text(
                raw
                if raw is not None
                else json.dumps(
                    value or acceptance_value(ACCEPTED_REVIEWED_HEAD),
                    sort_keys=True,
                    separators=(",", ":"),
                )
                + "\n"
            )
            paths.append(acceptance_path.relative_to(directory))
        if extra:
            extra_path = directory / "phase5-acceptance-extra"
            extra_path.write_text("unexpected\n")
            paths.append(extra_path.relative_to(directory))
        if paths:
            checked([*GIT, "add", "--", *paths], cwd=directory)
        synthetic_commit(
            directory,
            "Synthetic Phase 5 acceptance",
            identity,
            allow_empty=not paths,
        )
        return directory, git_at(directory, "rev-parse", "HEAD")

    try:
        review = clone("review")
        review_result = validator(review)
        review_value = json.loads(review_result.stdout)
        require(
            review_result.returncode == 0
            and review_value["repositoryState"] == "correction_review"
            and review_value["reviewedTaskHead"] == reviewed_head
            and review_value["marker"] == DESCENDANT_BASELINE_MARKER
            and review_value["verdict"] == DESCENDANT_BASELINE_VERDICT,
            "synthetic_review_rejected",
        )

        original = clone("original-acceptance")
        validate_phase5_acceptance_object(original, ACCEPTANCE_COMMIT)
        checked(
            [*GIT, "checkout", "-q", "-B", "main", ACCEPTANCE_COMMIT],
            cwd=original,
        )
        validate_phase5_descendant(original)
        original_result = validator(original)
        require(
            original_result.returncode == 0
            and json.loads(original_result.stdout)["verdict"]
            == ACCEPTED_VERDICT,
            "historical_a192_rejected",
        )

        accepted = clone("accepted-main-descendant")
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=accepted)
        accepted_result = validator(accepted)
        accepted_value = json.loads(accepted_result.stdout)
        require(
            accepted_result.returncode == 0
            and accepted_value["repositoryState"] == "integrated_main"
            and accepted_value["reviewedTaskHead"] == ACCEPTED_REVIEWED_HEAD
            and accepted_value["verdict"] == ACCEPTED_VERDICT
            and accepted_value["phase5ApplyAuthorized"] is False
            and accepted_value["phase5PassClaimed"] is False
            and accepted_value["phase6Authorized"] is False,
            "synthetic_integrated_rejected",
        )
        first_unprotected = accepted / "notes/phase5-descendant-one.txt"
        first_unprotected.parent.mkdir(parents=True, exist_ok=True)
        first_unprotected.write_text("unprotected descendant one\n")
        checked(
            [*GIT, "add", "--", first_unprotected.relative_to(accepted)],
            cwd=accepted,
        )
        synthetic_commit(
            accepted, "Future Phase 5 descendant one", METADATA)
        require(validator(accepted).returncode == 0,
                "one_main_descendant_rejected")
        second_unprotected = accepted / "notes/phase5-descendant-two.txt"
        second_unprotected.write_text("unprotected descendant two\n")
        checked(
            [*GIT, "add", "--", second_unprotected.relative_to(accepted)],
            cwd=accepted,
        )
        synthetic_commit(
            accepted, "Future Phase 5 descendant two", METADATA)
        require(validator(accepted).returncode == 0,
                "two_main_descendants_rejected")

        wrong_branch = clone("wrong-branch")
        checked([*GIT, "checkout", "-q", "-b", "topic"], cwd=wrong_branch)
        validator_rejected(wrong_branch, "unexpected_branch", "wrong-branch")

        detached = clone("detached")
        checked([*GIT, "checkout", "-q", "--detach"], cwd=detached)
        validator_rejected(detached, "unexpected_branch", "detached")

        dirty = clone("dirty")
        (dirty / "dirty-fixture").write_text("dirty\n")
        validator_rejected(dirty, "dirty_worktree", "dirty")

        wrong_parent, wrong_parent_commit = candidate(
            "wrong-parent", wrong_parent=True)
        rejected(
            lambda: validate_phase5_acceptance_object(
                wrong_parent, wrong_parent_commit),
            "wrong-parent",
        )
        extra, extra_commit = candidate("extra-file", extra=True)
        rejected(
            lambda: validate_phase5_acceptance_object(extra, extra_commit),
            "extra-file",
        )
        malformed, malformed_commit = candidate(
            "malformed", raw='{"schema":\n')
        rejected(
            lambda: validate_phase5_acceptance_object(
                malformed, malformed_commit),
            "malformed",
        )
        wrong_head, wrong_head_commit = candidate(
            "wrong-reviewed-head",
            value=acceptance_value(
                ACCEPTED_REVIEWED_HEAD, reviewedTaskHead="0" * 40),
        )
        rejected(
            lambda: validate_phase5_acceptance_object(
                wrong_head, wrong_head_commit),
            "wrong-reviewed-head",
        )
        wrong_metadata, wrong_metadata_commit = candidate(
            "wrong-metadata", identity=METADATA)
        rejected(
            lambda: validate_phase5_acceptance_object(
                wrong_metadata, wrong_metadata_commit),
            "wrong-metadata",
        )
        missing, missing_commit = candidate(
            "missing-acceptance", include=False)
        rejected(
            lambda: validate_phase5_acceptance_object(missing, missing_commit),
            "missing-acceptance",
        )
        apply_authorized, apply_authorized_commit = candidate(
            "apply-authorized",
            value=acceptance_value(
                ACCEPTED_REVIEWED_HEAD, phase5ApplyAuthorized=True),
        )
        rejected(
            lambda: validate_phase5_acceptance_object(
                apply_authorized, apply_authorized_commit),
            "apply-authorized",
        )

        nonancestor = clone("nonancestor")
        rejected_reason(
            lambda: validate_phase5_descendant(
                nonancestor, ACCEPTED_REVIEWED_HEAD),
            "acceptance_commit_not_ancestor",
            "nonancestor",
        )

        merged = clone("merge-descendant")
        checked([*GIT, "checkout", "-q", "-B", "main"], cwd=merged)
        checked([*GIT, "checkout", "-q", "-b", "side"], cwd=merged)
        synthetic_commit(merged, "Side descendant", METADATA, allow_empty=True)
        checked([*GIT, "checkout", "-q", "main"], cwd=merged)
        synthetic_commit(merged, "Main descendant", METADATA, allow_empty=True)
        checked(
            [*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"],
            cwd=merged,
            environment={
                "GIT_AUTHOR_EMAIL": METADATA[1],
                "GIT_AUTHOR_NAME": METADATA[0],
                "GIT_COMMITTER_EMAIL": METADATA[3],
                "GIT_COMMITTER_NAME": METADATA[2],
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_CONFIG_NOSYSTEM": "1",
                "HOME": str(merged),
                "LANG": "C",
                "LC_ALL": "C",
                "PATH": "/usr/bin:/bin",
            },
        )
        validator_rejected(
            merged,
            "accepted_descendant_merge",
            "merge-descendant",
        )

        def flip_accepted_state(text):
            before = '"phase5PassClaimed": false'
            require(before in text, "compatibility_flip_fixture")
            return text.replace(
                before, '"phase5PassClaimed": true', 1
            )

        commit_path_drift(
            "compatibility-evidence-tamper",
            COMPATIBILITY_EVIDENCE,
            transform=flip_accepted_state,
        )
        commit_path_drift(
            "followup-evidence-tamper",
            DESCENDANT_BASELINE_EVIDENCE,
        )
        commit_path_drift(
            "followup-evidence-delete",
            DESCENDANT_BASELINE_EVIDENCE,
            delete=True,
        )
        for name, relative in (
            ("phase5-validator-drift", "bin/check-phase5-prep"),
            ("phase4-validator-drift", "bin/check-phase4-final-probes"),
            ("phase4-doctor-drift", "bin/phase4-final-doctor"),
            ("phase4-acceptance-drift", "evidence/phase-4/acceptance.json"),
            ("phase5-acceptance-drift", ACCEPTANCE_EVIDENCE),
            ("protected-contract-drift", "manifests/codex-contract.json"),
        ):
            commit_path_drift(name, relative)

        omitted = clone("pair-omitted")
        checkout_main(omitted, FIRST_COMPATIBILITY_EVIDENCE_COMMIT)
        synthetic_commit(
            omitted, "Omitted pair placeholder one", METADATA, allow_empty=True
        )
        synthetic_commit(
            omitted, "Omitted pair placeholder two", METADATA, allow_empty=True
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(omitted),
            "descendant_implementation_scope",
            "pair-omitted",
        )

        reordered = clone("pair-reordered")
        checkout_main(reordered, FIRST_COMPATIBILITY_EVIDENCE_COMMIT)
        reordered_evidence = reordered / DESCENDANT_BASELINE_EVIDENCE
        reordered_evidence.parent.mkdir(parents=True, exist_ok=True)
        reordered_evidence.write_bytes(
            (ROOT / DESCENDANT_BASELINE_EVIDENCE).read_bytes()
        )
        checked(
            [*GIT, "add", "--", DESCENDANT_BASELINE_EVIDENCE],
            cwd=reordered,
        )
        synthetic_commit(
            reordered, "Reordered evidence first", METADATA
        )
        write_current_implementation(reordered)
        synthetic_commit(
            reordered, "Reordered implementation second", METADATA
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(reordered),
            "descendant_implementation_scope",
            "pair-reordered",
        )

        misparented = clone("pair-misparented")
        checkout_main(misparented, FIRST_COMPATIBILITY_EVIDENCE_COMMIT)
        synthetic_commit(
            misparented,
            "Intervening pair parent",
            METADATA,
            allow_empty=True,
        )
        misparented_implementation = commit_synthetic_implementation(
            misparented
        )
        commit_synthetic_evidence(
            misparented, misparented_implementation
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(misparented),
            "descendant_implementation_scope",
            "pair-misparented",
        )

        multifile = clone("pair-multifile-implementation")
        checkout_main(multifile, FIRST_COMPATIBILITY_EVIDENCE_COMMIT)
        multifile_implementation = commit_synthetic_implementation(
            multifile, extra=True
        )
        commit_synthetic_evidence(multifile, multifile_implementation)
        rejected_reason(
            lambda: validate_descendant_baseline_pair(multifile),
            "descendant_implementation_scope",
            "pair-multifile-implementation",
        )

        evidence_multifile = clone("pair-multifile-evidence")
        checkout_main(
            evidence_multifile, FIRST_COMPATIBILITY_EVIDENCE_COMMIT
