            evidence_multifile
        )
        commit_synthetic_evidence(
            evidence_multifile,
            evidence_multifile_implementation,
            extra=True,
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(evidence_multifile),
            "descendant_evidence_scope",
            "pair-multifile-evidence",
        )

        pair_metadata = clone("pair-wrong-metadata")
        checkout_main(pair_metadata, FIRST_COMPATIBILITY_EVIDENCE_COMMIT)
        pair_metadata_implementation = commit_synthetic_implementation(
            pair_metadata, identity=COORDINATOR_METADATA
        )
        commit_synthetic_evidence(
            pair_metadata, pair_metadata_implementation
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(pair_metadata),
            "descendant_implementation_metadata",
            "pair-wrong-metadata",
        )

        missing_evidence = clone("pair-missing-evidence")
        checkout_main(
            missing_evidence, FIRST_COMPATIBILITY_EVIDENCE_COMMIT
        )
        commit_synthetic_implementation(missing_evidence)
        rejected_reason(
            lambda: validate_descendant_baseline_pair(missing_evidence),
            "descendant_pair_commit_count",
            "pair-missing-evidence",
        )

        wrong_record = clone("pair-wrong-record")
        checkout_main(wrong_record, FIRST_COMPATIBILITY_EVIDENCE_COMMIT)
        wrong_record_implementation = commit_synthetic_implementation(
            wrong_record
        )
        wrong_record_value = copy.deepcopy(
            strict_json(ROOT / DESCENDANT_BASELINE_EVIDENCE)
        )
        wrong_record_value["gate"]["phase5PassClaimed"] = True
        commit_synthetic_evidence(
            wrong_record,
            wrong_record_implementation,
            value=wrong_record_value,
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(wrong_record),
            "descendant_evidence_gate",
            "pair-wrong-record",
        )

        malformed_evidence = clone("pair-malformed-evidence")
        checkout_main(
            malformed_evidence, FIRST_COMPATIBILITY_EVIDENCE_COMMIT
        )
        malformed_implementation = commit_synthetic_implementation(
            malformed_evidence
        )
        commit_synthetic_evidence(
            malformed_evidence,
            malformed_implementation,
            raw='{"schema":\n',
        )
        rejected_reason(
            lambda: validate_descendant_baseline_pair(
                malformed_evidence
            ),
            "descendant_evidence_json",
            "pair-malformed-evidence",
        )

        return {
            "acceptedAndDescendantPositive": 4,
            "cleanNoOriginCorrectionReview": True,
            "cleanNoOriginMainDescendant": True,
            "negativeCases": negative_cases,
            "correctionReviewPositive": 1,
        }
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def validate_historical_evidence():
    value = strict_json(ROOT / HISTORICAL_EVIDENCE)
    require(
        value["base"] == BASE
        and value["branch"] == BRANCH
        and value["implementationCommit"] == ORIGINAL_IMPLEMENTATION,
        "historical_evidence_binding",
    )
    require(
        value["gate"]["marker"] == MARKER
        and value["gate"]["maximumVerdict"] == VERDICT
        and value["gate"]["applyAuthorized"] is False,
        "historical_evidence_gate",
    )


def validate_first_correction_evidence():
    value = strict_json(ROOT / CORRECTION_EVIDENCE)
    require(
        set(value)
        == {
            "base",
            "branch",
            "cliInventory",
            "correction",
            "gate",
            "phase",
            "rollback",
            "schema",
            "systemMutations",
            "tests",
        },
        "correction_evidence_keys",
    )
    require(
        value["schema"] == 1
        and value["phase"] == "phase5_codex_contract_preparation",
        "correction_evidence_header",
    )
    require(value["base"] == BASE and value["branch"] == BRANCH, "correction_evidence_base")
    require(
        value["correction"]
        == {
            "appendOnly": True,
            "correctionImplementationCommit": FIRST_CORRECTION_IMPLEMENTATION,
            "historicalEvidenceCommit": REVIEWED_HEAD,
            "historicalImplementationCommit": ORIGINAL_IMPLEMENTATION,
            "reviewedHead": REVIEWED_HEAD,
        },
        "correction_evidence_binding",
    )
    require(
        value["gate"]
        == {
            "applyAuthorized": False,
            "independentReviewRequired": True,
            "marker": MARKER,
            "maximumVerdict": VERDICT,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
        },
        "correction_evidence_gate",
    )
    require(
        value["systemMutations"]
        == {
            "codexLiveState": False,
            "hooksOrSkillsInstalled": False,
            "performed": False,
            "pluginsMcpAppsOauth": False,
            "rootOrSystem": False,
        },
        "correction_evidence_mutations",
    )
    require(
        value["rollback"]
        == {"liveRollbackRequired": False, "transactionFixtureExact": True},
        "correction_evidence_rollback",
    )
    require(all(value["tests"].values()), "correction_evidence_tests")
    inventory = value["cliInventory"]
    require(
        inventory["canonicalPath"] == str(CODEX)
        and inventory["source"] == "chatgpt-app-bundle"
        and inventory["version"] == "codex-cli 0.145.0-alpha.18"
        and inventory["regularExecutableNonSymlink"] is True
        and inventory["pluginsExact"] is True
        and inventory["mcpIdentityEnabledExact"] is True
        and inventory["mcpVersionProof"] == "apply-gate-required"
        and inventory["appsAndModelToolAvailability"] == "apply-gate-required",
        "correction_evidence_cli",
    )


