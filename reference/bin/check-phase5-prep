_BRIDGE_V52_DOCTOR_MODULE = None
_BRIDGE_V52_PHASE4_MODULE = None
_BRIDGE_V52_PRIVATE_RECORD_CAPABILITY = None


class BridgeV52PrivateRecordCapability:
    __slots__ = (
        "descriptor",
        "identity",
        "pipe_buf",
        "state",
        "__cleanup_descriptor",
    )

    def __init__(self, descriptor, pipe_identity, pipe_buf):
        self.__cleanup_descriptor = descriptor
        self.descriptor = descriptor
        self.pipe_buf = pipe_buf
        self.state = "ready"
        self.identity = (self, descriptor, pipe_identity, pipe_buf)

    @property
    def cleanup_descriptor(self):
        return self.__cleanup_descriptor


def bridge_v52_private_record_mode(raw_arguments):
    require(type(raw_arguments) is list and
            all(type(item) is str for item in raw_arguments),
            "bridge52_environment_selector")
    if raw_arguments == ["--matrix", "--json"]:
        return "matrix"
    if raw_arguments == ["--implementation", "--json"]:
        return "implementation"
    if raw_arguments == ["--git-only", "--json"]:
        return "git-only"
    return None


def bridge_v52_parse_private_record_selector(selector):
    require(type(selector) is str and selector != "" and
            selector.isascii() and selector.isdigit() and
            (selector == "0" or not selector.startswith("0")),
            "bridge52_environment_selector")
    descriptor = int(selector, 10)
    require(type(descriptor) is int and descriptor > 2 and
            str(descriptor) == selector,
            "bridge52_environment_selector")
    return descriptor


def bridge_v52_bind_private_record(raw_arguments):
    global _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY
    mode = bridge_v52_private_record_mode(raw_arguments)
    selector_present = BRIDGE_V52_PRIVATE_RECORD in os.environ
    selector = os.environ.get(BRIDGE_V52_PRIVATE_RECORD)
    descriptor = None
    capability = None
    first = None
    try:
        if mode != "matrix":
            require(not selector_present and
                    _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY is None,
                    "bridge52_environment_selector")
        else:
            require(selector_present and
                    _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY is None,
                    "bridge52_environment_selector")
            descriptor = bridge_v52_parse_private_record_selector(selector)
            metadata = os.fstat(descriptor)
            flags = fcntl.fcntl(descriptor, fcntl.F_GETFL)
            pipe_buf = os.fpathconf(descriptor, "PC_PIPE_BUF")
            require(stat.S_ISFIFO(metadata.st_mode) and
                    type(flags) is int and
                    flags & os.O_ACCMODE == os.O_WRONLY and
                    flags & os.O_NONBLOCK == 0 and
                    type(pipe_buf) is int and pipe_buf >= 512,
                    "bridge52_private_record_capability")
            os.set_inheritable(descriptor, False)
            require(os.get_inheritable(descriptor) is False,
                    "bridge52_private_record_capability")
            pipe_identity = (metadata.st_dev, metadata.st_ino)
            capability = BridgeV52PrivateRecordCapability(
                descriptor, pipe_identity, pipe_buf)
            require(capability.identity[0] is capability and
                    capability.identity[1] == descriptor and
                    capability.identity[2] == pipe_identity and
                    capability.identity[3] == pipe_buf,
                    "bridge52_private_record_identity")
            _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY = capability
    except Exception as error:
        first = error
    finally:
        try:
            os.environ.pop(BRIDGE_V52_PRIVATE_RECORD, None)
        except Exception as error:
            if first is None:
                first = error
        if first is not None and descriptor is not None:
            if capability is not None:
                capability.state = "consumed"
                capability.descriptor = None
                _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY = None
            try:
                os.close(descriptor)
            except Exception:
                pass
    if first is not None:
        raise first
    return capability


def bridge_v52_private_record_ready():
    capability = _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY
    return (type(capability) is BridgeV52PrivateRecordCapability and
            capability.state == "ready")


def bridge_v52_tuple_digest(values):
    return hashlib.sha256(("\n".join(values) + "\n").encode()).hexdigest()


def bridge_v52_load_doctor():
    global _BRIDGE_V52_DOCTOR_MODULE
    if _BRIDGE_V52_DOCTOR_MODULE is None:
        name = "bridge_v52_phase4_doctor"
        existing = sys.modules.get(name)
        if existing is not None:
            require(Path(existing.__file__).resolve() ==
                    (ROOT / "bin/phase4-final-doctor").resolve(),
                    "bridge52_doctor_identity")
            _BRIDGE_V52_DOCTOR_MODULE = existing
            return existing
        loader = importlib.machinery.SourceFileLoader(
            name, str(ROOT / "bin/phase4-final-doctor"))
        module = types.ModuleType(name)
        module.__file__ = loader.path
        sys.modules[name] = module
        try:
            loader.exec_module(module)
        except Exception:
            sys.modules.pop(name, None)
            raise
        _BRIDGE_V52_DOCTOR_MODULE = module
    return _BRIDGE_V52_DOCTOR_MODULE


def bridge_v52_load_phase4():
    global _BRIDGE_V52_PHASE4_MODULE
    require(_BRIDGE_V52_PHASE4_MODULE is None,
            "bridge52_provider_duplicate_load")
    loader = importlib.machinery.SourceFileLoader(
        "bridge_v52_phase4_provider",
        str(ROOT / "bin/check-phase4-final-probes"),
    )
    module = types.ModuleType(loader.name)
    module.__file__ = loader.path
    loader.exec_module(module)
    require(module.bridge_v52_phase4_facts_provider.__module__ ==
            loader.name and
            module.bridge_v52_phase4_facts_provider.__code__.co_argcount == 0,
            "bridge52_provider_identity")
    _BRIDGE_V52_PHASE4_MODULE = module
    return module


def bridge_v52_phase4_provider_lifecycle(root_state, lifecycle):
    """Own the complete first Phase 4 provider transaction before append."""
    first_case = "phase4-fact-profile-current-mismatch"
    result = {}

    lifecycle.enter("pre-provider")
    lifecycle.enter("pre-operations")
    lifecycle.enter("pre-cases")
    lifecycle.enter("case-partition-1")

    def execute():
        module = None
        context = None
        prior_context = None
        issued_token = None
        reset_count = 0
        facts = None
        first_error = None

        try:
            module = bridge_v52_load_phase4()
            require(module is _BRIDGE_V52_PHASE4_MODULE and
                    module.bridge_v52_phase4_facts_provider.__module__ ==
                        "bridge_v52_phase4_provider" and
                    module.bridge_v52_phase4_facts_provider.__code__.
                        co_argcount == 0,
                    "bridge52_provider_identity")
            context = module._BRIDGE_V52_PROVIDER_CONTEXT
            prior_context = context.get()
            require(module._BRIDGE_V52_PROVIDER_TOKEN is None and
                    prior_context is None and
                    module._BRIDGE_V52_PROVIDER_LOADS == 0 and
                    module._BRIDGE_V52_PROVIDER_CALLS == 0,
                    "bridge52_provider_precondition")

            module.bridge_v52_bind_provider_context(root_state)
            issued_token = module._BRIDGE_V52_PROVIDER_TOKEN
            bound = context.get()
            require(issued_token is not None and type(bound) is dict and
                    set(bound) == {"rootState", "used"} and
                    bound["rootState"] is root_state and
                    bound["used"] is False and
                    module._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    module._BRIDGE_V52_PROVIDER_CALLS == 0,
                    "bridge52_provider_precondition")

            facts = module.bridge_v52_phase4_facts_provider()
            expected = (
                module.BRIDGE_V52_PHASE4_FACT_CASES +
                module.BRIDGE_V52_PHASE4_RAW_CASES +
                module.BRIDGE_V52_PHASE4_HISTORY_CASES +
                module.BRIDGE_V52_PHASE4_OWNER_CASES +
                module.BRIDGE_V52_PHASE4_TOPOLOGY_CASES
            )
            require(type(facts) is dict and set(facts) == {
                        "ambientAttempted", "ambientCases", "caseIDs",
                        "factCases", "historicalCases", "ownerCases",
                        "rawCases", "topologyCases", "facts",
                    } and
                    type(facts["caseIDs"]) is list and
                    all(type(case_id) is str for case_id in facts["caseIDs"])
                    and tuple(facts["caseIDs"]) == expected and
                    len(expected) == len(set(expected)) == 128 and
                    expected[0] == first_case and
                    type(facts["ambientAttempted"]) is int and
                    facts["ambientAttempted"] == 0 and
                    type(facts["ambientCases"]) is int and
                    facts["ambientCases"] == 20 and
                    type(facts["factCases"]) is int and
                    facts["factCases"] == 75 and
                    type(facts["rawCases"]) is int and
                    facts["rawCases"] == 24 and
                    type(facts["historicalCases"]) is int and
                    facts["historicalCases"] == 7 and
                    type(facts["ownerCases"]) is int and
                    facts["ownerCases"] == 2 and
                    type(facts["topologyCases"]) is int and
                    facts["topologyCases"] == 20 and
                    type(facts["facts"]) is dict and
                    module._BRIDGE_V52_PROVIDER_TOKEN is issued_token and
                    context.get() is bound and bound["used"] is True and
                    module._BRIDGE_V52_PROVIDER_LOADS == 1 and
                    module._BRIDGE_V52_PROVIDER_CALLS == 1,
                    "bridge52_provider_result")
        except Exception as error:
            first_error = error
        finally:
            if module is not None and context is not None:
                current_token = module._BRIDGE_V52_PROVIDER_TOKEN
                if current_token is not None:
                    if issued_token is None:
                        issued_token = current_token
                    try:
                        require(current_token is issued_token,
                                "bridge52_provider_token")
                        reset_count += 1
                        module.bridge_v52_reset_provider_context()
                    except Exception as cleanup_error:
                        if first_error is None:
                            first_error = cleanup_error
                try:
                    require(module._BRIDGE_V52_PROVIDER_TOKEN is None and
                            context.get() is prior_context,
                            "bridge52_provider_restore")
                except Exception as cleanup_error:
                    if first_error is None:
                        first_error = cleanup_error

        if first_error is not None:
            raise first_error
        require(module is _BRIDGE_V52_PHASE4_MODULE and facts is not None and
                issued_token is not None and reset_count == 1 and
                module._BRIDGE_V52_PROVIDER_TOKEN is None and
                context.get() is prior_context and
                module._BRIDGE_V52_PROVIDER_LOADS == 1 and
                module._BRIDGE_V52_PROVIDER_CALLS == 1,
                "bridge52_provider_finalization")
        result["module"] = module
        result["facts"] = facts
        lifecycle.phase4_cases.append(first_case)

    lifecycle.case(first_case, execute)
    return (result["module"], result["facts"],
            tuple(lifecycle.phase4_cases))


def bridge_v52_cleanup_provider_token(module):
    """Reset the exact provider token through its production cleanup API."""
    if module._BRIDGE_V52_PROVIDER_TOKEN is not None:
        module.bridge_v52_reset_provider_context()


def bridge_v52_cleanup_provider_context(module, context):
    """Clear an otherwise orphaned provider context without retaining state."""
    if context.get() is not None:
        context.set(None)
    require(module._BRIDGE_V52_PROVIDER_TOKEN is None and
            context.get() is None,
            "bridge52_cleanup_context")


def bridge_v52_cleanup_module_reference(module):
    """Drop the Phase4 module's retained doctor reference."""
    module._BRIDGE_V52_DOCTOR = None


def bridge_v52_cleanup_sys_module(name):
    """Remove one exact transient module registration."""
    sys.modules.pop(name, None)


def bridge_v52_unload_modules(doctor_module=None, phase4_module=None):
    """Unconditionally clear transient modules while retaining first error."""
    global _BRIDGE_V52_DOCTOR_MODULE, _BRIDGE_V52_PHASE4_MODULE
    if doctor_module is None:
        doctor_module = _BRIDGE_V52_DOCTOR_MODULE
    if phase4_module is None:
        phase4_module = _BRIDGE_V52_PHASE4_MODULE
    provider_context = None
    first_error = None

    if phase4_module is not None:
        try:
            provider_context = phase4_module._BRIDGE_V52_PROVIDER_CONTEXT
        except Exception as error:
            first_error = error
        try:
            bridge_v52_cleanup_provider_token(phase4_module)
        except Exception as error:
            if first_error is None:
                first_error = error
            try:
                token = phase4_module._BRIDGE_V52_PROVIDER_TOKEN
                phase4_module._BRIDGE_V52_PROVIDER_TOKEN = None
                if token is not None and provider_context is not None:
                    provider_context.reset(token)
            except Exception:
                try:
                    phase4_module._BRIDGE_V52_PROVIDER_TOKEN = None
                except Exception:
                    pass
        if provider_context is not None:
            try:
                bridge_v52_cleanup_provider_context(
                    phase4_module, provider_context)
            except Exception as error:
                if first_error is None:
                    first_error = error
                try:
                    phase4_module._BRIDGE_V52_PROVIDER_TOKEN = None
                    if provider_context.get() is not None:
                        provider_context.set(None)
                except Exception:
                    pass
        try:
            bridge_v52_cleanup_module_reference(phase4_module)
        except Exception as error:
            if first_error is None:
                first_error = error
            try:
                phase4_module._BRIDGE_V52_DOCTOR = None
            except Exception:
                pass

    _BRIDGE_V52_PHASE4_MODULE = None
    for name in ("bridge_v52_phase4_provider", "bridge_v52_phase4_doctor"):
        try:
            bridge_v52_cleanup_sys_module(name)
        except Exception as error:
            if first_error is None:
                first_error = error
            try:
                sys.modules.pop(name, None)
            except Exception:
                pass
    _BRIDGE_V52_DOCTOR_MODULE = None

    if first_error is not None:
        raise first_error
    return (doctor_module, phase4_module, provider_context)


def bridge_v52_lifecycle_expected_stage(index):
    """Perform one closed expected-stage lookup for an owned transition."""
    return BRIDGE_V52_STAGES[index]


def bridge_v52_lifecycle_append(events, event):
    """Append one owned lifecycle event without synthesizing authority."""
    events.append(event)


def bridge_v52_lifecycle_restore(events, prior):
    """Restore one exact lifecycle prefix for first-failure rollback."""
    events[:] = prior


def bridge_v52_protected_identity(result, counts):
    """Create one immutable identity pair for the owned protected result."""
    return (result, counts)


def bridge_v52_boundary_identity(result):
    """Create one immutable identity seal for the owned boundary result."""
    return (result,)


def bridge_v52_partition3_identity(protected_result, boundary_result):
    """Seal the two owned partition-three results for the driver."""
    return (protected_result, boundary_result)


def bridge_v52_partition4_finalization(lifecycle, case_id, stage):
    """Finalize the owned partition-four transition before case success."""
    require(lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:11] and
            tuple(lifecycle.diagnostics) ==
                BRIDGE_V52_DIAGNOSTIC_CASES[:11] and
            lifecycle.stages[-1] == stage and
            lifecycle.diagnostics[-1] == case_id,
            "bridge52_partition4_finalization")


def bridge_v52_partition5_finalization(lifecycle, case_id, stage):
    """Finalize the owned partition-five transition before case success."""
    require(lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:12] and
            tuple(lifecycle.diagnostics) ==
                BRIDGE_V52_DIAGNOSTIC_CASES[:12] and
            lifecycle.stages[-1] == stage and
            lifecycle.diagnostics[-1] == case_id,
            "bridge52_partition5_finalization")


class BridgeV52Lifecycle:
    def __init__(self):
        self.stages = []
        self.diagnostics = []
        self.phase4_cases = []
        self.local_setup = None
        self.local_setup_fields = None
        self.local_setup_root = None
        self.reviewer_setup = None
        self.reviewer_setup_fields = None
        self.reviewer_setup_root = None
        self.main_setup = None
        self.main_setup_fields = None
        self.main_setup_root = None
        self.protected_setup = None
        self.protected_setup_fields = None
        self.protected_setup_root = None
        self.executor_setup = None
        self.executor_setup_fields = None
        self.executor_setup_root = None
        self.third_setup = None
        self.third_setup_fields = None
        self.third_setup_root = None
        self.protected_matrix_result = None
        self.protected_matrix_fields = None
        self.boundary_facts_result = None
        self.boundary_facts_fields = None
        self.partition3_results = None
        self.active_case = None
        self.first_failure = None

    def enter(self, stage, protected_operation=None, boundary_operation=None):
        if stage == "case-partition-3" or len(self.stages) == 9:
            return self.enter_case_partition_3(
                stage, protected_operation, boundary_operation)
        if stage == "case-partition-4" or len(self.stages) == 10:
            return self.enter_case_partition_4(
                stage, protected_operation, boundary_operation)
        if stage == "case-partition-5" or len(self.stages) == 11:
            return self.enter_case_partition_5(
                stage, protected_operation, boundary_operation)
        require(protected_operation is None and boundary_operation is None,
                "bridge52_partition3_operation_owner")
        expected = BRIDGE_V52_STAGES[len(self.stages)]
        require(stage == expected, "bridge52_stage_order")
        self.stages.append(stage)
        if len(self.stages) <= len(BRIDGE_V52_DIAGNOSTIC_CASES):
            case_id = BRIDGE_V52_DIAGNOSTIC_CASES[len(self.stages) - 1]
            self.case(case_id, lambda: require(
                self.stages[-1] == stage and self.active_case == case_id,
                "bridge52_diagnostic_stage"))

    def enter_case_partition_3(self, stage, protected_operation,
                               boundary_operation):
        """Own partition3 transition and its two sealed matrix results."""
        case_id = "diagnostic-case-partition-3"
        result = [None]

        def owned():
            prior_stages = tuple(self.stages)
            prior_diagnostics = tuple(self.diagnostics)
            protected_result = None
            protected_counts = None
            protected_fields = None
            boundary_result = None
            boundary_fields = None
            partition3_results = None
            protected_calls = 0
            boundary_calls = 0
            protected_started = False
            protected_finished = False
            boundary_started = False
            boundary_finished = False
            first_error = None
            try:
                require(self.active_case == case_id and
                        type(self.stages) is list and
                        type(self.diagnostics) is list and
                        callable(protected_operation) and
                        callable(boundary_operation) and
                        self.protected_matrix_result is None and
                        self.protected_matrix_fields is None and
                        self.boundary_facts_result is None and
                        self.boundary_facts_fields is None and
                        self.partition3_results is None and
                        result[0] is None,
                        "bridge52_partition3_ownership")
                require(prior_stages == BRIDGE_V52_STAGES[:9] and
                        len(prior_stages) == 9 and
                        prior_diagnostics ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:9] and
                        len(prior_diagnostics) == 9,
                        "bridge52_partition3_prior_prefix")
                expected = bridge_v52_lifecycle_expected_stage(
                    len(self.stages))
                require(expected == stage and stage == "case-partition-3",
                        "bridge52_partition3_order")
                bridge_v52_lifecycle_append(self.stages, stage)
                require(tuple(self.stages) == BRIDGE_V52_STAGES[:10] and
                        len(self.stages) == 10 and
                        self.stages[-1] == stage,
                        "bridge52_partition3_resulting_stage")

                protected_started = True
                protected_calls += 1
                protected_result = protected_operation()
                require(type(protected_result) is dict and
                        type(protected_result.get("counts")) is dict and
                        all(type(value) is int for value in (
                            protected_result.get("astTargets"),
                            protected_result.get("concreteTargets"),
                            protected_result.get("total"),
                            *protected_result["counts"].values())),
                        "bridge52_partition3_protected_type")
                protected_counts = protected_result["counts"]
                require(len(protected_result) == 4 and
                        len(protected_counts) == 3 and
                        protected_calls == 1,
                        "bridge52_partition3_protected_count")
                require(tuple(protected_result) == (
                            "astTargets", "concreteTargets", "counts",
                            "total") and
                        tuple(protected_counts) == (
                            "phase4", "prep", "apply"),
                        "bridge52_partition3_protected_order")
                require(protected_result["astTargets"] == 13 and
                        protected_result["concreteTargets"] == 99 and
                        protected_counts == {
                            "phase4": 112, "prep": 112, "apply": 112,
                        } and
                        protected_result["total"] == 336 and
                        sum(protected_counts.values()) == 336,
                        "bridge52_partition3_protected_value")
                protected_fields = bridge_v52_protected_identity(
                    protected_result, protected_counts)
                self.protected_matrix_result = protected_result
                self.protected_matrix_fields = protected_fields
                require(self.protected_matrix_result is protected_result and
                        self.protected_matrix_fields is protected_fields,
                        "bridge52_partition3_protected_seal")
                require(type(protected_fields) is tuple and
                        len(protected_fields) == 2 and
                        protected_fields[0] is protected_result and
                        protected_fields[1] is protected_counts,
                        "bridge52_partition3_protected_identity")
                protected_finished = True

                boundary_started = True
                boundary_calls += 1
                boundary_result = boundary_operation()
                require(type(boundary_result) is dict and
                        all(type(value) is int
                            for value in boundary_result.values()),
                        "bridge52_partition3_boundary_type")
                require(len(boundary_result) == 2 and boundary_calls == 1,
                        "bridge52_partition3_boundary_count")
                require(tuple(boundary_result) ==
                            ("applyCases", "finalCases"),
                        "bridge52_partition3_boundary_order")
                require(boundary_result == {
                            "applyCases": 14, "finalCases": 29,
                        },
                        "bridge52_partition3_boundary_value")
                boundary_fields = bridge_v52_boundary_identity(
                    boundary_result)
                self.boundary_facts_result = boundary_result
                self.boundary_facts_fields = boundary_fields
                require(self.boundary_facts_result is boundary_result and
                        self.boundary_facts_fields is boundary_fields,
                        "bridge52_partition3_boundary_seal")
                require(type(boundary_fields) is tuple and
                        len(boundary_fields) == 1 and
                        boundary_fields[0] is boundary_result,
                        "bridge52_partition3_boundary_identity")
                partition3_results = bridge_v52_partition3_identity(
                    protected_result, boundary_result)
                self.partition3_results = partition3_results
                result[0] = partition3_results
                require(type(partition3_results) is tuple and
                        len(partition3_results) == 2 and
                        partition3_results[0] is
                            self.protected_matrix_result and
                        partition3_results[1] is
                            self.boundary_facts_result and
                        result[0] is self.partition3_results,
                        "bridge52_partition3_result_identity")
                boundary_finished = True
                bridge_v52_lifecycle_append(self.diagnostics, case_id)
                require(tuple(self.diagnostics) ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:10] and
                        len(self.diagnostics) == 10 and
                        self.diagnostics[-1] == case_id,
                        "bridge52_partition3_diagnostic_append")
                require(self.active_case == case_id and
                        tuple(self.stages) == BRIDGE_V52_STAGES[:10] and
                        tuple(self.diagnostics) ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:10] and
                        protected_calls == 1 and boundary_calls == 1 and
                        protected_finished and boundary_finished and
                        result[0] is self.partition3_results and
                        self.partition3_results[0] is
                            self.protected_matrix_result and
                        self.partition3_results[1] is
                            self.boundary_facts_result,
                        "bridge52_partition3_finalization")
            except Exception as error:
                if (((protected_started and not protected_finished) or
                        (boundary_started and not boundary_finished)) and
                        self.first_failure is None):
                    reason = str(error)
                    self.first_failure = {
                        "caseID": case_id,
                        "reason": reason if re.fullmatch(
                            r"bridge52_[a-z0-9_]+", reason) else
                            "bridge52_internal",
                        "result": "fail",
                        "stage": "case-partition-3",
                        "status": "failed",
                    }
                first_error = error

            if first_error is not None:
                result[0] = None
                self.protected_matrix_result = None
                self.protected_matrix_fields = None
                self.boundary_facts_result = None
                self.boundary_facts_fields = None
                self.partition3_results = None
                for events, prior in (
                        (self.diagnostics, prior_diagnostics),
                        (self.stages, prior_stages)):
                    restored = False
                    for _attempt in range(2):
                        try:
                            bridge_v52_lifecycle_restore(events, prior)
                        except Exception:
                            continue
                        restored = True
                        break
                    if not restored:
                        events[:] = prior
                require(tuple(self.stages) == prior_stages and
                        tuple(self.diagnostics) == prior_diagnostics and
                        self.active_case == case_id and
                        result[0] is None and
                        self.protected_matrix_result is None and
                        self.protected_matrix_fields is None and
                        self.boundary_facts_result is None and
                        self.boundary_facts_fields is None and
                        self.partition3_results is None,
                        "bridge52_partition3_rollback")
                raise first_error

        self.case(case_id, owned)
        return result[0]

    def enter_case_partition_4(self, stage, protected_operation,
                               boundary_operation):
        """Own the exact partition4 transition and diagnostic append."""
        case_id = "diagnostic-case-partition-4"

        def owned():
            prior_stages = tuple(self.stages)
            prior_diagnostics = tuple(self.diagnostics)
            first_error = None
            try:
                require(self.active_case == case_id and
                        type(self.stages) is list and
                        type(self.diagnostics) is list and
                        protected_operation is None and
                        boundary_operation is None,
                        "bridge52_partition4_ownership")
                require(prior_stages == BRIDGE_V52_STAGES[:10] and
                        len(prior_stages) == 10 and
                        prior_diagnostics ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:10] and
                        len(prior_diagnostics) == 10,
                        "bridge52_partition4_prior_prefix")
                expected = bridge_v52_lifecycle_expected_stage(
                    len(self.stages))
                require(expected == stage and stage == "case-partition-4",
                        "bridge52_partition4_order")
                bridge_v52_lifecycle_append(self.stages, stage)
                require(tuple(self.stages) == BRIDGE_V52_STAGES[:11] and
                        len(self.stages) == 11 and
                        self.stages[-1] == stage,
                        "bridge52_partition4_resulting_stage")
                bridge_v52_lifecycle_append(self.diagnostics, case_id)
                require(tuple(self.diagnostics) ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:11] and
                        len(self.diagnostics) == 11 and
                        self.diagnostics[-1] == case_id,
                        "bridge52_partition4_diagnostic_append")
                bridge_v52_partition4_finalization(
                    self, case_id, stage)
            except Exception as error:
                if self.first_failure is None:
                    reason = str(error)
                    self.first_failure = {
                        "caseID": case_id,
                        "reason": reason if re.fullmatch(
                            r"bridge52_[a-z0-9_]+", reason) else
                            "bridge52_internal",
                        "result": "fail",
                        "stage": "case-partition-4",
                        "status": "failed",
                    }
                first_error = error

            if first_error is not None:
                for events, prior in (
                        (self.diagnostics, prior_diagnostics),
                        (self.stages, prior_stages)):
                    restored = False
                    for _attempt in range(2):
                        try:
                            bridge_v52_lifecycle_restore(events, prior)
                        except Exception:
                            continue
                        restored = True
                        break
                    if not restored:
                        events[:] = prior
                if (tuple(self.stages) != prior_stages or
                        tuple(self.diagnostics) != prior_diagnostics):
                    self.diagnostics[:] = prior_diagnostics
                    self.stages[:] = prior_stages
                raise first_error

        self.case(case_id, owned)

    def enter_case_partition_5(self, stage, protected_operation,
                               boundary_operation):
        """Own the exact partition5 guard, transition and diagnostic append."""
        case_id = "diagnostic-case-partition-5"

        def owned():
            prior_stages = tuple(self.stages)
            prior_diagnostics = tuple(self.diagnostics)
            first_error = None
            try:
                require(self.active_case == case_id and
                        type(self.stages) is list and
                        type(self.diagnostics) is list,
                        "bridge52_partition5_ownership")
                require(protected_operation is None and
                        boundary_operation is None,
                        "bridge52_partition5_operation_guard")
                require(prior_stages == BRIDGE_V52_STAGES[:11] and
                        len(prior_stages) == 11 and
                        prior_diagnostics ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:11] and
                        len(prior_diagnostics) == 11,
                        "bridge52_partition5_prior_prefix")
                expected = bridge_v52_lifecycle_expected_stage(
                    len(self.stages))
                require(expected == stage and stage == "case-partition-5",
                        "bridge52_partition5_order")
                bridge_v52_lifecycle_append(self.stages, stage)
                require(tuple(self.stages) == BRIDGE_V52_STAGES[:12] and
                        len(self.stages) == 12 and
                        self.stages[-1] == stage,
                        "bridge52_partition5_resulting_stage")
                bridge_v52_lifecycle_append(self.diagnostics, case_id)
                require(tuple(self.diagnostics) ==
                            BRIDGE_V52_DIAGNOSTIC_CASES[:12] and
                        len(self.diagnostics) == 12 and
                        self.diagnostics[-1] == case_id,
                        "bridge52_partition5_diagnostic_append")
                bridge_v52_partition5_finalization(
                    self, case_id, stage)
            except Exception as error:
                if self.first_failure is None:
                    reason = str(error)
                    self.first_failure = {
                        "caseID": case_id,
                        "reason": reason if re.fullmatch(
                            r"bridge52_[a-z0-9_]+", reason) else
                            "bridge52_internal",
                        "result": "fail",
                        "stage": "case-partition-5",
                        "status": "failed",
                    }
                first_error = error

            if first_error is not None:
                for events, prior in (
                        (self.diagnostics, prior_diagnostics),
                        (self.stages, prior_stages)):
                    restored = False
                    for _attempt in range(2):
                        try:
                            bridge_v52_lifecycle_restore(events, prior)
                        except Exception:
                            continue
                        restored = True
                        break
                    if not restored:
                        events[:] = prior
                if (tuple(self.stages) != prior_stages or
                        tuple(self.diagnostics) != prior_diagnostics):
                    self.diagnostics[:] = prior_diagnostics
                    self.stages[:] = prior_stages
                raise first_error

        self.case(case_id, owned)

    def case(self, case_id, operation):
        require(self.active_case is None and self.first_failure is None,
                "bridge52_case_ownership")
        self.active_case = case_id
        try:
            operation()
        except Exception as error:
            if self.first_failure is None:
                reason = str(error)
                self.first_failure = {
                    "caseID": case_id,
                    "reason": reason if re.fullmatch(
                        r"bridge52_[a-z0-9_]+", reason) else
                        "bridge52_internal",
                    "result": "fail",
                    "stage": self.stages[-1] if self.stages else
                        "pre-environment",
                    "status": "failed",
                }
            raise
        finally:
            self.active_case = None
        if (case_id.startswith("diagnostic-") and case_id not in {
                "diagnostic-case-partition-3",
                "diagnostic-case-partition-4",
                "diagnostic-case-partition-5",
        }):
            self.diagnostics.append(case_id)


def bridge_v52_private_record(value):
    capability = _BRIDGE_V52_PRIVATE_RECORD_CAPABILITY
    require(type(capability) is BridgeV52PrivateRecordCapability and
            capability.state == "ready",
            "bridge52_private_record_identity")
    capability.state = "consuming"
    cleanup_descriptor = capability.cleanup_descriptor
    first = None
    frame_identity = None
    try:
        descriptor = capability.descriptor
        require(type(capability.identity) is tuple and
                len(capability.identity) == 4 and
                capability.identity[0] is capability and
                descriptor == cleanup_descriptor and
                capability.identity[1] == cleanup_descriptor and
                capability.identity[3] == capability.pipe_buf,
                "bridge52_private_record_identity")
        metadata = os.fstat(cleanup_descriptor)
        flags = fcntl.fcntl(cleanup_descriptor, fcntl.F_GETFL)
        pipe_buf = os.fpathconf(cleanup_descriptor, "PC_PIPE_BUF")
        require(stat.S_ISFIFO(metadata.st_mode) and
                (metadata.st_dev, metadata.st_ino) ==
                    capability.identity[2] and
                type(flags) is int and
                flags & os.O_ACCMODE == os.O_WRONLY and
                flags & os.O_NONBLOCK == 0 and
                type(pipe_buf) is int and pipe_buf == capability.pipe_buf and
                pipe_buf >= 512 and
                os.get_inheritable(cleanup_descriptor) is False and
                BRIDGE_V52_PRIVATE_RECORD not in os.environ,
                "bridge52_private_record_capability")
        require(type(value) is dict and
                tuple(value.keys()) == BRIDGE_V52_SUCCESS_RECORD_KEYS and
                all(type(key) is str and type(item) is str
                    for key, item in value.items()),
                "bridge52_private_record_schema")
        success = tuple(value.items()) == BRIDGE_V52_SUCCESS_RECORD_ITEMS
        failure = (
            value["caseID"] != "" and
            re.fullmatch(r"bridge52_[a-z0-9_]+", value["reason"]) is not None
            and value["result"] == "fail" and value["stage"] != "" and
            value["status"] == "failed"
        )
        require(success or failure, "bridge52_private_record_schema")
        raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) +
               "\n").encode("utf-8")
        canonical = (
            json.dumps(value, sort_keys=True, separators=(",", ":")) +
            "\n").encode("utf-8")
        frame_identity = (value, raw)
        require(frame_identity[0] is value and
                frame_identity[1] is raw and canonical is not raw and
                canonical == raw and raw[-1:] == b"\n" and
                raw.count(b"\n") == 1 and
                0 < len(raw) <= 512 and len(raw) <= capability.pipe_buf and
                (not success or
                 (len(raw) == 128 and raw == BRIDGE_V52_SUCCESS_RECORD_RAW)),
                "bridge52_private_record_frame")
        written = os.write(cleanup_descriptor, raw)
        require(type(written) is int and written == len(raw),
                "bridge52_private_record_write")
    except Exception as error:
        first = error
    finally:
        capability.state = "consumed"
        capability.descriptor = None
        try:
            os.close(cleanup_descriptor)
        except Exception as error:
            if first is None:
                first = error
    if first is not None:
        raise first
    return frame_identity


def bridge_v52_child_environment(environment, *, synthetic=False):
    require(type(environment) is dict or hasattr(environment, "items"),
            "bridge52_child_environment_type")
    allowed = {
        "HOME", "LOGNAME", "PATH", "SHELL", "TMPDIR", "USER",
        "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME",
        "XDG_STATE_HOME",
    }
    child = {
        key: value for key, value in dict(environment).items()
        if key in allowed and type(value) is str
    }
    child["GIT_CONFIG_GLOBAL"] = "/dev/null"
    child["GIT_CONFIG_NOSYSTEM"] = "1"
    child["GIT_NO_REPLACE_OBJECTS"] = "1"
    child.pop("GIT_CONFIG_SYSTEM", None)
    child["PYTHONDONTWRITEBYTECODE"] = "1"
    child["PYTHONNOUSERSITE"] = "1"
    child["LANG"] = "C"
    child["LC_ALL"] = "C"
    if synthetic:
        child[BRIDGE_V52_SYNTHETIC_FLAG] = "1"
    return child


def bridge_v52_commit_environment(doctor, epoch):
    return {
        **bridge_v52_child_environment(os.environ),
        "GIT_AUTHOR_NAME": doctor.BRIDGE_V52_IDENTITY[0],
        "GIT_AUTHOR_EMAIL": doctor.BRIDGE_V52_IDENTITY[1],
        "GIT_COMMITTER_NAME": doctor.BRIDGE_V52_IDENTITY[2],
        "GIT_COMMITTER_EMAIL": doctor.BRIDGE_V52_IDENTITY[3],
        "GIT_AUTHOR_DATE": str(epoch) + " +0000",
        "GIT_COMMITTER_DATE": str(epoch) + " +0000",
    }


def bridge_v52_fresh_implementation_repository(source, implementation,
                                                destination, doctor):
    destination.mkdir(mode=0o700)
    checked([*GIT, "init", "-q", "-b", doctor.BRIDGE_V52_BRANCH],
            cwd=destination, environment=bridge_v52_child_environment(os.environ))
    checked([*GIT, "fetch", "-q", "--no-tags", str(source), implementation],
            cwd=destination, environment=bridge_v52_child_environment(os.environ))
    checked([*GIT, "update-ref", "refs/heads/" + doctor.BRIDGE_V52_BRANCH,
             implementation], cwd=destination,
            environment=bridge_v52_child_environment(os.environ))
    checked([*GIT, "checkout", "-q", doctor.BRIDGE_V52_BRANCH],
            cwd=destination, environment=bridge_v52_child_environment(os.environ))
    require(git("remote", cwd=destination) == "" and
            git("rev-parse", "HEAD", cwd=destination) == implementation and
            git("status", "--porcelain=v1", "--untracked-files=all",
                cwd=destination) == "", "bridge52_fixture_implementation")
    doctor.bridge_v52_validate_implementation(destination, implementation)
    return destination


def bridge_v52_commit_child(repository, doctor, implementation, *,
                            raw=None, path=None, subject=None, epoch=None,
                            mode=0o644, extra_path=None):
    relative = path or doctor.BRIDGE_V52_EVIDENCE
    target = repository / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(raw if raw is not None else
                       doctor.bridge_v52_placeholder_bytes(implementation))
    target.chmod(mode)
    paths = [relative]
    if extra_path is not None:
        extra = repository / extra_path
        extra.parent.mkdir(parents=True, exist_ok=True)
        extra.write_text("extra\n")
        paths.append(extra_path)
    checked([*GIT, "add", "--", *paths], cwd=repository,
            environment=bridge_v52_child_environment(os.environ))
    checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
             subject or doctor.BRIDGE_V52_EVIDENCE_SUBJECT],
            cwd=repository,
            environment=bridge_v52_commit_environment(
                doctor, epoch or doctor.BRIDGE_V52_EVIDENCE_EPOCH))
    return git("rev-parse", "HEAD", cwd=repository)


def bridge_v52_run_entrypoint(repository, relative, arguments, environment):
    return subprocess.run(
        [str(repository / relative), *arguments], cwd=repository,
        env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        check=False,
    )


def bridge_v52_expect_denial(operation):
    try:
        operation()
    except (RuntimeError, ValueError, KeyError, TypeError,
            json.JSONDecodeError, UnicodeDecodeError):
        return
    raise RuntimeError("bridge52_negative_accepted")


def bridge_v52_remove_tree(path):
    """Remove one owned fixture tree retry-safely without masking failure."""
    path = Path(path)
    first = None
    for _attempt in range(2):
        if not os.path.lexists(path):
            break
        try:
            shutil.rmtree(path)
        except Exception as error:
            if first is None:
                first = error
    require(not os.path.lexists(path), "bridge52_route_cleanup")
    if first is not None:
        raise first


def bridge_v52_route_pending_event(prefix, final_case):
    """Construct the pending exact route10 tuple inside its final owner."""
    require(type(prefix) is tuple and type(final_case) is str,
            "bridge52_route_final_construction")
    return (*prefix, final_case)


def bridge_v52_route_unique(events):
    """Observe exact route uniqueness without supplying route authority."""
    return len(events) == len(set(events))


def bridge_v52_route_identity(pending):
    """Seal one exact route result by object identity."""
    return (pending,)


def bridge_v52_route_identity_matches(sealed, result):
    """Validate the stored route seal without reconstructing its value."""
    return sealed[0] is result


def bridge_v52_route_finalization(lifecycle, actual, pending, result,
                                  sealed, final_case, cleanup_root,
                                  environment_before, command_before,
                                  source_head, source_status, phase4,
                                  provider_context, provider_loads,
                                  provider_calls):
    """Finalize the owned route append only after cleanup and sealing."""
    require(lifecycle.active_case == final_case and lifecycle.stages and
            lifecycle.stages[-1] == "case-partition-4" and
            tuple(actual) == pending and actual[-1] is pending[-1] and
            result is pending and type(sealed) is tuple and len(sealed) == 1
            and sealed[0] is result and not os.path.lexists(cleanup_root) and
            dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before and
            git("rev-parse", "HEAD", cwd=ROOT) == source_head and
            git("status", "--porcelain=v1", "--untracked-files=all",
                cwd=ROOT) == source_status and
            phase4 is _BRIDGE_V52_PHASE4_MODULE and
            phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
            provider_context.get() is None and
            phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
            phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls,
            "bridge52_route_finalization")


def bridge_v52_route_final_case(root_state, doctor, phase4, lifecycle,
                                actual, predicate):
    """Own final route predicate, cleanup and exact route10 result seal."""
    final_case = "matrix-input-placeholder-no-flag-denial"
    result = [None]
    sealed_identity = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        source_head = source_status = None
        provider_context = None
        provider_loads = provider_calls = None
        command_stack = contextlib.ExitStack()
        cleanup_root = None
        pending = None
        sealed = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == final_case and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-4",
                    "bridge52_route_final_ownership")
            require(type(prefix) is tuple and len(prefix) == 9 and
                    prefix == BRIDGE_V52_ROUTE_CASES[:-1] and
                    len(set(prefix)) == 9 and
                    all(type(value) is str for value in prefix) and
                    BRIDGE_V52_ROUTE_CASES[-1] == final_case and
                    result[0] is None and sealed_identity[0] is None,
                    "bridge52_route_final_prefix")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            source_head = git("rev-parse", "HEAD", cwd=ROOT)
            source_status = git("status", "--porcelain=v1",
                                "--untracked-files=all", cwd=ROOT)
            provider_context = phase4._BRIDGE_V52_PROVIDER_CONTEXT
            provider_loads = phase4._BRIDGE_V52_PROVIDER_LOADS
            provider_calls = phase4._BRIDGE_V52_PROVIDER_CALLS
            require(phase4 is _BRIDGE_V52_PHASE4_MODULE and
                    phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                    provider_loads == 1 and provider_calls == 1 and
                    provider_context.get() is None and callable(predicate),
                    "bridge52_route_final_setup")
            command_environment = bridge_v52_child_environment(os.environ)
            command_stack.enter_context(
                doctor.bridge_v52_closed_command_environment(
                    command_environment))
            command_token = _BRIDGE_V52_COMMAND_ENVIRONMENT.set(
                command_environment)
            command_stack.callback(
                _BRIDGE_V52_COMMAND_ENVIRONMENT.reset, command_token)
            cleanup_root = Path(tempfile.mkdtemp(
                prefix="bridge-v52-route.")).resolve()
            repository = cleanup_root / "control"
            bridge_v52_fresh_implementation_repository(
                ROOT, root_state.implementation, repository, doctor)
            predicate(repository)
        except Exception as error:
            first_error = error

        try:
            if cleanup_root is not None:
                bridge_v52_remove_tree(cleanup_root)
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            command_stack.close()
        except Exception as error:
            if first_error is None:
                first_error = error
        try:
            require(cleanup_root is not None and
                    not os.path.lexists(cleanup_root),
                    "bridge52_route_final_absence")
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                require(tuple(actual) == prefix and
                        dict(os.environ) == environment_before and
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before and
                        git("rev-parse", "HEAD", cwd=ROOT) == source_head and
                        git("status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status and
                        phase4 is _BRIDGE_V52_PHASE4_MODULE and
                        phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                        provider_context.get() is None and
                        phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                        phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls,
                        "bridge52_route_final_restoration")
                pending = bridge_v52_route_pending_event(prefix, final_case)
                require(type(pending) is tuple and
                        all(type(value) is str for value in pending),
                        "bridge52_route_final_type")
                require(len(pending) == 10,
                        "bridge52_route_final_count")
                require(final_case in pending,
                        "bridge52_route_final_omission")
                require(bridge_v52_route_unique(pending),
                        "bridge52_route_final_duplicate")
                require(pending[:-1] == prefix and
                        pending[-1] == final_case,
                        "bridge52_route_final_order")
                require(pending == BRIDGE_V52_ROUTE_CASES,
                        "bridge52_route_final_equality")
                require(bridge_v52_route_unique(pending),
                        "bridge52_route_final_uniqueness")
                sealed = bridge_v52_route_identity(pending)
                result[0] = pending
                sealed_identity[0] = sealed
                require(result[0] is pending and type(result[0]) is tuple and
                        type(sealed) is tuple and len(sealed) == 1 and
                        sealed[0] is pending,
                        "bridge52_route_final_seal")
                require(sealed_identity[0] is sealed and
                        bridge_v52_route_identity_matches(
                            sealed_identity[0], result[0]),
                        "bridge52_route_final_identity")
                actual.append(final_case)
                bridge_v52_route_finalization(
                    lifecycle, actual, pending, result[0], sealed_identity[0],
                    final_case, cleanup_root, environment_before,
                    command_before, source_head, source_status, phase4,
                    provider_context, provider_loads, provider_calls)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if cleanup_root is not None and os.path.lexists(cleanup_root):
                try:
                    bridge_v52_remove_tree(cleanup_root)
                except Exception:
                    try:
                        shutil.rmtree(cleanup_root)
                    except Exception:
                        pass
            try:
                command_stack.close()
            except Exception:
                pass
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            try:
                require((cleanup_root is None or
                         not os.path.lexists(cleanup_root)) and
                        (prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (source_head is None or git("rev-parse", "HEAD",
                            cwd=ROOT) == source_head) and
                        (source_status is None or git(
                            "status", "--porcelain=v1",
                            "--untracked-files=all", cwd=ROOT) ==
                            source_status) and
                        (provider_context is None or
                         (phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                          provider_context.get() is None and
                          phase4._BRIDGE_V52_PROVIDER_LOADS == provider_loads and
                          phase4._BRIDGE_V52_PROVIDER_CALLS == provider_calls))
                        and result[0] is None and
                        sealed_identity[0] is None,
                        "bridge52_route_final_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(final_case, owned)
    return result[0]


def bridge_v52_route_matrix(root_state, doctor, phase4, lifecycle):
    actual = []

    def fixture(case_id, operation):
        def owned():
            temporary = None
            command_stack = contextlib.ExitStack()
            first = None
            try:
                command_environment = bridge_v52_child_environment(os.environ)
                command_stack.enter_context(
                    doctor.bridge_v52_closed_command_environment(
                        command_environment))
                command_token = _BRIDGE_V52_COMMAND_ENVIRONMENT.set(
                    command_environment)
                command_stack.callback(
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.reset, command_token)
                temporary = Path(tempfile.mkdtemp(
                    prefix="bridge-v52-route.")).resolve()
                repository = temporary / "control"
                bridge_v52_fresh_implementation_repository(
                    ROOT, root_state.implementation, repository, doctor)
                operation(repository)
            except Exception as error:
                first = error
            finally:
                if temporary is not None:
                    try:
                        bridge_v52_remove_tree(temporary)
                    except Exception as cleanup_error:
                        if first is None:
                            first = cleanup_error
                try:
                    command_stack.close()
                except Exception as cleanup_error:
                    if first is None:
                        first = cleanup_error
                if first is not None:
                    raise first
            actual.append(case_id)
        lifecycle.case(case_id, owned)

    def synthetic_positive(repository):
        activity = {"downstream": 0, "spawn": 0}
        provider_before = (
            phase4._BRIDGE_V52_PROVIDER_LOADS,
            phase4._BRIDGE_V52_PROVIDER_CALLS,
        )
        implementation = git("rev-parse", "HEAD", cwd=repository)
        child = bridge_v52_commit_child(
            repository, doctor, implementation)
        child_environment = bridge_v52_child_environment(
            os.environ, synthetic=True)
        require(BRIDGE_V52_PRIVATE_RECORD not in child_environment and
                child_environment.get(BRIDGE_V52_SYNTHETIC_FLAG) == "1" and
                not [key for key in child_environment
                     if key.startswith("BRIDGE_V52_") and
                     key != BRIDGE_V52_SYNTHETIC_FLAG],
                "bridge52_route_environment")
        classifier_calls = 0

        def classify_once():
            nonlocal classifier_calls
            classifier_calls += 1
            return doctor.bridge_v52_classify_actual_root(
                repository, child_environment)

        fixture_state = classify_once()
        require(classifier_calls == 1 and
                doctor.bridge_v52_state_is_sealed(fixture_state) and
                fixture_state.input_state is
                    doctor.BRIDGE_V52_SYNTHETIC_REVIEW and
                fixture_state.implementation == implementation and
                fixture_state.head == child and
                fixture_state.evidence == child and
                fixture_state is not root_state and
                git("rev-parse", child + "^", cwd=repository) ==
                    implementation and
                git("diff-tree", "--no-commit-id", "--name-only", "-r",
                    child, cwd=repository) == doctor.BRIDGE_V52_EVIDENCE and
                git("status", "--porcelain=v1", "--untracked-files=all",
                    cwd=repository) == "" and
                git("remote", cwd=repository) == "" and
                activity == {"downstream": 0, "spawn": 0} and
                (phase4._BRIDGE_V52_PROVIDER_LOADS,
                 phase4._BRIDGE_V52_PROVIDER_CALLS) == provider_before,
                "bridge52_route_synthetic")

    fixture(BRIDGE_V52_ROUTE_CASES[0], synthetic_positive)

    def real_positive(repository):
        state = doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(os.environ))
        require(doctor.bridge_v52_state_is_sealed(state) and
                state.input_state is doctor.BRIDGE_V52_REAL_IMPLEMENTATION and
                state.evidence is None and state.head == state.implementation,
                "bridge52_route_real")

    fixture(BRIDGE_V52_ROUTE_CASES[1], real_positive)

    def evidence_head(repository):
        implementation = git("rev-parse", "HEAD", cwd=repository)
        raw = (json.dumps({"schema": 1, "phase": "real-evidence-fixture"},
                          sort_keys=True, separators=(",", ":")) + "\n").encode()
        bridge_v52_commit_child(repository, doctor, implementation, raw=raw)
        bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(os.environ)))

    fixture(BRIDGE_V52_ROUTE_CASES[2], evidence_head)

    def descendant(repository, *, reviewer):
        implementation = git("rev-parse", "HEAD", cwd=repository)
        bridge_v52_commit_child(repository, doctor, implementation)
        identity = (
            ["Bridge Reviewer", "bridge-reviewer@agent-first-mac.invalid"] * 2
            if reviewer else doctor.BRIDGE_V52_IDENTITY
        )
        environment = {
            **bridge_v52_commit_environment(
                doctor, doctor.BRIDGE_V52_EVIDENCE_EPOCH + 1),
            "GIT_AUTHOR_NAME": identity[0],
            "GIT_AUTHOR_EMAIL": identity[1],
            "GIT_COMMITTER_NAME": identity[2],
            "GIT_COMMITTER_EMAIL": identity[3],
        }
        checked([*GIT, "commit", "--allow-empty", "-q", "--no-gpg-sign",
                 "-m", "bounded descendant"], cwd=repository,
                environment=environment)
        bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(
                os.environ, synthetic=True)))

    fixture(BRIDGE_V52_ROUTE_CASES[3],
            lambda repository: descendant(repository, reviewer=True))

    def main_denial(repository):
        checked([*GIT, "branch", "-m", "main"], cwd=repository,
                environment=bridge_v52_child_environment(os.environ))
        bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(os.environ)))

    fixture(BRIDGE_V52_ROUTE_CASES[4], main_denial)
    fixture(BRIDGE_V52_ROUTE_CASES[5],
            lambda repository: descendant(repository, reviewer=False))

    def malformed(repository):
        implementation = git("rev-parse", "HEAD", cwd=repository)
        bridge_v52_commit_child(
            repository, doctor, implementation,
            subject="Record swapped Bridge fixture",
            epoch=doctor.BRIDGE_V52_EVIDENCE_EPOCH + 10)
        bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(
                os.environ, synthetic=True)))

    fixture(BRIDGE_V52_ROUTE_CASES[6], malformed)

    def wrong_branch(repository):
        checked([*GIT, "branch", "-m", "unexpected"], cwd=repository,
                environment=bridge_v52_child_environment(os.environ))
        bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(os.environ)))

    fixture(BRIDGE_V52_ROUTE_CASES[7], wrong_branch)
    fixture(BRIDGE_V52_ROUTE_CASES[8], lambda repository:
            bridge_v52_expect_denial(
                lambda: doctor.bridge_v52_classify_actual_root(
                    repository, bridge_v52_child_environment(
                        os.environ, synthetic=True))))

    def placeholder_without_flag(repository):
        implementation = git("rev-parse", "HEAD", cwd=repository)
        bridge_v52_commit_child(repository, doctor, implementation)
        bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
            repository, bridge_v52_child_environment(os.environ)))

    final_result = bridge_v52_route_final_case(
        root_state, doctor, phase4, lifecycle, actual,
        placeholder_without_flag)
    return final_result


def bridge_v52_environment_base(environment):
    """Construct one hardened child base inside the first environment ID."""
    return bridge_v52_child_environment(environment)


def bridge_v52_environment_schedule():
    """Construct the exact ordered seven-entry environment mapping."""
    return tuple(zip(
        BRIDGE_V52_ENVIRONMENT_CASES,
        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
    ))


def bridge_v52_environment_identity(base, schedule):
    """Seal the child base and exact mutation schedule by identity."""
    return (base, schedule)


def bridge_v52_environment_identity_matches(sealed, base, schedule):
    """Validate the stored environment seal without reconstruction."""
    return sealed[0] is base and sealed[1] is schedule


def bridge_v52_environment_mutate(value, mutation):
    """Apply one already validated closed environment mutation."""
    operation, key, replacement = mutation
    if operation == "pop":
        require(replacement is None, "bridge52_environment_mapping")
        value.pop(key)
    else:
        require(operation == "set" and type(replacement) is str,
                "bridge52_environment_mapping")
        value[key] = replacement


def bridge_v52_environment_predicate(doctor, value):
    """Execute entry zero's real hardened-environment denial predicate."""
    bridge_v52_expect_denial(
        lambda: doctor.bridge_v52_hardened_environment(value))


def bridge_v52_environment_append(actual, case_id):
    """Append one observed environment case under its active owner."""
    actual.append(case_id)


def bridge_v52_environment_restoration(environment_before, command_before):
    """Validate ambient environment and command context restoration."""
    require(dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before,
            "bridge52_environment_first_restoration")


def bridge_v52_environment_finalization(lifecycle, actual, result, sealed,
                                        base, schedule, case_id):
    """Finalize entry zero only after exact append and restored state."""
    require(lifecycle.active_case == case_id and lifecycle.stages and
            lifecycle.stages[-1] == "case-partition-5" and
            tuple(actual) == (case_id,) and actual[0] is case_id and
            result is sealed and type(result) is tuple and len(result) == 2 and
            bridge_v52_environment_identity_matches(result, base, schedule),
            "bridge52_environment_first_finalization")


def bridge_v52_environment_first_case(doctor, lifecycle, actual):
    """Own exact environment setup, seal and entry-zero lifecycle."""
    case_id = "matrix-environment-global-missing"
    result = [None]
    sealed_identity = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        base = None
        schedule = None
        sealed = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-5" and
                    prefix == () and result[0] is None and
                    sealed_identity[0] is None,
                    "bridge52_environment_first_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            base = bridge_v52_environment_base(os.environ)
            require(type(base) is dict and
                    base.get("GIT_CONFIG_GLOBAL") == "/dev/null" and
                    base.get("GIT_CONFIG_NOSYSTEM") == "1" and
                    base.get("GIT_NO_REPLACE_OBJECTS") == "1" and
                    "GIT_CONFIG_SYSTEM" not in base and
                    BRIDGE_V52_PRIVATE_RECORD not in base and
                    BRIDGE_V52_SYNTHETIC_FLAG not in base and
                    not any(key.startswith("CODEX_") for key in base),
                    "bridge52_environment_first_base")
            schedule = bridge_v52_environment_schedule()
            require(type(schedule) is tuple and
                    all(type(entry) is tuple and len(entry) == 2 and
                        type(entry[0]) is str and
                        type(entry[1]) is tuple and len(entry[1]) == 3 and
                        type(entry[1][0]) is str and
                        type(entry[1][1]) is str and
                        (entry[1][2] is None or type(entry[1][2]) is str)
                        for entry in schedule),
                    "bridge52_environment_first_type")
            require(len(schedule) == 7,
                    "bridge52_environment_first_count")
            case_ids = tuple(entry[0] for entry in schedule)
            require(len(case_ids) == len(set(case_ids)),
                    "bridge52_environment_first_duplicate")
            require(set(case_ids) == set(BRIDGE_V52_ENVIRONMENT_CASES),
                    "bridge52_environment_first_omission")
            require(case_ids == BRIDGE_V52_ENVIRONMENT_CASES,
                    "bridge52_environment_first_order")
            require(tuple(entry[1] for entry in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_first_mapping")
            sealed = bridge_v52_environment_identity(base, schedule)
            sealed_identity[0] = sealed
            require(type(sealed) is tuple and len(sealed) == 2 and
                    sealed[0] is base and sealed[1] is schedule,
                    "bridge52_environment_first_seal")
            require(sealed_identity[0] is sealed and
                    bridge_v52_environment_identity_matches(
                        sealed_identity[0], base, schedule),
                    "bridge52_environment_first_identity")
            value = dict(base)
            bridge_v52_environment_mutate(value, schedule[0][1])
            bridge_v52_environment_predicate(doctor, value)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
            if environment_before is not None:
                bridge_v52_environment_restoration(
                    environment_before, command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                result[0] = sealed
                bridge_v52_environment_append(actual, case_id)
                bridge_v52_environment_finalization(
                    lifecycle, actual, result[0], sealed_identity[0],
                    base, schedule, case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            try:
                require((prefix is None or tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        result[0] is None and sealed_identity[0] is None,
                        "bridge52_environment_first_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)
    return result[0]


def bridge_v52_environment_second_access(returned_setup):
    """Access the stored first-case seal only under the second case owner."""
    return returned_setup


def bridge_v52_environment_second_unpack(accessed_setup):
    """Unpack the exact two-field setup only after identity validation."""
    return (accessed_setup[0], accessed_setup[1])


def bridge_v52_environment_second_identity(returned_setup):
    """Seal the exact returned setup object without copying it."""
    return returned_setup


def bridge_v52_environment_second_identity_matches(sealed, returned_setup,
                                                    accessed_setup):
    """Require both observed setup references to retain object identity."""
    return sealed is returned_setup and accessed_setup is sealed


def bridge_v52_environment_second_bind(schedule):
    """Bind exact entry one from the already validated stored schedule."""
    return schedule[1]


def bridge_v52_environment_second_append(actual, case_id):
    """Append entry one only under its active lifecycle owner."""
    actual.append(case_id)


def bridge_v52_environment_second_restoration(environment_before,
                                              command_before):
    """Validate second-case ambient environment/context restoration."""
    require(dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before,
            "bridge52_environment_second_restoration")


def bridge_v52_environment_second_finalization(
        lifecycle, actual, result, sealed, returned_setup, accessed_setup,
        base, schedule, entry, case_id):
    """Finalize entry one only after restored state and exact append."""
    expected = BRIDGE_V52_ENVIRONMENT_CASES[:2]
    require(lifecycle.active_case == case_id and lifecycle.stages and
            lifecycle.stages[-1] == "case-partition-5" and
            type(expected) is tuple and len(expected) == 2 and
            tuple(actual) == expected and
            actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
            actual[1] is case_id and result is sealed and
            bridge_v52_environment_second_identity_matches(
                sealed, returned_setup, accessed_setup) and
            bridge_v52_environment_identity_matches(
                accessed_setup, base, schedule) and
            entry is schedule[1] and entry[0] is case_id and
            entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[1],
            "bridge52_environment_second_finalization")


def bridge_v52_environment_second_case(
        doctor, lifecycle, actual, returned_setup):
    """Own returned-seal access, entry-one execution and prefix rollback."""
    case_id = "matrix-environment-global-wrong"
    result = [None]
    sealed_identity = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        accessed_setup = None
        base = None
        schedule = None
        entry = None
        sealed = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-5" and
                    prefix == BRIDGE_V52_ENVIRONMENT_CASES[:1] and
                    len(prefix) == 1 and
                    actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
                    result[0] is None and sealed_identity[0] is None,
                    "bridge52_environment_second_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            sealed = bridge_v52_environment_second_identity(returned_setup)
            sealed_identity[0] = sealed
            accessed_setup = bridge_v52_environment_second_access(
                returned_setup)
            require(type(accessed_setup) is tuple,
                    "bridge52_environment_second_type")
            require(len(accessed_setup) == 2,
                    "bridge52_environment_second_count")
            require(bridge_v52_environment_second_identity_matches(
                        sealed_identity[0], returned_setup, accessed_setup),
                    "bridge52_environment_second_identity")
            base, schedule = bridge_v52_environment_second_unpack(
                accessed_setup)
            require(type(base) is dict and accessed_setup[0] is base and
                    base.get("GIT_CONFIG_GLOBAL") == "/dev/null" and
                    base.get("GIT_CONFIG_NOSYSTEM") == "1" and
                    base.get("GIT_NO_REPLACE_OBJECTS") == "1" and
                    "GIT_CONFIG_SYSTEM" not in base and
                    BRIDGE_V52_PRIVATE_RECORD not in base and
                    BRIDGE_V52_SYNTHETIC_FLAG not in base and
                    not any(key.startswith("CODEX_") for key in base),
                    "bridge52_environment_second_base")
            require(type(schedule) is tuple and
                    accessed_setup[1] is schedule and len(schedule) == 7 and
                    all(type(item) is tuple and len(item) == 2 and
                        type(item[0]) is str and type(item[1]) is tuple and
                        len(item[1]) == 3 and type(item[1][0]) is str and
                        type(item[1][1]) is str and
                        (item[1][2] is None or type(item[1][2]) is str)
                        for item in schedule) and
                    bridge_v52_environment_identity_matches(
                        accessed_setup, base, schedule),
                    "bridge52_environment_second_schedule")
            require(tuple(item[0] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_CASES and
                    tuple(item[1] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_second_mapping")
            entry = bridge_v52_environment_second_bind(schedule)
            require(type(entry) is tuple and len(entry) == 2 and
                    entry is schedule[1] and entry[0] is case_id and
                    entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[1],
                    "bridge52_environment_second_bind")
            value = dict(base)
            bridge_v52_environment_mutate(value, entry[1])
            bridge_v52_environment_predicate(doctor, value)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
            if environment_before is not None:
                bridge_v52_environment_second_restoration(
                    environment_before, command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                result[0] = sealed
                bridge_v52_environment_second_append(actual, case_id)
                bridge_v52_environment_second_finalization(
                    lifecycle, actual, result[0], sealed_identity[0],
                    returned_setup, accessed_setup, base, schedule, entry,
                    case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            try:
                require((prefix is None or
                         prefix == BRIDGE_V52_ENVIRONMENT_CASES[:1] and
                         tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        result[0] is None and sealed_identity[0] is None,
                        "bridge52_environment_second_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)
    return result[0]


def bridge_v52_environment_third_access(returned_setup):
    """Access the stored second-case seal only under the third owner."""
    return returned_setup


def bridge_v52_environment_third_unpack(accessed_setup):
    """Unpack the exact two-field setup only after third-case sealing."""
    return (accessed_setup[0], accessed_setup[1])


def bridge_v52_environment_third_identity(returned_setup):
    """Seal the exact returned second-case setup without copying it."""
    return returned_setup


def bridge_v52_environment_third_identity_matches(sealed, returned_setup,
                                                   accessed_setup):
    """Require both third-case setup observations to retain identity."""
    return sealed is returned_setup and accessed_setup is sealed


def bridge_v52_environment_third_bind(schedule):
    """Bind exact entry two from the already validated stored schedule."""
    return schedule[2]


def bridge_v52_environment_third_append(actual, case_id):
    """Append entry two only under its active lifecycle owner."""
    actual.append(case_id)


def bridge_v52_environment_third_restoration(environment_before,
                                             command_before):
    """Validate third-case ambient environment/context restoration."""
    require(dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before,
            "bridge52_environment_third_restoration")


def bridge_v52_environment_third_finalization(
        lifecycle, actual, result, sealed, returned_setup, accessed_setup,
        base, schedule, entry, case_id):
    """Finalize entry two only after restored state and exact append."""
    expected = BRIDGE_V52_ENVIRONMENT_CASES[:3]
    require(lifecycle.active_case == case_id and lifecycle.stages and
            lifecycle.stages[-1] == "case-partition-5" and
            type(expected) is tuple and len(expected) == 3 and
            tuple(actual) == expected and
            actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
            actual[1] is BRIDGE_V52_ENVIRONMENT_CASES[1] and
            actual[2] is case_id and result is sealed and
            bridge_v52_environment_third_identity_matches(
                sealed, returned_setup, accessed_setup) and
            bridge_v52_environment_identity_matches(
                accessed_setup, base, schedule) and
            entry is schedule[2] and entry[0] is case_id and
            entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[2],
            "bridge52_environment_third_finalization")


def bridge_v52_environment_third_case(
        doctor, lifecycle, actual, returned_setup):
    """Own returned-seal access, entry-two execution and prefix rollback."""
    case_id = "matrix-environment-nosystem-missing"
    result = [None]
    sealed_identity = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        accessed_setup = None
        base = None
        schedule = None
        entry = None
        sealed = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-5" and
                    prefix == BRIDGE_V52_ENVIRONMENT_CASES[:2] and
                    len(prefix) == 2 and
                    actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
                    actual[1] is BRIDGE_V52_ENVIRONMENT_CASES[1] and
                    result[0] is None and sealed_identity[0] is None,
                    "bridge52_environment_third_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            sealed = bridge_v52_environment_third_identity(returned_setup)
            sealed_identity[0] = sealed
            accessed_setup = bridge_v52_environment_third_access(
                returned_setup)
            require(type(accessed_setup) is tuple,
                    "bridge52_environment_third_type")
            require(len(accessed_setup) == 2,
                    "bridge52_environment_third_count")
            require(bridge_v52_environment_third_identity_matches(
                        sealed_identity[0], returned_setup, accessed_setup),
                    "bridge52_environment_third_identity")
            base, schedule = bridge_v52_environment_third_unpack(
                accessed_setup)
            require(type(base) is dict and accessed_setup[0] is base and
                    base.get("GIT_CONFIG_GLOBAL") == "/dev/null" and
                    base.get("GIT_CONFIG_NOSYSTEM") == "1" and
                    base.get("GIT_NO_REPLACE_OBJECTS") == "1" and
                    "GIT_CONFIG_SYSTEM" not in base and
                    BRIDGE_V52_PRIVATE_RECORD not in base and
                    BRIDGE_V52_SYNTHETIC_FLAG not in base and
                    not any(key.startswith("CODEX_") for key in base),
                    "bridge52_environment_third_base")
            require(type(schedule) is tuple and
                    accessed_setup[1] is schedule and len(schedule) == 7 and
                    all(type(item) is tuple and len(item) == 2 and
                        type(item[0]) is str and type(item[1]) is tuple and
                        len(item[1]) == 3 and type(item[1][0]) is str and
                        type(item[1][1]) is str and
                        (item[1][2] is None or type(item[1][2]) is str)
                        for item in schedule) and
                    bridge_v52_environment_identity_matches(
                        accessed_setup, base, schedule),
                    "bridge52_environment_third_schedule")
            require(tuple(item[0] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_CASES and
                    tuple(item[1] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_third_mapping")
            entry = bridge_v52_environment_third_bind(schedule)
            require(type(entry) is tuple and len(entry) == 2 and
                    entry is schedule[2] and entry[0] is case_id and
                    entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[2],
                    "bridge52_environment_third_bind")
            value = dict(base)
            bridge_v52_environment_mutate(value, entry[1])
            bridge_v52_environment_predicate(doctor, value)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
            if environment_before is not None:
                bridge_v52_environment_third_restoration(
                    environment_before, command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                result[0] = sealed
                bridge_v52_environment_third_append(actual, case_id)
                bridge_v52_environment_third_finalization(
                    lifecycle, actual, result[0], sealed_identity[0],
                    returned_setup, accessed_setup, base, schedule, entry,
                    case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            try:
                require((prefix is None or
                         prefix == BRIDGE_V52_ENVIRONMENT_CASES[:2] and
                         tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        result[0] is None and sealed_identity[0] is None,
                        "bridge52_environment_third_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)
    return result[0]


