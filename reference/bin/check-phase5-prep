                        accessed_setup, base, schedule),
                    "bridge52_environment_fifth_schedule")
            require(tuple(item[0] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_CASES and
                    tuple(item[1] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_fifth_mapping")
            entry = bridge_v52_environment_fifth_bind(schedule)
            require(type(entry) is tuple and len(entry) == 2 and
                    entry is schedule[4] and entry[0] is case_id and
                    entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[4],
                    "bridge52_environment_fifth_bind")
            value = dict(base)
            bridge_v52_environment_mutate(value, entry[1])
            bridge_v52_environment_predicate(doctor, value)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
            if environment_before is not None:
                bridge_v52_environment_fifth_restoration(
                    environment_before, command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                result[0] = sealed
                bridge_v52_environment_fifth_append(actual, case_id)
                bridge_v52_environment_fifth_finalization(
                    lifecycle, actual, result[0], sealed_identity[0],
                    returned_setup, accessed_setup, base, schedule, entry,
                    case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            try:
                require((prefix is None or
                         prefix == BRIDGE_V52_ENVIRONMENT_CASES[:4] and
                         tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        result[0] is None and sealed_identity[0] is None,
                        "bridge52_environment_fifth_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)
    return result[0]


def bridge_v52_environment_sixth_access(returned_setup):
    """Access the stored fifth-case seal only under the sixth owner."""
    return returned_setup


def bridge_v52_environment_sixth_unpack(accessed_setup):
    """Unpack the exact two-field setup only after sixth-case sealing."""
    return (accessed_setup[0], accessed_setup[1])


def bridge_v52_environment_sixth_identity(returned_setup):
    """Seal the exact returned fifth-case setup without copying it."""
    return returned_setup


def bridge_v52_environment_sixth_identity_matches(sealed, returned_setup,
                                                   accessed_setup):
    """Require both sixth-case setup observations to retain identity."""
    return sealed is returned_setup and accessed_setup is sealed


def bridge_v52_environment_sixth_bind(schedule):
    """Bind exact entry five from the validated stored schedule."""
    return schedule[5]


def bridge_v52_environment_sixth_append(actual, case_id):
    """Append entry five only under its active lifecycle owner."""
    actual.append(case_id)


def bridge_v52_environment_sixth_restoration(environment_before,
                                             command_before):
    """Validate sixth-case ambient environment/context restoration."""
    require(dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before,
            "bridge52_environment_sixth_restoration")


def bridge_v52_environment_sixth_finalization(
        lifecycle, actual, result, sealed, returned_setup, accessed_setup,
        base, schedule, entry, case_id):
    """Finalize entry five only after restored state and exact append."""
    expected = BRIDGE_V52_ENVIRONMENT_CASES[:6]
    require(lifecycle.active_case == case_id and lifecycle.stages and
            lifecycle.stages[-1] == "case-partition-5" and
            type(expected) is tuple and len(expected) == 6 and
            tuple(actual) == expected and
            actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
            actual[1] is BRIDGE_V52_ENVIRONMENT_CASES[1] and
            actual[2] is BRIDGE_V52_ENVIRONMENT_CASES[2] and
            actual[3] is BRIDGE_V52_ENVIRONMENT_CASES[3] and
            actual[4] is BRIDGE_V52_ENVIRONMENT_CASES[4] and
            actual[5] is case_id and result is sealed and
            bridge_v52_environment_sixth_identity_matches(
                sealed, returned_setup, accessed_setup) and
            bridge_v52_environment_identity_matches(
                accessed_setup, base, schedule) and
            entry is schedule[5] and entry[0] is case_id and
            entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[5],
            "bridge52_environment_sixth_finalization")


def bridge_v52_environment_sixth_case(
        doctor, lifecycle, actual, returned_setup):
    """Own returned-seal access, entry-five execution and rollback."""
    case_id = "matrix-environment-no-replace-wrong"
    result = [None]
    sealed_identity = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        accessed_setup = None
        base = None
        schedule = None
        entry = None
        sealed = None
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-5" and
                    prefix == BRIDGE_V52_ENVIRONMENT_CASES[:5] and
                    len(prefix) == 5 and
                    actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
                    actual[1] is BRIDGE_V52_ENVIRONMENT_CASES[1] and
                    actual[2] is BRIDGE_V52_ENVIRONMENT_CASES[2] and
                    actual[3] is BRIDGE_V52_ENVIRONMENT_CASES[3] and
                    actual[4] is BRIDGE_V52_ENVIRONMENT_CASES[4] and
                    result[0] is None and sealed_identity[0] is None,
                    "bridge52_environment_sixth_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            sealed = bridge_v52_environment_sixth_identity(returned_setup)
            sealed_identity[0] = sealed
            accessed_setup = bridge_v52_environment_sixth_access(
                returned_setup)
            require(type(accessed_setup) is tuple,
                    "bridge52_environment_sixth_type")
            require(len(accessed_setup) == 2,
                    "bridge52_environment_sixth_count")
            require(bridge_v52_environment_sixth_identity_matches(
                        sealed_identity[0], returned_setup, accessed_setup),
                    "bridge52_environment_sixth_identity")
            base, schedule = bridge_v52_environment_sixth_unpack(
                accessed_setup)
            require(type(base) is dict and accessed_setup[0] is base and
                    base.get("GIT_CONFIG_GLOBAL") == "/dev/null" and
                    base.get("GIT_CONFIG_NOSYSTEM") == "1" and
                    base.get("GIT_NO_REPLACE_OBJECTS") == "1" and
                    "GIT_CONFIG_SYSTEM" not in base and
                    BRIDGE_V52_PRIVATE_RECORD not in base and
                    BRIDGE_V52_SYNTHETIC_FLAG not in base and
                    not any(key.startswith("CODEX_") for key in base),
                    "bridge52_environment_sixth_base")
            require(type(schedule) is tuple and
                    accessed_setup[1] is schedule and len(schedule) == 7 and
                    all(type(item) is tuple and len(item) == 2 and
                        type(item[0]) is str and type(item[1]) is tuple and
                        len(item[1]) == 3 and type(item[1][0]) is str and
                        type(item[1][1]) is str and
                        (item[1][2] is None or type(item[1][2]) is str)
                        for item in schedule) and
                    bridge_v52_environment_identity_matches(
                        accessed_setup, base, schedule),
                    "bridge52_environment_sixth_schedule")
            require(tuple(item[0] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_CASES and
                    tuple(item[1] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_sixth_mapping")
            entry = bridge_v52_environment_sixth_bind(schedule)
            require(type(entry) is tuple and len(entry) == 2 and
                    entry is schedule[5] and entry[0] is case_id and
                    entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[5],
                    "bridge52_environment_sixth_bind")
            value = dict(base)
            bridge_v52_environment_mutate(value, entry[1])
            bridge_v52_environment_predicate(doctor, value)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
            if environment_before is not None:
                bridge_v52_environment_sixth_restoration(
                    environment_before, command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                result[0] = sealed
                bridge_v52_environment_sixth_append(actual, case_id)
                bridge_v52_environment_sixth_finalization(
                    lifecycle, actual, result[0], sealed_identity[0],
                    returned_setup, accessed_setup, base, schedule, entry,
                    case_id)
            except Exception as error:
                first_error = error

        if first_error is not None:
            result[0] = None
            sealed_identity[0] = None
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            try:
                require((prefix is None or
                         prefix == BRIDGE_V52_ENVIRONMENT_CASES[:5] and
                         tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        result[0] is None and sealed_identity[0] is None,
                        "bridge52_environment_sixth_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)
    return result[0]


def bridge_v52_environment_seventh_access(returned_setup):
    """Access the stored sixth-case seal only under the seventh owner."""
    return returned_setup


def bridge_v52_environment_seventh_unpack(accessed_setup):
    """Unpack the exact two-field setup only after seventh-case sealing."""
    return (accessed_setup[0], accessed_setup[1])


def bridge_v52_environment_seventh_identity(returned_setup):
    """Seal the exact returned sixth-case setup without copying it."""
    return returned_setup


def bridge_v52_environment_seventh_identity_matches(sealed, returned_setup,
                                                     accessed_setup):
    """Require both seventh-case setup observations to retain identity."""
    return sealed is returned_setup and accessed_setup is sealed


def bridge_v52_environment_seventh_bind(schedule):
    """Bind exact entry six from the validated stored schedule."""
    return schedule[6]


def bridge_v52_environment_pending_event(prefix, final_case):
    """Construct the exact env7 tuple inside the existing final owner."""
    require(type(prefix) is tuple and type(final_case) is str,
            "bridge52_environment_final_construction")
    return (*prefix, final_case)


def bridge_v52_environment_unique(events):
    """Observe exact environment-result uniqueness without authority."""
    return len(events) == len(set(events))


def bridge_v52_environment_equal(events):
    """Compare the observed result to the closed env7 authority."""
    return events == BRIDGE_V52_ENVIRONMENT_CASES


def bridge_v52_environment_result_identity(pending):
    """Seal one exact environment result by object identity."""
    return (pending,)


def bridge_v52_environment_result_identity_matches(sealed, result):
    """Validate the stored env7 seal without reconstructing its value."""
    return sealed[0] is result


def bridge_v52_exact234_source_identity(
        phase4_first, phase4_facts, local, route, environment, diagnostics):
    """Seal the six exact aggregate sources without copying their values."""
    return (phase4_first, phase4_facts, local, route, environment,
            diagnostics)


def bridge_v52_exact234_result_identity(sources, result_pair):
    """Seal the exact aggregate pair and all source object identities."""
    return (sources, result_pair, result_pair[1])


def bridge_v52_exact234_result_identity_matches(sealed, sources,
                                                 result_pair):
    """Validate the exact aggregate pair without recomputation."""
    return (type(sealed) is tuple and len(sealed) == 3 and
            sealed[0] is sources and sealed[1] is result_pair and
            sealed[2] is result_pair[1] and
            type(sources) is tuple and len(sources) == 6 and
            type(result_pair) is tuple and len(result_pair) == 2 and
            result_pair[0] is sources[4] and
            result_pair[1] is sealed[2])


def bridge_v52_exact234_construction(
        phase4_cases, local, route, environment, diagnostics):
    """Construct the exact aggregate once from the observed source values."""
    return phase4_cases + local + route + environment + diagnostics


def bridge_v52_exact234_expected(phase4_expected):
    """Construct the closed exact234 authority independently of result."""
    return (phase4_expected + BRIDGE_V52_LOCAL_CASES +
            BRIDGE_V52_ROUTE_CASES + BRIDGE_V52_ENVIRONMENT_CASES +
            BRIDGE_V52_DIAGNOSTIC_CASES)


def bridge_v52_exact234_equal(result, expected):
    """Compare the constructed aggregate with the closed authority."""
    return result == expected


def bridge_v52_exact234_unique(result):
    """Validate exact aggregate uniqueness without changing order."""
    return len(result) == len(set(result))


def bridge_v52_exact234_aggregate(
        phase4, phase4_first, phase4_facts, local, route, environment,
        diagnostics):
    """Construct and seal exact234 from the six observed result sources."""
    require(type(phase4) is types.ModuleType and
            type(phase4_first) is tuple and len(phase4_first) == 1 and
            type(phase4_facts) is dict and set(phase4_facts) == {
                "ambientAttempted", "ambientCases", "caseIDs", "factCases",
                "historicalCases", "ownerCases", "rawCases",
                "topologyCases", "facts",
            } and
            type(phase4_facts["caseIDs"]) is list and
            all(type(case_id) is str
                for case_id in phase4_facts["caseIDs"]) and
            len(phase4_facts["caseIDs"]) == 128 and
            len(set(phase4_facts["caseIDs"])) == 128 and
            type(phase4_facts["ambientAttempted"]) is int and
            phase4_facts["ambientAttempted"] == 0 and
            type(phase4_facts["ambientCases"]) is int and
            phase4_facts["ambientCases"] == 20 and
            type(phase4_facts["factCases"]) is int and
            phase4_facts["factCases"] == 75 and
            type(phase4_facts["rawCases"]) is int and
            phase4_facts["rawCases"] == 24 and
            type(phase4_facts["historicalCases"]) is int and
            phase4_facts["historicalCases"] == 7 and
            type(phase4_facts["ownerCases"]) is int and
            phase4_facts["ownerCases"] == 2 and
            type(phase4_facts["topologyCases"]) is int and
            phase4_facts["topologyCases"] == 20 and
            type(phase4_facts["facts"]) is dict and
            type(local) is tuple and type(route) is tuple and
            type(environment) is tuple and type(diagnostics) is list,
            "bridge52_exact234_source_type")
    sources = bridge_v52_exact234_source_identity(
        phase4_first, phase4_facts, local, route, environment, diagnostics)
    require(sources[0] is phase4_first and
            sources[1] is phase4_facts and sources[2] is local and
            sources[3] is route and sources[4] is environment and
            sources[5] is diagnostics,
            "bridge52_exact234_source_identity")

    phase4_expected = (
        phase4.BRIDGE_V52_PHASE4_FACT_CASES +
        phase4.BRIDGE_V52_PHASE4_RAW_CASES +
        phase4.BRIDGE_V52_PHASE4_HISTORY_CASES +
        phase4.BRIDGE_V52_PHASE4_OWNER_CASES +
        phase4.BRIDGE_V52_PHASE4_TOPOLOGY_CASES
    )
    phase4_cases = phase4_first + tuple(phase4_facts["caseIDs"][1:])
    diagnostic_cases = tuple(diagnostics)
    require(type(phase4_expected) is tuple and
            type(phase4_cases) is tuple and len(phase4_cases) == 128 and
            phase4_first == phase4_expected[:1] and
            phase4_cases == phase4_expected and
            local == BRIDGE_V52_LOCAL_CASES and
            route == BRIDGE_V52_ROUTE_CASES and
            environment == BRIDGE_V52_ENVIRONMENT_CASES and
            diagnostic_cases == BRIDGE_V52_DIAGNOSTIC_CASES,
            "bridge52_exact234_source_order")

    result = bridge_v52_exact234_construction(
        phase4_cases, local, route, environment, diagnostic_cases)
    expected = bridge_v52_exact234_expected(phase4_expected)
    require(type(result) is tuple and
            all(type(case_id) is str for case_id in result),
            "bridge52_exact234_type")
    require(len(result) == 234, "bridge52_exact234_count")
    require(result[:128] == phase4_cases and
            result[128:205] == local and
            result[205:215] == route and
            result[215:222] == environment and
            result[222:] == diagnostic_cases,
            "bridge52_exact234_order")
    require(bridge_v52_exact234_equal(result, expected),
            "bridge52_exact234_equality")
    require(bridge_v52_exact234_unique(result),
            "bridge52_exact234_unique")
    require(bridge_v52_tuple_digest(result) == BRIDGE_V52_CASE_DIGEST,
            "bridge52_exact234_digest")

    result_pair = (environment, result)
    sealed = bridge_v52_exact234_result_identity(sources, result_pair)
    require(bridge_v52_exact234_result_identity_matches(
                sealed, sources, result_pair) and
            result_pair[0] is environment and result_pair[1] is result,
            "bridge52_exact234_identity")
    return (result_pair, sealed)


def bridge_v52_environment_seventh_append(actual, case_id):
    """Append entry six only under its active lifecycle owner."""
    actual.append(case_id)


def bridge_v52_environment_seventh_restoration(environment_before,
                                               command_before):
    """Validate seventh-case ambient environment/context restoration."""
    require(dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before,
            "bridge52_environment_seventh_restoration")


def bridge_v52_environment_post_cases_guard(
        lifecycle, actual, result, sealed, case_id):
    """Guard the post-cases transition with the sealed final env result."""
    return (lifecycle.active_case == case_id and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            result is not None and type(result) is tuple and
            type(sealed) is tuple and len(sealed) == 1 and
            sealed[0] is result and
            bridge_v52_environment_result_identity_matches(sealed, result))


def bridge_v52_environment_post_cases_transition(
        lifecycle, actual, result, sealed, case_id):
    """Advance post-cases inside the existing final environment owner."""
    prior_stages = tuple(lifecycle.stages)
    rollback_stages = BRIDGE_V52_STAGES[:12]
    stage = "post-cases"
    first_error = None
    try:
        require(bridge_v52_environment_post_cases_guard(
                    lifecycle, actual, result, sealed, case_id),
                "bridge52_environment_post_cases_guard")
        require(type(lifecycle.stages) is list and
                prior_stages == BRIDGE_V52_STAGES[:12] and
                len(prior_stages) == 12 and
                prior_stages[-1] == "case-partition-5",
                "bridge52_environment_post_cases_prior_prefix")
        expected = bridge_v52_lifecycle_expected_stage(
            len(lifecycle.stages))
        require(expected == stage and BRIDGE_V52_STAGES[12] == stage,
                "bridge52_environment_post_cases_order")
        bridge_v52_lifecycle_append(lifecycle.stages, stage)
        require(tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:13] and
                len(lifecycle.stages) == 13 and
                lifecycle.stages[-1] == stage,
                "bridge52_environment_post_cases_resulting_stage")
    except Exception as error:
        if lifecycle.first_failure is None:
            reason = str(error)
            lifecycle.first_failure = {
                "caseID": case_id,
                "reason": reason if re.fullmatch(
                    r"bridge52_[a-z0-9_]+", reason) else
                    "bridge52_internal",
                "result": "fail",
                "stage": stage,
                "status": "failed",
            }
        first_error = error

    if first_error is not None:
        restored = False
        for _attempt in range(2):
            try:
                bridge_v52_lifecycle_restore(
                    lifecycle.stages, rollback_stages)
            except Exception:
                continue
            restored = True
            break
        if not restored or tuple(lifecycle.stages) != rollback_stages:
            lifecycle.stages[:] = rollback_stages
        try:
            require(tuple(lifecycle.stages) == rollback_stages and
                    rollback_stages == BRIDGE_V52_STAGES[:12],
                    "bridge52_environment_post_cases_rollback")
        except Exception:
            pass
        raise first_error


def bridge_v52_environment_seventh_finalization(
        lifecycle, actual, pending, result, sealed, setup_seal,
        returned_setup, accessed_setup, base, schedule, entry, case_id,
        environment_before, command_before):
    """Finalize entry six only after restored state and exact env7 seal."""
    require(lifecycle.active_case == case_id and lifecycle.stages and
            lifecycle.stages[-1] == "case-partition-5" and
            type(pending) is tuple and len(pending) == 7 and
            bridge_v52_environment_equal(pending) and
            bridge_v52_environment_unique(pending) and
            tuple(actual) == pending and
            all(value is pending[index]
                for index, value in enumerate(actual)) and
            result is pending and type(sealed) is tuple and
            len(sealed) == 1 and sealed[0] is result and
            bridge_v52_environment_result_identity_matches(sealed, result) and
            bridge_v52_environment_seventh_identity_matches(
                setup_seal, returned_setup, accessed_setup) and
            bridge_v52_environment_identity_matches(
                accessed_setup, base, schedule) and
            entry is schedule[6] and entry[0] is case_id and
            entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[6] and
            dict(os.environ) == environment_before and
            _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is command_before,
            "bridge52_environment_seventh_finalization")


def bridge_v52_environment_aggregate_finalization(
        lifecycle, actual, environment_result, aggregate_result,
        aggregate_seal, aggregate_calls, case_id):
    """Finalize exact234 while the final environment owner is still active."""
    require(lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:13] and
            lifecycle.stages[-1] == "post-cases" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            aggregate_calls == 1 and type(aggregate_result) is tuple and
            len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_result[1]) is tuple and
            len(aggregate_result[1]) == 234 and
            aggregate_result[1] == (
                _BRIDGE_V52_PHASE4_MODULE.BRIDGE_V52_PHASE4_FACT_CASES +
                _BRIDGE_V52_PHASE4_MODULE.BRIDGE_V52_PHASE4_RAW_CASES +
                _BRIDGE_V52_PHASE4_MODULE.BRIDGE_V52_PHASE4_HISTORY_CASES +
                _BRIDGE_V52_PHASE4_MODULE.BRIDGE_V52_PHASE4_OWNER_CASES +
                _BRIDGE_V52_PHASE4_MODULE.BRIDGE_V52_PHASE4_TOPOLOGY_CASES +
                BRIDGE_V52_LOCAL_CASES + BRIDGE_V52_ROUTE_CASES +
                BRIDGE_V52_ENVIRONMENT_CASES +
                BRIDGE_V52_DIAGNOSTIC_CASES) and
            bridge_v52_tuple_digest(aggregate_result[1]) ==
                BRIDGE_V52_CASE_DIGEST and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            type(aggregate_seal[0]) is tuple and
            len(aggregate_seal[0]) == 6 and
            aggregate_seal[0][4] is environment_result and
            aggregate_seal[0][5] is lifecycle.diagnostics and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result),
            "bridge52_exact234_finalization")


def bridge_v52_environment_post_provider_guard(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, case_id):
    """Guard post-provider with the completed exact234 callback seals."""
    return (lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:13] and
            lifecycle.stages[-1] == "post-cases" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            bridge_v52_environment_result_identity_matches(
                environment_seal, environment_result) and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result))


def bridge_v52_environment_post_provider_finalization(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, case_id):
    """Finalize post-provider inside the final environment owner."""
    require(lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:14] and
            lifecycle.stages[-1] == "post-provider" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_result[1]) is tuple and
            len(aggregate_result[1]) == 234 and
            bridge_v52_tuple_digest(aggregate_result[1]) ==
                BRIDGE_V52_CASE_DIGEST and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result),
            "bridge52_environment_post_provider_finalization")


def bridge_v52_environment_post_provider_transition(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, case_id):
    """Advance post-provider under the completed final environment owner."""
    prior_stages = tuple(lifecycle.stages)
    rollback_stages = BRIDGE_V52_STAGES[:12]
    stage = "post-provider"
    first_error = None
    try:
        require(bridge_v52_environment_post_provider_guard(
                    lifecycle, actual, environment_result, environment_seal,
                    aggregate_result, aggregate_seal, aggregate_calls,
                    aggregate_completed, case_id),
                "bridge52_environment_post_provider_guard")
        require(type(lifecycle.stages) is list and
                prior_stages == BRIDGE_V52_STAGES[:13] and
                len(prior_stages) == 13 and
                prior_stages[-1] == "post-cases",
                "bridge52_environment_post_provider_prior_prefix")
        expected = bridge_v52_lifecycle_expected_stage(
            len(lifecycle.stages))
        require(expected == stage and BRIDGE_V52_STAGES[13] == stage,
                "bridge52_environment_post_provider_order")
        bridge_v52_lifecycle_append(lifecycle.stages, stage)
        require(tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:14] and
                len(lifecycle.stages) == 14 and
                lifecycle.stages[-1] == stage,
                "bridge52_environment_post_provider_resulting_stage")
        bridge_v52_environment_post_provider_finalization(
            lifecycle, actual, environment_result, environment_seal,
            aggregate_result, aggregate_seal, aggregate_calls,
            aggregate_completed, case_id)
    except Exception as error:
        if lifecycle.first_failure is None:
            reason = str(error)
            lifecycle.first_failure = {
                "caseID": case_id,
                "reason": reason if re.fullmatch(
                    r"bridge52_[a-z0-9_]+", reason) else
                    "bridge52_internal",
                "result": "fail",
                "stage": stage,
                "status": "failed",
            }
        first_error = error

    if first_error is not None:
        restored = False
        for _attempt in range(2):
            try:
                bridge_v52_lifecycle_restore(
                    lifecycle.stages, rollback_stages)
            except Exception:
                continue
            restored = True
            break
        if not restored or tuple(lifecycle.stages) != rollback_stages:
            lifecycle.stages[:] = rollback_stages
        try:
            require(tuple(lifecycle.stages) == rollback_stages and
                    rollback_stages == BRIDGE_V52_STAGES[:12],
                    "bridge52_environment_post_provider_rollback")
        except Exception:
            pass
        raise first_error


def bridge_v52_outer_environment_identity(environment):
    """Seal the independently captured outer environment by identity."""
    return (environment,)


def bridge_v52_outer_environment_access(sealed):
    """Access the independently captured outer environment through its seal."""
    return sealed[0]


def bridge_v52_outer_environment_identity_matches(
        sealed, environment, accessed):
    """Require one exact outer-environment object across capture and use."""
    return (type(sealed) is tuple and len(sealed) == 1 and
            sealed[0] is environment and accessed is environment)


def bridge_v52_outer_environment_restore(environment):
    """Restore and validate the complete independently captured environment."""
    require(type(environment) is dict and
            all(type(key) is str and type(value) is str
                for key, value in environment.items()),
            "bridge52_outer_environment_type")
    if dict(os.environ) != environment:
        os.environ.clear()
        os.environ.update(environment)
    require(dict(os.environ) == environment,
            "bridge52_outer_environment_restoration")


def bridge_v52_outer_environment_predicate(environment):
    """Require exact equality with the independently captured environment."""
    require(type(environment) is dict and
            dict(os.environ) == environment,
            "bridge52_outer_environment_predicate")


def bridge_v52_environment_post_environment_guard(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed, case_id,
        outer_environment, outer_environment_seal,
        accessed_outer_environment):
    """Guard post-environment with provider and outer-baseline seals."""
    return (lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:14] and
            lifecycle.stages[-1] == "post-provider" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            bridge_v52_environment_result_identity_matches(
                environment_seal, environment_result) and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(post_provider_completed) is bool and
            post_provider_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(outer_environment) is dict and
            bridge_v52_outer_environment_identity_matches(
                outer_environment_seal, outer_environment,
                accessed_outer_environment) and
            dict(os.environ) == accessed_outer_environment)


def bridge_v52_environment_post_environment_finalization(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed, case_id,
        outer_environment, outer_environment_seal,
        accessed_outer_environment):
    """Finalize post-environment and exact full-environment restoration."""
    require(lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:15] and
            lifecycle.stages[-1] == "post-environment" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(post_provider_completed) is bool and
            post_provider_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(outer_environment) is dict and
            bridge_v52_outer_environment_identity_matches(
                outer_environment_seal, outer_environment,
                accessed_outer_environment) and
            dict(os.environ) == accessed_outer_environment,
            "bridge52_environment_post_environment_finalization")


def bridge_v52_environment_post_environment_transition(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed, case_id,
        outer_environment, outer_environment_seal):
    """Advance post-environment under the final environment owner."""
    prior_stages = tuple(lifecycle.stages)
    rollback_stages = BRIDGE_V52_STAGES[:12]
    stage = "post-environment"
    accessed_outer_environment = None
    first_error = None
    try:
        require(type(outer_environment_seal) is tuple and
                len(outer_environment_seal) == 1,
                "bridge52_outer_environment_seal")
        accessed_outer_environment = bridge_v52_outer_environment_access(
            outer_environment_seal)
        require(type(outer_environment) is dict and
                bridge_v52_outer_environment_identity_matches(
                    outer_environment_seal, outer_environment,
                    accessed_outer_environment),
                "bridge52_outer_environment_identity")
        require(bridge_v52_environment_post_environment_guard(
                    lifecycle, actual, environment_result, environment_seal,
                    aggregate_result, aggregate_seal, aggregate_calls,
                    aggregate_completed, post_provider_completed, case_id,
                    outer_environment, outer_environment_seal,
                    accessed_outer_environment),
                "bridge52_environment_post_environment_guard")
        require(type(lifecycle.stages) is list and
                prior_stages == BRIDGE_V52_STAGES[:14] and
                len(prior_stages) == 14 and
                prior_stages[-1] == "post-provider",
                "bridge52_environment_post_environment_prior_prefix")
        expected = bridge_v52_lifecycle_expected_stage(
            len(lifecycle.stages))
        require(expected == stage and BRIDGE_V52_STAGES[14] == stage,
                "bridge52_environment_post_environment_order")
        bridge_v52_lifecycle_append(lifecycle.stages, stage)
        require(tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:15] and
                len(lifecycle.stages) == 15 and
                lifecycle.stages[-1] == stage,
                "bridge52_environment_post_environment_resulting_stage")
        bridge_v52_outer_environment_predicate(accessed_outer_environment)
        bridge_v52_outer_environment_restore(accessed_outer_environment)
        bridge_v52_environment_post_environment_finalization(
            lifecycle, actual, environment_result, environment_seal,
            aggregate_result, aggregate_seal, aggregate_calls,
            aggregate_completed, post_provider_completed, case_id,
            outer_environment, outer_environment_seal,
            accessed_outer_environment)
    except Exception as error:
        if lifecycle.first_failure is None:
            reason = str(error)
            lifecycle.first_failure = {
                "caseID": case_id,
                "reason": reason if re.fullmatch(
                    r"bridge52_[a-z0-9_]+", reason) else
                    "bridge52_internal",
                "result": "fail",
                "stage": stage,
                "status": "failed",
            }
        first_error = error

    if first_error is not None:
        try:
            bridge_v52_outer_environment_restore(outer_environment)
        except Exception:
            try:
                if (type(outer_environment) is dict and
                        dict(os.environ) != outer_environment):
                    os.environ.clear()
                    os.environ.update(outer_environment)
            except Exception:
                pass
        restored = False
        for _attempt in range(2):
            try:
                bridge_v52_lifecycle_restore(
                    lifecycle.stages, rollback_stages)
            except Exception:
                continue
            restored = True
            break
        if not restored or tuple(lifecycle.stages) != rollback_stages:
            lifecycle.stages[:] = rollback_stages
        try:
            require(tuple(lifecycle.stages) == rollback_stages and
                    rollback_stages == BRIDGE_V52_STAGES[:12] and
                    type(outer_environment) is dict and
                    dict(os.environ) == outer_environment,
                    "bridge52_environment_post_environment_rollback")
        except Exception:
            pass
        raise first_error


def bridge_v52_module_cleanup_identity(fields):
    """Seal the exact transient module objects and provider context."""
    return (fields,)


def bridge_v52_module_cleanup_identity_matches(
        sealed, fields, doctor_module, phase4_module, provider_context):
    """Validate one exact cleanup result without reconstructing it."""
    return (type(fields) is tuple and len(fields) == 3 and
            fields[0] is doctor_module and
            fields[1] is phase4_module and
            fields[2] is provider_context and
            type(sealed) is tuple and len(sealed) == 1 and
            sealed[0] is fields and
            _BRIDGE_V52_DOCTOR_MODULE is None and
            _BRIDGE_V52_PHASE4_MODULE is None and
            phase4_module._BRIDGE_V52_PROVIDER_TOKEN is None and
            phase4_module._BRIDGE_V52_PROVIDER_CONTEXT is provider_context and
            provider_context.get() is None and
            phase4_module._BRIDGE_V52_DOCTOR is None and
            sys.modules.get("bridge_v52_phase4_provider") is None and
            sys.modules.get("bridge_v52_phase4_doctor") is None)


def bridge_v52_environment_post_cleanup_guard(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed,
        post_environment_completed, case_id, outer_environment,
        outer_environment_seal, doctor_module, phase4_module,
        provider_context):
    """Guard cleanup with the completed post-environment identity chain."""
    return (lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:15] and
            lifecycle.stages[-1] == "post-environment" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            bridge_v52_environment_result_identity_matches(
                environment_seal, environment_result) and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(post_provider_completed) is bool and
            post_provider_completed is True and
            type(post_environment_completed) is bool and
            post_environment_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(outer_environment) is dict and
            type(outer_environment_seal) is tuple and
            len(outer_environment_seal) == 1 and
            outer_environment_seal[0] is outer_environment and
            dict(os.environ) == outer_environment and
            doctor_module is _BRIDGE_V52_DOCTOR_MODULE and
            phase4_module is _BRIDGE_V52_PHASE4_MODULE and
            doctor_module is not None and phase4_module is not None and
            phase4_module._BRIDGE_V52_DOCTOR is doctor_module and
            phase4_module._BRIDGE_V52_PROVIDER_CONTEXT is provider_context and
            phase4_module._BRIDGE_V52_PROVIDER_TOKEN is None and
            provider_context.get() is None and
            sys.modules.get("bridge_v52_phase4_doctor") is doctor_module and
            sys.modules.get("bridge_v52_phase4_provider") is None)


def bridge_v52_environment_post_cleanup_finalization(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed,
        post_environment_completed, case_id, outer_environment,
        outer_environment_seal, doctor_module, phase4_module,
        provider_context, cleanup_fields, cleanup_seal):
    """Finalize exact module/context cleanup under the final case owner."""
    require(lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:16] and
            lifecycle.stages[-1] == "post-cleanup" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(post_provider_completed) is bool and
            post_provider_completed is True and
            type(post_environment_completed) is bool and
            post_environment_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(outer_environment) is dict and
            type(outer_environment_seal) is tuple and
            len(outer_environment_seal) == 1 and
            outer_environment_seal[0] is outer_environment and
            dict(os.environ) == outer_environment and
            bridge_v52_module_cleanup_identity_matches(
                cleanup_seal, cleanup_fields, doctor_module, phase4_module,
                provider_context),
            "bridge52_environment_post_cleanup_finalization")


def bridge_v52_environment_post_cleanup_transition(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed,
        post_environment_completed, case_id, outer_environment,
        outer_environment_seal, doctor_module, phase4_module):
    """Advance and seal unconditional cleanup under the final case owner."""
    rollback_stages = BRIDGE_V52_STAGES[:12]
    stage = "post-cleanup"
    provider_context = None
    cleanup_fields = None
    cleanup_seal = None
    cleanup_completed = False
    first_error = None
    try:
        provider_context = phase4_module._BRIDGE_V52_PROVIDER_CONTEXT
        require(bridge_v52_environment_post_cleanup_guard(
                    lifecycle, actual, environment_result, environment_seal,
                    aggregate_result, aggregate_seal, aggregate_calls,
                    aggregate_completed, post_provider_completed,
                    post_environment_completed, case_id, outer_environment,
                    outer_environment_seal, doctor_module, phase4_module,
                    provider_context),
                "bridge52_environment_post_cleanup_guard")
        prior_stages = tuple(lifecycle.stages)
        require(type(lifecycle.stages) is list and
                prior_stages == BRIDGE_V52_STAGES[:15] and
                len(prior_stages) == 15 and
                prior_stages[-1] == "post-environment",
                "bridge52_environment_post_cleanup_prior_prefix")
        expected = bridge_v52_lifecycle_expected_stage(
            len(lifecycle.stages))
        require(expected == stage and BRIDGE_V52_STAGES[15] == stage,
                "bridge52_environment_post_cleanup_order")
        bridge_v52_lifecycle_append(lifecycle.stages, stage)
        require(tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:16] and
                len(lifecycle.stages) == 16 and
                lifecycle.stages[-1] == stage,
                "bridge52_environment_post_cleanup_resulting_stage")
        cleanup_fields = bridge_v52_unload_modules(
            doctor_module, phase4_module)
        cleanup_completed = True
        require(type(cleanup_fields) is tuple and len(cleanup_fields) == 3 and
                cleanup_fields[0] is doctor_module and
                cleanup_fields[1] is phase4_module and
                cleanup_fields[2] is provider_context,
                "bridge52_environment_post_cleanup_result")
        cleanup_seal = bridge_v52_module_cleanup_identity(cleanup_fields)
        require(type(cleanup_seal) is tuple and len(cleanup_seal) == 1 and
                cleanup_seal[0] is cleanup_fields and
                bridge_v52_module_cleanup_identity_matches(
                    cleanup_seal, cleanup_fields, doctor_module,
                    phase4_module, provider_context),
                "bridge52_environment_post_cleanup_seal")
        bridge_v52_environment_post_cleanup_finalization(
            lifecycle, actual, environment_result, environment_seal,
            aggregate_result, aggregate_seal, aggregate_calls,
            aggregate_completed, post_provider_completed,
            post_environment_completed, case_id, outer_environment,
            outer_environment_seal, doctor_module, phase4_module,
            provider_context, cleanup_fields, cleanup_seal)
    except Exception as error:
        if lifecycle.first_failure is None:
            reason = str(error)
            lifecycle.first_failure = {
                "caseID": case_id,
                "reason": reason if re.fullmatch(
                    r"bridge52_[a-z0-9_]+", reason) else
                    "bridge52_internal",
                "result": "fail",
                "stage": stage,
                "status": "failed",
            }
        first_error = error
    finally:
        if not cleanup_completed:
            try:
                bridge_v52_unload_modules(doctor_module, phase4_module)
                cleanup_completed = True
            except Exception as cleanup_error:
                if first_error is None:
                    if lifecycle.first_failure is None:
                        reason = str(cleanup_error)
                        lifecycle.first_failure = {
                            "caseID": case_id,
                            "reason": reason if re.fullmatch(
                                r"bridge52_[a-z0-9_]+", reason) else
                                "bridge52_internal",
                            "result": "fail",
                            "stage": stage,
                            "status": "failed",
                        }
                    first_error = cleanup_error

    if first_error is not None:
        restored = False
        for _attempt in range(2):
            try:
                bridge_v52_lifecycle_restore(
                    lifecycle.stages, rollback_stages)
            except Exception:
                continue
            restored = True
            break
        if not restored or tuple(lifecycle.stages) != rollback_stages:
            lifecycle.stages[:] = rollback_stages
        try:
            require(tuple(lifecycle.stages) == rollback_stages and
                    rollback_stages == BRIDGE_V52_STAGES[:12] and
                    _BRIDGE_V52_DOCTOR_MODULE is None and
                    _BRIDGE_V52_PHASE4_MODULE is None and
                    sys.modules.get("bridge_v52_phase4_provider") is None and
                    sys.modules.get("bridge_v52_phase4_doctor") is None and
                    (phase4_module is None or
                     phase4_module._BRIDGE_V52_PROVIDER_TOKEN is None) and
                    (provider_context is None or
                     provider_context.get() is None),
                    "bridge52_environment_post_cleanup_rollback")
        except Exception:
            pass
        raise first_error
    return (cleanup_fields, cleanup_seal)


def bridge_v52_stage_pending_event(prefix, stage):
    """Construct the one pending final-stage result from its exact prefix."""
    return (*prefix, stage)


def bridge_v52_stage_unique(stages):
    """Require every final lifecycle stage to occur exactly once."""
    return len(set(stages)) == len(stages)


def bridge_v52_stage_equal(stages):
    """Compare the constructed lifecycle result to the canonical contract."""
    return stages == BRIDGE_V52_STAGES


def bridge_v52_stage_result_identity(stage_result, cleanup_seal):
    """Seal the exact final stage result to the completed cleanup seal."""
    return (stage_result, cleanup_seal)


def bridge_v52_stage_result_identity_matches(
        sealed, stage_result, cleanup_seal, cleanup_fields,
        doctor_module, phase4_module, provider_context):
    """Validate one final stage result without rebuilding either identity."""
    return (type(stage_result) is tuple and
            stage_result == BRIDGE_V52_STAGES and
            type(cleanup_seal) is tuple and len(cleanup_seal) == 1 and
            type(sealed) is tuple and len(sealed) == 2 and
            sealed[0] is stage_result and sealed[1] is cleanup_seal and
            bridge_v52_module_cleanup_identity_matches(
                cleanup_seal, cleanup_fields, doctor_module, phase4_module,
                provider_context))


def bridge_v52_environment_post_return_guard(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed,
        post_environment_completed, post_cleanup_completed, case_id,
        outer_environment, outer_environment_seal, cleanup_fields,
        cleanup_seal):
    """Guard post-return with every completed predecessor identity."""
    return (lifecycle.active_case == case_id and
            tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:16] and
            lifecycle.stages[-1] == "post-cleanup" and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            bridge_v52_environment_result_identity_matches(
                environment_seal, environment_result) and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(post_provider_completed) is bool and
            post_provider_completed is True and
            type(post_environment_completed) is bool and
            post_environment_completed is True and
            type(post_cleanup_completed) is bool and
            post_cleanup_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(outer_environment) is dict and
            type(outer_environment_seal) is tuple and
            len(outer_environment_seal) == 1 and
            outer_environment_seal[0] is outer_environment and
            dict(os.environ) == outer_environment and
            type(cleanup_fields) is tuple and len(cleanup_fields) == 3 and
            bridge_v52_module_cleanup_identity_matches(
                cleanup_seal, cleanup_fields, cleanup_fields[0],
                cleanup_fields[1], cleanup_fields[2]))


def bridge_v52_environment_post_return_finalization(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed,
        post_environment_completed, post_cleanup_completed, case_id,
        outer_environment, outer_environment_seal, cleanup_fields,
        cleanup_seal, stage_result, stage_seal):
    """Finalize the exact stage/digest/cleanup identity before case success."""
    require(lifecycle.active_case == case_id and
            type(lifecycle.stages) is list and
            tuple(lifecycle.stages) is not stage_result and
            tuple(lifecycle.stages) == stage_result and
            stage_result == BRIDGE_V52_STAGES and
            len(stage_result) == 17 and
            stage_result[-1] == "post-return" and
            bridge_v52_stage_unique(stage_result) and
            bridge_v52_tuple_digest(stage_result) == BRIDGE_V52_STAGE_DIGEST and
            tuple(actual) == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_result) is tuple and
            type(environment_seal) is tuple and
            len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            type(aggregate_calls) is int and aggregate_calls == 1 and
            type(aggregate_completed) is bool and aggregate_completed is True and
            type(post_provider_completed) is bool and
            post_provider_completed is True and
            type(post_environment_completed) is bool and
            post_environment_completed is True and
            type(post_cleanup_completed) is bool and
            post_cleanup_completed is True and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(outer_environment) is dict and
            type(outer_environment_seal) is tuple and
            len(outer_environment_seal) == 1 and
            outer_environment_seal[0] is outer_environment and
            dict(os.environ) == outer_environment and
            bridge_v52_stage_result_identity_matches(
                stage_seal, stage_result, cleanup_seal, cleanup_fields,
                cleanup_fields[0], cleanup_fields[1], cleanup_fields[2]),
            "bridge52_environment_post_return_finalization")


def bridge_v52_environment_post_return_transition(
        lifecycle, actual, environment_result, environment_seal,
        aggregate_result, aggregate_seal, aggregate_calls,
        aggregate_completed, post_provider_completed,
        post_environment_completed, post_cleanup_completed, case_id,
        outer_environment, outer_environment_seal, cleanup_fields,
        cleanup_seal):
    """Advance, validate and seal post-return under the final case owner."""
    rollback_stages = BRIDGE_V52_STAGES[:12]
    stage = "post-return"
    stage_result = None
    stage_seal = None
    first_error = None
    try:
        require(bridge_v52_environment_post_return_guard(
                    lifecycle, actual, environment_result, environment_seal,
                    aggregate_result, aggregate_seal, aggregate_calls,
                    aggregate_completed, post_provider_completed,
                    post_environment_completed, post_cleanup_completed,
                    case_id, outer_environment, outer_environment_seal,
                    cleanup_fields, cleanup_seal),
                "bridge52_environment_post_return_guard")
        prior_stages = tuple(lifecycle.stages)
        require(type(lifecycle.stages) is list and
                prior_stages == BRIDGE_V52_STAGES[:16] and
                len(prior_stages) == 16 and
                prior_stages[-1] == "post-cleanup",
                "bridge52_environment_post_return_prior_prefix")
        expected = bridge_v52_lifecycle_expected_stage(
            len(lifecycle.stages))
        require(expected == stage and BRIDGE_V52_STAGES[16] == stage,
                "bridge52_environment_post_return_order")
        stage_result = bridge_v52_stage_pending_event(prior_stages, stage)
        require(type(stage_result) is tuple and
                all(type(value) is str for value in stage_result),
                "bridge52_environment_post_return_type")
        require(len(stage_result) == 17,
                "bridge52_environment_post_return_count")
        require(stage in stage_result,
                "bridge52_environment_post_return_omission")
        require(bridge_v52_stage_unique(stage_result),
                "bridge52_environment_post_return_duplicate")
        require(stage_result[:-1] == prior_stages and
                stage_result[-1] is stage,
                "bridge52_environment_post_return_stage_order")
        require(bridge_v52_stage_equal(stage_result),
                "bridge52_environment_post_return_equality")
        require(bridge_v52_stage_unique(stage_result),
                "bridge52_environment_post_return_uniqueness")
        require(bridge_v52_tuple_digest(stage_result) ==
                    BRIDGE_V52_STAGE_DIGEST,
                "bridge52_environment_post_return_digest")
        bridge_v52_lifecycle_append(lifecycle.stages, stage)
        require(tuple(lifecycle.stages) == stage_result and
                len(lifecycle.stages) == 17 and
                lifecycle.stages[-1] == stage,
                "bridge52_environment_post_return_resulting_stage")
        stage_seal = bridge_v52_stage_result_identity(
            stage_result, cleanup_seal)
        require(type(stage_seal) is tuple and len(stage_seal) == 2 and
                stage_seal[0] is stage_result and
                stage_seal[1] is cleanup_seal and
                bridge_v52_stage_result_identity_matches(
                    stage_seal, stage_result, cleanup_seal, cleanup_fields,
                    cleanup_fields[0], cleanup_fields[1], cleanup_fields[2]),
                "bridge52_environment_post_return_seal")
        bridge_v52_environment_post_return_finalization(
            lifecycle, actual, environment_result, environment_seal,
            aggregate_result, aggregate_seal, aggregate_calls,
            aggregate_completed, post_provider_completed,
            post_environment_completed, post_cleanup_completed, case_id,
            outer_environment, outer_environment_seal, cleanup_fields,
            cleanup_seal, stage_result, stage_seal)
    except Exception as error:
        if lifecycle.first_failure is None:
            reason = str(error)
            lifecycle.first_failure = {
                "caseID": case_id,
                "reason": reason if re.fullmatch(
                    r"bridge52_[a-z0-9_]+", reason) else
                    "bridge52_internal",
                "result": "fail",
                "stage": stage,
                "status": "failed",
            }
        first_error = error
    finally:
        if first_error is not None:
            try:
                bridge_v52_unload_modules(
                    cleanup_fields[0] if type(cleanup_fields) is tuple and
                    len(cleanup_fields) == 3 else None,
                    cleanup_fields[1] if type(cleanup_fields) is tuple and
                    len(cleanup_fields) == 3 else None)
            except Exception:
                pass

    if first_error is not None:
        stage_result = None
        stage_seal = None
        restored = False
        for _attempt in range(2):
            try:
                bridge_v52_lifecycle_restore(
                    lifecycle.stages, rollback_stages)
            except Exception:
                continue
            restored = True
            break
        if not restored or tuple(lifecycle.stages) != rollback_stages:
            lifecycle.stages[:] = rollback_stages
        try:
            require(tuple(lifecycle.stages) == rollback_stages and
                    rollback_stages == BRIDGE_V52_STAGES[:12] and
                    stage_result is None and stage_seal is None and
                    _BRIDGE_V52_DOCTOR_MODULE is None and
                    _BRIDGE_V52_PHASE4_MODULE is None and
                    sys.modules.get("bridge_v52_phase4_provider") is None and
                    sys.modules.get("bridge_v52_phase4_doctor") is None and
                    (type(cleanup_fields) is not tuple or
                     len(cleanup_fields) != 3 or
                     cleanup_fields[2].get() is None),
                    "bridge52_environment_post_return_rollback")
        except Exception:
            pass
        raise first_error
    return (stage_result, stage_seal)


def bridge_v52_result_envelope_access(
        environment_result, environment_seal, aggregate_result,
        aggregate_seal, cleanup_fields, cleanup_seal, stage_fields,
        stage_seal):
    """Access the four already sealed result sources exactly once."""
    return (environment_result, environment_seal, aggregate_result,
            aggregate_seal, cleanup_fields, cleanup_seal, stage_fields,
            stage_seal)


def bridge_v52_result_envelope_allocate(items):
    """Allocate the closed public container from its ordered field pairs."""
    return dict(items)


def bridge_v52_result_envelope_identity(result, sources):
    """Seal one public result to the exact objects that produced it."""
    return (result, sources)


def bridge_v52_result_envelope_identity_matches(sealed, result, sources):
    """Validate the public result seal without reconstructing the result."""
    return (type(sealed) is tuple and len(sealed) == 2 and
            sealed[0] is result and sealed[1] is sources)


def bridge_v52_result_envelope_validate(
        result, sources, doctor, lifecycle, root_state, implementation,
        phase4_facts, local, route, protected, boundary):
    """Validate the exact closed twenty-key public matrix envelope."""
    require(type(result) is dict,
            "bridge52_result_envelope_type")
    require(type(sources) is tuple and len(sources) == 8,
            "bridge52_result_envelope_access")
    environment_result, environment_seal, aggregate_result, aggregate_seal, \
        cleanup_fields, cleanup_seal, stage_fields, stage_seal = sources
    false_authority = result.get("falseAuthority")
    isolation = result.get("isolation")
    matrix = result.get("matrix")
    phase4_result = result.get("phase4Facts")
    protected_result = result.get("protectedMatrix")
    provider = result.get("provider")
    submatrices = result.get("submatrices")
    require(len(result) >= 20,
            "bridge52_result_envelope_missing")
    require(len(result) <= 20,
            "bridge52_result_envelope_extra")
    require(tuple(result) == BRIDGE_V52_RESULT_KEYS and
            set(result) == set(BRIDGE_V52_RESULT_KEYS),
            "bridge52_result_envelope_order")
    require(type(environment_result) is tuple and
            environment_result == BRIDGE_V52_ENVIRONMENT_CASES and
            type(environment_seal) is tuple and len(environment_seal) == 1 and
            environment_seal[0] is environment_result and
            bridge_v52_environment_result_identity_matches(
                environment_seal, environment_result) and
            type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            aggregate_result[0] is environment_result and
            type(aggregate_seal) is tuple and len(aggregate_seal) == 3 and
            bridge_v52_exact234_result_identity_matches(
                aggregate_seal, aggregate_seal[0], aggregate_result) and
            type(aggregate_seal[0]) is tuple and
            len(aggregate_seal[0]) == 6 and
            aggregate_seal[0][1] is phase4_facts and
            aggregate_seal[0][2] is local and
            aggregate_seal[0][3] is route and
            aggregate_seal[0][4] is environment_result and
            aggregate_seal[0][5] is lifecycle.diagnostics and
            type(cleanup_fields) is tuple and len(cleanup_fields) == 3 and
            cleanup_fields[0] is doctor and
            type(protected) is dict and
            type(protected.get("counts")) is dict and
            type(boundary) is dict and
            bridge_v52_module_cleanup_identity_matches(
                cleanup_seal, cleanup_fields, doctor, cleanup_fields[1],
                cleanup_fields[2]) and
            type(stage_fields) is tuple and
            stage_fields == BRIDGE_V52_STAGES and len(stage_fields) == 17 and
            bridge_v52_stage_result_identity_matches(
                stage_seal, stage_fields, cleanup_seal, cleanup_fields,
                doctor, cleanup_fields[1], cleanup_fields[2]),
            "bridge52_result_envelope_source_identity")
    exact234 = aggregate_result[1]
    phase4 = cleanup_fields[1]
    require(lifecycle.active_case == "matrix-environment-system-present" and
            tuple(lifecycle.stages) == stage_fields and
            tuple(lifecycle.diagnostics) == BRIDGE_V52_DIAGNOSTIC_CASES and
            lifecycle.protected_matrix_result is protected and
            type(lifecycle.protected_matrix_fields) is tuple and
            len(lifecycle.protected_matrix_fields) == 2 and
            lifecycle.protected_matrix_fields[0] is protected and
            lifecycle.protected_matrix_fields[1] is protected["counts"] and
            lifecycle.boundary_facts_result is boundary and
            type(lifecycle.boundary_facts_fields) is tuple and
            len(lifecycle.boundary_facts_fields) == 1 and
            lifecycle.boundary_facts_fields[0] is boundary and
            type(lifecycle.partition3_results) is tuple and
            len(lifecycle.partition3_results) == 2 and
            lifecycle.partition3_results[0] is protected and
            lifecycle.partition3_results[1] is boundary,
            "bridge52_result_envelope_driver_identity")
    require(doctor.bridge_v52_state_is_sealed(root_state) and
            root_state.implementation == implementation and
            type(root_state.implementation) is str and
            len(root_state.implementation) == 40 and
            type(root_state.head) is str and len(root_state.head) == 40 and
            (root_state.input_state is
                doctor.BRIDGE_V52_REAL_IMPLEMENTATION or
             root_state.input_state is
                doctor.BRIDGE_V52_SYNTHETIC_REVIEW),
            "bridge52_result_envelope_root_identity")
    require(type(exact234) is tuple and len(exact234) == 234 and
            all(type(case_id) is str for case_id in exact234) and
            len(set(exact234)) == 234 and
            exact234[:128] == tuple(phase4_facts["caseIDs"]) and
            exact234[128:205] == local and
            exact234[205:215] == route and
            exact234[215:222] == environment_result and
            exact234[222:] == tuple(lifecycle.diagnostics) and
            bridge_v52_tuple_digest(exact234) == BRIDGE_V52_CASE_DIGEST and
            type(local) is tuple and local == BRIDGE_V52_LOCAL_CASES and
            len(local) == 77 and type(route) is tuple and
            route == BRIDGE_V52_ROUTE_CASES and len(route) == 10 and
            bridge_v52_tuple_digest(stage_fields) == BRIDGE_V52_STAGE_DIGEST,
            "bridge52_result_envelope_counts")
    require(type(false_authority) is dict and len(false_authority) == 6 and
            tuple(false_authority) == (
                "evidence", "integration", "liveApply", "phase5Pass",
                "phase6", "syntheticAcceptance") and
            all(type(value) is bool and value is False
                for value in false_authority.values()),
            "bridge52_result_envelope_false_authority")
    require(type(isolation) is dict and len(isolation) == 3 and
            tuple(isolation) == (
                "childPrivateRecordStripped", "externalFixtureEnvironment",
                "temporaryRootsRemoved") and
            all(type(value) is bool and value is True
                for value in isolation.values()),
            "bridge52_result_envelope_isolation")
    require(type(matrix) is dict and len(matrix) == 8 and
            tuple(matrix) == (
                "allPassed", "caseIDs", "caseIDsSHA256", "count",
                "routeIDs", "routeIDsSHA256", "stageIDs",
                "stageIDsSHA256") and
            type(matrix["allPassed"]) is bool and
            matrix["allPassed"] is True and
            type(matrix["caseIDs"]) is list and
            tuple(matrix["caseIDs"]) == exact234 and
            type(matrix["caseIDsSHA256"]) is str and
            matrix["caseIDsSHA256"] == BRIDGE_V52_CASE_DIGEST and
            type(matrix["count"]) is int and matrix["count"] == 234 and
            type(matrix["routeIDs"]) is list and
            tuple(matrix["routeIDs"]) == route and
            type(matrix["routeIDsSHA256"]) is str and
            matrix["routeIDsSHA256"] == bridge_v52_tuple_digest(route) and
            type(matrix["stageIDs"]) is list and
            tuple(matrix["stageIDs"]) == stage_fields and
            type(matrix["stageIDsSHA256"]) is str and
            matrix["stageIDsSHA256"] == BRIDGE_V52_STAGE_DIGEST,
            "bridge52_result_envelope_matrix")
    require(type(phase4_facts) is dict and
            type(phase4_result) is dict and len(phase4_result) == 8 and
            tuple(phase4_result) == (
                "ambientAttempted", "ambientCases", "caseCount",
                "factCases", "historicalCases", "ownerCases", "rawCases",
                "topologyCases") and
            all(type(value) is int for value in phase4_result.values()) and
            phase4_result == {
                "ambientAttempted": phase4_facts["ambientAttempted"],
                "ambientCases": phase4_facts["ambientCases"],
                "caseCount": len(phase4_facts["caseIDs"]),
                "factCases": phase4_facts["factCases"],
                "historicalCases": phase4_facts["historicalCases"],
                "ownerCases": phase4_facts["ownerCases"],
                "rawCases": phase4_facts["rawCases"],
                "topologyCases": phase4_facts["topologyCases"],
            } and tuple(phase4_result.values()) == (0, 20, 128, 75, 7, 2, 24, 20),
            "bridge52_result_envelope_phase4")
    require(type(protected_result) is dict and protected_result is protected and
            len(protected_result) == 4 and tuple(protected_result) == (
                "astTargets", "concreteTargets", "counts", "total") and
            type(protected_result["counts"]) is dict and
            tuple(protected_result["counts"]) == (
                "phase4", "prep", "apply") and
            all(type(value) is int for value in (
                protected_result["astTargets"],
                protected_result["concreteTargets"],
                *protected_result["counts"].values(),
                protected_result["total"])) and
            protected_result == {
                "astTargets": 13, "concreteTargets": 99,
                "counts": {"phase4": 112, "prep": 112, "apply": 112},
                "total": 336,
            },
            "bridge52_result_envelope_protected")
    require(type(provider) is dict and len(provider) == 3 and
            tuple(provider) == ("calls", "loads", "reset") and
            type(provider["calls"]) is int and provider["calls"] == 1 and
            type(provider["loads"]) is int and provider["loads"] == 1 and
            type(provider["reset"]) is bool and provider["reset"] is True and
            phase4._BRIDGE_V52_PROVIDER_CALLS == provider["calls"] and
            phase4._BRIDGE_V52_PROVIDER_LOADS == provider["loads"] and
            phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
            phase4._BRIDGE_V52_PROVIDER_CONTEXT is cleanup_fields[2] and
            cleanup_fields[2].get() is None,
            "bridge52_result_envelope_provider")
    require(type(submatrices) is dict and len(submatrices) == 3 and
            tuple(submatrices) == (
                "applyCases", "finalCases", "localCases") and
            all(type(value) is int for value in submatrices.values()) and
            submatrices == {
                "applyCases": boundary["applyCases"],
                "finalCases": boundary["finalCases"],
                "localCases": len(local),
            } and tuple(submatrices.values()) == (14, 29, 77),
            "bridge52_result_envelope_submatrices")
    expected_state = (
        "bridge_merge_compatibility_v52_implementation"
        if root_state.input_state is doctor.BRIDGE_V52_REAL_IMPLEMENTATION
        else "bridge_merge_compatibility_v52_review")
    require(type(result["implementationCommit"]) is str and
            result["implementationCommit"] == root_state.implementation and
            type(result["marker"]) is str and
            result["marker"] == doctor.BRIDGE_V52_MARKER and
            type(result["matrixInputState"]) is str and
            result["matrixInputState"] == root_state.input_state.value and
            type(result["mode"]) is str and result["mode"] == "matrix" and
            type(result["phase5ApplyAuthorized"]) is bool and
            result["phase5ApplyAuthorized"] is False and
            type(result["phase5PassClaimed"]) is bool and
            result["phase5PassClaimed"] is False and
            type(result["phase6Authorized"]) is bool and
            result["phase6Authorized"] is False and
            type(result["preparationOnly"]) is bool and
            result["preparationOnly"] is True and
            type(result["protectedBaselineCommit"]) is str and
            result["protectedBaselineCommit"] == doctor.BRIDGE_V52_BASE and
            type(result["repositoryState"]) is str and
            result["repositoryState"] == expected_state and
            type(result["schema"]) is int and result["schema"] == 1 and
            type(result["sourceCommit"]) is str and
            result["sourceCommit"] == root_state.head and
            type(result["verdict"]) is str and result["verdict"] ==
                "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
                "PREPARED_FOR_INDEPENDENT_REVIEW",
            "bridge52_result_envelope_scalars")


def bridge_v52_result_envelope_build(
        doctor, lifecycle, root_state, implementation, phase4_facts, local,
        route, protected, boundary, environment_result, environment_seal,
        aggregate_result, aggregate_seal, cleanup_fields, cleanup_seal,
        stage_fields, stage_seal):
    """Construct, strictly validate and identity-seal the driver result."""
    sources = bridge_v52_result_envelope_access(
        environment_result, environment_seal, aggregate_result,
        aggregate_seal, cleanup_fields, cleanup_seal, stage_fields,
        stage_seal)
    require(type(sources) is tuple and len(sources) == 8 and
            sources[0] is environment_result and
            sources[1] is environment_seal and
            sources[2] is aggregate_result and
            sources[3] is aggregate_seal and
            sources[4] is cleanup_fields and sources[5] is cleanup_seal and
            sources[6] is stage_fields and sources[7] is stage_seal,
            "bridge52_result_envelope_access")
    require(type(aggregate_result) is tuple and len(aggregate_result) == 2 and
            type(cleanup_fields) is tuple and len(cleanup_fields) == 3,
            "bridge52_result_envelope_source_identity")
    exact234 = aggregate_result[1]
    phase4 = cleanup_fields[1]
    repository_state = (
        "bridge_merge_compatibility_v52_implementation"
        if root_state.input_state is doctor.BRIDGE_V52_REAL_IMPLEMENTATION
        else "bridge_merge_compatibility_v52_review")
    items = (
        ("falseAuthority", {
            "evidence": False, "integration": False,
            "liveApply": False, "phase5Pass": False,
            "phase6": False, "syntheticAcceptance": False,
        }),
        ("implementationCommit", root_state.implementation),
        ("isolation", {
            "childPrivateRecordStripped": True,
            "externalFixtureEnvironment": True,
            "temporaryRootsRemoved": True,
        }),
        ("marker", doctor.BRIDGE_V52_MARKER),
        ("matrix", {
            "allPassed": True,
            "caseIDs": list(exact234),
            "caseIDsSHA256": bridge_v52_tuple_digest(exact234),
            "count": len(exact234),
            "routeIDs": list(route),
            "routeIDsSHA256": bridge_v52_tuple_digest(route),
            "stageIDs": list(stage_fields),
            "stageIDsSHA256": bridge_v52_tuple_digest(stage_fields),
        }),
        ("matrixInputState", root_state.input_state.value),
        ("mode", "matrix"),
        ("phase4Facts", {
            "ambientAttempted": phase4_facts["ambientAttempted"],
            "ambientCases": phase4_facts["ambientCases"],
            "caseCount": len(phase4_facts["caseIDs"]),
            "factCases": phase4_facts["factCases"],
            "historicalCases": phase4_facts["historicalCases"],
            "ownerCases": phase4_facts["ownerCases"],
            "rawCases": phase4_facts["rawCases"],
            "topologyCases": phase4_facts["topologyCases"],
        }),
        ("phase5ApplyAuthorized", False),
        ("phase5PassClaimed", False),
        ("phase6Authorized", False),
        ("preparationOnly", True),
        ("protectedBaselineCommit", doctor.BRIDGE_V52_BASE),
        ("protectedMatrix", protected),
        ("provider", {
            "calls": phase4._BRIDGE_V52_PROVIDER_CALLS,
            "loads": phase4._BRIDGE_V52_PROVIDER_LOADS,
            "reset": phase4._BRIDGE_V52_PROVIDER_TOKEN is None and
                phase4._BRIDGE_V52_PROVIDER_CONTEXT is cleanup_fields[2] and
                cleanup_fields[2].get() is None,
        }),
        ("repositoryState", repository_state),
        ("schema", 1),
        ("sourceCommit", root_state.head),
        ("submatrices", {
            "applyCases": boundary["applyCases"],
            "finalCases": boundary["finalCases"],
            "localCases": len(local),
        }),
        ("verdict",
         "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
         "PREPARED_FOR_INDEPENDENT_REVIEW"),
    )
    require(type(items) is tuple and len(items) == 20 and
            tuple(item[0] for item in items) == BRIDGE_V52_RESULT_KEYS and
            all(type(item) is tuple and len(item) == 2 and
                type(item[0]) is str for item in items),
            "bridge52_result_envelope_construction")
    result = bridge_v52_result_envelope_allocate(items)
    bridge_v52_result_envelope_validate(
        result, sources, doctor, lifecycle, root_state, implementation,
        phase4_facts, local, route, protected, boundary)
    sealed = bridge_v52_result_envelope_identity(result, sources)
    require(bridge_v52_result_envelope_identity_matches(
                sealed, result, sources),
            "bridge52_result_envelope_seal")
    bridge_v52_result_envelope_validate(
        result, sources, doctor, lifecycle, root_state, implementation,
        phase4_facts, local, route, protected, boundary)
    require(bridge_v52_result_envelope_identity_matches(
                sealed, result, sources),
            "bridge52_result_envelope_finalization")
    return (result, sealed)


def bridge_v52_environment_seventh_case(
        doctor, lifecycle, actual, returned_setup, aggregate_callback,
        result_envelope_callback, outer_environment):
    """Own returned-seal access, entry-six execution and rollback."""
    case_id = "matrix-environment-system-present"
    result = [None]
    setup_identity = [None]
    sealed_identity = [None]
    aggregate_result = [None]
    aggregate_identity = [None]
    aggregate_calls = [0]
    aggregate_completed = [False]
    cleanup_result = [None]
    cleanup_identity = [None]
    stage_result = [None]
    stage_identity = [None]
    envelope_result = [None]
    envelope_identity = [None]
    envelope_calls = [0]
    completed_result = [None]

    def owned():
        prefix = None
        environment_before = None
        command_before = None
        accessed_setup = None
        base = None
        schedule = None
        entry = None
        setup_seal = None
        pending = None
        sealed = None
        aggregate_return = None
        aggregate_pair = None
        aggregate_seal = None
        outer_environment_seal = None
        cleanup_return = None
        cleanup_fields = None
        cleanup_seal = None
        stage_return = None
        stage_fields = None
        stage_seal = None
        envelope_return = None
        envelope_fields = None
        envelope_seal = None
        post_cases_entered = False
        post_provider_started = False
        post_provider_completed = False
        post_environment_started = False
        post_environment_completed = False
        post_cleanup_started = False
        post_cleanup_completed = False
        post_return_started = False
        first_error = None
        try:
            prefix = tuple(actual)
            require(lifecycle.active_case == case_id and lifecycle.stages and
                    lifecycle.stages[-1] == "case-partition-5" and
                    prefix == BRIDGE_V52_ENVIRONMENT_CASES[:6] and
                    len(prefix) == 6 and
                    actual[0] is BRIDGE_V52_ENVIRONMENT_CASES[0] and
                    actual[1] is BRIDGE_V52_ENVIRONMENT_CASES[1] and
                    actual[2] is BRIDGE_V52_ENVIRONMENT_CASES[2] and
                    actual[3] is BRIDGE_V52_ENVIRONMENT_CASES[3] and
                    actual[4] is BRIDGE_V52_ENVIRONMENT_CASES[4] and
                    actual[5] is BRIDGE_V52_ENVIRONMENT_CASES[5] and
                    result[0] is None and setup_identity[0] is None and
                    sealed_identity[0] is None and
                    aggregate_result[0] is None and
                    aggregate_identity[0] is None and
                    aggregate_calls[0] == 0 and
                    aggregate_completed[0] is False and
                    cleanup_result[0] is None and
                    cleanup_identity[0] is None and
                    stage_result[0] is None and
                    stage_identity[0] is None and
                    envelope_result[0] is None and
                    envelope_identity[0] is None and
                    envelope_calls[0] == 0 and
                    completed_result[0] is None,
                    "bridge52_environment_seventh_ownership")
            environment_before = dict(os.environ)
            command_before = _BRIDGE_V52_COMMAND_ENVIRONMENT.get()
            setup_seal = bridge_v52_environment_seventh_identity(
                returned_setup)
            setup_identity[0] = setup_seal
            accessed_setup = bridge_v52_environment_seventh_access(
                returned_setup)
            require(type(accessed_setup) is tuple,
                    "bridge52_environment_seventh_type")
            require(len(accessed_setup) == 2,
                    "bridge52_environment_seventh_count")
            require(bridge_v52_environment_seventh_identity_matches(
                        setup_identity[0], returned_setup, accessed_setup),
                    "bridge52_environment_seventh_identity")
            base, schedule = bridge_v52_environment_seventh_unpack(
                accessed_setup)
            require(type(base) is dict and accessed_setup[0] is base and
                    base.get("GIT_CONFIG_GLOBAL") == "/dev/null" and
                    base.get("GIT_CONFIG_NOSYSTEM") == "1" and
                    base.get("GIT_NO_REPLACE_OBJECTS") == "1" and
                    "GIT_CONFIG_SYSTEM" not in base and
                    BRIDGE_V52_PRIVATE_RECORD not in base and
                    BRIDGE_V52_SYNTHETIC_FLAG not in base and
                    not any(key.startswith("CODEX_") for key in base),
                    "bridge52_environment_seventh_base")
            require(type(schedule) is tuple and
                    accessed_setup[1] is schedule and len(schedule) == 7 and
                    all(type(item) is tuple and len(item) == 2 and
                        type(item[0]) is str and type(item[1]) is tuple and
                        len(item[1]) == 3 and type(item[1][0]) is str and
                        type(item[1][1]) is str and
                        (item[1][2] is None or type(item[1][2]) is str)
                        for item in schedule) and
                    bridge_v52_environment_identity_matches(
                        accessed_setup, base, schedule),
                    "bridge52_environment_seventh_schedule")
            require(tuple(item[0] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_CASES and
                    tuple(item[1] for item in schedule) ==
                        BRIDGE_V52_ENVIRONMENT_MUTATIONS,
                    "bridge52_environment_seventh_mapping")
            entry = bridge_v52_environment_seventh_bind(schedule)
            require(type(entry) is tuple and len(entry) == 2 and
                    entry is schedule[6] and entry[0] is case_id and
                    entry[1] is BRIDGE_V52_ENVIRONMENT_MUTATIONS[6],
                    "bridge52_environment_seventh_bind")
            value = dict(base)
            bridge_v52_environment_mutate(value, entry[1])
            bridge_v52_environment_predicate(doctor, value)
        except Exception as error:
            first_error = error

        try:
            if (environment_before is not None and
                    dict(os.environ) != environment_before):
                os.environ.clear()
                os.environ.update(environment_before)
            if (environment_before is not None and
                    _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                        command_before):
                _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
            if environment_before is not None:
                bridge_v52_environment_seventh_restoration(
                    environment_before, command_before)
        except Exception as error:
            if first_error is None:
                first_error = error

        if first_error is None:
            try:
                pending = bridge_v52_environment_pending_event(prefix, case_id)
                require(type(pending) is tuple and
                        all(type(value) is str for value in pending),
                        "bridge52_environment_final_type")
                require(len(pending) == 7,
                        "bridge52_environment_final_count")
                require(case_id in pending,
                        "bridge52_environment_final_omission")
                require(bridge_v52_environment_unique(pending),
                        "bridge52_environment_final_duplicate")
                require(pending[:-1] == prefix and
                        pending[-1] is case_id,
                        "bridge52_environment_final_order")
                require(bridge_v52_environment_equal(pending),
                        "bridge52_environment_final_equality")
                require(bridge_v52_environment_unique(pending),
                        "bridge52_environment_final_uniqueness")
                sealed = bridge_v52_environment_result_identity(pending)
                result[0] = pending
                sealed_identity[0] = sealed
                require(result[0] is pending and
                        type(result[0]) is tuple and
                        type(sealed) is tuple and len(sealed) == 1 and
                        sealed[0] is pending,
                        "bridge52_environment_final_seal")
                require(sealed_identity[0] is sealed and
                        bridge_v52_environment_result_identity_matches(
                            sealed_identity[0], result[0]),
                        "bridge52_environment_final_identity")
                bridge_v52_environment_seventh_append(actual, case_id)
                bridge_v52_environment_seventh_finalization(
                    lifecycle, actual, pending, result[0], sealed_identity[0],
                    setup_identity[0], returned_setup, accessed_setup, base,
                    schedule, entry, case_id, environment_before,
                    command_before)
                bridge_v52_environment_post_cases_transition(
                    lifecycle, actual, result[0], sealed_identity[0], case_id)
                post_cases_entered = True
                require(callable(aggregate_callback) and
                        aggregate_calls[0] == 0,
                        "bridge52_exact234_callback")
                aggregate_calls[0] += 1
                aggregate_return = aggregate_callback(
                    result[0], lifecycle.diagnostics)
                require(aggregate_calls[0] == 1 and
                        type(aggregate_return) is tuple and
                        len(aggregate_return) == 2,
                        "bridge52_exact234_callback_result")
                aggregate_pair, aggregate_seal = aggregate_return
                require(type(aggregate_pair) is tuple and
                        len(aggregate_pair) == 2 and
                        aggregate_pair[0] is result[0] and
                        type(aggregate_pair[1]) is tuple and
                        type(aggregate_seal) is tuple and
                        len(aggregate_seal) == 3 and
                        aggregate_seal[1] is aggregate_pair,
                        "bridge52_exact234_callback_identity")
                aggregate_result[0] = aggregate_pair
                aggregate_identity[0] = aggregate_seal
                require(aggregate_result[0] is aggregate_pair and
                        aggregate_identity[0] is aggregate_seal,
                        "bridge52_exact234_seal")
                bridge_v52_environment_aggregate_finalization(
                    lifecycle, actual, result[0], aggregate_result[0],
                    aggregate_identity[0], aggregate_calls[0], case_id)
                aggregate_completed[0] = True
                post_provider_started = True
                bridge_v52_environment_post_provider_transition(
                    lifecycle, actual, result[0], sealed_identity[0],
                    aggregate_result[0], aggregate_identity[0],
                    aggregate_calls[0], aggregate_completed[0], case_id)
                post_provider_completed = True
                post_environment_started = True
                outer_environment_seal = bridge_v52_outer_environment_identity(
                    outer_environment)
                require(type(outer_environment_seal) is tuple and
                        len(outer_environment_seal) == 1 and
                        outer_environment_seal[0] is outer_environment,
                        "bridge52_outer_environment_seal")
                bridge_v52_environment_post_environment_transition(
                    lifecycle, actual, result[0], sealed_identity[0],
                    aggregate_result[0], aggregate_identity[0],
                    aggregate_calls[0], aggregate_completed[0],
                    post_provider_completed, case_id, outer_environment,
                    outer_environment_seal)
                post_environment_completed = True
                post_cleanup_started = True
                cleanup_return = bridge_v52_environment_post_cleanup_transition(
                    lifecycle, actual, result[0], sealed_identity[0],
                    aggregate_result[0], aggregate_identity[0],
                    aggregate_calls[0], aggregate_completed[0],
                    post_provider_completed, post_environment_completed,
                    case_id, outer_environment, outer_environment_seal,
                    _BRIDGE_V52_DOCTOR_MODULE, _BRIDGE_V52_PHASE4_MODULE)
                require(type(cleanup_return) is tuple and
                        len(cleanup_return) == 2,
                        "bridge52_environment_post_cleanup_return")
                cleanup_fields, cleanup_seal = cleanup_return
                require(type(cleanup_fields) is tuple and
                        type(cleanup_seal) is tuple and
                        cleanup_seal[0] is cleanup_fields,
                        "bridge52_environment_post_cleanup_identity")
                cleanup_result[0] = cleanup_fields
                cleanup_identity[0] = cleanup_seal
                post_cleanup_completed = True
                post_return_started = True
                stage_return = bridge_v52_environment_post_return_transition(
                    lifecycle, actual, result[0], sealed_identity[0],
                    aggregate_result[0], aggregate_identity[0],
                    aggregate_calls[0], aggregate_completed[0],
                    post_provider_completed, post_environment_completed,
                    post_cleanup_completed, case_id, outer_environment,
                    outer_environment_seal, cleanup_result[0],
                    cleanup_identity[0])
                require(type(stage_return) is tuple and
                        len(stage_return) == 2,
                        "bridge52_environment_post_return_return")
                stage_fields, stage_seal = stage_return
                require(type(stage_fields) is tuple and
                        type(stage_seal) is tuple and
                        stage_seal[0] is stage_fields and
                        stage_seal[1] is cleanup_identity[0],
                        "bridge52_environment_post_return_identity")
                stage_result[0] = stage_fields
                stage_identity[0] = stage_seal
                require(callable(result_envelope_callback) and
                        envelope_calls[0] == 0,
                        "bridge52_result_envelope_callback")
                envelope_calls[0] += 1
                envelope_return = result_envelope_callback(
                    result[0], sealed_identity[0], aggregate_result[0],
                    aggregate_identity[0], cleanup_result[0],
                    cleanup_identity[0], stage_result[0], stage_identity[0])
                require(envelope_calls[0] == 1 and
                        type(envelope_return) is tuple and
                        len(envelope_return) == 2,
                        "bridge52_result_envelope_callback_result")
                envelope_fields, envelope_seal = envelope_return
                require(type(envelope_fields) is dict and
                        type(envelope_seal) is tuple and
                        len(envelope_seal) == 2 and
                        envelope_seal[0] is envelope_fields and
                        type(envelope_seal[1]) is tuple and
                        len(envelope_seal[1]) == 8 and
                        envelope_seal[1][0] is result[0] and
                        envelope_seal[1][1] is sealed_identity[0] and
                        envelope_seal[1][2] is aggregate_result[0] and
                        envelope_seal[1][3] is aggregate_identity[0] and
                        envelope_seal[1][4] is cleanup_result[0] and
                        envelope_seal[1][5] is cleanup_identity[0] and
                        envelope_seal[1][6] is stage_result[0] and
                        envelope_seal[1][7] is stage_identity[0] and
                        bridge_v52_result_envelope_identity_matches(
                            envelope_seal, envelope_fields,
                            envelope_seal[1]),
                        "bridge52_result_envelope_callback_identity")
                envelope_result[0] = envelope_fields
                envelope_identity[0] = envelope_seal
                completed_result[0] = envelope_result[0]
                require(completed_result[0] is envelope_result[0] and
                        envelope_identity[0] is envelope_seal and
                        envelope_calls[0] == 1 and
                        stage_result[0] is stage_fields and
                        stage_identity[0] is stage_seal and
                        bridge_v52_stage_result_identity_matches(
                            stage_identity[0], stage_result[0],
                            cleanup_identity[0], cleanup_result[0],
                            cleanup_result[0][0], cleanup_result[0][1],
                            cleanup_result[0][2]),
                        "bridge52_result_envelope_completion")
            except Exception as error:
                if post_cases_entered and lifecycle.first_failure is None:
                    reason = str(error)
                    lifecycle.first_failure = {
                        "caseID": case_id,
                        "reason": reason if re.fullmatch(
                            r"bridge52_[a-z0-9_]+", reason) else
                            "bridge52_internal",
                        "result": "fail",
                        "stage": ("post-return" if post_return_started else
                                  "post-cleanup" if post_cleanup_started else
                                  "post-environment"
                                  if post_environment_started else
                                  "post-provider" if post_provider_started else
                                  "post-cases"),
                        "status": "failed",
                    }
                first_error = error

        if first_error is not None:
            result[0] = None
            setup_identity[0] = None
            sealed_identity[0] = None
            aggregate_result[0] = None
            aggregate_identity[0] = None
            aggregate_completed[0] = False
            cleanup_result[0] = None
            cleanup_identity[0] = None
            stage_result[0] = None
            stage_identity[0] = None
            envelope_result[0] = None
            envelope_identity[0] = None
            envelope_calls[0] = 0
            completed_result[0] = None
            post_provider_completed = False
            post_environment_completed = False
            post_cleanup_completed = False
            outer_environment_seal = None
            if environment_before is not None:
                try:
                    if dict(os.environ) != environment_before:
                        os.environ.clear()
                        os.environ.update(environment_before)
                except Exception:
                    pass
                try:
                    if (_BRIDGE_V52_COMMAND_ENVIRONMENT.get() is not
                            command_before):
                        _BRIDGE_V52_COMMAND_ENVIRONMENT.set(command_before)
                except Exception:
                    pass
            try:
                bridge_v52_outer_environment_restore(outer_environment)
            except Exception:
                try:
                    if (type(outer_environment) is dict and
                            dict(os.environ) != outer_environment):
                        os.environ.clear()
                        os.environ.update(outer_environment)
                except Exception:
                    pass
            if prefix is not None:
                restored = False
                for _attempt in range(2):
                    try:
                        actual[:] = prefix
                    except Exception:
                        continue
                    restored = True
                    break
                if not restored or tuple(actual) != prefix:
                    actual[:] = prefix
            if tuple(lifecycle.stages) != BRIDGE_V52_STAGES[:12]:
                restored = False
                for _attempt in range(2):
                    try:
                        bridge_v52_lifecycle_restore(
                            lifecycle.stages, BRIDGE_V52_STAGES[:12])
                    except Exception:
                        continue
                    restored = True
                    break
                if (not restored or tuple(lifecycle.stages) !=
                        BRIDGE_V52_STAGES[:12]):
                    lifecycle.stages[:] = BRIDGE_V52_STAGES[:12]
            try:
                require((prefix is None or
                         prefix == BRIDGE_V52_ENVIRONMENT_CASES[:6] and
                         tuple(actual) == prefix) and
                        (environment_before is None or dict(os.environ) ==
                            environment_before) and
                        (environment_before is None or
                         _BRIDGE_V52_COMMAND_ENVIRONMENT.get() is
                            command_before) and
                        tuple(lifecycle.stages) == BRIDGE_V52_STAGES[:12] and
                        result[0] is None and setup_identity[0] is None and
                        sealed_identity[0] is None and
                        aggregate_result[0] is None and
                        aggregate_identity[0] is None and
                        aggregate_completed[0] is False and
                        cleanup_result[0] is None and
                        cleanup_identity[0] is None and
                        stage_result[0] is None and
                        stage_identity[0] is None and
                        envelope_result[0] is None and
                        envelope_identity[0] is None and
                        envelope_calls[0] == 0 and
                        completed_result[0] is None and
                        post_provider_completed is False and
                        post_environment_completed is False and
                        outer_environment_seal is None and
                        _BRIDGE_V52_DOCTOR_MODULE is None and
                        _BRIDGE_V52_PHASE4_MODULE is None and
                        sys.modules.get("bridge_v52_phase4_provider") is None and
                        sys.modules.get("bridge_v52_phase4_doctor") is None and
                        (type(outer_environment) is not dict or
                         dict(os.environ) == outer_environment) and
                        aggregate_calls[0] in {0, 1},
                        "bridge52_environment_seventh_rollback")
            except Exception:
                pass
            raise first_error

    lifecycle.case(case_id, owned)
    return completed_result[0]


def bridge_v52_environment_matrix(
        doctor, lifecycle, aggregate_callback, result_envelope_callback,
        outer_environment):
    actual = []
    environment_setup = bridge_v52_environment_first_case(
        doctor, lifecycle, actual)
    environment_setup = bridge_v52_environment_second_case(
        doctor, lifecycle, actual, environment_setup)
    environment_setup = bridge_v52_environment_third_case(
        doctor, lifecycle, actual, environment_setup)
    environment_setup = bridge_v52_environment_fourth_case(
        doctor, lifecycle, actual, environment_setup)
    environment_setup = bridge_v52_environment_fifth_case(
        doctor, lifecycle, actual, environment_setup)
    environment_setup = bridge_v52_environment_sixth_case(
        doctor, lifecycle, actual, environment_setup)
    environment_result = bridge_v52_environment_seventh_case(
        doctor, lifecycle, actual, environment_setup, aggregate_callback,
        result_envelope_callback, outer_environment)
    return environment_result


def bridge_v52_real_evidence_fixture(doctor, implementation, repository):
    route_digest = bridge_v52_tuple_digest(BRIDGE_V52_ROUTE_CASES)
    phase4 = _BRIDGE_V52_PHASE4_MODULE
    if phase4 is None:
        phase4 = bridge_v52_load_phase4()
    case_ids = list(
        phase4.BRIDGE_V52_PHASE4_FACT_CASES +
        phase4.BRIDGE_V52_PHASE4_RAW_CASES +
        phase4.BRIDGE_V52_PHASE4_HISTORY_CASES +
        phase4.BRIDGE_V52_PHASE4_OWNER_CASES +
        phase4.BRIDGE_V52_PHASE4_TOPOLOGY_CASES +
        BRIDGE_V52_LOCAL_CASES + BRIDGE_V52_ROUTE_CASES +
        BRIDGE_V52_ENVIRONMENT_CASES + BRIDGE_V52_DIAGNOSTIC_CASES
    )
    protected_paths = sorted({
        path for path in git(
            "ls-tree", "-r", "--name-only", implementation,
            cwd=repository).splitlines()
        if doctor.retained_protected_path(path)
    } | {doctor.BRIDGE_V52_EVIDENCE})
    return {
        "authority": {
            "acceptedBase": doctor.BRIDGE_V52_BASE,
            "acceptedMerge": doctor.BRIDGE_V52_MERGE,
            "branch": doctor.BRIDGE_V52_BRANCH,
            "handoffSHA256": doctor.BRIDGE_V52_HANDOFF_SHA256,
            "incorporatedHandoffs":
                doctor.BRIDGE_V52_INCORPORATED_HANDOFFS,
            "marker": doctor.BRIDGE_V52_MARKER,
            "noSyntheticProvenance": True,
        },
        "bindings": {
            "implementationBlobs": {
                path: git("rev-parse", implementation + ":" + path,
                          cwd=repository)
                for path in sorted(doctor.BRIDGE_V52_IMPLEMENTATION_SCOPE)
            },
            "implementationCommit": implementation,
            "implementationRawSHA256":
                doctor.bridge_v52_raw_digest(implementation, repository),
            "implementationScope":
                sorted(doctor.BRIDGE_V52_IMPLEMENTATION_SCOPE),
            "implementationTree":
                git("rev-parse", implementation + "^{tree}", cwd=repository),
            "modes": {
                path: "100755" for path in
                sorted(doctor.BRIDGE_V52_IMPLEMENTATION_SCOPE)
            } | {doctor.BRIDGE_V52_EVIDENCE: "100644"},
            "protectedPathCount": len(protected_paths),
            "protectedPaths": protected_paths,
            "protectedPolicy": "retained_protected_path",
        },
        "captures": [
            {"id": "real-matrix-1", "inputState": "realImplementation",
             "sha256": "1" * 64},
            {"id": "real-matrix-2", "inputState": "realImplementation",
             "sha256": "2" * 64},
        ],
        "gate": {
            "liveApplyAuthorized": False,
            "phase5PassClaimed": False,
            "phase6Authorized": False,
            "verdict":
                "PHASE5_BRIDGE_MERGE_COMPATIBILITY_CORRECTION_V52_"
                "PREPARED_FOR_INDEPENDENT_REVIEW",
        },
        "matrix": {
            "caseCount": 234,
            "caseIDs": case_ids,
            "caseIDsSHA256": BRIDGE_V52_CASE_DIGEST,
            "inputState": "realImplementation",
            "routeCount": 10,
            "routeIDs": list(BRIDGE_V52_ROUTE_CASES),
            "routeIDsSHA256": route_digest,
            "stageCount": 17,
            "stageIDs": list(BRIDGE_V52_STAGES),
            "stageIDsSHA256": BRIDGE_V52_STAGE_DIGEST,
        },
        "phase": "phase5_bridge_merge_compatibility_correction_v52",
        "preservation": {
            "ambientCases": 20, "applyCases": 14, "finalCases": 29,
            "localCases": 77, "phase4Cases": 128,
            "protectedCases": 336, "providerCalls": 1,
            "providerLoads": 1, "syntheticAuthorityUsed": False,
        },
        "protectedBaseline": doctor.BRIDGE_V52_BASE,
        "schema": 1,
        "systemMutations": {
            "applied": False, "codex": False, "live": False,
            "root": False, "system": False, "windows": False,
        },
    }


def bridge_v52_protected_matrix(implementation, doctor):
    tracked = git("ls-tree", "-r", "--name-only", implementation).splitlines()
    concrete = sorted({
        path for path in tracked
        if retained_protected_path(path)
    } | {"bin/check-phase5-apply-bundle"})
    require(len(concrete) == 99 and
            "bin/check-phase5-apply-bundle" in concrete,
            "bridge52_protected_concrete")
    ast_targets = (
        "ast-actual-root-classifier",
        "ast-atomic-output",
        "ast-child-environment",
        "ast-cleanup-finally",
        "ast-evidence-recursive-types",
        "ast-first-failure-latch",
        "ast-input-state-seal",
        "ast-private-record",
        "ast-provider-boundary",
        "ast-route-fixture",
        "ast-stage-tracker",
        "ast-topology-binder",
        "ast-unknown-error-envelope",
    )
    validators = (
        "bin/check-phase4-final-probes",
        "bin/check-phase5-prep",
        "bin/check-phase5-apply-bundle",
    )
    sources = [(ROOT / path).read_text() for path in validators]
    trees = [ast.parse(source) for source in sources]
    require(all(any(isinstance(node, ast.Try) for node in ast.walk(tree))
                for tree in trees) and
            all(any(isinstance(node, ast.Call) for node in ast.walk(tree))
                for tree in trees), "bridge52_protected_ast")
    targets = tuple(concrete) + ast_targets
    require(len(targets) == 112 and len(set(targets)) == 112,
            "bridge52_protected_targets")
    counts = {"phase4": 0, "prep": 0, "apply": 0}
    temporary = Path(tempfile.mkdtemp(prefix="bridge-v52-protected.")).resolve()
    first = None
    try:
        for target_index, target in enumerate(targets):
            repository = temporary / ("target-" + str(target_index))
            bridge_v52_fresh_implementation_repository(
                ROOT, implementation, repository, doctor)
            relative = (target if target in concrete else
                        validators[target_index % len(validators)])
            path = repository / relative
            require(path.is_file() and not path.is_symlink(),
                    "bridge52_protected_file")
            mode = stat.S_IMODE(path.stat().st_mode)
            before = path.read_bytes()
            require(before, "bridge52_protected_source")
            path.write_bytes(before + b"\n")
            path.chmod(mode)
            require(path.read_bytes() == before + b"\n" and
                    len(path.read_bytes()) == len(before) + 1,
                    "bridge52_protected_lf")
            checked([*GIT, "add", "--", relative], cwd=repository,
                    environment=bridge_v52_child_environment(os.environ))
            checked([*GIT, "commit", "-q", "--no-gpg-sign", "-m",
                     "Bounded protected descendant"], cwd=repository,
                    environment={
                        **bridge_v52_commit_environment(
                            doctor, doctor.BRIDGE_V52_EVIDENCE_EPOCH + 2),
                        "GIT_AUTHOR_NAME": "Bridge Reviewer",
                        "GIT_AUTHOR_EMAIL":
                            "bridge-reviewer@agent-first-mac.invalid",
                        "GIT_COMMITTER_NAME": "Bridge Reviewer",
                        "GIT_COMMITTER_EMAIL":
                            "bridge-reviewer@agent-first-mac.invalid",
                    })
            for index, validator in enumerate(validators):
                compile((repository / validator).read_text() + "\n",
                        "bridge52-protected-" + str(target_index) + "-" +
                        str(index), "exec")
            for route, executable, arguments in (
                ("phase4", validators[0], ["--git-only"]),
                ("prep", validators[1], ["--git-only", "--json"]),
                ("apply", validators[2], ["--git-only", "--json"]),
            ):
                result = bridge_v52_run_entrypoint(
                    repository, executable, arguments,
                    bridge_v52_child_environment(os.environ))
                require(result.returncode == 1 and result.stderr == b"",
                        "bridge52_protected_denial")
                value = strict_json_text(
                    result.stdout.decode(), "bridge52-protected-child")
                reason = value.get("reason", value.get("error"))
                require(type(reason) is str and
                        reason.startswith("bridge52_") and
                        not any(str(temporary) in str(item)
                                for item in value.values()),
                        "bridge52_protected_envelope")
                counts[route] += 1
            shutil.rmtree(repository)
            require(not repository.exists(), "bridge52_protected_cleanup")
    except Exception as error:
        first = error
    finally:
        try:
            shutil.rmtree(temporary)
            require(not temporary.exists(), "bridge52_protected_cleanup")
        except Exception as cleanup_error:
            if first is None:
                first = cleanup_error
    if first is not None:
        raise first
    require(counts == {"phase4": 112, "prep": 112, "apply": 112} and
            sum(counts.values()) == 336,
            "bridge52_protected_aggregate")
    return {"astTargets": 13, "concreteTargets": 99,
            "counts": counts, "total": 336}


def bridge_v52_implementation_mutation(doctor, implementation, dimension,
                                       destination):
    bridge_v52_fresh_implementation_repository(
        ROOT, implementation, destination, doctor)
    tree = git("rev-parse", implementation + "^{tree}", cwd=destination)
    parent = doctor.BRIDGE_V52_BASE
    subject = doctor.BRIDGE_V52_IMPLEMENTATION_SUBJECT
    epoch = doctor.BRIDGE_V52_IMPLEMENTATION_EPOCH
    timezone = "+0000"
    environment = bridge_v52_commit_environment(doctor, epoch)
    if dimension == "parent":
        parent = doctor.BRIDGE_V52_MERGE
    elif dimension == "scope":
        extra = destination / "bridge-v52-extra"
        extra.write_text("extra\n")
        checked([*GIT, "add", "--", "bridge-v52-extra"], cwd=destination,
                environment=bridge_v52_child_environment(os.environ))
        tree = checked([*GIT, "write-tree"], cwd=destination,
                       environment=bridge_v52_child_environment(os.environ)).strip()
    elif dimension == "mode":
        checked([*GIT, "update-index", "--chmod=-x",
                 "bin/check-phase5-prep"], cwd=destination,
                environment=bridge_v52_child_environment(os.environ))
        tree = checked([*GIT, "write-tree"], cwd=destination,
                       environment=bridge_v52_child_environment(os.environ)).strip()
    elif dimension == "author":
        environment.update(GIT_AUTHOR_NAME="Wrong Author",
                           GIT_AUTHOR_EMAIL="wrong-author@example.invalid")
    elif dimension == "committer":
        environment.update(GIT_COMMITTER_NAME="Wrong Committer",
                           GIT_COMMITTER_EMAIL=
                           "wrong-committer@example.invalid")
    elif dimension == "epoch":
        epoch -= 1
        environment["GIT_AUTHOR_DATE"] = str(epoch) + " +0000"
        environment["GIT_COMMITTER_DATE"] = str(epoch) + " +0000"
    elif dimension == "timezone":
        timezone = "+0100"
        environment["GIT_AUTHOR_DATE"] = str(epoch) + " " + timezone
        environment["GIT_COMMITTER_DATE"] = str(epoch) + " " + timezone
    elif dimension == "subject":
        subject = "Wrong Bridge implementation subject"
    elif dimension != "extra-header":
        raise RuntimeError("bridge52_internal")
    oid = checked([*GIT, "commit-tree", tree, "-p", parent, "-m", subject],
                  cwd=destination, environment=environment).strip()
    if dimension == "extra-header":
        raw = checked([*GIT, "cat-file", "commit", oid], cwd=destination,
                      environment=bridge_v52_child_environment(os.environ))
        require("\n\n" in raw, "bridge52_extra_header_fixture")
        raw = raw.replace("\n\n", "\nencoding UTF-8\n\n", 1)
        oid = checked([*GIT, "hash-object", "-t", "commit", "-w", "--stdin"],
                      cwd=destination,
                      environment=bridge_v52_child_environment(os.environ),
                      stdin=raw).strip()
    checked([*GIT, "update-ref", "refs/heads/" + doctor.BRIDGE_V52_BRANCH,
             oid], cwd=destination,
            environment=bridge_v52_child_environment(os.environ))
    checked([*GIT, "read-tree", oid], cwd=destination,
            environment=bridge_v52_child_environment(os.environ))
    checked([*GIT, "checkout-index", "--all", "--force"], cwd=destination,
            environment=bridge_v52_child_environment(os.environ))
    bridge_v52_expect_denial(lambda: doctor.bridge_v52_classify_actual_root(
        destination, bridge_v52_child_environment(os.environ)))
    require(git("remote", cwd=destination) == "",
            "bridge52_implementation_mutation_origin")


def bridge_v52_closed_argv(argv, consumer):
    allowed = {
        "phase4": (["--git-only"],),
        "prep": (["--implementation", "--json"],
                 ["--git-only", "--json"], ["--matrix", "--json"]),
        "apply": (["--implementation", "--json"],
                  ["--git-only", "--json"]),
    }
    require(consumer in allowed and list(argv) in allowed[consumer],
            "bridge52_usage")
    return tuple(argv)


class BridgeV52LocalSetup(tuple):
    """Exact immutable identity carrier for the six local fixture fields."""
    __slots__ = ()

    def __new__(cls, fields):
        require(type(fields) is tuple and len(fields) == 6,
                "bridge52_local_setup_container")
        return tuple.__new__(cls, fields)


