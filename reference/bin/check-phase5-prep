def validate_runner_gate_evidence(value, implementation):
    required = {"authority", "baseBlobs", "gate", "implementation", "implementationBlobs", "matrix", "phase", "protectedBaseline", "redaction", "schema", "systemMutations", "tests", "topology"}
    require(type(value) is dict and set(value) == required and type(value["schema"]) is int and value["schema"] == 1,
            "runner_gate_evidence_shape")
    require(exact_json_value(value["authority"], {"base": RUNNER_GATE_BASE, "branch": RUNNER_GATE_BRANCH,
            "ownerCommits": [RUNNER_GATE_OWNER_PARENT, RUNNER_GATE_BASE]}), "runner_gate_evidence_authority")
    require(exact_json_value(value["implementation"], {"commit": implementation, "parent": RUNNER_GATE_BASE,
            "metadata": RUNNER_GATE_METADATA}), "runner_gate_evidence_implementation")
    require(exact_json_value(value["gate"], {"liveApplyAuthorized": False, "marker": RUNNER_GATE_MARKER,
            "maximumVerdict": RUNNER_GATE_VERDICT, "phase5PassClaimed": False, "phase6Authorized": False,
            "stageBContinuationRequired": True}), "runner_gate_evidence_gate")
    require(value["phase"] == "phase5_current_main_runner_gate_rebase" and
            exact_json_value(value["systemMutations"], {"live": False, "private": False, "root": False, "system": False}) and
            exact_json_value(value["redaction"], {"privatePaths": False, "receiptBytes": False, "secrets": False, "stableMachineIdentifiers": False}),
            "runner_gate_evidence_boundary")
    require(type(value["tests"]) is dict and value["tests"] and all(type(k) is str and v is True for k, v in value["tests"].items()),
            "runner_gate_evidence_tests")
    require(exact_json_value(value["matrix"], {"allPassed": True,
            "count": len(RUNNER_GATE_MATRIX_CASES), "caseIDs": RUNNER_GATE_MATRIX_CASES}),
            "runner_gate_evidence_matrix")
    require(exact_json_value(value["topology"], {"evidenceOnlyChild": True, "noMerge": True,
            "ownerCommitCount": 2, "ownerScope": sorted(RUNNER_GATE_OWNER_SCOPE), "implementationScope": sorted(RUNNER_GATE_SCOPE)}),
            "runner_gate_evidence_topology")
    protected = sorted(INHERITED_PROTECTED_PATHS | PRIVATE_RUNTIME_SCOPE | {PRIVATE_RUNTIME_EVIDENCE, POST_PRIVATE_ROUTING_EVIDENCE, RUNNER_GATE_EVIDENCE} | POST_PRIVATE_ROUTING_SCOPE)
    require(exact_json_value(value["protectedBaseline"], {"count": len(protected), "paths": protected}),
            "runner_gate_evidence_protected_baseline")
    for path in RUNNER_GATE_SCOPE:
        require(value["baseBlobs"].get(path) == git_blob_digest(ROOT, RUNNER_GATE_BASE, path) and
                value["implementationBlobs"].get(path) == git_blob_digest(ROOT, implementation, path),
                "runner_gate_evidence_blob_" + path)
    require(set(value["baseBlobs"]) == RUNNER_GATE_SCOPE and set(value["implementationBlobs"]) == RUNNER_GATE_SCOPE,
            "runner_gate_evidence_blob_shape")


