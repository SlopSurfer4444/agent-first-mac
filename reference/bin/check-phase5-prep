                    "bridge52_environment_fourth_type")
            require(len(accessed_setup) == 2,
                    "bridge52_environment_fourth_count")
            require(bridge_v52_environment_fourth_identity_matches(
                        sealed_identity[0], returned_setup, accessed_setup),
                    "bridge52_environment_fourth_identity")
