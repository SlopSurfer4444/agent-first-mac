def validate_current_shape_evidence(value, implementation):
    required = {"authority", "baseBlobs", "gate", "implementation", "implementationBlobs", "implementationRawCommitSHA256", "matrix", "phase", "publicObservation", "redaction", "schema", "systemMutations", "tests", "topology"}
    require(type(value) is dict and set(value) == required and value["schema"] == 1 and
            value["phase"] == "phase5_current_private_runtime_shape_correction", "current_shape_evidence_shape")
    require(exact_json_value(value["authority"], {"base": CURRENT_SHAPE_BASE, "branch": CURRENT_SHAPE_BRANCH,
            "handoffSHA256": "8b3fecd8ce643685093aae97afd97ee6c0c9dd0878b02943eb9201487b625536"}) and
            exact_json_value(value["implementation"], {"commit": implementation, "parent": CURRENT_SHAPE_BASE,
            "metadata": RUNNER_GATE_METADATA}), "current_shape_evidence_authority")
    require(exact_json_value(value["gate"], {"liveApplyAuthorized": False, "marker": CURRENT_SHAPE_MARKER,
            "maximumVerdict": CURRENT_SHAPE_VERDICT, "phase5PassClaimed": False, "phase6Authorized": False,
            "stageBContinuationRequired": True}), "current_shape_evidence_gate")
    require(exact_json_value(value["publicObservation"], {"externalProjectAdditions": 6, "hookLeafRecords": 3,
            "hookParentTables": 1, "nonProjectTableHeaders": 29, "projectRows": 25,
            "tableHeaders": 54, "vendorRows": 4}), "current_shape_evidence_observation")
    require(exact_json_value(value["redaction"], {"privateHashes": False, "privatePaths": False,
            "projectIdentities": False, "secrets": False, "stableMachineIdentifiers": False}) and
            exact_json_value(value["systemMutations"], {"liveCodex": False, "privateConfig": False,
            "root": False, "system": False}), "current_shape_evidence_boundary")
    require(exact_json_value(value["topology"], {"evidenceOnlyChild": True,
            "implementationPaths": sorted(CURRENT_SHAPE_SCOPE), "noMerge": True,
            "parent": CURRENT_SHAPE_BASE}), "current_shape_evidence_topology")
    require(type(value["matrix"]) is dict and value["matrix"].get("allPassed") is True and
            type(value["matrix"].get("caseIDs")) is list and value["matrix"].get("count") == len(value["matrix"]["caseIDs"]),
            "current_shape_evidence_matrix")
    raw = subprocess.run([*GIT, "cat-file", "commit", implementation], cwd=ROOT,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    require(raw.returncode == 0 and value["implementationRawCommitSHA256"] == hashlib.sha256(raw.stdout).hexdigest() and
            type(value["tests"]) is dict and value["tests"] and all(item is True for item in value["tests"].values()),
            "current_shape_evidence_bindings")
    for path in CURRENT_SHAPE_SCOPE:
        require(value["baseBlobs"].get(path) == git_blob_digest(ROOT, CURRENT_SHAPE_BASE, path) and
                value["implementationBlobs"].get(path) == git_blob_digest(ROOT, implementation, path),
                "current_shape_evidence_blob_" + path)
    require(set(value["baseBlobs"]) == CURRENT_SHAPE_SCOPE and set(value["implementationBlobs"]) == CURRENT_SHAPE_SCOPE,
            "current_shape_evidence_blobs")


def exact_json_value(value, expected):
    """Compare JSON values without Python's bool/int equality aliasing."""
    if type(value) is not type(expected):
        return False
    if type(expected) is dict:
        return set(value) == set(expected) and all(
            exact_json_value(value[key], expected[key]) for key in expected)
    if type(expected) is list:
        return len(value) == len(expected) and all(
            exact_json_value(item, expected[index])
            for index, item in enumerate(value))
    return value == expected


def validate_integrated_private_runtime_evidence_contract(
        value, directory=ROOT, implementation=PRIVATE_RUNTIME_IMPLEMENTATION):
    """Validate the complete accepted private-runtime evidence semantics."""
    required = {
        "authority", "base", "bindings", "branch", "gate", "implementation",
        "phase", "publicObservation", "redaction", "schema", "systemMutations",
        "tests", "topology",
    }
    require(type(value) is dict and set(value) == required,
            "integrated_private_runtime_evidence_shape")
    require(type(value["schema"]) is int and value["schema"] == 1 and
            value["phase"] == "phase5_private_current_runtime_reconciliation_contract" and
            value["base"] == PRIVATE_RUNTIME_BASE and
            value["branch"] == PRIVATE_RUNTIME_BRANCH,
            "integrated_private_runtime_evidence_header")
    require(type(value["implementation"]) is str and
            value["implementation"] == implementation,
            "integrated_private_runtime_evidence_implementation")
    require(exact_json_value(value["authority"], {
        "handoffSHA256": "64fd9d337a18b57878819a0f0b58f3a2d33c08e4b8745bef0feb772c83cd713c",
        "ownerDecision": "согласовано",
        "operationalMigrationDependency": False,
    }), "integrated_private_runtime_evidence_authority")
    require(exact_json_value(value["gate"], {
        "marker": PRIVATE_RUNTIME_MARKER,
        "maximumVerdict": PRIVATE_RUNTIME_VERDICT,
        "phase5PassClaimed": False,
        "phase6Authorized": False,
        "stageBContinuationRequired": True,
    }), "integrated_private_runtime_evidence_gate")
    bindings = value["bindings"]
    require(type(bindings) is dict and set(bindings) == {
        "implementationBlobsSHA256", "implementationMetadata",
        "implementationParent", "implementationRawCommitSHA256",
        "implementationScope",
    } and bindings["implementationParent"] == PRIVATE_RUNTIME_BASE and
            exact_json_value(bindings["implementationMetadata"],
                             PRIVATE_RUNTIME_EXECUTOR_METADATA) and
            exact_json_value(bindings["implementationScope"],
                             sorted(PRIVATE_RUNTIME_SCOPE)) and
            type(bindings["implementationBlobsSHA256"]) is dict and
            set(bindings["implementationBlobsSHA256"]) == PRIVATE_RUNTIME_SCOPE,
            "integrated_private_runtime_evidence_bindings")
    raw = subprocess.run([*GIT, "cat-file", "commit", implementation],
                         cwd=directory, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, check=False)
    require(raw.returncode == 0 and
            bindings["implementationRawCommitSHA256"] ==
            hashlib.sha256(raw.stdout).hexdigest() and
            all(bindings["implementationBlobsSHA256"][path] ==
                git_blob_digest(directory, implementation, path)
                for path in PRIVATE_RUNTIME_SCOPE),
            "integrated_private_runtime_evidence_raw_bindings")
    require(exact_json_value(value["publicObservation"], {
        "externalProjectAdditions": 4,
        "hookLeafRecords": 3,
        "hookParentTables": 1,
        "projectRows": 23,
        "vendorRows": 4,
    }), "integrated_private_runtime_evidence_public_observation")
    require(exact_json_value(value["redaction"], {
        "privateHashes": False, "privatePaths": False, "secrets": False,
        "stableMachineIdentifiers": False,
    }), "integrated_private_runtime_evidence_redaction")
    require(exact_json_value(value["systemMutations"], {
        "liveCodex": False, "privateConfig": False, "root": False,
        "system": False,
    }), "integrated_private_runtime_evidence_mutations")
    require(exact_json_value(value["topology"], {
        "evidenceOnlyChild": True,
        "implementationPaths": sorted(PRIVATE_RUNTIME_SCOPE),
        "noMerge": True,
        "parent": PRIVATE_RUNTIME_BASE,
    }), "integrated_private_runtime_evidence_topology")
    require(type(value["tests"]) is dict and value["tests"] and
            all(type(key) is str and item is True
                for key, item in value["tests"].items()),
            "integrated_private_runtime_evidence_tests")


def validate_integrated_private_runtime_pair():
    require(git("rev-parse", PRIVATE_RUNTIME_IMPLEMENTATION + "^") == PRIVATE_RUNTIME_BASE and
            git("rev-parse", PRIVATE_RUNTIME_EVIDENCE_COMMIT + "^") == PRIVATE_RUNTIME_IMPLEMENTATION and
            commit_scope(PRIVATE_RUNTIME_IMPLEMENTATION) == PRIVATE_RUNTIME_SCOPE and
            commit_scope(PRIVATE_RUNTIME_EVIDENCE_COMMIT) == {PRIVATE_RUNTIME_EVIDENCE} and
            metadata(PRIVATE_RUNTIME_IMPLEMENTATION, cwd=ROOT) == CURRENT_MAIN_METADATA and
            metadata(PRIVATE_RUNTIME_EVIDENCE_COMMIT, cwd=ROOT) == CURRENT_MAIN_METADATA,
            "integrated_private_runtime_pair_topology")
    value = strict_json_text(git("show", PRIVATE_RUNTIME_EVIDENCE_COMMIT + ":" + PRIVATE_RUNTIME_EVIDENCE))
    validate_integrated_private_runtime_evidence_contract(value)
    for commit, paths, label in ((PRIVATE_RUNTIME_IMPLEMENTATION, PRIVATE_RUNTIME_SCOPE, "implementation"),
                                 (PRIVATE_RUNTIME_EVIDENCE_COMMIT, {PRIVATE_RUNTIME_EVIDENCE}, "evidence")):
        for path in paths:
            mode = git("ls-tree", commit, "--", path).split()[0]
            require(mode == ("100755" if path.startswith("bin/") else "100644"),
                    "integrated_private_runtime_" + label + "_mode_" + path)


def validate_post_private_routing_evidence(value, implementation):
    required = {"acceptedPrivatePair", "base", "baseBlobs", "commitPolicy", "gate", "implementation",
                "implementationBlobs", "matrix", "phase", "protectedBaseline", "redaction", "schema", "systemMutations", "tests"}
    require(set(value) == required and value["schema"] == 1 and
            value["phase"] == "phase5_private_current_runtime_post_integration_routing_correction" and
            value["base"] == PRIVATE_RUNTIME_EVIDENCE_COMMIT and
            value["acceptedPrivatePair"] == {"evidence": PRIVATE_RUNTIME_EVIDENCE_COMMIT, "implementation": PRIVATE_RUNTIME_IMPLEMENTATION} and
            value["implementation"] == {"commit": implementation, "parent": PRIVATE_RUNTIME_EVIDENCE_COMMIT,
                                           "metadata": PRIVATE_RUNTIME_EXECUTOR_METADATA} and
            value["commitPolicy"] == POST_PRIVATE_ROUTING_POLICY and
            value["gate"] == {"liveApplyAuthorized": False, "marker": POST_PRIVATE_ROUTING_MARKER,
                              "maximumVerdict": POST_PRIVATE_ROUTING_VERDICT, "phase5PassClaimed": False,
                              "phase6Authorized": False} and
            value["systemMutations"] == {"live": False, "private": False, "root": False, "system": False} and
            value["redaction"] == {"privateHashes": False, "privatePaths": False, "secrets": False,
                                  "stableMachineIdentifiers": False} and
            isinstance(value["tests"], dict) and value["tests"] and all(value["tests"].values()) and
            value["matrix"] == {"allPassed": True, "count": 62, "caseIDs": sorted(value["matrix"].get("caseIDs", []))} and
            set(value["baseBlobs"]) == POST_PRIVATE_ROUTING_SCOPE and
            set(value["implementationBlobs"]) == POST_PRIVATE_ROUTING_SCOPE,
            "post_private_routing_evidence_contract")
    for path in POST_PRIVATE_ROUTING_SCOPE:
        require(value["baseBlobs"][path] == git_blob_digest(ROOT, PRIVATE_RUNTIME_EVIDENCE_COMMIT, path) and
                value["implementationBlobs"][path] == git_blob_digest(ROOT, implementation, path),
                "post_private_routing_blob_" + path)
    protected = sorted(INHERITED_PROTECTED_PATHS | PRIVATE_RUNTIME_SCOPE |
                       {PRIVATE_RUNTIME_EVIDENCE, POST_PRIVATE_ROUTING_EVIDENCE})
    require(value["protectedBaseline"] == {"authority": "accepted-private-runtime-post-integration-routing",
                                              "count": 21, "paths": protected,
                                              "source": "6bb3fffbd2a96aed0d5451243857de6ddf228d7e"},
            "post_private_routing_protected_baseline")


def post_integration_evidence_contract(value, implementation, evidence_commit):
    """Bind the append-only repair without allowing its receipt to self-attest.

    Evidence cannot name its own object id (doing so would change that id), so
    the caller verifies the evidence commit's parent and neutral metadata from
    Git and the object records the corresponding immutable expectation.
    """
    required = {
        "authority", "baseBlobs", "commitPolicy", "evidence", "gate", "historicalPhase2",
        "implementation", "implementationBlobs", "phase", "protectedBaseline",
        "repositoryProof", "schema", "systemMutations",
    }
    require(set(value) == required, "post_integration_evidence_keys")
    require(value["schema"] == 1 and
            value["phase"] == "phase5_post_integration_phase2_doctor_compatibility_correction" and
            value["authority"] == {
                "base": POST_INTEGRATION_BASE,
                "branch": CURRENT_MAIN_BRANCH,
                "phase4Acceptance": "448626030776911a94f50ea95e984153dc16b353",
                "phase5Accepted": "05b190bb4886f3138152ceeaefa0e3fe3869ce4c",
            }, "post_integration_evidence_authority")
    require(value["implementation"] == {
                "commit": implementation,
                "metadata": CURRENT_MAIN_METADATA,
                "parent": POST_INTEGRATION_BASE,
            } and value["evidence"] == {
                "metadata": CURRENT_MAIN_METADATA,
                "parent": implementation,
            }, "post_integration_evidence_commits")
    require(value["commitPolicy"] == {
                "baseCommitterEpoch": POST_INTEGRATION_BASE_EPOCH,
                "evidence": POST_INTEGRATION_COMMIT_POLICY["evidence"],
                "implementation": POST_INTEGRATION_COMMIT_POLICY["implementation"],
            }, "post_integration_evidence_commit_policy")
    require(value["gate"] == {
                "liveApplyAuthorized": False,
                "marker": POST_INTEGRATION_MARKER,
                "maximumVerdict": POST_INTEGRATION_VERDICT,
                "phase5PassClaimed": False,
                "phase6Authorized": False,
            }, "post_integration_evidence_gate")
    require(value["historicalPhase2"] == {
                "acceptance": POST_INTEGRATION_HISTORICAL_PHASE2_ACCEPTANCE,
                "reviewed": POST_INTEGRATION_HISTORICAL_PHASE2_REVIEWED,
                "sourceProtectedBaseline": POST_INTEGRATION_BASE,
            }, "post_integration_evidence_historical_phase2")
    protected = sorted(CURRENT_MAIN_SCOPE | {CURRENT_MAIN_EVIDENCE} |
                       POST_INTEGRATION_SCOPE | {POST_INTEGRATION_EVIDENCE})
    require(value["protectedBaseline"] == {
                "evidenceParent": implementation,
                "paths": protected,
            }, "post_integration_evidence_protected_baseline")
    require(value["repositoryProof"] == {
                "historicalDoctorNoOrigin": True,
                "historicalDoctorRepeatedByteIdentical": True,
                "historicalDoctorSchemaClosed": True,
                "protectedDescendantNegative": True,
                "unprotectedDescendantsAllowed": True,
            }, "post_integration_evidence_repository_proof")
    require(value["systemMutations"] == {
                "liveCodex": False,
                "phase5Pass": False,
                "phase6": False,
                "privateConfig": False,
                "root": False,
                "system": False,
            }, "post_integration_evidence_mutations")
    for relative in POST_INTEGRATION_SCOPE:
        require(value["baseBlobs"].get(relative) ==
                git_blob_digest(ROOT, POST_INTEGRATION_BASE, relative) and
                value["implementationBlobs"].get(relative) ==
                git_blob_digest(ROOT, implementation, relative),
                "post_integration_evidence_hash_" + relative)
    require(set(value["baseBlobs"]) == POST_INTEGRATION_SCOPE and
            set(value["implementationBlobs"]) == POST_INTEGRATION_SCOPE,
            "post_integration_evidence_hash_maps")


def post_integration_topology_matrix():
    """Repository-only adversarial checks for the new protected baseline."""
    workspace = Path(tempfile.mkdtemp(prefix="phase5-post-integration-matrix-"))
    failures = 0
    commit_environment = {
        "GIT_AUTHOR_NAME": "Phase 5 Executor",
        "GIT_AUTHOR_EMAIL": "phase5-executor@agent-first-mac.invalid",
        "GIT_COMMITTER_NAME": "Phase 5 Executor",
        "GIT_COMMITTER_EMAIL": "phase5-executor@agent-first-mac.invalid",
        "LC_ALL": "C", "LANG": "C", "PATH": "/usr/bin:/bin",
    }

    def clone(name):
        directory = workspace / name
        checked([*GIT, "clone", "--no-local", "--quiet", "--branch",
                 CURRENT_MAIN_BRANCH, ROOT, directory])
        checked([*GIT, "remote", "remove", "origin"], cwd=directory)
        require(git("remote", cwd=directory) == "", "post_integration_origin_retained")
        return directory

    def validator(directory):
        return run([directory / "bin/check-phase5-prep", "--git-only", "--json"],
                   cwd=directory)

    def reject(name, prepare):
        nonlocal failures
        directory = clone(name)
        prepare(directory)
        value = validator(directory)
        require(value.returncode != 0, "post_integration_matrix_accepted_" + name)
        failures += 1

    try:
        clean = clone("clean")
        first = validator(clean)
        second = validator(clean)
        clean_value = strict_json_text(first.stdout, "post_integration_clean")
        require(first.returncode == second.returncode == 0 and first.stdout == second.stdout and
                clean_value["marker"] == POST_INTEGRATION_MARKER and
                clean_value["verdict"] == POST_INTEGRATION_VERDICT and
                clean_value["repositoryState"] == "post_integration_review",
                "post_integration_clean_no_origin")
        unprotected = clone("unprotected-descendant")
        (unprotected / "unprotected-post-integration-marker").write_text("fixture\n")
        checked([*GIT, "add", "--", "unprotected-post-integration-marker"], cwd=unprotected)
        checked([*GIT, "commit", "-q", "-m", "unprotected fixture"], cwd=unprotected,
                environment=commit_environment)
        require(validator(unprotected).returncode == 0,
                "post_integration_unprotected_descendant")
        (unprotected / "unprotected-post-integration-marker-two").write_text("fixture\n")
        checked([*GIT, "add", "--", "unprotected-post-integration-marker-two"], cwd=unprotected)
        checked([*GIT, "commit", "-q", "-m", "second unprotected fixture"], cwd=unprotected,
                environment=commit_environment)
        require(validator(unprotected).returncode == 0,
                "post_integration_two_unprotected_descendants")
        reject("dirty", lambda directory: (directory / "dirty").write_text("fixture\n"))
        reject("detached", lambda directory: checked([*GIT, "checkout", "-q", "--detach"], cwd=directory))
        reject("wrong-branch", lambda directory: checked([*GIT, "checkout", "-q", "-b", "wrong"], cwd=directory))
        impl, evidence = git("rev-list", "--reverse", POST_INTEGRATION_BASE + "..HEAD").splitlines()[:2]
        def rewritten_start(directory):
            checked([*GIT, "checkout", "-q", "-B", CURRENT_MAIN_BRANCH,
                     POST_INTEGRATION_BASE], cwd=directory)
        def missing_evidence(directory):
            checked([*GIT, "checkout", "-q", "-B", CURRENT_MAIN_BRANCH, impl], cwd=directory)
        reject("missing-evidence", missing_evidence)
        def wrong_parent(directory):
            rewritten_start(directory)
            checked([*GIT, "commit", "-q", "--allow-empty", "-m", "bridge"],
                    cwd=directory, environment=commit_environment)
            checked([*GIT, "cherry-pick", "--no-edit", impl], cwd=directory,
                    environment=commit_environment)
            checked([*GIT, "cherry-pick", "--no-edit", evidence], cwd=directory,
                    environment=commit_environment)
        reject("wrong-parent-bridge", wrong_parent)
        def content_equivalent_extra_parent_bridge(directory):
            rewritten_start(directory)
            checked([*GIT, "commit", "-q", "--allow-empty", "-m", "extra parent bridge"],
                    cwd=directory, environment=commit_environment)
            checked([*GIT, "cherry-pick", "--no-commit", impl], cwd=directory,
                    environment=commit_environment)
            checked([*GIT, "commit", "-q", "-m",
                     POST_INTEGRATION_COMMIT_POLICY["implementation"]["message"].rstrip("\n")],
                    cwd=directory, environment=commit_environment)
            alternate = git("rev-parse", "HEAD", cwd=directory)
            substituted = strict_json_text(git("show", evidence + ":" + POST_INTEGRATION_EVIDENCE),
                                            "bridge-evidence")
            substituted["implementation"]["commit"] = alternate
            substituted["evidence"]["parent"] = alternate
            substituted["protectedBaseline"]["evidenceParent"] = alternate
            path = directory / POST_INTEGRATION_EVIDENCE
            path.write_text(json.dumps(substituted, sort_keys=True) + "\n")
            checked([*GIT, "add", "--", POST_INTEGRATION_EVIDENCE], cwd=directory)
            checked([*GIT, "commit", "-q", "-m",
                     POST_INTEGRATION_COMMIT_POLICY["evidence"]["message"].rstrip("\n")],
                    cwd=directory, environment=commit_environment)
        reject("content-equivalent-extra-parent-bridge", content_equivalent_extra_parent_bridge)
        def wrong_scope(directory):
            rewritten_start(directory)
            checked([*GIT, "cherry-pick", "--no-commit", impl], cwd=directory,
                    environment=commit_environment)
            (directory / "unexpected-post-integration-path").write_text("fixture\n")
            checked([*GIT, "add", "-A"], cwd=directory)
            checked([*GIT, "commit", "-q", "-m", "wrong scope"], cwd=directory,
                    environment=commit_environment)
            checked([*GIT, "cherry-pick", "--no-edit", evidence], cwd=directory,
                    environment=commit_environment)
        reject("wrong-scope", wrong_scope)
        def wrong_metadata(directory):
            rewritten_start(directory)
            bad = dict(commit_environment)
            bad.update({"GIT_COMMITTER_NAME": "Other", "GIT_COMMITTER_EMAIL": "other@example.invalid"})
            checked([*GIT, "cherry-pick", "--no-edit", impl], cwd=directory, environment=bad)
            checked([*GIT, "cherry-pick", "--no-edit", evidence], cwd=directory, environment=bad)
        reject("wrong-metadata", wrong_metadata)
        def merge_bridge(directory):
            checked([*GIT, "checkout", "-q", "-B", "side"], cwd=directory)
            checked([*GIT, "commit", "-q", "--allow-empty", "-m", "side"], cwd=directory,
                    environment=commit_environment)
            checked([*GIT, "checkout", "-q", CURRENT_MAIN_BRANCH], cwd=directory)
            checked([*GIT, "commit", "-q", "--allow-empty", "-m", "main"], cwd=directory,
                    environment=commit_environment)
            checked([*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"], cwd=directory,
                    environment=commit_environment)
        reject("merge", merge_bridge)
        def protected_drift(directory):
            path = directory / POST_INTEGRATION_EVIDENCE
            path.write_text(path.read_text() + "\n")
            checked([*GIT, "add", "--", POST_INTEGRATION_EVIDENCE], cwd=directory)
            checked([*GIT, "commit", "-q", "-m", "protected evidence drift"], cwd=directory,
                    environment=commit_environment)
        reject("protected-evidence", protected_drift)
        def validator_drift(directory):
            path = directory / "bin/check-phase5-prep"
            path.write_text(path.read_text() + "# fixture\n")
            checked([*GIT, "add", "--", "bin/check-phase5-prep"], cwd=directory)
            checked([*GIT, "commit", "-q", "-m", "protected validator drift"], cwd=directory,
                    environment=commit_environment)
        reject("protected-validator", validator_drift)
        def evidence_substitution(directory):
            path = directory / POST_INTEGRATION_EVIDENCE
            substituted = strict_json(path)
            substituted["implementationBlobs"]["bin/check-phase5-prep"] = "0" * 64
            path.write_text(json.dumps(substituted, sort_keys=True) + "\n")
            checked([*GIT, "add", "--", POST_INTEGRATION_EVIDENCE], cwd=directory)
            checked([*GIT, "commit", "-q", "--amend", "--no-edit"], cwd=directory,
                    environment=commit_environment)
        reject("evidence-substitution", evidence_substitution)
        def canonical_identity_rejected(directory):
            rewritten_start(directory)
            alternate_environment = dict(commit_environment)
            alternate_environment.update({
                "GIT_AUTHOR_DATE": str(POST_INTEGRATION_BASE_EPOCH + 11) + " +0000",
                "GIT_COMMITTER_DATE": str(POST_INTEGRATION_BASE_EPOCH + 11) + " +0000",
            })
            checked([*GIT, "cherry-pick", "--no-commit", impl], cwd=directory,
                    environment=alternate_environment)
            checked([*GIT, "commit", "-q", "-m",
                     POST_INTEGRATION_COMMIT_POLICY["implementation"]["message"].rstrip("\n")],
                    cwd=directory, environment=alternate_environment)
            alternate = git("rev-parse", "HEAD", cwd=directory)
            substituted = strict_json_text(git("show", evidence + ":" + POST_INTEGRATION_EVIDENCE),
                                            "alternate-identity-evidence")
            substituted["implementation"]["commit"] = alternate
            substituted["evidence"]["parent"] = alternate
            substituted["protectedBaseline"]["evidenceParent"] = alternate
            substituted["commitPolicy"]["implementation"]["epoch"] = (
                POST_INTEGRATION_BASE_EPOCH + 11)
            substituted["commitPolicy"]["evidence"]["epoch"] = (
                POST_INTEGRATION_BASE_EPOCH + 12)
            path = directory / POST_INTEGRATION_EVIDENCE
            path.write_text(json.dumps(substituted, sort_keys=True) + "\n")
            alternate_environment["GIT_AUTHOR_DATE"] = str(POST_INTEGRATION_BASE_EPOCH + 12) + " +0000"
            alternate_environment["GIT_COMMITTER_DATE"] = str(POST_INTEGRATION_BASE_EPOCH + 12) + " +0000"
            checked([*GIT, "add", "--", POST_INTEGRATION_EVIDENCE], cwd=directory)
            checked([*GIT, "commit", "-q", "-m",
                     POST_INTEGRATION_COMMIT_POLICY["evidence"]["message"].rstrip("\n")],
                    cwd=directory, environment=alternate_environment)
            alternate_evidence = git("rev-parse", "HEAD", cwd=directory)
            expected_policy = {
                "baseCommitterEpoch": POST_INTEGRATION_BASE_EPOCH,
                "implementation": dict(POST_INTEGRATION_COMMIT_POLICY["implementation"],
                                       epoch=POST_INTEGRATION_BASE_EPOCH + 11),
                "evidence": dict(POST_INTEGRATION_COMMIT_POLICY["evidence"],
                                 epoch=POST_INTEGRATION_BASE_EPOCH + 12),
            }
            def reconstructed_from_policy(commit, parent, policy):
                content = (
                    "tree " + git("show", "-s", "--format=%T", commit, cwd=directory) + "\n" +
                    "parent " + parent + "\n" +
                    "author " + policy["author"] + " " + str(policy["epoch"]) + " " +
                    policy["timezone"] + "\n" +
                    "committer " + policy["committer"] + " " + str(policy["epoch"]) + " " +
                    policy["timezone"] + "\n\n" + policy["message"]
                ).encode()
                result = run([*GIT, "cat-file", "commit", commit], cwd=directory)
                return (result.returncode == 0 and result.stdout.encode() == content and
                        hashlib.sha1(b"commit " + str(len(content)).encode() + b"\0" + content).
                        hexdigest() == commit)
            committed_evidence = strict_json_text(
                git("show", alternate_evidence + ":" + POST_INTEGRATION_EVIDENCE,
                    cwd=directory),
                "alternate-identity-committed-evidence")
            require(committed_evidence == substituted and
                    substituted["commitPolicy"] == expected_policy and
                    reconstructed_from_policy(alternate, POST_INTEGRATION_BASE,
                                              substituted["commitPolicy"]["implementation"]) and
                    reconstructed_from_policy(alternate_evidence, alternate,
                                              substituted["commitPolicy"]["evidence"]),
                    "post_integration_same_tree_fixture_self_consistency")
            for executable, arguments in (
                ("bin/check-phase5-prep", ["--git-only", "--json"]),
                ("bin/check-phase4-final-probes", ["--git-only"]),
                ("bin/check-phase5-apply-bundle", ["--git-only", "--json"]),
            ):
                result = run([directory / executable, *arguments], cwd=directory)
                require(result.returncode != 0 and "post_integration_implementation_commit_identity" in result.stdout,
                        "post_integration_same_tree_identity_accepted_" + Path(executable).name)
        canonical_identity_rejected(clone("same-tree-alternate-identity"))
        failures += 1
        value = strict_json_text(git("show", evidence + ":" + POST_INTEGRATION_EVIDENCE),
                                 "post_integration_evidence")
        for name, mutate in {
            "extra": lambda item: item.update(extra=True),
            "hash": lambda item: item["implementationBlobs"].update(
                {"bin/check-phase5-prep": "0" * 64}),
            "base_hash": lambda item: item["baseBlobs"].update(
                {"bin/check-phase5-prep": "0" * 64}),
            "wrong_base": lambda item: item["authority"].update(base="0" * 40),
            "historical": lambda item: item["historicalPhase2"].update(reviewed="0" * 40),
            "gate": lambda item: item["gate"].update(phase5PassClaimed=True),
            "mutation": lambda item: item["systemMutations"].update(root=True),
            "protected": lambda item: item["protectedBaseline"].update(paths=[]),
        }.items():
            candidate = json.loads(json.dumps(value))
            mutate(candidate)
            try:
                post_integration_evidence_contract(candidate, impl, evidence)
            except (RuntimeError, ValueError, KeyError, TypeError):
                failures += 1
                continue
            raise RuntimeError("post_integration_evidence_accepted_" + name)
        phase4 = load_module("post_integration_phase4", ROOT / "bin/phase4-final-doctor")
        def expected(name, reason, action):
            nonlocal failures
            try:
                action()
            except RuntimeError as error:
                require(str(error) == reason, "post_integration_reason_" + name)
                failures += 1
                return
            raise RuntimeError("post_integration_historical_accepted_" + name)
        expected("historical_acceptance_missing", "phase2_historical_acceptance_missing",
                 lambda: phase4.validate_historical_phase2_topology(ROOT, acceptance="0" * 40))
        expected("historical_acceptance_substituted", "phase2_historical_acceptance_parent",
                 lambda: phase4.validate_historical_phase2_topology(
                     ROOT, acceptance=phase4.PHASE2_HISTORICAL_REVIEWED))
        expected("historical_acceptance_wrong_parent", "phase2_historical_acceptance_parent",
                 lambda: phase4.validate_historical_phase2_topology(
                     ROOT, reviewed=phase4.PHASE2_CURRENT_CONTROL))
        orphan = workspace / "historical-nonancestor"
        checked([*GIT, "init", "-q", orphan])
        checked([*GIT, "commit", "-q", "--allow-empty", "-m", "orphan reviewed"], cwd=orphan,
                environment=commit_environment)
        orphan_reviewed = git("rev-parse", "HEAD", cwd=orphan)
        checked([*GIT, "commit", "-q", "--allow-empty", "-m", "orphan acceptance"], cwd=orphan,
                environment=commit_environment)
        orphan_acceptance = git("rev-parse", "HEAD", cwd=orphan)
        expected("historical_acceptance_nonancestor", "phase2_historical_acceptance_nonancestor",
                 lambda: phase4.validate_historical_phase2_topology(
                     orphan, acceptance=orphan_acceptance, reviewed=orphan_reviewed))
        retained_origin = workspace / "historical-origin"
        checked([*GIT, "clone", "--no-local", "--quiet", ROOT, retained_origin])
        checked([*GIT, "checkout", "-q", "-B", "main", phase4.PHASE2_HISTORICAL_ACCEPTANCE],
                cwd=retained_origin)
        expected("historical_clone_retained_origin", "phase2_historical_clone_origin",
                 lambda: phase4.validate_historical_phase2_clone(retained_origin))
        historical = clone("historical-doctor")
        checked([*GIT, "checkout", "-q", "-B", "main", phase4.PHASE2_HISTORICAL_ACCEPTANCE],
                cwd=historical)
        phase4.validate_historical_phase2_clone(historical)
        expected("historical_clone_wrong_branch", "phase2_historical_clone_branch",
                 lambda: (checked([*GIT, "checkout", "-q", "-B", "other"], cwd=historical),
                          phase4.validate_historical_phase2_clone(historical)))
        checked([*GIT, "checkout", "-q", "-B", "main", phase4.PHASE2_HISTORICAL_ACCEPTANCE],
                cwd=historical)
        expected("historical_clone_wrong_head", "phase2_historical_clone_head",
                 lambda: (checked([*GIT, "checkout", "-q", "-B", "main", phase4.PHASE2_HISTORICAL_REVIEWED], cwd=historical),
                          phase4.validate_historical_phase2_clone(historical)))
        checked([*GIT, "checkout", "-q", "-B", "main", phase4.PHASE2_HISTORICAL_ACCEPTANCE],
                cwd=historical)
        (historical / "historical-dirty").write_text("fixture\n")
        expected("historical_clone_dirty", "phase2_historical_clone_dirty",
                 lambda: phase4.validate_historical_phase2_clone(historical))
        (historical / "historical-dirty").unlink()
        doctor_one = run([historical / "bin/phase2-doctor", "--json"], cwd=historical)
        doctor_two = run([historical / "bin/phase2-doctor", "--json"], cwd=historical)
        require(phase4.validate_historical_phase2_doctor_runs(doctor_one, doctor_two),
                "post_integration_historical_doctor_positive")
        expected("historical_doctor_rc", "phase2_historical_doctor_rc",
                 lambda: phase4.validate_historical_phase2_doctor_runs(
                     SimpleNamespace(returncode=1, stdout=doctor_one.stdout), doctor_two))
        expected("historical_doctor_output", "phase2_historical_live_doctor",
                 lambda: phase4.validate_historical_phase2_doctor_runs(
                     doctor_one, SimpleNamespace(returncode=0, stdout=doctor_two.stdout + "\n")))
        parsed_doctor = strict_json_text(doctor_one.stdout, "historical-doctor")
        for name, mutate in {
            "historical_doctor_schema": lambda item: item.update(schema=2),
            "historical_doctor_schema_true": lambda item: item.update(schema=True),
            "historical_doctor_schema_float": lambda item: item.update(schema=1.0),
            "historical_doctor_check_set": lambda item: item["checks"].pop(),
            "historical_doctor_verdict": lambda item: item.update(verdict="FAIL"),
            "historical_doctor_repeat": lambda item: item.update(phase="other"),
        }.items():
            altered = json.loads(json.dumps(parsed_doctor))
            mutate(altered)
            expected(name, "phase2_historical_live_doctor",
                     lambda altered=altered: phase4.validate_historical_phase2_doctor_output(
                         json.dumps(altered, sort_keys=True), json.dumps(altered, sort_keys=True)))
        def altered_doctor(name, mutate):
            altered = json.loads(json.dumps(parsed_doctor))
            mutate(altered)
            expected(name, "phase2_historical_live_doctor",
                     lambda altered=altered: phase4.validate_historical_phase2_doctor_output(
                         json.dumps(altered, sort_keys=True), json.dumps(altered, sort_keys=True)))
        altered_doctor("historical_doctor_facts_empty",
                       lambda item: item["checks"][0].update(facts={}))
        altered_doctor("historical_doctor_facts_string",
                       lambda item: item["checks"][0].update(facts="anything"))
        altered_doctor("historical_doctor_facts_private_path",
                       lambda item: item["checks"][0]["facts"].update(privatePath="/" + "Users/example/secret"))
        altered_doctor("historical_doctor_facts_missing",
                       lambda item: item["checks"][0]["facts"].pop("standalone"))
        altered_doctor("historical_doctor_facts_wrong_value",
                       lambda item: item["checks"][0]["facts"].update(standalone=False))
        altered_doctor("historical_doctor_facts_cross_assigned",
                       lambda item: item["checks"][0].update(facts=item["checks"][1]["facts"]))
        def exact_type_substitutions(value, path=()):
            if type(value) is dict:
                for key in sorted(value):
                    yield from exact_type_substitutions(value[key], path + (key,))
            elif type(value) is list:
                for index, item in enumerate(value):
                    yield from exact_type_substitutions(item, path + (index,))
            elif type(value) is bool:
                yield path, "bool_int", int(value)
                yield path, "bool_float", float(value)
            elif type(value) is int:
                yield path, "int_float", float(value)
                if value in {0, 1}:
                    yield path, "int_bool", bool(value)

        def replace_json_path(value, path, replacement):
            target = value
            for key in path[:-1]:
                target = target[key]
            target[path[-1]] = replacement

        for index, check in enumerate(parsed_doctor["checks"]):
            for path, substitution, replacement in exact_type_substitutions(check["facts"]):
                altered = json.loads(json.dumps(parsed_doctor))
                replace_json_path(altered["checks"][index]["facts"], path, replacement)
                path_name = "_".join(str(item) for item in path)
                expected("historical_doctor_fact_type_" + check["id"] + "_" + path_name +
                         "_" + substitution, "phase2_historical_live_doctor",
                         lambda altered=altered: phase4.validate_historical_phase2_doctor_output(
                             json.dumps(altered, sort_keys=True),
                             json.dumps(altered, sort_keys=True)))
        unequal = json.loads(json.dumps(parsed_doctor))
        unequal["checks"][0]["facts"]["standalone"] = False
        expected("historical_doctor_true_unequal_repeat", "phase2_historical_live_doctor",
                 lambda: phase4.validate_historical_phase2_doctor_output(
                     doctor_one.stdout, json.dumps(unequal, sort_keys=True)))
        return {"cleanNoOrigin": True, "negativeCases": failures,
                "unprotectedDescendants": 2}
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def current_main_compatibility(mode="git-only"):
    branch, head = git("branch", "--show-current"), git("rev-parse", "HEAD")
    if branch not in {CURRENT_MAIN_BRANCH, POST_PRIVATE_ROUTING_BRANCH, RUNNER_GATE_BRANCH, CURRENT_SHAPE_BRANCH, "main"} or head == CURRENT_MAIN_BASE:
        return None
    require(git("status", "--porcelain=v1", "--untracked-files=all") == "",
            "current_main_dirty_worktree")
    require(git("remote") == "", "current_main_origin")
    if run([*GIT, "merge-base", "--is-ancestor", CURRENT_MAIN_BASE, head]).returncode != 0:
        return None
    commits = git("rev-list", "--reverse", CURRENT_MAIN_BASE + ".." + head).splitlines()
    if len(commits) < 2:
        return None
    implementation, evidence_commit = commits[:2]
    require(git("rev-parse", implementation + "^") == CURRENT_MAIN_BASE and
            git("rev-parse", evidence_commit + "^") == implementation,
            "current_main_pair_parent")
    require(commit_scope(implementation) == CURRENT_MAIN_SCOPE and
            commit_scope(evidence_commit) == {CURRENT_MAIN_EVIDENCE},
            "current_main_pair_scope")
    require(metadata(implementation, cwd=ROOT) == CURRENT_MAIN_METADATA and
            metadata(evidence_commit, cwd=ROOT) == CURRENT_MAIN_METADATA,
            "current_main_pair_metadata")
    require(git("rev-list", "--merges", CURRENT_MAIN_BASE + ".." + head) == "",
            "current_main_pair_merge")
    evidence = strict_json_text(git("show", evidence_commit + ":" + CURRENT_MAIN_EVIDENCE))
    require(set(evidence) == {"authority", "baseBlobs", "gate", "implementationBlobs",
                              "implementationCommit", "phase", "phase4Compatibility",
                              "runtimeObservation", "schema", "systemMutations"},
            "current_main_evidence_schema")
    require(evidence["schema"] == 1 and
            evidence["phase"] == "phase5_current_main_runtime_phase4_doctor_compatibility" and
            evidence["implementationCommit"] == implementation and
            evidence["authority"] == {"base": CURRENT_MAIN_BASE, "branch": CURRENT_MAIN_BRANCH,
                                      "phase4Acceptance": "448626030776911a94f50ea95e984153dc16b353",
                                      "phase5Accepted": "05b190bb4886f3138152ceeaefa0e3fe3869ce4c"},
            "current_main_evidence_header")
    require(evidence["gate"] == {"liveApplyAuthorized": False, "marker": CURRENT_MAIN_MARKER,
                                   "maximumVerdict": CURRENT_MAIN_VERDICT,
                                   "phase5PassClaimed": False, "phase6Authorized": False},
            "current_main_evidence_gate")
    require(evidence["systemMutations"] == {"codex": False, "live": False, "root": False,
                                             "system": False}, "current_main_evidence_mutations")
    require(evidence["phase4Compatibility"] == {
        "directoryAllocationSizesHistoricalOnly": True,
        "historicalGeneration2And3Retained": True,
        "laterCurrentGenerationReceiptBound": True,
        "secureAuditAndStagingDirectories": True,
    }, "current_main_phase4_compatibility")
    require(evidence["runtimeObservation"] == {
        "appBuild": "5848",
        "appVersion": "26.721.41059",
        "cliVersion": "codex-cli 0.146.0-alpha.3.1",
        "mcpRows": 3,
        "orderedPlugins": 13,
        "privateConfigRecorded": False,
    }, "current_main_runtime_observation")
    for relative in CURRENT_MAIN_SCOPE:
        require(evidence["implementationBlobs"].get(relative) ==
                git_blob_digest(ROOT, implementation, relative) and
                evidence["baseBlobs"].get(relative) ==
                git_blob_digest(ROOT, CURRENT_MAIN_BASE, relative),
                "current_main_evidence_hash_" + relative)
    require(set(evidence["implementationBlobs"]) == CURRENT_MAIN_SCOPE and
            set(evidence["baseBlobs"]) == CURRENT_MAIN_SCOPE,
            "current_main_evidence_hash_map")
    protected = CURRENT_MAIN_SCOPE | {CURRENT_MAIN_EVIDENCE}
    later = commit_range_paths(evidence_commit, head)
    if later:
        commits = git("rev-list", "--reverse", POST_INTEGRATION_BASE + ".." + head).splitlines()
        require(len(commits) >= 2 and git("rev-parse", commits[0] + "^") == POST_INTEGRATION_BASE and
                git("rev-parse", commits[1] + "^") == commits[0] and commit_scope(commits[0]) == POST_INTEGRATION_SCOPE and
                commit_scope(commits[1]) == {POST_INTEGRATION_EVIDENCE} and metadata(commits[0], cwd=ROOT) == CURRENT_MAIN_METADATA and metadata(commits[1], cwd=ROOT) == CURRENT_MAIN_METADATA,
                "post_integration_pair_topology")
        require(int(git("show", "-s", "--format=%ct", POST_INTEGRATION_BASE)) ==
                POST_INTEGRATION_BASE_EPOCH, "post_integration_base_epoch")
        validate_post_integration_commit_identity(
            commits[0], POST_INTEGRATION_BASE, "implementation")
        validate_post_integration_commit_identity(
            commits[1], commits[0], "evidence")
        post = strict_json_text(git("show", commits[1] + ":" + POST_INTEGRATION_EVIDENCE))
        post_integration_evidence_contract(post, commits[0], commits[1])
        protected |= POST_INTEGRATION_SCOPE | {POST_INTEGRATION_EVIDENCE}
        validate_integrated_private_runtime_pair()
        private_commits = git("rev-list", "--reverse", commits[1] + ".." + head).splitlines()
        require(private_commits[:2] == [PRIVATE_RUNTIME_IMPLEMENTATION, PRIVATE_RUNTIME_EVIDENCE_COMMIT],
                "integrated_private_runtime_pair_sequence")
        protected |= PRIVATE_RUNTIME_SCOPE | {PRIVATE_RUNTIME_EVIDENCE}
        later = commit_range_paths(PRIVATE_RUNTIME_EVIDENCE_COMMIT, head)
        if later:
            correction = git("rev-list", "--reverse", PRIVATE_RUNTIME_EVIDENCE_COMMIT + ".." + head).splitlines()
            if len(correction) == 1:
                implementation = correction[0]
                require(mode == "implementation" and branch == POST_PRIVATE_ROUTING_BRANCH and
                        head == implementation and
                        git("rev-parse", implementation + "^") == PRIVATE_RUNTIME_EVIDENCE_COMMIT and
                        commit_scope(implementation) == POST_PRIVATE_ROUTING_SCOPE and
                        metadata(implementation, cwd=ROOT) == PRIVATE_RUNTIME_EXECUTOR_METADATA and
                        git("rev-list", "--merges", PRIVATE_RUNTIME_EVIDENCE_COMMIT + ".." + head) == "",
                        "post_private_routing_implementation_topology")
                require(int(git("show", "-s", "--format=%ct", PRIVATE_RUNTIME_EVIDENCE_COMMIT)) ==
                        POST_PRIVATE_ROUTING_BASE_EPOCH,
                        "post_private_routing_base_epoch")
                validate_post_private_routing_identity(
                    implementation, PRIVATE_RUNTIME_EVIDENCE_COMMIT, "implementation")
                for path in POST_PRIVATE_ROUTING_SCOPE:
                    require(git("ls-tree", implementation, "--", path).split()[0] == "100755",
                            "post_private_routing_implementation_mode_" + path)
                return {"implementation": implementation,
                        "baseline": PRIVATE_RUNTIME_EVIDENCE_COMMIT,
                        "state": "post_private_routing_implementation"}
            require(len(correction) >= 2 and git("rev-parse", correction[0] + "^") == PRIVATE_RUNTIME_EVIDENCE_COMMIT and
                    git("rev-parse", correction[1] + "^") == correction[0] and
                    commit_scope(correction[0]) == POST_PRIVATE_ROUTING_SCOPE and
                    commit_scope(correction[1]) == {POST_PRIVATE_ROUTING_EVIDENCE} and
                    metadata(correction[0], cwd=ROOT) == PRIVATE_RUNTIME_EXECUTOR_METADATA and
                    metadata(correction[1], cwd=ROOT) == PRIVATE_RUNTIME_EXECUTOR_METADATA and
                    git("rev-list", "--merges", PRIVATE_RUNTIME_EVIDENCE_COMMIT + ".." + head) == "",
                    "post_private_routing_topology")
            require(int(git("show", "-s", "--format=%ct", PRIVATE_RUNTIME_EVIDENCE_COMMIT)) == POST_PRIVATE_ROUTING_BASE_EPOCH,
                    "post_private_routing_base_epoch")
            validate_post_private_routing_identity(correction[0], PRIVATE_RUNTIME_EVIDENCE_COMMIT, "implementation")
            validate_post_private_routing_identity(correction[1], correction[0], "evidence")
            validate_post_private_routing_evidence(strict_json_text(git("show", correction[1] + ":" + POST_PRIVATE_ROUTING_EVIDENCE)), correction[0])
            for commit, paths, label in ((correction[0], POST_PRIVATE_ROUTING_SCOPE, "implementation"),
                                         (correction[1], {POST_PRIVATE_ROUTING_EVIDENCE}, "evidence")):
                for path in paths:
                    require(git("ls-tree", commit, "--", path).split()[0] ==
                            ("100755" if path.startswith("bin/") else "100644"),
                            "post_private_routing_" + label + "_mode_" + path)
            protected |= POST_PRIVATE_ROUTING_SCOPE | {POST_PRIVATE_ROUTING_EVIDENCE}
            later = commit_range_paths(correction[1], head)
            runner_commits = git("rev-list", "--reverse", correction[1] + ".." + head).splitlines()
            if runner_commits[:2] == [RUNNER_GATE_OWNER_PARENT, RUNNER_GATE_BASE] and len(runner_commits) in {3, 4, 5, 6}:
                require(git("rev-parse", RUNNER_GATE_OWNER_PARENT + "^") == correction[1] and
                        git("rev-parse", RUNNER_GATE_BASE + "^") == RUNNER_GATE_OWNER_PARENT and
                        commit_scope(RUNNER_GATE_OWNER_PARENT) == RUNNER_GATE_OWNER_SCOPE and
                        commit_scope(RUNNER_GATE_BASE) == RUNNER_GATE_OWNER_SCOPE,
                        "runner_gate_owner_history")
                implementation = runner_commits[2]
                require(git("rev-parse", implementation + "^") == RUNNER_GATE_BASE and
                        commit_scope(implementation) == RUNNER_GATE_SCOPE and
                        metadata(implementation, cwd=ROOT) == RUNNER_GATE_METADATA and
                        git("rev-list", "--merges", correction[1] + ".." + head) == "",
                        "runner_gate_implementation_topology")
                validate_runner_gate_identity(implementation, RUNNER_GATE_BASE, "implementation")
                if len(runner_commits) == 3:
                    require(mode == "implementation" and branch == RUNNER_GATE_BRANCH and head == implementation,
                            "runner_gate_implementation_state")
                    return {"implementation": implementation, "baseline": RUNNER_GATE_BASE,
                            "state": "private_runtime_runner_gate_implementation"}
                evidence_commit = runner_commits[3]
                require(git("rev-parse", evidence_commit + "^") == implementation and
                        commit_scope(evidence_commit) == {RUNNER_GATE_EVIDENCE} and
                        metadata(evidence_commit, cwd=ROOT) == RUNNER_GATE_METADATA,
                        "runner_gate_evidence_topology")
                validate_runner_gate_identity(evidence_commit, implementation, "evidence")
                validate_runner_gate_evidence(strict_json_text(git("show", evidence_commit + ":" + RUNNER_GATE_EVIDENCE)), implementation)
                for commit, paths, label in ((implementation, RUNNER_GATE_SCOPE, "implementation"),
                                             (evidence_commit, {RUNNER_GATE_EVIDENCE}, "evidence")):
                    for path in paths:
                        require(git("ls-tree", commit, "--", path).split()[0] ==
                                ("100755" if path.startswith("bin/") else "100644"),
                                "runner_gate_" + label + "_mode_" + path)
                protected |= RUNNER_GATE_SCOPE | {RUNNER_GATE_EVIDENCE}
                later = commit_range_paths(evidence_commit, head)
                shape_commits = git("rev-list", "--reverse", evidence_commit + ".." + head).splitlines()
                if shape_commits:
                    implementation = shape_commits[0]
                    require(git("rev-parse", implementation + "^") == CURRENT_SHAPE_BASE and
                            commit_scope(implementation) == CURRENT_SHAPE_SCOPE and
                            metadata(implementation, cwd=ROOT) == RUNNER_GATE_METADATA and
                            git("rev-list", "--merges", evidence_commit + ".." + head) == "",
                            "current_shape_implementation_topology")
                    validate_current_shape_identity(implementation, CURRENT_SHAPE_BASE, "implementation")
                    if len(shape_commits) == 1:
                        require(mode == "implementation" and branch == CURRENT_SHAPE_BRANCH and head == implementation,
                                "current_shape_implementation_state")
                        return {"implementation": implementation, "baseline": CURRENT_SHAPE_BASE,
                                "state": "current_private_runtime_shape_implementation"}
                    shape_evidence = shape_commits[1]
                    require(git("rev-parse", shape_evidence + "^") == implementation and
                            commit_scope(shape_evidence) == {CURRENT_SHAPE_EVIDENCE} and
                            metadata(shape_evidence, cwd=ROOT) == RUNNER_GATE_METADATA,
                            "current_shape_evidence_topology")
                    validate_current_shape_identity(shape_evidence, implementation, "evidence")
                    validate_current_shape_evidence(strict_json_text(git("show", shape_evidence + ":" + CURRENT_SHAPE_EVIDENCE)), implementation)
                    for commit, paths, label in ((implementation, CURRENT_SHAPE_SCOPE, "implementation"),
                                                 (shape_evidence, {CURRENT_SHAPE_EVIDENCE}, "evidence")):
                        for path in paths:
                            require(git("ls-tree", commit, "--", path).split()[0] ==
                                    ("100755" if path.startswith("bin/") else "100644"),
                                    "current_shape_" + label + "_mode_" + path)
                    protected |= CURRENT_SHAPE_SCOPE | {CURRENT_SHAPE_EVIDENCE}
                    later = commit_range_paths(shape_evidence, head)
                    require(not (later & protected), "current_shape_protected_drift")
                    for descendant in git("rev-list", shape_evidence + ".." + head).splitlines():
                        require(metadata(descendant, cwd=ROOT) != RUNNER_GATE_METADATA,
                                "current_shape_executor_descendant")
                    return {"implementation": implementation, "baseline": shape_evidence,
                            "state": "current_private_runtime_shape_main" if branch == "main" else "current_private_runtime_shape_review"}
                require(not (later & protected), "runner_gate_protected_drift")
                for descendant in git("rev-list", evidence_commit + ".." + head).splitlines():
                    require(metadata(descendant, cwd=ROOT) != RUNNER_GATE_METADATA,
                            "runner_gate_executor_descendant")
                return {"implementation": implementation, "baseline": evidence_commit,
                        "state": "private_runtime_runner_gate_main" if branch == "main" else "private_runtime_runner_gate_review"}
            require(not (later & protected), "post_private_routing_protected_drift")
            for descendant in git("rev-list", correction[1] + ".." + head).splitlines():
                require(metadata(descendant, cwd=ROOT) != PRIVATE_RUNTIME_EXECUTOR_METADATA,
                        "post_private_routing_executor_descendant")
            return {"implementation": correction[0], "baseline": correction[1],
                    "state": "post_private_routing_main" if branch == "main" else "post_private_routing_review"}
        return {"implementation": PRIVATE_RUNTIME_IMPLEMENTATION, "baseline": PRIVATE_RUNTIME_EVIDENCE_COMMIT,
                "state": "private_runtime_integrated_main" if branch == "main" else "private_runtime_integrated_review"}
    require(not (later & protected), "current_main_protected_descendant_drift")
    return {"implementation": implementation, "baseline": evidence_commit,
            "state": "current_main_compatibility_review" if branch == CURRENT_MAIN_BRANCH
            else "current_main_compatibility_main"}


def post_private_routing_topology_matrix():
    """Exercise each post-private route with an independently built fixture.

    These deliberately use commits and replacement objects, rather than a
    shared protected-path mutation: a protected-drift failure cannot stand in
    for a missing evidence, identity, mode, or accepted-private binding test.
    """
    workspace = Path(tempfile.mkdtemp(prefix="phase5-post-private-routing-"))
    case_ids = []
    try:
        executor = PRIVATE_RUNTIME_EXECUTOR_METADATA
        reviewer = ["Reviewer", "reviewer@agent-first-mac.invalid",
                    "Reviewer", "reviewer@agent-first-mac.invalid"]

        def clone(name, *, branch=POST_PRIVATE_ROUTING_BRANCH, revision=POST_PRIVATE_ROUTING_EVIDENCE_COMMIT):
            directory = workspace / name
            checked([*GIT, "clone", "--no-local", "--quiet", ROOT, directory])
            checked([*GIT, "checkout", "-q", "-B", branch, revision], cwd=directory)
            checked([*GIT, "remote", "remove", "origin"], cwd=directory)
            require(git("remote", cwd=directory) == "", "post_private_matrix_origin")
            return directory

        def git_only(directory):
            return run([directory / "bin/check-phase5-prep", "--git-only", "--json"], cwd=directory)

        def reject(name, prepare):
            directory = clone(name)
            prepare(directory)
            require(git_only(directory).returncode != 0, "post_private_matrix_accepted_" + name)
            case_ids.append(name)

        def commit_path(directory, path, text, identity=reviewer, message="matrix fixture"):
            target = directory / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(text)
            checked([*GIT, "add", "--", path], cwd=directory)
            synthetic_commit(directory, message, identity)

        def altered_json(directory, path, change, identity=reviewer, message="matrix json"):
            value = strict_json(directory / path)
            change(value)
            commit_path(directory, path, json.dumps(value, sort_keys=True) + "\n", identity, message)

        def replace_commit(directory, old, tree, parent, identity, message):
            env = {"GIT_AUTHOR_NAME": identity[0], "GIT_AUTHOR_EMAIL": identity[1],
                   "GIT_COMMITTER_NAME": identity[2], "GIT_COMMITTER_EMAIL": identity[3],
                   "GIT_AUTHOR_DATE": "1785115424 +0000", "GIT_COMMITTER_DATE": "1785115424 +0000",
                   "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1", "HOME": str(directory),
                   "PATH": "/usr/bin:/bin", "LC_ALL": "C", "LANG": "C"}
            result = run([*GIT, "commit-tree", tree, "-p", parent, "-m", message], cwd=directory, environment=env)
            require(result.returncode == 0, "post_private_matrix_replace_commit")
            checked([*GIT, "replace", old, result.stdout.strip()], cwd=directory)

        def replace_private_evidence(directory, mutate):
            # A real replacement object keeps the accepted object name but
            # makes every descriptor read observe the malformed evidence.
            index = directory / "private-index"
            env = dict(os.environ)
            env.update({"GIT_INDEX_FILE": str(index), "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1"})
            checked([*GIT, "read-tree", PRIVATE_RUNTIME_EVIDENCE_COMMIT + "^{tree}"], cwd=directory, environment=env)
            value = strict_json_text(git("show", PRIVATE_RUNTIME_EVIDENCE_COMMIT + ":" + PRIVATE_RUNTIME_EVIDENCE, cwd=directory))
            mutate(value)
            blob = run([*GIT, "hash-object", "-w", "--stdin"], cwd=directory, environment=env,
                       stdin=json.dumps(value, sort_keys=True) + "\n")
            require(blob.returncode == 0, "post_private_matrix_evidence_blob")
            checked([*GIT, "update-index", "--cacheinfo", "100644," + blob.stdout.strip() + "," + PRIVATE_RUNTIME_EVIDENCE], cwd=directory, environment=env)
            tree = checked([*GIT, "write-tree"], cwd=directory, environment=env).strip()
            replace_commit(directory, PRIVATE_RUNTIME_EVIDENCE_COMMIT, tree, PRIVATE_RUNTIME_IMPLEMENTATION,
                           executor, "accepted private evidence replacement")

        def commit_unprotected(directory, label, identity=reviewer):
            commit_path(directory, "unprotected-" + label, "fixture\n", identity, label)

        def all_git_only_routes(directory, sentinel=None, include_phase4=True):
            # Each route has its own executable and must disable repository
            # config; bounded subprocess completion proves the wrapper survives.
            routes = [("bin/check-phase5-prep", ["--git-only", "--json"]),
                      ("bin/check-phase5-apply-bundle", ["--git-only", "--json"])]
            if include_phase4:
                routes.append(("bin/check-phase4-final-probes", ["--git-only"]))
            for executable, arguments in routes:
                result = run([directory / executable, *arguments], cwd=directory,
                             timeout=30)
                require(result.returncode == 0 and result.stdout,
                        "post_private_matrix_route_rc_" + Path(executable).name)
            if sentinel is not None:
                require(not sentinel.exists(), "post_private_matrix_malicious_git_executed")

        # New topology has its own branch and owner-bound base.  Keep it out
        # of the historical fixture family below, which must stay on 6bf2e2f.
        runner = clone("runner-clean", branch=RUNNER_GATE_BRANCH, revision=RUNNER_GATE_EVIDENCE_COMMIT)
        all_git_only_routes(runner)
        runner_value = strict_json_text(git_only(runner).stdout, "runner_matrix_clean")
        require(runner_value["repositoryState"] == "private_runtime_runner_gate_review" and
                runner_value["protectedBaselineCommit"] == git("rev-parse", "HEAD", cwd=runner),
                "runner_matrix_clean_state")
        case_ids.append("runner-clean-no-origin-git-only")
        runner_implementation = clone("runner-implementation", branch=RUNNER_GATE_BRANCH, revision=RUNNER_GATE_EVIDENCE_COMMIT + "^")
        prep_runner = run([runner_implementation / "bin/check-phase5-prep", "--implementation", "--json"], cwd=runner_implementation)
        apply_runner = run([runner_implementation / "bin/check-phase5-apply-bundle", "--implementation", "--json"], cwd=runner_implementation)
        for result, label in ((prep_runner, "prep"), (apply_runner, "apply")):
            value = strict_json_text(result.stdout, "runner_matrix_" + label)
            require(result.returncode == 0 and value["repositoryState"] == "private_runtime_runner_gate_implementation" and
                    value["protectedBaselineCommit"] == RUNNER_GATE_BASE,
                    "runner_matrix_implementation_" + label)
        case_ids.append("runner-exact-implementation-prep-apply")

        def runner_git_only(directory):
            return run([directory / "bin/check-phase5-prep", "--git-only", "--json"], cwd=directory)

        def runner_reject(name, prepare):
            directory = clone("runner-" + name, branch=RUNNER_GATE_BRANCH, revision=RUNNER_GATE_EVIDENCE_COMMIT)
            prepare(directory)
            for executable, arguments in (
                    ("bin/check-phase5-prep", ["--git-only", "--json"]),
                    ("bin/check-phase5-apply-bundle", ["--git-only", "--json"]),
                    ("bin/check-phase4-final-probes", ["--git-only"])):
                result = run([directory / executable, *arguments], cwd=directory, timeout=30)
                require(result.returncode != 0,
                        "runner_matrix_accepted_" + name + "_" + Path(executable).name)
            case_ids.append("runner-" + name)

        def runner_change_revert(directory):
            path = "bin/check-phase5-prep"
            baseline = git("rev-parse", "HEAD", cwd=directory)
            commit_path(directory, path, (directory / path).read_text() + "\n# runner changed then reverted\n",
                        reviewer, "runner change protected validator")
            checked([*GIT, "checkout", baseline, "--", path], cwd=directory)
            checked([*GIT, "add", "--", path], cwd=directory)
            synthetic_commit(directory, "runner restore protected validator", reviewer)

        def runner_merge(directory):
            checked([*GIT, "checkout", "-q", "-b", "side"], cwd=directory)
            commit_unprotected(directory, "runner-side")
            checked([*GIT, "checkout", "-q", RUNNER_GATE_BRANCH], cwd=directory)
            commit_unprotected(directory, "runner-main")
            checked([*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"], cwd=directory)

        runner_reject("protected-change-revert", runner_change_revert)
        runner_reject("merge", runner_merge)
        runner_reject("origin", lambda d: checked([*GIT, "remote", "add", "origin", "file:///invalid"], cwd=d))
        runner_reject("dirty", lambda d: (d / "dirty").write_text("fixture\n"))
        runner_reject("detached", lambda d: checked([*GIT, "checkout", "-q", "--detach"], cwd=d))
        runner_reject("executor-descendant", lambda d: commit_unprotected(d, "runner-executor", executor))
        def runner_three_reviewer_descendants(directory):
            for number in range(3):
                commit_unprotected(directory, "runner-reviewer-" + str(number))
        runner_reject("three-nonexecutor-unprotected-descendants",
                      runner_three_reviewer_descendants)
        runner_reject("owner-history", lambda d: checked([*GIT, "reset", "--hard", RUNNER_GATE_OWNER_PARENT], cwd=d))

        def runner_malicious(key):
            directory = clone("runner-malicious-" + key, branch=RUNNER_GATE_BRANCH, revision=RUNNER_GATE_EVIDENCE_COMMIT)
            sentinel = workspace / ("runner-sentinel-" + key)
            hook = workspace / ("runner-malicious-" + key + "-payload")
            hook.mkdir()
            payload = "#!/bin/sh\ntouch '" + str(sentinel) + "'\nexit 97\n"
            (hook / "post-commit").write_text(payload)
            (hook / "post-commit").chmod(0o755)
            checked([*GIT, "config", "core.hooksPath", str(hook)], cwd=directory)
            if key == "fsmonitor":
                checked([*GIT, "config", "core.fsmonitor", str(hook / "post-commit")], cwd=directory)
            all_git_only_routes(directory, sentinel)
            require(not sentinel.exists(), "runner_matrix_malicious_executed_" + key)
            checked([*GIT, "remote", "add", "origin", "file:///invalid"], cwd=directory)
            require(runner_git_only(directory).returncode != 0,
                    "runner_matrix_malicious_invalid_state_" + key)
            case_ids.append("runner-malicious-" + key)

        runner_malicious("hooks")
        runner_malicious("fsmonitor")

        for name, count in (("one-nonexecutor-unprotected-descendant", 1),
                            ("two-nonexecutor-unprotected-descendants", 2)):
            directory = clone("runner-" + name, branch=RUNNER_GATE_BRANCH, revision=RUNNER_GATE_EVIDENCE_COMMIT)
            baseline = git("rev-parse", "HEAD", cwd=directory)
            for number in range(count):
                commit_unprotected(directory, "runner-reviewer-" + str(number))
            all_git_only_routes(directory)
            prep_value = strict_json_text(runner_git_only(directory).stdout,
                                          "runner_matrix_descendant_" + name)
            apply_value = strict_json_text(run(
                [directory / "bin/check-phase5-apply-bundle", "--git-only", "--json"],
                cwd=directory).stdout, "runner_matrix_descendant_apply_" + name)
            require(prep_value["repositoryState"] == "private_runtime_runner_gate_review" and
                    prep_value["protectedBaselineCommit"] == baseline and
                    apply_value["repositoryState"] == "private_runtime_runner_gate_review" and
                    apply_value["protectedBaselineCommit"] == baseline and
                    apply_value["sourceCommit"] == git("rev-parse", "HEAD", cwd=directory),
                    "runner_matrix_descendant_state_" + name)
            case_ids.append("runner-" + name)

        clean = clone("clean")
        first, second = git_only(clean), git_only(clean)
        require(first.returncode == second.returncode == 0 and first.stdout == second.stdout,
                "post_private_matrix_clean")
        all_git_only_routes(clean, include_phase4=False)
        historical_phase4 = run([clean / "bin/check-phase4-final-probes", "--git-only"], cwd=clean)
        require(historical_phase4.returncode != 0 and strict_json_text(historical_phase4.stdout) ==
                {"reason": "phase2_historical_live_doctor", "result": "fail"},
                "post_private_matrix_historical_phase4_temporal_negative")
        case_ids.append("clean-no-origin-git-only")

        # Exercise the semantic consumer directly.  These fixtures retain the
        # real accepted Git objects and therefore cannot pass merely because a
        # replacement commit was rejected by topology or cryptographic checks.
        accepted_private_value = strict_json_text(
            git("show", PRIVATE_RUNTIME_EVIDENCE_COMMIT + ":" +
                PRIVATE_RUNTIME_EVIDENCE), "accepted-private-semantic")
        validate_integrated_private_runtime_evidence_contract(
            accepted_private_value)
        case_ids.append("private-semantic-positive")

        def semantic_reject(name, reason, mutate):
            candidate = copy.deepcopy(accepted_private_value)
            mutate(candidate)
            try:
                validate_integrated_private_runtime_evidence_contract(candidate)
            except RuntimeError as error:
                require(str(error) == reason,
                        "post_private_semantic_reason_" + name)
                case_ids.append(name)
                return
            raise RuntimeError("post_private_semantic_accepted_" + name)

        semantic_cases = (
            ("private-semantic-unknown-top-level",
             "integrated_private_runtime_evidence_shape",
             lambda item: item.update(unknown=True)),
            ("private-semantic-schema", "integrated_private_runtime_evidence_header",
             lambda item: item.update(schema=2)),
            ("private-semantic-phase", "integrated_private_runtime_evidence_header",
             lambda item: item.update(phase="other")),
            ("private-semantic-base", "integrated_private_runtime_evidence_header",
             lambda item: item.update(base="0" * 40)),
            ("private-semantic-branch", "integrated_private_runtime_evidence_header",
             lambda item: item.update(branch="other")),
            ("private-semantic-implementation",
             "integrated_private_runtime_evidence_implementation",
             lambda item: item.update(implementation="0" * 40)),
            ("private-semantic-authority-owner-decision",
             "integrated_private_runtime_evidence_authority",
             lambda item: item["authority"].update(ownerDecision="other")),
            ("private-semantic-authority-handoff",
             "integrated_private_runtime_evidence_authority",
             lambda item: item["authority"].update(handoffSHA256="0" * 64)),
            ("private-semantic-authority-dependency",
             "integrated_private_runtime_evidence_authority",
             lambda item: item["authority"].update(
                 operationalMigrationDependency=True)),
            ("private-semantic-gate-phase5-pass",
             "integrated_private_runtime_evidence_gate",
             lambda item: item["gate"].update(phase5PassClaimed=True)),
            ("private-semantic-gate-phase6-authorized",
             "integrated_private_runtime_evidence_gate",
             lambda item: item["gate"].update(phase6Authorized=True)),
            ("private-semantic-gate-stageb",
             "integrated_private_runtime_evidence_gate",
             lambda item: item["gate"].update(stageBContinuationRequired=False)),
            ("private-semantic-gate-marker",
             "integrated_private_runtime_evidence_gate",
             lambda item: item["gate"].update(marker="other")),
            ("private-semantic-gate-verdict",
             "integrated_private_runtime_evidence_gate",
             lambda item: item["gate"].update(maximumVerdict="other")),
            ("private-semantic-public-observation",
             "integrated_private_runtime_evidence_public_observation",
             lambda item: item["publicObservation"].update(projectRows=24)),
            ("private-semantic-redaction",
             "integrated_private_runtime_evidence_redaction",
             lambda item: item["redaction"].update(privatePaths=True)),
            ("private-semantic-system-mutations",
             "integrated_private_runtime_evidence_mutations",
             lambda item: item["systemMutations"].update(privateConfig=True)),
            ("private-semantic-tests-empty",
             "integrated_private_runtime_evidence_tests",
             lambda item: item.update(tests={})),
            ("private-semantic-tests-false",
             "integrated_private_runtime_evidence_tests",
             lambda item: item["tests"].update(
                 {next(iter(item["tests"])): False})),
            ("private-semantic-topology",
             "integrated_private_runtime_evidence_topology",
             lambda item: item["topology"].update(noMerge=False)),
            ("private-semantic-bindings-keyset",
             "integrated_private_runtime_evidence_bindings",
             lambda item: item["bindings"].update(extra=True)),
            ("private-semantic-bindings-parent",
             "integrated_private_runtime_evidence_bindings",
             lambda item: item["bindings"].update(implementationParent="0" * 40)),
            ("private-semantic-bindings-metadata",
             "integrated_private_runtime_evidence_bindings",
             lambda item: item["bindings"].update(implementationMetadata=[])),
            ("private-semantic-bindings-scope",
             "integrated_private_runtime_evidence_bindings",
             lambda item: item["bindings"].update(implementationScope=[])),
            ("private-semantic-bindings-blob-keyset",
             "integrated_private_runtime_evidence_bindings",
             lambda item: item["bindings"]["implementationBlobsSHA256"].pop(
                 "bin/check-phase5-prep")),
            ("private-semantic-bindings-raw",
             "integrated_private_runtime_evidence_raw_bindings",
             lambda item: item["bindings"].update(
                 implementationRawCommitSHA256="0" * 64)),
            ("private-semantic-bindings-blob",
             "integrated_private_runtime_evidence_raw_bindings",
             lambda item: item["bindings"]["implementationBlobsSHA256"].update(
                 {"bin/check-phase5-prep": "0" * 64})),
        )
        for semantic_name, semantic_reason, semantic_mutate in semantic_cases:
            semantic_reject(semantic_name, semantic_reason, semantic_mutate)

        implementation = clone("implementation-stage")
        checked([*GIT, "reset", "--hard", "HEAD^"], cwd=implementation)
        prep_implementation = run(
            [implementation / "bin/check-phase5-prep", "--implementation", "--json"],
            cwd=implementation)
        prep_value = strict_json_text(prep_implementation.stdout,
                                      "post_private_prep_implementation")
        require(prep_implementation.returncode == 0 and
                prep_value["repositoryState"] == "post_private_routing_implementation" and
                prep_value["protectedBaselineCommit"] == PRIVATE_RUNTIME_EVIDENCE_COMMIT,
                "post_private_matrix_prep_implementation")
        case_ids.append("exact-implementation-stage-prep")
        apply_implementation = run(
            [implementation / "bin/check-phase5-apply-bundle", "--implementation", "--json"],
            cwd=implementation)
        apply_value = strict_json_text(apply_implementation.stdout,
                                       "post_private_apply_implementation")
        require(apply_implementation.returncode == 0 and
                apply_value["repositoryState"] == "post_private_routing_implementation" and
                apply_value["protectedBaselineCommit"] == PRIVATE_RUNTIME_EVIDENCE_COMMIT,
                "post_private_matrix_apply_implementation")
        case_ids.append("exact-implementation-stage-apply")

        # Accepted-private evidence/schema/raw/blob/mode/topology fixtures.
        reject("private-evidence-schema", lambda d: replace_private_evidence(d, lambda v: v.update(schema=2)))
        reject("private-evidence-raw", lambda d: replace_private_evidence(d, lambda v: v["bindings"].update(implementationRawCommitSHA256="0" * 64)))
        reject("private-evidence-blob", lambda d: replace_private_evidence(d, lambda v: v["bindings"]["implementationBlobsSHA256"].update({"bin/check-phase5-prep": "0" * 64})))
        reject("private-mode", lambda d: replace_private_evidence(d, lambda v: v["bindings"].update(implementationScope=[])))
        reject("private-topology", lambda d: replace_private_evidence(d, lambda v: v.update(base="0" * 40)))

        # Correction facts are changed in the actual correction objects.
        reject("correction-base", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v.update(base="0" * 40)))
        reject("correction-parent", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v["implementation"].update(parent="0" * 40)))
        reject("correction-scope", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v["protectedBaseline"].update(paths=[])))
        reject("correction-metadata", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v["implementation"].update(metadata=[])))
        reject("correction-raw", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v["implementationBlobs"].update({"bin/check-phase5-prep":"0" * 64})))
        reject("correction-mode", lambda d: commit_path(d, "bin/check-phase5-prep", (d / "bin/check-phase5-prep").read_text() + "\n# mode fixture\n", reviewer, "mode fixture"))
        reject("correction-evidence-missing", lambda d: checked([*GIT, "reset", "--hard", "HEAD^"], cwd=d))
        reject("correction-evidence-extra", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v.update(extra=True)))
        reject("correction-evidence-tampered", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v["gate"].update(phase5PassClaimed=True)))
        reject("correction-evidence-substituted", lambda d: altered_json(d, POST_PRIVATE_ROUTING_EVIDENCE, lambda v: v["acceptedPrivatePair"].update(evidence="0" * 40)))
        def correction_evidence_multifile(d):
            # Rebuild the pair with one evidence commit that changes the
            # evidence plus an extra file; it is not a harmless descendant.
            impl = git("rev-parse", "HEAD^", cwd=d)
            receipt = git("show", "HEAD:" + POST_PRIVATE_ROUTING_EVIDENCE, cwd=d)
            checked([*GIT, "checkout", "-q", "-B", POST_PRIVATE_ROUTING_BRANCH,
                     PRIVATE_RUNTIME_EVIDENCE_COMMIT], cwd=d)
            checked([*GIT, "checkout", impl, "--", *sorted(POST_PRIVATE_ROUTING_SCOPE)], cwd=d)
            (d / "unexpected-correction-implementation-path").write_text("fixture\n")
            checked([*GIT, "add", "-A"], cwd=d)
            synthetic_commit(d, "wrong correction implementation scope", executor)
            (d / POST_PRIVATE_ROUTING_EVIDENCE).write_text(receipt)
            (d / "extra-evidence").write_text("fixture\n")
            checked([*GIT, "add", "--", POST_PRIVATE_ROUTING_EVIDENCE, "extra-evidence"], cwd=d)
            synthetic_commit(d, "multifile correction evidence", executor)
        reject("correction-evidence-multifile", correction_evidence_multifile)
        reject("wrong-branch", lambda d: checked([*GIT, "checkout", "-q", "-b", "wrong"], cwd=d))
        reject("renamed-branch", lambda d: checked([*GIT, "branch", "-m", "renamed"], cwd=d))
        reject("detached", lambda d: checked([*GIT, "checkout", "-q", "--detach"], cwd=d))
        reject("dirty", lambda d: (d / "dirty").write_text("fixture\n"))
        reject("origin", lambda d: checked([*GIT, "remote", "add", "origin", "file:///invalid"], cwd=d))
        reject("substitute-base", lambda d: (checked([*GIT, "checkout", "-q", "-B", POST_PRIVATE_ROUTING_BRANCH, PRIVATE_RUNTIME_IMPLEMENTATION], cwd=d), commit_unprotected(d, "substitute-base")))
        def make_merge(d):
            checked([*GIT, "checkout", "-q", "-b", "side"], cwd=d); commit_unprotected(d, "side")
            checked([*GIT, "checkout", "-q", POST_PRIVATE_ROUTING_BRANCH], cwd=d); commit_unprotected(d, "main")
            checked([*GIT, "merge", "-q", "--no-ff", "--no-edit", "side"], cwd=d)
        reject("merge", make_merge)
        reject("protected-validator-descendant", lambda d: commit_path(d, "bin/check-phase5-prep", (d / "bin/check-phase5-prep").read_text() + "\n# protected\n"))
        reject("protected-evidence-descendant", lambda d: commit_path(d, POST_PRIVATE_ROUTING_EVIDENCE, (d / POST_PRIVATE_ROUTING_EVIDENCE).read_text() + "\n"))
        def protected_change_revert(d):
            path = "bin/check-phase5-prep"
            baseline = git("rev-parse", "HEAD", cwd=d)
            commit_path(d, path, (d / path).read_text() + "\n# changed then reverted\n",
                        reviewer, "change protected validator")
            checked([*GIT, "checkout", baseline, "--", path], cwd=d)
            checked([*GIT, "add", "--", path], cwd=d)
            synthetic_commit(d, "restore protected validator", reviewer)
            for executable, arguments in (
                    ("bin/check-phase5-prep", ["--git-only", "--json"]),
                    ("bin/check-phase5-apply-bundle", ["--git-only", "--json"]),
                    ("bin/check-phase4-final-probes", ["--git-only"])):
                result = run([d / executable, *arguments], cwd=d)
                require(result.returncode != 0,
                        "post_private_matrix_change_revert_accepted_" +
                        Path(executable).name)
        change_revert = clone("protected-change-revert")
        protected_change_revert(change_revert)
        case_ids.append("protected-change-revert-all-git-only-routes")
        reject("third-executor-descendant", lambda d: commit_unprotected(d, "third-executor", executor))
        def malicious(d, key):
            sentinel = workspace / ("sentinel-" + key)
            payload = "#!/bin/sh\ntouch '" + str(sentinel) + "'\nexit 97\n"
            hook = workspace / ("malicious-" + key + "-payload")
            hook.mkdir()
            (hook / "post-commit").write_text(payload)
            (hook / "post-commit").chmod(0o755)
            checked([*GIT, "config", "core.hooksPath", str(hook)], cwd=d)
            if key == "fsmonitor": checked([*GIT, "config", "core.fsmonitor", str(hook / "post-commit")], cwd=d)
            # The legacy family is intentionally split: preparation and apply
            # remain valid on 6bf, while the immutable historical Phase 4
            # live route must fail only with its temporal reason.
            for executable in ("bin/check-phase5-prep", "bin/check-phase5-apply-bundle"):
                result = run([d / executable, "--git-only", "--json"], cwd=d, timeout=30)
                require(result.returncode == 0, "post_private_matrix_legacy_malicious_" + Path(executable).name)
            phase4 = run([d / "bin/check-phase4-final-probes", "--git-only"], cwd=d, timeout=30)
            require(phase4.returncode != 0 and strict_json_text(phase4.stdout) ==
                    {"reason": "phase2_historical_live_doctor", "result": "fail"},
                    "post_private_matrix_legacy_malicious_phase4")
            require(not sentinel.exists(), "post_private_matrix_sentinel")
            checked([*GIT, "remote", "add", "origin", "file:///invalid"], cwd=d)
        reject("malicious-fsmonitor", lambda d: malicious(d, "fsmonitor"))
        reject("malicious-hooks", lambda d: malicious(d, "hooks"))
        for name in ("one-nonexecutor-unprotected-descendant", "two-nonexecutor-unprotected-descendants"):
            directory = clone(name)
            for number in range(1 if name.startswith("one") else 2):
                commit_unprotected(directory, str(number))
            require(git_only(directory).returncode == 0, "post_private_matrix_rejected_" + name)
            case_ids.append(name)
        require(sorted(case_ids) == RUNNER_GATE_MATRIX_CASES,
                "post_private_matrix_case_contract")
        return {"allPassed": True, "caseIDs": sorted(case_ids), "count": len(case_ids)}
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


