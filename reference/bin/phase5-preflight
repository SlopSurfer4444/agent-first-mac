APP_BUNDLE = CODEX.parents[2]
MANAGED_VALUES = {
    "approval_policy": "never",
    "sandbox_mode": "danger-full-access",
}
MANAGED_EXACT = re.compile(
    r'^\s*(approval_policy|sandbox_mode)\s*=\s*"([^"\\\r\n]*)"\s*(?:#.*)?$'
)
MANAGED_PREFIX = re.compile(r"^\s*(approval_policy|sandbox_mode)(?:\s|=|\.)")
TABLE_HEADER = re.compile(r"^\s*\[\[?\s*([A-Za-z0-9_-]+)")
