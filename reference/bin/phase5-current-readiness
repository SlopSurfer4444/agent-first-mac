APP = integrations.APP_RESOURCES
BUNDLE = "/Applications/ChatGPT.app"
CLI = APP + "/codex"
MAX_OUTPUT = 4 * 1024 * 1024
MAX_SOURCE = 512 * 1024 * 1024
AGGREGATE_SECONDS = 90.0
COMMAND_SECONDS = 8.0
READ_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
STAGES = frozenset(("target-read", "history-read", "source-bind", "signature", "version",
                    "integration-source", "mcp", "catalog", "admission", "final-recheck", "cleanup"))


def safe_stage(value):
    return value if type(value) is str and value in STAGES else None


class ReadinessError(Exception):
    def __init__(self, *, private_owner=None, stage=None):
        self.private_owner = private_owner
        self.settlement_failed = private_owner is not None
        self.stage = safe_stage(stage)
        super().__init__("current_readiness_required")


def earliest(primary, error):
    """Keep the first interruption, otherwise the first ordinary failure."""
    if isinstance(primary, (KeyboardInterrupt, SystemExit)):
        return primary
    if primary is None or isinstance(error, (KeyboardInterrupt, SystemExit)):
        return error
    return primary


def require(value):
    if value is not True:
        raise ReadinessError()


def strict_json(raw):
    def pairs(items):
        result = {}
        for key, value in items:
            require(key not in result)
            result[key] = value
        return result
    def constant(_):
        raise ReadinessError()
    require(type(raw) is bytes and len(raw) <= MAX_OUTPUT)
    return json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=pairs,
                      parse_constant=constant)


class Budget:
    def __init__(self, seconds=AGGREGATE_SECONDS, *, clock=time.monotonic):
        self.clock = clock
        self.end = clock() + seconds

    def check(self):
        require(self.clock() < self.end)

    def command(self, maximum):
        remaining = min(maximum, self.end - self.clock())
        require(remaining > 2.0)
        return remaining


def command_read(arguments, environment, budget, *, session_factory=catalog._Session):
    """Fixed read commands; reuse the reviewed direct-Popen settlement owner.

The new code only drains nonblocking raw pipes (shared 4 MiB cap), not another
RPC protocol. Cleanup never signals a process group or an already reaped child.
"""
    allowed = (
        (CLI, "--version"), (CLI, "mcp", "list", "--json"),
        ("/usr/bin/codesign", "-dvv", BUNDLE),
        ("/usr/bin/codesign", "-dr", "-", BUNDLE),
        ("/usr/bin/codesign", "--verify", "--deep", "--strict", BUNDLE),
        ("/usr/sbin/spctl", "--assess", "--type", "execute", BUNDLE),
    )
    require(type(arguments) in (list, tuple)
            and all(type(value) in (str, type(Path("/"))) for value in arguments))
    argv = tuple(str(value) for value in arguments)
    require(argv in allowed)
    require(type(environment) is dict and integrations._path(environment.get("HOME"))
            and integrations._equal(environment, {
                "HOME": environment["HOME"], "CODEX_HOME": environment["HOME"] + "/.codex",
                "LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "SHELL": "/bin/zsh"}))
    duration = budget.command(COMMAND_SECONDS)
    deadline = time.monotonic() + duration
    owner = session_factory(deadline - 2.0)
    primary, output, size = None, {"stdout": bytearray(), "stderr": bytearray()}, 0
    try:
        owner.start(argv, environment, catalog.subprocess.Popen)
        owner.streams["stdin"].close()
        while owner.eof != {"stdout", "stderr"} or owner.process.poll() is None:
            budget.check()
            require(time.monotonic() < deadline - 2.0)
            for key, _ in owner.selector.select(min(0.05, max(0, deadline - 2.0 - time.monotonic()))):
                name = key.data
                require(name in output)
                try:
                    chunk = os.read(owner.streams[name].fileno(), min(65536, MAX_OUTPUT + 1 - size))
                except BlockingIOError:
                    continue
                if not chunk:
                    owner.eof.add(name)
                    owner.selector.unregister(owner.streams[name])
                    continue
                size += len(chunk)
                require(size <= MAX_OUTPUT)
                output[name].extend(chunk)
        result = SimpleNamespace(returncode=owner.process.returncode,
            stdout=bytes(output["stdout"]).decode("utf-8", "strict"),
            stderr=bytes(output["stderr"]).decode("utf-8", "strict"))
    except BaseException as error:
        primary = error
    settled, problem = owner.close(deadline, True)
    interruption = primary if isinstance(primary, (KeyboardInterrupt, SystemExit)) else owner.interruption
    if interruption is not None:
        interruption.private_owner = owner if not settled else None
        interruption.settlement_failed = not settled
        raise interruption from None
    if primary is not None or not settled or problem:
        raise ReadinessError(private_owner=owner if not settled else None) from None
    budget.check()
    return result


def file_stamp(facts):
    return tuple(getattr(facts, key) for key in (
        "st_dev", "st_ino", "st_uid", "st_gid", "st_mode", "st_nlink", "st_size",
        "st_mtime_ns", "st_ctime_ns", "st_flags"))


class SourceFile:
    """Held file FD, bounded streamed bytes/hash, and rebound complete chain.

Directory chains are opened one at a time to avoid one full chain per source
remaining open. Their identities are retained and compared on every recheck;
the leaf file descriptor remains held until close. No path fallback or symlink.
"""
    def __init__(self, path, root, uid, budget, *, keep=True, absent=False, syscalls=os, opener=OwnedParent.open):
        self.path, self.root, self.uid = str(path), str(root), uid
        self.budget, self.os, self.opener, self.keep = budget, syscalls, opener, keep
        self.absent = absent
        self.fds = []
        try:
            with opener(str(Path(path).parent), self.root, uid, syscalls=syscalls) as parent:
                self.chain = tuple(parent._identities)
                if absent:
                    self.stamp, self.data, self.digest = None, None, "absent"
                    self._check_absent(parent)
                    return
                descriptor = syscalls.open(Path(path).name, READ_FLAGS, dir_fd=parent.descriptor)
                self.fds.append(descriptor)
                self.stamp = file_stamp(syscalls.fstat(descriptor))
                self.data, self.digest = self._read(parent)
        except BaseException:
            self.close()
            raise

    def _check_absent(self, parent):
        self.budget.check()
        parent.verify()
        require(tuple(parent._identities) == self.chain)
        try:
            self.os.stat(Path(self.path).name, dir_fd=parent.descriptor, follow_symlinks=False)
        except FileNotFoundError:
            parent.verify()
            return
        raise ReadinessError()

    def _read(self, parent):
        self.budget.check()
        descriptor = self.fds[0]
        facts = self.os.fstat(descriptor)
        maximum = MAX_OUTPUT if self.keep else MAX_SOURCE
        require(stat.S_ISREG(facts.st_mode) and facts.st_uid == self.uid
                and facts.st_nlink == 1 and not facts.st_mode & 0o022
                and not facts.st_mode & 0o7000
                and 0 <= facts.st_size <= maximum and file_stamp(facts) == self.stamp)
        parent.verify()
        self.os.lseek(descriptor, 0, os.SEEK_SET)
        digest, chunks, size = hashlib.sha256(), [], 0
        while True:
            self.budget.check()
            block = self.os.read(descriptor, min(65536, maximum + 1 - size))
            if not block:
                break
            size += len(block)
            require(size <= maximum)
            digest.update(block)
            if self.keep:
                chunks.append(block)
        named = self.os.stat(Path(self.path).name, dir_fd=parent.descriptor, follow_symlinks=False)
        require(file_stamp(self.os.fstat(descriptor)) == self.stamp
                and file_stamp(named) == self.stamp and size == facts.st_size
                and tuple(parent._identities) == self.chain)
        parent.verify()
        return b"".join(chunks) if self.keep else None, digest.hexdigest()

    def verify(self):
        with self.opener(str(Path(self.path).parent), self.root, self.uid, syscalls=self.os) as parent:
            require(tuple(parent._identities) == self.chain)
            if self.absent:
                self._check_absent(parent)
                return True
            value, digest = self._read(parent)
            require(value == self.data and digest == self.digest)
        return True

    def close(self):
        _close_all(self.os, self.fds)


def public(verdict, *, observed=0, settled=True, stage=None):
    return {"schema": 1, "probe": "phase5-current-readiness", "verdict": verdict,
            "observedTargets": observed, "reasonCodes": [] if verdict == "ready" else ["current_readiness_required"],
            "failureStage": None if verdict == "ready" else safe_stage(stage) or "admission",
            "childSettled": settled, "executionAdmission": False, "liveAdmission": False,
            "configMutationAuthorized": False, "trustMutationAuthorized": False,
            "phase5Accepted": False, "phase6Allowed": False, "cleanupPerformed": False}


