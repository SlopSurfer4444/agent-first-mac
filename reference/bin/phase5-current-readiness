#!/usr/bin/python3
"""Standalone, read-only current-generation readiness. Never apply/capture.

No Store, allocation, transaction dispatch, model request or old gate is invoked.
Catalog/CLI reads may exercise normal runtime auth/cache/network read behavior;
all guarded local changes invalidate this operation. Observed boundaries do not
promise continuous exclusion, provider-state custody or future execution rights.
Run only the reviewed source under an external finite deadline: synchronous
Popen and kernel calls cannot be interrupted by a cooperative Python deadline.
An unresolved child remains attached to a private exception, including numeric
SystemExit at the terminal boundary. JSON is NOT an ownership-transfer or
recovery mechanism: a standalone process exit cannot preserve its Python handle
in another process. Unresolved ownership requires external reconciliation and
stops readiness/retry; this executable never claims such recovery occurred.
"""

import sys
sys.dont_write_bytecode = True

import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import pwd
import re
import stat
import time
from types import SimpleNamespace

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import phase5_runtime_capture as capture
from lib import phase5_runtime_integrations as integrations
from lib import phase5_runtime_legacy as legacy
from lib import phase5_runtime_targets as targets
