{
  "allowedCommands": [
    "apply-system",
    "doctor-root"
  ],
  "apply": {
    "activationArguments": [
      "--switch-generation"
    ],
    "applyGateAccepted": false,
    "profilePath": "/nix/var/nix/profiles/system",
    "receiptSuffix": "AIDev/state/phase-4/apply-receipts",
    "rollbackArguments": [
      "--switch-generation"
    ],
    "storeRoot": "/nix/store"
  },
  "audit": {
    "maxRecordBytes": 4096,
    "retentionDays": 30,
    "rollbackHint": "switch-to-exact-previous-generation-and-verify"
  },
  "control": {
    "expectedBranch": "main",
    "provenanceRule": "local-reviewed-main-exact-head",
    "repositoryRule": "caller-home-relative",
    "repositorySuffix": "AIDev/control",
    "requireClean": true,
    "requireExactHead": true
  },
  "environment": {
    "HOME": "/var/empty",
    "LANG": "C",
    "LC_ALL": "C",
    "PATH": "/usr/bin:/bin",
    "TMPDIR": "/var/empty"
  },
  "executables": {
    "activation": "/run/current-system/sw/bin/darwin-rebuild",
    "git": "/usr/bin/git",
    "nixEnv": "/nix/var/nix/profiles/default/bin/nix-env",
    "nixStore": "/nix/var/nix/profiles/default/bin/nix-store"
  },
  "installedPaths": {
    "attestation": "/etc/agent-first-mac/aid-admin-install.json",
    "audit": "/var/log/agent-first-mac/aid-admin",
    "binary": "/usr/local/libexec/aid-admin",
    "emergencyDisable": "/etc/agent-first-mac/aid-admin.disabled",
    "policy": "/etc/agent-first-mac/aid-admin-policy.json",
    "staging": "/var/db/agent-first-mac/staging",
    "sudoers": "/etc/sudoers.d/agent-first-mac-aid-admin"
  },
  "preparationOnly": true,
  "schema": 2
}
